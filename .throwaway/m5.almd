fn look(v: Value, key: String) -> Int? = match value.get(v, key) {
  some(x) => result.to_option(value.as_int(x)),
  none => none,
}
effect fn main() -> Unit = {
  let x: Value = value.object([("k1", value.int(1))])
  let a1: String = "k${1}"
  var i = 0
  while i < 1 {
    let r: Option[Int] = look(x, a1)
    println("${option.is_some(r)}")
    i = i + 1
  }
}
