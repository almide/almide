// The regex reference probe (#2129). Reads `op<TAB>pattern<TAB>subject` lines
// and answers one line per case, in a shape a text diff can read.
//
// It exists so `scripts/check-regex-reference.sh` can ask BOTH legs the same
// questions the committed reference table already answers — see
// proofs/regex/README.md for what that table is and is not.
import io
import regex

// One case per line: op<TAB>pattern<TAB>subject. Answers one line per case.
fn answer(op: String, pat: String, s: String) -> String = match op {
  "is_match" => if regex.is_match(regex.new(pat), s) then "true" else "false",
  "full_match" => if regex.is_full_match(regex.new(pat), s) then "true" else "false",
  "find" => match regex.find(regex.new(pat), s) {
    some(m) => "<" + m + ">",
    none => "<none>",
  },
  "find_all" => "[" + list.join(regex.find_all(regex.new(pat), s), "|") + "]",
  "split" => "[" + list.join(regex.split(regex.new(pat), s), "|") + "]",
  "captures" => match regex.captures(regex.new(pat), s) {
    some(cs) => "[" + list.join(cs |> list.map((c) => c ?? ""), "|") + "]",
    none => "<none>",
  },
  _ => "<bad-op>",
}

effect fn main() -> Unit = {
  let lines = string.split(io.read_all(), "\n")
  let out = lines |> list.filter((l) => l != "") |> list.map((l) => {
    let f = string.split(l, "\t")
    answer(list.get(f, 0) ?? "", list.get(f, 1) ?? "", list.get(f, 2) ?? "")
  })
  println(list.join(out, "\n"))
}
