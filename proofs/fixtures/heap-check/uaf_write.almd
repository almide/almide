import ffi

// The address of a buffer that dies when this returns: its block goes back
// to the allocator's free list, and the address dangles.
fn dangling() -> RawPtr = ffi.address(bytes.zeros(40))

effect fn main() -> Unit = {
  let p = dangling()
  // A use-after-free WRITE through the dangling address.
  let n = ffi.write(p, bytes.from_list([9, 9, 9, 9, 9, 9, 9, 9]), 8)
  // The next request of the same size class takes the freed block back.
  let c = bytes.zeros(40)
  println("wrote ${n}, reused ${bytes.len(c)}")
}
