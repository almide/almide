// #4281 drill: a string byte read's guard admits one byte past the string's
// len word while the bounds witness still records `c a` — the proven
// checker accepts, the bytes test a looser bound than the read needs.
effect fn main() -> Unit = {
  let s = "hey"
  match string.get(s, 1) {
    some(c) => println(c),
    none => println("none"),
  }
}
