// proofs/gate.sh fixture (#2755): the structural witness's later shapes, one
// small fn each, so a drill names one object's line.
effect fn raise(x: Int) -> Int = if x == 0 then err("zero") else ok(x)

// A callback that RAISES over a Map / a Set instantiates the self-hosted
// `map.__fallible_map` / `set.__fallible_map`: an ordinary call, the literal
// lambda a closure value whose env is built here and lent to the body.
effect fn raised_map(m: Map[String, Int]) -> Map[String, Int] = map.map(m, (v) => raise(v)!)!

effect fn raised_set(s: Set[Int]) -> Set[Int] = set.map(s, (v) => raise(v)!)!

// `none` read as an operand: the NULL address, no block.
fn none_eq(o: String?) -> Bool = o == none

// `none ?? fallback`: the carrier is NULL, the fresh fallback joins.
fn or_fresh(s: String) -> String = none ?? s + "!"

// A Bytes index reads a scalar byte; out of bounds aborts holding `b`.
fn byte_of(i: Int) -> Int = {
  let b = bytes.from_list([1, 2, 3])
  b[i]
}

// A record literal that omits a field with a literal-list default.
type Tagged = { name: String, tags: List[String] = [] }

fn tagged(n: String) -> Tagged = Tagged { name: n }

// A typed error `!`-ed into a String channel: the repr text moves into a
// fresh err block that leaves; the owned carrier is released.
fn parse_pos(x: Int) -> Result[Int, Int] = if x > 0 then ok(x) else err(x)

effect fn as_text(x: Int) -> Int = {
  let n = parse_pos(x)!
  n + 1
}

// A borrowed `if` stored into a list slot: each arm shares its own source.
fn pick_text(c: Bool, a: String, b: String) -> List[String] = [
  if c then a else b
]

// A Var read as a statement is dropped.
fn stmt_var(xs: List[Int]) -> Int = {
  xs
  1
}

effect fn main() -> Unit = {
  let m = raised_map(["a": 1])!
  let s = raised_set(set.from_list([2]))!
  println("${map.len(m)} ${set.len(s)} ${none_eq(none)} ${or_fresh("x")} ${byte_of(1)} ${tagged("t").name} ${as_text(2)!} ${list.len(pick_text(true, "a", "b"))} ${stmt_var([1])}")
}
