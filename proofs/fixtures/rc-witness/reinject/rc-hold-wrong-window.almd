// #4277 drill: a routine's hold move (`h<local>@window`, a credit moved into
// a compound routine through a pooled hold local) is recorded against the
// window after the one it was moved into. The ownership witness is
// unchanged; the routine's release of that credit, inside its own window, is
// read through frame variables no event of that window accounts, so the RC
// byte check must refuse it. (`value.object` builds its map through the
// judged set, whose fresh keys move in through their hold.)
import json

effect fn main() -> Unit = {
  let items = [
    value.int(1),
    value.object([("a", value.int(2))]),
    value.int(3)
  ]
  let updated = list.set(items, 1, value.array([value.int(7), value.int(8)]))
  println(json.stringify(value.array(updated)))
  println(json.stringify(value.array(list.set(items, 0, value.string("x")))))
}
