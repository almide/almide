// #4277 drill: a variable's credit moved into a routine (`m<local>@window`:
// `map.set(m, k, v)` shares the key `k` and moves that share into the judged
// set) is recorded against the window after the one it was moved into. The
// ownership witness is unchanged; the set's release of the key it was handed
// (the key is present), inside its own window, now names a frame variable no
// event of that window accounts, so the RC byte check must refuse it.
effect fn main() -> Unit = {
  var m: Map[String, Int] = map.from_list([("a", 1), ("b", 2)])
  let k = string.repeat("a", 1)
  m = map.set(m, k, 3)
  let j = string.repeat("b", 1)
  m = map.set(m, j, 4)
  println("${int.to_string(map.len(m))} ${k} ${j}")
}
