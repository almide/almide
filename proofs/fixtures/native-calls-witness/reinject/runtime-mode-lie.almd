// #4006 C1 drill (native-calls): a fold over a list of Option[Int] is served
// by the runtime body `list.fold` declares. The re-injected witness says the
// caller handed the list over to that body while its own line keeps it.
fn main() -> Unit = {
  let v: List[Int?] = [some(1), none, some(3)]
  println(int.to_string(list.fold(v, 0, (a, o) => a + (o ?? 0))))
}
