// #4280 drill: a `for` loop reads its element BEFORE the exit test, so the
// read on the iteration past the end is guarded by nothing. The loop's
// header stretch then reads `a0 e0`, which the checker rejects.
effect fn main() -> Unit = {
  let xs = [1, 2, 3]
  var s = 0
  for x in xs {
    s = s + x
  }
  println("${s}")
}
