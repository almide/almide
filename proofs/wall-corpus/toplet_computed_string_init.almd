// @wall: no CONST initializer
// A module-level `let` whose initializer is COMPUTED from another heap
// global (`MESSAGE_2 + "?"` — gleam constant_test #6086's aliased-concat
// constant): the wasm global-init path requires const initializers, and a
// computed init would inject an uncounted call, so the reference walls.
// Literal and alias-of-literal top-lets vote (gleam_toplet_consts).
let MESSAGE = "hello"
let MESSAGE_2 = MESSAGE
let MESSAGE_3 = MESSAGE_2 + "?"
fn main() -> Unit = println(MESSAGE_3)
