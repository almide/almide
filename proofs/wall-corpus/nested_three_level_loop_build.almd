// @wall: heap reassignment inside a control-flow frame
// The loop-built spelling of the three-level tower: TWO fresh heap vars per
// iteration (`mid`, `leaf`) pushed into each other and then the outer var.
// The single-fresh-var two-level build lowers and votes (t_freshheap shape,
// spec/wasm_cross/nested_list_list_int.almd); the second nested fresh var
// crosses into the branch-merged handle-slot territory the brick refuses —
// deferring the write would be a silent no-op.
fn main() -> Unit = {
  var tower: List[List[List[Int]]] = []
  var i = 0
  while i < 2 {
    var mid: List[List[Int]] = []
    var leaf: List[Int] = []
    list.push(leaf, i)
    list.push(mid, leaf)
    list.push(tower, mid)
    i = i + 1
  }
  println(int.to_string(list.len(tower)))
}
