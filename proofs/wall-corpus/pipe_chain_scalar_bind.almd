// @wall: scalar binding outside the value subset
// A CHAINED pipe (two or more stages mixing named fns and lambdas) bound
// to a scalar: `three() |> ((x) => x * 10) |> identity`. One-stage pipes
// in every arrangement vote (gleam_pipe_shapes) — the chain is where the
// STRICT value mode refuses rather than defer the stage to Const 0.
fn identity(x: Int) -> Int = x
fn three() -> Int = 3
fn main() -> Unit = {
  let p = three() |> ((x) => x * 10) |> identity
  println(int.to_string(p))
}
