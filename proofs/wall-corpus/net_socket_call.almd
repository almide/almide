// @wall: `net.tcp_connect` is not available on --target wasm
// TCP sockets are a host capability with no WASI preview-1 surface in the
// structural leg's import set. Since the availability ledger covers the whole
// public surface (#1827), the refusal is the E081 availability diagnostic at
// check time — one per net.* call, naming the module's missing host binding —
// rather than the emitter's unlinked-name wall. Graduates with a sockets story
// (wasi p2 or a host op), never silently.
import net

effect fn main() -> Unit = {
  let s = net.tcp_connect("127.0.0.1", 1)!
  net.tcp_write(s, bytes.from_string("ping"))!
  net.tcp_close(s)!
}
