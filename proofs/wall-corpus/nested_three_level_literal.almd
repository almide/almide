// @wall: non-empty List[heap] literal with nested-ownership elements
// A THREE-level list literal (`List[List[List[Int]]]`): each outer element
// is itself a list-of-lists — nested ownership the literal builder cannot
// materialize faithfully (storing the inner towers needs per-level Dup/drop
// routing no generated drop names). Two-level `[[1,2],[]]` lowers and votes
// (spec/wasm_cross/nested_list_list_int.almd); the third level is where the
// brick ends today. Admitting it would emit an empty or leaking tower.
fn main() -> Unit = {
  let tower: List[List[List[Int]]] = [[[1, 2], [3]], [[4]]]
  let flat = list.fold(tower, 0, (a, mid) =>
    a + list.fold(mid, 0, (b, leaf) => b + list.fold(leaf, 0, (c, x) => c + x)))
  println(int.to_string(flat))
}
