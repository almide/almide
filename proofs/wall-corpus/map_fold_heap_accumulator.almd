// @wall: map.fold_hacc
// `map.fold` with a HEAP accumulator (here a `List[String]` grown per
// entry): the fold generic is registered for scalar accumulators only —
// the heap-acc variant routes to the unregistered `_hacc` name, because
// linking the scalar one would treat the accumulator handle as a plain
// i64 and leak/corrupt it across iterations. (A scalar accumulator over a
// heap-VALUED map is refused too, as `map.fold_hval_wall` — this specimen
// pins the accumulator flavor, which fires first. Scalar-valued map folds
// vote: spec/wasm_cross/edge_map_order.almd.)
fn main() -> Unit = {
  var m: Map[String, List[Int]] = map.new()
  map.set(m, "a", [1, 2])
  let lines = map.fold(m, [], (acc, k, v) => acc + ["${k}:${int.to_string(list.len(v))}"])
  println(list.join(lines, " "))
}
