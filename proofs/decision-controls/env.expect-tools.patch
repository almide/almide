# Negative control of env.expect-tools (proofs/decision-sites.toml): the workspace no longer arms ALMIDE_EXPECT_TOOLS: a missing tool is a silent skip.
# control_test: tests/decision_expect_tools_test.rs::novel_a_missing_tool_fails_by_default
diff --git a/.cargo/config.toml b/.cargo/config.toml
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -4,4 +4,4 @@
 # CI sets the same switch explicitly; a run that deliberately has no tool sets
 # its own value (an explicit environment value wins: force = false).
 [env]
-ALMIDE_EXPECT_TOOLS = { value = "1", force = false }
+ALMIDE_EXPECT_TOOLS_UNARMED = { value = "1", force = false }
