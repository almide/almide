diff --git a/src/cli/install.rs b/src/cli/install.rs
--- a/src/cli/install.rs
+++ b/src/cli/install.rs
@@ -346,7 +346,7 @@
             "error: --trust {t} does not match the owner of {src} ({owner})\n  hint: --trust must name the owner the source belongs to"
