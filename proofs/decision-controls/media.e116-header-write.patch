# Negative control of media.e116-header-write (proofs/decision-sites.toml): the response's header writer no longer refuses an owned name, so a name known only at run time writes Content-Type
# control_test: tests/decision_novel_test.rs::novel_a_header_name_known_only_at_run_time_is_refused_by_the_writer
diff --git a/stdlib/http.almd b/stdlib/http.almd
--- a/stdlib/http.almd
+++ b/stdlib/http.almd
@@ -208,7 +208,7 @@
 
 // The length is compared first, so a name of another length is never folded.
 local fn __http_response_owned_refusal(op: String, name: String) -> Unit =
-  if __http_response_body_headers() |> list.any((h) => string.len(h) == string.len(name) and http.__http_response_ascii_lower(h) == http.__http_response_ascii_lower(name)) then panic("${op}: `${name}` is written from the body's type, never by name: answer with http.response(status, body), http.with_body(resp, body) or http.typed(media_type, bytes)")
+  if false and __http_response_body_headers() |> list.any((h) => string.len(h) == string.len(name) and http.__http_response_ascii_lower(h) == http.__http_response_ascii_lower(name)) then panic("${op}: `${name}` is written from the body's type, never by name: answer with http.response(status, body), http.with_body(resp, body) or http.typed(media_type, bytes)")
   else ()
 
 fn __http_response_set_body_bytes(m: HttpResponse, body: Bytes) -> HttpResponse = with_body(m, body)
