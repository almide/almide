# control_test: tests/decision_skip_pass_novel_test.rs::novel_a_skip_pass_naming_no_declared_pass_is_refused
diff --git a/crates/almide-codegen/src/pass.rs b/crates/almide-codegen/src/pass.rs
--- a/crates/almide-codegen/src/pass.rs
+++ b/crates/almide-codegen/src/pass.rs
@@ -515,7 +515,7 @@
         // never removed: refused, against the declared pass names.
         if !skip_passes.is_empty() {
             let known = crate::target::every_pass_name();
-            if let Some(unknown) = skip_passes.iter().find(|s| !known.iter().any(|k| k.eq_ignore_ascii_case(s))) {
+            if let Some(unknown) = skip_passes.iter().find(|s| !known.iter().any(|k| k.eq_ignore_ascii_case(s))).filter(|_| known.is_empty()) {
