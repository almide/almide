diff --git a/src/dispatch.rs b/src/dispatch.rs
--- a/src/dispatch.rs
+++ b/src/dispatch.rs
@@ -906,9 +906,9 @@
         Commands::Run { locked: true, .. }
             | Commands::Build { locked: true, .. }
             | Commands::Test { locked: true, .. }
