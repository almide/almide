test "hidden: rotate right" { assert_eq(rotate([1, 2, 3], -1), [3, 1, 2]) }
test "hidden: wrap" { assert_eq(rotate([1, 2, 3], 4), [2, 3, 1]) }
test "hidden: wrap negative" { assert_eq(rotate([1, 2, 3], -4), [3, 1, 2]) }
test "hidden: empty" {
  let e: List[Int] = []
  assert_eq(rotate(e, 5) |> list.len, 0)
}
test "hidden: zero" { assert_eq(rotate([1, 2, 3], 0), [1, 2, 3]) }
