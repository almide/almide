test "hidden: exact multiple" { assert_eq(chunk([1, 2, 3, 4], 2), [[1, 2], [3, 4]]) }
test "hidden: empty" {
  let e: List[Int] = []
  assert_eq(chunk(e, 3) |> list.len, 0)
}
test "hidden: n larger than list" { assert_eq(chunk([1, 2], 5), [[1, 2]]) }
test "hidden: seven by three" { assert_eq(chunk([1, 2, 3, 4, 5, 6, 7], 3), [[1], [2, 3, 4], [5, 6, 7]]) }
