test "hidden: repeats inside one input" { assert_eq(merge([1, 1, 2], [2, 3]), [1, 2, 3]) }
test "hidden: empty left" { assert_eq(merge([], [4, 4]), [4]) }
test "hidden: empty right" { assert_eq(merge([5, 5, 6], []), [5, 6]) }
test "hidden: tail repeats" { assert_eq(merge([1, 3], [2, 3, 3]), [1, 2, 3]) }
test "hidden: both empty" { assert_eq(merge([], []) |> list.len, 0) }
