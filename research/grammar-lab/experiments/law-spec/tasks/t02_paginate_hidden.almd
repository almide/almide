test "hidden: last partial page" { assert_eq(page([1, 2, 3, 4, 5, 6, 7], 3, 3), [7]) }
test "hidden: page zero" { assert_eq(page([1, 2, 3, 4, 5, 6, 7], 0, 3) |> list.len, 0) }
test "hidden: negative page" { assert_eq(page([1, 2, 3, 4, 5, 6, 7], -1, 3) |> list.len, 0) }
test "hidden: past the end" { assert_eq(page([1, 2, 3, 4, 5, 6, 7], 4, 3) |> list.len, 0) }
test "hidden: empty list" {
  let e: List[Int] = []
  assert_eq(page(e, 1, 3) |> list.len, 0)
}
test "hidden: count exact" { assert_eq(page_count([1, 2, 3, 4, 5, 6], 3), 2) }
