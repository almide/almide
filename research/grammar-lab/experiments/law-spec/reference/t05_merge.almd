// Merge two ascending lists into one strictly ascending list without repeats.

fn merge(a: List[Int], b: List[Int]) -> List[Int] = dedup(merge_all(a, b))

fn merge_all(a: List[Int], b: List[Int]) -> List[Int] =
  match a {
    [] => b,
    [x, ..xs] => match b {
      [] => a,
      [y, ..ys] => if x <= y then [x] + merge_all(xs, b) else [y] + merge_all(a, ys),
    },
  }

fn dedup(xs: List[Int]) -> List[Int] =
  xs |> list.fold([], (acc, x) => if list.last(acc) == some(x) then acc else acc + [x])
