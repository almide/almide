// Grammar Lab — A/B test runner for Almide syntax variants
// Usage: almide run src/mod.almd -- <experiment-dir> [--model <name>]
//
// Per trial: the model modifies the task source (attempt 1). The gate is the
// visible tests, plus the variant's compiled laws when it has them. When the
// gate fails and the experiment allows a repair round, the gate's output goes
// back to the model once (attempt 2). Every attempt is also judged by the
// task's hidden tests, which the model never sees: a gate pass with a hidden
// fail is "survived but wrong".
import json
import fs
import process
import env
import io

// ── Config ──
effect fn resolve_bin(env_var: String, name: String, fallback: String) -> String =
  match env.get(env_var) {
    some(p) => p,
    none => {
      let r = process.exec_status("which", [name]) ?? process.ProcessStatus { code: 1, stdout: "", stderr: "" }
      if r.code == 0 then string.trim(r.stdout) else fallback
    },
  }

effect fn get_almide_bin() -> String = resolve_bin("ALMIDE_BIN", "almide", "../../target/release/almide")!

// ── Helpers ──
effect fn println(s: String) -> Unit = io.print(s + "\n")

fn jstr(v: Value, key: String) -> String = json.get_string(v, key) ?? ""

fn truncate(s: String, n: Int) -> String =
  if string.len(s) <= n then s else string.slice(s, 0, n) + "\n… (truncated)"

// ── Entry Point ──
effect fn main() -> Unit =
  match run_experiment() {
    ok(_) => (),
    err(e) => {
      println("Error: ${e}")
      process.exit(1)
    },
  }

type Variant = { name: String, transpile_mode: String, with_laws: Bool, layer2: String }

type Task = {
  name: String,
  source: String,
  instruction: String,
  layer3: String,
  tests: String,
  hidden: String,
  laws: String,
  laws_compiled: String,
}

type Ctx = { experiment: String, model_name: String, model_id: String, layer1: String, runtime: String, repair_rounds: Int, out_root: String }

effect fn read_opt(path: String) -> String = if path != "" and fs.exists(path) then fs.read_text(path)! else ""

effect fn load_task(dir: String, name: String) -> Result[Task, String] = {
  let cfg = json.parse(fs.read_text("${dir}/tasks/${name}.json")!)!
  let rel = (key: String) => {
    let f = jstr(cfg, key)
    if f == "" then "" else "${dir}/tasks/${f}"
  }
  ok({
    name: name,
    source: fs.read_text("${dir}/${jstr(cfg, "source_dir")}/${name}.almd")!,
    instruction: jstr(cfg, "instruction"),
    layer3: jstr(cfg, "layer3_hint"),
    tests: fs.read_text(rel("test_file"))!,
    hidden: read_opt(rel("hidden_file"))!,
    laws: read_opt(rel("laws_file"))!,
    laws_compiled: read_opt(rel("laws_compiled_file"))!,
  })
}

effect fn run_experiment() -> Result[Unit, String] = {
  let args = env.args()
  guard list.len(args) >= 1 else err("Usage: grammar-lab <experiment-dir> [--model <name>]")
  let dir = args[0]
  let config = json.parse(fs.read_text("${dir}/experiment.json")!)!
  let experiment = jstr(config, "name")
  let trials = int.parse(parse_cli_string(args, "--trials", "")) ?? (json.get_int(config, "trials") ?? 5)
  let repair_rounds = json.get_int(config, "repair_rounds") ?? 0
  let model_filter = parse_cli_string(args, "--model", "")
  let task_filter = parse_cli_string(args, "--task", "")
  let task_names = json.get_array(config, "tasks") ?? [] |> list.map((t) => value.as_string(t) ?? "") |> list.filter((t) => task_filter == "" or t == task_filter)
  let runtime_path = jstr(config, "runtime_file")
  let runtime = if runtime_path == "" then "" else strip_blocks(fs.read_text("${dir}/${runtime_path}")!)
  let layer1 = fs.read_text("prompts/layer1_rules.md")!
  let variants = json.get_array(config, "variants") ?? [] |> list.map((v) => {
    let name = jstr(v, "name")
    let layer2_path = "prompts/layer2_${name}.md"
    { name: name, transpile_mode: jstr(v, "transpile_regex"), with_laws: json.get_bool(v, "with_laws") ?? false, layer2: layer2_path }
  })
  let tasks = task_names |> list.map((t) => load_task(dir, t)!)!
  let stamp = int.to_string(env.unix_timestamp())
  let out_root = "outputs/${experiment}/${stamp}"
  println("=== Grammar Lab ===")
  println("Experiment: ${experiment}  trials: ${trials}  repair rounds: ${repair_rounds}  outputs: ${out_root}")
  var all_results: List[Value] = []
  for model_json in json.get_array(config, "models") ?? [] {
    let model_name = jstr(model_json, "name")
    if model_filter != "" and model_filter != model_name then continue
    println("Model: ${model_name}")
    let ctx = { experiment: experiment, model_name: model_name, model_id: jstr(model_json, "model_id"), layer1: layer1, runtime: runtime, repair_rounds: repair_rounds, out_root: out_root }
    for trial in 1...trials {
      for task in tasks {
        for variant in variants {
          let layer2 = read_opt(variant.layer2)!
          let r = run_trial(ctx, { name: variant.name, transpile_mode: variant.transpile_mode, with_laws: variant.with_laws, layer2: layer2 }, task, trial)!
          all_results = all_results + [r]
          println("  ${task.name} [${variant.name}] trial ${trial}: ${trial_line(r)}")
        }
      }
    }
  }
  fs.mkdir_p("results")!
  let suffix = if task_filter == "" then "" else "_${task_filter}"
  let results_path = "results/${experiment}_${stamp}${suffix}.json"
  fs.write(results_path, json.stringify_pretty(value.array(all_results)))!
  println("")
  println("Results written to ${results_path}")
  print_summary(all_results)!
  ok(())
}

fn flag(r: Value, key: String) -> Bool = json.get_bool(r, key) ?? false

fn mark(b: Bool) -> String = if b then "pass" else "FAIL"

fn trial_line(r: Value) -> String = {
  let first = "gate ${mark(flag(r, "gate_1"))} hidden ${mark(flag(r, "hidden_1"))}"
  if flag(r, "repaired") then "${first} → repair: gate ${mark(flag(r, "gate_2"))} hidden ${mark(flag(r, "hidden_2"))}" else first
}

// ── One trial ──
effect fn run_trial(ctx: Ctx, variant: Variant, task: Task, trial: Int) -> Result[Value, String] = {
  let system = build_system_prompt(ctx.layer1, variant.layer2, task.layer3)
  let user = build_user_prompt(task, variant.with_laws)
  let out_dir = "${ctx.out_root}/${ctx.model_name}/${variant.name}"
  fs.mkdir_p(out_dir)!
  let tag = "${out_dir}/${task.name}_${trial}"
  let code_1 = attempt(ctx, variant, system, user, "${tag}_1")!
  let gate_1 = evaluate(gate_source(ctx, variant, task, code_1), "${tag}_1_gate")!
  let hidden_1 = evaluate("${code_1}\n\n${task.hidden}", "${tag}_1_hidden")!
  let repaired = not gate_1.passed and ctx.repair_rounds > 0
  let (gate_2, hidden_2) = if repaired then {
    let repair = "${user}\n\n## Your previous answer\n\n```almide\n${code_1}\n```\n\n## Result of checking it\n\n```\n${truncate(gate_1.output, 2500)}\n```\n\nFix the code so every check passes. Return the whole modified file."
    let code_2 = attempt(ctx, variant, system, repair, "${tag}_2")!
    (evaluate(gate_source(ctx, variant, task, code_2), "${tag}_2_gate")!, evaluate("${code_2}\n\n${task.hidden}", "${tag}_2_hidden")!)
  } else (gate_1, hidden_1)
  ok(value.object([
    ("experiment", value.str(ctx.experiment)),
    ("model", value.str(ctx.model_name)),
    ("variant", value.str(variant.name)),
    ("task", value.str(task.name)),
    ("trial", value.int(trial)),
    ("compiled_1", value.bool(gate_1.compiled)),
    ("gate_1", value.bool(gate_1.passed)),
    ("hidden_1", value.bool(hidden_1.passed)),
    ("repaired", value.bool(repaired)),
    ("gate_2", value.bool(gate_2.passed)),
    ("hidden_2", value.bool(hidden_2.passed)),
  ]))
}

effect fn attempt(ctx: Ctx, variant: Variant, system: String, user: String, tag: String) -> Result[String, String] = {
  let response = call_claude_code(ctx.model_id, system, user)!
  let code = strip_blocks(extract_code(response))
  fs.write("${tag}_raw.almd", code)!
  let compilable = transpile(code, variant.transpile_mode)
  fs.write("${tag}_compiled.almd", compilable)!
  ok(compilable)
}

fn gate_source(ctx: Ctx, variant: Variant, task: Task, code: String) -> String =
  if variant.with_laws then "${code}\n\n${ctx.runtime}\n\n${task.tests}\n\n${task.laws_compiled}"
  else "${code}\n\n${task.tests}"

fn build_system_prompt(layer1: String, layer2: String, layer3: String) -> String =
  "You are modifying code written in Almide (.almd files). Return ONLY the modified code in one ```almide block, no explanation.\n\n${layer1}\n\n${layer2}\n\n${layer3}"

fn build_user_prompt(task: Task, with_laws: Bool) -> String = {
  let laws = if with_laws then "\n\n## Laws (must hold for every input; the checker generates inputs and reports a counterexample)\n\n```almide\n${task.laws}\n```" else ""
  "## Current Code\n\n```almide\n${task.source}\n```\n\n## Tests (must pass after modification)\n\n```almide\n${task.tests}\n```${laws}\n\n## Instruction\n\n${task.instruction}"
}

// ── LLM ──
// The model runs from a neutral directory so the repository's CLAUDE.md is not in its context.
effect fn call_claude_code(model_id: String, system: String, user: String) -> Result[String, String] = {
  let claude_bin = resolve_bin("CLAUDE_BIN", "claude", "claude")!
  let neutral = env.get("GRAMMAR_LAB_NEUTRAL_DIR") ?? "/tmp/grammar-lab-neutral"
  fs.mkdir_p(neutral)!
  let r = process.exec_status("/bin/sh", ["-c", "cd \"$0\" && exec \"$@\"", neutral, claude_bin, "-p", "--model", model_id, "--append-system-prompt", system, "--output-format", "text", "--max-turns", "1", user])!
  if r.code != 0 then err("claude-code failed: ${r.stderr}") else ok(r.stdout)
}

// ── Strip test / law blocks the model echoed back (the runner appends its own) ──
fn strip_blocks(code: String) -> String = {
  let lines = string.split(code, "\n")
  var result: List[String] = []
  var depth = 0
  var skipping = false
  for line in lines {
    let t = string.trim(line)
    let starts = not skipping and (string.starts_with(t, "test ") or string.starts_with(t, "law "))
    if starts or skipping then {
      let opens = string.chars(line) |> list.filter((c) => c == "{") |> list.len
      let closes = string.chars(line) |> list.filter((c) => c == "}") |> list.len
      depth = (if starts then 0 else depth) + opens - closes
      skipping = depth > 0
    } else {
      result = result + [line]
    }
  }
  string.join(result, "\n")
}

// ── Transpile ──
fn transpile(code: String, mode: String) -> String =
  match mode {
    "paren-to-fn-lambda" => string.split(code, "\n") |> list.map((line) => transpile_line_paren_to_(line)) |> string.join("\n"),
    "combinator-to-match" => string.split(code, "\n") |> list.map((line) => transpile_line_combinator(line)) |> string.join("\n"),
    _ => code,
  }

fn transpile_line_paren_to_(line: String) -> String = {
  // Generic approach: find ") =>" and look backwards for matching "("
  // If "(" is not preceded by "fn" or a keyword, insert "fn"
  // Handles any parameter names without enumeration
  if not string.contains(line, ") =>") then { line } else {
    // Find all ") =>" positions
    var positions: List[Int] = []
    var si = 0
    let line_len = string.len(line)
    while si + 4 <= line_len {
      if string.slice(line, si, si + 4) == ") =>" then {
        positions = positions + [si]
        si = si + 4
      } else {
        si = si + 1
      }
    }
    if list.len(positions) == 0 then { line } else {
      // For each ") =>" find matching "(" by scanning backwards
      var insert_positions: List[Int] = []
      for close_pos in positions {
        var depth = 1
        var j = close_pos - 1
        var open_pos = -1
        while j >= 0 and depth > 0 {
          let ch = string.slice(line, j, j + 1)
          if ch == ")" then {
            depth = depth + 1
          } else if ch == "(" then {
            depth = depth - 1
            if depth == 0 then {
              open_pos = j
            } else { () }
          } else { () }
          j = j - 1
        }
        if open_pos >= 0 then {
          // Check character before "(" — if alpha/underscore, it's part of a word (some, fn, etc.)
          let skip = if open_pos >= 1 then {
            let prev = string.slice(line, open_pos - 1, open_pos)
            string.contains("abcdefghijklmnopqrstuvwxyz_", prev)
          } else { false }
          if not skip then {
            insert_positions = insert_positions + [open_pos]
          } else { () }
        } else { () }
      }
      // Insert "fn" at positions (reverse order to preserve indices)
      if list.len(insert_positions) == 0 then { line } else {
        let sorted = insert_positions |> list.sort() |> list.reverse()
        var result = line
        for pos in sorted {
          let before = string.slice(result, 0, pos)
          let after = string.slice(result, pos, string.len(result))
          result = before + "fn" + after
        }
        result
      }
    }
  }
}

// ── Combinator-to-match transpile ──
fn find_pos(s: String, sub: String) -> Int = {
  let s_len = string.len(s)
  let sub_len = string.len(sub)
  var i = 0
  var result = -1
  while i + sub_len <= s_len and result < 0 {
    if string.slice(s, i, i + sub_len) == sub then {
      result = i
    } else {
      i = i + 1
    }
  }
  result
}

fn replace_all_str(s: String, old: String, replacement: String) -> String = if not string.contains(s, old) then {
  s
} else {
  let parts = string.split(s, old)
  string.join(parts, replacement)
}

fn transpile_line_combinator(line: String) -> String = {
  // Step 1: Replace "option.unwrap_or(" with "unwrap_or("
  let line = replace_all_str(line, "option.unwrap_or(", "unwrap_or(")
  // Step 2: Handle |> option.map(fn(...) => ...)
  let line = transpile_pipe_option(line, "option.map", true)
  // Step 3: Handle |> option.flat_map(fn(...) => ...)
  let line = transpile_pipe_option(line, "option.flat_map", false)
  line
}

fn transpile_pipe_option(line: String, call_name: String, wrap_some: Bool) -> String = {
  let marker = "|> ${call_name}(fn("
  if not string.contains(line, marker) then { line } else {
    let marker_pos = find_pos(line, marker)
    if marker_pos < 0 then { line } else {
      let pipe_pos = marker_pos
      // Position of opening "(" after call_name: "|> " + call_name + "("
      let open_paren_pos = marker_pos + string.len("|> ") + string.len(call_name)
      // Find matching ")" using bracket matching
      var depth = 1
      var i = open_paren_pos + 1
      let line_len = string.len(line)
      var close_pos = -1
      while i < line_len and depth > 0 {
        let ch = string.slice(line, i, i + 1)
        if ch == "(" then {
          depth = depth + 1
        } else if ch == ")" then {
          depth = depth - 1
          if depth == 0 then {
            close_pos = i
          } else { () }
        } else { () }
        i = i + 1
      }
      if close_pos < 0 then { line } else {
        // Content between parens is "fn(PARAM) => BODY"
        let content = string.slice(line, open_paren_pos + 1, close_pos)
        let fn_prefix = "fn("
        if not string.starts_with(content, fn_prefix) then { line } else {
          let after_fn = string.slice(content, string.len(fn_prefix), string.len(content))
          // Find ") => " to separate param from body
          let arrow_pos = find_pos(after_fn, ") => ")
          if arrow_pos < 0 then { line } else {
            let param = string.slice(after_fn, 0, arrow_pos)
            let body = string.slice(after_fn, arrow_pos + 5, string.len(after_fn))
            let match_expr = if wrap_some then {
              "|> match { some(${param}) => some(${body}), none => none }"
            } else {
              "|> match { some(${param}) => ${body}, none => none }"
            }
            let before = string.slice(line, 0, pipe_pos)
            let after = string.slice(line, close_pos + 1, line_len)
            before + match_expr + after
          }
        }
      }
    }
  }
}

// ── Code Extraction ──
fn extract_code(response: String) -> String = {
  let lines = string.split(response, "\n")
  var in_block = false
  var code_lines: List[String] = []
  for line in lines {
    if string.starts_with(line, "```almide") then in_block = true
    else if in_block and string.starts_with(line, "```") then in_block = false
    else if in_block then code_lines = code_lines + [line]
    else ()
  }
  if list.len(code_lines) == 0 then response else string.join(code_lines, "\n")
}

// ── Evaluation ──
type EvalResult = { compiled: Bool, passed: Bool, output: String }

effect fn evaluate(code: String, tag: String) -> Result[EvalResult, String] = {
  let path = "${tag}.almd"
  fs.write(path, code)!
  let bin = get_almide_bin()!
  let check_r = process.exec_status(bin, ["check", path])!
  if check_r.code != 0 then ok({ compiled: false, passed: false, output: check_r.stdout + check_r.stderr })
  else {
    let test_r = process.exec_status("perl", ["-e", "alarm shift; exec @ARGV", "120", bin, "test", path])!
    ok({ compiled: true, passed: test_r.code == 0, output: test_r.stdout + test_r.stderr })
  }
}

// ── Summary ──
fn count(results: List[Value], model: String, variant: String, key: String) -> (Int, Int) = {
  let rows = results |> list.filter((r) => jstr(r, "model") == model and jstr(r, "variant") == variant)
  (rows |> list.filter((r) => flag(r, key)) |> list.len, list.len(rows))
}

fn wrong_survivors(results: List[Value], model: String, variant: String, gate: String, hidden: String) -> Int =
  results |> list.filter((r) => jstr(r, "model") == model and jstr(r, "variant") == variant and flag(r, gate) and not flag(r, hidden)) |> list.len

fn cell(p: (Int, Int)) -> String = {
  let (passed, total) = p
  let pct = if total > 0 then passed * 100 / total else 0
  string.pad_end("${pct}% (${passed}/${total})", 16, " ")
}

effect fn print_summary(results: List[Value]) -> Unit = {
  println("=== Summary ===")
  let models = results |> list.map((r) => jstr(r, "model")) |> list.unique
  let variants = results |> list.map((r) => jstr(r, "variant")) |> list.unique
  let tasks = results |> list.map((r) => jstr(r, "task")) |> list.unique
  let metrics = [("gate_1", "gate, 1st"), ("hidden_1", "hidden, 1st"), ("gate_2", "gate, final"), ("hidden_2", "hidden, final")]
  for model in models {
    println("")
    println("Model: ${model}")
    println(string.pad_end("", 26, " ") + (variants |> list.map((v) => string.pad_end(v, 16, " ")) |> string.join("")))
    for (key, label) in metrics {
      println(string.pad_end("  ${label}", 26, " ") + (variants |> list.map((v) => cell(count(results, model, v, key))) |> string.join("")))
    }
    println(string.pad_end("  survived but wrong, 1st", 26, " ") + (variants |> list.map((v) => string.pad_end(int.to_string(wrong_survivors(results, model, v, "gate_1", "hidden_1")), 16, " ")) |> string.join("")))
    println(string.pad_end("  survived but wrong, fin", 26, " ") + (variants |> list.map((v) => string.pad_end(int.to_string(wrong_survivors(results, model, v, "gate_2", "hidden_2")), 16, " ")) |> string.join("")))
    println("  hidden, final by task:")
    for task in tasks {
      let cells = variants |> list.map((v) => {
        let rows = results |> list.filter((r) => jstr(r, "model") == model and jstr(r, "variant") == v and jstr(r, "task") == task)
        cell((rows |> list.filter((r) => flag(r, "hidden_2")) |> list.len, list.len(rows)))
      })
      println(string.pad_end("    ${task}", 26, " ") + string.join(cells, ""))
    }
    if list.len(variants) == 2 then {
      for (key, label) in metrics {
        let (p1, t1) = count(results, model, variants[0], key)
        let (p2, t2) = count(results, model, variants[1], key)
        let p = fishers_exact_p(p1, t1 - p1, p2, t2 - p2)
        println("  Fisher (${label}): p = ${float.to_fixed(p, 4)}")
      }
    } else ()
  }
}

// ── Fisher's Exact Test ──
fn log_choose(n: Int, k: Int) -> Float = {
  // log(C(n, k)) = log_gamma(n+1) - log_gamma(k+1) - log_gamma(n-k+1)
  math.log_gamma(int.to_float(n + 1)) - math.log_gamma(int.to_float(k + 1)) - math.log_gamma(int.to_float(n - k + 1))
}

fn hypergeometric_log_pmf(a: Int, b: Int, c: Int, d: Int) -> Float = {
  // P(X=a) for 2x2 table [[a,b],[c,d]]
  let n = a + b + c + d
  log_choose(a + b, a) + log_choose(c + d, c) - log_choose(n, a + c)
}

fn fishers_exact_p(a: Int, b: Int, c: Int, d: Int) -> Float = {
  // Two-tailed Fisher's exact test
  // Sum probabilities of all tables as or more extreme than observed
  let n = a + b + c + d
  let r1 = a + b
  // row 1 total
  let c1 = a + c
  // col 1 total
  let observed_log_p = hypergeometric_log_pmf(a, b, c, d)
  let observed_p = math.exp(observed_log_p)
  // Enumerate all possible values of a (0..min(r1, c1))
  let max_a = math.min(r1, c1)
  var p_value = 0.0
  for i in 0...max_a {
    let bi = r1 - i
    let ci = c1 - i
    let di = n - r1 - ci
    if bi >= 0 and ci >= 0 and di >= 0 then {
      let log_pi = hypergeometric_log_pmf(i, bi, ci, di)
      let pi = math.exp(log_pi)
      // Include if probability <= observed (two-tailed)
      if pi <= observed_p + 0.0000001 then {
        p_value = p_value + pi
      } else { () }
    } else { () }
  }
  // Clamp to [0, 1]
  math.fmin(1.0, p_value)
}

// ── CLI Helpers ──
fn parse_cli_string(args: List[String], flag_name: String, fb: String) -> String =
  match list.index_of(args, flag_name) {
    some(i) => list.get(args, i + 1) ?? fb,
    none => fb,
  }
