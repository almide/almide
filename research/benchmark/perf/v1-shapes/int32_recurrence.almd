// v1-vs-v0 shape bench: a sized-int recurrence that does not fold — two
// Int32 values feeding each other through `+`/`-`/`*` at the declared width
// (the narrow ring ops and the narrow call ABI, #4006).
fn step(x: Int32, y: Int32) -> Int32 = x * 31 + y

fn back(x: Int32, y: Int32) -> Int32 = x * 17 - y

fn main() -> Unit = {
  var h: Int32 = 7
  var g: Int32 = 3
  var i = 0
  while i < 3000000 {
    h = step(h, g)
    g = back(g, h)
    i = i + 1
  }
  println(int32.to_string(h + g))
}
