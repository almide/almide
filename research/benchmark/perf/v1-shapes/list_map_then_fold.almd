// v1-vs-v0 shape bench: a list.map and a list.fold over two lets, which no
// fusion joins. The map is one collect from the source's iterator and the
// fold a for over the list: 1.78x v0 as an indexed loop with a push.
fn build(n: Int) -> List[Int] = {
  var xs: List[Int] = []
  var i = 0
  while i < n {
    xs = xs + [i * 3]
    i = i + 1
  }
  xs
}

fn main() -> Unit = {
  let n = list.len(list.range(0, 200)) * 1000
  let xs = build(n)
  let ys = xs |> list.map((x) => x + 1)
  let s = ys |> list.fold(0, (acc, y) => acc + y)
  println(int.to_string(s))
}
