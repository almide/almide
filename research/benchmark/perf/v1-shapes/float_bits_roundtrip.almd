// v1-vs-v0 shape bench: the raw float bit reinterpret both ways in a loop —
// `float.to_bits` of a computed f64 and `float.from_bits` of an Int lane
// (render_native_float_op's FloatBits arm over an F64 and an I64 operand).
fn mix(x: Float, k: Int) -> Int = float.to_bits(x * 1.5 + float.from(k))

fn main() -> Unit = {
  var acc = 0
  var f = 0.25
  var i = 0
  while i < 200000 {
    let b = mix(f, i)
    acc = int.bxor(acc, b)
    f = float.from_bits(int.band(b, 4607182418800017407))
    i = i + 1
  }
  println(int.to_string(acc))
}
