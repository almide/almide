// v1-vs-v0 shape bench (scripts/check-native-v1-perf-shapes.sh): an
// interpolation piece built once at the top level whose chain (the key) a
// call inside the loop reads, so the render keeps the piece's scheduled
// release instead of releasing it right after its last reader
// (render_native_tail::last_top_level_read).
fn weight(key: String, n: Int) -> Int = string.len(key) + n % 3

fn main() -> Unit = {
  let a1: String = "k${1}"
  var acc = 0
  var i = 0
  while i < 200000 {
    acc = acc + weight(a1, i)
    i = i + 1
  }
  println(int.to_string(acc))
}
