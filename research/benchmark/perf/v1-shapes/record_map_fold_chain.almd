// v1-vs-v0 shape bench: a record built by a map fused into a fold. Each
// pass binds the record and releases it after the fold step (the drill
// fused-release-lost pins that release). It read 4.8x v0 before fusion.
type P = { x: Int, y: Int }

fn main() -> Unit = {
  let n = list.len(list.range(0, 200)) * 1000
  let s = list.range(0, n) |> list.map((i) => { x: i, y: i * 3 }) |> list.fold(0, (acc, p) => acc + p.x + p.y)
  println(int.to_string(s))
}
