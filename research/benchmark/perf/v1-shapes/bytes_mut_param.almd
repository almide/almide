// v1-vs-v0 shape bench: a `mut b: Bytes` param written by stdlib appends.
// The certified render takes `b` as a writable borrow (`&mut`, #4491) and
// edits the caller's buffer in place, as v0 does. Before that it edited a
// copy on each call (1.37x v0's instructions) and the call walled to v0. The
// bench keeps the shape timed: if the copy comes back, it reads over the gate.
fn rec(mut b: Bytes, x: Int) -> Unit = {
  bytes.append_u16_le(b, x)
  bytes.append_u32_le(b, x * 7)
}

fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 100000 {
    var b = bytes.zeros(0)
    var i = 0
    while i < 4 {
      rec(b, r + i)
      i = i + 1
    }
    total = total + bytes.len(b)
    r = r + 1
  }
  println(int.to_string(total))
}
