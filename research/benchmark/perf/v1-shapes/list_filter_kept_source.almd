// v1-vs-v0 shape bench (scripts/check-native-v1-perf.sh, #4006): a string
// list filtered on every turn of a loop from a source list that lives on, so
// each kept element is a copy of a string the source still holds.
fn main() -> Unit = {
  let src = string.to_list("abcdefghij")
  var i = 0
  var acc = 0
  while i < 20000 {
    let kept = list.filter(src, (c) => c != "e")
    acc = acc + list.len(kept) + list.len(src)
    i = i + 1
  }
  println("${acc}")
}
