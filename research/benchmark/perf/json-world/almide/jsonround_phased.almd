// jsonround with each phase timed inside the program (datetime.monotonic_ns).
// Line 1 is the same line jsonround.almd prints; line 2 is the phase split.
import json

let n = 50000

fn record(i: Int) -> Value = value.object([
  ("id", value.int(i)),
  ("name", value.string("user_${i}")),
  ("tags", value.array([value.string("t${i % 7}"), value.string("t${i % 11}")])),
  ("meta", value.object([
    ("score", value.int((i * 37) % 1000)),
    ("active", value.bool(i % 2 == 0)),
  ])),
])

fn score(r: Value) -> Int =
  value.get_int(value.get(r, "meta") ?? value.null(), "score") ?? 0

effect fn main() -> Unit = {
  let t0 = datetime.monotonic_ns()
  let doc = value.array(list.range(0, n) |> list.map(record))
  let t1 = datetime.monotonic_ns()
  let text = json.stringify(doc)
  let t2 = datetime.monotonic_ns()
  let back = json.parse(text) ?? value.null()
  let t3 = datetime.monotonic_ns()
  let sum = (value.as_array(back) ?? []) |> list.map(score) |> list.sum
  let t4 = datetime.monotonic_ns()
  println("${sum} ${string.len(text)}")
  println("PHASES build=${t1 - t0} stringify=${t2 - t1} parse=${t3 - t2} sum=${t4 - t3}")
}
