// globalread (#4562): the per-frame lookups of a text renderer's glyph cache.
// Every glyph of a frame reads its entry from a 1,024-entry map and its advance
// from a 256-entry list; a frame is 2,000 glyphs. The argument is `mode:frames`.
// `g` keeps the map and the list in module-level `var`s, the shape a renderer
// keeps its caches in, and reads them from a helper fn per glyph; `l` passes
// the same map and list to the same helper as parameters. The two rows do the
// same lookups, so their relation (check-perf-ratio.sh, GLOBAL READ) is what a
// read through the module-level var costs over a parameter. 0.69.1 copied the
// whole map (and the whole list) natively on every lookup through the var.
import env

let GLYPHS = 2000

var cache: Map[Int, Int] = map.new()
var advances: List[Int] = []

fn glyph_global(gid: Int) -> Int = (map.get(cache, gid) ?? 0) + (list.get(advances, gid % 256) ?? 0)

fn glyph_local(c: Map[Int, Int], adv: List[Int], gid: Int) -> Int = (map.get(c, gid) ?? 0) + (list.get(adv, gid % 256) ?? 0)

fn gid_of(i: Int, f: Int) -> Int = (i * 7 + f) % 1024

fn run_global(frames: Int) -> Int = {
  for i in 0..<1024 {
    cache = map.set(cache, i, i * 3)
  }
  advances = list.range(0, 256)
  var sum = 0
  for f in 0..<frames {
    for i in 0..<GLYPHS {
      sum = sum + glyph_global(gid_of(i, f))
    }
  }
  sum
}

fn run_local(frames: Int) -> Int = {
  var c: Map[Int, Int] = map.new()
  for i in 0..<1024 {
    c = map.set(c, i, i * 3)
  }
  let adv = list.range(0, 256)
  var sum = 0
  for f in 0..<frames {
    for i in 0..<GLYPHS {
      sum = sum + glyph_local(c, adv, gid_of(i, f))
    }
  }
  sum
}

effect fn main() -> Unit = {
  let parts = string.split(list.get(env.args(), 0) ?? "g:10", ":")
  let mode = list.get(parts, 0) ?? "g"
  let frames = int.parse(list.get(parts, 1) ?? "") ?? 10
  let sum = if mode == "g" then run_global(frames) else run_local(frames)
  println("frames=${frames} sum=${sum}")
}
