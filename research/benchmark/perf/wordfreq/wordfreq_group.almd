// wordfreq, idiomatic spelling — the same workload as wordfreq.almd written
// the way docs/CHEATSHEET.md recommends: `list.group_by` + `map.map` instead
// of `var` + `for` + `m[w] = …`. Identical vocabulary, draws, sort and output;
// only the aggregation differs, so the spread between this row and
// `wordfreq` is what the recommended idiom costs on the native leg (T5:
// recommended = fastest, or the guidance is wrong). Reported beside the
// imperative row against the same Rust reference.
import env
import int

let vocab_size = 5000
let modulus = 2147483648

fn next(s: Int) -> Int = (s * 1103515245 + 12345) % modulus

fn letters(s: Int, k: Int, acc: String) -> String =
  if k == 0 then acc
  else {
    let s2 = next(s)
    letters(s2, k - 1, acc + string.from_codepoint(97 + (s2 / 65536) % 26))
  }

fn word_of(i: Int) -> String = {
  let s = next(i * 7919 + 17)
  letters(s, 3 + (s / 65536) % 6, "")
}

fn draw(i: Int) -> Int = (next(next((i * 2654435761 + 1) % modulus)) / 65536) % vocab_size

effect fn main() -> Unit = {
  let args = env.args()
  let n = match list.get(args, 0) {
    some(s) => match int.parse(s) {
      ok(v) => v,
      err(_) => 2000000,
    },
    none => 2000000,
  }
  let vocab = list.range(0, vocab_size) |> list.map(word_of)
  let counts = list.range(0, n)
    |> list.map((i) => vocab[draw(i)])
    |> list.group_by((w) => w)
    |> map.map((ws) => list.len(ws))
  let top = map.entries(counts)
    |> list.sort_by(((w, c)) => (0 - c, w))
    |> list.take(10)
  for (w, c) in top {
    println("${w} ${c}")
  }
}
