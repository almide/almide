// ADR-0001 S3 operator algebra, pinned at UNIT precision via the budget
// boundary (heavy(1000) = 1002 units = 3006ns at CM-1 v0.3):
//   +  : 3000+6 = 3006 ok / 3000+5 = 3005 exhaust
//   -  : 3011-5 = 3006 ok / 3011-6 = 3005 exhaust / 100-200 = 0-saturated
//   *  : 501*6 = 3006 ok (both operand orders) / minus 1ns = exhaust
//   +MAX: overflowing sum saturates (admits everything)
//   <  : same-clock Ord
// Digits print with a leading 9 so zeros survive int printing.
fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n { acc = (acc + i * 7) % 999983; i = i + 1 }
  acc
}

effect fn main() -> Unit = {
  let f = (r: Int) => if r == -1 then 1 else 0
  let add_ok = fan.bounded(compute.ns(3000) + compute.ns(6)) { heavy(1000) } ?? -1
  let add_ex = fan.bounded(compute.ns(3000) + compute.ns(5)) { heavy(1000) } ?? -1
  let sub_ok = fan.bounded(compute.ns(3011) - compute.ns(5)) { heavy(1000) } ?? -1
  let sub_ex = fan.bounded(compute.ns(3011) - compute.ns(6)) { heavy(1000) } ?? -1
  let sub_sat = fan.bounded(compute.ns(100) - compute.ns(200)) { heavy(1000) } ?? -1
  let mul_ok = fan.bounded(compute.ns(501) * 6) { heavy(1000) } ?? -1
  let mul_ok2 = fan.bounded(6 * compute.ns(501)) { heavy(1000) } ?? -1
  let mul_ex = fan.bounded(compute.ns(501) * 6 - compute.ns(1)) { heavy(1000) } ?? -1
  let add_sat = fan.bounded(compute.h(9000000000000) + compute.h(9000000000000)) { heavy(1000) } ?? -1
  let cmp = if compute.ms(2) < compute.ms(3) then 0 else 1
  println(int.to_string(900000 + f(add_ok) * 10000 + f(add_ex) * 1000 + f(sub_ok) * 100 + f(sub_ex) * 10 + f(sub_sat)))
  println(int.to_string(900000 + f(mul_ok) * 10000 + f(mul_ok2) * 1000 + f(mul_ex) * 100 + f(add_sat) * 10 + cmp))
}
