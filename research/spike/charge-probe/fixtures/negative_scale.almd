// ADR-0001 S3: a NEGATIVE scale factor in `T * Int` is the same deterministic
// abort class as a negative constructor argument — identical on both targets.
fn work() -> Int = 42

fn pick(n: Int) -> Int = n - 5

effect fn main() -> Unit = {
  let r = fan.bounded(compute.ms(5) * pick(3)) { work() } ?? -1
  println(int.to_string(r))
}
