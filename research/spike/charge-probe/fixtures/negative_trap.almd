// ADR-0001 S3 / S6-2: a NEGATIVE time-constructor argument is a deterministic
// abort (§13 convention: "Error: ..." on stderr + exit 1) — identical on both
// targets. The argument flows through a call so the guard is the runtime one,
// not the compile-time literal fold.
fn work() -> Int = 42

fn pick(n: Int) -> Int = n - 10

effect fn main() -> Unit = {
  let r = fan.bounded(compute.us(pick(5))) { work() } ?? -1
  println(int.to_string(r))
}
