// Exact winner-appearance boundary at CM-1 v0.3 (3ns/unit): the eventual
// winner heavy(500) spends 502 units = 1506ns, so the race has no admitted
// arm through ns=1505 and produces the arm-1 winner from ns=1506 — the same
// nanosecond on both targets.
fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n { acc = (acc + i * 7) % 999983; i = i + 1 }
  acc
}

effect fn main() -> Unit = {
  var ns = 1500
  while ns < 1512 {
    let r = fan.race(compute.ns(ns)) { heavy(1000); heavy(500) } ?? -1
    let flag = if r == -1 then 1 else 0
    println(int.to_string(ns * 10 + flag))
    ns = ns + 1
  }
}
