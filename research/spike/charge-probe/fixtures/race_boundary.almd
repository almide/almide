fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n { acc = (acc + i * 7) % 999983; i = i + 1 }
  acc
}

effect fn main() -> Unit = {
  var us = 20
  while us < 35 {
    let r = fan.race(compute.us(us)) { heavy(1000); heavy(500) } ?? -1
    let flag = if r == -1 then 1 else 0
    println(int.to_string(us * 10 + flag))
    us = us + 1
  }
}
