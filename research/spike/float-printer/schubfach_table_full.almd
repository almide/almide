// schubfach (table variant) — Schubfach (Giulietti, "The Schubfach way to render doubles") with the 126-bit
// power-of-ten constant g(j) = floor(10^j * 2^-r) + 1 (r = floor(log2 10^j) - 125) DERIVED AT
// RUN TIME by exact big-integer arithmetic instead of read from the 617-entry table:
//   j >= 0: P = 10^j as a bignum (chunked *10^9), g = its top 126 bits (+1)
//   j <  0: P = 2^N as a bignum, divided by 10^-j (chunked /10^9: floor(floor(x/a)/b) = floor(x/ab)
//           is exact on integers), which leaves exactly the 126 bits of g (+1)
// so the whole "table" is one multiply-by-small and one divide-by-small loop over u32 limbs.
// Same output contract as stdlib/float_to_string.almd (Rust `format!("{}", x)` + the `.0` suffix).
//
// Scratch block (byte offsets from sb = handle(block) + 12):
//   P   @ 0    len word + up to 38 u32 limbs (2^1202 needs 38)     160 bytes
//   G   @ 160  g1 @ +0, g0 @ +8 (two i64 slots, each < 2^63)         16 bytes
//   DP  @ 176  17 decimal digits, written backwards from +196        24 bytes
//   total 200 → prim.alloc_list(26) = 208 bytes.
// ───────────────────────── floor-log helpers (exact over the f64 range, checked offline) ─────────
fn __sf_flog10pow2(e: Int) -> Int = prim.bshr(e * 661971961083, 41)

fn __sf_flog10_3q_pow2(e: Int) -> Int = prim.bshr(e * 661971961083 - 274743187321, 41)

fn __sf_flog2pow10(e: Int) -> Int = prim.bshr(e * 913124641741, 38)

