// E1 small kernel: a bounds-checked indexed loop over a List[Float].
// A 3-point stencil times a half-index gather, summed. Every index is in range
// by construction (1 <= i <= n-2 with n = list.len(xs)), which the checker
// could know from the range and the list's length; the Rust it emits today
// still checks each access.
// Usage: almide run idxloop.almd -- <n> <reps>

import env
import int

fn smooth_dot(xs: List[Float], r: Int) -> Float = {
  let n = list.len(xs)
  var acc = float.from_int(r)
  for i in 1..<n - 1 {
    let s = xs[i - 1] * 0.25 + xs[i] * 0.5 + xs[i + 1] * 0.25
    acc = acc + s * xs[i / 2]
  }
  acc
}

fn arg(args: List[String], k: Int, d: Int) -> Int =
  match list.get(args, k) {
    some(s) => match int.parse(s) { ok(v) => v, err(_) => d },
    none => d,
  }

effect fn main() -> Unit = {
  let args = env.args()
  let n = arg(args, 0, 1000)
  let reps = arg(args, 1, 10)
  let xs = list.map(0..<n, (i) => float.from_int(i * 7919 % 1000) / 1000.0)
  var total = 0.0
  for r in 0..<reps {
    total = total + smooth_dot(xs, r)
  }
  println(float.to_fixed(total, 6))
}
