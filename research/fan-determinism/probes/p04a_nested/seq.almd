// p04a: a fan of fans, every leaf printing on both streams, finishing in
// reverse order. Sequential reading: outer 0 (its leaves in order), outer 1, ...
fn burn(n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = (acc * 31 + i) % 1000003
    i = i + 1
  }
  acc
}

effect fn leaf(o: Int, i: Int, work: Int) -> Result[Int, String] = {
  var k = 0
  var acc = 0
  while k < 10 {
    acc = (acc + burn(work)) % 1000003
    println("leaf ${o}.${i} ${k}")
    if k % 4 == 0 then eprintln("leaf ${o}.${i} e${k}") else ()
    k = k + 1
  }
  ok(acc)
}

effect fn outer(o: Int, work: Int) -> Result[Int, String] = {
  println("outer ${o} start")
  let __seq_r1: Result[Int, String] = leaf(o, 0, work)
  let __seq_r2: Result[Int, String] = leaf(o, 1, 20000)
  let __seq_r3: Result[Int, String] = leaf(o, 2, 0)
  let a = __seq_r1!
  let b = __seq_r2!
  let c = __seq_r3!
  println("outer ${o} end")
  ok((a + b + c) % 1000003)
}

effect fn main() -> Unit = {
  let __seq_r4: Result[Int, String] = outer(0, 200000)
  let __seq_r5: Result[Int, String] = outer(1, 50000)
  let __seq_r6: Result[Int, String] = outer(2, 0)
  let x = __seq_r4!
  let y = __seq_r5!
  let z = __seq_r6!
  println("total ${x} ${y} ${z}")
}
