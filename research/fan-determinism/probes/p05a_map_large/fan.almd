// p05a: fan.map and fan { list.map } over 200k elements with a pure callback
// that prints every ~1000th element (println is allowed in a pure fn,
// ADR-0022): the chunked work-stealing path. Then fan.settle, then a fan.map
// whose elements 3 and 150001 fail: the LOWEST-INDEX Err surfaces.
fn burn(n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = (acc * 31 + i) % 1000003
    i = i + 1
  }
  acc
}

fn heavy(x: Int) -> Int = (burn(x % 50 + 100) + x) % 1000003

effect fn main() -> Unit = {
  let xs = list.range(0, 200000)
  let ys = fan.map(xs, (x) => {
    if x % 997 == 0 then println("map ${x}") else ()
    ok(heavy(x))
  })!
  println("map sum ${list.fold(ys, 0, (a, y) => (a + y) % 1000003)}")
  let zs = fan {
    list.map(xs, (x) => {
      if x % 1009 == 0 then eprintln("lm ${x}") else ()
      heavy(x + 1)
    })
  }
  println("list.map sum ${list.fold(zs, 0, (a, y) => (a + y) % 1000003)}")
  let rs = fan.settle(list.range(0, 50000), (x) => if x % 7777 == 5 then err("bad ${x}") else ok(heavy(x)))
  let bad = list.filter_map(rs, (r) => match r {
    ok(_) => none,
    err(e) => some(e),
  })
  println("settle bad ${list.join(bad, ",")}")
  let ws = fan.map(xs, (x) => {
    if x % 20011 == 0 then println("last ${x}") else ()
    if x == 3 or x == 150001 then err("fail ${x}") else ok(heavy(x))
  })!
  println("unreachable ${list.len(ws)}")
}
