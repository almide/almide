// p07a: the clock. env.sleep_ms and datetime.* are not @ordered, so the arms
// stay threaded. Sequential reading: arm 1 starts after arm 0 ends, so every
// line prints "true".
import env

effect fn sleeper(ms: Int) -> Result[Int, String] = {
  env.sleep_ms(ms)
  ok(datetime.monotonic_ns())
}

effect fn stamp() -> Result[Int, String] = ok(datetime.monotonic_ns())

effect fn wall_sleeper(ms: Int) -> Result[Int, String] = {
  env.sleep_ms(ms)
  ok(datetime.now_ms())
}

effect fn wall_stamp() -> Result[Int, String] = ok(datetime.now_ms())

effect fn main() -> Unit = {
  let (end0, start1) = fan {
    sleeper(150)!
    stamp()!
  }
  println("monotonic: arm 1 started after arm 0 ended: ${start1 >= end0}")
  let (wend0, wstart1) = fan {
    wall_sleeper(150)!
    wall_stamp()!
  }
  println("wall: arm 1 started after arm 0 ended: ${wstart1 >= wend0}")
}
