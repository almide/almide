// p03b: three arms fail; the slowest is arm 0. Sequential reading: every arm
// prints, the LOWEST-INDEX Err ("zero") surfaces, exit 1.
fn burn(n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = (acc * 31 + i) % 1000003
    i = i + 1
  }
  acc
}

effect fn fail(id: Int, work: Int) -> Result[Int, String] = {
  let s = burn(work)
  println("arm ${id} ${s}")
  eprintln("arm ${id} about to fail")
  err("failure ${id}")
}

effect fn fine(id: Int) -> Result[Int, String] = {
  println("arm ${id} fine")
  ok(id)
}

effect fn main() -> Unit = {
  let __seq_r1: Result[Int, String] = fail(0, 3000000)
  let __seq_r2: Result[Int, String] = fine(1)
  let __seq_r3: Result[Int, String] = fail(2, 1000)
  let __seq_r4: Result[Int, String] = fail(3, 0)
  let a = __seq_r1!
  let b = __seq_r2!
  let c = __seq_r3!
  let d = __seq_r4!
  println("unreachable ${a} ${b} ${c} ${d}")
}
