// p16b: process.exit in arm 0 while later arms print at once. Sequential
// reading: arm 0's line, exit 4; nothing of arms 1 and 2.
import process

fn burn(n: Int) -> Int = {
  var acc = 0
  var i = 0
  while i < n {
    acc = (acc * 31 + i) % 1000003
    i = i + 1
  }
  acc
}

effect fn slow(id: Int) -> Result[Int, String] = {
  let s = burn(3000000)
  println("arm ${id} ${s}")
  eprintln("arm ${id} err")
  ok(s)
}

effect fn quit(id: Int, code: Int) -> Result[Int, String] = {
  println("arm ${id} exiting")
  process.exit(code)
}

effect fn fast(id: Int) -> Result[Int, String] = {
  println("arm ${id}")
  eprintln("arm ${id} err")
  ok(id)
}

effect fn main() -> Unit = {
  let __seq_r1: Result[Int, String] = quit(0, 4)
  let __seq_r2: Result[Int, String] = fast(1)
  let __seq_r3: Result[Int, String] = fast(2)
  let a = __seq_r1!
  let b = __seq_r2!
  let c = __seq_r3!
  println("unreachable ${a} ${b} ${c}")
}
