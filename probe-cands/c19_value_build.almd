fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 2000 {
    let v = value.object([("a", value.int(r)), ("b", value.array([value.str("x"), value.int(2)]))])
    let items = value.as_array(value.get(v, "b") ?? value.null()) ?? []
    total = total + list.len(items) + (value.get_int(v, "a") ?? 0)
    r = r + 1
  }
  println(int.to_string(total))
}
