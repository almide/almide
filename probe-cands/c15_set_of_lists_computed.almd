fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 3000 {
    let rows = list.range(0, 4) |> list.map((i) => [i, r % 3])
    let s = set.from_list(rows)
    let inner = list.range(0, 3) |> list.map((i) => set.from_list(list.range(0, i + r % 2)))
    let u = set.from_list(inner)
    total = total + set.len(s) + set.len(u) + (if set.contains(s, [1, r % 3]) then 1 else 0)
    r = r + 1
  }
  println(int.to_string(total))
}
