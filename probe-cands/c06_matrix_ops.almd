fn main() -> Unit = {
  var acc = 0.0
  var r = 0
  while r < 2000 {
    let a = matrix.from_lists([[1.0, 2.0], [3.0, float.from(r % 7)]])
    let b = matrix.scale(a, 2.0)
    let c = matrix.transpose(b)
    acc = acc + (matrix.get(c, 1, 1) ?? 0.0) + float.from(matrix.rows(b) + matrix.cols(c))
    r = r + 1
  }
  println(float.to_string(acc))
}
