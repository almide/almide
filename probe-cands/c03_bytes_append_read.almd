fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 20000 {
    var b = bytes.new()
    bytes.append_u8(b, r % 256)
    bytes.append_u16_le(b, r % 1000)
    bytes.append_f64_le(b, 1.5)
    total = total + bytes.len(b) + (bytes.get_u16_le(b, 1) ?? 0)
    r = r + 1
  }
  println(int.to_string(total))
}
