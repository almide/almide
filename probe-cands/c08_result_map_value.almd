import json

fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 2000 {
    let v = json.parse("{\"a\": ${r}, \"b\": [1, 2]}")
    let n = match v {
      ok(x) => value.get_int(x, "a") ?? 0,
      err(_) => 0,
    }
    total = total + n
    r = r + 1
  }
  println(int.to_string(total))
}
