fn pairs(n: Int) -> List[(String, Int)] = list.range(0, n) |> list.map((i) => (int.to_string(i), i * 2))

fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 3000 {
    let ps = pairs(r % 10)
    let ws = ps + [("z", r)]
    total = total + list.len(ws) + list.fold(ws, 0, (a, p) => a + p.1)
    r = r + 1
  }
  println(int.to_string(total))
}
