type Slot = { key: Option[Int], name: Option[String], n: Int }

fn mk(r: Int) -> Slot = Slot { key: if r % 2 == 0 then some(r) else none, name: some("x"), n: r }

fn main() -> Unit = {
  var total = 0
  var r = 0
  while r < 20000 {
    let s = mk(r)
    total = total + (s.key ?? 0) + s.n + string.len(s.name ?? "")
    r = r + 1
  }
  println(int.to_string(total))
}
