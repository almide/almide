// A pure let-bound lambda passed to an `effect () -> Unit` slot.
type V = { on_click: effect () -> Unit }

fn base() -> V = { on_click: () => () }
fn on_click(v: V, f: effect () -> Unit) -> V = { ...v, on_click: f }

var n = 0

fn view() -> V = {
  let toggle = () => { n = n + 1 }
  base() |> on_click(toggle)
}

@export(wasm, "fire")
effect fn fire() -> Int = {
  view().on_click()!
  n
}

effect fn main() -> Unit = println("${fire()!}")
