@bounded
fn pair_len(i: Int) -> Int = list.len([i, i])

@bounded
fn shape() -> Int = {
  var n = 0
  for i in 0..<4 {
    n = n + pair_len(i)
  }
  n
}

// The declared-amplifier case (E075, owner ruling 2026-11-22): `string.repeat`
// declares `@sized_by(s, n)`, so a run-time `n` sizes its result.
@bounded
fn widen(s: String, n: Int) -> Int = string.len(string.repeat(s, n))

test "a bounded fn allocates per iteration through a callee" {
  assert_eq(shape(), 8)
  assert_eq(widen("ab", 3), 6)
}
