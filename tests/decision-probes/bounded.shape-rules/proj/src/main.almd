// The probe of bounded.shape-rules: a @bounded fn calls, inside a counted
// loop, a @bounded helper that builds a List — the allocation is reached
// through the callee (E071, #4871; the member rule of #4855 has its own
// novel test), and a @bounded fn hands a declared amplifier a run-time
// Int (E075, `@sized_by`).
@bounded
fn pair_len(i: Int) -> Int = list.len([i, i])

@bounded
fn shape() -> Int = {
  var n = 0
  for i in 0..<4 {
    n = n + pair_len(i)
  }
  n
}

// The declared-amplifier case (E075, owner ruling 2026-11-22): `string.repeat`
// declares `@sized_by(s, n)`, so a run-time `n` sizes its result.
@bounded
fn widen(s: String, n: Int) -> Int = string.len(string.repeat(s, n))

effect fn main() -> Unit = println("${shape()} ${widen("ab", 3)}")
