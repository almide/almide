// The probe of fsscope.beneath-walk: a rooted read through a symlink that leads out of the root.
import fs

effect fn main() -> Unit = {
  let base = if fs.is_dir("proj/data") then "proj" else "."
  let root = fs.open_root(base + "/data")!
  match fs.root_read_text(root, "link/s.txt") {
    ok(v) => println("link: ADMITTED ${v}"),
    err(e) => println("link: err ${e}"),
  }
}
