import self.reader

type Reader = { read: (String) -> Result[String, String] }

fn call_it(f: (String) -> Result[String, String]) -> Result[String, String] = f("s.txt")

fn looks_pure(r: Reader) -> Result[String, String] = call_it(r.read)

effect fn probe() -> String = {
  let r = Reader { read: (p) => reader.read(p) }
  looks_pure(r) ?? "none"
}

test "probe" {
  assert_eq(probe()!, "none")
}
