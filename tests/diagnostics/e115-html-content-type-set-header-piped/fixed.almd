// A request may carry any Content-Type: only a served response is guarded.
// The response stays text/plain.
import http

fn page(name: String) -> HttpResponse = http.response(200, name) |> http.set_header("X-Frame-Options", "DENY")

fn upload(body: String) -> HttpRequest = http.new_request("POST", "/pages", body, []) |> http.set_header("Content-Type", "text/html")

fn main() -> Unit = {
  println(http.body(page("guest")))
  println(http.body(upload("<p>draft</p>")))
}
