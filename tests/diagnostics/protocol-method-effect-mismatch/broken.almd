// #1589: effect-ness is part of a generic protocol method's signature.
protocol Store[V] {
  fn get(self) -> V
  fn set(mut self, v: V) -> Unit
}

type Cell: Store[Int] = { v: Int }

effect fn Cell.get(self) -> Int = self.v

fn Cell.set(mut self, v: Int) -> Unit = { self.v = v }

fn main() -> Unit = println("x")
