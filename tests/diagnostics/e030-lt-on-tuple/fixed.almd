// The ordering operators are defined only on scalar orderable types — a
// TUPLE operand has no `<`, even when every element would.
fn earlier(a: (Int, Int), b: (Int, Int)) -> Bool =
  if a.0 == b.0 then a.1 < b.1 else a.0 < b.0

fn main() -> Unit = println(if earlier((1, 2), (1, 3)) then "yes" else "no")
