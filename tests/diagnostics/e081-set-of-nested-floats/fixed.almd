// A Set's membership is its element's `==`, IEEE on every Float inside the
// element; the verified native render carries a nested Float as its bits, so
// the native build route refuses the set (C-464). A List keeps the same
// membership test, `list.contains`.
fn has(s: List[List[Float]], x: Float) -> Bool = list.contains(s, [x])

effect fn main() -> Unit = {
  let s = [[1.5], [2.5]]
  println("${list.len(s)} ${has(s, 1.5)}")
}
