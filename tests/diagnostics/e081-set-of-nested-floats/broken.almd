// A Set's membership is its element's `==`, IEEE on every Float inside the
// element; the verified native render carries a nested Float as its bits, so
// the native build route refuses the set (C-464).
fn has(s: Set[List[Float]], x: Float) -> Bool = set.contains(s, [x])

effect fn main() -> Unit = {
  let s = set.from_list([[1.5], [2.5], [1.5]])
  println("${set.len(s)} ${has(s, 1.5)}")
}
