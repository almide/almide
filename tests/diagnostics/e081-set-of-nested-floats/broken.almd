// A Set's membership is the collection key equality (ALS-C11); the verified
// native render carries a Float two runtime containers deep in an element as
// its bits, with no key equality for it, so the native build route refuses the
// set.
fn has(s: Set[List[List[Float]]], x: Float) -> Bool = set.contains(s, [[x]])

effect fn main() -> Unit = {
  let s = set.from_list([[[1.5]], [[2.5]], [[1.5]]])
  println("${set.len(s)} ${has(s, 1.5)}")
}
