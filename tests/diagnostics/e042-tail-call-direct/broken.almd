// E042: a bare fallible call as the TAIL of a `-> Unit` effect fn (#2182).
// The value is the fn's value, so its error leaves through the fn's own error
// channel unspelled — the same `!` spelling a statement needs (#2277: nothing
// is dropped here, and the message says so).
import fs

effect fn main() -> Unit = {
  println("x")
  fs.remove("b")
}
