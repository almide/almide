// The cycle passes its value on unchanged; the wrapping happens once, outside.
fn a[T](x: T, n: Int) -> Int =
  if n <= 0 then 0
  else b(x, n - 1)

fn b[U](y: U, n: Int) -> Int =
  if n <= 0 then 0
  else c(y, n - 1)

fn c[V](z: V, n: Int) -> Int =
  if n <= 0 then 0
  else 1 + a(z, n - 1)

effect fn main() -> Unit = {
  println(int.to_string(a(some(1), 5)))
}
