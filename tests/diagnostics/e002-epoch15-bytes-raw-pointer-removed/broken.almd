// The deprecated `bytes` raw-pointer spellings left at dialect epoch 15
// (ADR-0031 D4): an address with a caller-typed length is not a value the
// language has. A million-byte read off a 3-byte buffer once passed here.
import ffi

fn main() -> Unit = {
  let b = bytes.from_string("abc")
  let c = bytes.from_raw_ptr(bytes.as_ptr(b), 1000000)
  println(int.to_string(bytes.len(c)))
}
