// The `bytes` raw-pointer spellings left at dialect epoch 15 (ADR-0031 D4):
// an address with a caller-typed length is not a value the language has.
// `bytes.as_ptr(b)` becomes the read-only Region of `b`, which carries its
// length. The arguments are the same but the type is not (RawPtr became
// Region), so `almide fix` leaves the call to the author (#4525).
import ffi

effect fn main() -> Unit = {
  let b = bytes.from_string("abc")
  let c = ffi.read(ffi.region(b), 0, 3)!
  println(int.to_string(bytes.len(c)))
}
