// The fix: a variant error type — the guard becomes a match on structure.
type Fail = | Boom | Other(String)

effect fn risky() -> Result[Int, Fail] = err(Boom)

effect fn describe() -> Result[String, String] = {
  match risky() {
    ok(n) => ok(int.to_string(n)),
    err(Boom) => err("known failure"),
    err(Other(m)) => ok("recovered: ${m}"),
  }
}

effect fn main() -> Unit = println(describe() ?? "none")
