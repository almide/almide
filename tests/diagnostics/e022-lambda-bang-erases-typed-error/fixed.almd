type E: Eq, Repr = | Neg(Int) | Bad(String)

fn step(acc: Int, x: Int) -> Int!E = {
  guard x >= 0 else err(Neg(x))
  acc + x
}

fn total(xs: List[Int]) -> Int!E = xs |> list.fold(
  0,
  (acc, x) => if x == 100 then int.parse("1") |> result.map_err((e) => Bad(e))
  else ok(step(acc, x)!),
)!

test "t" {
  assert_eq(total([1, 100, 2]), ok(3))
}
