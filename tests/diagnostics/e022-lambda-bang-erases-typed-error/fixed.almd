type E: Eq, Repr = | Neg(Int)

fn step(acc: Int, x: Int) -> Int!E = {
  guard x >= 0 else err(Neg(x))
  acc + x
}

fn step_or_skip(acc: Int, x: Int) -> Int!E = if x == 100 then acc
else step(acc, x)!

fn total(xs: List[Int]) -> Int!E = xs |> list.fold(0, (acc, x) => step_or_skip(acc, x)!)!

test "t" {
  assert_eq(total([1, 100, 2]), ok(3))
}
