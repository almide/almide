// A Rust host fn declared to return a Region: the Rust host ABI lends a
// Region in as its `(ptr, len)` for the call, and nothing defines one coming
// back, so the native build route refuses it (C-464).
import ffi

@extern(rust, "crate::host", "make")
fn make(n: Int) -> Region

effect fn main() -> Unit = {
  let r = make(4)
  println(int.to_string(ffi.len(r)))
}
