// A pure fn's closure writing a key of an enclosing `var` Map is a
// mutation of that Map (#3344).
fn counts(ws: List[String]) -> Map[String, Int] = {
  var seen: Map[String, Int] = [:]
  let _ = list.map(ws, (w) => {
    seen[w] = (seen[w] ?? 0) + 1
    w
  })
  seen
}

fn main() -> Unit = println(int.to_string(map.len(counts(["a", "b", "a"]))))
