// #1456: a module name is a qualifier and a file name, so it is ASCII.
// An import alias spelled in a caseless script would read as a type
// (`文書.stringify` as a method of a type `文書`); the parser refuses it
// and names the fix.
import json as 文書

effect fn main() -> Unit = {
  let v = 文書.parse("[1]")!
  println(文書.stringify(v))
}
