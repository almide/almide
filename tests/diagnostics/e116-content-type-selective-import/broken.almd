// E116 (ADR-0032): a bare `with_headers` brought in by a selective import,
// writing CONTENT-TYPE in another case.
import http.{with_headers}

fn report(rows: String) -> HttpResponse = with_headers(200, rows, [("CONTENT-TYPE", "text/plain; charset=utf-8")])

fn main() -> Unit = println(http.body(report("a,b")))
