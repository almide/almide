type E: Eq, Repr = | Neg(Int) | Bad(String)

fn step(acc: Int, x: Int) -> Int!E = {
  guard x >= 0 else err(Neg(x))
  acc + x
}

fn total(xs: List[String]) -> Int!E = xs |> list.fold(
  0,
  (acc, s) => {
    let x = int.parse(s) |> result.map_err((e) => Bad(e))!
    step(acc, x)!
  },
)!

test "t" {
  assert_eq(total(["1", "2"]), ok(3))
}
