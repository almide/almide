// `scaled` keeps a `var` of its own, but hands a closure over it to a user
// fn, which could store it: the closure is its own body, and `c` is outside it.
fn apply(xs: List[Int], f: (Int) -> Int) -> List[Int] = xs |> list.map(f)

fn scaled(xs: List[Int]) -> Int = {
  var c = 10
  c = c + 1
  apply(xs, (x) => x + c) |> list.sum
}

effect fn main() -> Unit = {
  let r = fan.map([1, 2, 3], (x) => ok(scaled([x, x])))!
  println("${list.sum(r)}")
}
