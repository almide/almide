// A stdlib import used ONLY through the type it owns — `IpAddr` in a
// signature, the bare `V4` constructor, no `net.*` call — is USED: the
// type alone pulls the module's declaration into the IR (#1853).
// This broken file adds a genuinely unused import beside it.
import net


fn f(e: IpAddr) -> IpAddr = e

fn main() -> Unit = println("${f(V4(127, 0, 0, 1))}")
