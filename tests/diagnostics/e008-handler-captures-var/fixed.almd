// The handler computes its answer from the request alone, and the app is a
// top-level `let` (an app passed to http.serve reads no local of main: E095).
import http

let app = http.router([
  http.route("GET /", (req) => http.response(200, "path=${http.req_path(req)}"))
])

effect fn main() -> Unit = http.serve(8080, app!)!
