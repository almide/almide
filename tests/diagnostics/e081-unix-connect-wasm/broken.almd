// A Unix-domain socket on `--target wasm`: WASI has no Unix sockets, so the
// stock build route refuses the reachable call at check time (E081) with the
// declared reason, instead of a late render wall.
import unix

effect fn main() -> Unit = {
  let fd = unix.connect("/tmp/almide-e081.sock")!
  println("${unix.select([fd], 0)!}")
}
