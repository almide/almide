// E116 (ADR-0032): a response's Content-Type is its body's type. Written by
// name it would relabel the String body; here as a CSV report.
import http

fn report(rows: String) -> HttpResponse = http.with_headers(200, rows, [("Content-Type", "text/csv"), ("X-Report", "1")])

fn main() -> Unit = println(http.body(report("a,b")))
