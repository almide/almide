// A user `type IpAddr` shadows the stdlib's (#1837): every bare `IpAddr`
// and `Little` below is the program's own declaration, so they use no
// import — `import net` stays unused (#1853).


type IpAddr = | Little | Big

fn f(e: IpAddr) -> IpAddr = e

fn main() -> Unit = println(match f(Little) { Little => "little", Big => "big" })
