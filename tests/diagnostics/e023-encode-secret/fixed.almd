import json
import secret

type LoginInput: Codec = { user: String, password: Secret[String] }

fn main() -> Unit = {
  let x = LoginInput { user: "ana", password: secret.new("hunter2") }
  let out = value.object([("user", value.str(x.user)), ("password", value.str(secret.reveal(x.password)))])
  println(json.stringify(out))
}
