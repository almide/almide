// The real fix is `almide add almide-graphics/nn@v0.2.0 --trust github.com/almide-graphics`, `import nn.kernels` and
// `kernels.from_q1_0_bytes(w, 0, 1, 128)`; this case checks without dependencies,
// so it reads the f32 weights the stdlib still decodes.
fn main() -> Unit = {
  let w = bytes.zeros(512)
  match matrix.from_bytes_f32_le(w, 0, 1, 128) {
    some(m) => println(int.to_string(matrix.cols(m))),
    none => println("short buffer"),
  }
}
