// The BLOCK form of fan.race (arms, no mapper) needs an effect context just
// like the mapper form.
fn probe_a(n: Int) -> Result[Int, String] = ok(n)
fn probe_b(n: Int) -> Result[Int, String] = ok(n + 1)

fn fastest() -> Int = fan.race {
  probe_a(1)
  probe_b(2)
} ?? -1

effect fn main() -> Unit = println(int.to_string(fastest()))
