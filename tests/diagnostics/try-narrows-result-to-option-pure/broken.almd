// #1071: in a pure fn `?` is the Result→Option conversion, not error
// propagation — value.as_string receives an Option[Value] and E005 fires.
// The hint must name that rule, never "declare a type parameter" on a
// stdlib fn the writer does not own.
import json

fn read_tag(s: String) -> String =
  value.as_string(json.parse(s)?) ?? "unknown"

fn main() -> Unit = ()
