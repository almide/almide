// E027: the thunk-list fan.any spelling was removed in Wave 1 — the block
// form is the surface, and it synthesizes the same literal list internally.
effect fn a() -> Result[Int, String] = ok(1)

effect fn b() -> Result[Int, String] = ok(2)

effect fn main() -> Unit = {
  let r = fan.any([() => a(), () => b()])
  println(int.to_string(r))
}
