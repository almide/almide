// process.pid reached through a helper on `--target wasi`: the availability
// verdict scans every REACHABLE body, not only `main`, so a pid behind a
// helper fn is refused at check time (#4913) the same as a direct call.
import process

effect fn instance_id() -> Int = process.pid()

effect fn main() -> Unit = {
  let id = instance_id()
  println("instance > 0: ${id > 0}")
}
