// The fix the hint teaches: name the argument at the conformance.
protocol Repository[T] {
  fn find(self, id: Int) -> Option[T]
}

type User = { id: Int }
type MemStore: Repository[User] = { users: List[User] }

fn MemStore.find(self, id: Int) -> Option[User] =
  self.users |> list.find((u) => u.id == id)

fn main() -> Unit = {
  let s = MemStore { users: [User { id: 1 }] }
  match s.find(1) {
    some(u) => println(int.to_string(u.id)),
    none => println("none"),
  }
}
