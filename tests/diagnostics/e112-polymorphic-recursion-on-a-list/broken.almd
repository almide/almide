// E112 (ADR-0030): `depth` calls itself on a list of its argument, so every
// call depth is a new instance (`List[T]`, `List[List[T]]`, ...).
// Monomorphization stops at the budget.
fn depth[T: Eq](x: T, n: Int) -> Int = if n == 0 then 0 else 1 + depth([x], n - 1)

effect fn main() -> Unit = println("${depth(1, 3)}")
