// E100 (#4043): a 4096-byte write into a 4-byte buffer, in a file with no
// `import ffi`. Native aborted on the corrupted heap; wasm overwrote the
// neighbouring blocks and exited 0. Checked on the wasm route here, where the
// corruption was silent; a `@memory_unsafe` call needs the file's `import ffi`.
fn main() -> Unit = {
  let small = bytes.from_list([1, 2, 3, 4])
  let big = bytes.from_list(list.repeat(65, 4096))
  let n = bytes.copy_to_ptr(big, bytes.as_ptr(small), 4096)
  println(int.to_string(n))
  println(int.to_string(bytes.len(small)))
}
