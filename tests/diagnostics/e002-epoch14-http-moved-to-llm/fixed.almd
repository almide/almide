// The real fix is `almide add almide/llm@v0.1.0`, `import llm` and
// `llm.openai_streaming_call(...)`; this case checks without dependencies, so
// it streams the raw body through the stdlib's generic `http.request_stream`.
import http

effect fn ask(key: String, body: String) -> Unit = http.request_stream(
  "POST",
  "http://127.0.0.1:9/chat/completions",
  body,
  ["Authorization": "Bearer " + key, "Content-Type": "application/json"],
  (chunk) => println(chunk),
)!

effect fn main() -> Unit = ask("k", "{\"stream\": true}")!
