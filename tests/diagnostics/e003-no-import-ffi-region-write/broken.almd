// #4043: a Region write in a file with no `import ffi` (E003: `ffi` is never
// auto-imported), checked on the wasm route. The write is bounds-checked (ADR-0031: a 4096-byte write into a
// 4-byte region is an err), but the import is still the opt-in.
effect fn main() -> Unit = {
  let small = ffi.alloc(4)!
  let big = bytes.from_list(list.repeat(65, 4096))
  let _ = ffi.write(small, 0, big)
  println(int.to_string(ffi.len(small)))
}
