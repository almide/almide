// E043: the list.try_* family was REMOVED (ADR-0006 D3) — the core HOF is
// fallibility-polymorphic: a callback whose body ends in `!` instantiates
// the fallible form (first-err short-circuit); one name per combinator remains.
fn parse1(s: String) -> Result[Int, String] = int.parse(s)

fn main() -> Unit = {
  let r = list.map(["1", "2"], (s) => parse1(s)!)
  println("r=${r ?? []}")
}
