// #2607: `!` on a Result inside a fn returning Option. The fn DOES return a
// carrier; what cannot happen is the Result's error propagating into an
// Option. The message names that, and the fix-it converts first with `?`.
fn first_num(s: String) -> Int? = {
  let n = int.parse(s)?!
  some(n)
}

effect fn main() -> Unit = println(int.to_string(first_num("3") ?? 0))
