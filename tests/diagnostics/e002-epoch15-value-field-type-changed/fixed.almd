// `value.field` left at dialect epoch 15 for `value.get`, which keeps the
// arguments but returns Option[Value], not Result[Value, String]. Renaming
// the callee alone would hand the caller another type, so `almide fix`
// leaves the call to the author (#4525).
effect fn main() -> Unit = {
  let v = value.object([("a", value.int(1))])
  let found = match value.get(v, "a") {
    some(_) => "found",
    none => "missing field 'a'",
  }
  println(found)
}
