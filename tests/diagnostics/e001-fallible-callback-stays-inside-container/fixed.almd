// The fix the hint names: traverse with a stdlib HOF that DOES accept a
// fallible callback (the first-err short-circuit comes with it) — `set.map`
// is one of them since #3163.
fn parse1(s: String) -> Result[Int, String] = int.parse(s)

fn all_parsed(xs: Set[String]) -> Result[Set[Int], String] = set.map(xs, (x) => parse1(x)!)

fn main() -> Unit = println(int.to_string(set.len(all_parsed(set.from_list(["1"])) ?? set.new())))
