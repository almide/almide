// E001: a FALLIBLE callback handed to a HOF that has no fallible form. The
// stdlib HOFs of the fallible matrix (`list.map`, `set.map`, `map.fold`, …) are
// rewritten before inference to their `__fallible_*` carrier, so the traversal
// itself becomes fallible; a USER HOF generic in its callback's result has no
// carrier, so the callback's Result rides through the container and the
// mismatch lands as `Set[Result[..]]` vs `Result[Set[..]]`.
//
// Under the generic "fix the expression type" that dead-ends: nothing says
// which spellings work. The shape is recognizable (a Result one level inside
// the actual where the expected has it outside), so the hint names the HOFs
// that do accept the callback — read from the same table the rewrite reads.
fn parse1(s: String) -> Result[Int, String] = int.parse(s)

fn each_of[A, B](xs: Set[A], f: (A) -> B) -> Set[B] = set.map(xs, f)

fn all_parsed(xs: Set[String]) -> Result[Set[Int], String] = each_of(xs, (x) => parse1(x)!)

fn main() -> Unit = println(int.to_string(set.len(all_parsed(set.from_list(["1"])) ?? set.new())))
