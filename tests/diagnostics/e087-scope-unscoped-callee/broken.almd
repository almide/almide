type Tree = | Leaf | Node(Tree, Tree)

scoped fn make(depth: Int) -> Tree = if depth == 0 then Leaf else Node(
  make(depth - 1),
  make(depth - 1),
)

scoped fn count(t: Tree) -> Int = match t {
  Leaf => 1,
  Node(l, r) => 1 + count(l) + count(r),
}

fn remember(t: Tree) -> Int = count(t)

scoped fn summarize(depth: Int) -> Int = remember(make(depth))

effect fn main() -> Unit = println(int.to_string(scoped {
  summarize(3)
}))
