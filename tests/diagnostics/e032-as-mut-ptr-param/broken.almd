// E032: a helper writes through `bytes.as_mut_ptr` into a buffer it received as
// a plain parameter (#3966). `as_mut_ptr` is `@mutating`, so its receiver is a
// `mut` position like the receiver of `bytes.set_u8`. Before #3966 the checker
// read only `mut b` and missed `@mutating`, so this compiled, and the targets
// disagreed about whether the caller's `let` buffer changed: native wrote
// through, wasm did not.
fn poke(dst: Bytes, src: Bytes) -> Int = bytes.copy_to_ptr(src, bytes.as_mut_ptr(dst), 4)

fn main() -> Unit = {
  var dst = bytes.from_list([0, 0, 0, 0])
  let src = bytes.from_list([1, 2, 3, 4])
  let _ = poke(dst, src)
  println(int.to_string(bytes.get_or(dst, 0, 9)))
}
