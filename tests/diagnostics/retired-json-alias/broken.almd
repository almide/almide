// #1075 -> #1078: the json.* accessor spellings were retired aliases of the
// value.* data model. After the one-release E040 window they were DROPPED —
// this fixture is the executable half of "aliases must not resolve": a
// retired spelling is an ordinary undefined-function error now, never a
// silent resolve and never a warning.
import json

fn main() -> Unit = {
  let n = json.as_int(json.parse("7") ?? value.null())
  println(int.to_string(n ?? 0))
}
