// E110 (row 22, C-436): a `[T: Decode]` wrapper forwards its type parameter to
// the sink without saying it is one, so a caller could hand it a `Codec` type
// and the sink would never see the concrete type.
import http

type NoteInput: Decode = { text: String }

fn body_as[T: Decode](req: HttpRequest) -> Result[T, HttpResponse] = http.decode_json[T](req)

effect fn main() -> Unit = {
  let r: Result[NoteInput, HttpResponse] = body_as(http.new_request("POST", "/n", "{\"text\":\"hi\"}", []))
  println(match r {
    ok(n) => n.text,
    err(bad) => http.body(bad),
  })
}
