// Hosting the closure in an effect fn admits the mutation (#3344).
type Bag = { items: List[Int] }

effect fn gather(xs: List[Int]) -> Int = {
  var b: Bag = { items: [] }
  let _ = list.map(xs, (x) => {
    list.push(b.items, x)
    x
  })
  list.len(b.items)
}

effect fn main() -> Unit = println(int.to_string(gather([1, 2, 3])!))
