// E118 (ADR-0032 Q22): a media type has one owner. text/html is html's, so
// a page is built with html's builders.
import html
import http

type Page: Body = { text: String }

@media_owns("text/html")
fn Page.media_type(self) -> String = "text/html"

fn Page.to_text(self) -> String = self.text

fn main() -> Unit = println(http.body(http.response(200, Page { text: "<p>hi</p>" })))
