// The handler reaches the top-level `var` through a fn it calls.
import http

var hits = 0

effect fn bump() -> Int = {
  hits = hits + 1
  hits
}

effect fn main() -> Unit = {
  let app = http.router([
    http.route("GET /", (req) => http.response(200, "n=${bump()!}"))
  ])!
  http.serve(8080, app)!
}
