pub fn apply(f: std::rc::Rc<dyn Fn(i64) -> i64>, x: i64) -> i64 {
    (f.clone())(x)
}

pub fn main() -> () {
    println!("{}", format!("{}", apply((std::rc::Rc::new(move |x: i64| (x).wrapping_add(1i64)) as std::rc::Rc<dyn Fn(i64) -> i64>), 41i64)))
}
