pub fn apply(f: &dyn Fn(i64) -> i64, x: i64) -> i64 {
    (f)(x)
}

pub fn __almide_main() -> () {
    almide_println!("{}", &AlmideString::from_fmt(format_args!("{}", apply(&|x| (x).wrapping_add(1i64), 41i64))))
}

fn main() {
    #[cfg(all(unix, not(miri)))]
    {
        extern "C" {
            fn signal(sig: i32, handler: usize) -> usize;
        }
        // SIGPIPE = 13, SIG_DFL = 0
        unsafe {
            signal(13, 0);
        }
    }
    #[cfg(all(target_os = "linux", target_env = "gnu", not(miri)))]
    {
        extern "C" {
            fn mallopt(param: i32, value: i32) -> i32;
        }
        // M_TRIM_THRESHOLD = -1, M_MMAP_THRESHOLD = -3 (#4620)
        unsafe {
            mallopt(-1, i32::MAX);
            mallopt(-3, 1 << 30);
        }
    }
    almide_stack_guard_install();
    {
        let __almide_hook = std::panic::take_hook();
        std::panic::set_hook(std::boxed::Box::new(move |info| { almide_stdout_flush(); __almide_hook(info); }));
    }
    __almide_main();
    almide_stdout_finish();
}
