pub fn apply(f: &dyn Fn(i64) -> i64, x: i64) -> i64 {
    (f)(x)
}

pub fn __almide_main() -> () {
    almide_println!("{}", &format!("{}", apply(&|x| (x).wrapping_add(1i64), 41i64)))
}

fn main() {
    #[cfg(unix)]
    {
        extern "C" {
            fn signal(sig: i32, handler: usize) -> usize;
        }
        // SIGPIPE = 13, SIG_DFL = 0
        unsafe {
            signal(13, 0);
        }
    }
    {
        let __almide_hook = std::panic::take_hook();
        std::panic::set_hook(std::boxed::Box::new(move |info| { almide_stdout_flush(); __almide_hook(info); }));
    }
    __almide_main();
    almide_stdout_finish();
}
