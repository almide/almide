pub fn almide_rt_fan_map<A, B>(
    items: Vec<A>,
    f: std::rc::Rc<dyn Fn(A) -> Result<B, AlmideString>>,
) -> Result<Vec<B>, AlmideString> {
    let __almide_r: Result<Vec<B>, AlmideString> = (|| {
        let mut out = Vec::with_capacity(items.len());
        let mut first_err: Option<AlmideString> = None;
        for item in items {
            match (f(item), &first_err) {
                (Ok(v), None) => out.push(v),
                (Err(e), None) => first_err = Some(e),
                _ => {}
            }
        }
        match first_err {
            Some(e) => Err(e),
            None => Ok(out),
        }
    })();
    __almide_r.map_err(Into::into)
}

// `fan.map`'s PARALLEL twin (#2044). RustLowering's fan routing (native only) routes a
// `fan.map` here when its callback is a PURE lambda LITERAL whose element,
// result and captured types are all Send-safe (`is_send_safe_ty` in
// pass_rust_lowering_fan.rs: the scalars, String, List, Set, Map, Result and
// tuples/records of those), or an effect callback whose only effect is a
// nested fan (`Purity::for_fan`). Closure values and every other EFFECT
// callback (its side effects must stay in list order) keep the sequential
// `almide_rt_fan_map`.
// The callback is a raw `impl Fn` (the box pass leaves fan args unboxed), so
// a non-Send capture the pass missed is a loud rustc error, never a race.
//
// Observably identical to the sequential twin: every element runs (ADR-0024
// D1 — no worker stops at an Err), results land in pre-sized slots by index,
// and the map's Err is the LOWEST-INDEX Err in LIST ORDER. No "big list"
// cut-off (a 64-chunk fan over 14 cores would never clear a size threshold):
// the cost model (#3341, list.rs `almide_rt_fan_plan`) goes parallel only
// when the site's measured time per element is worth the offer's cost.
// `ALMIDE_FAN_SEQUENTIAL=1` forces the sequential path — the ablation knob.
//
// Every BLOCK of elements (the dealer's unit, about four per worker) writes
// into its own output timeline (ADR-0024 D5), flushed in list order; inside a
// block the elements run in list order on one thread, so element order holds
// at element granularity for the cost of one registration per block (#3784:
// one per element — a mutex, a flush and a wake — made a light map slower
// than sequential). Every element runs, so no Err cuts the group: a trap in
// element k waits for the blocks below its own and discards everything above
// (ADR-0024 D6, #3779).
pub fn almide_rt_fan_map_par<A: Send + Sync + Clone, B: Send, F: Fn(A) -> Result<B, AlmideString> + Send + Sync>(
    items: Vec<A>,
    f: F,
) -> Result<Vec<B>, AlmideString> {
    items.almide_share();
    // The slots cross threads, so an element's error is held as an owned
    // `String` (Send) and converted once at the boundary.
    let __almide_r: Result<Vec<B>, String> = (|| {
        let mut slots: Vec<Option<Result<B, String>>> = (0..items.len()).map(|_| None).collect();
        if items.len() < 2 || almide_rt_list_par_sequential() {
            for (slot, item) in slots.iter_mut().zip(items) {
                *slot = Some(f(item).map_err(String::from));
            }
            return almide_fan_map_settle_slots(slots);
        }
        // #3341: the cost model (list.rs `almide_rt_fan_plan`) decides from the
        // site's last measured time per element whether this offer is worth a
        // parallel run; every offer records what its elements took.
        let site = almide_rt_fan_map_par::<A, B, F> as fn(Vec<A>, F) -> Result<Vec<B>, AlmideString> as usize;
        let n = items.len();
        let (workers, clock) = AlmideFanClock::offer(site, n);
        if workers < 2 {
            clock.calling(|| {
                for (slot, item) in slots.iter_mut().zip(items) {
                    *slot = Some(f(item).map_err(String::from));
                }
                ((), n)
            });
            clock.record();
            return almide_fan_map_settle_slots(slots);
        }
        let block = almide_fan_block(n, workers);
        // The group flushes this thread's stdout first: a runtime abort on a worker
        // exits without reaching this thread's buffer (C-197, see rust.toml fan_expr).
        // One timeline per BLOCK, dealt in list order (list.rs `almide_fan_deal`).
        let blocks: Vec<_> = items.chunks(block).zip(slots.chunks_mut(block)).enumerate().collect();
        let group = almide_fan_group(blocks.len());
        almide_fan_panic_if_any(almide_fan_deal(blocks, workers, |blocks| {
            for (b, (chunk, out)) in blocks {
                let _blk = almide_fan_enter(&group, b);
                clock.worker(out.iter_mut().zip(chunk.iter()), |(slot, item)| {
                    *slot = Some(f(item.clone()).map_err(String::from));
                    Some(true)
                });
            }
        }));
        clock.record();
        almide_fan_map_settle_slots(slots)
    })();
    __almide_r.map_err(Into::into)
}

// The map's result from its filled slots: the ok values in list order, or the
// LOWEST-INDEX Err (every element ran — ADR-0024 D1).
fn almide_fan_map_settle_slots<B>(slots: Vec<Option<Result<B, String>>>) -> Result<Vec<B>, String> {
    let mut out = Vec::with_capacity(slots.len());
    for slot in slots {
        match slot {
            Some(Ok(v)) => out.push(v),
            Some(Err(e)) => return Err(e),
            // Every worker fills every slot of its chunk.
            None => unreachable!("fan.map_par: an element that never ran"),
        }
    }
    Ok(out)
}

// NO PRODUCER. This is the pre-0.42 thunk-list `fan.race(thunks)`, which
// evaluated only thunk[0]. The call form is now refused with E027
// (static_dispatch.rs), and its successor `fan.min { }` / `fan.min(xs, f)`
// lowers in the frontend to the least-(spend, index) fold, so they never call
// this function. Kept only until the runtime registry drops it.
pub fn almide_rt_fan_race<T>(
    thunks: Vec<impl Fn() -> Result<T, AlmideString>>,
) -> Result<T, AlmideString> {
    let __almide_r: Result<T, AlmideString> = (|| {
        match thunks.into_iter().next() {
            Some(thunk) => thunk(),
            None => Err(AlmideString::from("fan.race: no candidates")),
        }
    })();
    __almide_r.map_err(Into::into)
}

// `fan.any { }` (removed in dialect epoch 14) tries the thunks in LIST ORDER and returns the FIRST `Ok`
// (deterministic — NOT wall-clock fastest). If every candidate fails it returns
// a defined `Err`, never panicking or trapping. Later thunks are never started.
// (`fan.min` is a different selection: least compute spent, tie -> list order.)
pub fn almide_rt_fan_any<T>(
    thunks: Vec<impl Fn() -> Result<T, AlmideString>>,
) -> Result<T, AlmideString> {
    let __almide_r: Result<T, AlmideString> = (|| {
        for thunk in &thunks {
            if let Ok(val) = thunk() {
                return Ok(val);
            }
        }
        Err(AlmideString::from("fan.any: all candidates failed"))
    })();
    __almide_r.map_err(Into::into)
}

// `fan.any(xs, f)` (removed in dialect epoch 14) (internally `any_map`) -- the T2-3 MAPPER form: apply `f` to the items IN LIST ORDER
// and return the FIRST `Ok`; an element's Err disqualifies that element only.
// All-fail (and the empty list) is the ledger-constant Err. Deterministic --
// the early cut is structural (later elements are never evaluated).
pub fn almide_rt_fan_any_map<A, B>(
    items: Vec<A>,
    f: std::rc::Rc<dyn Fn(A) -> Result<B, AlmideString>>,
) -> Result<B, AlmideString> {
    let __almide_r: Result<B, AlmideString> = (|| {
        for item in items {
            if let Ok(v) = f(item) {
                return Ok(v);
            }
        }
        Err(AlmideString::from("fan.any: all candidates failed"))
    })();
    __almide_r.map_err(Into::into)
}

// NO PRODUCER: `fan.settle { }` lowers to a tuple and `fan.settle(xs, f)` to
// `list.map`, both sequential. One output timeline per thunk, flushed in list order (ADR-0024 D5). The
// group flushes this thread's stdout first: a runtime abort on a worker exits
// without reaching this thread's buffer (C-197, see rust.toml fan_expr).
pub fn almide_rt_fan_settle<T: Send + 'static>(
    thunks: Vec<impl Fn() -> Result<T, AlmideString> + Send + Sync>,
) -> Vec<Result<T, AlmideString>> {
    let group = almide_fan_group(thunks.len());
    let group = &group;
    std::thread::scope(|s| {
        let handles: Vec<_> = thunks
            .iter()
            .enumerate()
            .map(|(i, thunk)| s.spawn(move || {
                let _elem = almide_fan_enter(group, i);
                // The error crosses the thread as an owned `String` (Send);
                // the identity while the alias is `String`.
                thunk().map_err(String::from)
            }))
            .collect();
        handles
            .into_iter()
            .map(|h| almide_fan_join(h).map_err(AlmideString::from))
            .collect()
    })
}


// list extern — Rust native implementations
// Signatures match TOML templates: &Vec for read-only, Vec for consuming

pub fn almide_rt_list_len<T>(xs: &[T]) -> i64 { xs.len() as i64 }
pub fn almide_rt_list_is_empty<T>(xs: &[T]) -> bool { xs.is_empty() }
pub fn almide_rt_list_first<A: Clone>(xs: &[A]) -> Option<A> { xs.first().cloned() }
pub fn almide_rt_list_last<A: Clone>(xs: &[A]) -> Option<A> { xs.last().cloned() }
pub fn almide_rt_list_get<T: Clone>(xs: &[T], i: i64) -> Option<T> { xs.get(i as usize).cloned() }
pub fn almide_rt_list_get_or<T: Clone>(xs: &[T], i: i64, default: T) -> T { xs.get(i as usize).cloned().unwrap_or(default) }
pub fn almide_rt_list_contains<T: PartialEq>(xs: &[T], x: T) -> bool { xs.contains(&x) }
pub fn almide_rt_list_index_of<T: PartialEq>(xs: &[T], x: T) -> Option<i64> { xs.iter().position(|v| *v == x).map(|i| i as i64) }
pub fn almide_rt_list_join(xs: &[AlmideString], sep: &str) -> AlmideString { let __almide_out: String = xs.join(sep); __almide_out.into() }
pub fn almide_rt_list_reverse<A: Clone>(xs: &[A]) -> Vec<A> { xs.iter().rev().cloned().collect() }
pub fn almide_rt_list_sort<A: Ord + Clone>(xs: &[A]) -> Vec<A> { let mut v = xs.to_vec(); v.sort(); v }
// Float ordering uses IEEE-754 totalOrder (`f64::total_cmp`): NaN takes its
// totalOrder position (greatest, after +inf; with a -NaN before -inf) and
// `-0.0 < +0.0`. `f64` is not `Ord`, so `list.sort`/`min`/`max` on `List[Float]`
// (and `sort_by` with a Float key) route to these float-specific variants
// instead of the `Ord`-bounded generics (IntrinsicLoweringPass swaps the
// symbol). This is the ORDERING twin of the wasm sign-magnitude bit trick and
// matches the interp's `total_cmp`. NOTE: this list-min/max totalOrder is a
// DIFFERENT contract from the SCALAR `float.min`/`max`/`math.fmin`/`fmax`,
// which keep their C-049 NaN-IGNORING semantics. See C-055.
pub fn almide_rt_list_sort_float(xs: &[f64]) -> Vec<f64> { let mut v = xs.to_vec(); v.sort_by(|a, b| a.total_cmp(b)); v }
pub fn almide_rt_list_min_float(xs: &[f64]) -> Option<f64> { xs.iter().copied().min_by(|a, b| a.total_cmp(b)) }
pub fn almide_rt_list_max_float(xs: &[f64]) -> Option<f64> { xs.iter().copied().max_by(|a, b| a.total_cmp(b)) }
pub fn almide_rt_list_sort_by_float<A: Clone>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> f64>) -> Vec<A> {
    let f = move |a| f(a);
    let mut v = xs;
    v.sort_by(|a, b| f(a.clone()).total_cmp(&f(b.clone())));
    v
}
// `list.sum`/`list.product` follow the language's integer-overflow law:
// TWO'S-COMPLEMENT WRAPPING at runtime, identical to plain `a + b` / `a * b`
// (contract C-001/C-047 family) and byte-identical to wasm's `i64.add`/`i64.mul`.
// Std `Iterator::sum`/`product` would PANIC under `-C overflow-checks` (debug /
// `cargo test`) yet wrap in release — a profile-dependent split that diverges
// from wasm. Folding with the explicit `wrapping_*` ops removes that split, so
// the result is the same on native (any profile) and wasm. See C-056.
pub fn almide_rt_list_sum(xs: &[i64]) -> i64 { xs.iter().fold(0i64, |a, &b| a.wrapping_add(b)) }
pub fn almide_rt_list_sum_float(xs: &[f64]) -> f64 { xs.iter().sum() }
pub fn almide_rt_list_product(xs: &[i64]) -> i64 { xs.iter().fold(1i64, |a, &b| a.wrapping_mul(b)) }
pub fn almide_rt_list_product_float(xs: &[f64]) -> f64 { xs.iter().product() }
pub fn almide_rt_list_min<T: Ord + Clone>(xs: &[T]) -> Option<T> { xs.iter().min().cloned() }
pub fn almide_rt_list_max<T: Ord + Clone>(xs: &[T]) -> Option<T> { xs.iter().max().cloned() }
// chunk/windows are TOTAL (ALS-T4): a NEGATIVE n keeps the historical `as usize`
// wrap (huge → chunk: whole-as-one-chunk / windows: empty), now normative; n == 0
// aborts with the ALS-T6 form (`Error: …` + exit 1) instead of leaking Rust's raw
// `chunks(0)`/`windows(0)` panic (exit 101) — wasm previously even returned len+1
// EMPTY windows silently for `windows(xs, 0)`.
pub fn almide_rt_list_chunk<T: Clone>(xs: &[T], n: i64) -> Vec<Vec<T>> { if n == 0 { almide_abort("chunk size must be positive"); } xs.chunks(n as usize).map(|c| c.to_vec()).collect() }
pub fn almide_rt_list_windows<T: Clone>(xs: &[T], n: i64) -> Vec<Vec<T>> { if n == 0 { almide_abort("window size must be positive"); } if (n as usize) > xs.len() { return vec![]; } xs.windows(n as usize).map(|w| w.to_vec()).collect() }
pub fn almide_rt_list_dedup<T: Clone + PartialEq>(xs: &[T]) -> Vec<T> { let mut r = Vec::new(); for x in xs { if r.last() != Some(x) { r.push(x.clone()); } } r }
// The seen set is an `AlmideMap` (#3704): it hashes only the exact-equality
// key types (Int, String, Bool, their pairs, List[Int] / List[String]) and
// probes every other type by `PartialEq`, so the answer is the old
// `r.contains` scan's — Float `-0.0 == 0.0`, NaN never matches — in O(n)
// for the hashed types where the scan was O(n^2).
pub fn almide_rt_list_unique<T: Clone + PartialEq + 'static>(xs: &[T]) -> Vec<T> {
    let mut seen: AlmideMap<T, ()> = AlmideMap::new();
    let mut r = Vec::new();
    for x in xs {
        if !seen.contains_key(x) { seen.insert(x.clone(), ()); r.push(x.clone()); }
    }
    r
}
pub fn almide_rt_list_set<T: Clone>(xs: &[T], i: i64, x: T) -> Vec<T> { let mut r = xs.to_vec(); if let Some(s) = r.get_mut(i as usize) { *s = x; } r }
pub fn almide_rt_list_swap<T: Clone>(xs: &[T], i: i64, j: i64) -> Vec<T> { let mut r = xs.to_vec(); let (a, b) = (i as usize, j as usize); if a < r.len() && b < r.len() { r.swap(a, b); } r }

// Consuming functions (templates use .to_vec())
pub fn almide_rt_list_map<A, B>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> B>) -> Vec<B> { let f = move |a| f(a); xs.into_iter().map(f).collect() }
pub fn almide_rt_list_filter<A: Clone>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> bool>) -> Vec<A> { let f = move |a| f(a); xs.into_iter().filter(|x| f(x.clone())).collect() }
pub fn almide_rt_list_fold<A, B>(xs: Vec<A>, init: B, f: std::rc::Rc<dyn Fn(B, A) -> B>) -> B { let f = move |a, b| f(a, b); xs.into_iter().fold(init, f) }
pub fn almide_rt_list_find<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> Option<A> { let f = move |a| f(a); xs.iter().find(|x| f((*x).clone())).cloned() }
pub fn almide_rt_list_any<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> bool { let f = move |a| f(a); xs.iter().any(|x| f(x.clone())) }
pub fn almide_rt_list_all<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> bool { let f = move |a| f(a); xs.iter().all(|x| f(x.clone())) }
pub fn almide_rt_list_each<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A)>) { let f = move |a| f(a); for x in xs { f(x.clone()); } }
pub fn almide_rt_list_count<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> i64 { let f = move |a| f(a); xs.iter().filter(|x| f((*x).clone())).count() as i64 }
pub fn almide_rt_list_enumerate<T: Clone>(xs: Vec<T>) -> Vec<(i64, T)> { xs.into_iter().enumerate().map(|(i, x)| (i as i64, x)).collect() }
pub fn almide_rt_list_zip<T: Clone, U: Clone>(a: Vec<T>, b: Vec<U>) -> Vec<(T, U)> { a.into_iter().zip(b.into_iter()).collect() }
pub fn almide_rt_list_zip_with<A: Clone, B: Clone, C>(a: Vec<A>, b: Vec<B>, f: std::rc::Rc<dyn Fn(A, B) -> C>) -> Vec<C> { let f = move |a, b| f(a, b); a.into_iter().zip(b.into_iter()).map(|(x, y)| f(x, y)).collect() }
// Takes a SLICE, not an owned `Vec`. The element type is already `Clone`, so
// consuming the outer list bought nothing — and it made `flatten` unusable
// alongside a borrow of the same binding in one expression:
// `list.get_or(xs, 0, list.flatten(xs))` moved `xs` into `flatten` while
// `get_or` borrowed it, so `check` accepted and rustc rejected with E0505
// (differential fuzz). A slice parameter takes a borrow like every other
// read-only list fn, and an owned `Vec` still deref-coerces into it.
pub fn almide_rt_list_flatten<T: Clone>(xs: &[Vec<T>]) -> Vec<T> { xs.iter().flatten().cloned().collect() }
pub fn almide_rt_list_flat_map<A, B>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> Vec<B>>) -> Vec<B> { let f = move |a| f(a); xs.into_iter().flat_map(f).collect() }
// FIXED-ARITY twin of `almide_rt_list_flat_map`, for the `|x| … [a, b]` shape
// the CHEATSHEET's recommended build idiom produces
// (`list.range |> list.flat_map`). `RustLoweringPass::lower_flat_map_arrays`
// retargets those call sites here and rewrites the tail list literal to a Rust
// ARRAY, which is what makes the difference: the `Rc<dyn Fn(A) -> Vec<B>>`
// signature above forces ONE HEAP ALLOCATION PER ELEMENT for the intermediate
// list, and at 2^22 elements that single `vec![a, b]` was 44 ms of a 79 ms
// build — the whole of the 3x gap between the recommended idiom and a
// hand-written append loop (#1337).
//
// `F: Fn` rather than `Rc<dyn Fn>`: it keeps the per-element call STATIC so
// rustc inlines the body and the arity stays a constant it can unroll (the
// generated `build.rs` registry derives the un-boxing from this `F: Fn` bound
// — see `takes_raw_fn_last_arg`). `with_capacity` removes the growth reallocs
// `flat_map().collect()` cannot avoid, since `FlatMap`'s `size_hint` lower
// bound is 0.
//
// Semantics are identical to `almide_rt_list_flat_map`: same order, same
// elements, same length. Only the intermediate container is gone.
pub fn almide_rt_list_flat_map_arr<A, B, const N: usize, F: Fn(A) -> [B; N]>(xs: Vec<A>, f: F) -> Vec<B> {
    let mut out = Vec::with_capacity(xs.len().saturating_mul(N));
    for x in xs { out.extend(f(x)); }
    out
}
pub fn almide_rt_list_flat_map_effect<A, B>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> Result<Vec<B>, AlmideString>>) -> Result<Vec<B>, AlmideString> { let __almide_r: Result<Vec<B>, String> = (|| { let f = move |a| f(a); let mut r = Vec::new(); for x in xs { r.extend(f(x)?); } Ok(r) })(); __almide_r.map_err(Into::into) }
pub fn almide_rt_list_filter_map<A, B>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> Option<B>>) -> Vec<B> { let f = move |a| f(a); xs.into_iter().filter_map(f).collect() }
pub fn almide_rt_list_find_index<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> Option<i64> { let f = move |a| f(a); xs.iter().position(|x| f(x.clone())).map(|i| i as i64) }
pub fn almide_rt_list_take<T: Clone>(xs: &[T], n: i64) -> Vec<T> { xs.iter().take(n as usize).cloned().collect() }
pub fn almide_rt_list_drop<T: Clone>(xs: &[T], n: i64) -> Vec<T> { xs.iter().skip(n as usize).cloned().collect() }
pub fn almide_rt_list_take_while<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> Vec<A> { let f = move |a| f(a); xs.iter().take_while(|x| f((*x).clone())).cloned().collect() }
pub fn almide_rt_list_drop_while<A: Clone>(xs: &[A], f: std::rc::Rc<dyn Fn(A) -> bool>) -> Vec<A> { let f = move |a| f(a); xs.iter().skip_while(|x| f((*x).clone())).cloned().collect() }
pub fn almide_rt_list_partition<A: Clone>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> bool>) -> (Vec<A>, Vec<A>) { let f = move |a| f(a); xs.into_iter().partition(|x| f(x.clone())) }
pub fn almide_rt_list_group_by<A: Clone, B: PartialEq + Clone + 'static>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> B>) -> AlmideMap<B, Vec<A>> {
    let f = move |a| f(a);
    let mut m: AlmideMap<B, Vec<A>> = AlmideMap::new();
    for x in xs {
        let k = f(x.clone());
        if let Some(g) = m.get_mut(&k) { g.push(x); } else { m.insert(k, vec![x]); }
    }
    m
}
// `map.map(list.group_by(xs, f), (g) => list.len(g))`, fused by PeepholePass:
// the same keys in the same first-seen order with each group's size, without
// building the groups (Kotlin's `groupingBy(f).eachCount()`, Java's
// `groupingBy(f, counting())`). `f` runs once per element in order, as in
// `group_by`; the element is handed to it by value — nothing keeps it — so
// it is never cloned, and no group `Vec` is grown, kept or freed.
pub fn almide_rt_list_group_count<A, B: PartialEq + 'static>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> B>) -> AlmideMap<B, i64> {
    let f = move |a| f(a);
    let mut m: AlmideMap<B, i64> = AlmideMap::new();
    for x in xs {
        m.upsert_with(f(x), 0, |c| c + 1);
    }
    m
}
pub fn almide_rt_list_slice<T: Clone>(xs: &[T], start: i64, end: i64) -> Vec<T> { let s = start as usize; let e = (end as usize).min(xs.len()); if s >= e { vec![] } else { xs[s..e].to_vec() } }
pub fn almide_rt_list_insert<T>(mut xs: Vec<T>, i: i64, x: T) -> Vec<T> { let idx = (i as usize).min(xs.len()); xs.insert(idx, x); xs }
pub fn almide_rt_list_remove_at<T>(mut xs: Vec<T>, i: i64) -> Vec<T> { if (i as usize) < xs.len() { xs.remove(i as usize); } xs }
pub fn almide_rt_list_update<A: Clone>(mut xs: Vec<A>, i: i64, f: std::rc::Rc<dyn Fn(A) -> A>) -> Vec<A> { let f = move |a| f(a); if let Some(s) = xs.get_mut(i as usize) { *s = f(s.clone()); } xs }
pub fn almide_rt_list_intersperse<T: Clone>(xs: Vec<T>, sep: T) -> Vec<T> { let mut r = Vec::new(); for (i, x) in xs.into_iter().enumerate() { if i > 0 { r.push(sep.clone()); } r.push(x); } r }
// Negative counts clamp to 0 (C-054 discipline — the wasm self-host
// `list_repeat` already clamps; `n as usize` on a negative i64 panicked).
//
// A result over the shared 2^31-BYTE ceiling aborts in the T6 form on BOTH
// targets, the same rule `string.repeat` follows (C-161). Without it the two
// legs failed in different ways for a count native can satisfy but wasm cannot:
// `list.repeat(0.0, i32::MAX)` allocated 16 GiB natively and printed a length,
// while the wasm leg — capped at a 4 GiB address space — trapped out-of-bounds
// (differential fuzz). A machine-dependent success on one leg is not an
// observable the equivalence claim can carry.
//
// The ceiling counts SLOTS at the wasm element width (8 bytes), not
// `size_of::<T>()`, so the limit is the same number on both legs whatever the
// native element happens to be.
pub const ALMIDE_LIST_REPEAT_MAX_ELEMS: i64 = (1 << 31) / 8;
pub fn almide_rt_list_repeat<T: Clone>(x: T, n: i64) -> Vec<T> {
    if n > ALMIDE_LIST_REPEAT_MAX_ELEMS {
        almide_abort("repeat result too large");
    }
    vec![x; n.max(0) as usize]
}
// `list.range` has NO chosen ceiling (ratified A, 2026-08-17): this leg fills to
// its own structural bound, and a span the machine cannot satisfy is the C-197
// abort via try_reserve — never a raw `capacity overflow` panic, which is what
// `(start..end).collect()`'s infallible reserve produced for a span like
// (i64::MIN, 3). `saturating_sub` keeps the count honest where `end - start`
// would wrap. The wasm leg fails with the SAME message at its own i32 floor
// bound; success between the two bounds is the contracted divergence.
pub fn almide_rt_list_range(start: i64, end: i64) -> Vec<i64> {
    let count = end.saturating_sub(start).max(0) as usize;
    let mut v: Vec<i64> = Vec::new();
    if v.try_reserve_exact(count).is_err() {
        almide_abort("out of memory");
    }
    v.extend(start..end);
    v
}
pub fn almide_rt_list_reduce<A: Clone>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A, A) -> A>) -> Option<A> { let f = move |a, b| f(a, b); xs.into_iter().reduce(f) }
pub fn almide_rt_list_scan<A: Clone, B: Clone>(xs: Vec<A>, init: B, f: std::rc::Rc<dyn Fn(B, A) -> B>) -> Vec<B> { let f = move |a, b| f(a, b); let mut r = Vec::new(); let mut a = init; for x in xs { a = f(a, x); r.push(a.clone()); } r }
pub fn almide_rt_list_sort_by<A: Clone, B: Ord>(mut xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> B>) -> Vec<A> { let f = move |a| f(a); xs.sort_by_cached_key(|x| f(x.clone())); xs }  // #560: cached_key calls the key fn ONCE PER ELEMENT (n), matching the wasm precomputed-key array + the key-extraction intent; sort_by_key called it per COMPARISON (n log n), an observable native!=wasm divergence for side-effectful keys.
pub fn almide_rt_list_fold_effect<A, B>(xs: Vec<A>, init: B, f: std::rc::Rc<dyn Fn(B, A) -> Result<B, AlmideString>>) -> Result<B, AlmideString> { let __almide_r: Result<B, String> = (|| { let f = move |a, b| f(a, b); let mut a = init; for x in xs { a = f(a, x)?; } Ok(a) })(); __almide_r.map_err(Into::into) }
pub fn almide_rt_list_map_effect<A, B>(xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> Result<B, AlmideString>>) -> Result<Vec<B>, AlmideString> { let __almide_r: Result<Vec<B>, AlmideString> = (|| { let f = move |a| f(a); xs.into_iter().map(f).collect() })(); __almide_r.map_err(Into::into) }

pub fn almide_rt_list_take_end<T: Clone>(xs: &[T], n: i64) -> Vec<T> {
    let start = if n as usize >= xs.len() { 0 } else { xs.len() - n as usize };
    xs[start..].to_vec()
}
pub fn almide_rt_list_drop_end<T: Clone>(xs: &[T], n: i64) -> Vec<T> {
    let end = if n as usize >= xs.len() { 0 } else { xs.len() - n as usize };
    xs[..end].to_vec()
}

// The OWNED twins of the range ops (#3398). The ops above borrow their source
// (#3397); where the source is not read again — its last use, or a temporary —
// BorrowLowering hands it over by value and calls the `_owned` twin, which
// keeps the elements it returns by moving them instead of cloning each one.
// Same results as the borrowing op for every argument (negative counts and
// out-of-range bounds included); the twin table is `owned_source.rs`.
pub fn almide_rt_list_take_owned<T>(mut xs: Vec<T>, n: i64) -> Vec<T> { xs.truncate(n as usize); xs }
pub fn almide_rt_list_drop_owned<T>(mut xs: Vec<T>, n: i64) -> Vec<T> { let k = (n as usize).min(xs.len()); xs.drain(..k); xs }
pub fn almide_rt_list_take_while_owned<A: Clone>(mut xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> bool>) -> Vec<A> { let k = xs.iter().take_while(|x| f((*x).clone())).count(); xs.truncate(k); xs }
pub fn almide_rt_list_drop_while_owned<A: Clone>(mut xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> bool>) -> Vec<A> { let k = xs.iter().take_while(|x| f((*x).clone())).count(); xs.drain(..k); xs }
pub fn almide_rt_list_find_owned<A: Clone>(mut xs: Vec<A>, f: std::rc::Rc<dyn Fn(A) -> bool>) -> Option<A> { let i = xs.iter().position(|x| f(x.clone()))?; Some(xs.swap_remove(i)) }
pub fn almide_rt_list_slice_owned<T>(mut xs: Vec<T>, start: i64, end: i64) -> Vec<T> { let s = start as usize; let e = (end as usize).min(xs.len()); if s >= e { return Vec::new(); } xs.truncate(e); xs.drain(..s); xs }
pub fn almide_rt_list_take_end_owned<T>(mut xs: Vec<T>, n: i64) -> Vec<T> { let start = if n as usize >= xs.len() { 0 } else { xs.len() - n as usize }; xs.drain(..start); xs }
pub fn almide_rt_list_drop_end_owned<T>(mut xs: Vec<T>, n: i64) -> Vec<T> { let end = if n as usize >= xs.len() { 0 } else { xs.len() - n as usize }; xs.truncate(end); xs }
// The point writes (#3533): `xs = list.set(xs, i, v)` wrote into a copy of the
// whole list every step; the twin writes into the source it owns.
pub fn almide_rt_list_set_owned<T>(mut xs: Vec<T>, i: i64, x: T) -> Vec<T> { if let Some(s) = xs.get_mut(i as usize) { *s = x; } xs }
pub fn almide_rt_list_swap_owned<T>(mut xs: Vec<T>, i: i64, j: i64) -> Vec<T> { let (a, b) = (i as usize, j as usize); if a < xs.len() && b < xs.len() { xs.swap(a, b); } xs }
// Keep the FIRST element of each distinct key, in first-occurrence order.
// The key bound is `PartialEq` (not `Eq + Hash`) so a record, variant, tuple,
// Option or Float key dedups exactly as the wasm leg's generic-equality scan
// does (#1812): user types derive `Clone, Debug, PartialEq` only, so the old
// `HashSet` seen set was a check-passes/build-fails gap (rustc E0277), and a
// Float key follows `PartialEq` — `-0.0 == 0.0` collapses, NaN never matches.
// The seen keys live in an `AlmideMap` (#3704), with the same answers as
// the old `Vec` scan for the reason `almide_rt_list_unique` gives.
pub fn almide_rt_list_unique_by<T: Clone, K: PartialEq + 'static>(xs: Vec<T>, f: std::rc::Rc<dyn Fn(T) -> K>) -> Vec<T> {
    let f = move |a| f(a);
    let mut seen: AlmideMap<K, ()> = AlmideMap::new();
    let mut result = Vec::new();
    for x in xs {
        let k = f(x.clone());
        if !seen.contains_key(&k) { seen.insert(k, ()); result.push(x); }
    }
    result
}
pub fn almide_rt_list_shuffle<T>(mut xs: Vec<T>) -> Vec<T> {
    use std::collections::hash_map::DefaultHasher;
    use std::hash::{Hash, Hasher};
    let mut seed = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_nanos() as u64;
    for i in (1..xs.len()).rev() {
        let mut h = DefaultHasher::new();
        seed.hash(&mut h);
        i.hash(&mut h);
        let j = (h.finish() as usize) % (i + 1);
        xs.swap(i, j);
        seed = seed.wrapping_add(1);
    }
    xs
}
// Same ALS-T6 guard as `almide_rt_list_windows`: n == 0 aborts with the
// unified `Error: …` + exit 1 form (std's `windows(0)` panics — a raw Rust
// panic exit 101 the wasm leg never shows). n > len returns empty like the
// plural twin instead of leaking std's behavior.
pub fn almide_rt_list_window<T: Clone>(xs: &[T], n: i64) -> Vec<Vec<T>> {
    if n == 0 { almide_abort("window size must be positive"); }
    if (n as usize) > xs.len() { return vec![]; }
    xs.windows(n as usize).map(|w| w.to_vec()).collect()
}

// ── Parallel variants (pure list ops under a `fan` block, #2044) ──
// Reached ONLY through `fan { … }`: RustLowering's fan routing rewrites a pure
// `list.map/filter/any/all` whose element, result and captured types are all
// Send-safe scalars to these twins when the call sits under a fan block — the
// explicit fan-out is the user's signal that each element is a task worth a
// thread, so the threshold is 2 elements, not a "big list" cut-off (a 64-chunk
// fan over 14 cores would never clear one). The callback is a NAMED `F: Fn`
// generic in LAST position on purpose: build.rs derives `takes_raw_fn_last_arg`
// from exactly that shape, which is what keeps the closure a raw `impl Fn`
// instead of the uniform `Rc<dyn Fn>` (neither Send nor Sync). `par_map` joins
// into pre-sized slots by index, so its output is byte-identical to `list_map`.
// `ALMIDE_FAN_SEQUENTIAL=1` (read once per process) forces the sequential path
// — the ablation knob check-perf-ratio.sh's fan VICTORY rows use.
const ALMIDE_PARALLEL_THRESHOLD: usize = 2;

/// `ALMIDE_FAN_SEQUENTIAL` — set (non-empty, not "0") means every parallel
/// twin takes its sequential path. Read once; the value is process-wide.
pub fn almide_rt_list_par_sequential() -> bool {
    static SEQ: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
    *SEQ.get_or_init(|| {
        std::env::var("ALMIDE_FAN_SEQUENTIAL").map(|v| !v.is_empty() && v != "0").unwrap_or(false)
    })
}

/// Worker count for `len` items: one per available core, never more than `len`.
/// `ALMIDE_FAN_THREADS=N` (read once) caps it further — the thread-scaling
/// lever #3003 measures both legs with; the result is the same at any N.
pub fn almide_rt_list_par_workers(len: usize) -> usize {
    static CAP: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
    let cap = *CAP.get_or_init(|| {
        std::env::var("ALMIDE_FAN_THREADS").ok().and_then(|v| v.parse::<usize>().ok()).filter(|&n| n > 0).unwrap_or(usize::MAX)
    });
    // Read once too: on Linux `available_parallelism` reads the cgroup quota
    // files on every call, which cost every offer 11-48 us on GCE (#3341's
    // fixed cost, paid even by the offers the model keeps sequential).
    static CPUS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
    let cpus = *CPUS.get_or_init(|| std::thread::available_parallelism().map(|n| n.get()).unwrap_or(1));
    cpus.max(1).min(cap).min(len.max(1))
}

// #3341 — THE FAN COST MODEL, one formula on both legs (the embedded wasm
// host's copy is crates/almide-wasm-run/src/host_fan.rs `plan`; each leg's
// two constants are its own, pinned to docs/benchmarks/fan-cost-model.txt by
// tests/fan_cost_model_test.rs). Every parallel twin is a SITE (one per
// callback type — the monomorphised twin's own address), and every offer at
// a site records the compute time its elements took (`AlmideFanClock`: the
// threads' CPU time inside the elements, so spawn latency and the time a
// thread sat descheduled are not counted, and each worker's first element —
// its warm-up — is kept out of the mean; a sequential site is timed on one
// offer in `ALMIDE_FAN_RESAMPLE`, a parallel one on one in
// `ALMIDE_FAN_RESAMPLE_PAR`). A site's FIRST offer goes parallel, as
// before #3341; later offers estimate each element at the site's last
// measured time `t`. A parallel offer on W workers COSTS `OFFER + W·WORKER`
// (publishing it, the pool threads entering and leaving, the group's
// bookkeeping — measured, docs/benchmarks/fan-cost-model.txt) and SAVES
// `t·(n − ⌈n/W⌉)`; the W with the largest positive net saving wins, and none
// = the offer runs here, sequentially. Output is the same either way (C-321).
// Timing element 0 first and deciding after it was measured and rejected: it
// serialises one whole chunk, ~2x wall time when n ≈ workers (fannkuchredux).
pub const ALMIDE_FAN_OFFER_NS: u128 = 1_500;
pub const ALMIDE_FAN_WORKER_NS: u128 = 700;

/// The worker count for an offer of `n` elements whose site last measured
/// `per_elem` ns per element (`None` = its first offer): >= 2 = go parallel
/// on that many workers, 1 = stay sequential.
pub fn almide_rt_fan_plan(n: usize, per_elem: Option<u128>) -> usize {
    // `ALMIDE_FAN_COST_OFF` (read once): every offer goes parallel — the
    // pre-#3341 behaviour, the ablation the crossover is measured against.
    static OFF: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
    let off = *OFF.get_or_init(|| std::env::var("ALMIDE_FAN_COST_OFF").map(|v| !v.is_empty() && v != "0").unwrap_or(false));
    let Some(t) = per_elem.filter(|_| !off) else { return almide_rt_list_par_workers(n) };
    let mut best = (1usize, 0u128);
    for w in 2..=almide_rt_list_par_workers(n) {
        let saved = t.saturating_mul((n - n.div_ceil(w)) as u128);
        let cost = ALMIDE_FAN_OFFER_NS + ALMIDE_FAN_WORKER_NS * w as u128;
        if saved > cost && saved - cost > best.1 {
            best = (w, saved - cost);
        }
    }
    best.0
}

/// Per site: its last measured time per element (`t`, plus one: 0 = never
/// measured), and how many more offers may run without being measured (see
/// `AlmideFanClock::record`). A fixed open-addressed table keyed by the
/// site's address, read without a lock on every offer — the mutex-guarded
/// map it replaces was a lock, a hash and a probe per offer, on a path a
/// sequential offer of ten 0.3 us elements pays in full. A site that finds
/// the table full keeps no history: each of its offers plans as a first.
struct AlmideFanSite {
    key: std::sync::atomic::AtomicUsize,
    t: std::sync::atomic::AtomicU64,
    skip: std::sync::atomic::AtomicU32,
}

const ALMIDE_FAN_SITE_EMPTY: AlmideFanSite = AlmideFanSite {
    key: std::sync::atomic::AtomicUsize::new(0),
    t: std::sync::atomic::AtomicU64::new(0),
    skip: std::sync::atomic::AtomicU32::new(0),
};
static ALMIDE_FAN_SITES: [AlmideFanSite; 256] = [ALMIDE_FAN_SITE_EMPTY; 256];

/// The table entry for `site`, claiming an empty one when `insert`.
fn almide_fan_site(site: usize, insert: bool) -> Option<&'static AlmideFanSite> {
    use std::sync::atomic::Ordering;
    let n = ALMIDE_FAN_SITES.len();
    let mut i = ((site as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 56) as usize % n;
    for _ in 0..n {
        let e = &ALMIDE_FAN_SITES[i];
        match e.key.load(Ordering::Acquire) {
            k if k == site => return Some(e),
            0 if !insert => return None,
            0 => match e.key.compare_exchange(0, site, Ordering::AcqRel, Ordering::Acquire) {
                Ok(_) => return Some(e),
                Err(k) if k == site => return Some(e),
                Err(_) => {}
            },
            _ => {}
        }
        i = (i + 1) % n;
    }
    None
}

/// A sequential site re-measures one offer in this many: timing an offer
/// reads the thread CPU clock twice, a syscall (~0.3 us on the GCE Intel VM,
/// ~1.1 us on the AMD one) that a cheap sequential offer otherwise pays every
/// time; a site whose work grows past the crossover is seen within this many
/// offers. (Until 2026-10-17 a site within 4x of the crossover re-measured
/// one in 4; with the pool's crossover at ~0.6 us per element that tier
/// caught 0.4 us elements and cost them 12% on the AMD VM.)
const ALMIDE_FAN_RESAMPLE: u32 = 16;
/// A parallel site re-measures one offer in this many: each thread reads the
/// CPU clock around its elements, three syscalls per helper on the offer's
/// critical path (~3.3 us on the AMD VM, 2026-10-17).
const ALMIDE_FAN_RESAMPLE_PAR: u32 = 8;
/// The site's next offer runs sequentially and is measured: a parallel
/// offer's elements read slower than the same elements run in one thread
/// (the threads share the block counter and the result slots), and an
/// estimate from them within 2x of the crossover is not evidence that the
/// site is above it. A site's first offer is parallel, so a run of 0.3 us
/// elements otherwise stayed parallel for its first dozens of offers (100
/// iterations: 0.36 us per offer over sequential on the Intel VM, 2026-10-17).
const ALMIDE_FAN_PROBE: u32 = u32::MAX;

/// The calling thread's CPU time in ns — the clock an offer's elements are
/// measured on (the wasm host's copy is host_fan.rs `cpu_ns`). Wall time
/// would also count the time the thread sat descheduled: on a loaded
/// machine ONE preempted element of a trivial body read 4.6 ms and kept its
/// site parallel. Elsewhere: a monotonic wall clock.
#[cfg(all(any(target_os = "linux", target_os = "macos"), target_pointer_width = "64"))]
fn almide_fan_cpu_ns() -> u64 {
    #[repr(C)]
    struct Timespec { sec: i64, nsec: i64 }
    unsafe extern "C" {
        fn clock_gettime(clock: i32, ts: *mut Timespec) -> i32;
    }
    // CLOCK_THREAD_CPUTIME_ID
    const CLOCK: i32 = if cfg!(target_os = "linux") { 3 } else { 16 };
    let mut ts = Timespec { sec: 0, nsec: 0 };
    if unsafe { clock_gettime(CLOCK, &mut ts) } != 0 {
        return 0;
    }
    (ts.sec as u64).wrapping_mul(1_000_000_000).wrapping_add(ts.nsec as u64)
}
#[cfg(not(all(any(target_os = "linux", target_os = "macos"), target_pointer_width = "64")))]
fn almide_fan_cpu_ns() -> u64 {
    static T0: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
    T0.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64
}

/// What one read of `almide_fan_cpu_ns` costs (measured once: the least of
/// 16 back-to-back pairs). An interval between two reads also holds one read,
/// and a worker of a parallel offer often times one or two elements: on the
/// AMD VM (a 1.1 us read) a 0.4 us element read 1.5-4 us, and the site stayed
/// parallel on that estimate where sequential was faster (2026-10-17).
fn almide_fan_clock_cost() -> u64 {
    static COST: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
    *COST.get_or_init(|| {
        (0..16).map(|_| {
            let a = almide_fan_cpu_ns();
            almide_fan_cpu_ns().wrapping_sub(a)
        }).min().unwrap_or(0)
    })
}

/// The CPU time since `t0`, less the read that ends it.
fn almide_fan_cpu_since(t0: u64) -> u64 {
    almide_fan_cpu_ns().wrapping_sub(t0).saturating_sub(almide_fan_clock_cost())
}

/// What one offer's elements took. A worker thread's FIRST element is its
/// warm-up (a fresh thread's first touch of the body) and is kept apart —
/// that cost belongs to the offer's `WORKER` term, not to `t`; the estimate
/// is the warm elements' mean, or the warm-ups' when no worker ran a second
/// element. The calling thread's sequential run is all warm.
struct AlmideFanClock {
    warm: [std::sync::atomic::AtomicU64; 2],
    cold: [std::sync::atomic::AtomicU64; 2],
    site: usize,
    n: usize,
    /// `false` = an unmeasured offer: no clock reads, no record.
    measure: bool,
    /// The offer runs on more than one thread.
    parallel: bool,
}

impl AlmideFanClock {
    /// Plan an offer of `n` elements at `site`: its worker count, and the
    /// clock that measures it.
    fn offer(site: usize, n: usize) -> (usize, Self) {
        let z = || std::sync::atomic::AtomicU64::new(0);
        use std::sync::atomic::Ordering;
        let known = almide_fan_site(site, false).and_then(|e| match e.t.load(Ordering::Acquire) {
            0 => None,
            t => Some((e, u128::from(t - 1))),
        });
        let (workers, measure) = match known {
            // the probe a parallel estimate near the crossover asked for
            Some((e, _)) if e.skip.load(Ordering::Relaxed) == ALMIDE_FAN_PROBE
                && e.skip.compare_exchange(ALMIDE_FAN_PROBE, 0, Ordering::Relaxed, Ordering::Relaxed).is_ok() => (1, true),
            Some((e, t)) => {
                // a CAS loop, not `fetch_update`: newer toolchains deprecate
                // that spelling, and generated programs build warning-free
                let mut k = e.skip.load(Ordering::Relaxed);
                let skipped = loop {
                    if k == 0 || k == ALMIDE_FAN_PROBE {
                        break false;
                    }
                    match e.skip.compare_exchange_weak(k, k - 1, Ordering::Relaxed, Ordering::Relaxed) {
                        Ok(_) => break true,
                        Err(now) => k = now,
                    }
                };
                (almide_rt_fan_plan(n, Some(t)), !skipped)
            }
            None => (almide_rt_fan_plan(n, None), true),
        };
        (workers, AlmideFanClock { warm: [z(), z()], cold: [z(), z()], site, n, measure, parallel: workers >= 2 })
    }

    fn add(cell: &[std::sync::atomic::AtomicU64; 2], ns: u64, n: u64) {
        cell[0].fetch_add(ns, std::sync::atomic::Ordering::Relaxed);
        cell[1].fetch_add(n, std::sync::atomic::Ordering::Relaxed);
    }

    /// The calling thread runs the offer: `g` returns its result and how
    /// many elements it evaluated.
    fn calling<R>(&self, g: impl FnOnce() -> (R, usize)) -> R {
        if !self.measure {
            return g().0;
        }
        let t0 = almide_fan_cpu_ns();
        let (r, n) = g();
        Self::add(&self.warm, almide_fan_cpu_since(t0), n as u64);
        r
    }

    /// A worker thread runs `items` through `each`: `Some(go_on)` = it
    /// evaluated the element, `None` = it stopped without evaluating it.
    fn worker<T>(&self, items: impl IntoIterator<Item = T>, mut each: impl FnMut(T) -> Option<bool>) {
        if !self.measure {
            for x in items {
                if each(x) != Some(true) { break; }
            }
            return;
        }
        let mut it = items.into_iter();
        let Some(first) = it.next() else { return };
        let t0 = almide_fan_cpu_ns();
        let go = each(first);
        let t1 = almide_fan_cpu_ns();
        if go.is_some() {
            Self::add(&self.cold, t1.wrapping_sub(t0).saturating_sub(almide_fan_clock_cost()), 1);
        }
        if go != Some(true) {
            return;
        }
        let mut n = 0u64;
        for x in it {
            match each(x) {
                Some(go_on) => {
                    n += 1;
                    if !go_on { break; }
                }
                None => break,
            }
        }
        Self::add(&self.warm, almide_fan_cpu_since(t1), n);
    }

    /// Record the offer as the site's estimate: ns per element — and let the
    /// site's next offers run unmeasured: `ALMIDE_FAN_RESAMPLE - 1` of them
    /// when it would stay sequential, `ALMIDE_FAN_RESAMPLE_PAR - 1` when not.
    fn record(self) {
        if !self.measure {
            return;
        }
        let [w, wn] = self.warm.map(|a| a.into_inner());
        let [c, cn] = self.cold.map(|a| a.into_inner());
        let (ns, n) = if wn > 0 { (w, wn) } else { (c, cn) };
        if n > 0 {
            let t = u128::from(ns) / u128::from(n);
            let Some(e) = almide_fan_site(self.site, true) else { return };
            let was_sequential = match e.t.load(std::sync::atomic::Ordering::Acquire) {
                0 => false,
                old => almide_rt_fan_plan(self.n, Some(u128::from(old - 1))) < 2,
            };
            let skip = if almide_rt_fan_plan(self.n, Some(t)) < 2 {
                ALMIDE_FAN_RESAMPLE - 1
            } else if self.parallel && (wn == 0 || almide_rt_fan_plan(self.n, Some(t / 2)) < 2) {
                // only warm-ups timed (a site's first offer spawns the pool:
                // 0.4 us elements read 4.1 us on the AMD VM), or near the
                // crossover
                ALMIDE_FAN_PROBE
            } else if !self.parallel && was_sequential {
                // a sequential site turns parallel on two measurements in a
                // row, not on one: one preempted or interrupted offer read
                // above the crossover sent 0.42 us elements (0.58 us
                // crossover) parallel at ~9 us a time on the AMD VM
                ALMIDE_FAN_PROBE
            } else {
                ALMIDE_FAN_RESAMPLE_PAR - 1
            };
            e.skip.store(skip, std::sync::atomic::Ordering::Relaxed);
            e.t.store(u64::try_from(t).unwrap_or(u64::MAX - 1) + 1, std::sync::atomic::Ordering::Release);
        }
    }
}

// The RESIDENT fan pool (`almide_fan_pool`, below `almide_fan_deal`): the
// threads that help parallel offers take their blocks, spawned by the first
// offers that need them, polling for the next offer for a while after each
// one and parked after that, for the rest of the process. A thread per chunk
// per offer (`std::thread::scope`) cost 117 us
// per offer on eight workers on an Intel 8581C and 299 us on an AMD EPYC
// 7B13 (2026-10-16, an empty 10-element chunk map) — a fixed cost the cost
// model above must charge every offer. The wasm host keeps resident workers
// too (crates/almide-wasm-run/src/host_fan.rs `Crew`).
//
// A pool thread leaves nothing of an offer behind: its stdout buffer is
// flushed (a scoped thread flushed it as it exited) and its fan sink is
// cleared (a `list.par_*` chunk adopts its element's sink). A chunk may
// itself start a parallel offer, and two `fan { }` arms may start offers at
// once: every offer is published to the same pool and takes its own blocks
// too, so none waits for a helper that is busy elsewhere.
/// The `std::thread::scope` panic: once every task has finished, a panicked
/// one panics the offer.
fn almide_fan_panic_if_any(outcomes: Vec<std::thread::Result<()>>) {
    if outcomes.iter().any(Result::is_err) {
        panic!("a scoped thread panicked");
    }
}

/// The block size an offer of `n` elements on `workers` threads is dealt in:
/// about four blocks per worker, the wasm host's `run_all` split.
fn almide_fan_block(n: usize, workers: usize) -> usize {
    n.div_ceil(workers * 4).max(1)
}

/// Deal `blocks`, in order, to `workers` threads: each takes the next
/// block until none is left, and `work` runs on each thread over the blocks
/// it took. A thread the OS left waiting (or placed on a busy core) takes
/// fewer blocks instead of holding the offer back — with a fixed chunk per
/// thread, resident threads made spectralnorm 1.3x slower on an Intel 8581C.
/// Blocks are dealt in list order, so every block below one being run was
/// already taken by a running thread (the ADR-0024 D6 trap wait relies on it).
///
/// The calling thread is one of the takers. The others are threads of the
/// shared fan pool (`almide_fan_pool`): the offer is PUBLISHED in a slot
/// (`ALMIDE_FAN_SLOTS`), and every pool thread that is polling for work —
/// whichever offer it last helped — enters it and takes blocks until none is
/// left, so offers made from any thread (a pool thread, a `fan { }` arm)
/// share one set of threads, and an offer inside an offer gets help from
/// threads that finished elsewhere. `workers` only says how many sleeping
/// threads to wake. Once its own taking is done the caller withdraws the
/// offer and waits only for the threads already inside it.
///
/// Returns this thread's outcome, then every helper's PANIC (a helper that
/// finished normally leaves nothing).
fn almide_fan_deal<'a, T: Send + 'a>(blocks: Vec<T>, workers: usize, work: impl Fn(&mut dyn Iterator<Item = T>) + Sync + 'a) -> Vec<std::thread::Result<()>> {
    use std::sync::atomic::Ordering;
    let queue = AlmideFanBlocks::new(blocks);
    let gate = AlmideFanGate {
        parent: ALMIDE_FAN_IN_GATE.with(std::cell::Cell::get),
        inside: std::sync::atomic::AtomicUsize::new(0),
        next: std::sync::atomic::AtomicUsize::new(0),
        len: queue.cells.len(),
        caller: std::thread::current(),
        parking: std::sync::atomic::AtomicBool::new(false),
        counted: std::sync::atomic::AtomicBool::new(false),
        panics: std::sync::Mutex::new(Vec::new()),
        take: std::cell::UnsafeCell::new(None),
    };
    let me: &AlmideFanGate = &gate;
    let take = || {
        // restored on unwind too: a stale gate here would become the
        // `parent` of this thread's next offer
        struct Restore(*const AlmideFanGate);
        impl Drop for Restore {
            fn drop(&mut self) {
                ALMIDE_FAN_IN_GATE.with(|g| g.set(self.0));
            }
        }
        // a thread that arrives after the last block was dealt does nothing,
        // so it has nothing to undo either (see `almide_fan_help`)
        let Some(first) = queue.take(me.draw()) else { return false };
        let _restore = Restore(ALMIDE_FAN_IN_GATE.with(|g| g.replace(me as *const AlmideFanGate)));
        let mut next = std::iter::once(first).chain(std::iter::from_fn(|| queue.take(me.draw())));
        work(&mut next);
        true
    };
    let take: &(dyn Fn() -> bool + Sync + '_) = &take;
    // SAFETY (the lifetime erasure): a helper calls `take` only from inside
    // the gate, which it can enter only while the gate is published; this
    // function withdraws it and waits until no helper is inside before it
    // returns — so no call outlives the borrow. Written before publishing.
    unsafe {
        *gate.take.get() = Some(std::mem::transmute::<*const (dyn Fn() -> bool + Sync + '_), *const (dyn Fn() -> bool + Sync + 'static)>(take as *const _));
    }
    let _running = AlmideFanRunning::enter();
    // counted before it is visible: no thread can draw past its last block
    // before the count includes it
    gate.counted.store(true, Ordering::SeqCst);
    ALMIDE_FAN_OPEN_BLOCKS.fetch_add(1, Ordering::SeqCst);
    let slot = almide_fan_publish(&gate);
    if slot.is_none() {
        gate.counted.store(false, Ordering::SeqCst);
        ALMIDE_FAN_OPEN_BLOCKS.fetch_sub(1, Ordering::SeqCst);
    } else {
        almide_fan_pool_wake(workers.saturating_sub(1));
    }
    let mine = std::panic::catch_unwind(std::panic::AssertUnwindSafe(take)).map(|_| ());
    // the elements this thread ran printed into its own buffer: out before
    // the offer returns, as a helper's are
    almide_stdout_flush();
    if let Some(slot) = slot {
        almide_fan_withdraw(slot);
    }
    // While its helpers finish, this thread takes blocks of other offers of
    // the same tree — made inside a block of the same outermost offer —
    // instead of idling on a core: a 4 x 10 nest otherwise left threads
    // waiting through every outer offer's tail (220 us against 187 per outer
    // offer, Intel VM, 2026-10-17; 203 when only this offer's own
    // descendants were taken). Not another tree's offer (another `fan { }`
    // arm's): its elements do not bring this tree's end closer, and running
    // one delayed this arm's next offer by up to an element (two arms of
    // 10000-iteration maps: 108 us per pair against 95).
    let root = gate.root();
    almide_fan_wait(
        || {
            if gate.inside.load(Ordering::SeqCst) == 0 {
                return true;
            }
            if let Some(other) = almide_fan_steal(|g| std::ptr::eq(g.root(), root)) {
                let sink = almide_fan_current();
                almide_fan_help(other);
                almide_fan_adopt(sink);
            }
            false
        },
        || {
            // a helper that leaves after this sees `parking` and wakes this
            // thread; one that read it just before sleeps it until the park
            // times out (1 ms)
            gate.parking.store(true, Ordering::SeqCst);
            if gate.inside.load(Ordering::SeqCst) != 0 {
                almide_fan_park();
            }
        },
    );
    let mut outcomes = vec![mine];
    outcomes.append(&mut gate.panics.lock().unwrap_or_else(|e| e.into_inner()));
    outcomes
}

/// How long a pool thread polls for an offer, and an offer's caller for its
/// last helper, before it sleeps. A thread put to sleep and woken again costs
/// the offer the kernel's wake-up path — 5-20 us on the GCE VMs, most of an
/// offer of short elements; Rayon's and Go's idle workers poll for a while
/// for the same reason.
const ALMIDE_FAN_SPIN: std::time::Duration = std::time::Duration::from_micros(50);

/// Poll `done` for up to `ALMIDE_FAN_SPIN`, then call `sleep` (which may
/// return early) between polls until it holds.
fn almide_fan_wait(mut done: impl FnMut() -> bool, mut sleep: impl FnMut()) {
    let mut start: Option<std::time::Instant> = None;
    let mut polls = 0u32;
    while !done() {
        polls = polls.wrapping_add(1);
        if polls % 64 == 0 {
            let t0 = *start.get_or_insert_with(std::time::Instant::now);
            if t0.elapsed() >= ALMIDE_FAN_SPIN {
                sleep();
                continue;
            }
        }
        std::hint::spin_loop();
    }
}

fn almide_fan_park() {
    std::thread::park_timeout(std::time::Duration::from_millis(1));
}

/// An offer's blocks, each taken by exactly one thread: the index comes from
/// the gate's counter, and the block at an index is moved out by the thread
/// that drew it.
struct AlmideFanBlocks<T> {
    cells: Vec<std::cell::UnsafeCell<Option<T>>>,
}

// SAFETY: a cell is read only by the one thread whose `fetch_add` drew its
// index, so no two threads touch the same block.
unsafe impl<T: Send> Sync for AlmideFanBlocks<T> {}

impl<T> AlmideFanBlocks<T> {
    fn new(blocks: Vec<T>) -> Self {
        AlmideFanBlocks { cells: blocks.into_iter().map(|b| std::cell::UnsafeCell::new(Some(b))).collect() }
    }

    fn take(&self, i: usize) -> Option<T> {
        // SAFETY: see the `Sync` impl.
        self.cells.get(i).and_then(|c| unsafe { (*c.get()).take() })
    }
}

std::thread_local! {
    /// The gate whose blocks this thread is running (null outside any).
    static ALMIDE_FAN_IN_GATE: std::cell::Cell<*const AlmideFanGate> = const { std::cell::Cell::new(std::ptr::null()) };
}

/// One offer's door for its helpers, in `almide_fan_deal`'s frame. A helper
/// enters (`inside` + 1) through the slot the offer is published in, and
/// the caller returns only once the offer is withdrawn and `inside` is 0.
struct AlmideFanGate {
    /// The gate in whose block this offer was made (null: none). It
    /// outlives this one: the block does not end before this offer returns.
    parent: *const AlmideFanGate,
    /// Helpers inside the gate.
    inside: std::sync::atomic::AtomicUsize,
    /// The next block to deal, of `len`.
    next: std::sync::atomic::AtomicUsize,
    len: usize,
    /// The offer is counted in `ALMIDE_FAN_OPEN_BLOCKS` (it was published).
    counted: std::sync::atomic::AtomicBool,
    /// Woken by the helper that leaves last, once `parking` says it sleeps.
    caller: std::thread::Thread,
    /// The caller has polled for `ALMIDE_FAN_SPIN` and may be parked. Until
    /// then no helper clones `caller`: seven helpers cloning and dropping one
    /// handle per offer contended on its count.
    parking: std::sync::atomic::AtomicBool,
    panics: std::sync::Mutex<Vec<std::thread::Result<()>>>,
    /// The offer's taking loop, borrowed from `almide_fan_deal`'s frame
    /// (see the SAFETY note there).
    take: std::cell::UnsafeCell<Option<*const (dyn Fn() -> bool + Sync)>>,
}

// SAFETY: `take` points at a `Sync` closure, written before the gate is
// shared and called from other threads only under the gate protocol above;
// `parent` is only read, and outlives the gate.
unsafe impl Sync for AlmideFanGate {}

impl AlmideFanGate {
    /// The next block's index. The draw that first runs past the last block
    /// takes the offer out of `ALMIDE_FAN_OPEN_BLOCKS`.
    fn draw(&self) -> usize {
        use std::sync::atomic::Ordering;
        let i = self.next.fetch_add(1, Ordering::Relaxed);
        if i == self.len && self.counted.load(Ordering::SeqCst) {
            ALMIDE_FAN_OPEN_BLOCKS.fetch_sub(1, Ordering::SeqCst);
        }
        i
    }

    /// The outermost offer this one was made inside (itself if none).
    fn root(&self) -> &AlmideFanGate {
        let mut g = self;
        // SAFETY: a parent outlives its children (see `parent`).
        while let Some(p) = unsafe { g.parent.as_ref() } {
            g = p;
        }
        g
    }
}

/// The threads working on offers — callers inside `almide_fan_deal` and
/// pool threads inside a gate, each counted once however deep its offers
/// nest. A pool thread enters a gate only while this is below the cores: two
/// `fan { }` arms each dealing an offer to seven pool threads put nine
/// threads on eight cores, and a preempted element held its whole offer back
/// (busy, 10000 iterations: 1.33x Go's time on the Intel VM, 2026-10-17).
static ALMIDE_FAN_RUNNING: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);

std::thread_local! {
    static ALMIDE_FAN_DEPTH: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
}

/// This thread's count in `ALMIDE_FAN_RUNNING` for as long as it lives.
struct AlmideFanRunning;

impl AlmideFanRunning {
    fn enter() -> Self {
        if ALMIDE_FAN_DEPTH.with(|d| d.replace(d.get() + 1)) == 0 {
            ALMIDE_FAN_RUNNING.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
        }
        AlmideFanRunning
    }

    /// A pool thread's entry: `None` when the cores are all taken.
    fn enter_if_free() -> Option<Self> {
        use std::sync::atomic::Ordering;
        let cores = almide_rt_list_par_workers(usize::MAX);
        let mut r = ALMIDE_FAN_RUNNING.load(Ordering::SeqCst);
        loop {
            if r >= cores {
                return None;
            }
            match ALMIDE_FAN_RUNNING.compare_exchange_weak(r, r + 1, Ordering::SeqCst, Ordering::SeqCst) {
                Ok(_) => break,
                Err(now) => r = now,
            }
        }
        ALMIDE_FAN_DEPTH.with(|d| d.set(d.get() + 1));
        Some(AlmideFanRunning)
    }
}

impl Drop for AlmideFanRunning {
    fn drop(&mut self) {
        if ALMIDE_FAN_DEPTH.with(|d| d.replace(d.get() - 1)) == 1 {
            ALMIDE_FAN_RUNNING.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
        }
    }
}

/// A pool thread inside `gate` (counted in `inside`): take blocks, leave its
/// panic if it had one, and leave — waking the caller when it is the last.
fn almide_fan_help(gate: &AlmideFanGate) {
    use std::sync::atomic::Ordering;
    // SAFETY: this helper is inside the gate, so the offer has not returned
    // and the closure is alive; it was written before the gate was published.
    let take = unsafe { &*(*gate.take.get()).expect("set before the gate is published") };
    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(take));
    // a helper that took a block leaves no element's sink or output behind
    if !matches!(outcome, Ok(false)) {
        almide_fan_adopt(None);
        almide_stdout_flush();
    }
    if let Err(panic) = outcome {
        gate.panics.lock().unwrap_or_else(|e| e.into_inner()).push(Err(panic));
    }
    // after the decrement the caller may return and free the gate: wake it
    // through a handle cloned before
    let caller = gate.parking.load(Ordering::SeqCst).then(|| gate.caller.clone());
    if gate.inside.fetch_sub(1, Ordering::SeqCst) == 1 {
        if let Some(caller) = caller {
            caller.unpark();
        }
    }
}

/// The published offers. A pool thread entering one holds the slot's
/// `readers` count while it reads the gate pointer and enters, and
/// withdrawing an offer clears the pointer and waits for `readers` to drain,
/// so no thread reaches a gate after its caller stopped waiting for entrants.
struct AlmideFanSlot {
    gate: std::sync::atomic::AtomicPtr<AlmideFanGate>,
    readers: std::sync::atomic::AtomicUsize,
}

const ALMIDE_FAN_SLOT_EMPTY: AlmideFanSlot = AlmideFanSlot {
    gate: std::sync::atomic::AtomicPtr::new(std::ptr::null_mut()),
    readers: std::sync::atomic::AtomicUsize::new(0),
};
/// Offers open at once beyond this run on their callers alone.
static ALMIDE_FAN_SLOTS: [AlmideFanSlot; 64] = [ALMIDE_FAN_SLOT_EMPTY; 64];
/// One past the highest slot ever used (the scan bound).
static ALMIDE_FAN_HIGH: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
/// Published offers with a block left to deal. A polling thread reads only
/// this until it is non-zero: with every thread reading and writing the
/// slots' and the budget's counters while an offer is published (after its
/// blocks were all dealt, too), an empty forced-parallel offer cost ~3 us on
/// the Intel VM.
static ALMIDE_FAN_OPEN_BLOCKS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);

fn almide_fan_publish(gate: &AlmideFanGate) -> Option<usize> {
    use std::sync::atomic::Ordering;
    let p = gate as *const AlmideFanGate as *mut AlmideFanGate;
    let i = ALMIDE_FAN_SLOTS.iter().position(|s| s.gate.compare_exchange(std::ptr::null_mut(), p, Ordering::SeqCst, Ordering::Relaxed).is_ok())?;
    ALMIDE_FAN_HIGH.fetch_max(i + 1, Ordering::SeqCst);
    Some(i)
}

fn almide_fan_withdraw(i: usize) {
    use std::sync::atomic::Ordering;
    let slot = &ALMIDE_FAN_SLOTS[i];
    slot.gate.store(std::ptr::null_mut(), Ordering::SeqCst);
    while slot.readers.load(Ordering::SeqCst) > 0 {
        std::hint::spin_loop();
    }
}

/// Enter the oldest-slotted published offer that has a block left and that
/// `which` accepts.
fn almide_fan_steal(which: impl Fn(&AlmideFanGate) -> bool) -> Option<&'static AlmideFanGate> {
    use std::sync::atomic::Ordering;
    if ALMIDE_FAN_OPEN_BLOCKS.load(Ordering::Relaxed) == 0 {
        return None;
    }
    for slot in &ALMIDE_FAN_SLOTS[..ALMIDE_FAN_HIGH.load(Ordering::Relaxed)] {
        if slot.gate.load(Ordering::Relaxed).is_null() {
            continue;
        }
        slot.readers.fetch_add(1, Ordering::SeqCst);
        let p = slot.gate.load(Ordering::SeqCst);
        // SAFETY: a non-null pointer read under `readers` is a gate whose
        // caller has not finished withdrawing it, so it is alive; once
        // entered, the caller waits for this thread to leave.
        let entered = unsafe { p.as_ref() }.filter(|g| {
            g.next.load(Ordering::Relaxed) < g.len && which(g) && {
                g.inside.fetch_add(1, Ordering::SeqCst);
                true
            }
        });
        slot.readers.fetch_sub(1, Ordering::SeqCst);
        if let Some(g) = entered {
            // SAFETY: see above — valid until this thread leaves the gate,
            // which `almide_fan_help` does last.
            return Some(unsafe { &*(g as *const AlmideFanGate) });
        }
    }
    None
}

/// The shared fan pool: resident threads that help published offers,
/// spawned as offers first need them, at most one fewer than the cores. A
/// thread polls for an offer for `ALMIDE_FAN_SPIN` after each one before it
/// parks, so back-to-back offers reach it without a wake-up; an offer wakes
/// parked threads (the lowest-numbered first) only when fewer than it wants
/// are polling.
struct AlmideFanPool {
    hands: Box<[AlmideFanHand]>,
    /// Hands `0..started` have a thread.
    started: std::sync::atomic::AtomicUsize,
    /// Threads polling (not parked, not helping).
    polling: std::sync::atomic::AtomicUsize,
    spawning: std::sync::Mutex<()>,
}

struct AlmideFanHand {
    /// The thread is (about to be) parked: a waker must unpark it.
    parked: std::sync::atomic::AtomicBool,
    thread: std::sync::OnceLock<std::thread::Thread>,
}

fn almide_fan_pool() -> &'static AlmideFanPool {
    static POOL: std::sync::OnceLock<AlmideFanPool> = std::sync::OnceLock::new();
    POOL.get_or_init(|| {
        let cap = almide_rt_list_par_workers(usize::MAX).saturating_sub(1).max(1);
        AlmideFanPool {
            hands: (0..cap).map(|_| AlmideFanHand {
                parked: std::sync::atomic::AtomicBool::new(false),
                thread: std::sync::OnceLock::new(),
            }).collect(),
            started: std::sync::atomic::AtomicUsize::new(0),
            polling: std::sync::atomic::AtomicUsize::new(0),
            spawning: std::sync::Mutex::new(()),
        }
    })
}

/// A pool thread's life: poll for a published offer with blocks left, help
/// it, poll again; park after `ALMIDE_FAN_SPIN` with nothing published.
fn almide_fan_hand_loop(hand: &'static AlmideFanHand) {
    use std::sync::atomic::Ordering;
    let polling = &almide_fan_pool().polling;
    loop {
        let mut gate = None;
        let mut running = None;
        almide_fan_wait(
            || {
                if ALMIDE_FAN_OPEN_BLOCKS.load(Ordering::Relaxed) == 0 {
                    return false;
                }
                let Some(r) = AlmideFanRunning::enter_if_free() else {
                    // every core is working: give this core to a thread that
                    // has work, and look again as soon as the scheduler
                    // finds none
                    std::thread::yield_now();
                    return false;
                };
                gate = almide_fan_steal(|_| true);
                running = gate.is_some().then_some(r);
                gate.is_some()
            },
            || {
                // stop counting as polling BEFORE the last look, so a waker
                // that counted this thread finds it published-aware
                polling.fetch_sub(1, Ordering::SeqCst);
                hand.parked.store(true, Ordering::SeqCst);
                if ALMIDE_FAN_OPEN_BLOCKS.load(Ordering::SeqCst) == 0 {
                    std::thread::park();
                }
                hand.parked.store(false, Ordering::SeqCst);
                polling.fetch_add(1, Ordering::SeqCst);
            },
        );
        polling.fetch_sub(1, Ordering::SeqCst);
        if let Some(gate) = gate {
            almide_fan_help(gate);
        }
        drop(running);
        polling.fetch_add(1, Ordering::SeqCst);
    }
}

/// Make `helpers` pool threads available to the offer just published: those
/// polling already will find it; wake parked ones (and spawn new ones, up to
/// the cap) for the rest.
fn almide_fan_pool_wake(helpers: usize) {
    use std::sync::atomic::Ordering;
    if helpers == 0 {
        return;
    }
    let pool = almide_fan_pool();
    let mut short = helpers.saturating_sub(pool.polling.load(Ordering::SeqCst));
    if short == 0 {
        return;
    }
    for hand in &pool.hands[..pool.started.load(Ordering::Acquire)] {
        if short == 0 {
            return;
        }
        if hand.parked.swap(false, Ordering::SeqCst) {
            if let Some(t) = hand.thread.get() {
                t.unpark();
            }
            short -= 1;
        }
    }
    if pool.started.load(Ordering::Acquire) == pool.hands.len() {
        return;
    }
    let _spawning = pool.spawning.lock().unwrap_or_else(|e| e.into_inner());
    while short > 0 {
        let i = pool.started.load(Ordering::Acquire);
        if i == pool.hands.len() {
            return;
        }
        pool.polling.fetch_add(1, Ordering::SeqCst);
        let spawned = std::thread::Builder::new().spawn(move || almide_fan_hand_loop(&almide_fan_pool().hands[i]));
        let Ok(handle) = spawned else {
            pool.polling.fetch_sub(1, Ordering::SeqCst);
            return;
        };
        let _ = pool.hands[i].thread.set(handle.thread().clone());
        pool.started.store(i + 1, Ordering::Release);
        short -= 1;
    }
}

pub fn almide_rt_list_par_map<A: Send + Sync + Clone, B: Send, F: Fn(A) -> B + Send + Sync>(xs: Vec<A>, f: F) -> Vec<B> {
    xs.almide_share();
    if xs.len() < ALMIDE_PARALLEL_THRESHOLD || almide_rt_list_par_sequential() {
        return xs.into_iter().map(&f).collect();
    }
    let site = almide_rt_list_par_map::<A, B, F> as fn(Vec<A>, F) -> Vec<B> as usize;
    let n = xs.len();
    let (workers, clock) = AlmideFanClock::offer(site, n);
    if workers < 2 {
        let out = clock.calling(|| (xs.into_iter().map(&f).collect(), n));
        clock.record();
        return out;
    }
    let block = almide_fan_block(n, workers);
    let mut slots: Vec<Option<B>> = (0..n).map(|_| None).collect();
    // One output timeline per BLOCK, under the enclosing fan element's (the
    // group's parent): inside a block the elements run in list order on one
    // thread, blocks drain in list order, and a trap in element k waits for
    // the blocks below its own (ADR-0024 D6, #3779 — adopting the parent's
    // sink alone carried no index, so under a one-arm fan the first trap in
    // TIME won). The group flushes this thread's stdout first (C-197).
    let blocks: Vec<_> = xs.chunks(block).zip(slots.chunks_mut(block)).enumerate().collect();
    let group = almide_fan_group(blocks.len());
    almide_fan_panic_if_any(almide_fan_deal(blocks, workers, |blocks| {
        for (b, (chunk, out)) in blocks {
            let _blk = almide_fan_enter(&group, b);
            clock.worker(out.iter_mut().zip(chunk.iter()), |(slot, x)| {
                *slot = Some(f(x.clone()));
                Some(true)
            });
        }
    }));
    clock.record();
    slots.into_iter().map(|b| b.expect("list.par_map: every slot is written by its worker")).collect()
}

pub fn almide_rt_list_par_filter<A: Send + Sync + Clone, F: Fn(A) -> bool + Send + Sync>(xs: Vec<A>, f: F) -> Vec<A> {
    xs.almide_share();
    if xs.len() < ALMIDE_PARALLEL_THRESHOLD || almide_rt_list_par_sequential() {
        return xs.into_iter().filter(|x| f(x.clone())).collect();
    }
    let site = almide_rt_list_par_filter::<A, F> as fn(Vec<A>, F) -> Vec<A> as usize;
    let n = xs.len();
    let (workers, clock) = AlmideFanClock::offer(site, n);
    if workers < 2 {
        let out = clock.calling(|| (xs.into_iter().filter(|x| f(x.clone())).collect(), n));
        clock.record();
        return out;
    }
    let block = almide_fan_block(n, workers);
    // each element's verdict by index; the kept elements are then taken in
    // list order
    let mut keep = vec![false; n];
    // One output timeline per block (see `almide_rt_list_par_map`).
    let blocks: Vec<_> = xs.chunks(block).zip(keep.chunks_mut(block)).enumerate().collect();
    let group = almide_fan_group(blocks.len());
    // the lowest thread's panic, as joining the handles in order resumed it
    if let Some(Err(panic)) = almide_fan_deal(blocks, workers, |blocks| {
        for (b, (chunk, out)) in blocks {
            let _blk = almide_fan_enter(&group, b);
            clock.worker(out.iter_mut().zip(chunk.iter()), |(k, x)| {
                *k = f(x.clone());
                Some(true)
            });
        }
    })
    .into_iter()
    .find(Result::is_err)
    {
        std::panic::resume_unwind(panic);
    }
    clock.record();
    xs.into_iter().zip(keep).filter_map(|(x, k)| k.then_some(x)).collect()
}

/// `any` (`stop_on` = true) / `all` (`stop_on` = false): does some element's
/// verdict equal `stop_on`. Records the elements it actually evaluated.
fn almide_fan_search<A: Send + Sync + Clone, F: Fn(A) -> bool + Send + Sync>(site: usize, xs: &[A], f: &F, stop_on: bool) -> bool {
    let (workers, clock) = AlmideFanClock::offer(site, xs.len());
    let look = |x: &A| f(x.clone()) == stop_on;
    let hit = if workers < 2 {
        clock.calling(|| {
            let mut seen = 0usize;
            let hit = xs.iter().any(|x| {
                seen += 1;
                look(x)
            });
            (hit, seen)
        })
    } else {
        let block = almide_fan_block(xs.len(), workers);
        let hit = std::sync::atomic::AtomicBool::new(false);
        // One output timeline per block (see `almide_rt_list_par_map`).
        let blocks: Vec<_> = xs.chunks(block).enumerate().collect();
        let group = almide_fan_group(blocks.len());
        almide_fan_panic_if_any(almide_fan_deal(blocks, workers, |blocks| {
            for (b, chunk) in blocks {
                let _blk = almide_fan_enter(&group, b);
                clock.worker(chunk.iter(), |x| {
                    if hit.load(std::sync::atomic::Ordering::Relaxed) { return None; }
                    if look(x) {
                        hit.store(true, std::sync::atomic::Ordering::Relaxed);
                        return Some(false);
                    }
                    Some(true)
                });
            }
        }));
        hit.load(std::sync::atomic::Ordering::Relaxed)
    };
    clock.record();
    hit
}

pub fn almide_rt_list_par_any<A: Send + Sync + Clone, F: Fn(A) -> bool + Send + Sync>(xs: &[A], f: F) -> bool {
    xs.almide_share();
    if xs.len() < ALMIDE_PARALLEL_THRESHOLD || almide_rt_list_par_sequential() {
        return xs.iter().any(|x| f(x.clone()));
    }
    almide_fan_search(almide_rt_list_par_any::<A, F> as fn(&[A], F) -> bool as usize, xs, &f, true)
}

pub fn almide_rt_list_par_all<A: Send + Sync + Clone, F: Fn(A) -> bool + Send + Sync>(xs: &[A], f: F) -> bool {
    xs.almide_share();
    if xs.len() < ALMIDE_PARALLEL_THRESHOLD || almide_rt_list_par_sequential() {
        return xs.iter().all(|x| f(x.clone()));
    }
    !almide_fan_search(almide_rt_list_par_all::<A, F> as fn(&[A], F) -> bool as usize, xs, &f, false)
}

// ── Mutable operations ──

#[inline(always)] pub fn almide_rt_list_push<A>(xs: &mut Vec<A>, x: A) { xs.push(x); }

// Pre-allocate a List with the given capacity. Start-empty (len=0) but
// skips all reallocations up to `cap` pushes. Useful when the caller
// knows the final size up front (Q1_0 tensor decode, fixed-size bulk
// transforms).
//
// The EAGER reservation is clamped to this many bytes — capacity is an
// unobservable hint (`push` grows past it normally), but an unclamped eager
// reservation aborts on huge requests (`with_capacity(i32::MAX)` over a
// 24-byte element = ~51.5 GB, machine-dependent). The ceiling below keeps
// `with_capacity` total on native; the v1 wasm self-host
// (stdlib/list_make.almd) reserves NOTHING — `list_with_capacity` ignores
// `cap` and returns a fresh empty list — so there is no wasm-side ceiling to
// mirror, and the two legs still agree because the reservation is
// unobservable (C-034). v0's wasm leg clamped at the same 64 MiB in
// emit_wasm/calls_list.rs, retired in c71eff7b.
pub const ALMIDE_MAX_WITH_CAPACITY_PREALLOC_BYTES: usize = 64 * 1024 * 1024; // 64 MiB
#[inline(always)] pub fn almide_rt_list_with_capacity<A>(cap: i64) -> Vec<A> {
    let elem_size = std::mem::size_of::<A>().max(1);
    let max_cap = ALMIDE_MAX_WITH_CAPACITY_PREALLOC_BYTES / elem_size;
    Vec::with_capacity((cap.max(0) as usize).min(max_cap))
}
pub fn almide_rt_list_pop<A>(xs: &mut Vec<A>) -> Option<A> { xs.pop() }
pub fn almide_rt_list_clear<A>(xs: &mut Vec<A>) { xs.clear(); }

// ── Algorithmic primitives (Phase 3 stdlib expansion) ──

pub fn almide_rt_list_binary_search(xs: &[i64], target: i64) -> Option<i64> {
    xs.binary_search(&target).ok().map(|i| i as i64)
}

// map extern — Rust native implementations
// TOML templates use &{m} for read-only, {m} for consuming
//
// `Map[K,V]` is an INSERTION-ORDERED map, mirroring the wasm Map's intended
// insertion order so native == wasm observably (std HashMap iterates in
// hash-bucket order, randomized per process). `AlmideMap` is a Vec<(K,V)>
// keyed by first-seen insertion order: insert updates a key's value in place
// (keeping its position) and appends new keys; remove preserves the order of
// survivors. Key bound is `PartialEq` (not `Eq + Hash`) — same as the wasm
// keyed lookup contract, and lets non-Hash keys work.
//
// Lookup (#2150): `entries` stays the single source of truth for order,
// equality and repr; once a map grows past `ALMIDE_MAP_INDEX_THRESHOLD` with
// a hashable key type it carries an `AlmideKeyIndex` — the compact-ordered-
// dict shape (CPython 3.6+, Roc's Dict): an open-addressing slot table of
// entry POSITIONS beside a per-entry cache of the full 64-bit hash. A probe
// compares the cached hash before touching the key, so a String miss costs
// one hash and no string compares; a hit costs one hash and one `==`. One
// hash per operation (the earlier sidecar SipHashed the key AND the
// fingerprint again inside a `HashMap<u64, u32>`, ~4 SipHash passes per
// `get_or` + `insert` pair). Key types with no hash (see `key_hash` —
// notably Float, where `NaN != NaN` must keep behaving exactly like the
// linear scan) stay on the linear path for good. The persistent ops
// (`map.set` et al) still clone O(n) per op — the index changes the read
// side and the mutable-insert side, not the copy.

/// Entry count at which an indexable map builds its index. Below this a
/// linear scan over `Vec<(K, V)>` is faster than hashing. Shared with set.rs
/// via flat inlining (set's source references the `almide_rt_map_`-prefixed
/// fns below, which is what RUNTIME_DEPS keys on).
pub const ALMIDE_MAP_INDEX_THRESHOLD: usize = 16;

/// Empty slot marker in `AlmideKeyIndex::slots`. A live slot is never all
/// ones: its low half is an entry position, and positions stay below
/// `u32::MAX - 1`.
pub const ALMIDE_MAP_SLOT_EMPTY: u64 = u64::MAX;

/// A removed entry's slot (#3691): a probe passes over it, an insert never
/// claims it. Its low half is no position a live slot can hold.
pub const ALMIDE_MAP_SLOT_DEAD: u64 = u64::MAX - 1;

/// The half of a slot that holds the upper 32 bits of the entry's hash.
pub const ALMIDE_MAP_SLOT_TAG: u64 = 0xFFFF_FFFF_0000_0000;

/// Odd 64-bit multiplier (the golden-ratio constant) shared by the hashers.
pub const ALMIDE_MAP_HASH_MUL: u64 = 0x9E37_79B9_7F4A_7C15;

/// splitmix64 finalizer: every input bit reaches every output bit, so the
/// low bits the slot mask keeps are as good as the high ones.
#[inline]
pub fn almide_rt_map_mix64(x: u64) -> u64 {
    let mut z = x.wrapping_add(ALMIDE_MAP_HASH_MUL);
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
    z ^ (z >> 31)
}

/// Multiply-fold over 8-byte words (the FxHash step) with the length mixed
/// in and a splitmix finalizer — one multiply per word, no per-byte loop.
/// The 1..=7-byte tail is read with fixed-width loads (two overlapping
/// `u32`s, or first/middle/last byte — wyhash's small-input read) instead
/// of a variable-length copy into a zeroed buffer, which compiled to a
/// `memcpy` call on every short key (#2157: a word-count key is 3..8 bytes,
/// so the call ran once per lookup). The length is already in `h`, so the
/// overlapping reads cannot make two different lengths collide.
#[inline]
pub fn almide_rt_map_hash_bytes(b: &[u8]) -> u64 {
    let mut h: u64 = (b.len() as u64).wrapping_mul(ALMIDE_MAP_HASH_MUL);
    let mut words = b.chunks_exact(8);
    for w in &mut words {
        let mut buf = [0u8; 8];
        buf.copy_from_slice(w);
        h = (h ^ u64::from_le_bytes(buf)).wrapping_mul(ALMIDE_MAP_HASH_MUL).rotate_left(29);
    }
    let rest = words.remainder();
    if !rest.is_empty() {
        h = (h ^ almide_map_hash_tail(rest)).wrapping_mul(ALMIDE_MAP_HASH_MUL).rotate_left(29);
    }
    almide_rt_map_mix64(h)
}

/// The 1..=7 bytes after the last whole word, as one `u64` (see above).
#[inline]
fn almide_map_hash_tail(b: &[u8]) -> u64 {
    let n = b.len();
    if n >= 4 {
        let lo = u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as u64;
        let hi = u32::from_le_bytes([b[n - 4], b[n - 3], b[n - 2], b[n - 1]]) as u64;
        lo | (hi << 32)
    } else {
        (b[0] as u64) | ((b[n / 2] as u64) << 8) | ((b[n - 1] as u64) << 16)
    }
}

/// Order-sensitive pair combine: `(a, b)` and `(b, a)` hash differently.
#[inline]
pub fn almide_rt_map_hash_pair(a: u64, b: u64) -> u64 {
    almide_rt_map_mix64(a.wrapping_mul(ALMIDE_MAP_HASH_MUL) ^ b)
}

#[inline]
fn almide_map_hash_seq(hs: impl Iterator<Item = u64>) -> u64 {
    almide_rt_map_mix64(hs.fold(0x51_7CC1_B727_220A_95u64, almide_rt_map_hash_pair))
}

/// Hash for the key types the index supports. `None` = this key type stays
/// on the linear path (the answer is per TYPE, never per value, so one probe
/// decides a map's fate). Equality is always re-confirmed with `PartialEq`
/// after a hash hit, so a collision can never produce a wrong answer — only
/// an extra comparison. The `&dyn Any` downcasts fold to one branch per
/// monomorphization. The `almide_rt_map_` name is deliberate: it is how
/// build.rs's RUNTIME_DEPS extraction learns that a module referencing this
/// helper (set.rs) needs map's source spliced in.
pub fn almide_rt_map_key_hash<K: 'static>(k: &K) -> Option<u64> {
    let a = k as &dyn std::any::Any;
    if let Some(x) = a.downcast_ref::<i64>() {
        return Some(almide_rt_map_mix64(*x as u64));
    }
    if let Some(s) = a.downcast_ref::<AlmideString>() {
        return Some(almide_rt_map_hash_bytes(s.as_bytes()));
    }
    if let Some(b) = a.downcast_ref::<bool>() {
        return Some(almide_rt_map_mix64(*b as u64));
    }
    almide_map_key_hash_compound(a)
}

fn almide_map_key_hash_compound(a: &dyn std::any::Any) -> Option<u64> {
    if let Some((x, y)) = a.downcast_ref::<(i64, i64)>() {
        return Some(almide_rt_map_hash_pair(*x as u64, *y as u64));
    }
    if let Some((x, y)) = a.downcast_ref::<(AlmideString, AlmideString)>() {
        return Some(almide_rt_map_hash_pair(almide_rt_map_hash_bytes(x.as_bytes()), almide_rt_map_hash_bytes(y.as_bytes())));
    }
    if let Some((x, y)) = a.downcast_ref::<(AlmideString, i64)>() {
        return Some(almide_rt_map_hash_pair(almide_rt_map_hash_bytes(x.as_bytes()), *y as u64));
    }
    if let Some((x, y)) = a.downcast_ref::<(i64, AlmideString)>() {
        return Some(almide_rt_map_hash_pair(*x as u64, almide_rt_map_hash_bytes(y.as_bytes())));
    }
    if let Some(xs) = a.downcast_ref::<Vec<i64>>() {
        return Some(almide_map_hash_seq(xs.iter().map(|x| *x as u64)));
    }
    if let Some(xs) = a.downcast_ref::<Vec<AlmideString>>() {
        return Some(almide_map_hash_seq(xs.iter().map(|s| almide_rt_map_hash_bytes(s.as_bytes()))));
    }
    almide_map_key_hash_sized_int(a)
}

fn almide_map_key_hash_sized_int(a: &dyn std::any::Any) -> Option<u64> {
    if let Some(x) = a.downcast_ref::<i32>() { return Some(almide_rt_map_mix64(*x as u64)); }
    if let Some(x) = a.downcast_ref::<i16>() { return Some(almide_rt_map_mix64(*x as u64)); }
    if let Some(x) = a.downcast_ref::<i8>() { return Some(almide_rt_map_mix64(*x as u64)); }
    if let Some(x) = a.downcast_ref::<u64>() { return Some(almide_rt_map_mix64(*x)); }
    if let Some(x) = a.downcast_ref::<u32>() { return Some(almide_rt_map_mix64(*x as u64)); }
    if let Some(x) = a.downcast_ref::<u16>() { return Some(almide_rt_map_mix64(*x as u64)); }
    if let Some(x) = a.downcast_ref::<u8>() { return Some(almide_rt_map_mix64(*x as u64)); }
    // A runtime-internal `String` key (not an Almide String, which is `AlmideString` above).
    if let Some(s) = a.downcast_ref::<String>() { return Some(almide_rt_map_hash_bytes(s.as_bytes())); }
    None
}

/// What a lookup key must provide: its hash, agreeing with the stored key
/// type's hash for every `K: Borrow<Q>` pair the read side admits. The
/// blanket impl covers every sized key; `str` is the one unsized borrow —
/// a `&str` parameter (the borrow-inferred rendering of a String param)
/// probes a `Map[String, _]` without materializing a String first, and
/// hashes byte-identically to the stored `AlmideString`.
pub trait AlmideMapKey {
    fn almide_key_hash(&self) -> Option<u64>;
}
impl<T: 'static> AlmideMapKey for T {
    #[inline]
    fn almide_key_hash(&self) -> Option<u64> {
        almide_rt_map_key_hash(self)
    }
}
impl AlmideMapKey for str {
    #[inline]
    fn almide_key_hash(&self) -> Option<u64> {
        Some(almide_rt_map_hash_bytes(self.as_bytes()))
    }
}

/// The hash index beside an insertion-ordered entry vector: `hashes[p]` is
/// the full hash of entry `p`, `slots` is a power-of-two linear-probe table
/// (load ≤ 3/4) whose slots each carry an entry position (low 32 bits) AND
/// the upper 32 bits of that entry's hash. A probe rejects a slot on the tag
/// it already loaded — it never reads `hashes[p]` (a second, dependent load
/// into another array) — and touches the entry only on a tag match. Shared
/// by `AlmideMap` and `AlmideSet`.
///
/// Removal tombstones (#3691). The owner leaves a hole at the removed
/// entry's position instead of shifting the later entries down (insertion
/// order is observable, C-033, so `swap_remove` is out), and `kill` marks
/// the entry's slot `ALMIDE_MAP_SLOT_DEAD`: a probe steps over it and an
/// insert never reuses it. Every position — live or dead — owns exactly one
/// non-empty slot, so `hashes.len()` stays the occupancy the growth check
/// reads, and growth re-places only the live slots. The owner compacts
/// (`retain`, its entries the same way) once the holes outnumber the live
/// entries, so a removal is amortized O(1) where the shift-and-rebuild it
/// replaced was O(n) per call.
#[derive(Clone, Debug, Default)]
pub struct AlmideKeyIndex {
    hashes: Vec<u64>,
    slots: Vec<u64>,
}

impl AlmideKeyIndex {
    pub fn with_capacity(n: usize) -> Self {
        let slot_len = (n * 4 / 3 + 1).next_power_of_two().max(32);
        AlmideKeyIndex { hashes: Vec::with_capacity(n), slots: vec![ALMIDE_MAP_SLOT_EMPTY; slot_len] }
    }

    /// Position of the entry whose hash is `h` and whose key `eq` confirms.
    #[inline]
    pub fn find(&self, h: u64, mut eq: impl FnMut(usize) -> bool) -> Option<usize> {
        let mask = self.slots.len() - 1;
        let mut i = (h as usize) & mask;
        let tag = h & ALMIDE_MAP_SLOT_TAG;
        loop {
            let s = self.slots[i];
            if s == ALMIDE_MAP_SLOT_EMPTY {
                return None;
            }
            if s & ALMIDE_MAP_SLOT_TAG == tag && s != ALMIDE_MAP_SLOT_DEAD {
                let p = (s & !ALMIDE_MAP_SLOT_TAG) as usize;
                if eq(p) {
                    return Some(p);
                }
            }
            i = (i + 1) & mask;
        }
    }

    /// Record the entry just appended at position `hashes.len()`.
    #[inline]
    pub fn push(&mut self, h: u64) {
        let p = self.hashes.len() as u32;
        self.hashes.push(h);
        if self.hashes.len() * 4 > self.slots.len() * 3 {
            self.grow(self.slots.len() * 2);
        }
        self.place(h, p);
    }

    /// The entry at `p` became a hole: its slot turns dead. Its slot holds
    /// exactly its hash tag and position, so the probe compares whole words
    /// and never touches the entries.
    pub fn kill(&mut self, p: usize) {
        let h = self.hashes[p];
        let want = (h & ALMIDE_MAP_SLOT_TAG) | p as u64;
        let mask = self.slots.len() - 1;
        let mut i = (h as usize) & mask;
        while self.slots[i] != want {
            i = (i + 1) & mask;
        }
        self.slots[i] = ALMIDE_MAP_SLOT_DEAD;
    }

    /// The owner dropped its holes: keep the positions `keep` admits,
    /// renumbered in order, and re-place them in a table sized for them.
    pub fn retain(&mut self, mut keep: impl FnMut(usize) -> bool) {
        let mut p = 0;
        self.hashes.retain(|_| {
            p += 1;
            keep(p - 1)
        });
        let slot_len = (self.hashes.len() * 4 / 3 + 1).next_power_of_two().max(32);
        self.slots.clear();
        self.slots.resize(slot_len, ALMIDE_MAP_SLOT_EMPTY);
        for p in 0..self.hashes.len() {
            self.place(self.hashes[p], p as u32);
        }
    }

    /// Double the table: the live slots are re-placed, the dead ones dropped.
    fn grow(&mut self, slot_len: usize) {
        let old = std::mem::replace(&mut self.slots, vec![ALMIDE_MAP_SLOT_EMPTY; slot_len]);
        for s in old {
            if s != ALMIDE_MAP_SLOT_EMPTY && s != ALMIDE_MAP_SLOT_DEAD {
                let p = (s & !ALMIDE_MAP_SLOT_TAG) as u32;
                self.place(self.hashes[p as usize], p);
            }
        }
    }

    #[inline]
    fn place(&mut self, h: u64, p: u32) {
        let mask = self.slots.len() - 1;
        let mut i = (h as usize) & mask;
        while self.slots[i] != ALMIDE_MAP_SLOT_EMPTY {
            i = (i + 1) & mask;
        }
        self.slots[i] = (h & ALMIDE_MAP_SLOT_TAG) | p as u64;
    }
}

/// Where a keyed collection's lookups go. `Linear` until the threshold;
/// then `Built` for a hashable key type or `Unhashable` for good.
#[derive(Clone, Debug, Default)]
pub enum AlmideKeyLookup {
    #[default]
    Linear,
    Unhashable,
    Built(AlmideKeyIndex),
}

impl AlmideKeyLookup {
    /// Hash `k` only when a built index will consume it.
    #[inline]
    pub fn hash_for<Q: ?Sized + AlmideMapKey>(&self, k: &Q) -> Option<u64> {
        match self {
            AlmideKeyLookup::Built(_) => k.almide_key_hash(),
            _ => None,
        }
    }

    /// Index every key of a collection that just crossed the threshold.
    pub fn build<'a, K: AlmideMapKey + 'a>(&mut self, keys: impl Iterator<Item = &'a K>, n: usize) {
        let mut ix = AlmideKeyIndex::with_capacity(n);
        for k in keys {
            match k.almide_key_hash() {
                Some(h) => ix.push(h),
                None => {
                    *self = AlmideKeyLookup::Unhashable;
                    return;
                }
            }
        }
        *self = AlmideKeyLookup::Built(ix);
    }
}

/// `entries` in insertion order; a removed entry of an indexed map leaves a
/// `None` hole (#3691) that every read skips, counted by `dead`. Holes exist
/// only beside a `Built` index (the linear lanes shift instead — their scan
/// is O(n) per lookup anyway), and `remove` compacts once they outnumber
/// the live entries.
#[derive(Clone, Debug, Default)]
pub struct AlmideMap<K, V> {
    entries: Vec<Option<(K, V)>>,
    dead: usize,
    lookup: AlmideKeyLookup,
}

impl<K, V> AlmideMap<K, V> {
    pub fn new() -> Self {
        AlmideMap { entries: Vec::new(), dead: 0, lookup: AlmideKeyLookup::Linear }
    }
    pub fn len(&self) -> usize {
        self.entries.len() - self.dead
    }
    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }
    pub fn keys(&self) -> impl Iterator<Item = &K> {
        self.iter().map(|(k, _)| k)
    }
    pub fn values(&self) -> impl Iterator<Item = &V> {
        self.iter().map(|(_, v)| v)
    }
    pub fn iter(&self) -> impl Iterator<Item = (&K, &V)> {
        self.entries.iter().flatten().map(|(k, v)| (k, v))
    }
    pub fn clear(&mut self) {
        self.entries.clear();
        self.dead = 0;
        self.lookup = AlmideKeyLookup::Linear;
    }
}

impl<K: PartialEq + 'static, V> AlmideMap<K, V> {
    /// Position of `k` in `entries`, given its hash when the index is built.
    /// `Q` is the borrowed form of the key (`str` for a `String` key), so a
    /// read never has to own a key it only compares.
    #[inline]
    fn position_with<Q: ?Sized + PartialEq>(&self, k: &Q, h: Option<u64>) -> Option<usize>
    where K: std::borrow::Borrow<Q> {
        let is_k = |e: &Option<(K, V)>| matches!(e, Some((ek, _)) if ek.borrow() == k);
        match (&self.lookup, h) {
            (AlmideKeyLookup::Built(ix), Some(h)) => ix.find(h, |p| is_k(&self.entries[p])),
            _ => self.entries.iter().position(is_k),
        }
    }

    #[inline]
    fn position<Q: ?Sized + PartialEq + AlmideMapKey>(&self, k: &Q) -> Option<usize>
    where K: std::borrow::Borrow<Q> {
        self.position_with(k, self.lookup.hash_for(k))
    }

    /// A new entry was appended: extend the index, or build it at the threshold.
    #[inline]
    fn note_push(&mut self, h: Option<u64>) {
        if let AlmideKeyLookup::Built(ix) = &mut self.lookup {
            if let Some(h) = h {
                ix.push(h);
            }
            return;
        }
        // A linear map has no holes, so key order is position order.
        if matches!(self.lookup, AlmideKeyLookup::Linear) && self.entries.len() >= ALMIDE_MAP_INDEX_THRESHOLD {
            self.lookup.build(self.entries.iter().flatten().map(|(k, _)| k), self.entries.len());
        }
    }

    pub fn get<Q: ?Sized + PartialEq + AlmideMapKey>(&self, k: &Q) -> Option<&V>
    where K: std::borrow::Borrow<Q> {
        let i = self.position(k)?;
        self.entries[i].as_ref().map(|(_, v)| v)
    }
    pub fn get_mut<Q: ?Sized + PartialEq + AlmideMapKey>(&mut self, k: &Q) -> Option<&mut V>
    where K: std::borrow::Borrow<Q> {
        let i = self.position(k)?;
        self.entries[i].as_mut().map(|(_, v)| v)
    }
    pub fn contains_key<Q: ?Sized + PartialEq + AlmideMapKey>(&self, k: &Q) -> bool
    where K: std::borrow::Borrow<Q> {
        self.position(k).is_some()
    }
    /// Insert: update the value in place if the key exists (preserving its
    /// position), else append the new entry. Matches insertion-order semantics.
    pub fn insert(&mut self, k: K, v: V) {
        let h = self.lookup.hash_for(&k);
        if let Some(i) = self.position_with(&k, h) {
            if let Some((_, slot)) = &mut self.entries[i] {
                *slot = v;
            }
            return;
        }
        self.entries.push(Some((k, v)));
        self.note_push(h);
    }
    /// `m[k] = f(map.get_or(m, k, init))` in ONE probe (the walker's
    /// `map_upsert` form): present → the slot becomes `f(old)` in place,
    /// absent → `(k, f(init))` is appended. The same hash and position the
    /// two-step `get_or` + `insert` computed twice. `f` runs before the
    /// append, so an `f` that aborts leaves no half-inserted key behind.
    pub fn upsert_with<F: FnOnce(V) -> V>(&mut self, k: K, init: V, f: F) where V: Clone {
        let h = self.lookup.hash_for(&k);
        if let Some(i) = self.position_with(&k, h) {
            if let Some((_, slot)) = &mut self.entries[i] {
                *slot = f(slot.clone());
            }
            return;
        }
        let v = f(init);
        self.entries.push(Some((k, v)));
        self.note_push(h);
    }
    /// Remove, keeping the order of the remaining entries: an indexed map
    /// leaves a hole (amortized O(1), #3691), a linear one shifts.
    pub fn remove(&mut self, k: &K) {
        let Some(i) = self.position(k) else { return };
        let AlmideKeyLookup::Built(ix) = &mut self.lookup else {
            self.entries.remove(i);
            return;
        };
        ix.kill(i);
        self.entries[i] = None;
        self.dead += 1;
        if self.dead * 2 > self.entries.len() {
            let entries = &self.entries;
            ix.retain(|p| entries[p].is_some());
            self.entries.retain(Option::is_some);
            self.dead = 0;
        }
    }
}

// Almide-literal repr for compound string interpolation: `["a": 1, "b": 2]`
// (brackets, Swift-style), empty → `[:]`, keys rendered in their own literal
// form (string keys quoted, int keys bare). Pair order = insertion order, so the
// output matches the wasm compact-ordered-dict walk byte-for-byte.
impl<K: AlmideRepr, V: AlmideRepr> AlmideRepr for AlmideMap<K, V> {
    fn almide_repr(&self) -> String {
        if self.is_empty() {
            return "[:]".to_string();
        }
        let mut o = String::from("[");
        for (i, (k, v)) in self.iter().enumerate() {
            if i > 0 { o.push_str(", "); }
            o.push_str(&k.almide_repr());
            o.push_str(": ");
            o.push_str(&v.almide_repr());
        }
        o.push(']');
        o
    }
}

// Map equality is order-INDEPENDENT (same size + same key/value pairs), matching
// std HashMap and the wasm structural Map `==`.
impl<K: PartialEq + 'static, V: PartialEq> PartialEq for AlmideMap<K, V> {
    fn eq(&self, other: &Self) -> bool {
        self.len() == other.len() && self.iter().all(|(k, v)| other.get(k) == Some(v))
    }
}

impl<K: PartialEq + 'static, V> FromIterator<(K, V)> for AlmideMap<K, V> {
    fn from_iter<I: IntoIterator<Item = (K, V)>>(iter: I) -> Self {
        let mut m = AlmideMap::new();
        for (k, v) in iter {
            m.insert(k, v);
        }
        m
    }
}

impl<K: PartialEq + 'static, V, const N: usize> From<[(K, V); N]> for AlmideMap<K, V> {
    fn from(arr: [(K, V); N]) -> Self {
        arr.into_iter().collect()
    }
}

// ADR-0013: a map returned across the runtime boundary converts its keys and values.
impl<K: AlmideIntoStr, V: AlmideIntoStr> AlmideIntoStr for AlmideMap<K, V> where K::Out: PartialEq + 'static {
    type Out = AlmideMap<K::Out, V::Out>;
    fn into_almide(self) -> Self::Out { self.into_iter().map(|(k, v)| (k.into_almide(), v.into_almide())).collect() }
}

impl<K, V> IntoIterator for AlmideMap<K, V> {
    type Item = (K, V);
    type IntoIter = std::iter::Flatten<std::vec::IntoIter<Option<(K, V)>>>;
    fn into_iter(self) -> Self::IntoIter {
        self.entries.into_iter().flatten()
    }
}

pub fn almide_rt_map_new<K, V>() -> AlmideMap<K, V> { AlmideMap::new() }
pub fn almide_rt_map_len<K, V>(m: &AlmideMap<K, V>) -> i64 { m.len() as i64 }
pub fn almide_rt_map_is_empty<K, V>(m: &AlmideMap<K, V>) -> bool { m.is_empty() }
// The read side borrows its key (`@borrow_ref(key)` in stdlib/map.almd):
// `map.get_or(counts, w, 0)` no longer clones `w` at the call site — the
// clone was one third of the word-count loop's map cost (#2157). `Q` is the
// borrowed key form: `&String`/`&str` for a String key, `&i64` for Int.
pub fn almide_rt_map_get<K: PartialEq + 'static, V: Clone, Q: ?Sized + PartialEq + AlmideMapKey>(m: &AlmideMap<K, V>, k: &Q) -> Option<V>
where K: std::borrow::Borrow<Q> { m.get(k).cloned() }
pub fn almide_rt_map_get_or<K: PartialEq + 'static, V: Clone, Q: ?Sized + PartialEq + AlmideMapKey>(m: &AlmideMap<K, V>, k: &Q, default: V) -> V
where K: std::borrow::Borrow<Q> { m.get(k).cloned().unwrap_or(default) }
// Consuming (@consume(m) in stdlib/map.almd): a caller whose map is dead at
// the call moves it in and this is one hash insert; a caller that still uses
// the source gets its clone inserted by pass_clone at the call site. The
// borrowing `let mut r = m.clone()` form cloned the WHOLE map on every call —
// the fold-accumulator hot loop (#1143) paid it per line. Composes with the
// index: the moved-in map keeps its index, so the insert is O(1) for
// hashable keys.
pub fn almide_rt_map_set<K: PartialEq + Clone + 'static, V: Clone>(mut m: AlmideMap<K, V>, k: K, v: V) -> AlmideMap<K, V> { m.insert(k, v); m }
// Single-scan insert-or-update, consuming like map_set: present → f(old)
// in place (position preserved), absent → append init. Lookup and append go
// through the index-aware `position`/`insert` — a raw `entries.push` here
// would leave a present key out of the index, and a later probe would
// wrongly report it absent.
//
// The present arm hands the old value to `f` by MOVING it out (the unused
// `init` takes its slot for the call's duration) — a `clone` there copied a
// String / List value on every update only to drop the original.
pub fn almide_rt_map_upsert<K: PartialEq + 'static, V: Clone>(m: AlmideMap<K, V>, k: K, init: V, f: std::rc::Rc<dyn Fn(V) -> V>) -> AlmideMap<K, V> {
    almide_rt_map_upsert_fn(m, k, init, move |v| f(v))
}
// The same op with the update fn as a static `F`: RustLowering routes a call
// whose closure is a lambda literal here, so the closure is neither boxed into
// a fresh `Rc` per call nor called through a vtable.
pub fn almide_rt_map_upsert_fn<K: PartialEq + 'static, V: Clone, F: Fn(V) -> V>(mut m: AlmideMap<K, V>, k: K, init: V, f: F) -> AlmideMap<K, V> {
    if let Some(v) = m.get_mut(&k) {
        let old = std::mem::replace(v, init);
        *v = f(old);
    } else {
        m.insert(k, init);
    }
    m
}
// String-keyed twins whose key arrives BORROWED (`StrMapKey`, the final-IR
// rewrite of `k.to_string()` at the key slot): the key is copied only when it
// is inserted, never when it is found.
pub fn almide_rt_map_upsert_str_fn<V: Clone, F: Fn(V) -> V>(mut m: AlmideMap<AlmideString, V>, k: &str, init: V, f: F) -> AlmideMap<AlmideString, V> {
    let __almide_v: AlmideMap<AlmideString, V> = {
        if let Some(v) = m.get_mut(k) {
            let old = std::mem::replace(v, init);
            *v = f(old);
        } else {
            m.insert(AlmideString::from(k), init);
        }
        m
    };
    __almide_v
}
pub fn almide_rt_map_set_str<V: Clone>(mut m: AlmideMap<AlmideString, V>, k: &str, v: V) -> AlmideMap<AlmideString, V> {
    let __almide_v: AlmideMap<AlmideString, V> = {
        match m.get_mut(k) {
            Some(slot) => *slot = v,
            None => m.insert(AlmideString::from(k), v),
        }
        m
    };
    __almide_v
}
pub fn almide_rt_map_remove<K: PartialEq + Clone + 'static, V: Clone>(m: &AlmideMap<K, V>, k: K) -> AlmideMap<K, V> { let mut r = m.clone(); r.remove(&k); r }
// The owned twin (`@reuse(m)`, #3640): a source at its last use is edited in
// place instead of cloned.
pub fn almide_rt_map_remove_owned<K: PartialEq + Clone + 'static, V: Clone>(mut m: AlmideMap<K, V>, k: K) -> AlmideMap<K, V> { m.remove(&k); m }
pub fn almide_rt_map_contains<K: PartialEq + 'static, V, Q: ?Sized + PartialEq + AlmideMapKey>(m: &AlmideMap<K, V>, k: &Q) -> bool
where K: std::borrow::Borrow<Q> { m.contains_key(k) }
pub fn almide_rt_map_keys<K: Clone, V>(m: &AlmideMap<K, V>) -> Vec<K> { m.keys().cloned().collect() }
pub fn almide_rt_map_values<K, V: Clone>(m: &AlmideMap<K, V>) -> Vec<V> { m.values().cloned().collect() }
pub fn almide_rt_map_entries<K: Clone, V: Clone>(m: &AlmideMap<K, V>) -> Vec<(K, V)> { m.iter().map(|(k, v)| (k.clone(), v.clone())).collect() }
// The OWNED twins of the whole-map reads (`owned_source.rs`, the #3398
// mechanism the list range ops use). Where the source map is not read again
// — its last use, or a temporary such as `list.group_by(..)`'s result —
// BorrowLowering hands it over by value and the twin MOVES every key and
// value out instead of cloning it. `map_values_owned` also keeps the source's
// key index: the keys and their order are unchanged, so the hashes and the
// slot table stay valid as they are and nothing is rehashed.
pub fn almide_rt_map_keys_owned<K, V>(m: AlmideMap<K, V>) -> Vec<K> { m.into_iter().map(|(k, _)| k).collect() }
pub fn almide_rt_map_values_owned<K, V>(m: AlmideMap<K, V>) -> Vec<V> { m.into_iter().map(|(_, v)| v).collect() }
pub fn almide_rt_map_entries_owned<K, V>(m: AlmideMap<K, V>) -> Vec<(K, V)> { m.entries.into_iter().flatten().collect() }
// The holes stay where they are, so the index and `dead` carry over as is.
pub fn almide_rt_map_map_values_owned<K, V, W>(m: AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(V) -> W>) -> AlmideMap<K, W> {
    let AlmideMap { entries, dead, lookup } = m;
    AlmideMap { entries: entries.into_iter().map(|e| e.map(|(k, v)| (k, f(v)))).collect(), dead, lookup }
}
pub fn almide_rt_map_merge<K: PartialEq + Clone + 'static, V: Clone>(a: &AlmideMap<K, V>, b: &AlmideMap<K, V>) -> AlmideMap<K, V> { let mut r = a.clone(); for (k, v) in b.iter() { r.insert(k.clone(), v.clone()); } r }
// The owned twin (`@reuse(a)`, #3643): a left map at its last use is extended
// in place instead of cloned — b's keys a has take b's value where they are,
// b's new keys append in b's order (`insert`).
pub fn almide_rt_map_merge_owned<K: PartialEq + Clone + 'static, V: Clone>(mut a: AlmideMap<K, V>, b: &AlmideMap<K, V>) -> AlmideMap<K, V> { for (k, v) in b.iter() { a.insert(k.clone(), v.clone()); } a }

pub fn almide_rt_map_filter<K: PartialEq + Clone + 'static, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V) -> bool>) -> AlmideMap<K, V> {
    let f = move |a, b| f(a, b);
    m.iter().filter(|(k, v)| f((*k).clone(), (*v).clone())).map(|(k, v)| (k.clone(), v.clone())).collect()
}

pub fn almide_rt_map_map_values<K: PartialEq + Clone + 'static, V: Clone, W>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(V) -> W>) -> AlmideMap<K, W> {
    let f = move |a| f(a);
    m.iter().map(|(k, v)| (k.clone(), f((*v).clone()))).collect()
}

pub fn almide_rt_map_from_entries<K: PartialEq + 'static, V>(entries: Vec<(K, V)>) -> AlmideMap<K, V> { entries.into_iter().collect() }
pub fn almide_rt_map_from_list<K: PartialEq + Clone + 'static, V: Clone>(keys: &[K], values: &[V]) -> AlmideMap<K, V> { keys.iter().cloned().zip(values.iter().cloned()).collect() }

pub fn almide_rt_map_fold<K: Clone, V: Clone, A>(m: &AlmideMap<K, V>, init: A, f: std::rc::Rc<dyn Fn(A, K, V) -> A>) -> A {
    let f = move |a, k, v| f(a, k, v);
    let mut acc = init;
    for (k, v) in m.iter() { acc = f(acc, k.clone(), v.clone()); }
    acc
}
pub fn almide_rt_map_any<K: Clone, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V) -> bool>) -> bool {
    let f = move |a, b| f(a, b);
    m.iter().any(|(k, v)| f(k.clone(), v.clone()))
}
pub fn almide_rt_map_all<K: Clone, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V) -> bool>) -> bool {
    let f = move |a, b| f(a, b);
    m.iter().all(|(k, v)| f(k.clone(), v.clone()))
}
pub fn almide_rt_map_count<K: Clone, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V) -> bool>) -> i64 {
    let f = move |a, b| f(a, b);
    m.iter().filter(|&(k, v)| f(k.clone(), v.clone())).count() as i64
}
pub fn almide_rt_map_each<K: Clone, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V)>) {
    let f = move |a, b| f(a, b);
    for (k, v) in m.iter() { f(k.clone(), v.clone()); }
}
pub fn almide_rt_map_find<K: Clone + PartialEq + 'static, V: Clone>(m: &AlmideMap<K, V>, f: std::rc::Rc<dyn Fn(K, V) -> bool>) -> Option<(K, V)> {
    let f = move |a, b| f(a, b);
    m.iter().find(|&(k, v)| f(k.clone(), v.clone())).map(|(k, v)| (k.clone(), v.clone()))
}
pub fn almide_rt_map_update<K: PartialEq + Clone + 'static, V: Clone>(m: &AlmideMap<K, V>, key: K, f: std::rc::Rc<dyn Fn(V) -> V>) -> AlmideMap<K, V> {
    almide_rt_map_update_owned(m.clone(), key, f)
}
// `@reuse(m)` (#3707): `m = map.update(m, k, f)` over a dying `m` updates
// the map it is handed instead of a copy of it.
pub fn almide_rt_map_update_owned<K: PartialEq + Clone + 'static, V: Clone>(mut m: AlmideMap<K, V>, key: K, f: std::rc::Rc<dyn Fn(V) -> V>) -> AlmideMap<K, V> {
    let f = move |a| f(a);
    if let Some(v) = m.get(&key).cloned() { m.insert(key, f(v)); }
    m
}

// ── Mutable operations ──

pub fn almide_rt_map_insert<K: PartialEq + 'static, V>(m: &mut AlmideMap<K, V>, k: K, v: V) { m.insert(k, v); }
pub fn almide_rt_map_delete<K: PartialEq + 'static, V>(m: &mut AlmideMap<K, V>, k: K) { m.remove(&k); }
pub fn almide_rt_map_clear<K, V>(m: &mut AlmideMap<K, V>) { m.clear(); }

//__ALMIDE_RT_BOUNDARY__
pub fn process(xs: &[i64]) -> i64 {
    (xs).iter().cloned().filter(|x| {
        let x: i64 = (*x);
        (x > 0i64)
    }).map(|x| (x).wrapping_mul(2i64)).fold(0i64, |acc, x| (acc).wrapping_add(x))
}
