// A failing `guard let … else err(e)` leaves the FUNCTION wherever it stands,
// not only at the fn's tail (#4653). Inside a branch-statement arm (an `if`,
// a `match` arm, an `if` in a loop body) the statements after the branch do
// not run and the caller receives the err; in a Unit `effect fn` the err
// reaches the caller instead of being dropped. The values built before the
// failing guard and the bound payload are heap values, so the early exit
// also has to release them: the run ends with no block live on wasm.
//
// The else leaves the fn with ITS value whatever its shape (#4655): a block
// that logs and ends in `err(e)`, an `ok(x)` / `none` / plain value that is
// the fn's early result, a branching else, a Unit else. From an arm of a
// statement none of them may fall through to the code after the branch, and
// at the tail of a Unit `effect fn` an err ending a block else is the fn's
// err, not a dropped value.
fn parse_name(s: String) -> Result[String, String] =
  if string.len(s) > 0 then ok("<" + s + ">") else err("empty name")

fn pick(n: Int) -> Int? = if n > 0 then some(n) else none

fn in_if_arm(c: Bool, s: String) -> Result[String, String] = {
  var log = ["start"]
  if c then {
    guard let name = parse_name(s) else err("if arm: no name")
    log = log + [name]
  } else ()
  log = log + ["end"]
  ok(list.join(log, " "))
}

fn in_match_arm(o: Int?, n: Int) -> Result[Int, String] = {
  var total = 0
  match o {
    some(k) => {
      guard let v = pick(n) else err("match arm: nothing picked for " + int.to_string(k))
      total = total + k + v
    },
    none => (),
  }
  ok(total + 1000)
}

fn in_loop_branch(xs: List[String]) -> Result[String, String] = {
  var acc = ""
  for x in xs {
    if string.len(acc) < 100 then {
      guard let name = parse_name(x) else err(e) => err("loop: " + e + " after " + acc)
      acc = acc + name
    } else ()
  }
  ok(acc)
}

effect fn unit_tail(s: String) -> Unit = {
  let pre = "checking [" + s + "]"
  println(pre)
  guard let name = parse_name(s) else err("unit effect: no name")
  println("got " + name)
}

effect fn unit_in_arm(c: Bool, n: Int) -> Unit = {
  let label = "n=" + int.to_string(n)
  if c then {
    guard let v = pick(n) else err("unit effect arm: " + label)
    println(label + " picked " + int.to_string(v))
  } else ()
  println(label + " done")
}

fn block_err_in_if_arm(c: Bool, s: String) -> Result[String, String] = {
  var log = ["start"]
  if c then {
    guard let name = parse_name(s) else {
      println("leaving after " + list.join(log, ","))
      err("if arm block: no name")
    }
    log = log + [name]
  } else ()
  log = log + ["end"]
  ok(list.join(log, " "))
}

fn ok_in_match_arm(o: Int?, s: String) -> Result[String, String] = {
  var seen = ["m"]
  match o {
    some(k) => {
      guard let name = parse_name(s) else ok("early at " + int.to_string(k))
      seen = seen + [name]
    },
    none => (),
  }
  ok(list.join(seen, "+"))
}

fn none_in_loop_branch(xs: List[Int]) -> String? = {
  var acc = "picked"
  for x in xs {
    if x != 7 then {
      guard let v = pick(x) else none
      acc = acc + " " + int.to_string(v)
    } else ()
  }
  some(acc)
}

fn value_in_if_arm(c: Bool, s: String) -> String = {
  var out = "v:"
  if c then {
    guard let name = parse_name(s) else "fallback for [" + out + "]"
    out = out + name
  } else ()
  out + "."
}

fn branching_in_while(n: Int) -> Result[String, String] = {
  var i = 0
  var acc = "w"
  while i < 3 {
    if i < 9 then {
      guard let v = pick(n - i) else if n < 0 then err("negative start") else ok("stopped at " + acc)
      acc = acc + int.to_string(v)
    } else ()
    i = i + 1
  }
  ok(acc)
}

fn unit_else_in_arm(c: Bool, n: Int) -> Unit = {
  let label = "u" + int.to_string(n)
  if c then {
    guard let v = pick(n) else { println(label + " nothing") }
    println(label + " has " + int.to_string(v))
  } else ()
  println(label + " after")
}

effect fn unit_tail_block(s: String) -> Unit = {
  let pre = "tail [" + s + "]"
  guard let name = parse_name(s) else {
    println(pre + " leaving")
    err("unit effect block: no name")
  }
  println(pre + " got " + name)
}

effect fn unit_arm_block(c: Bool, s: String) -> Unit = {
  let pre = "arm [" + s + "]"
  if c then {
    guard let name = parse_name(s) else {
      println(pre + " leaving")
      err("unit effect arm block: no name")
    }
    println(pre + " got " + name)
  } else ()
  println(pre + " done")
}

effect fn unit_arm_ok(c: Bool, n: Int) -> Unit = {
  let label = "k=" + int.to_string(n)
  if c then {
    guard let v = pick(n) else ok(())
    println(label + " picked " + int.to_string(v))
  } else ()
  println(label + " done")
}

fn show(r: Result[String, String]) -> String = match r {
  ok(s) => "ok " + s,
  err(e) => "err " + e,
}

fn show_int(r: Result[Int, String]) -> String = match r {
  ok(k) => "ok " + int.to_string(k),
  err(e) => "err " + e,
}

fn show_unit(r: Result[Unit, String]) -> String = match r {
  ok(_) => "ok",
  err(e) => "err " + e,
}

effect fn main() -> Unit = {
  println(show(in_if_arm(false, "")))
  println(show(in_if_arm(true, "ada")))
  println(show(in_if_arm(true, "")))
  println(show_int(in_match_arm(none, 0)))
  println(show_int(in_match_arm(some(5), 2)))
  println(show_int(in_match_arm(some(5), 0)))
  println(show(in_loop_branch(["a", "b"])))
  println(show(in_loop_branch(["a", "", "c"])))
  println(show_unit(unit_tail("bo")))
  println(show_unit(unit_tail("")))
  println(show_unit(unit_in_arm(false, 0)))
  println(show_unit(unit_in_arm(true, 3)))
  println(show_unit(unit_in_arm(true, 0)))
  println(show(block_err_in_if_arm(false, "")))
  println(show(block_err_in_if_arm(true, "eve")))
  println(show(block_err_in_if_arm(true, "")))
  println(show(ok_in_match_arm(none, "")))
  println(show(ok_in_match_arm(some(4), "kit")))
  println(show(ok_in_match_arm(some(4), "")))
  println(none_in_loop_branch([1, 7, 2]) ?? "nothing")
  println(none_in_loop_branch([1, 0, 2]) ?? "nothing")
  println(value_in_if_arm(false, ""))
  println(value_in_if_arm(true, "lin"))
  println(value_in_if_arm(true, ""))
  println(show(branching_in_while(9)))
  println(show(branching_in_while(2)))
  println(show(branching_in_while(-1)))
  unit_else_in_arm(false, 0)
  unit_else_in_arm(true, 6)
  unit_else_in_arm(true, 0)
  println(show_unit(unit_tail_block("mo")))
  println(show_unit(unit_tail_block("")))
  println(show_unit(unit_arm_block(false, "")))
  println(show_unit(unit_arm_block(true, "ny")))
  println(show_unit(unit_arm_block(true, "")))
  println(show_unit(unit_arm_ok(false, 0)))
  println(show_unit(unit_arm_ok(true, 8)))
  println(show_unit(unit_arm_ok(true, 0)))
  println("end")
}
