// The WALL row: the oracle runs it and the structural wasm leg declines it — `string.clear`
// on a record FIELD is `string-clear-nonvar` (#2747), the shape
// spec/wasm_cross/inplace_clear_alias_field.almd pins. A lifted wall turns this into a match
// on both sides and the ledger rows the parity test forges into STALE on both; the comparison
// does not care which.
type R = { name: String }

fn main() -> Unit = {
  var r = R { name: "hi" }
  string.clear(r.name)
  println("[" + r.name + "]")
}
