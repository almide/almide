package wasi:clocks@0.3.0;

// duration (nanoseconds) — the type wasi:http/types' request-options
// timeouts name (#1710 increment 2).
interface types {
  type duration = u64;
}

// The monotonic clock: `now` for datetime.monotonic_ns (fs_call op 60),
// `wait-for` for env.sleep_ms (op 36, ADR-0023 step 3).
interface monotonic-clock {
  use types.{duration};
  type mark = u64;
  now: func() -> mark;
  wait-for: async func(how-long: duration);
}

interface system-clock {
  record instant {
    seconds: s64,
    nanoseconds: u32,
  }
  now: func() -> instant;
}
