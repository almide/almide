package wasi:clocks@0.3.0;

// duration (nanoseconds) — the type wasi:http/types' request-options
// timeouts name (#1710 increment 2).
interface types {
  type duration = u64;
}

// The monotonic clock, `now` only: datetime.monotonic_ns (fs_call op 60).
interface monotonic-clock {
  type mark = u64;
  now: func() -> mark;
}

interface system-clock {
  record instant {
    seconds: s64,
    nanoseconds: u32,
  }
  now: func() -> instant;
}
