// The direct-p3 world (#1628 stage 2): the five-op host surface of the
// p2 world (console out, exit, stdin, entropy, wall clock) spelled as
// WASI 0.3 interfaces — stdio rides component-model streams and the
// async canonical ABI (write-via-stream is a sync import returning a
// completion future; the guest drives the async stream builtins through
// waitable-set.wait — no 🚝 sync builtin, ADR-0023 step 1 — and drains
// the future before task-return) — PLUS the filesystem surface: the p1 fs
// service spliced over a wasi:filesystem@0.3 adapter (#3140), resolving
// paths against the whole preopen table.
// env.get / the program arguments / env.sleep_ms ride wasi:cli/environment
// and monotonic-clock.wait-for (ADR-0023 step 3); the rest of env and
// process keep the defined refusal inside the shims. An import the module
// does not use is left out of the component by wit-component.
package almide:runtime-p3@0.1.0;

world p3-command {
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import wasi:cli/exit@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:random/random@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;

  export wasi:cli/run@0.3.0;
}

// The http-importing twin (#1710 increment 2): selected ONLY when the
// program's host ops include the http client family, so an http-free
// component keeps instantiating without `-S http`. The outgoing client
// rides `wasi:http/client@0.3.0.send` (the async canonical ABI — the
// same subtask machinery the fan prefetch lowers onto).
world p3-command-http {
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import wasi:cli/exit@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:random/random@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;

  export wasi:cli/run@0.3.0;
}

// The stock serve export (#2659, ADR-0020 §5.4, ADR-0023 §3.3, C-375): a
// serve-shaped program's component, which `wasmtime serve` runs with no
// flags. NO wasi:filesystem — `wasmtime serve` links none without
// `-S cli=y` (measured on wasmtime 47), so the fs ops are E081 on this shape
// — and no `wasi:cli/run`: `main` is not an entry point; the handler export
// calls it once per request (wasi_p3_serve.rs).
world p3-service {
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import wasi:cli/exit@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:random/random@0.3.0;
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;

  export wasi:http/handler@0.3.0;
}
