// almide:process/spawn — the PRIVATE subprocess capability (#2589, ADR-0025).
//
// Stock WASI (0.2 and 0.3) has no subprocess API. This interface is Almide's
// own, the one exception ADR-0025 makes to ADR-0023 §2.6 (no private host ABI
// on stock runtimes). It is bounded three ways:
//
// - it ships only when the program's op set names a process op (80..=90,
//   or the `start` child's 140..=145):
//   a program that never starts a child never carries the import;
// - a host that does not implement it refuses the module at load (stock
//   wasmtime: "unknown import: `almide:process/spawn::call` has not been
//   defined") — never a silent wrong answer at run time;
// - every operation that starts a child is checked against the project's
//   `[permissions] proc` allowlist, at compile time (`cli::check_permissions`)
//   and again by the host.
//
// The core-module import is the canonical-ABI lowering of `call`:
//   (import "almide:process/spawn" "call"
//     (func (param $op i32) (param $a-ptr i32) (param $a-len i32)
//           (param $b-ptr i32) (param $b-len i32) (param $ret i32)))
// with the answer's bytes placed through the module's `cabi_realloc` export.
// The embedded host (`almide run --target wasm`, `almide test`) serves the
// same operations to the raw module as `almide.fs_call` ops 80..=90 and
// 140..=145.
package almide:process;

interface spawn {
  /// The operation; the case index is the host op minus 80.
  ///
  /// Operands are text. `argv` is the argument list as decimal CHAR-length
  /// cells (`<chars>\n<payload>`, one per argument).
  enum op {
    /// a = cmd, b = argv. ok = stdout (exit 0); err = stderr, or a status
    /// line when stderr is empty, or the spawn error.
    exec,
    /// a = dir, b = [cmd] ++ argv. ok = stdout; err = stderr or spawn error.
    exec-in,
    /// a = cmd, b = [input] ++ argv; input is piped to the child's stdin.
    /// (exec-in, exec-with-stdin, exec-status, spawn and is-alive served the
    /// surface `process.output` / `process.start` replaced; they keep their
    /// cases so every later number holds.)
    exec-with-stdin,
    /// a = cmd, b = argv. ok = `<code>\n<stdout chars>\n<stdout><stderr>`,
    /// code -1 when the child was killed by a signal.
    exec-status,
    /// a = cmd, b = [timeout-ms, dir, stdin] ++ argv (`process.output`,
    /// R-process-02): dir "" keeps the host's, stdin "" gives the child none,
    /// timeout-ms 0 is no deadline. ok as exec-status; err is exactly
    /// `exec timed out after <ms>ms` when the deadline fires (the child's
    /// process group is killed).
    output,
    /// a = cmd, b = argv. The child shares the host's stdin/stdout/stderr;
    /// ok = the exit code in decimal, -1 when a signal ended the child.
    run,
    /// a = cmd, b = argv. Starts the child in the background (stdin null);
    /// ok = its pid in decimal.
    spawn,
    /// a = pid, b = signal, both decimal. ok = empty; err = the platform
    /// tool's stderr.
    kill,
    /// a = pid in decimal. ok = `1` while the process exists, else `0`.
    is-alive,
    /// ok = the host process's pid in decimal.
    pid,
    /// a = dir, b = [cmd, stdin, timeout-ms] ++ argv (`process.run`,
    /// R-process-07): `run` with the child's working directory (dir "" keeps
    /// the host's), stdin text piped in unless "", and a deadline unless 0
    /// (appended last, so the earlier cases keep their numbers).
    run-with,
    /// The `process.start` child (#4308, R-process-03): a host resource. The
    /// host keeps each started child in its own table — the pipes it drains,
    /// the deadline, what was read so far — and the guest holds only its
    /// handle, decimal text in `a`. These cases are host ops 140..=145
    /// (case index = op − 129; host ops 91..=139 serve other families).
    ///
    /// a = cmd, b = [timeout-ms, dir, stdin] ++ argv, as `output`; starts the
    /// child in its own process group and returns at once. ok = the handle;
    /// err = the spawn error, named `process.start(…)`.
    start,
    /// a = handle. Never blocks. ok = `1` once the outcome is in (the child
    /// exited and both pipes ended, or its deadline passed), else `0`.
    poll,
    /// a = handle. Blocks until the outcome; ok as `exec-status`, err is
    /// exactly `exec timed out after <ms>ms` past the deadline.
    wait,
    /// a = handle, b = grace-ms. SIGTERM to the child's group, grace-ms to
    /// end, then SIGKILL; ok as `exec-status` (code -1 when a signal ended
    /// it). Again after the end answers the same outcome.
    stop,
    /// a = handle, b = `1` (stdout) or `2` (stderr). Never blocks. ok = the
    /// text written since the last read; a UTF-8 sequence cut by the read
    /// waits for its rest.
    read-new,
    /// a = handle. ok = the child's pid in decimal.
    child-pid,
  }

  /// Run one operation.
  call: func(op: op, a: string, b: string) -> result<string, string>;
}

world process-host {
  import spawn;
}
