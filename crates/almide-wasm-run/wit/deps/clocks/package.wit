package wasi:clocks@0.2.3;

interface wall-clock {
  record datetime {
    seconds: u64,
    nanoseconds: u32,
  }

  now: func() -> datetime;
}

// The monotonic clock, `now` only: datetime.monotonic_ns (fs_call op 60).
interface monotonic-clock {
  type instant = u64;

  now: func() -> instant;
}
