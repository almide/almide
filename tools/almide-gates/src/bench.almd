// The build-speed benchmark — Unit 0.50 (#999), and the eighth gate this repository runs on
// itself.
//
// It measures what the README publishes: `almide check`, a cold native build, a warm one, and
// a cold wasm build. It is written in Almide rather than shell for the reason the whole
// dogfood exists — but here there is a sharper one. A benchmark harness is the one program
// whose own cost is part of its answer, and shell has no clock: every attempt reaches for an
// external process to read the time, and on a 30ms measurement that process IS the
// measurement. `datetime.monotonic_ns()` is in-process, so the only thing between the two
// readings is the work.
//
// Three failure modes this is written against, each of which happened during Unit 0.50:
//
//   1. **A single-shot number.** `almide check` read 47ms and 28ms on the same binary twenty
//      minutes apart; the first was one run on a loaded machine. Every row is an N-run MEAN
//      and N is published, so a reader can tell noise from signal.
//   2. **A "cold" build that is warm.** `almide clean` clears the DEPENDENCY cache; compiled
//      artifacts live in `$TMPDIR/almide-run`. A whole curve was published where every cold
//      row was a cache hit. Cold here clears BOTH, before every repetition.
//   3. **Measuring the harness.** A first draft took its timestamps by spawning a process per
//      reading — ~45ms each — and reported a 28ms command as 117ms. The harness was four
//      times the size of the thing it measured.
import process
import fs
import env

type Row = { key: String, ms: Int, n: Int }

fn ns_to_ms_x10(ns: Int) -> Int = ns / 100000

// Mean of `n` runs, in tenths of a millisecond so the report can carry one decimal without
// floats. `pre` runs before EACH repetition — that is how cold stays cold — and its own cost
// falls outside the two clock readings.
effect fn bench(key: String, n: Int, pre: List[String], cmd: String, cmd_args: List[String]) -> Row = {
  var total = 0
  for _i in 0..<n {
    if list.len(pre) > 0 then {
      let _ = process.output(process.ProcessCommand { cmd: list.get(pre, 0) ?? "true", args: list.drop(pre, 1) })
      ()
    } else ()
    let t0 = datetime.monotonic_ns()
    let _ = process.output(process.ProcessCommand { cmd: cmd, args: cmd_args })
    total = total + (datetime.monotonic_ns() - t0)
  }
  Row { key: key, ms: ns_to_ms_x10(total / n), n: n }
}

fn fmt_ms(x10: Int) -> String = int.to_string(x10 / 10) + "." + int.to_string(x10 % 10)

fn row_line(r: Row) -> String = string.pad_end(r.key, 9, " ") + " = " + fmt_ms(r.ms) + "   n=" + int.to_string(r.n)

// The RATCHET. Build timing on a shared machine is noisy at the tens-of-percent level, so a
// gate that fires at 5% gets switched off within a week — which is worse than no gate. 1.5x
// catches a real regression (an added pass, a lost cache) and ignores load.
fn regressed(got_x10: Int, base_x10: Int, tol_pct: Int) -> Bool = got_x10 * 100 > base_x10 * tol_pct

fn regression_line(key: String, got_x10: Int, base_x10: Int, tol_pct: Int) -> String = "::error::build-speed REGRESSION: " + key + " is " + fmt_ms(got_x10) + "ms against a " + fmt_ms(base_x10) + "ms baseline (> " + int.to_string(tol_pct / 100) + "." + int.to_string((tol_pct / 10) % 10) + "x)"

fn ok_line(key: String, got_x10: Int, base_x10: Int) -> String = "  " + string.pad_end(key, 9, " ") + " " + string.pad_start(
  fmt_ms(got_x10),
  8,
  " ",
) + "ms  (baseline " + fmt_ms(base_x10) + "ms)"

// `key = VALUE   n=N` — the baseline file's one line shape, read back for the ratchet.
fn baseline_of(lines: List[String], key: String) -> Int = {
  let hit = lines |> list.find((l) => string.starts_with(string.trim(l), key + " "))
  match hit {
    some(l) => {
      let after = list.get(string.split(l, "="), 1) ?? ""
      let num = string.trim(list.get(string.split(string.trim(after), " "), 0) ?? "0")
      let parts = string.split(num, ".")
      (int.parse(list.get(parts, 0) ?? "0") ?? 0) * 10 + (int.parse(list.get(parts, 1) ?? "0") ?? 0)
    },
    none => -1,
  }
}

test "a mean is reported to one decimal without floats" {
  assert_eq(fmt_ms(283), "28.3")
  assert_eq(fmt_ms(7332), "733.2")
  assert_eq(fmt_ms(50), "5.0")
}

test "the ratchet fires above the tolerance and not below it" {
  // 1.5x, expressed as 150 percent so the comparison stays integer.
  assert_eq(regressed(300, 200, 150), false)
  assert_eq(regressed(301, 200, 150), true)
  assert_eq(regressed(100, 200, 150), false)
}

test "a baseline row is read back with its decimal intact" {
  let lines = ["check_ms  = 28.3   n=20", "cold_ms   = 733.2   n=3"]
  assert_eq(baseline_of(lines, "check_ms"), 283)
  assert_eq(baseline_of(lines, "cold_ms"), 7332)
  assert_eq(baseline_of(lines, "absent_ms"), -1)
}

test "the report lines are the shapes the gate publishes" {
  assert_eq(row_line(Row { key: "check_ms", ms: 283, n: 20 }), "check_ms  = 28.3   n=20")
  assert_eq(ok_line("cold_ms", 7332, 7000), "  cold_ms      733.2ms  (baseline 700.0ms)")
}

// The four rows the README publishes, measured together so they share one machine state.
effect fn measure(alm: String, target: String) -> List[Row] = {
  let run_dir = (env.get("TMPDIR") ?? "/tmp") + "/almide-run"
  // Cold clears BOTH caches. `almide clean` alone leaves the compiled artifact in place,
  // which is how a warm build gets published under a cold label.
  let clear = ["sh", "-c", "rm -rf '" + run_dir + "'; '" + alm + "' clean"]
  [
    bench("check_ms", 20, [], alm, ["check", target])!,
    bench("cold_ms", 3, clear, alm, ["build", target, "-o", "/tmp/almide-bs-native"])!,
    bench("warm_ms", 5, [], alm, ["build", target, "-o", "/tmp/almide-bs-native"])!,
    bench(
      "wasm_ms",
      3,
      clear,
      alm,
      [
        "build",
        target,
        "--target",
        "wasm",
        "-o",
        "/tmp/almide-bs.wasm"
      ],
    )!
  ]
}

effect fn sh(cmd: String, cmd_args: List[String]) -> String = string.trim(process.exec(cmd, cmd_args) ?? "")

// The baseline file, with its provenance. A figure without the binary that produced it, the
// machine it ran on, and the date is not reproducible and therefore is not a claim.
effect fn baseline_text(alm: String, target: String, rows: List[Row], tol_pct: Int) -> String = {
  let ver = sh(alm, ["--version"])!
  let sha = string.slice(sh("shasum", ["-a", "256", alm])!, 0, 16)
  let src = fs.read_text(target) ?? ""
  let header = """
    # Build-speed baseline — the SOURCE for docs/benchmarks/README.md's build-speed table (#999).
    # Regenerate: almide run tools/almide-gates/src/main.almd -- bench
    # Ratchet:    almide run tools/almide-gates/src/main.almd -- bench docs/benchmarks --check
    #             (runs only on the `machine` class below — scripts/lib/machine-class.sh)
    #
    # Every row is an N-run MEAN and N is recorded: a single run of a 30ms process is
    # scheduler noise, not a measurement. Cold clears BOTH $TMPDIR/almide-run and the
    # dependency cache before every repetition — clearing only the latter produces a warm
    # build wearing a cold label.
    """
  header + "\n" + "version   = " + ver + "\n" + "binary    = sha256:" + sha + "\n" + "machine   = " + machine_class()! + "\n" + "date      = " + sh(
    "date",
    ["+%Y-%m-%d"],
  )! + "\n" + "target    = " + target + "\n" + "lines     = " + int.to_string(list.len(string.split(src, "\n")) - 1) + "\n" + "tolerance = " + int.to_string(tol_pct) + "\n" + (rows |> list.map(row_line) |> list.join("\n")) + "\n"
}

// The machine class a baseline is a claim about, and whether this machine is it. A build time
// does not transfer between machine classes, so the ratchet judges only on the class the
// baseline records and SAYS so when this is another one — a silent pass on the wrong machine
// would read as a green ratchet. The rule (arch + OS + CPU model) lives once, in
// scripts/lib/machine-class.sh, shared with the wasm-runtime ratio verdict.
effect fn machine_class() -> String = sh("bash", ["scripts/lib/machine-class.sh"])!

effect fn machine_key() -> String = sh("bash", ["scripts/lib/machine-class.sh", "--key"])!

effect fn same_class(recorded: String) -> Bool = {
  let st = process.output(process.ProcessCommand { cmd: "bash", args: ["scripts/lib/machine-class.sh", "--same", recorded] })!
  st.code == 0
}

// `key = VALUE` — a provenance line of the baseline, read back whole.
fn field_of(lines: List[String], key: String) -> String = {
  let hit = lines |> list.find((l) => string.starts_with(string.trim(l), key + " "))
  match hit {
    some(l) => string.trim(list.drop(string.split(l, "="), 1) |> list.join("=")),
    none => "",
  }
}

fn skip_line(recorded: String, here: String) -> String = "build-speed: ratchet SKIPPED — this machine's class (" + here + ") differs from the baseline's (" + recorded + "); a build time does not transfer between machine classes, so there is no verdict here. Run it on the recorded class, or re-stamp with `-- bench` on this one."

// The ratchet's whole verdict: SKIPPED (a pass that says so) on another machine class, the
// per-row 1.5x comparison on the recorded one.
fn gate(same: Bool, recorded: String, here: String, lines: List[String], rows: List[Row], tol_pct: Int) -> (List[String], Bool) =
  if same then check_against(lines, rows, tol_pct)
  else ([skip_line(recorded, here)], true)

fn check_against(lines: List[String], rows: List[Row], tol_pct: Int) -> (List[String], Bool) = {
  var out: List[String] = []
  // `ok` is the Result constructor and cannot be a binding name here.
  var passed = true
  for r in rows {
    let base = baseline_of(lines, r.key)
    if base < 0 then {
      out = out + [
        "::error::build-speed: no baseline row for " + r.key
      ]
      passed = false
    } else if regressed(r.ms, base, tol_pct) then {
      out = out + [
        regression_line(r.key, r.ms, base, tol_pct)
      ]
      passed = false
    } else {
      out = out + [
        ok_line(r.key, r.ms, base)
      ]
    }
  }
  (out, passed)
}

// The README block, rendered FROM the baseline file — never re-measured at render time. A
// generated block whose content depends on the machine that ran the generator would be stale
// on every other machine, and the freshness check would fail for everyone but its author.
// Measuring and publishing are separate acts: `bench` measures, this renders what was measured.
fn readme_block(lines: List[String]) -> List[String] = {
  let field = (k: String) => {
    let hit = lines |> list.find((l) => string.starts_with(string.trim(l), k + " "))
    match hit {
      some(l) => string.trim(list.get(string.split(l, "="), 1) ?? ""),
      none => "?",
    }
  }
  let ms = (k: String) => list.get(string.split(field(k), " "), 0) ?? "?"
  [
    "Measured on " + field("version") + ", " + field("machine") + ", `" + field("target") + "` (" + field("lines") + " lines), " + field("date") + ". Every row is an N-run MEAN —",
    "a single run of a 30ms process is scheduler noise. Cold clears BOTH `$TMPDIR/almide-run`",
    "and the dependency cache before each repetition; clearing only the latter measures a warm",
    "build. Regenerate with `almide run tools/almide-gates/src/main.almd -- bench`; the ratchet",
    "(`-- bench docs/benchmarks --check`) fails at 1.5x on the machine class above and skips, saying so, on any other.",
    "",
    "| scenario | time | runs |",
    "|---|---|---|",
    "| `almide check` | **" + ms("check_ms") + " ms** | 20 |",
    "| build, warm (content-cache hit) | **" + ms("warm_ms") + " ms** | 5 |",
    "| build, cold | **" + ms("cold_ms") + " ms** | 3 |",
    "| build, cold, `--target wasm` | **" + ms("wasm_ms") + " ms** | 3 |"
  ]
}

test "another machine class skips the ratchet and names both classes" {
  let lines = [
    "machine   = x86_64 Linux, Intel Xeon 8581C [GCE c4-standard-8]",
    "check_ms  = 10.0   n=20"
  ]
  let recorded = field_of(lines, "machine")
  assert_eq(recorded, "x86_64 Linux, Intel Xeon 8581C [GCE c4-standard-8]")
  // A 10x regression, on a machine of another class: no verdict, and the line says why.
  let v = gate(
    false,
    recorded,
    "arm64 Darwin, Apple M4 Pro",
    lines,
    [
      Row { key: "check_ms", ms: 1000, n: 20 }
    ],
    150,
  )
  assert_eq(v.1, true)
  let said = list.get(v.0, 0) ?? ""
  assert_eq(string.contains(said, "SKIPPED"), true)
  assert_eq(string.contains(said, "arm64 Darwin, Apple M4 Pro"), true)
  assert_eq(string.contains(said, "x86_64 Linux, Intel Xeon 8581C"), true)
}

test "the recorded machine class still fails a regressed row and passes a held one" {
  let lines = [
    "machine   = x86_64 Linux, Intel Xeon 8581C",
    "check_ms  = 10.0   n=20",
    "cold_ms   = 600.0   n=3"
  ]
  let bad = gate(
    true,
    "x86_64 Linux, Intel Xeon 8581C",
    "x86_64 Linux, Intel Xeon 8581C",
    lines,
    [
      Row { key: "check_ms", ms: 151, n: 20 },
      Row { key: "cold_ms", ms: 6000, n: 3 }
    ],
    150,
  )
  assert_eq(bad.1, false)
  assert_eq(
    string.starts_with(list.get(bad.0, 0) ?? "", "::error::build-speed REGRESSION: check_ms"),
    true,
  )
  let held = gate(
    true,
    "x86_64 Linux, Intel Xeon 8581C",
    "x86_64 Linux, Intel Xeon 8581C",
    lines,
    [
      Row { key: "check_ms", ms: 150, n: 20 },
      Row { key: "cold_ms", ms: 6000, n: 3 }
    ],
    150,
  )
  assert_eq(held.1, true)
  // A row the baseline lacks fails on the recorded class too: the gate cannot pass by reading nothing.
  let missing = gate(true, "x", "x", lines, [
    Row { key: "wasm_ms", ms: 1, n: 3 }
  ], 150)
  assert_eq(missing.1, false)
}

test "the README block is rendered from the baseline, values and provenance both" {
  let base = [
    "version   = almide 0.46.0",
    "machine   = arm64 Darwin",
    "date      = 2026-08-01",
    "target    = examples/lisp.almd",
    "lines     = 268",
    "check_ms  = 22.7   n=20",
    "cold_ms   = 643.9   n=3",
    "warm_ms   = 266.1   n=5",
    "wasm_ms   = 299.1   n=3"
  ]
  let b = readme_block(base)
  assert_eq(list.get(b, 8) ?? "", "| `almide check` | **22.7 ms** | 20 |")
  assert_eq(list.get(b, 10) ?? "", "| build, cold | **643.9 ms** | 3 |")
  // The provenance line carries the binary, the machine and the date — a figure without them
  // is not reproducible and therefore not a claim.
  assert_eq(string.contains(list.get(b, 0) ?? "", "almide 0.46.0, arm64 Darwin"), true)
  assert_eq(string.contains(list.get(b, 0) ?? "", "2026-08-01"), true)
}

// Rewrite everything between the markers, leaving both markers in place. Same discipline as
// `scripts/gen-claims.sh`: the block is DERIVED, so hand-editing it is a defect the freshness
// check catches rather than a change the reader is trusted not to make.
fn splice_block(doc: String, block: List[String]) -> String = {
  let start = "<!-- build-speed:generated:start — derived from docs/benchmarks/build-speed.txt by the almide-gates `bench` subcommand; DO NOT EDIT between the markers -->"
  let stop = "<!-- build-speed:generated:end -->"
  let lines = string.split(doc, "\n")
  var out: List[String] = []
  var inside = false
  for l in lines {
    if l == start then {
      out = out + [start] + block
      inside = true
    } else if l == stop then {
      out = out + [stop]
      inside = false
    } else if not inside then {
      out = out + [l]
    } else ()
  }
  list.join(out, "\n")
}

test "the splice replaces only what is between the markers" {
  let start = "<!-- build-speed:generated:start — derived from docs/benchmarks/build-speed.txt by the almide-gates `bench` subcommand; DO NOT EDIT between the markers -->"
  let stop = "<!-- build-speed:generated:end -->"
  let doc = "before\n" + start + "\nSTALE\nALSO STALE\n" + stop + "\nafter"
  assert_eq(splice_block(doc, ["fresh"]), "before\n" + start + "\nfresh\n" + stop + "\nafter")
  // Idempotent: rendering the same block twice is a no-op, which is what makes the freshness
  // check a string comparison rather than a diff.
  assert_eq(splice_block(splice_block(doc, ["fresh"]), ["fresh"]), splice_block(doc, ["fresh"]))
}
