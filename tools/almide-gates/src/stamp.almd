// The toolchain stamp — `proofs/lib/stamp.sh` in Almide.
//
// Every proof gate prints this before doing anything, and it does one load-bearing check:
// if the `almide` on PATH is not the same binary as `target/release/almide`, the gate ABORTS,
// because the evidence it would produce describes a different compiler than the tree under
// test. This session hit that guard for real — a parity run refused to start until
// `make install` caught the PATH binary up, which is exactly the "one command, one binary"
// rule the fuzz campaigns depend on. It is worth porting first: it is small, it is shared by
// every other gate, and it is the piece whose failure mode is silently-wrong evidence.
import process

type Stamp = { ok: Bool, lines: List[String] }

effect fn run(cmd: String, args: List[String]) -> String = string.trim(process.exec(cmd, args) ?? "")

// `shasum -a 256 <file> | cut -c1-16` — the first 16 hex chars identify the build.
effect fn sha16(path: String) -> String = {
  let out = run("shasum", ["-a", "256", path])!
  if out == "" then ""
  else string.slice(out, 0, 16)
}

// `command` is a shell builtin (macOS has a /usr/bin/command shim, Linux does not), so it
// is asked through a shell — the bash original's `command -v` resolves the same way.
effect fn which(cmd: String) -> String = run("sh", ["-c", "command -v \"$1\"", "_", cmd])!

// `stat -f '%Sm'` (BSD) with the GNU `stat -c '%y'` fallback, as the bash does.
effect fn mtime(path: String) -> String = {
  let bsd = run("stat", ["-f", "%Sm", path])!
  if bsd != "" then bsd
  else run("stat", ["-c", "%y", path])!
}

// The identity half: the `almide` line, and the FATAL block when the PATH binary
// and the workspace build disagree. `ok = false` means the caller must abort AND
// that the stamp ENDS here — the bash `return`s on that path, so the toolchain
// lines and the closing rule are never printed.
effect fn identity(root: String) -> Stamp = {
  let alm = which("almide")!
  if alm == "" then Stamp { ok: true, lines: ["  almide: NOT ON PATH"] } else {
    let ver = run("almide", ["--version"])!
    let hash = sha16(alm)!
    let mt = mtime(alm)!
    let line = "  almide: " + ver + "  sha256:" + hash + "  mtime:" + mt + "  (" + alm + ")"
    let wshash = sha16(root + "/target/release/almide")!
    if wshash != "" and hash != wshash then Stamp {
      ok: false,
      lines: [
        line,
        "  FATAL: PATH almide (" + hash + ") != workspace build (" + wshash + ").",
        "  The evidence this gate produces would not describe the tree under test.",
        "  Most common cause: a 'cargo test' ran after your last 'make install' —",
        "  the test profile relinks target/release/almide with a different feature",
        "  unification, so the hashes diverge even with identical sources.",
        "  Fix: make install && make verify-trust  (and do not run cargo",
        "  concurrently with the gate — a mid-gate relink invalidates the stamp)."
      ],
    } else Stamp { ok: true, lines: [line] }
  }
}

fn or_na(s: String) -> String = if s == "" then "n/a" else s

test "a tool that is not installed prints n/a, as the callers' pipefail makes the bash do" {
  assert_eq(or_na(""), "n/a")
  assert_eq(or_na("rustc 1.96.1"), "rustc 1.96.1")
}

// The stamp, as the bash prints it. `ok = false` means the caller must abort — the PATH
// binary and the workspace build disagree, so no measurement taken now would describe the
// tree being tested, and the stamp stops at the FATAL block exactly as the bash does.
effect fn toolchain(root: String) -> Stamp = {
  let id = identity(root)!
  let head_lines = ["── toolchain stamp ──"] + id.lines
  if not id.ok then Stamp { ok: false, lines: head_lines } else {
    // `$(tool --version 2>/dev/null || echo n/a)`: a tool that is not installed prints `n/a`.
    // The coqc line is a PIPELINE (`| head -1` — the Rocq banner is multi-line), so its `||`
    // only fires under `set -o pipefail`, and every caller of the stamp sets it
    // (proofs/*.sh) — so `n/a` is what the callers print. The #2163 output-parity diff found
    // the twin printing an empty field there: the stamp parity test had been invoking the
    // bash without pipefail, and the twin matched the test's invocation, not the callers'.
    let coq = run("coqc", ["--version"])!
    let head = run("git", ["-C", root, "rev-parse", "--short", "HEAD"])!
    let porcelain = string.trim(run("git", ["-C", root, "status", "--porcelain"])!)
    let dirty = if porcelain == "" then 0 else list.len(string.split(porcelain, "\n"))
    Stamp {
      ok: true,
      lines: head_lines + [
        "  rustc:    " + or_na(run("rustc", ["--version"])!),
        "  wasmtime: " + or_na(run("wasmtime", ["--version"])!),
        "  coqc:     " + or_na(list.get_or(string.split(coq, "\n"), 0, "")),
        "  tree:     " + head + " " + int.to_string(dirty) + " dirty file(s)",
        "─────────────────────"
      ],
    }
  }
}
