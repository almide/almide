// The `docs/contracts/generate-conformance.sh` replacement: the ALS conformance report.
//
// One row per normative ALS section — the contracts citing it, and the executable fixtures
// exercising each, with how CI runs them. Unlike the README table, evidence here is filtered
// to `fixture` / `exhaustive` only.
import toml

// Zero-pad the section number so a STRING sort orders `ALS-T10` after `ALS-T9`.
// The Python original sorts on the tuple `(letters, int(digits))`; `list.sort_by` takes one
// key, so the number is encoded into the string instead of compared separately. Three digits
// covers the ALS by a wide margin (currently ~64 sections).
// `string.is_digit`, not a hand-written `c >= "0" and c <= "9"` — that spelling emits
// invalid Rust natively (#1033: only the left operand of the `and` gets `.to_string()`),
// and the checker points at the stdlib function anyway (E015).
fn zero_pad(s: String, width: Int) -> String = if string.len(s) >= width then s else zero_pad("0" + s, width)

fn als_sort_key(spec: String) -> String = {
  let body = if string.starts_with(spec, "ALS-") then string.slice(spec, 4, string.len(spec))
  else spec
  // `string.filter` does not exist; go through `string.chars` and the list combinators.
  let cs = string.chars(body)
  let letters = cs |> list.filter((c) => not string.is_digit(c)) |> list.join("")
  let digits = cs |> list.filter((c) => string.is_digit(c)) |> list.join("")
  letters + zero_pad(digits, 3)
}

// The CI lane a fixture runs in, from its PATH. ORDER MATTERS: `spec/wasm_cross/` must be
// tested before the general `spec/` prefix, or every cross-target fixture reads as an
// ordinary both-target test.
fn how_ci_runs(path: String) -> String = if string.starts_with(path, "spec/wasm_cross/") then "byte-compare"
else if string.starts_with(path, "tests/diagnostics/") then "checker"
else if string.starts_with(path, "spec/") then "both-target test"
else if string.starts_with(path, "tests/") and string.ends_with(path, ".rs") then "cargo gate" else "other"

// Only fixture/exhaustive evidence appears in this report.
fn executable_paths(t: toml.Table) -> List[String] = t.array_items |> list.filter((it) => {
  let c = toml.inline_get(it, "class")
  c == "fixture" or c == "exhaustive"
}) |> list.map((it) => toml.inline_get(it, "path")) |> list.filter((p) => p != "")

fn cell_for(path: String) -> String = "`" + path + "` (" + how_ci_runs(path) + ")"

// The distinct spec keys, in ALS order.
fn sections_of(tables: List[toml.Table]) -> List[String] = tables |> list.filter((t) => toml.table_get(t, "id") != "") |> list.map((t) => toml.table_get(t, "spec")) |> list.unique |> list.sort_by((s) => als_sort_key(s))

fn row(tables: List[toml.Table], spec: String) -> String = {
  let members = tables |> list.filter((t) => toml.table_get(t, "id") != "" and toml.table_get(t, "spec") == spec)
  let cids = members |> list.map((t) => toml.table_get(t, "id")) |> list.join(", ")
  // De-dup fixtures shared between contracts of one section, KEEPING first-seen order —
  // `list.unique` preserves order, which is what the Python's seen-set loop does.
  let cells = members |> list.flat_map((t) => executable_paths(t)) |> list.unique |> list.map((p) => cell_for(p))
  "| " + spec + " | " + cids + " | " + list.join(cells, "<br>") + " |"
}

fn distinct_fixture_count(tables: List[toml.Table]) -> Int = tables |> list.flat_map((t) => executable_paths(t)) |> list.unique |> list.len

fn report_body(tables: List[toml.Table]) -> String = {
  let secs = sections_of(tables)
  let rows = secs |> list.map((s) => row(tables, s)) |> list.join("\n")
  int.to_string(list.len(secs)) + " normative sections; " + int.to_string(distinct_fixture_count(tables)) + " distinct executable fixtures.\n\n" + "| Section | Contracts | Fixtures (how CI runs each) |\n" + "|---------|-----------|------------------------------|\n" + rows + "\n"
}
