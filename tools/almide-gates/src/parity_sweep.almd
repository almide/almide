// The SWEEP half of `proofs/output-parity.sh` — everything the verdict rule in
// [parity.almd] needs processes and a filesystem for.
//
// The gate's shape: walk `spec/` for every `.almd` with a `fn main`, run each one through
// BOTH pipelines, classify with `parity.verdict_full`, and compare the resulting match-list
// against a committed baseline that may only grow. A file that drops out of the baseline is a
// regression and fails the gate; a file that matches with no baseline row fails it too (#3198:
// it used to be reported and passed, so a forgotten `--update` left the file uncompared) — a
// human ratchets it in with `--update`.
//
// Two behaviours here look like bugs and are not — the bash learned both the hard way, and a
// reimplementation that "cleans them up" produces different bytes:
//
//   * The RETRY. Under full-gate machine load the 20s alarm occasionally fires on files that
//     match fine when run alone, and a load artifact can surface as ANY verdict (a starved
//     oracle reads as v0fail, a starved render as wall) — so every non-match is re-run solo
//     with a generous timeout, and only the quiet re-run's verdict counts. A non-deterministic
//     verification result is not a result.
//   * The RE-SORT before comparison. The retry pass appends to the match list after it was
//     first sorted, and the baseline comparison is a sorted-set difference — an unsorted tail
//     once reported three phantom regressions.
//
// The corpus, the baseline and the wall ledger are overridable (OUTPUT_PARITY_SPEC /
// OUTPUT_PARITY_BASELINE / OUTPUT_PARITY_WALLED)
// for ONE consumer: the twin parity test (#2163) runs this and the bash over the same small
// purpose-built corpus with the same forged baseline and demands identical bytes. The
// defaults are the gate. That diff found, on its first run, that this half had no `--update`
// ratchet, no "no baseline" path, no tool checks, and that [parity.almd] did not strip
// warning blocks — every one of them a different byte from the bash on the day of a promotion.
import fs
import env
import process
import parity

type Sweep = { lines: List[String], matches: List[String], ok: Bool }

type Candidates = { files: List[String], skipped: Int }

// The perl `alarm; exec` wrapper is GONE (#1040): `process.exec_status_timeout`
// kills on the deadline in the runtime itself. A fired deadline maps to code
// 124 here — the same observable the perl wrapper produced — so the compared
// exit codes are unchanged.
effect fn run_capped(secs: Int, cmd: String, args: List[String]) -> process.ProcessStatus = {
  process.exec_status_timeout(cmd, args, secs * 1000) ?? process.ProcessStatus {
    code: 124,
    stdout: "",
    stderr: "",
  }
}

// One fixture through both pipelines. The wasm leg is the STRUCTURAL build forced
// (`ALMIDE_WASM_SKIP_STOCK_AUDIT=1 almide build --target wasm`, #2793 — it was the incumbent's
// `render_program` before), so a structural decline is a WALL and never an incumbent module
// standing in for it. `process.exec_status` takes no environment, so the variable rides on
// `env(1)`. The module path is masked out of the compared stderr (`parity.normalize_wasm_err`).
effect fn run_one(root: String, alm: String, file: String, secs: Int) -> String = {
  let wasm = root + "/target/almide-gates-parity.wasm"
  let v0 = run_capped(secs, alm, ["run", file])!
  let build = run_capped(
    secs,
    "env",
    [
      "ALMIDE_WASM_SKIP_STOCK_AUDIT=1",
      alm,
      "build",
      file,
      "--target",
      "wasm",
      "-o",
      wasm
    ],
  )!
  if build.code != 0 then {
    if v0.code == 0 then "wall" else "v0fail"
  } else {
    let v1 = run_capped(secs, "wasmtime", [wasm])!
    // The deadline fired on the wasm leg: the module never finished. HANG, never
    // runerr — the byte compare cannot see a non-termination, and a sweep with no
    // per-run limit simply stopped on it (#2567).
    if parity.is_deadline(v1.code) then "hang"
    else parity.verdict_full(
      v0.code == 0,
      true,
      v1.code == 0,
      v0.stdout,
      v1.stdout,
      v0.code,
      v1.code,
      v0.stderr,
      v1.stderr,
      wasm,
    )
  }
}

// A part-file with no `fn main` cannot be run standalone, and neither can a `// wasm:skip`
// fixture whose imports live in sibling files — comparing a broken standalone invocation
// proves nothing about either pipeline.
effect fn is_runnable(path: String) -> Bool = {
  let src = fs.read_text(path) ?? ""
  string.contains(src, "fn main") and not string.contains(
    list.get_or(string.split(src, "\n"), 0, ""),
    "wasm:skip",
  )
}

// The skipped files are COUNTED, not merely dropped: the bash reports `skip=N` in its summary
// line, and a gate that silently narrowed its own sweep would read as full coverage. The count
// is the only thing standing between "300 files agree" and "300 of the files I chose to look
// at agree".
effect fn corpus_dir(root: String) -> String = {
  // `find "$SPEC" -name '*.almd'` runs after the bash `cd`s to ROOT, so its paths are
  // repository-relative with no leading `./` — and the baseline is a list of exactly those
  // strings. A root of "." would make every path `./spec/…` and match nothing.
  let over = env.get("OUTPUT_PARITY_SPEC") ?? ""
  if over != "" then over
  else if root == "." then "spec" else root + "/spec"
}

effect fn candidates(root: String) -> Candidates = {
  let dir = corpus_dir(root)!
  let all = (fs.walk(dir) ?? []) |> list.filter((p) => string.ends_with(p, ".almd")) |> list.sort
  var out: List[String] = []
  var skipped = 0
  for p in all {
    if is_runnable(p)! then {
      out = out + [p]
    } else {
      skipped = skipped + 1
    }
  }
  Candidates { files: out, skipped: skipped }
}

effect fn classify_all(root: String, alm: String, files: List[String]) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  for f in files {
    out = out + [
      (f, run_one(root, alm, f, 20)!)
    ]
  }
  out
}

// The solo retry: only the quiet re-run's verdict counts (see the header).
effect fn retry_suspects(root: String, alm: String, first: List[(String, String)]) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  for cell in first {
    let (f, v) = cell
    if v == "match" then {
      out = out + [(f, v)]
    } else {
      out = out + [
        (f, run_one(root, alm, f, 60)!)
      ]
    }
  }
  out
}

fn count_of(cells: List[(String, String)], want: String) -> Int = cells |> list.filter((c) => c.1 == want) |> list.len

fn files_of(cells: List[(String, String)], want: String) -> List[String] = cells |> list.filter((c) => c.1 == want) |> list.map((c) => c.0)

// A failure class NAMES its files. Counts alone leave nothing to act on, and MISMATCH is the
// silent-miscompile class — the one the gate exists for.
fn class_report(cells: List[(String, String)], want: String, marker: String, heading: String) -> List[String] = class_report_wrapped(
  cells,
  want,
  marker,
  [heading],
)

// The XFAIL heading is TWO lines in the bash — a wrapped sentence, not two headings. The
// wrapping is not decoration: this list goes into CI logs verbatim, and rewrapping it is a
// byte difference for no gain.
fn class_report_wrapped(cells: List[(String, String)], want: String, marker: String, heading: List[String]) -> List[String] = {
  let fs2 = files_of(cells, want)
  if list.len(fs2) == 0 then []
  else heading + (fs2 |> list.map((f) => "    " + marker + " " + f))
}

// REGRESSION = a baseline must-match file that stopped matching. The baseline is re-sorted
// under the same collation before the set difference: a committed file may have been generated
// under a different locale, where `.` and `_` invert, which made the same files appear as both
// a regression AND a new match on every run.
fn missing_from(want: List[String], have: List[String]) -> List[String] = want |> list.filter((f) => not list.contains(have, f))

// In CI a missing tool is a FAILURE, not a skip (#978 — this gate spent its life skipping
// because CI never had the oracle on PATH, and nothing noticed). `ok = true` with a single
// line is the local SKIP; `ok = false` is the CI failure; an empty list means both tools are
// present and the sweep may start.
effect fn tool_check(alm: String) -> Sweep = {
  let ci = (env.get("CI") ?? "") == "true"
  // `command` is a shell BUILTIN: macOS ships a /usr/bin/command shim, Linux does not, so a
  // direct spawn "found" wasmtime on every developer machine and never on a CI runner
  // (#2438's shard 3 went red on exactly this). Ask a shell, as the bash original does.
  let have_wasmtime = (process.exec_status("sh", ["-c", "command -v \"$1\"", "_", "wasmtime"]) ?? process.ProcessStatus {
    code: 1,
    stdout: "",
    stderr: "",
  }).code == 0
  if not have_wasmtime then {
    if ci then Sweep {
      lines: [
        "::error::output-parity: wasmtime not found — in CI a missing tool is a failure (#978)"
      ],
      matches: [],
      ok: false,
    } else Sweep {
      lines: [
        "output-parity: wasmtime not found — SKIP"
      ],
      matches: [],
      ok: true,
    }
  } else if not fs.is_file(alm)! then {
    if ci then Sweep {
      lines: [
        "::error::output-parity: almide (v0 oracle) not found at " + alm + " — in CI a missing oracle is a failure (#978)"
      ],
      matches: [],
      ok: false,
    } else Sweep {
      lines: [
        "output-parity: almide (v0 oracle) not found at " + alm + " — SKIP"
      ],
      matches: [],
      ok: true,
    }
  } else Sweep { lines: [], matches: [], ok: true }
}

// The baseline path: the env override, else the committed ratchet under `proofs/`.
effect fn baseline_path_of(root: String) -> String = {
  let over = env.get("OUTPUT_PARITY_BASELINE") ?? ""
  if over != "" then over else root + "/proofs/output-parity-baseline.txt"
}

// THE WALL LEDGER (#2793) — the twin of the block in the bash and of
// `scripts/lib/determinism-walled.sh`. The claim is every must-match baseline row plus every
// row the ledger excuses; the structural walls inside it must be exactly the ledger's rows. A
// wall without a row fails (coverage shrank), a row that no longer walls fails as STALE, a
// file in both lists fails, and `max_walled` must equal the COMMITTED ledger's row count.
fn max_walled() -> Int = 0

type Ledger = { lines: List[String], ok: Bool }

effect fn walled_path_of(root: String) -> String = {
  let over = env.get("OUTPUT_PARITY_WALLED") ?? ""
  if over != "" then over
  else root + "/proofs/output-parity-walled-baseline.txt"
}

// `grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$'` — the data rows of a ledger.
fn ledger_data_rows(text: String) -> List[String] = parity.lines_of(text) |> list.filter((l) => not string.starts_with(string.trim_start(l), "#")) |> list.filter((l) => string.trim(l) != "")

// `sed 's/[[:space:]]*::.*$//'` — the file a row names: everything before the first `::`,
// trailing whitespace dropped.
fn row_name(row: String) -> String = match string.index_of(row, "::") {
  some(i) => string.trim_end(string.slice(row, 0, i)),
  none => row,
}

fn sorted_unique(xs: List[String]) -> List[String] = xs |> list.sort |> list.dedup

effect fn wall_ledger(root: String, baseline_path: String, walls: List[String]) -> Ledger = {
  let walled_path = walled_path_of(root)!
  let committed = ledger_data_rows(fs.read_text(root + "/proofs/output-parity-walled-baseline.txt") ?? "") |> list.len
  let max_line = if committed != max_walled() then [
    "::error::output-parity: MAX_WALLED=" + int.to_string(max_walled()) + " but proofs/output-parity-walled-baseline.txt has " + int.to_string(committed) + " row(s) — move both in the same change"
  ]
  else []
  let have_ledger = fs.is_file(walled_path)!
  let rows = if have_ledger then sorted_unique(ledger_data_rows(fs.read_text(walled_path) ?? "") |> list.map(row_name))
  else []
  let baseline = if fs.is_file(baseline_path)! then (fs.read_lines(baseline_path) ?? []) |> list.filter((l) => string.trim(l) != "")
  else []
  let claim = sorted_unique(baseline + rows)
  let got = sorted_unique(walls) |> list.filter((f) => list.contains(claim, f))
  let helper = if not have_ledger then ["::error::output-parity: wall ledger " + walled_path + " missing"]
  else (got |> list.filter((f) => not list.contains(rows, f)) |> list.map((f) => "::error::output-parity: " + f + " walls on the structural leg with no row in " + walled_path + " — coverage shrank; fix the decline or add the row (and raise MAX_WALLED) consciously in the same change")) + (rows |> list.filter((f) => not list.contains(got, f)) |> list.map((f) => "::error::output-parity: " + f + " has a row in " + walled_path + " but no longer walls — STALE; delete the row and lower MAX_WALLED in the same change"))
  let helper_ok = have_ledger and list.len(helper) == 0
  let both = sorted_unique(baseline) |> list.filter((f) => list.contains(rows, f))
  let both_lines = if list.len(both) == 0 then []
  else [
    "::error::output-parity: these files are both a must-match baseline row and a wall-ledger row — a file is one or the other:"
  ] + (both |> list.map((f) => "  = " + f))
  let clean = list.len(max_line) == 0 and helper_ok and list.len(both) == 0
  if clean then Ledger {
    lines: [
      "output-parity: wall ledger OK — " + int.to_string(list.len(got)) + " claimed file(s) wall on the structural leg, each with its row."
    ],
    ok: true,
  } else Ledger { lines: max_line + helper + both_lines, ok: false }
}

effect fn sweep(root: String, alm: String, baseline_path: String, update: Bool) -> Sweep = {
  let cand = candidates(root)!
  let cells = retry_suspects(root, alm, classify_all(root, alm, cand.files)!)!
  let matches = files_of(cells, "match") |> list.sort
  let summary = "output-parity: match=" + int.to_string(count_of(cells, "match")) + " wall=" + int.to_string(count_of(cells, "wall")) + " MISMATCH=" + int.to_string(count_of(cells, "mismatch")) + " RUNERR=" + int.to_string(count_of(cells, "runerr")) + " HANG=" + int.to_string(count_of(cells, "hang")) + " XFAIL=" + int.to_string(count_of(cells, "xfail")) + " v0fail=" + int.to_string(count_of(cells, "v0fail")) + " skip=" + int.to_string(cand.skipped)
  let classes = class_report(
    cells,
    "mismatch",
    "!",
    "  (MISMATCH = renders and runs but the stdout bytes diverge — silent miscompile class):",
  ) + class_report(
    cells,
    "runerr",
    "r",
    "  (RUNERR = renders but wasmtime rejects or traps where v0 succeeds):",
  ) + class_report(
    cells,
    "hang",
    "h",
    "  (HANG = renders but wasmtime did not finish within the per-run limit — a non-termination the byte compare never sees):",
  ) + class_report_wrapped(
    cells,
    "xfail",
    "x",
    [
      "  (XFAIL = a trap/abort fixture whose v1 observable [stderr+exit] diverges from v0 —",
      "   the trap-semantics contract surface not yet implemented on the MIR render path):"
    ],
  )
  // A hang fails LOUDLY and before any ratchet (#2567): the sweep that found it had no
  // per-run limit and simply stopped, and the one that had a limit filed the fixture under
  // RUNERR, where nothing fails. Neither is a verdict. After it, `--update` is the ratchet:
  // the match list, sorted, one path per line — and an EMPTY list writes an empty file, as
  // `cp` of an empty matches.txt does, not a lone newline.
  let hung = count_of(cells, "hang")
  let ledger = wall_ledger(root, baseline_path, files_of(cells, "wall"))!
  if hung > 0 then Sweep {
    lines: [summary] + classes + [
      "::error::output-parity: " + int.to_string(hung) + " fixture(s) HUNG on the v1 leg — a hang is never a baseline verdict; fix the renderer or wall the shape (#2567)"
    ],
    matches: matches,
    ok: false,
  } else if not ledger.ok then Sweep {
    lines: [summary] + classes + ledger.lines,
    matches: matches,
    ok: false,
  } else if update then {
    let text = if list.len(matches) == 0 then "" else list.join(matches, "\n") + "\n"
    fs.write(baseline_path, text)!
    Sweep {
      lines: [summary] + classes + ledger.lines + ["output-parity: baseline updated -> " + baseline_path + " (" + int.to_string(list.len(matches)) + " files)"],
      matches: matches,
      ok: true,
    }
  } else if not fs.is_file(baseline_path)! then Sweep {
    lines: [summary] + classes + ledger.lines + ["output-parity: no baseline (" + baseline_path + ") — run with --update first"],
    matches: matches,
    ok: true,
  } else {
    let baseline = (fs.read_lines(baseline_path) ?? []) |> list.filter((l) => l != "") |> list.sort
    let regressions = missing_from(baseline, matches)
    let gained = missing_from(matches, baseline)
    let gained_lines = if list.len(gained) == 0 then []
    else [
      "output-parity: NEW matches not yet in baseline (run --update to ratchet):"
    ] + (gained |> list.map((f) => "  + " + f))
    let tail = if list.len(regressions) > 0 then [
      "output-parity: REGRESSION — these baseline files stopped byte-matching v0:"
    ] + (regressions |> list.map((f) => "  - " + f))
    else if list.len(gained) > 0 then [
      "::error::output-parity: INCOMPLETE BASELINE — " + int.to_string(list.len(gained)) + " matching file(s) above have no row, so no later run compares them (#3198). Run --update and commit the rows."
    ]
    else ["output-parity: OK — all " + int.to_string(list.len(baseline)) + " baseline files still byte-match v0."]
    Sweep {
      lines: [summary] + classes + ledger.lines + gained_lines + tail,
      matches: matches,
      ok: list.len(regressions) == 0 and list.len(gained) == 0,
    }
  }
}

test "the skipped files are counted, not silently dropped" {
  // A gate that narrows its own sweep without saying so reads as full coverage. The count is
  // what distinguishes "everything agrees" from "everything I looked at agrees".
  let c = Candidates { files: ["a.almd"], skipped: 7 }
  assert_eq(c.skipped, 7)
  assert_eq(list.len(c.files), 1)
}

test "a regression is a baseline file that stopped matching, and only that" {
  // A NEW match is not a regression — the baseline only grows, and it grows by an explicit
  // `--update`, never by the gate quietly accepting whatever it saw this run. It still fails
  // the gate, as an incomplete baseline (#3198), not as a regression.
  let baseline = ["a.almd", "b.almd"]
  let matches = ["a.almd", "c.almd"]
  assert_eq(missing_from(baseline, matches), ["b.almd"])
  assert_eq(missing_from(matches, baseline), ["c.almd"])
}

test "an empty class prints nothing at all, not an empty heading" {
  let clean: List[(String, String)] = [("x.almd", "match")]
  assert_eq(list.len(class_report(clean, "mismatch", "!", "H")), 0)
  let dirty: List[(String, String)] = [("x.almd", "mismatch"), ("y.almd", "match")]
  assert_eq(class_report(dirty, "mismatch", "!", "H"), ["H", "    ! x.almd"])
}

test "counting is per class, and the classes do not overlap" {
  let cells: List[(String, String)] = [
    ("a", "match"),
    ("b", "match"),
    ("c", "wall"),
    ("d", "mismatch"),
    ("e", "v0fail"),
    ("f", "hang")
  ]
  assert_eq(count_of(cells, "match"), 2)
  assert_eq(count_of(cells, "wall"), 1)
  assert_eq(count_of(cells, "runerr"), 0)
  assert_eq(count_of(cells, "hang"), 1)
  assert_eq(files_of(cells, "mismatch"), ["d"])
  assert_eq(files_of(cells, "hang"), ["f"])
}

test "a hang names its file under its own heading, apart from the runerr row" {
  // #2567: the incumbent leg of one fixture never terminated. Under the runerr row it was
  // one entry among the ratcheted; as its own class it is the line the gate fails on.
  let cells: List[(String, String)] = [("x.almd", "hang"), ("y.almd", "runerr")]
  assert_eq(class_report(cells, "hang", "h", "H"), ["H", "    h x.almd"])
  assert_eq(class_report(cells, "runerr", "r", "R"), ["R", "    r y.almd"])
}

test "a ledger row names its file the way the bash's sed does" {
  // `grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | sed 's/[[:space:]]*::.*$//'`: comments
  // and blank lines are not rows, and a row is its file up to the first `::`.
  let text = "# header\n\n  # indented comment\nspec/a.almd :: decline :: #1\nspec/b.almd\n"
  assert_eq(ledger_data_rows(text), ["spec/a.almd :: decline :: #1", "spec/b.almd"])
  assert_eq(row_name("spec/a.almd :: decline :: #1"), "spec/a.almd")
  assert_eq(row_name("spec/b.almd"), "spec/b.almd")
}
