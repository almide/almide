// The SWEEP half of `proofs/output-parity.sh` — everything the verdict rule in
// [parity.almd] needs processes and a filesystem for.
//
// The gate's shape: walk `spec/` for every `.almd` with a `fn main`, run each one through
// BOTH pipelines, classify with `parity.verdict_full`, and compare the resulting match-list
// against a committed baseline that may only grow. A file that drops out of the baseline is a
// regression and fails the gate; a file that newly matches is reported so a human can ratchet
// it in with `--update`.
//
// Two behaviours here look like bugs and are not — the bash learned both the hard way, and a
// reimplementation that "cleans them up" produces different bytes:
//
//   * The RETRY. Under full-gate machine load the 20s alarm occasionally fires on files that
//     match fine when run alone, and a load artifact can surface as ANY verdict (a starved
//     oracle reads as v0fail, a starved render as wall) — so every non-match is re-run solo
//     with a generous timeout, and only the quiet re-run's verdict counts. A non-deterministic
//     verification result is not a result.
//   * The RE-SORT before comparison. The retry pass appends to the match list after it was
//     first sorted, and the baseline comparison is a sorted-set difference — an unsorted tail
//     once reported three phantom regressions.
import fs
import process
import parity

type Sweep = { lines: List[String], matches: List[String], ok: Bool }
type Candidates = { files: List[String], skipped: Int }

// `perl -e 'alarm …; exec …'` — macOS has no `timeout(1)`, and the bash reaches for the same
// wrapper. Kept identical rather than replaced with a sleep/kill pair: a different killing
// mechanism produces a different exit code, and the exit code is part of what this gate
// compares.
effect fn run_capped(secs: Int, cmd: String, args: List[String]) -> process.ProcessStatus = {
  let wrapped = ["-e", "alarm shift @ARGV; exec @ARGV", int.to_string(secs), cmd] + args
  process.exec_status("perl", wrapped) ?? process.ProcessStatus { code: 124, stdout: "", stderr: "" }
}

// One fixture through both pipelines. `render_program` writes WAT to stdout, so the WAT lands
// in a per-file temp the wasmtime leg then reads — which is also why the module path has to be
// masked out of the compared stderr (see `parity.normalize_wasm_err`).
effect fn run_one(root: String, alm: String, rp: String, file: String, secs: Int) -> String = {
  let wat = root + "/target/almide-gates-parity.wat"
  let v0 = run_capped(secs, alm, ["run", file])!
  let render = process.exec_status(rp, [file]) ?? process.ProcessStatus { code: 1, stdout: "", stderr: "" }
  if render.code != 0 then {
    if v0.code == 0 then "wall" else "v0fail"
  } else {
    fs.write(wat, render.stdout)!
    let v1 = run_capped(secs, "wasmtime", [wat])!
    parity.verdict_full(
      v0.code == 0, true, v1.code == 0,
      v0.stdout, v1.stdout,
      v0.code, v1.code,
      v0.stderr, v1.stderr, wat,
    )
  }
}

// A part-file with no `fn main` cannot be run standalone, and neither can a `// wasm:skip`
// fixture whose imports live in sibling files — comparing a broken standalone invocation
// proves nothing about either pipeline.
effect fn is_runnable(path: String) -> Bool = {
  let src = fs.read_text(path) ?? ""
  string.contains(src, "fn main")
    and not string.contains(list.get_or(string.split(src, "\n"), 0, ""), "wasm:skip")
}

// The skipped files are COUNTED, not merely dropped: the bash reports `skip=N` in its summary
// line, and a gate that silently narrowed its own sweep would read as full coverage. The count
// is the only thing standing between "300 files agree" and "300 of the files I chose to look
// at agree".
effect fn candidates(root: String) -> Candidates = {
  // `find spec -name '*.almd'` runs after the bash `cd`s to ROOT, so its paths are
  // repository-relative with no leading `./` — and the baseline is a list of exactly those
  // strings. A root of "." would make every path `./spec/…` and match nothing.
  let dir = if root == "." then "spec" else root + "/spec"
  let all = (fs.walk(dir) ?? []) |> list.filter((p) => string.ends_with(p, ".almd")) |> list.sort
  var out: List[String] = []
  var skipped = 0
  for p in all {
    if is_runnable(p)! then out = out + [p] else skipped = skipped + 1
  }
  Candidates { files: out, skipped: skipped }
}

effect fn classify_all(root: String, alm: String, rp: String, files: List[String]) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  for f in files {
    out = out + [(f, run_one(root, alm, rp, f, 20)!)]
  }
  out
}

// The solo retry: only the quiet re-run's verdict counts (see the header).
effect fn retry_suspects(root: String, alm: String, rp: String, first: List[(String, String)]) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  for cell in first {
    let (f, v) = cell
    if v == "match" then out = out + [(f, v)]
    else out = out + [(f, run_one(root, alm, rp, f, 60)!)]
  }
  out
}

fn count_of(cells: List[(String, String)], want: String) -> Int =
  cells |> list.filter((c) => c.1 == want) |> list.len

fn files_of(cells: List[(String, String)], want: String) -> List[String] =
  cells |> list.filter((c) => c.1 == want) |> list.map((c) => c.0)

// A failure class NAMES its files. Counts alone leave nothing to act on, and MISMATCH is the
// silent-miscompile class — the one the gate exists for.
fn class_report(cells: List[(String, String)], want: String, marker: String, heading: String) -> List[String] =
  class_report_wrapped(cells, want, marker, [heading])

// The XFAIL heading is TWO lines in the bash — a wrapped sentence, not two headings. The
// wrapping is not decoration: this list goes into CI logs verbatim, and rewrapping it is a
// byte difference for no gain.
fn class_report_wrapped(cells: List[(String, String)], want: String, marker: String, heading: List[String]) -> List[String] = {
  let fs2 = files_of(cells, want)
  if list.len(fs2) == 0 then []
  else heading + (fs2 |> list.map((f) => "    " + marker + " " + f))
}

// REGRESSION = a baseline must-match file that stopped matching. The baseline is re-sorted
// under the same collation before the set difference: a committed file may have been generated
// under a different locale, where `.` and `_` invert, which made the same files appear as both
// a regression AND a new match on every run.
fn missing_from(want: List[String], have: List[String]) -> List[String] =
  want |> list.filter((f) => not list.contains(have, f))

effect fn sweep(root: String, alm: String, rp: String, baseline_path: String) -> Sweep = {
  let cand = candidates(root)!
  let cells = retry_suspects(root, alm, rp, classify_all(root, alm, rp, cand.files)!)!
  let matches = files_of(cells, "match") |> list.sort
  let summary = "output-parity: match=" + int.to_string(count_of(cells, "match"))
    + " wall=" + int.to_string(count_of(cells, "wall"))
    + " MISMATCH=" + int.to_string(count_of(cells, "mismatch"))
    + " RUNERR=" + int.to_string(count_of(cells, "runerr"))
    + " XFAIL=" + int.to_string(count_of(cells, "xfail"))
    + " v0fail=" + int.to_string(count_of(cells, "v0fail"))
    + " skip=" + int.to_string(cand.skipped)
  let classes =
    class_report(cells, "mismatch", "!", "  (MISMATCH = renders and runs but the stdout bytes diverge — silent miscompile class):")
    + class_report(cells, "runerr", "r", "  (RUNERR = renders but wasmtime rejects or traps where v0 succeeds):")
    + class_report_wrapped(cells, "xfail", "x", [
        "  (XFAIL = a trap/abort fixture whose v1 observable [stderr+exit] diverges from v0 —",
        "   the trap-semantics contract surface not yet implemented on the MIR render path):",
      ])
  let baseline = (fs.read_lines(baseline_path) ?? []) |> list.filter((l) => l != "") |> list.sort
  let regressions = missing_from(baseline, matches)
  let gained = missing_from(matches, baseline)
  let gained_lines = if list.len(gained) == 0 then []
    else ["output-parity: NEW matches not yet in baseline (run --update to ratchet):"]
      + (gained |> list.map((f) => "  + " + f))
  let tail = if list.len(regressions) > 0 then
      ["output-parity: REGRESSION — these baseline files stopped byte-matching v0:"]
        + (regressions |> list.map((f) => "  - " + f))
    else ["output-parity: OK — all " + int.to_string(list.len(baseline)) + " baseline files still byte-match v0."]
  Sweep {
    lines: [summary] + classes + gained_lines + tail,
    matches: matches,
    ok: list.len(regressions) == 0,
  }
}

test "the skipped files are counted, not silently dropped" {
  // A gate that narrows its own sweep without saying so reads as full coverage. The count is
  // what distinguishes "everything agrees" from "everything I looked at agrees".
  let c = Candidates { files: ["a.almd"], skipped: 7 }
  assert_eq(c.skipped, 7)
  assert_eq(list.len(c.files), 1)
}

test "a regression is a baseline file that stopped matching, and only that" {
  // A NEW match is not a regression — the baseline only grows, and it grows by an explicit
  // `--update`, never by the gate quietly accepting whatever it saw this run.
  let baseline = ["a.almd", "b.almd"]
  let matches = ["a.almd", "c.almd"]
  assert_eq(missing_from(baseline, matches), ["b.almd"])
  assert_eq(missing_from(matches, baseline), ["c.almd"])
}

test "an empty class prints nothing at all, not an empty heading" {
  let clean: List[(String, String)] = [("x.almd", "match")]
  assert_eq(list.len(class_report(clean, "mismatch", "!", "H")), 0)
  let dirty: List[(String, String)] = [("x.almd", "mismatch"), ("y.almd", "match")]
  assert_eq(class_report(dirty, "mismatch", "!", "H"), ["H", "    ! x.almd"])
}

test "counting is per class, and the classes do not overlap" {
  let cells: List[(String, String)] = [
    ("a", "match"), ("b", "match"), ("c", "wall"), ("d", "mismatch"), ("e", "v0fail"),
  ]
  assert_eq(count_of(cells, "match"), 2)
  assert_eq(count_of(cells, "wall"), 1)
  assert_eq(count_of(cells, "runerr"), 0)
  assert_eq(files_of(cells, "mismatch"), ["d"])
}
