protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}
fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0
type Lexical: Order = {}
fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)
fn better[O: Order](o: O, best: String?, n: String) -> String? = match best {
    none => some(n),
    some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
  }
test "g" { assert_eq(better(Lexical {}, some("b"), "c"), some("c")) }
