protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

type Lexical: Order = {}

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

fn f[O: Order](o: O, a: String, b: String) -> String? = {
  let r = none
  if o.cmp(a, b) > 0 then some(a) else r
}

fn main() -> Unit = {
  let line = "${f(Lexical {}, "b", "a")}"
  println(line)
}
