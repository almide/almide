protocol Scorer {
  fn score(s: Self, x: String) -> Int
}

type Judge[T] = { score: (T) -> Int }

type Vowels: Scorer = {}

fn Vowels.score(s: Vowels, x: String) -> Int = string.to_list(x) |> list.count((c) => string.contains("aeiou", c))

fn best[S: Scorer](s: S, names: List[String]) -> String? = {
  names |> list.fold(none, (top, n) => match top {
    none => some(n),
    some(t) => if s.score(n) > s.score(t) then some(n) else some(t),
  })
}

fn main() -> Unit = {
  let b = "best=${best(Vowels {}, ["pear", "banana"])}"
  println(b)
}
