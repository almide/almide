// An ordering port: `cmp(a, b)` is -1, 0 or 1.
protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

// Plain string order.
type Lexical: Order = {}
fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

fn is_digit_char(c: String) -> Bool = string.is_digit(c)

// Maximal runs of digits and of non-digits: "file10b" -> ["file", "10", "b"].
fn runs(s: String) -> List[String] =
  string.to_list(s) |> list.fold([], (acc, c) => match list.last(acc) {
    some(last) =>
      if is_digit_char(c) == is_digit_char(string.take(last, 1)) then list.drop_end(acc, 1) + [last + c]
      else acc + [c],
    none => [c],
  })

fn cmp_run(x: String, y: String) -> Int =
  if string.is_digit(x) and string.is_digit(y) then {
    let nx = int.parse(x) ?? 0
    let ny = int.parse(y) ?? 0
    if nx < ny then -1 else if nx > ny then 1 else 0
  } else sign(x, y)

fn cmp_runs(xs: List[String], ys: List[String]) -> Int =
  match xs {
    [] => if list.is_empty(ys) then 0 else -1,
    [x, ..xt] => match ys {
      [] => 1,
      [y, ..yt] => {
        let c = cmp_run(x, y)
        if c != 0 then c else cmp_runs(xt, yt)
      },
    },
  }

// Digit runs by number, other runs as text; string order breaks the rest.
type Natural: Order = {}
fn Natural.cmp(o: Natural, a: String, b: String) -> Int = {
  let c = cmp_runs(runs(a), runs(b))
  if c != 0 then c else sign(a, b)
}

// Stable insertion sort: equal names keep their input order.
fn sort_names[O: Order](o: O, names: List[String]) -> List[String] =
  names |> list.fold([], (sorted, n) => insert(o, sorted, n))

fn insert[O: Order](o: O, sorted: List[String], n: String) -> List[String] = {
  let before = sorted |> list.take_while((s) => o.cmp(s, n) <= 0)
  before + [n] + list.drop(sorted, list.len(before))
}

// The greatest name; the first one listed among equals.
fn greatest[O: Order](o: O, names: List[String]) -> String? =
  names |> list.fold(none, (best, n) => match best {
    none => some(n),
    some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
  })

type Collation = | Plain(Lexical) | Human(Natural)

fn sort_by_collation(c: Collation, names: List[String]) -> List[String] =
  match c {
    Plain(l) => sort_names(l, names),
    Human(n) => sort_names(n, names),
  }
test "hidden: numerically equal runs fall back to string order" {
  assert_eq(sort_by_collation(Human(Natural {}), ["a1", "a01"]), ["a01", "a1"])
  assert_eq(sort_by_collation(Human(Natural {}), ["a01", "a1"]), ["a01", "a1"])
  assert_eq(Natural {}.cmp("x007", "x7"), -1)
  assert_eq(Natural {}.cmp("x7", "x7"), 0)
}
test "hidden: prefixes and mixed runs" {
  assert_eq(sort_by_collation(Human(Natural {}), ["file10b", "file10", "file9", "file10a"]), ["file9", "file10", "file10a", "file10b"])
  assert_eq(sort_by_collation(Human(Natural {}), ["b", "a2", "a", "a10", "10", "9"]), ["9", "10", "a", "a2", "a10", "b"])
}
test "hidden: plain order and stability" {
  assert_eq(sort_by_collation(Human(Natural {}), ["beta", "Alpha", "alpha"]), ["Alpha", "alpha", "beta"])
  assert_eq(sort_names(Lexical {}, ["b", "a", "b", "a"]), ["a", "a", "b", "b"])
  assert_eq(greatest(Lexical {}, []), none)
}
