protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

type Lexical: Order = {}

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

fn f[O: Order](o: O, xs: List[String]) -> String? = xs |> list.fold(none, (b, x) => match b {
  none => some(x),
  some(v) => if v < x then some(x) else some(v),
})

fn main() -> Unit = {
  let line = "${f(Lexical {}, ["a", "c"])}"
  println(line)
}
