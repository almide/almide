protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}
fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0
type Lexical: Order = {}
fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)
type Natural: Order = {}
fn Natural.cmp(o: Natural, a: String, b: String) -> Int = 0 - sign(a, b)
fn pick[O: Order](o: O, a: String, b: String) -> String = if o.cmp(a, b) <= 0 then a else b
type Collation = | Plain(Lexical) | Human(Natural)
fn by(c: Collation, a: String, b: String) -> String =
  match c {
    Plain(l) => pick(l, a, b),
    Human(n) => pick(n, a, b),
  }
test "coll" {
  assert_eq(by(Plain(Lexical {}), "a", "b"), "a")
  assert_eq(by(Human(Natural {}), "a", "b"), "b")
}
