// Catalogue items with tags: a set of lowercase, trimmed, non-empty tags.
type Item: Eq, Repr = { name: String, tags: Set[String] }

fn clean(t: String) -> String = string.to_lower(string.trim(t))

fn tag_set(raw: List[String]) -> Set[String] =
  raw |> list.map(clean) |> list.filter((t) => t != "") |> set.from_list

fn item(name: String, raw: List[String]) -> Item = Item { name: name, tags: tag_set(raw) }

fn has_tag(i: Item, t: String) -> Bool = set.contains(i.tags, clean(t))

fn add_tag(i: Item, t: String) -> Item = Item { ...i, tags: set.union(i.tags, tag_set([t])) }

fn same_tags(a: Item, b: Item) -> Bool = a.tags == b.tags

fn tags_text(tags: Set[String]) -> String = set.to_list(tags) |> list.sort |> list.join(",")

fn tag_line(i: Item) -> String = i.name + " [" + tags_text(i.tags) + "]"

// Items grouped by identical tag sets: "<tags>: <names>" per group, groups in
// first-seen order, names in list order.
fn groups(items: List[Item]) -> List[String] = {
  let keys = items |> list.map((i) => i.tags) |> list.unique
  keys |> list.map((k) => {
    let names = items |> list.filter((i) => i.tags == k) |> list.map((i) => i.name)
    tags_text(k) + ": " + list.join(names, ",")
  })
}
test "tags are a set" {
  let i = item("lamp", ["home", "light"])
  assert_eq(i.tags, set.from_list(["home", "light"]))
  assert_eq(tag_line(i), "lamp [home,light]")
  assert(has_tag(i, "Home"))
}
test "groups by set" {
  let xs = [item("a", ["x"]), item("b", ["x", "y"]), item("c", ["x"])]
  assert_eq(groups(xs), ["x: a,c", "x,y: b"])
}
test "hidden: rendering is sorted regardless of input order" {
  assert_eq(tag_line(item("lamp", ["Light", "home"])), "lamp [home,light]")
  assert_eq(tag_line(item("z", ["b", "c", "a"])), "z [a,b,c]")
  assert_eq(tag_line(item("e", [])), "e []")
  assert_eq(tag_line(add_tag(item("q", ["m"]), "b")), "q [b,m]")
}
test "hidden: blanks, case and duplicates" {
  let i = item("x", [" A", "a", "", "  ", "B "])
  assert_eq(tag_line(i), "x [a,b]")
  assert_eq(add_tag(i, "A"), i)
  assert_eq(add_tag(i, " "), i)
  assert(same_tags(item("p", ["b", "a"]), item("q", ["A", "B", "a"])))
  assert(not same_tags(item("p", ["b"]), item("q", ["b", "c"])))
}
test "hidden: groups key on the set" {
  let xs = [item("n1", ["y", "x"]), item("n2", []), item("n3", ["x", "y"]), item("n4", ["X"]), item("n5", [" "])]
  assert_eq(groups(xs), ["x,y: n1,n3", ": n2,n5", "x: n4"])
  assert_eq(groups([]), [])
}
