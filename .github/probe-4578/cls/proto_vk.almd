// @contract: C-094
// A protocol-method call on a protocol-bounded type parameter inside a fold
// callback, where the method's name is also the name of a function-typed field
// of exactly one registered record (#4579). The auto-imported `Heap[A]` has a
// field `cmp: (A, A) -> Int`. The checker answered `o.cmp(a, b)` on an
// `O: Order` by guessing that record from the field name instead of asking the
// bound, so the call typed as `Heap.cmp`, the protocol method was never
// consulted, and the open seed of `list.fold((o, none), …)` stayed unsolved in
// the IR: the wasm leg walled `ty-mismatch:Scalar(Str)-vs-Unit` while native
// ran the program. A bounded type parameter's members now come from its bounds
// only. `Scorer.score` pins the same family for a user record: `Judge[T]` is
// only declared, and its `score: (T) -> Int` field had the same effect, since
// the guess searched every registered record and a field type naming the
// record's own type parameter is what left the seed open. The receiver rides in
// the accumulator rather than being captured, so every function here also
// lowers on the certified MIR leg (a fold callback that captures a record is
// outside its brick).
protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

protocol Scorer {
  fn score(s: Self, x: String) -> Int
}

type Judge[T] = { score: (T) -> Int }

fn sign(a: String, b: String) -> Int = if a < b then -1
else if a > b then 1 else 0

type Lexical: Order = {  }

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

type ByLength: Order = {  }

fn ByLength.cmp(o: ByLength, a: String, b: String) -> Int = {
  let c = string.len(a) - string.len(b)
  if c < 0 then -1
  else if c > 0 then 1 else sign(a, b)
}

type Vowels: Scorer = {  }

fn Vowels.score(s: Vowels, x: String) -> Int = string.to_list(x) |> list.count((c) => string.contains("aeiou", c))

// The running pick: the first name, then `n` whenever it beats the held one.
fn keep(held: String?, n: String, beats: Bool) -> String? = match held {
  none => some(n),
  some(h) => if beats then some(n) else some(h),
}

// The greatest name; the first one listed among equals.
fn greatest[O: Order](o: O, names: List[String]) -> String? = {
  let r = names |> list.fold(
    (o, none),
    ((oo, best), n) => (oo, keep(best, n, oo.cmp(n, best ?? n) > 0)),
  )
  r.1
}

// The best-scoring name; none for an empty list.
fn best[S: Scorer](s: S, names: List[String]) -> String? = {
  let r = names |> list.fold(
    (s, none),
    ((ss, top), n) => (ss, keep(top, n, ss.score(n) > ss.score(top ?? n))),
  )
  r.1
}

// Stable insertion sort through the bound: equal names keep their input order.
fn sort_names[O: Order](o: O, names: List[String]) -> List[String] = names |> list.fold(
  [],
  (sorted, n) => insert(o, sorted, n),
)

fn insert[O: Order](o: O, sorted: List[String], n: String) -> List[String] = {
  let k = sorted |> list.count((s) => o.cmp(s, n) <= 0)
  list.take(sorted, k) + [n] + list.drop(sorted, k)
}

type Collation = | Plain(Lexical) | Short(ByLength)

fn sort_by_collation(c: Collation, names: List[String]) -> List[String] = match c {
  Plain(l) => sort_names(l, names),
  Short(s) => sort_names(s, names),
}

fn main() -> Unit = {
  let names = [
    "pear",
    "fig",
    "banana",
    "kiwi",
    "apple",
    "fig"
  ]
  let g = "greatest lexical=${greatest(Lexical {}, names)} by length=${greatest(ByLength {}, names)} empty=${greatest(
    Lexical {},
    [],
  )}"
  println(g)
  let p = "plain=${sort_by_collation(Plain(Lexical {}), names)}"
  println(p)
  let s = "short=${sort_by_collation(Short(ByLength {}), names)}"
  println(s)
  let b = "best=${best(Vowels {}, names)} empty=${best(Vowels {}, [])}"
  println(b)
}
