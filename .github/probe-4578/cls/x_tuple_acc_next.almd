protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

protocol Counter {
  fn next(c: Self, n: Int) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

type Lexical: Order = {}

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

type Step: Counter = { by: Int }

fn Step.next(c: Step, n: Int) -> Int = n + c.by

fn f[C: Counter](c: C, start: Int, limit: Int) -> Int? = {
  let r = list.range(0, 5) |> list.fold((c, none), ((cc, acc), _) => (cc, match acc {
    none => if start < limit then some(start) else none,
    some(v) => if cc.next(v) < limit then some(cc.next(v)) else some(v),
  }))
  r.1
}

fn main() -> Unit = {
  let line = "${f(Step { by: 3 }, 1, 12)}"
  println("={line}")
}
