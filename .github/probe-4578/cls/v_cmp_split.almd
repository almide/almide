protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

type Lexical: Order = {}

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

fn g_generic[O: Order](o: O, names: List[String]) -> String? =
  names |> list.fold(none, (best, n) => match best {
    none => some(n),
    some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
  })

fn g_concrete(o: Lexical, names: List[String]) -> String? =
  names |> list.fold(none, (best, n) => match best {
    none => some(n),
    some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
  })

fn g_plain(names: List[String]) -> String? =
  names |> list.fold(none, (best, n) => match best {
    none => some(n),
    some(b) => if n > b then some(n) else some(b),
  })

fn g_typed_seed[O: Order](o: O, names: List[String]) -> String? = {
  let seed: String? = none
  names |> list.fold(seed, (best, n) => match best {
    none => some(n),
    some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
  })
}

fn g_option_helper[O: Order](o: O, best: String?, n: String) -> String? = match best {
  none => some(n),
  some(b) => if o.cmp(n, b) > 0 then some(n) else some(b),
}

fn g_via_helper[O: Order](o: O, names: List[String]) -> String? =
  names |> list.fold(none, (best, n) => g_option_helper(o, best, n))

fn ins_generic[O: Order](o: O, sorted: List[String], n: String) -> List[String] = {
  let before = sorted |> list.take_while((s) => o.cmp(s, n) <= 0)
  before + [n] + list.drop(sorted, list.len(before))
}

fn ins_plain(sorted: List[String], n: String) -> List[String] = {
  let before = sorted |> list.take_while((s) => s <= n)
  before + [n] + list.drop(sorted, list.len(before))
}

fn ins_count[O: Order](o: O, sorted: List[String], n: String) -> List[String] = {
  let k = sorted |> list.count((s) => o.cmp(s, n) <= 0)
  list.take(sorted, k) + [n] + list.drop(sorted, k)
}

fn main() -> Unit = {
  println("${g_generic(Lexical {}, ["a", "b"])} ${g_concrete(Lexical {}, ["a"])} ${g_plain(["a"])} ${g_typed_seed(Lexical {}, ["a"])} ${g_via_helper(Lexical {}, ["a"])}")
  println("${ins_generic(Lexical {}, ["a", "c"], "b")} ${ins_plain(["a", "c"], "b")} ${ins_count(Lexical {}, ["a", "c"], "b")}")
}
