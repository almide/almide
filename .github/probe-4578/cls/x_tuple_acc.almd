protocol Order {
  fn cmp(o: Self, a: String, b: String) -> Int
}

protocol Counter {
  fn next(c: Self, n: Int) -> Int
}

fn sign(a: String, b: String) -> Int = if a < b then -1 else if a > b then 1 else 0

type Lexical: Order = {}

fn Lexical.cmp(o: Lexical, a: String, b: String) -> Int = sign(a, b)

type Step: Counter = { by: Int }

fn Step.next(c: Step, n: Int) -> Int = n + c.by

fn f[O: Order](o: O, names: List[String]) -> String? = {
  let r = names |> list.fold((o, none), ((oo, best), n) => (oo, match best {
    none => some(n),
    some(b) => if oo.cmp(n, b) > 0 then some(n) else some(b),
  }))
  r.1
}

fn main() -> Unit = {
  let line = "${f(Lexical {}, ["b", "c", "a"])}"
  println("={line}")
}
