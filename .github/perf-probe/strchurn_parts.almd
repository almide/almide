// perf-probe ablation: strchurn stage 1 only (N int.to_string into a list).
import env
import int

effect fn main() -> Unit = {
  let args = env.args()
  let n = match list.get(args, 0) {
    some(s) => match int.parse(s) {
      ok(v) => v,
      err(_) => 1000000,
    },
    none => 1000000,
  }
  let parts = list.range(0, n) |> list.map((i) => int.to_string(i))
  let total = parts |> list.map((s) => string.len(s)) |> list.sum
  println("n: ${n} sum: ${total}")
}
