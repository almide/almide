// perf-probe ablation: the per-key string building of mapbuild/strchurn alone —
// int.to_string + a literal prefix concat, consumed and dropped, N times.
import env
import int

effect fn main() -> Unit = {
  let args = env.args()
  let n = match list.get(args, 0) {
    some(s) => match int.parse(s) {
      ok(v) => v,
      err(_) => 1000000,
    },
    none => 1000000,
  }
  var total = 0
  for i in 0..<n {
    let k = "k" + int.to_string(i)
    total = total + string.len(k)
  }
  println("itoa total: ${int.to_string(total)}")
}
