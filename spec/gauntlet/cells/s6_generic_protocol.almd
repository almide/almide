// UNFILED: a generic protocol declares but cannot be used
type User: Eq, Repr = { name: String }

protocol Repository[T] {
  fn get(self, id: String) -> T?
}

type UserRepo: Repository[User] = { ids: List[String], vals: List[User] }

fn UserRepo.get(self, id: String) -> User? = list.get(self.vals, 0)

fn name_of[R: Repository[User]](r: R, id: String) -> String =
  match r.get(id) { some(u) => u.name, none => "?" }
