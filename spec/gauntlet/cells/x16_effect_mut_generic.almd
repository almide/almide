import io

protocol Counter {
  fn bump(mut self: Self, by: Int) -> Unit
  fn read(self) -> Int
}

type Tally: Counter = { n: Int }

fn Tally.bump(mut self: Tally, by: Int) -> Unit = {
  self.n = self.n + by
}

fn Tally.read(self) -> Int = self.n

effect fn go[C: Counter](mut c: C) -> Int = {
  c.bump(1)
  c.read()
}

effect fn main() -> Unit = {
  var t = Tally { n: 0 }
  io.print(int.to_string(go(t)!))
}
