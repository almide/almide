import io

protocol Counter {
  fn bump(mut self: Self, by: Int) -> Unit
  fn read(self) -> Int
}

type Tally: Counter = { n: Int }

fn Tally.bump(mut self: Tally, by: Int) -> Unit = { self.n = self.n + by }

fn Tally.read(self) -> Int = self.n

fn go[C: Counter](mut c: C) -> Int = {
  c.bump(1)
  c.bump(2)
  c.read()
}

effect fn main() -> Unit = {
  var t = Tally { n: 10 }
  let r = go(t)
  io.print("${r}/${t.n}")
}
