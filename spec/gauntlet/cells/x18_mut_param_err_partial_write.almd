// #1871 — a mut-param effect fn that mutates its buffer and THEN errs, consumed
// through `??` and `match`. Native passes `mut` as `&mut`, so the write stays
// visible after the err (r=-9 len=1, then m=0 len=2); the interp (the
// executable spec) agrees. Ruled (B), write visible (#2917): the C-132 carrier
// carries the buffer on the err arm too and the call site writes back on both
// arms, so the wasm leg prints the same bytes. This cell pins that `run` row.
effect fn bump_then_fail(mut buf: List[Int], n: Int) -> Int = {
  list.push(buf, n)
  if n > 0 then err("fell") else ok(n)
}

effect fn main() -> Unit = {
  var xs: List[Int] = []
  let r = bump_then_fail(xs, 9) ?? -9
  println("r=${r} len=${list.len(xs)}")
  let m = match bump_then_fail(xs, 0) {
    ok(v) => v,
    err(_) => -1,
  }
  println("m=${m} len=${list.len(xs)}")
}
