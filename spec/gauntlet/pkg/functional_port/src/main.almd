import self.application.place_order
import self.infra.memory_repo
import self.infra.pair_repo
import self.infra.system_clock
import io

effect fn main() -> Unit = {
  let clock = system_clock.FixedClock { stamp: "2026-08-25T00:00:00Z" }
  let cmd = place_order.PlaceOrderCommand { order_id: "o-1", customer: "ada", sku: "widget", qty: 3, unit_cents: 1250 }
  let (m1, a) = place_order.place_order(memory_repo.empty_repo(), clock, cmd)!
  io.print("memory: total=${a.total} rev=${place_order.revenue(m1)!}")
  let (m2, msg1) = place_order.cancel_order(m1, "o-1")!
  io.print(" ${msg1} rev=${place_order.revenue(m2)!}\n")
  let (p1, b) = place_order.place_order(pair_repo.PairOrderRepo { ids: [], orders: [] }, clock, cmd)!
  io.print("pair:   total=${b.total} rev=${place_order.revenue(p1)!}")
  let (p2, msg2) = place_order.cancel_order(p1, "o-1")!
  io.print(" ${msg2} rev=${place_order.revenue(p2)!}\n")
}
