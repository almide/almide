// @contract: C-166
// `${map}` renders byte-identically on both targets for every self-hosted
// key/value pairing. Two of the most common walled the whole program: the
// interp leaf table synthesizes an ALREADY-SUFFIXED display name
// (`map.to_string_ss` for an all-String map, `to_string_sb` for Bool values),
// and the repr router then appended ANOTHER suffix to it — fabricating
// `map.to_string_ss_str_wall` / `map.to_string_x_skv_wall`, names nothing
// defines. Only `to_string` and `to_string_sb` were spelled out as
// pass-through; the rest of the family fell through to the wall arm. And
// `Map[String, Float]` had no variant at all.
effect fn main() -> Unit = {
  // All-String: quoted keys AND values.
  println("${["a": "x", "b": "y"]}")

  // Float values: shortest-round-trip, the same rendering a bare `${float}` gives.
  println("${["a": 1.5, "b": -0.25]}")

  // A key needing escaping goes through the shared quoting path, so every
  // variant escapes identically rather than re-deriving it.
  println("${["q\"k": 0.1]}")

  // The pairings that already worked must keep working — this is the family the
  // suffix fix touches, so all of it is pinned together.
  println("${["a": 1, "b": 2]}")
  println("${["a": true]}")
  println("${["a": [1, 2]]}")

  // Empty renders `[:]` in every pairing.
  let e: Map[String, Float] = [:]
  println("${e}")
}
