// @contract: C-210
// NaN OBSERVATION IS CANONICAL — the deterministic-profile conformance
// fixture. A NaN's raw sign/payload is where byte-identity would leak:
// x86 arithmetic produces sign-set NaNs where aarch64 does not, engines
// may or may not propagate payloads, and `int.bits_to_float` can smuggle
// arbitrary payloads in. Every observation boundary (`float.to_bits`,
// the bytes float writes) collapses NaN to ONE pattern — f64
// 0x7FF8000000000000, f32 0x7FC00000 — so the assertions below hold with
// the SAME bytes on native, wasm, and every host architecture. Non-NaN
// bits stay raw (the 1.5 row pins that no normalization over-reaches).
effect fn main() -> Unit = {
  let z = 0.0
  let nan_div = z / z
  let inf = 1.0 / z
  let canon = 0x7FF8000000000000
  println(if float.to_bits(nan_div) == canon then "div:canonical" else "div:RAW-LEAK")
  println(if float.to_bits(inf - inf) == canon then "infsub:canonical" else "infsub:RAW-LEAK")
  println(if float.to_bits(0.0 - nan_div) == canon then "negated:canonical" else "negated:RAW-LEAK")
  println(if float.to_bits(int.bits_to_float(0x7FF8000000000123)) == canon then "payload:canonical" else "payload:RAW-LEAK")
  println(if float.to_bits(int.bits_to_float(-2251799813685248)) == canon then "signed:canonical" else "signed:RAW-LEAK")
  println(if float.to_bits(1.5) == 0x3FF8000000000000 then "finite:raw" else "finite:WRONG")
}
