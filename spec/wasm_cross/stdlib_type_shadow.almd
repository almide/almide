// @contract: C-076
// A user type named after a STDLIB-OWNED type — the builtin `Value`, a
// runtime-backed nominal (`HttpRequest`), an auto-imported bundled record
// (`Deque`, with no import), an auto-imported newtype (`value.Path`), a
// bundled record (`Url`) — keeps its own identity while the stdlib's stays exactly
// what every stdlib signature carries (#1828). The checker keys the user's
// declaration under the #433 module-qualified name (`self.Value` in the entry
// program), never under the bare key the stdlib's `Ty::Named("Value")` is;
// link mangling then names the user's struct apart from the runtime's
// reserved `AlmideValue` (#1821) on native, and the wasm type table keys it
// apart from the builtin dynamic value. Before this landing `json.parse("{}")!.n`
// type-checked against the user's record and printed a wrong number on wasm
// while native failed at rustc (E0308).
//
// Cells, each byte-identical native == wasm: the user's record literal, field
// read, record PATTERN, convention method, equality and repr (shown under the
// SOURCE spelling `Value { … }`, not the identity key) beside the stdlib value
// flowing through `json.parse` / `json.stringify` / `value.int`; a user
// VARIANT under a runtime-backed name beside the runtime's `HttpResponse`;
// a user record under `Deque` beside the auto-imported `deque.from_list` /
// `deque.len` and `bytes.append_u16_le`; a user record under `Path` beside
// `value.key(value.root(), ..)`; a user record under `Url` beside
// `url.parse`'s own record. (The stdlib `bytes.Endian` twin and `json.JsonPath`
// this fixture first pinned left in dialect epoch 15.)
import json
import http
import url

type Value = { n: Int }

type HttpRequest = | Small(Int) | Big

type Deque = { n: Int }

type Path = { n: Int }

type Url = { n: Int }

fn twice(v: Value) -> Int = v.n * 2

fn kind(v: Value) -> String = match v {
  Value { n } => if n > 1 then "big" else "small"
}

fn Value.triple(self) -> Int = self.n * 3

fn show(r: HttpRequest) -> String = match r {
  Small(n) => "small ${n}",
  Big => "big",
}

fn pick(big: Bool) -> Deque = if big then Deque { n: 1 } else Deque { n: 0 }

effect fn main() -> Unit = {
  let mine = Value { n: 7 }
  let doc = json.parse("{\"a\":1}")!
  println("${twice(mine)} ${kind(mine)} ${mine.triple()} ${mine == Value { n: 7 }} ${mine}")
  println("${json.stringify(doc)} ${json.stringify(value.int(3))}")
  let r = http.response(200, "body")
  println("${show(Small(3))} ${show(Big)} ${http.body(r)}")
  var t = bytes.zeros(0)
  bytes.append_u16_le(t, 258)
  let e: Deque = pick(true)
  let q = deque.from_list([1, 2, 3])
  println("${bytes.get_u16_le(t, 0) ?? 0} ${bytes.get_u16_be(t, 0) ?? 0} ${e.n} ${deque.len(q)} ${deque.to_list(q)}")
  let path = value.key(value.root(), "a")
  let jp = Path { n: 5 }
  println("${jp.n} ${json.stringify(value.get_path(doc, path) ?? value.null())}")
  let u = url.parse("http://example.com/p")!
  let mu = Url { n: 9 }
  println("${mu.n} ${u.host}")
}
