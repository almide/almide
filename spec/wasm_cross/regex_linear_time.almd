// @contract: C-032
// #4019: regex matching takes time proportional to the pattern's size times
// the input's length, whatever the pattern. The engines used to backtrack with
// no bound on the steps, so a pattern with nested or overlapping repetition
// took time exponential in the input's length on a subject it does not match:
// `(a+)+$` on 30 `a`s and a `!` already took minutes, and every row below
// would never have finished (2^100 ways to split 100 `a`s). Both legs now run
// the backtracking walk under a step budget linear in the input and hand over
// to a Pike VM, which keeps one thread per program state, when it runs out;
// the answer is the one the walk would have given
// (tests/regex_pike_differential_test.rs holds the two engines together).
// The wasm_cross gate's per-run time limit is what turns a regression here
// into a failure rather than a slow pass. 100 characters is far past where the
// old engines stopped answering and inside the reference interpreter's call
// depth (it does not eliminate tail calls); the differential test runs the
// same shapes at 100,000 characters natively.
import regex

fn line(label: String, answer: Bool) -> String = "${label}=${answer}"

fn main() -> Unit = {
  let a100 = string.repeat("a", 100)
  let bang = a100 + "!"
  // nested repetition: every split of the a's between the two loops
  println(line("(a+)+$ miss", regex.is_match(regex.new("(a+)+$"), bang)))
  println(line("(a+)+$ hit", regex.is_match(regex.new("(a+)+$"), a100)))
  println(line("full (a+)+ miss", regex.is_full_match(regex.new("(a+)+"), bang)))
  // overlapping alternatives under a star: Fibonacci-many ways to cut the a's
  println(line("(a|aa)*b", regex.is_match(regex.new("(a|aa)*b"), a100)))
  println(line("(a|aa)*b hit", regex.is_match(regex.new("(a|aa)*b"), a100 + "b")))
  // an optional inside a plus: the same blow-up through an empty choice
  println(line("^(a|a?)+$", regex.is_match(regex.new("^(a|a?)+$"), a100 + "b")))
  // the word-list shape behind many real advisories
  println(line("(\\w+\\s?)+$", regex.is_match(regex.new("(\\w+\\s?)+$"), bang)))
  // the other operations go through the same VM
  println(line("find", regex.find(regex.new("(a|aa)*c"), a100) == none))
  println(line("replace", regex.replace(regex.new("(a+)+b"), bang, "x") == bang))
  println(line("split", list.len(regex.split(regex.new("(a+)+b"), bang)) == 1))
  // captures: the last instance of the repeated group, as the walk answered
  match regex.captures(regex.new("^(a+)+(!)$"), bang) {
    some(cs) => println("captures=${list.len(cs)} ${string.len(list.get_or(cs, 0, none) ?? "")} ${list.get_or(cs, 2, none) ?? ""}"),
    none => println("captures=none"),
  }
  // the rule is the walk's, so a short input answers what it always did
  println(line("short", regex.is_match(regex.new("(a+)+$"), "aaaa!")))
  println(ostr(regex.find(regex.new("(a|ab)(c|bcd)(d*)"), "abcd")))
  println(ostr(regex.captures(regex.new("(a*)*b"), "aaab") |> option.map((cs) => list.join(cs |> list.map((c) => c ?? ""), ","))))
}

fn ostr(o: String?) -> String = match o {
  some(s) => s,
  none => "NONE",
}
