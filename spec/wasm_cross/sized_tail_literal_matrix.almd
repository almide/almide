// ── Float32 ──
fn whole_float32() -> Float32 = 2.5

fn if_arm_float32(n: Int) -> Float32 = if n > 0 then 2.5 else -1.25

fn match_arm_float32(n: Int) -> Float32 = match n {
  0 => -1.25,
  _ => 2.5,
}

fn block_tail_float32(n: Int) -> Float32 = {
  let k = n + 1
  if k > 1 then 2.5 else -1.25
}

fn let_annot_float32(n: Int) -> Float32 = {
  let v: Float32 = if n > 0 then 2.5 else -1.25
  v
}

fn some_payload_float32(n: Int) -> Float32? = if n > 0 then some(2.5) else none

fn ok_payload_float32(n: Int) -> Result[Float32, String] = if n > 0 then ok(2.5) else err("no")

fn err_payload_float32(n: Int) -> Result[Bool, Float32] = if n > 0 then ok(true) else err(2.5)

effect fn effect_tail_float32(n: Int) -> Float32 = {
  if n > 0 then 2.5 else -1.25
}

effect fn effect_ok_float32(n: Int) -> Float32 = {
  if n > 0 then ok(2.5) else ok(-1.25)
}

fn lambda_let_float32(n: Int) -> Float32 = {
  let g: (Int) -> Float32 = (x) => if x > 0 then 2.5 else -1.25
  g(n)
}

fn apply_float32(f: (Int) -> Float32, x: Int) -> Float32 = f(x)

fn lambda_arg_float32(n: Int) -> Float32 = apply_float32((x) => if x > 0 then 2.5 else -1.25, n)

effect fn show_float32(n: Int) -> Unit = {
  println("float32 ${n}: ${whole_float32()} ${if_arm_float32(n)} ${match_arm_float32(n)} ${block_tail_float32(n)} ${let_annot_float32(n)} ${effect_tail_float32(n)!} ${effect_ok_float32(n)!} ${lambda_let_float32(n)} ${lambda_arg_float32(n)}")
  match some_payload_float32(n) {
    some(v) => println("  some ${v}"),
    none => println("  none"),
  }
  match ok_payload_float32(n) {
    ok(v) => println("  ok ${v}"),
    err(e) => println("  err ${e}"),
  }
  match err_payload_float32(n) {
    ok(v) => println("  ok ${v}"),
    err(v) => println("  err ${v}"),
  }
}

effect fn main() -> Unit = {
  show_int8(1)!
  show_int8(0)!
  show_int16(1)!
  show_int16(0)!
  show_int32(1)!
  show_int32(0)!
  show_uint8(1)!
  show_uint8(0)!
  show_uint16(1)!
  show_uint16(0)!
  show_uint32(1)!
  show_uint32(0)!
  show_uint64(1)!
  show_uint64(0)!
  show_float32(1)!
  show_float32(0)!
}
