// @contract: C-038
// #3060: a literal in a tail-like position of a fn with a SIZED return takes
// the declared width, the way a `let` annotation gives it to its value. Native
// used to spell the literal at its default width (`7i64` in an `-> i32` fn,
// `Some(4i64)` in `-> Option<i32>`, `Ok::<i64, String>` in an effect fn) and
// rustc rejected the crate that check accepted. The full matrix: every sized
// width x every tail position, one fn per cell named `<position>_<width>`;
// tests/sized_tail_literal_matrix_test.rs refuses a missing cell.
// ── Int8 ──
fn whole_int8() -> Int8 = -3

fn if_arm_int8(n: Int) -> Int8 = if n > 0 then -3 else 7

fn match_arm_int8(n: Int) -> Int8 = match n {
  0 => 7,
  _ => -3,
}

fn block_tail_int8(n: Int) -> Int8 = {
  let k = n + 1
  if k > 1 then -3 else 7
}

fn let_annot_int8(n: Int) -> Int8 = {
  let v: Int8 = if n > 0 then -3 else 7
  v
}

fn some_payload_int8(n: Int) -> Int8? = if n > 0 then some(-3) else none

fn ok_payload_int8(n: Int) -> Result[Int8, String] = if n > 0 then ok(-3) else err("no")

fn err_payload_int8(n: Int) -> Result[Bool, Int8] = if n > 0 then ok(true) else err(-3)

effect fn effect_tail_int8(n: Int) -> Int8 = {
  if n > 0 then -3 else 7
}

effect fn effect_ok_int8(n: Int) -> Int8 = {
  if n > 0 then ok(-3) else ok(7)
}

fn lambda_let_int8(n: Int) -> Int8 = {
  let g: (Int) -> Int8 = (x) => if x > 0 then -3 else 7
  g(n)
}

fn apply_int8(f: (Int) -> Int8, x: Int) -> Int8 = f(x)

fn lambda_arg_int8(n: Int) -> Int8 = apply_int8((x) => if x > 0 then -3 else 7, n)

effect fn show_int8(n: Int) -> Unit = {
  println("int8 ${n}: ${whole_int8()} ${if_arm_int8(n)} ${match_arm_int8(n)} ${block_tail_int8(n)} ${let_annot_int8(n)} ${effect_tail_int8(n)!} ${effect_ok_int8(n)!} ${lambda_let_int8(n)} ${lambda_arg_int8(n)}")
  match some_payload_int8(n) {
    some(v) => println("  some ${v}"),
    none => println("  none"),
  }
  match ok_payload_int8(n) {
    ok(v) => println("  ok ${v}"),
    err(e) => println("  err ${e}"),
  }
  match err_payload_int8(n) {
    ok(v) => println("  ok ${v}"),
    err(v) => println("  err ${v}"),
  }
}

