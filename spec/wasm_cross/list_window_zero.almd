// @contract: C-129
// The SINGULAR `list.window(xs, 0)` — the plural `windows` had the T6 zero
// guard but `window` leaked std's raw `windows(0)` panic natively (exit 101)
// while the wasm self-host aborted in the T6 form (fuzz seed 1784914502541553000).
// Both targets: `Error: window size must be positive` + exit 1.
fn main() -> Unit = {
  let w = list.window([1.0, 2.0, 3.0], 2)
  println(int.to_string(list.len(w)))
  let z = list.window([1.0, 2.0], 0)
  println(int.to_string(list.len(z)))
}
