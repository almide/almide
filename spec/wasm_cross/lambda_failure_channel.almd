// @contract: C-369
// Cross-target coverage (#2725, ADR-0021): a lambda's failure channel carries
// the error type its `!`s agree on. Agreeing `!`s propagate the typed error
// through the fallible HOF unchanged — braces, a branch, a mid-block `let`,
// a typed slot. A channel that falls to `String` (disagreeing `!`s, or a
// `-> T!` fn) carries each typed error as its repr text, the text `"${e}"`
// shows. native == wasm byte-for-byte on stdout.
type Pt = { x: Int, y: Float }

type E: Eq, Repr = | Neg(Int) | Bad(String) | At(Pt) | Wrap(E) | Opt(Float?) | Named { code: Int, why: String } | Gone

fn step(acc: Int, x: Int) -> Int!E = if x < 0 then err(Neg(x)) else ok(acc + x)

fn fold_braced(xs: List[Int]) -> Int!E = list.fold(xs, 0, (acc, x) => {
  step(acc, x)!
})!

fn fold_branch(xs: List[Int]) -> Int!E = list.fold(
  xs,
  0,
  (acc, x) => if x == 100 then acc
  else step(acc, x)!,
)!

fn fold_mid_block(xs: List[Int]) -> Int!E = list.fold(
  xs,
  0,
  (acc, x) => {
    let v = step(acc, x)!
    v * 2
  },
)!

fn sum_with(xs: List[Int], f: (Int) -> Int!E) -> Int!E = list.fold(xs, 0, (a, x) => a + f(x)!)!

fn typed_slot(xs: List[Int]) -> Int!E = sum_with(xs, (n) => step(0, n)! * 3)

fn fail(e: E) -> Int!E = err(e)

fn erased(e: E) -> Int! = fail(e)! + 1

fn disagree(xs: List[String]) -> List[Int]! = list.map(
  xs,
  (s) => {
    let n = int.parse(s)!
    step(0, n)!
  },
)!

fn show_typed(label: String, r: Result[Int, E]) -> Unit = match r {
  ok(v) => println("${label} ok ${v}"),
  err(e) => println("${label} err ${e}"),
}

fn show_erased(label: String, r: Result[Int, String]) -> Unit = match r {
  ok(v) => println("${label} ok ${v}"),
  err(m) => println("${label} err [${m}] len ${string.len(m)}"),
}

fn main() -> Unit = {
  show_typed("braced", fold_braced([1, 2]))
  show_typed("braced", fold_braced([1, -2]))
  show_typed("branch", fold_branch([1, 100, 2]))
  show_typed("branch", fold_branch([3, -4]))
  show_typed("mid", fold_mid_block([4, 5]))
  show_typed("mid", fold_mid_block([4, -1]))
  show_typed("slot", typed_slot([1, 2]))
  show_typed("slot", typed_slot([1, -7]))
  show_erased("neg", erased(Neg(-2)))
  show_erased("bad", erased(Bad("q\"u\n\\ t\t")))
  show_erased("at", erased(At({ x: 1, y: 2.5 })))
  show_erased("wrap", erased(Wrap(Named { code: 7, why: "why" })))
  show_erased("opt", erased(Opt(some(2.0))))
  show_erased("none", erased(Opt(none)))
  show_erased("gone", erased(Gone))
  match disagree(["1", "2"]) {
    ok(v) => println("disagree ok ${v}"),
    err(m) => println("disagree err [${m}]"),
  }
  match disagree(["1", "-3"]) {
    ok(v) => println("disagree ok ${v}"),
    err(m) => println("disagree err [${m}]"),
  }
  match disagree(["x"]) {
    ok(v) => println("disagree ok ${v}"),
    err(m) => println("disagree err [${m}]"),
  }
}
