// @contract: C-324
// The 147-line SQLite tokenizer that shipped the #1688 miscompile in the
// wild: `emit_escaped` forwards its `mut Bytes` out-buffer to `emit_str`
// from inside match arms, and `emit_str` grows it through a for-loop of
// `bytes.push` — on v0.60.0-rc2 the structural leg trapped at runtime
// where native prints the highlighted HTML. Now both C-324 halves fire
// on one program: `emit_escaped`'s terminal match FOLDS to value flow,
// while `highlight`'s write-backs under a loop branch are un-foldable, so
// the structural emitter REFUSES it (assign:mut-param-in-branch-arm) and
// the build reroutes to the incumbent leg — the ledgers pin the refusal
// with a `!` row, and this fixture pins the rerouted build byte-identical
// with native. The
// tokenizer is verbatim from the wasm-size benchmark; only the stdin
// read is replaced by an embedded sample (all token classes on one
// input: keywords, strings with doubled-quote escapes, numbers, line and
// block comments, operators, brackets, HTML-escapable characters).
let keywords = [
  "ABORT",
  "ACTION",
  "ADD",
  "AFTER",
  "ALL",
  "ALTER",
  "ANALYZE",
  "AND",
  "AS",
  "ASC",
  "ATTACH",
  "AUTOINCREMENT",
  "BEFORE",
  "BEGIN",
  "BETWEEN",
  "BY",
  "CASCADE",
  "CASE",
  "CAST",
  "CHECK",
  "COLLATE",
  "COLUMN",
  "COMMIT",
  "CONFLICT",
  "CONSTRAINT",
  "CREATE",
  "CROSS",
  "CURRENT_DATE",
  "CURRENT_TIME",
  "CURRENT_TIMESTAMP",
  "DATABASE",
  "DEFAULT",
  "DEFERRABLE",
  "DEFERRED",
  "DELETE",
  "DESC",
  "DETACH",
  "DISTINCT",
  "DROP",
  "EACH",
  "ELSE",
  "END",
  "ESCAPE",
  "EXCEPT",
  "EXCLUSIVE",
  "EXISTS",
  "EXPLAIN",
  "FAIL",
  "FOR",
  "FOREIGN",
  "FROM",
  "FULL",
  "GLOB",
  "GROUP",
  "HAVING",
  "IF",
  "IGNORE",
  "IMMEDIATE",
  "IN",
  "INDEX",
  "INDEXED",
  "INITIALLY",
  "INNER",
  "INSERT",
  "INSTEAD",
  "INTERSECT",
  "INTO",
  "IS",
  "ISNULL",
  "JOIN",
  "KEY",
  "LEFT",
  "LIKE",
  "LIMIT",
  "MATCH",
  "NATURAL",
  "NO",
  "NOT",
  "NOTNULL",
  "NULL",
  "OF",
  "OFFSET",
  "ON",
  "OR",
  "ORDER",
  "OUTER",
  "PLAN",
  "PRAGMA",
  "PRIMARY",
  "QUERY",
  "RAISE",
  "RECURSIVE",
  "REFERENCES",
  "REGEXP",
  "REINDEX",
  "RELEASE",
  "RENAME",
  "REPLACE",
  "RESTRICT",
  "RIGHT",
  "ROLLBACK",
  "ROW",
  "SAVEPOINT",
  "SELECT",
  "SET",
  "TABLE",
  "TEMP",
  "TEMPORARY",
  "THEN",
  "TO",
  "TRANSACTION",
  "TRIGGER",
  "UNION",
  "UNIQUE",
  "UPDATE",
  "USING",
  "VACUUM",
  "VALUES",
  "VIEW",
  "VIRTUAL",
  "WHEN",
  "WHERE",
  "WITH",
  "WITHOUT"
]

fn at(src: List[Int], i: Int) -> Int = if i < list.len(src) then src[i] else 0 - 1

fn is_digit(c: Int) -> Bool = c >= 48 and c <= 57

fn is_ident_start(c: Int) -> Bool = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

fn is_ident_char(c: Int) -> Bool = is_ident_start(c) or is_digit(c)

fn scan_while(src: List[Int], i: Int, pred: (Int) -> Bool) -> Int = if i < list.len(src) and pred(src[i]) then scan_while(src, i + 1, pred)
else i

// End of a quoted run starting at i (opening quote q, doubled q escapes).
fn scan_quoted(src: List[Int], i: Int, q: Int) -> Int = {
  let n = list.len(src)
  var j = i + 1
  var open = true
  while open and j < n {
    if src[j] == q then {
      if at(src, j + 1) == q then {
        j = j + 2
      } else {
        j = j + 1
        open = false
      }
    } else {
      j = j + 1
    }
  }
  j
}

// Optional exponent: E [-+]? DIGIT+ — consumed only when digits follow.
fn scan_exponent(src: List[Int], i: Int) -> Int = {
  let e = at(src, i)
  if e != 69 and e != 101 then i
  else {
    let s = at(src, i + 1)
    let d = if s == 43 or s == 45 then i + 2 else i + 1
    if is_digit(at(src, d)) then scan_while(src, d, is_digit)
    else i
  }
}

fn scan_number(src: List[Int], i: Int) -> Int = {
  let j = scan_while(src, i, is_digit)
  let k = if at(src, j) == 46 then scan_while(src, j + 1, is_digit)
  else j
  scan_exponent(src, k)
}

// IDENTIFIER: "..." | `...` | [...] | [a-zA-Z_][a-zA-Z_0-9]*  (returns i when none)
fn scan_identifier(src: List[Int], i: Int) -> Int = {
  let c = at(src, i)
  if c == 34 or c == 96 then scan_quoted(src, i, c)
  else if c == 91 then {
    let j = scan_while(src, i + 1, (b) => b != 93)
    if j < list.len(src) then j + 1 else j
  } else if is_ident_start(c) then scan_while(src, i + 1, is_ident_char)
  else i
}

fn upper(c: Int) -> Int = if c >= 97 and c <= 122 then c - 32 else c

fn is_keyword(word: List[Int]) -> Bool = list.contains(keywords, string.from_bytes(word |> list.map(upper)))

fn is_op2(a: Int, b: Int) -> Bool = (a == 124 and b == 124) or (a == 60 and b == 60) or (a == 62 and b == 62) or (a == 60 and b == 61) or (a == 62 and b == 61) or (a == 61 and b == 61) or (a == 33 and b == 61) or (a == 60 and b == 62)

fn is_op1(c: Int) -> Bool = c == 61 or c == 42 or c == 47 or c == 37 or c == 43 or c == 45 or c == 38 or c == 124 or c == 60 or c == 62 or c == 126

// Longest-match token at i: (end, css class; "" = no capture).
fn token(src: List[Int], i: Int) -> (Int, String) = {
  let n = list.len(src)
  let c = src[i]
  let d = at(src, i + 1)
  if c == 45 and d == 45 then (scan_while(src, i, (b) => b != 10 and b != 13), "comment")
  else if c == 47 and d == 42 then {
    var j = i + 2
    while j < n and not (src[j] == 42 and at(src, j + 1) == 47) {
      j = j + 1
    }
    (if j < n then j + 2 else n, "comment")
  } else if c == 39 then (scan_quoted(src, i, 39), "string")
  else if (c == 120 or c == 88) and d == 39 then (scan_quoted(src, i + 1, 39), "string")
  else if is_digit(c) then (scan_number(src, i), "number")
  else if c == 46 and is_digit(d) then (scan_exponent(src, scan_while(src, i + 1, is_digit)), "number")
  else if c == 63 then (scan_while(src, i + 1, is_digit), "variable parameter")
  else if c == 58 or c == 64 or c == 36 then {
    let j = scan_identifier(src, i + 1)
    if j > i + 1 then (j, "variable parameter") else (i + 1, "")
  } else if is_op2(c, d) then (i + 2, "operator")
  else if is_op1(c) then (i + 1, "operator")
  else if c == 40 or c == 41 then (i + 1, "punctuation bracket")
  else if c == 59 or c == 46 or c == 44 then (i + 1, "punctuation delimiter")
  else {
    let j = scan_identifier(src, i)
    if j == i then (i + 1, "")
    else if is_ident_start(c) and is_keyword(list.slice(src, i, j)) then (j, "keyword") else (j, "")
  }
}

fn emit_str(mut out: Bytes, s: String) -> Unit = {
  for b in string.to_bytes(s) {
    bytes.push(out, b)
  }
}

fn emit_escaped(mut out: Bytes, src: List[Int], i: Int, j: Int) -> Unit = {
  var k = i
  while k < j {
    let b = src[k]
    match b {
      38 => emit_str(out, "&amp;"),
      60 => emit_str(out, "&lt;"),
      62 => emit_str(out, "&gt;"),
      34 => emit_str(out, "&quot;"),
      _ => bytes.push(out, b),
    }
    k = k + 1
  }
}

fn highlight(src: List[Int], mut out: Bytes) -> Unit = {
  let n = list.len(src)
  var i = 0
  while i < n {
    let (j, cls) = token(src, i)
    if cls == "" then {
      emit_escaped(out, src, i, j)
    } else {
      emit_str(out, "<span class=\"${cls}\">")
      emit_escaped(out, src, i, j)
      emit_str(out, "</span>")
    }
    i = j
  }
}

let sample = "SELECT name, COUNT(*) AS n FROM users u JOIN orders o ON u.id = o.uid\nWHERE u.email LIKE '%@example.com' AND o.total > 99.5 AND note = 'a&b <c> \"d\"'\nGROUP BY name HAVING n >= 2 ORDER BY n DESC LIMIT 10; -- trailing comment\n/* block\ncomment */ UPDATE t SET x = x''y'' WHERE k ISNULL;\n"

fn main() -> Unit = {
  var out = bytes.new(0)
  highlight(string.to_bytes(sample), out)
  println(bytes.to_string_lossy(out))
}
