// @contract: C-066
// #2010 Map stage b: a Map's ENTRIES are released with its entries array —
// handle keys and values dropped through the typed entry walk, a copied
// entries array (functional set / remove / filter / merge / update / upsert,
// a bind of a shared map) taking its own entry credits, an overwrite
// releasing the value it replaced. 2000 rounds of building, sharing,
// mutating and walking a Map[String, String] and a Map[String, Int] per
// round; the checksum pins value correctness byte-identical native == wasm,
// and the alloc ledger pins the watermark (it does not grow with the round
// count). Shapes stay inside the incumbent's linked registry (String and
// Int values) so the v1 leg lowers the fixture too.
fn build(i: Int) -> Map[String, String] = {
  let si = int.to_string(i)
  let pairs = [("a" + si, "x" + si), ("b", "y")]
  let m0 = map.from_list(pairs)
  let m1 = map.update(m0, "b", (v) => v + "z" + si)
  let m2 = map.upsert(m1, "c" + int.to_string(i % 2), "init", (v) => v)
  let m3 = map.filter(m2, (k, v) => string.len(v) > 1)
  let extra = [("d", "w" + si)]
  let m4 = map.merge(m3, map.from_list(extra))
  let m5 = map.set(m4, "e", "q" + si)
  map.remove(m5, "b")
}

fn counter(i: Int) -> Int = {
  var m: Map[String, Int] = map.new()
  map.insert(m, "a" + int.to_string(i), i)
  let shared = m
  map.insert(m, "b", 2)
  map.insert(m, "a" + int.to_string(i), 7)
  let doubled = map.map(m, (v) => v * 2)
  let found = map.find(doubled, (k, v) => v == 14)
  let f = match found {
    some((k, v)) => string.len(k) + v,
    none => 0,
  }
  var t: Map[String, String] = map.new()
  t["k" + int.to_string(i)] = "v" + int.to_string(i)
  t["k" + int.to_string(i)] = "w" + int.to_string(i)
  let vs = map.values(t) |> list.join("")
  map.len(m) + map.len(shared) + string.len(vs) + f + list.len(map.entries(doubled)) + map.fold(m, 0, (acc, k, v) => acc + v)
}

fn main() -> Unit = {
  var sink = 0
  var i = 0
  while i < 2000 {
    let m = build(i)
    var n = 0
    for (k, v) in m {
      n = n + string.len(k) + string.len(v)
    }
    let ks = map.keys(m) |> list.join(",")
    let g = map.get(m, "d")
    let gl = match g {
      some(v) => string.len(v),
      none => 0,
    }
    sink = sink + n + string.len(ks) + map.len(m) + gl + string.len(map.get_or(m, "e", "")) + counter(i)
    i = i + 1
  }
  println(int.to_string(sink))
}
