// @contract: C-292
// One value fed into two owning slots: Pair(x, x) dups its argument on
// construction; the tail call f(y, y) passes one value into two consuming
// parameters; has_none walks a List-of-Option recursively.
type Pr = | Pair(String, String)

fn mk_pair_of(x: String) -> Pr = Pair(x, x)

fn both(f: (String, String) -> String, y: String) -> String = f(y, y)

fn has_none(xs: List[Int?]) -> Bool = match xs {
  [] => false,
  [h, ..t] => match h {
    none => true,
    some(_) => has_none(t),
  },
}

fn main() -> Unit = {
  let p = mk_pair_of("bean" + "s")
  println(match p {
    Pair(a, b) => a + "|" + b
  })
  println(both((a, b) => a + b, "yo" + "yo"))
  println(if has_none([some(1), none, some(3)]) then "T" else "F")
  println(if has_none([some(1), some(2)]) then "T" else "F")
  println(if has_none([]) then "T" else "F")
}
