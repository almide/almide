// @contract: C-284
// The map / set / option cells of the fallible-HOF matrix (#3163): a
// propagating callback makes the HOF fallible, as it does for the list cells.
// A map and a set are walked in insertion order on every target, so the FIRST
// err is the same entry everywhere; an option's callback runs at most once.
// Callbacks print their visits, so the stop point is part of the compared
// output. Before #3163 each cell here was a type error.
effect fn chk(x: Int) -> Bool = {
  println("  visit " + int.to_string(x))
  if x < 0 then err("neg " + int.to_string(x))!
  else x > 2
}

effect fn kv(k: String, v: Int) -> Bool = {
  println("  visit " + k)
  if v < 0 then err("neg " + k)!
  else v > 2
}

effect fn dbl(v: Int) -> Int = {
  println("  dbl " + int.to_string(v))
  if v < 0 then err("bad dbl " + int.to_string(v))!
  else v * 2
}

effect fn acc(a: Int, k: String, v: Int) -> Int = {
  println("  acc " + k)
  if v < 0 then err("bad acc " + k)!
  else a + v
}

effect fn add(a: Int, x: Int) -> Int = {
  println("  add " + int.to_string(x))
  if x < 0 then err("bad add " + int.to_string(x))!
  else a + x
}

effect fn half(x: Int) -> Int? = if x < 0 then err("odd half")!
else if x % 2 == 0 then some(x / 2) else none

effect fn seven() -> Int = 7

effect fn nothing() -> Int = err("no fallback")!

effect fn maybe_seven() -> Int? = some(7)

effect fn ord(a: Int, x: Int) -> Int = {
  println("  ord " + int.to_string(a) + " " + int.to_string(x))
  if a < 0 or x < 0 then err("bad ord " + int.to_string(a) + " " + int.to_string(x))!
  else if a < x then -1
  else if a > x then 1
  else 0
}

effect fn key(x: Int) -> Int = {
  println("  key " + int.to_string(x))
  if x < 0 then err("bad key " + int.to_string(x))!
  else x % 3
}

effect fn pick(x: Int) -> Int? = {
  println("  pick " + int.to_string(x))
  if x < 0 then err("bad pick " + int.to_string(x))!
  else if x > 2 then some(x * 10) else none
}

effect fn pchk(e: (String, Int)) -> Bool = {
  println("  entry " + e.0)
  if e.1 < 0 then err("bad entry " + e.0)!
  else e.1 > 2
}

effect fn ppick(e: (String, Int)) -> Int? = {
  println("  entry " + e.0)
  if e.1 < 0 then err("bad entry " + e.0)!
  else if e.1 > 2 then some(e.1 * 10)
  else none
}

effect fn pkey(e: (String, Int)) -> Int = {
  println("  pkey " + e.0)
  if e.1 < 0 then err("bad pkey " + e.0)!
  else e.1 % 3
}

effect fn pord(a: (String, Int), x: (String, Int)) -> Int = {
  println("  pord " + a.0 + " " + x.0)
  if a.1 < 0 or x.1 < 0 then err("bad pord " + a.0 + " " + x.0)!
  else if a.1 < x.1 then -1
  else if a.1 > x.1 then 1
  else 0
}

effect fn pjoin(a: (String, Int), x: (String, Int)) -> (String, Int) = {
  println("  pjoin " + x.0)
  if x.1 < 0 then err("bad pjoin " + x.0)!
  else (a.0 + x.0, a.1 + x.1)
}

effect fn pacc(a: Int, e: (String, Int)) -> Int = {
  println("  pacc " + e.0)
  if e.1 < 0 then err("bad pacc " + e.0)!
  else a + e.1
}

effect fn pzip(e: (String, Int), y: Int) -> Int = {
  println("  pzip " + e.0)
  if e.1 < 0 then err("bad pzip " + e.0)!
  else e.1 + y
}

fn show[T](label: String, r: Result[T, String], f: (T) -> String) -> Unit = match r {
  ok(v) => println(label + " ok " + f(v)),
  err(e) => println(label + " err " + e),
}

fn b(v: Bool) -> String = if v then "true" else "false"

fn mi(m: Map[String, Int]) -> String = map.to_list(m) |> list.map((e) => e.0 + "=" + int.to_string(e.1)) |> list.join(",")

fn si(s: Set[Int]) -> String = set.to_list(s) |> list.map((n) => int.to_string(n)) |> list.join(",")

fn ints(xs: List[Int]) -> String = xs |> list.map((n) => int.to_string(n)) |> list.join(",")

fn el(xs: List[(String, Int)]) -> String = xs |> list.map((e) => e.0 + "=" + int.to_string(e.1)) |> list.join(",")

fn oe(o: (String, Int)?) -> String = match o {
  some(e) => e.0 + "=" + int.to_string(e.1),
  none => "none",
}

fn oi(o: Int?) -> String = match o {
  some(n) => "some " + int.to_string(n),
  none => "none",
}

effect fn main() -> Unit = {
  let good = map.from_list([("a", 1), ("b", 3), ("c", 5)])
  let bad = map.from_list([("a", 1), ("b", -2), ("c", 3), ("d", -4)])
  show("map.map", good |> map.map((v) => dbl(v)!), mi)
  show("map.map", bad |> map.map((v) => dbl(v)!), mi)
  show("map.filter", good |> map.filter((k, v) => kv(k, v)!), mi)
  show("map.filter", bad |> map.filter((k, v) => kv(k, v)!), mi)
  show("map.fold", good |> map.fold(0, (a, k, v) => acc(a, k, v)!), (n) => int.to_string(n))
  show("map.fold", bad |> map.fold(0, (a, k, v) => acc(a, k, v)!), (n) => int.to_string(n))
  show("map.any", good |> map.any((k, v) => kv(k, v)!), b)
  show("map.any", bad |> map.any((k, v) => kv(k, v)!), b)
  show("map.all", good |> map.all((k, v) => kv(k, v)!), b)
  show("map.all", map.from_list([("x", 4), ("y", -1)]) |> map.all((k, v) => kv(k, v)!), b)
  show("map.count", good |> map.count((k, v) => kv(k, v)!), (n) => int.to_string(n))
  show("map.count", bad |> map.count((k, v) => kv(k, v)!), (n) => int.to_string(n))
  show(
    "map.find",
    good |> map.find((k, v) => kv(k, v)!),
    (o) => match o {
      some(e) => e.0 + "=" + int.to_string(e.1),
      none => "none",
    },
  )
  show(
    "map.find",
    bad |> map.find((k, v) => kv(k, v)!),
    (o) => match o {
      some(e) => e.0,
      none => "none",
    },
  )
  show("map.update", map.update(good, "b", (v) => dbl(v)!), mi)
  show("map.update", map.update(good, "z", (v) => dbl(v)!), mi)
  show("map.update", map.update(bad, "b", (v) => dbl(v)!), mi)
  show("map.upsert", map.upsert(good, "c", 0, (v) => dbl(v)!), mi)
  show("map.upsert", map.upsert(good, "z", 9, (v) => dbl(v)!), mi)
  show("map.upsert", map.upsert(bad, "d", 0, (v) => dbl(v)!), mi)
  let sg = set.from_list([1, 3, 5])
  let sb = set.from_list([1, -2, 3, -4])
  show("set.map", sg |> set.map((x) => dbl(x)!), si)
  show("set.map", sb |> set.map((x) => dbl(x)!), si)
  show("set.filter", sg |> set.filter((x) => chk(x)!), si)
  show("set.filter", sb |> set.filter((x) => chk(x)!), si)
  show("set.fold", sg |> set.fold(0, (a, x) => add(a, x)!), (n) => int.to_string(n))
  show("set.fold", sb |> set.fold(0, (a, x) => add(a, x)!), (n) => int.to_string(n))
  show("set.any", sg |> set.any((x) => chk(x)!), b)
  show("set.any", sb |> set.any((x) => chk(x)!), b)
  show("set.all", sg |> set.all((x) => chk(x)!), b)
  show("set.all", set.from_list([4, -1]) |> set.all((x) => chk(x)!), b)
  show("set.count", sg |> set.count((x) => chk(x)!), (n) => int.to_string(n))
  show("set.count", sb |> set.count((x) => chk(x)!), (n) => int.to_string(n))
  show("set.find", sg |> set.find((x) => chk(x)!), oi)
  show("set.find", sb |> set.find((x) => chk(x)!), oi)
  show("set.zip_with", set.zip_with(sg, [10, 20], (a, x) => add(a, x)!), ints)
  show("set.zip_with", set.zip_with(sb, [10, 20, 30], (a, x) => add(x, a)!), ints)
  show("set.filter_map", sg |> set.filter_map((x) => pick(x)!), ints)
  show("set.filter_map", sb |> set.filter_map((x) => pick(x)!), ints)
  show("set.find_map", sg |> set.find_map((x) => pick(x)!), oi)
  show("set.find_map", sb |> set.find_map((x) => pick(x)!), oi)
  show("set.reduce", sg |> set.reduce((a, x) => add(a, x)!), oi)
  show("set.reduce", sb |> set.reduce((a, x) => add(a, x)!), oi)
  show("set.scan", sg |> set.scan(10, (a, x) => add(a, x)!), ints)
  show("set.scan", sb |> set.scan(10, (a, x) => add(a, x)!), ints)
  show("set.partition", sg |> set.partition((x) => chk(x)!), (p) => ints(p.0) + "|" + ints(p.1))
  show("set.partition", sb |> set.partition((x) => chk(x)!), (p) => ints(p.0) + "|" + ints(p.1))
  show("set.group_by", sg |> set.group_by((x) => key(x)!), (m) => int.to_string(map.len(m)))
  show("set.group_by", sb |> set.group_by((x) => key(x)!), (m) => int.to_string(map.len(m)))
  show("set.sort_by", sg |> set.sort_by((x) => key(x)!), ints)
  show("set.sort_by", sb |> set.sort_by((x) => key(x)!), ints)
  show("set.sort_with", sg |> set.sort_with((a, x) => ord(x, a)!), ints)
  show("set.sort_with", sb |> set.sort_with((a, x) => ord(x, a)!), ints)
  show("set.min_by", sg |> set.min_by((x) => key(x)!), oi)
  show("set.min_by", sb |> set.min_by((x) => key(x)!), oi)
  show("set.max_by", sg |> set.max_by((x) => key(x)!), oi)
  show("set.max_by", sb |> set.max_by((x) => key(x)!), oi)
  show("set.min_with", sg |> set.min_with((a, x) => ord(a, x)!), oi)
  show("set.min_with", sb |> set.min_with((a, x) => ord(a, x)!), oi)
  show("set.max_with", sg |> set.max_with((a, x) => ord(a, x)!), oi)
  show("set.max_with", sb |> set.max_with((a, x) => ord(a, x)!), oi)
  show("map.zip_with", map.zip_with(good, [10, 20], (e, y) => pzip(e, y)!), ints)
  show("map.zip_with", map.zip_with(bad, [10, 20, 30], (e, y) => pzip(e, y)!), ints)
  show("map.filter_map", good |> map.filter_map((e) => ppick(e)!), ints)
  show("map.filter_map", bad |> map.filter_map((e) => ppick(e)!), ints)
  show("map.find_map", good |> map.find_map((e) => ppick(e)!), oi)
  show("map.find_map", bad |> map.find_map((e) => ppick(e)!), oi)
  show("map.reduce", good |> map.reduce((a, e) => pjoin(a, e)!), oe)
  show("map.reduce", bad |> map.reduce((a, e) => pjoin(a, e)!), oe)
  show("map.scan", good |> map.scan(0, (a, e) => pacc(a, e)!), ints)
  show("map.scan", bad |> map.scan(0, (a, e) => pacc(a, e)!), ints)
  show("map.partition", good |> map.partition((e) => pchk(e)!), (p) => el(p.0) + "|" + el(p.1))
  show("map.partition", bad |> map.partition((e) => pchk(e)!), (p) => el(p.0) + "|" + el(p.1))
  show("map.group_by", good |> map.group_by((e) => pkey(e)!), (m) => int.to_string(map.len(m)))
  show("map.group_by", bad |> map.group_by((e) => pkey(e)!), (m) => int.to_string(map.len(m)))
  show("map.sort_by", good |> map.sort_by((e) => pkey(e)!), el)
  show("map.sort_by", bad |> map.sort_by((e) => pkey(e)!), el)
  show("map.sort_with", good |> map.sort_with((a, e) => pord(e, a)!), el)
  show("map.sort_with", bad |> map.sort_with((a, e) => pord(e, a)!), el)
  show("map.min_by", good |> map.min_by((e) => pkey(e)!), oe)
  show("map.min_by", bad |> map.min_by((e) => pkey(e)!), oe)
  show("map.max_by", good |> map.max_by((e) => pkey(e)!), oe)
  show("map.max_by", bad |> map.max_by((e) => pkey(e)!), oe)
  show("map.min_with", good |> map.min_with((a, e) => pord(a, e)!), oe)
  show("map.min_with", bad |> map.min_with((a, e) => pord(a, e)!), oe)
  show("map.max_with", good |> map.max_with((a, e) => pord(a, e)!), oe)
  show("map.max_with", bad |> map.max_with((a, e) => pord(a, e)!), oe)
  show("option.map", some(4) |> option.map((x) => dbl(x)!), oi)
  show("option.map", some(-4) |> option.map((x) => dbl(x)!), oi)
  show("option.map", none |> option.map((x: Int) => dbl(x)!), oi)
  show("option.flat_map", some(4) |> option.flat_map((x) => half(x)!), oi)
  show("option.flat_map", some(-1) |> option.flat_map((x) => half(x)!), oi)
  show("option.filter", some(4) |> option.filter((x) => chk(x)!), oi)
  show("option.filter", some(-4) |> option.filter((x) => chk(x)!), oi)
  show(
    "option.unwrap_or_else",
    none |> option.unwrap_or_else(() => seven()!),
    (n) => int.to_string(n),
  )
  show(
    "option.unwrap_or_else",
    some(1) |> option.unwrap_or_else(() => nothing()!),
    (n) => int.to_string(n),
  )
  show(
    "option.unwrap_or_else",
    none |> option.unwrap_or_else(() => nothing()!),
    (n) => int.to_string(n),
  )
  show("option.or_else", none |> option.or_else(() => maybe_seven()!), oi)
  show("option.or_else", some(2) |> option.or_else(() => maybe_seven()!), oi)
}
