// @contract: C-284
// The fallible list-HOF family driven by a USER `effect fn` callback — the
// idiom CLAUDE.md recommends (`files |> list.map((f) => read_meta(f)!)!`).
//
// A lambda is a target-directed position: its own `Ty::Fn` ret is what
// monomorphization specializes the twin off (`list.__fallible_map__Int_Int_String`
// is named for `(Int) -> Result[Int, String]`). But the v1 pre-pass that strips
// the carrier from a NEVER-ERR lifted effect call recurses INTO lambda bodies,
// and the lambda lifter reads only the body — so the tail came out raw while the
// node still said Result. The lifted fn rendered `(result i64)` where the
// `call_indirect` inside the twin declares `(result i32)`, a Result block
// pointer. On v0.57.0 the `map` cells trapped at run time with `wasm trap:
// indirect call type mismatch`, and the `flat_map` cell did not trap at all —
// native printed `a1,a2` while wasm printed `,,,` (four empty strings) with
// exit 0 on both. Silent-wrong, on the documented idiom (almide#1406).
//
// Every existing fixture for the fallible form drives it with a plain `fn`
// returning Result or with `int.parse` — the last two cells here keep those
// pinned, since they are what made the family look covered while the effect-fn
// cells had no coverage at all.
effect fn bump(x: Int) -> Int = x + 1

effect fn label(x: Int) -> String = "a" + int.to_string(x)

effect fn pair(x: Int) -> List[String] = ["a" + int.to_string(x), "b"]

// A callback that CAN err: the first-err short-circuit (ADR-0006) must still
// fire, so widening the wrap cannot quietly convert an err into an ok.
effect fn checked(x: Int) -> Int = if x > 2 then err("too big")!
else x * 10

effect fn main() -> Unit = {
  let m = ([1, 2] |> list.map((i) => bump(i)!))!
  println("map_int=" + list.join(m |> list.map((v) => int.to_string(v)), ","))
  let ms = ([1, 2] |> list.map((i) => label(i)!))!
  println("map_str=" + list.join(ms, ","))
  let fm = ([1, 2] |> list.flat_map((i) => pair(i)!))!
  println("flat_map=" + list.join(fm, ","))
  // ok side of the err-capable callback
  match [1, 2] |> list.map((i) => checked(i)!) {
    ok(v) => println("checked_ok=" + list.join(v |> list.map((n) => int.to_string(n)), ",")),
    err(e) => println("checked_ok UNEXPECTED err: " + e),
  }
  // err side: the first failing element decides, and the rest is not appended
  match [1, 9, 2] |> list.map((i) => checked(i)!) {
    ok(v) => println("checked_err UNEXPECTED ok=" + int.to_string(list.len(v))),
    err(e) => println("checked_err=" + e),
  }
  // The always-covered shape: a NON-effect callee returning Result, kept as the
  // pin that this landing does not move it.
  let p = (["4", "8"] |> list.map((s) => int.parse(s)!))!
  println("plain_fn=" + list.join(p |> list.map((v) => int.to_string(v)), ","))
}
