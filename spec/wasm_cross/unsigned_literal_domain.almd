// @contract: C-173, C-179
// The accepted side of the integer-literal domain: every boundary literal the
// compiler CAN represent produces the same value on both targets, including the
// one negated form that stays legal in an unsigned context (`-0`, which is `0`).
// The rejected side is pinned by tests/diagnostics — a program that does not
// compile has no runtime behaviour to compare:
//   e024-unsigned-negative-literal/  a negated literal in an unsigned context
// (The interim carrier rejection is gone with the unsigned lane that replaced
// it — `UInt64`'s FULL domain is exercised here and in C-179's fixture.)
fn main() -> Unit = {
  // Lower bound, written both ways. `-0` is `0`, so it stays legal.
  let z8: UInt8 = 0
  let z32: UInt32 = -0
  let z64: UInt64 = -0
  // Upper bound of each unsigned width — every one its DECLARED maximum,
  // `UInt64` included: the i64 slot carries its upper half as a bit pattern
  // and the unsigned lane reads it back (#872).
  let m8: UInt8 = 255
  let m16: UInt16 = 65535
  let m32: UInt32 = 4294967295
  let m64: UInt64 = 18446744073709551615
  // The signed counterpart of each width still takes the negated literal —
  // the sign rule is about the type's domain, not about the `-` token.
  let s8: Int8 = -128
  let s16: Int16 = -32768
  let s32: Int32 = -2147483648
  let s64: Int64 = -9223372036854775808
  println("zero:${uint8.to_string(z8)}:${uint32.to_string(z32)}:${uint64.to_string(z64)}")
  println("max:${uint8.to_string(m8)}:${uint16.to_string(m16)}:${uint32.to_string(m32)}:${uint64.to_string(m64)}")
  println("min:${int.to_string(int.from_int8(s8))}:${int.to_string(int.from_int16(s16))}:${int.to_string(int.from_int32(s32))}:${int.to_string(int.from_int64(s64))}")
}
