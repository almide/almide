// @contract: C-221
// An `effect (A) -> B` fn-typed slot (#1055) behaves identically on both
// targets for BOTH admitted spellings: a FALLIBLE lambda (`!` inside — the
// slot grants effect-fn body ergonomics, and its errors surface through the
// HOF's own `!`) and a PURE lambda (carrier-typed by the checker, so its
// value tail is ok-wrapped and flows through the same Result plumbing).
// The err path is exercised too: a failing handler's message must reach the
// caller byte-identically.
effect fn run_h(h: effect (Int) -> Int, x: Int) -> Int = h(x)!

effect fn risky(s: String) -> Int = int.parse(s)!

effect fn main() -> Unit = {
  println(int.to_string(run_h((x) => risky("41")! + x, 1)!))
  println(int.to_string(run_h((x) => x * 2, 21)!))
  let bad = run_h((x) => risky("nope")! + x, 1) ?? -1
  println(int.to_string(bad))
}
