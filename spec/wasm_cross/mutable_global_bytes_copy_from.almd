// @contract: C-194
// `bytes.copy_from` with a mutable-global DESTINATION writes through the
// module's storage slot on both targets (#955). Native's mutator table was
// missing `copy_from` (the one two-buffer entry in the runtime's &mut set), so
// the dst rendered as `&mut G.with(|c| (**c.borrow()).clone())` — a mutation
// of a discarded temporary clone. Distinct-global copies SILENTLY read back
// the pre-copy bytes on native while wasm wrote through; the self-copy
// spelling was the loud tell, emitting invalid Rust (the aliasing hoist bound
// a `&` borrow where the Bind path expects an owned value).
//
// Four shapes pinned:
//   1. global dst ← distinct global src   (was silently wrong on native)
//   2. global dst ← the SAME global (src == dst, the #955 repro) with
//      NON-overlapping ranges
//   3. global dst ← local src             (the mixed spelling)
//   4. OVERLAPPING self-copy ranges, both directions — SNAPSHOT semantics
//      (#963): the copy reads as if src were snapshotted first. Native gets
//      this from the aliasing hoist's clone; the wasm self-host routes the
//      aliased case through copy_within's direction-switching memmove.
//      Before #963 wasm's forward byte loop observed its own writes.

var arena = bytes.new(8)
var other = bytes.new(8)

fn main() -> Unit = {
  // 1. distinct globals: other[3] → arena[0]
  bytes.set_at(other, 3, 42)
  bytes.copy_from(arena, other, 0, 3, 1)
  println(int.to_string(bytes.get_or(arena, 0, -1)))

  // 2. self-copy: arena[3] → arena[4] (the issue's repro)
  bytes.set_at(arena, 3, 87)
  bytes.copy_from(arena, arena, 4, 3, 1)
  println(int.to_string(bytes.get_or(arena, 4, -1)))

  // 3. local src into a global dst
  var scratch = bytes.new(4)
  bytes.set_at(scratch, 0, 9)
  bytes.copy_from(arena, scratch, 7, 0, 1)
  println(int.to_string(bytes.get_or(arena, 7, -1)))

  // 4. overlapping self-copy, forward (doff > soff): arena[0..2] → arena[1..3].
  //    Snapshot semantics: [1] gets the pre-copy [0], [2] gets the pre-copy [1]
  //    — a forward byte loop would propagate [0] into both (#963).
  bytes.copy_from(arena, arena, 1, 0, 2)
  println(int.to_string(bytes.get_or(arena, 1, -1)))
  println(int.to_string(bytes.get_or(arena, 2, -1)))

  //    and backward (doff < soff): arena[3..5] → arena[2..4]
  bytes.copy_from(arena, arena, 2, 3, 2)
  println(int.to_string(bytes.get_or(arena, 2, -1)))
  println(int.to_string(bytes.get_or(arena, 3, -1)))

  // The copies landed in the slot, not a clone: a fresh read in a callee sees
  // every write.
  println(int.to_string(bytes.get_or(arena, 0, -1)))
}
