effect fn main() -> Unit = {
  row_int8(-128)!
  row_int8(127)!
  row_int16(-32768)!
  row_int16(32767)!
  row_int32(-2147483648)!
  row_int32(2147483647)!
  row_uint8(0)!
  row_uint8(255)!
  row_uint16(0)!
  row_uint16(65535)!
  row_uint32(0)!
  row_uint32(4294967295)!
  row_uint64(0)!
  row_uint64(9223372036854775807)!
  row_uint64(9223372036854775808)!
  row_uint64(18446744073709551615)!
  row_float32(float.to_float32(0.1))!
  row_float32(float.to_float32(2.0))!
  row_float32(float.to_float32(-123.456))!
  let hi_int8: Int8 = 127
  println("main_line_int8: ${hi_int8}")
  println("${hi_int8}")
  let hi_int16: Int16 = 32767
  println("main_line_int16: ${hi_int16}")
  println("${hi_int16}")
  let hi_int32: Int32 = 2147483647
  println("main_line_int32: ${hi_int32}")
  println("${hi_int32}")
  let hi_uint8: UInt8 = 255
  println("main_line_uint8: ${hi_uint8}")
  println("${hi_uint8}")
  let hi_uint16: UInt16 = 65535
  println("main_line_uint16: ${hi_uint16}")
  println("${hi_uint16}")
  let hi_uint32: UInt32 = 4294967295
  println("main_line_uint32: ${hi_uint32}")
  println("${hi_uint32}")
  let hi_uint64: UInt64 = 18446744073709551615
  println("main_line_uint64: ${hi_uint64}")
  println("${hi_uint64}")
  let hi_float32: Float32 = float.to_float32(-123.456)
  println("main_line_float32: ${hi_float32}")
  println("${hi_float32}")
  let bu: Box[UInt64] = Box { v: hi_uint64 }
  let bi: Box[Int] = Box { v: -1 }
  let bi2: Box[Int] = Box { v: -2 }
  let bu2: Box[UInt64] = Box { v: hi_uint64 }
  println("shared box: ${bu} ${bi} ${bi2} ${bu2}")
  let tf: Tree[Float32] = Node(Leaf, float.to_float32(0.1))
  let td: Tree[Float] = Node(Leaf, 0.1 + 0.2)
  let td2: Tree[Float] = Node(Leaf, 0.1)
  let tf2: Tree[Float32] = Node(Leaf, float.to_float32(0.1 + 0.2))
  println("shared tree: ${tf} ${td} ${td2} ${tf2}")
}
