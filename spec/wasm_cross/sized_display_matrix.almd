  "${o}"
}

fn fails_uint64(x: UInt64) -> Result[Int, UInt64] = err(x)

effect fn lift_uint64(x: UInt64) -> Int = fails_uint64(x)!

effect fn err_propagate_uint64(x: UInt64) -> String = match lift_uint64(x) {
  ok(v) => "ok ${v}",
  err(e) => e,
}

effect fn row_uint64(x: UInt64) -> Unit = {
  println("UInt64 interp: " + interp_uint64(x))
  println("UInt64 interp_mid: " + interp_mid_uint64(x))
  println("UInt64 concat: " + concat_uint64(x))
  println("UInt64 list: " + list_uint64(x))
  println("UInt64 record: " + record_uint64(x))
  println("UInt64 anon_record: " + anon_record_uint64(x))
  println("UInt64 generic_record: " + generic_record_uint64(x))
  println("UInt64 tuple: " + tuple_uint64(x))
  println("UInt64 option: " + option_uint64(x))
  println("UInt64 result_ok: " + result_ok_uint64(x))
  println("UInt64 result_err: " + result_err_uint64(x))
  println("UInt64 map_key: " + map_key_uint64(x))
  println("UInt64 map_value: " + map_value_uint64(x))
