// @contract: C-179, C-372
// The SIZED-number display matrix (#3187): every sized width (rows) through
// every display path (columns) prints the same text on native, wasm and the
// interpreter. A UInt64 in the upper half (`i64::MAX+1 ..= u64::MAX`) rides
// the i64 slot as a bit pattern, so a display that reads the slot signed
// prints `-1` for u64::MAX; a Float32 rides the f64 slot, so a display that
// loses its type prints the widened f64's digits. One fn per cell, named
// `<path>_<width>`; tests/sized_display_matrix_test.rs keeps the matrix whole.
// `err_propagate_<width>` is the repr an error of that width carries when `!`
// lifts it into an effect fn's String channel. The `main_line_<width>` cells
// interpolate in `main`'s own body, where the outermost build takes the
// room-free appends (line_bounded.rs). Each integer row also asserts its
// `${x}` against `<width>.to_string(x)`, a printer of its own, so a leaf that
// every leg got wrong the same way still fails. The closing lines run each generic
// instance next to the default width that shares its slot layout, in both
// orders, so neither instance borrows the other's digits.
type Box[T] = { v: T }

type Tag[T] = | One(T) | Nope

type Tree[T] = | Leaf | Node(Tree[T], T)

type RecInt8 = { v: Int8, n: Int }

type VarInt8 = | TupInt8(Int8, Int8) | FldInt8 { v: Int8 }

type RecInt16 = { v: Int16, n: Int }

type VarInt16 = | TupInt16(Int16, Int16) | FldInt16 { v: Int16 }

type RecInt32 = { v: Int32, n: Int }

type VarInt32 = | TupInt32(Int32, Int32) | FldInt32 { v: Int32 }

type RecUInt8 = { v: UInt8, n: Int }

type VarUInt8 = | TupUInt8(UInt8, UInt8) | FldUInt8 { v: UInt8 }

type RecUInt16 = { v: UInt16, n: Int }

type VarUInt16 = | TupUInt16(UInt16, UInt16) | FldUInt16 { v: UInt16 }

type RecUInt32 = { v: UInt32, n: Int }

type VarUInt32 = | TupUInt32(UInt32, UInt32) | FldUInt32 { v: UInt32 }

type RecUInt64 = { v: UInt64, n: Int }

type VarUInt64 = | TupUInt64(UInt64, UInt64) | FldUInt64 { v: UInt64 }

type RecFloat32 = { v: Float32, n: Int }

type VarFloat32 = | TupFloat32(Float32, Float32) | FldFloat32 { v: Float32 }

fn interp_int8(x: Int8) -> String = "${x}"

fn interp_mid_int8(x: Int8) -> String = "<${x}|${x}>"

fn concat_int8(x: Int8) -> String = "s=" + int8.to_string(x) + "."

fn list_int8(x: Int8) -> String = "${[x, x]}"

fn record_int8(x: Int8) -> String = "${RecInt8 { v: x, n: 1 }}"

fn anon_record_int8(x: Int8) -> String = {
  let r: { u: Int8, k: Int } = { u: x, k: 1 }
  "${r}"
}

fn generic_record_int8(x: Int8) -> String = {
  let b: Box[Int8] = Box { v: x }
  "${b}"
}

fn tuple_int8(x: Int8) -> String = "${(x, 1, x)}"

fn option_int8(x: Int8) -> String = "${some(x)}"

fn result_ok_int8(x: Int8) -> String = {
  let r: Result[Int8, String] = ok(x)
  "${r}"
}

fn result_err_int8(x: Int8) -> String = {
  let r: Result[Int, Int8] = err(x)
  "${r}"
}

fn map_key_int8(x: Int8) -> String = {
  let m: Map[Int8, Int] = map.from_list([(x, 1)])
  "${m}"
}

fn map_value_int8(x: Int8) -> String = {
  let m: Map[String, Int8] = map.from_list([("k", x)])
  "${m}"
}

fn set_int8(x: Int8) -> String = {
  let s: Set[Int8] = set.from_list([x])
  "${s}"
}

fn variant_tuple_int8(x: Int8) -> String = "${TupInt8(x, x)}"

fn variant_record_int8(x: Int8) -> String = "${FldInt8 { v: x }}"

fn generic_variant_int8(x: Int8) -> String = {
  let t: Tag[Int8] = One(x)
  "${t}"
}

fn recursive_generic_int8(x: Int8) -> String = {
  let t: Tree[Int8] = Node(Node(Leaf, x), x)
  "${t}"
}

fn nested_int8(x: Int8) -> String = {
  let o: List[(Int8, RecInt8)]? = some([
    (x, RecInt8 { v: x, n: 2 })
  ])
  "${o}"
}

fn fails_int8(x: Int8) -> Result[Int, Int8] = err(x)

effect fn lift_int8(x: Int8) -> Int = fails_int8(x)!

effect fn err_propagate_int8(x: Int8) -> String = match lift_int8(x) {
  ok(v) => "ok ${v}",
  err(e) => e,
}

effect fn row_int8(x: Int8) -> Unit = {
  println("Int8 interp: " + interp_int8(x))
  println("Int8 interp_mid: " + interp_mid_int8(x))
  println("Int8 concat: " + concat_int8(x))
  println("Int8 list: " + list_int8(x))
  println("Int8 record: " + record_int8(x))
  println("Int8 anon_record: " + anon_record_int8(x))
  println("Int8 generic_record: " + generic_record_int8(x))
  println("Int8 tuple: " + tuple_int8(x))
  println("Int8 option: " + option_int8(x))
  println("Int8 result_ok: " + result_ok_int8(x))
  println("Int8 result_err: " + result_err_int8(x))
  println("Int8 map_key: " + map_key_int8(x))
  println("Int8 map_value: " + map_value_int8(x))
  println("Int8 set: " + set_int8(x))
  println("Int8 variant_tuple: " + variant_tuple_int8(x))
  println("Int8 variant_record: " + variant_record_int8(x))
  println("Int8 generic_variant: " + generic_variant_int8(x))
  println("Int8 recursive_generic: " + recursive_generic_int8(x))
  println("Int8 nested: " + nested_int8(x))
  let ep = err_propagate_int8(x)!
  println("Int8 err_propagate: " + ep)
  assert_eq(interp_int8(x), int8.to_string(x))
}

