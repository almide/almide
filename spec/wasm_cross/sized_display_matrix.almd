fn recursive_generic_uint32(x: UInt32) -> String = {
  let t: Tree[UInt32] = Node(Node(Leaf, x), x)
  "${t}"
}

fn nested_uint32(x: UInt32) -> String = {
  let o: List[(UInt32, RecUInt32)]? = some([
    (x, RecUInt32 { v: x, n: 2 })
  ])
  "${o}"
}

fn fails_uint32(x: UInt32) -> Result[Int, UInt32] = err(x)

effect fn lift_uint32(x: UInt32) -> Int = fails_uint32(x)!

effect fn err_propagate_uint32(x: UInt32) -> String = match lift_uint32(x) {
  ok(v) => "ok ${v}",
  err(e) => e,
}

effect fn row_uint32(x: UInt32) -> Unit = {
  println("UInt32 interp: " + interp_uint32(x))
  println("UInt32 interp_mid: " + interp_mid_uint32(x))
  println("UInt32 concat: " + concat_uint32(x))
  println("UInt32 list: " + list_uint32(x))
  println("UInt32 record: " + record_uint32(x))
  println("UInt32 anon_record: " + anon_record_uint32(x))
  println("UInt32 generic_record: " + generic_record_uint32(x))
  println("UInt32 tuple: " + tuple_uint32(x))
  println("UInt32 option: " + option_uint32(x))
  println("UInt32 result_ok: " + result_ok_uint32(x))
  println("UInt32 result_err: " + result_err_uint32(x))
  println("UInt32 map_key: " + map_key_uint32(x))
  println("UInt32 map_value: " + map_value_uint32(x))
  println("UInt32 set: " + set_uint32(x))
  println("UInt32 variant_tuple: " + variant_tuple_uint32(x))
  println("UInt32 variant_record: " + variant_record_uint32(x))
  println("UInt32 generic_variant: " + generic_variant_uint32(x))
  println("UInt32 recursive_generic: " + recursive_generic_uint32(x))
  println("UInt32 nested: " + nested_uint32(x))
  let ep = err_propagate_uint32(x)!
  println("UInt32 err_propagate: " + ep)
  assert_eq(interp_uint32(x), uint32.to_string(x))
}

fn interp_uint64(x: UInt64) -> String = "${x}"

fn interp_mid_uint64(x: UInt64) -> String = "<${x}|${x}>"

fn concat_uint64(x: UInt64) -> String = "s=" + uint64.to_string(x) + "."

fn list_uint64(x: UInt64) -> String = "${[x, x]}"

fn record_uint64(x: UInt64) -> String = "${RecUInt64 { v: x, n: 1 }}"

fn anon_record_uint64(x: UInt64) -> String = {
  let r: { u: UInt64, k: Int } = { u: x, k: 1 }
  "${r}"
}

fn generic_record_uint64(x: UInt64) -> String = {
  let b: Box[UInt64] = Box { v: x }
  "${b}"
}

fn tuple_uint64(x: UInt64) -> String = "${(x, 1, x)}"

fn option_uint64(x: UInt64) -> String = "${some(x)}"

fn result_ok_uint64(x: UInt64) -> String = {
  let r: Result[UInt64, String] = ok(x)
  "${r}"
}

fn result_err_uint64(x: UInt64) -> String = {
  let r: Result[Int, UInt64] = err(x)
  "${r}"
}

fn map_key_uint64(x: UInt64) -> String = {
  let m: Map[UInt64, Int] = map.from_list([(x, 1)])
  "${m}"
}

fn map_value_uint64(x: UInt64) -> String = {
  let m: Map[String, UInt64] = map.from_list([("k", x)])
  "${m}"
}

fn set_uint64(x: UInt64) -> String = {
  let s: Set[UInt64] = set.from_list([x])
  "${s}"
}

fn variant_tuple_uint64(x: UInt64) -> String = "${TupUInt64(x, x)}"

fn variant_record_uint64(x: UInt64) -> String = "${FldUInt64 { v: x }}"

fn generic_variant_uint64(x: UInt64) -> String = {
  let t: Tag[UInt64] = One(x)
  "${t}"
}

fn recursive_generic_uint64(x: UInt64) -> String = {
