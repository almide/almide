// @contract: C-022
// Regression: bytes.to_string_lossy(bytes.from_list(xs)) must be UTF-8 decode (the inverse of
// bytes.to_list(bytes.from_string(s))),
// byte-identical native==WASM. Native used to map each byte to a Latin-1 scalar
// (`b as u8 as char`), which corrupted every non-ASCII string and broke the
// to_bytes round-trip; it is now `String::from_utf8_lossy` (U+FFFD per maximal
// invalid subpart), matching to_bytes, Almide's own bytes.to_string_lossy, and
// every other language. The WASM runtime does the same lossy decode. string.len
// is BYTE length, so this asserts on byte counts / round-tripped content.
effect fn main() -> Unit = {
  // Round-trip valid UTF-8 (was broken on native for all non-ASCII).
  println(bytes.to_string_lossy(bytes.from_list(bytes.to_list(bytes.from_string("Σ")))))
  // Σ
  println(bytes.to_string_lossy(bytes.from_list(bytes.to_list(bytes.from_string("café")))))
  // café
  println(bytes.to_string_lossy(bytes.from_list(bytes.to_list(bytes.from_string("日本語 😀 ∑")))))
  // 日本語 😀 ∑
  println(bytes.to_string_lossy(bytes.from_list([72, 105])))
  // Hi
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([])))))
  // 0
  // Lossy: invalid sequences become U+FFFD (3 bytes) per maximal subpart.
  // Print the byte length of the decoded result (U+FFFD = 3 bytes each).
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([255])))))
  // 3  (1× FFFD)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([195, 40])))))
  // 4  (FFFD + '(')
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([195])))))
  // 3  (truncated lead)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([72, 255, 73])))))
  // 5  (H FFFD I)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([224, 160, 32])))))
  // 4  (E0 A0 valid prefix, then space)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([240, 144, 128])))))
  // 3  (truncated 4-byte)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([237, 160, 128])))))
  // 9  (surrogate → 3× FFFD)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([192, 128])))))
  // 6  (overlong → 2× FFFD)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([244, 144, 128, 128])))))
  // 12 (> U+10FFFF → 4× FFFD)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([226, 130])))))
  // 3  (truncated 3-byte)
  println(int.to_string(string.len(bytes.to_string_lossy(bytes.from_list([128, 128, 128])))))
  // 9  (lone continuations)
  // Mixed valid + invalid in one input (exact byte dump via to_bytes length).
  // Σ(2) + FFFD(3) + A(1) = 6
  println(int.to_string(list.len(bytes.to_list(bytes.from_string(bytes.to_string_lossy(bytes.from_list([206, 163, 255, 65])))))))
}
