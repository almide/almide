// @contract: C-004
// fan.map / fan.settle DETERMINISTIC contract (native == wasm), plus the `??`
// chain that spells first-Ok-in-source-order (`fan.any` was removed in dialect
// epoch 14, ADR-0028). All cases succeed (exit 0). (The thunk-list fan.race was
// REMOVED in 0.42.0 — under the deterministic model it was exactly thunks[0]();
// the deterministic head is `fan.min(clock) { }`, C-205.) LIST ORDER (no longer
// wall-clock), so it joins the gate; fan.timeout was removed outright (a wall-clock
// effect with no portable meaning, C-006). The error paths (element-Err, all-fail)
// live in fan_map_err.almd / fan_any_allfail.almd.
effect fn dbl(x: Int) -> Result[Int, String] = ok(x * 2)

effect fn label(x: Int) -> Result[String, String] = ok("n" + int.to_string(x))

effect fn ok_n(x: Int) -> Result[Int, String] = ok(x)

effect fn fail_n(m: String) -> Result[Int, String] = err(m)

effect fn main() -> Unit = {
  // fan.map: maps in list order, auto-unwraps + auto-? in effect context.
  let doubled = fan.map([1, 2, 3, 4], (x) => dbl(x))!
  println(int.to_string(list.len(doubled)) + ":" + int.to_string(doubled[0]) + "," + int.to_string(doubled[1]) + "," + int.to_string(doubled[2]) + "," + int.to_string(doubled[3]))
  // fan.map preserves element order (String payloads, captured offset).
  let off = 10
  let labels = fan.map([off + 1, off + 2], (x) => label(x))!
  println(labels[0] + "|" + labels[1])
  // fan.map over an empty list.
  let empty = fan.map([], (x: Int) => dbl(x))!
  println("empty=" + int.to_string(list.len(empty)))
  // `??` chain: the FIRST Ok in source order wins (deterministic, NOT wall-clock).
  let first = fail_n("skip") ?? ok_n(7) ?? ok_n(99) ?? -1
  println("any=" + int.to_string(first))
  // fan.settle: a TUPLE of per-arm Results in arm order (T2-4);
  // ok/err payloads preserved.
  let (s1, s2, s3) = fan.settle {
    ok_n(1)
    fail_n("bad")
    ok_n(3)
  }
  println("settle=${s1} ${s2} ${s3}")
}
