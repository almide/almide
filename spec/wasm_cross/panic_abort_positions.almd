// @contract: C-219
// #3118: `panic(msg)` aborts through ONE defined path in every position —
// `PANIC: <msg>` on stderr, no trailing newline, exit 1 — on native, wasm and
// the interp. Native lowered `panic` to Rust's unwinding `panic!` (exit 101
// plus the thread banner) wherever the verified native rung did not take the
// program, and an effect fn whose tail was a `panic` did not compile natively
// (`Ok::<(), String>(panic)`, E0308). Positions: fn tail (pure and effect),
// lambda body, loop body (pure `while`, effect `for`), value position. Each
// runs untaken first; the last line takes the loop-body abort. The guard else
// block and match-arm positions are pinned in tests/panic_abort_positions_test.rs
// (the MIR rung walls them).
fn tail_pure(n: Int) -> Int = if n > 0 then n else panic("tail_pure ${n}")

effect fn tail_effect(n: Int) -> Int = {
  println("tail_effect ${n}")
  if n > 0 then n else panic("tail_effect ${n}")
}

fn lambda_pure(xs: List[Int]) -> List[Int] = xs |> list.map((x) => if x >= 0 then x * 2 else panic("lambda_pure ${x}"))

fn loop_pure(m: Int) -> Int = {
  var i = 0
  var s = 0
  while i < 10 {
    i = i + 1
    if i == m then panic("loop_pure ${i}") else ()
    s = s + i
  }
  s
}

effect fn loop_effect(m: Int) -> Int = {
  var s = 0
  for i in 0..<10 {
    println("loop_effect ${i}")
    if i == m then panic("loop_effect ${i}") else ()
    s = s + i
  }
  s
}

fn value_pure(n: Int) -> String = {
  let label = if n < 0 then panic("value_pure ${n}") else "n=${n}"
  label + "!"
}

effect fn main() -> Unit = {
  println("${tail_pure(1)} ${tail_effect(2)!} ${list.len(lambda_pure([1, 2]))}")
  println("${loop_pure(99)} ${loop_effect(99)!} ${value_pure(5)}")
  println("${loop_pure(4)}")
  println("unreachable")
}
