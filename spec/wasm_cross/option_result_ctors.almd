// @contract: C-237
// ALS-E9 (docs/specs/als/expressions.md): the Option/Result constructor
// literals — `some(e)` and the BARE value `none` (calling `none()` is a
// check-time E001), `ok(e)` / `err(e)` under a Result-typed expectation
// (an un-annotated binding is E041, ADR-0008 — pinned by
// tests/ctor_diag_test.rs), `??` elimination, and the
// NESTED case: `some(none)` / `some(some(5))` eliminated through an
// Option-typed default (#1270 — the v1 renderer now rewrites the bind to
// `match e { some(p) => p, none => d }`), and the RECORD-payload case:
// `list.get(xs, i) ?? { … }` over Option[record] (#1287 — the synthesized
// match's merge now seeds the record's read shape, so a String field read
// is the precise slot borrow, not the container-grain header read that
// printed blanks on wasm). Identical on both targets.
type P = { name: String, n: Int }

fn count_items(xs: List[Int]) -> Int = list.len(xs)

fn scalar_temp(take: Bool) -> Int? =
  if take then some(count_items(bytes.to_list(bytes.from_list([1, 2, 3])))) else none

fn join_items(xs: List[String]) -> String = list.join(xs, ",")

fn heap_temp(take: Bool) -> String? =
  if take then some(join_items(["a", "b"])) else none

fn nested_tuple(take: Bool, p: (Int, String)) -> (Int, (Int, String), (Int, String))? =
  if take then some((7, p, (9, "tail"))) else none

effect fn main() -> Unit = {
  let s = some(5)
  let n: Int? = none
  println(int.to_string(s ?? 0))
  println(int.to_string(n ?? -1))
  let o: Result[Int, String] = ok(3)
  let e: Result[Int, String] = err("boom")
  println(int.to_string(o ?? 0))
  println(int.to_string(e ?? -9))
  let sn = some(none)
  let inner: Int? = sn ?? none
  println(int.to_string(inner ?? 9))
  let sv = some(some(5))
  let iv: Int? = sv ?? none
  println(int.to_string(iv ?? 9))
  let xs: List[P] = [
    { name: "x", n: 7 }
  ]
  let hit = list.get(xs, 0) ?? { name: "d", n: -1 }
  println(hit.name)
  println(int.to_string(hit.n))
  let ys: List[P] = []
  let miss = list.get(ys, 0) ?? { name: "d", n: -1 }
  println(miss.name)
  println(int.to_string(miss.n))
  // A constructor arm releases its payload call's temporary heap arguments.
  // Both scalar and heap payloads must keep the returned value alive.
  println(int.to_string(scalar_temp(true) ?? -1))
  println(int.to_string(scalar_temp(false) ?? -1))
  println(heap_temp(true) ?? "missing")
  println(heap_temp(false) ?? "missing")
  let source = (3, "keep")
  let nested = nested_tuple(true, source) ?? (0, (0, ""), (0, ""))
  println("${nested.0}:${(nested.1).1}:${(nested.2).1}/${source.1}")
  println(if option.is_none(nested_tuple(false, source)) then "none" else "wrong")
  // Heap.pop constructs nested tuple Options and calls a specialized
  // module-local forwarding helper. Retain an alias across the mutations.
  var queue: Heap[(Int, String)] = heap.new_by((entry) => entry.0)
  heap.push(queue, (2, "two"))
  heap.push(queue, (1, "first"))
  heap.push(queue, (1, "second"))
  let saved = queue
  for _ in 0..<3 {
    let entry = heap.pop(queue) ?? (0, "missing")
    println(entry.1)
  }
  let first = heap.peek(saved) ?? (0, "missing")
  println(first.1)
  println(if option.is_none(heap.pop(queue)) then "empty" else "wrong")
}
