// @contract: C-292
// Unzip a list of pairs through a recursive accumulator (each step rebuilds
// both accumulators), then the rotate that moves a head from one list to the
// other in a pair-of-lists carrier — the canonical reuse shapes.
type P2 = | Pair2(List[Int], List[Int])

fn unzip_iter(ys: List[(Int, Int)], acc1: List[Int], acc2: List[Int]) -> P2 = match ys {
  [] => Pair2(acc1, acc2),
  [(x, y), ..rest] => unzip_iter(rest, acc1 + [x], acc2 + [y]),
}

fn rotate(p: P2) -> P2 = match p {
  Pair2(ys, acc) => match ys {
    [] => Pair2([], []),
    [h, ..t] => Pair2(t, [h] + acc),
  }
}

fn show_ints(xs: List[Int]) -> String = xs |> list.map((v) => int.to_string(v)) |> list.join(",")

fn show(p: P2) -> String = match p {
  Pair2(a, b) => "(${show_ints(a)})(${show_ints(b)})"
}

fn main() -> Unit = {
  let zipped = [(1, 10), (2, 20), (3, 30)]
  println(show(unzip_iter(zipped, [], [])))
  var p = Pair2([7, 8, 9], [])
  p = rotate(p)
  p = rotate(p)
  println(show(p))
  println(show(rotate(Pair2([], [1]))))
}
