// @contract: C-281
// The two shapes the kernel-conformance corpus caught on its first run
// (edit-locality Stage 3), fixed and pinned:
// - almide#1428: a bare `err(..)` match subject — the checker defaults the
//   unconstrained ok payload to Unit; codegen now carries the resolved type
//   as an `Err::<(), String>` turbofish instead of emitting invalid Rust
//   (E0282). The err arm runs, per the kernel semantics.
// - almide#1429: an effect fn whose tail is the bare parameter
//   (`effect fn ident(x: Int) -> Int = x`) — the v1 native renderer carried
//   the ok-lift as a ret-VALUE retype, which corrupted the shared
//   param/return ValueId's rendered type; the lift is now a return-type
//   override. The call reifies `ok(x)` at the boundary.
effect fn ident(x: Int) -> Int = x

effect fn traced(x: Int) -> Int = {
  println("callee")
  x
}

effect fn main() -> Unit = {
  match err("boom") {
    ok(_v) => println("no"),
    err(_e) => println("bare-err-arm"),
  }
  match ident(6) {
    ok(_v) => println("ident-ok"),
    err(_e) => println("ident-err"),
  }
  match traced(1) {
    ok(_v) => println("traced-ok"),
    err(_e) => println("traced-err"),
  }
}
