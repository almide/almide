// @contract: C-054
// The last four cells of the integer-domain sweep, and unlike every other family in it
// these produced no abort at all — just two different answers, exit 0 on both legs.
//
// THREE OF THEM ARE ONE MISTAKE: an UNSIGNED step in the middle of a signed computation
// on the native leg, where the self-host had always been i64 throughout.
//
//   datetime.from_parts  cast the month `as u64`, so month -1 became 18446744073709551615
//                        and `153 * (m - 3)` wrapped: 1540840320 here, 1572566400 there.
//   math.choose          accumulated in u64: choose(i64::MAX, 2) was 4611686018427387905
//                        on one leg and -4611686018427387903 on the other. Neither is a
//                        binomial coefficient — the requirement is that they be the same
//                        non-answer, so the accumulation is now i64 and explicitly
//                        wrapping, like Almide's Int.
//   string.from_codepoint cast `cp as u32` BEFORE `char::from_u32`, so 2^32 — which is not
//                        a codepoint — truncated to 0, which is. One leg answered a
//                        one-byte NUL string, the other "". The `unwrap_or_default` was
//                        already the right intent; the cast in front of it was converting
//                        invalid input into valid input.
//
// THE FOURTH IS THE REVERSE SHAPE. `datetime.to_iso`'s self-host wrote a fixed 20-byte
// buffer with a 4-digit year, and its own header declared `SCOPE: {:04} matches v0 for
// years 0..9999`. Outside that scope it did not fail — it wrote garbage:
//
//   to_iso(i64::MAX)   native 292277026596-12-04T15:30:07Z   wasm 6596-12-04T15:30:07Z
//   to_iso(i64::MIN)   native -292277022657-01-28T08:29:52Z  wasm  .*+)-01-28T08:29:52Z
//
// The second row is the serious one: `48 + digit` with a NEGATIVE digit is not an ASCII
// character, so the wasm leg produced a String containing non-UTF-8 bytes, silently, exit
// 0. The year field is now variable width exactly as Rust's `{:04}` is — four columns
// minimum, zero-padded, the sign occupying one of them.
//
// A documented scope that produces a malformed value outside itself is not a scope.
import datetime

fn main() -> Unit = {
  // to_iso across the whole i64 range, plus year 1 to pin the zero-padding.
  println("iso_epoch=" + datetime.to_iso(0))
  println("iso_y1=" + datetime.to_iso(0 - 62135596800))
  println("iso_max=" + datetime.to_iso(9223372036854775807))
  println("iso_min=" + datetime.to_iso(0 - 9223372036854775807 - 1))
  // from_parts: the valid months must be untouched by the signedness change.
  println("fp_jan=" + int.to_string(datetime.from_parts(2020, 1, 1, 0, 0, 0)))
  println("fp_dec=" + int.to_string(datetime.from_parts(2020, 12, 1, 0, 0, 0)))
  println("fp_neg=" + int.to_string(datetime.from_parts(2020, 0 - 1, 1, 0, 0, 0)))
  println("fp_min=" + int.to_string(datetime.from_parts(2020, 0 - 9223372036854775807 - 1, 1, 0, 0, 0)))
  // choose: the real answer, then the two wrapping ones.
  println("ch_5=" + int.to_string(math.choose(5, 2)))
  println("ch_max=" + int.to_string(math.choose(9223372036854775807, 2)))
  println("ch_2p32=" + int.to_string(math.choose(4294967296, 2)))
  // from_codepoint: valid, the surrogate hole, the last codepoint, and past it.
  println("cp_a=[" + string.from_codepoint(65) + "]")
  println("cp_jp=[" + string.from_codepoint(12354) + "]")
  println("cp_surrogate=[" + string.from_codepoint(55296) + "]")
  println("cp_last=" + int.to_string(string.len(string.from_codepoint(1114111))))
  println("cp_past=[" + string.from_codepoint(1114112) + "]")
  println("cp_2p32=[" + string.from_codepoint(4294967296) + "]")
  println("cp_min=[" + string.from_codepoint(0 - 9223372036854775807 - 1) + "]")
}
