// @contract: C-234
// ALS-E6 (docs/specs/als/expressions.md), the disambiguation ruling: `(e)`
// is grouping, `(e,)` is a 1-tuple — the trailing comma is load-bearing
// (fmt round-trips it since #1265). No string interpolation in this file:
// its presence scalarizes the native 1-tuple repr and breaks `.0` (#1267).
effect fn main() -> Unit = {
  let t = (5,)
  println(int.to_string(t.0))
  let g = (5)
  println(int.to_string(g + 1))
}
