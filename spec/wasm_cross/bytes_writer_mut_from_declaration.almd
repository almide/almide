// @contract: C-033, C-319
// Every bytes writer the stdlib declares with a `mut` param is a WRITE on both
// legs, whichever implementation the wasm leg links for it. Two wasm decisions
// used to come from somewhere other than the declaration:
//  - #2949: a registry-linked call took its `mut` params from the linked
//    implementation, whose params carry none (`bytes_set_u16_le(b: Bytes, ..)`
//    behind `put_u16_le(mut b: Bytes, ..)`). No copy-on-write was done, so an
//    alias taken before the write saw it (wasm printed 2 where native printed 0).
//  - #2951: which captured vars need a shared closure cell came from a hand list
//    of six bytes writers. A closure writing through any other one (`put_u8`,
//    `put_u16_le`, `append_u8`, `copy_within`, ..) wrote a copy, and the write
//    was lost (wasm printed 0 where native printed 7).
// Both now read the declaration's `mut` positions. Byte-identical native == wasm.
import bytes

fn show(label: String, b: Bytes) -> Unit = println(label + " " + int.to_string(bytes.len(b)) + " " + int.to_string(bytes.get(b, 0) ?? 0) + " " + int.to_string(bytes.get(b, 1) ?? 0))

effect fn main() -> Unit = {
  // An alias taken before a typed write keeps the old contents.
  var a = bytes.zeros(8)
  let a0 = a
  bytes.put_u16_le(a, 0, 258)
  show("put_u16_le alias", a0)
  show("put_u16_le own", a)
  let a1 = a
  bytes.put_u32_be(a, 0, 772)
  show("put_u32_be alias", a1)
  show("put_u32_be own", a)
  let a2 = a
  bytes.put_i32_le(a, 0, 5)
  show("put_i32_le alias", a2)
  show("put_i32_le own", a)
  let a3 = a
  bytes.append_u16_le(a, 513)
  show("append_u16_le alias", a3)
  show("append_u16_le own", a)
  // A write inside a closure lands in the captured var.
  var c = bytes.zeros(4)
  let set8 = () => bytes.put_u8(c, 0, 7)
  set8()
  show("put_u8 closure", c)
  let set16 = () => bytes.put_u16_le(c, 0, 1027)
  set16()
  show("put_u16_le closure", c)
  let app = () => bytes.append_u8(c, 9)
  app()
  show("append_u8 closure", c)
  let wr = () => bytes.push(c, 11)
  wr()
  show("push closure", c)
  let cw = () => bytes.copy_within(c, 0, 1, 1)
  cw()
  show("copy_within closure", c)
}
