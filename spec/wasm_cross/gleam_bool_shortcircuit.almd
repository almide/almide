// gleam test/language/bool_negation_test.gleam: not-tables, parenthesised
// negation, and the SHORT-CIRCUIT proofs — gleam guards the RHS with
// `panic`; here the crasher is a division by a fn-produced zero, so if the
// dead side ever evaluates the program aborts instead of printing.
fn zero() -> Int = 0

fn main() -> Unit = {
  println(if not true then "T" else "F")
  println(if not false then "T" else "F")
  // `false and <crash>` must not evaluate the crash
  let guard1 = not true
  println(if guard1 and (1 / zero() == 1) then "boom" else "safe-and")
  // `true or <crash>` must not evaluate the crash
  let guard2 = not false
  println(if guard2 or (1 / zero() == 1) then "safe-or" else "boom")
  // parenthesised negation
  let b = not (true or false)
  println(if not b then "T" else "F")
}
