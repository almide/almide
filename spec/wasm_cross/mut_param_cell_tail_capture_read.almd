// @contract: C-132, C-319
// #3192: a `mut` param a closure READS (the whole param, or one field) and the
// fn writes is rebound onto the #3154 write-back cell on native. A tail that
// reads the param — a call taking it by `mut` or by value, a `!`-propagated
// call, a `match` / `if` whose arms call with it, nested blocks, a loop, a
// `guard` exit before the tail — left the call's `RefMut` temporary alive past
// the cell (rustc E0597). The caller sees the final value on every exit, the
// `!` error exit included. Byte-identical native == wasm == interp.
type S = { n: Int, xs: List[Int] }

fn bump(mut s: S, k: Int) -> Unit = {
  s.n = s.n + k
}

fn bumpv(mut s: S, k: Int) -> Int = {
  s.n = s.n + k
  s.n
}

fn weigh(s: S) -> Int = s.n * 100 + list.len(s.xs)

effect fn bump_e(mut s: S, k: Int) -> Unit = {
  s.n = s.n + k
  guard k < 100 else err("big ${int.to_string(k)}")
}

// whole-param capture: the closure reads `s` itself
fn wc_mutcall(mut s: S) -> Unit = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  bump(s, 1)
}

fn wc_mutcall_v(mut s: S) -> Int = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  bumpv(s, 1)
}

fn wc_byval(mut s: S) -> Int = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  weigh(s)
}

effect fn wc_bang(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  bump_e(s, k)!
}

fn wc_match(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  match k {
    0 => bump(s, 1),
    _ => bump(s, k),
  }
}

fn wc_if(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  if k > 2 then bumpv(s, 3) else bumpv(s, 4)
}

fn wc_nested(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  {
    let t = k + 1
    { bump(s, t) }
  }
}

fn wc_loop(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  for i in 0..<k {
    bump(s, i)
  }
}

fn wc_loop_then(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  for i in 0..<k {
    bump(s, i)
  }
  bumpv(s, 10)
}

fn wc_early(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + weigh(s))
  s.xs = ys
  guard k < 5 else bumpv(s, 100)
  bump(s, 1)
  bumpv(s, 2)
}

// field capture: the closure reads `s.n`
fn fc_mutcall(mut s: S) -> Unit = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  bump(s, 1)
}

fn fc_mutcall_v(mut s: S) -> Int = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  bumpv(s, 1)
}

fn fc_byval(mut s: S) -> Int = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  weigh(s)
}

effect fn fc_bang(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  bump_e(s, k)!
}

fn fc_match(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  match k {
    0 => bump(s, 1),
    _ => bump(s, k),
  }
}

fn fc_if(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  if k > 2 then bumpv(s, 3) else bumpv(s, 4)
}

fn fc_nested(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  {
    let t = k + 1
    { bump(s, t) }
  }
}

fn fc_loop(mut s: S, k: Int) -> Unit = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  for i in 0..<k {
    bump(s, i)
  }
}

fn fc_loop_then(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  for i in 0..<k {
    bump(s, i)
  }
  bumpv(s, 10)
}

fn fc_early(mut s: S, k: Int) -> Int = {
  let ys = s.xs |> list.map((x) => x + s.n)
  s.xs = ys
  guard k < 5 else bumpv(s, 100)
  bump(s, 1)
  bumpv(s, 2)
}

fn show(tag: String, s: S) -> Unit = println("${tag} n=${int.to_string(s.n)} xs=${s.xs |> list.map((x) => int.to_string(x)) |> list.join(",")}")

fn fresh() -> S = S { n: 1, xs: [1, 2] }

effect fn main() -> Unit = {
  var a = fresh()
  wc_mutcall(a)
  show("wc_mutcall", a)
  var b = fresh()
  let bv = wc_mutcall_v(b)
  show("wc_mutcall_v ${int.to_string(bv)}", b)
  var c = fresh()
  let cv = wc_byval(c)
  show("wc_byval ${int.to_string(cv)}", c)
  var d = fresh()
  wc_bang(d, 5)!
  show("wc_bang ok", d)
  var e = fresh()
  let eo = match wc_bang(e, 500) {
    ok(_) => "ok",
    err(m) => "err ${m}",
  }
  show("wc_bang ${eo}", e)
  var f = fresh()
  wc_match(f, 0)
  wc_match(f, 7)
  show("wc_match", f)
  var g = fresh()
  let gv = wc_if(g, 1) + wc_if(g, 9)
  show("wc_if ${int.to_string(gv)}", g)
  var h = fresh()
  wc_nested(h, 4)
  show("wc_nested", h)
  var i = fresh()
  wc_loop(i, 4)
  show("wc_loop", i)
  var j = fresh()
  let jv = wc_loop_then(j, 3)
  show("wc_loop_then ${int.to_string(jv)}", j)
  var k = fresh()
  let kv = wc_early(k, 2) + wc_early(k, 9)
  show("wc_early ${int.to_string(kv)}", k)
  var a2 = fresh()
  fc_mutcall(a2)
  show("fc_mutcall", a2)
  var b2 = fresh()
  let bv2 = fc_mutcall_v(b2)
  show("fc_mutcall_v ${int.to_string(bv2)}", b2)
  var c2 = fresh()
  let cv2 = fc_byval(c2)
  show("fc_byval ${int.to_string(cv2)}", c2)
  var d2 = fresh()
  fc_bang(d2, 5)!
  show("fc_bang ok", d2)
  var e2 = fresh()
  let eo2 = match fc_bang(e2, 500) {
    ok(_) => "ok",
    err(m) => "err ${m}",
  }
  show("fc_bang ${eo2}", e2)
  var f2 = fresh()
  fc_match(f2, 0)
  fc_match(f2, 7)
  show("fc_match", f2)
  var g2 = fresh()
  let gv2 = fc_if(g2, 1) + fc_if(g2, 9)
  show("fc_if ${int.to_string(gv2)}", g2)
  var h2 = fresh()
  fc_nested(h2, 4)
  show("fc_nested", h2)
  var i2 = fresh()
  fc_loop(i2, 4)
  show("fc_loop", i2)
  var j2 = fresh()
  let jv2 = fc_loop_then(j2, 3)
  show("fc_loop_then ${int.to_string(jv2)}", j2)
  var k2 = fresh()
  let kv2 = fc_early(k2, 2) + fc_early(k2, 9)
  show("fc_early ${int.to_string(kv2)}", k2)
}
