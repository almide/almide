// @contract: C-293
// A recursive variant whose payload is a List of itself — the archetypal
// nested-ownership shape: build a tree, fold sum and depth, then drop it
// whole by shadowing.
type Tree = | Leaf(Int) | Branch(List[Tree])

type Binary = | Empty | Fork(Binary, Int, Binary) | Hop(Binary)

// A recursive call at an inner arm's end still has the outer addition to
// perform. Keep the caller's tree live across several such borrowed reads.
fn branch_depth(t: Binary) -> Int = match t {
  Empty => 0,
  Hop(next) => branch_depth(next),
  Fork(l, _, r) => 1 + (if branch_depth(l) > branch_depth(r)
    then branch_depth(l) else branch_depth(r)),
}

fn regrow(t: Binary) -> Binary = match t {
  Empty => Empty,
  Hop(next) => next,
  Fork(l, v, _) => Fork(l, v + branch_depth(l), Empty),
}

fn sum(t: Tree) -> Int = match t {
  Leaf(n) => n,
  Branch(kids) => list.fold(kids, 0, (a, k) => a + sum(k)),
}

fn depth(t: Tree) -> Int = match t {
  Leaf(_) => 1,
  Branch(kids) => 1 + list.fold(
    kids,
    0,
    (a, k) => {
      let d = depth(k)
      if d > a then d else a
    },
  ),
}

fn main() -> Unit = {
  let t = Branch([
    Leaf(1),
    Branch([Leaf(2), Leaf(3)]),
    Branch([
      Branch([Leaf(4)]),
      Leaf(5)
    ])
  ])
  println(int.to_string(sum(t)))
  println(int.to_string(depth(t)))
  let flat = Branch([Leaf(10), Leaf(20)])
  println(int.to_string(sum(flat)))
  println(int.to_string(depth(Leaf(9))))
  var held = t
  held = Leaf(0)
  println(int.to_string(sum(held)))
  let binary = Fork(Fork(Empty, 5, Empty), 7, Fork(Empty, 9, Empty))
  println("${branch_depth(binary)} ${branch_depth(regrow(binary))} ${branch_depth(binary)}")
  println("${regrow(binary) == Fork(Fork(Empty, 5, Empty), 8, Empty)}")
  println("${branch_depth(Hop(Hop(binary)))} ${branch_depth(binary)}")
}
