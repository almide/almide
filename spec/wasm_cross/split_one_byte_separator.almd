// @contract: C-074
// #4612: `string.split` with a separator that is one byte at compile time
// runs a byte-compare kernel on the structural wasm leg instead of the KMP
// search. The pieces are the general split's: empty pieces at either end and
// between adjacent separators are kept, the empty string is one empty piece,
// multibyte characters never match a one-byte separator, and a large input
// (5000+ segments) is split iteratively. Every split here has a one-byte
// literal separator: a program with any other separator ships the search
// kernel anyway and routes these through it too.
fn show(parts: List[String]) -> String = "${list.len(parts)}:[${parts |> list.join("|")}]"

fn main() -> Unit = {
  println(show(string.split("a,b,c", ",")))
  println(show(string.split(",a,,b,", ",")))
  println(show(string.split("", ",")))
  println(show(string.split(",", ",")))
  println(show(string.split("no separator here", ",")))
  println(show(string.split("é,ü,→,", ",")))
  println(show(string.split("line one\nline two\n", "\n")))
  println(show(string.split("item-7, value 49 ,  tag7  ,x", ",")))
  let big = string.split(string.repeat("ab,", 6000), ",")
  println("${list.len(big)} ${big |> list.first ?? "none"} ${big |> list.last ?? "none"}")
}
