// @contract: C-117
// #2948: a user fn whose name a stdlib mutator also has keeps its OWN `mut`
// positions when branch_lift asks which args a call writes. `insert(tag, mut m)`
// writes its second argument; the bundled `map.insert(mut m, ..)` writes its
// first. The native leg lowers the bundled `map` module into the IR, and the
// lift's table keyed module fns under their bare name over the user's, so it
// read position 0, saw no write to `m`, outlined the branch into a helper that
// took `m` by value, and the insert was lost (native printed 0, wasm 1). The
// lookup now resolves a bare call in its own scope, and reads a stdlib fn's
// positions from its declaration on both legs. Byte-identical native == wasm.
fn insert(tag: String, mut m: Map[String, Int]) -> Unit = {
  map.insert(m, tag, 1)
}

fn push(label: String, mut xs: List[String]) -> Unit = {
  list.push(xs, label)
}

effect fn main() -> Unit = {
  var m: Map[String, Int] = map.new()
  var xs: List[String] = []
  for i in [1, 2, 3] {
    let s: String = if i == 1 then {
      insert("a", m)
      "inserted"
    } else "kept"
    let t: String = if i == 2 then {
      push("b", xs)
      "pushed"
    } else "kept"
    println(s + " " + t)
  }
  println(int.to_string(map.len(m)))
  println(int.to_string(list.len(xs)))
}
