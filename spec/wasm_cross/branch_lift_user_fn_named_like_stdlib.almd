// @contract: C-117
// #2948: a user fn whose name a stdlib mutator also has keeps its OWN `mut`
// positions when branch_lift asks which args a call writes. `insert(tag, mut m)`
// writes its second argument; the bundled `map.insert(mut m, ..)` writes its
// first. The lift's table was built from whatever modules a leg had lowered and
// keyed module fns under their bare name over the user's, so which positions a
// call got depended on the leg: with the loop in `main`, native (which lowers
// the bundled `map`) read position 0, outlined the branch into a helper that
// took `m` by value and lost the insert (native 0, wasm 1); with the loop in its
// own fn, as here, develop printed 1 on native and 0 on wasm. The lookup now
// resolves a bare call in its own scope and reads a stdlib fn's positions from
// its declaration on both legs. Byte-identical native == wasm.
fn insert(tag: String, mut m: Map[String, Int]) -> Unit = {
  map.insert(m, tag, 1)
}

fn push(label: String, mut xs: List[String]) -> Unit = {
  list.push(xs, label)
}

// The arm-writing loop lives in its own fn, so the incumbent's honest wall on
// this shape (a let-bound heap `if` it cannot lower once the lift declines)
// names exactly that fn in proofs/walled-real-baseline.txt.
fn arm_writes(mut m: Map[String, Int], mut xs: List[String]) -> Unit = {
  for i in [1, 2, 3] {
    let s: String = if i == 1 then {
      insert("a", m)
      "inserted"
    } else "kept"
    let t: String = if i == 2 then {
      push("b", xs)
      "pushed"
    } else "kept"
    println(s + " " + t)
  }
}

effect fn main() -> Unit = {
  var m: Map[String, Int] = map.new()
  var xs: List[String] = []
  arm_writes(m, xs)
  println(int.to_string(map.len(m)))
  println(int.to_string(list.len(xs)))
}
