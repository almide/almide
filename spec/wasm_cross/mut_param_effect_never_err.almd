// @contract: C-132
// #1575: a NEVER-ERR effect fn's mono instance with a `mut` param takes the
// same C-132 move-mode tuple rewrite as its plain-fn twin — the effect marker
// changes the return channel, not the parameter convention. (A non-Unit
// effect fn that CAN err keeps the honest exclusion wall: the err arm's
// buffer semantics are #1576's unratified design question.) Both spellings
// below are the same program modulo the marker; both must print the same
// values on native, wasm, and the interp. The caller-side trap this pins
// against: the `!`-wrapped call NODE carries the lifted Result carrier, and
// typing the destructured (result, buffer) tuple from it read the scalar
// half as a heap handle (invalid wasm, i64/i32 mismatch).
protocol Counter {
  fn bump(mut self: Self, by: Int) -> Unit
  fn read(self) -> Int
}

type Tally: Counter = { n: Int }

fn Tally.bump(mut self: Tally, by: Int) -> Unit = { self.n = self.n + by }

fn Tally.read(self) -> Int = self.n

effect fn go_effect[C: Counter](mut c: C) -> Int = {
  c.bump(2)
  c.bump(3)
  c.read()
}

fn go_plain[C: Counter](mut c: C) -> Int = {
  c.bump(2)
  c.bump(3)
  c.read()
}

effect fn main() -> Unit = {
  var t = Tally { n: 1 }
  let a = go_effect(t)!
  println("${a}")
  // 6 — and the writeback is visible in the caller:
  println("${t.n}")
  // 6
  var u = Tally { n: 1 }
  let b = go_plain(u)
  println("${b}")
  // 6
  println("${u.n}")
  // 6
}
