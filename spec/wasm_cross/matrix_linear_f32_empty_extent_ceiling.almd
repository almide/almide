// @contract: C-161
// The empty-extent edge of the f32 linear kernel was `zeros(rows(x), w_rows)`,
// so its shape took the shared 2^28 element ceiling like every constructor.
// Native built that zero matrix without the ceiling: `w_rows = 2^27 + 1`
// (2^28 + 2 elements) succeeded and printed a shape, and `w_rows = i64::MAX`
// took a raw `capacity overflow` panic (exit 101), where wasm aborts with
// `Error: matrix dimensions too large` + exit 1 (#2783, nightly fuzz #2781).
// The kernel left the stdlib for module nn.kernels of package almide-graphics/nn (dialect epoch 15); the
// cells now pin the `matrix.zeros` shape it delegated to. The guard fires
// before either allocator is asked for anything, so the over-ceiling cell
// costs no memory. The in-range and clamped cells come first; the fixture
// ends at the abort.
fn show(m: Matrix) -> String = {
  let (r, c) = matrix.shape(m)
  int.to_string(r) + " x " + int.to_string(c)
}

fn main() -> Unit = {
  // No rows: zero elements at any width, so a huge width is not over the ceiling.
  println("empty_x_max=" + show(matrix.zeros(0, 9223372036854775807)))
  // A negative width clamps to 0 (C-161).
  println("neg_rows=" + show(matrix.zeros(2, 0 - 9223372036854775807)))
  println("zero_cols=" + show(matrix.zeros(2, 1)))
  // 2 x (2^27 + 1) is just over the 2^28 ceiling.
  println("over=" + show(matrix.zeros(2, 134217729)))
  println("unreachable")
}
