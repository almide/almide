// @contract: C-177
// Two-phase rebuild of a mutable-global record list, reads in ARG position
// (`bump(items[i], d)` — the wasm_cross_pkg tick shape): the projection
// hoist must treat a LOOP as a boundary — hoisting the mg read before the
// loop froze one stale handle for every iteration, so the second tick read
// pre-reassign values (native 110.0, wasm 100.0 + garbage: silent wrong
// value class).
type Rec = { a: Float, b: Float }

var items: List[Rec] = []
var count = 0

fn bump(r: Rec, d: Float) -> Rec = { a: r.a + d, b: r.b }

fn init() -> Unit = {
  count = 3
  items = []
  for i in 0..count {
    items = items + [{ a: int.to_float(i), b: int.to_float(i) * 2.0 }]
  }
}

fn tick_a(d: Float) -> Unit = {
  var out: List[Rec] = []
  for i in 0..count {
    out = out + [bump(items[i], d)]
  }
  items = out
}

fn tick_b(d: Float) -> Unit = {
  var out: List[Rec] = []
  for i in 0..count {
    out = out + [bump(items[i], d)]
  }
  items = out
}

fn main() -> Unit = {
  init()
  tick_a(10.0)
  tick_b(100.0)
  println(float.to_string(items[0].a) + " " + float.to_string(items[2].b))
}
