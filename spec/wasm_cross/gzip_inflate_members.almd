fn sym_kind(sym: Int) -> Int = if sym < 0 then 0
else if sym < 256 then 1
else if sym == 256 then 2
else if sym - 257 >= 29 then 0 else 3

fn len_kind(sym: Int) -> Int = if sym < 0 then 0
else if sym < 16 then 1
else if sym == 16 then 2
else if sym == 17 then 3 else 4

// (status, pos, buf, cnt)
fn codes(pos: Int, buf: Int, cnt: Int, inp: Bytes, mut out: Bytes, lencode: List[Int], distcode: List[Int]) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  var status = 0
  var running = true
  while running {
    let (sym, p2, b2, c2) = decode(p, b, c, inp, lencode)
    p = p2
    b = b2
    c = c2
    let sk = sym_kind(sym)
    var clen = 0
    var dist = 1
    match int.band(sk, 3) {
      0 => {
        status = 0 - 1
        running = false
      },
      1 => { bytes.push(out, sym) },
      2 => {
        running = false
      },
      _ => {
        let li = sym - 257
        let (eb, p3, b3, c3) = bits(p, b, c, inp, lext[li])
        let (ds, p4, b4, c4) = decode(p3, b3, c3, inp, distcode)
        let dsc = if ds < 0 or ds >= 30 then 0 else ds
        let (db, p5, b5, c5) = bits(p4, b4, c4, inp, dext[dsc])
        p = p5
        b = b5
        c = c5
        let bad = if ds < 0 or ds >= 30 then 1 else 0
        status = 0 - bad
        running = bad == 0
        clen = if bad == 1 then 0 else lbase[li] + eb
        dist = dbase[dsc] + db
      },
    }
    var k = 0
    while k < clen {
      bytes.push(out, bytes.get_or(out, bytes.len(out) - dist, 0))
      k = k + 1
    }
  }
  (status, p, b, c)
}

fn fixed_lit() -> List[Int] = {
  var lengths = list.repeat(8, 288)
  var i = 144
  while i < 256 {
    lengths[i] = 9
    i = i + 1
  }
  i = 256
  while i < 280 {
    lengths[i] = 7
    i = i + 1
  }
  construct(lengths, 288)
}

// Read the HLIT+HDIST code lengths (with 16/17/18 repeats). Returns (status, pos, buf, cnt, lengths).
fn read_lengths(pos: Int, buf: Int, cnt: Int, inp: Bytes, lencode: List[Int], total: Int) -> (Int, Int, Int, Int, List[Int]) = {
  var p = pos
  var b = buf
  var c = cnt
  var lengths = list.repeat(0, 320)
  var i = 0
  var status = 0
  while i < total and status == 0 {
    let (sym, p2, b2, c2) = decode(p, b, c, inp, lencode)
    p = p2
    b = b2
    c = c2
    let lk = len_kind(sym)
    let need = if lk == 2 then 2
    else if lk == 3 then 3
    else if lk == 4 then 7 else 0
    let (extra, p3, b3, c3) = bits(p, b, c, inp, need)
    p = p3
    b = b3
    c = c3
    let val = if lk == 1 then sym
    else if lk == 2 and i > 0 then lengths[i - 1] else 0
    let rep0 = if lk == 1 then 1
    else if lk == 2 or lk == 3 then 3 + extra
    else if lk == 4 then 11 + extra else 0
    let bad = if lk == 0 or (lk == 2 and i == 0) or i + rep0 > total then 1 else 0
    status = 0 - bad
    var rep = if bad == 1 then 0 else rep0
    while rep > 0 {
      lengths[i] = val
      i = i + 1
      rep = rep - 1
    }
  }
  (status, p, b, c, if status != 0 then list.repeat(0, 320) else lengths)
}

// (status, pos, buf, cnt)
fn dynamic(pos: Int, buf: Int, cnt: Int, inp: Bytes, mut out: Bytes) -> (Int, Int, Int, Int) = {
  let order = [
    16,
    17,
    18,
    0,
    8,
    7,
    9,
    6,
    10,
    5,
    11,
    4,
    12,
    3,
    13,
    2,
    14,
    1,
    15
  ]
  let (nlit, p1, b1, c1) = bits(pos, buf, cnt, inp, 5)
  let (ndist, p2, b2, c2) = bits(p1, b1, c1, inp, 5)
  let (ncode, p3, b3, c3) = bits(p2, b2, c2, inp, 4)
  let nlen = nlit + 257
  let ndis = ndist + 1
  var p = p3
  var b = b3
  var c = c3
  var cl = list.repeat(0, 19)
  var i = 0
  while i < ncode + 4 {
    let (v, p4, b4, c4) = bits(p, b, c, inp, 3)
    p = p4
    b = b4
    c = c4
    cl[order[i]] = v
    i = i + 1
  }
  let lencode = construct(cl, 19)
  let (status, p5, b5, c5, lengths) = read_lengths(p, b, c, inp, lencode, nlen + ndis)
  let (s2, p6, b6, c6) = codes(p5, b5, c5, inp, out, construct(lengths, nlen), construct(list.slice(lengths, nlen, nlen + ndis), ndis))
  (if status != 0 then status else s2, p6, b6, c6)
}

// (status, pos, 0, 0) — stored blocks are byte-aligned
fn stored(pos: Int, inp: Bytes, mut out: Bytes) -> (Int, Int, Int, Int) = {
  let len = int.bor(bytes.get_or(inp, pos, 0), int.bshl(bytes.get_or(inp, pos + 1, 0), 8))
  let nlen = int.bor(bytes.get_or(inp, pos + 2, 0), int.bshl(bytes.get_or(inp, pos + 3, 0), 8))
  let start = pos + 4
  let bad = if int.bxor(len, nlen) != 65535 or start + len > bytes.len(inp) then 1 else 0
  let n = if bad == 1 then 0 else len
  var k = 0
  while k < n {
    bytes.push(out, bytes.get_or(inp, start + k, 0))
    k = k + 1
  }
  (0 - bad, start + n, 0, 0)
}

// Inflate one DEFLATE stream starting at byte `pos`; returns (status, pos of the first byte after it).
fn inflate(pos: Int, inp: Bytes, mut out: Bytes) -> (Int, Int) = {
  let flit = fixed_lit()
  let fdist = construct(list.repeat(5, 30), 30)
  var p = pos
  var b = 0
  var c = 0
  var last = 0
  var status = 0
  while last == 0 and status == 0 {
    let (l, p1, b1, c1) = bits(p, b, c, inp, 1)
    let (kind, p2, b2, c2) = bits(p1, b1, c1, inp, 2)
    last = l
    let (s, p3, b3, c3) = match int.band(kind, 3) {
      0 => stored(p2, inp, out),
      1 => codes(p2, b2, c2, inp, out, flit, fdist),
      2 => dynamic(p2, b2, c2, inp, out),
      _ => (0 - 1, p2, b2, c2),
    }
    status = s
    p = p3
    b = b3
    c = c3
  }
  (status, p)
}

fn crc_table() -> List[Int] = {
  var t = list.repeat(0, 256)
  var n = 0
  while n < 256 {
    var cc = n
    var k = 0
    while k < 8 {
      cc = if int.band(cc, 1) == 1 then int.bxor(3988292384, int.bshr(cc, 1)) else int.bshr(cc, 1)
      k = k + 1
    }
    t[n] = cc
    n = n + 1
  }
  t
}

fn crc32(t: List[Int], b: Bytes, start: Int) -> Int = {
  var cc = 4294967295
  var i = start
  let n = bytes.len(b)
  while i < n {
    cc = int.bxor(t[int.band(int.bxor(cc, bytes.get_or(b, i, 0)), 255)], int.bshr(cc, 8))
    i = i + 1
  }
  int.bxor(cc, 4294967295)
}

fn u32_le(b: Bytes, p: Int) -> Int = int.bor(int.bor(bytes.get_or(b, p, 0), int.bshl(bytes.get_or(b, p + 1, 0), 8)), int.bor(int.bshl(bytes.get_or(b, p + 2, 0), 16), int.bshl(bytes.get_or(b, p + 3, 0), 24)))

fn skip_zstr(b: Bytes, p: Int) -> Int = if bytes.get_or(b, p, 0) == 0 then p + 1 else skip_zstr(b, p + 1)

// Position of the deflate stream after the gzip member header at `pos`, or -1 if not a gzip member.
fn header_end(inp: Bytes, pos: Int) -> Int = {
  if bytes.get_or(inp, pos, 0) != 31 or bytes.get_or(inp, pos + 1, 0) != 139 or bytes.get_or(inp, pos + 2, 0) != 8 then 0 - 1
  else {
    let flg = bytes.get_or(inp, pos + 3, 0)
    let p0 = pos + 10
    let p1 = if int.band(flg, 4) != 0 then p0 + 2 + int.bor(bytes.get_or(inp, p0, 0), int.bshl(bytes.get_or(inp, p0 + 1, 0), 8))
    else p0
    let p2 = if int.band(flg, 8) != 0 then skip_zstr(inp, p1) else p1
    let p3 = if int.band(flg, 16) != 0 then skip_zstr(inp, p2) else p2
    if int.band(flg, 2) != 0 then p3 + 2 else p3
  }
}

// gzip members back to back; returns 0 on success, else an error code (see error_text).
fn gunzip(inp: Bytes, mut out: Bytes) -> Int = {
  let t = crc_table()
  var pos = 0
  var code = 0
  while pos < bytes.len(inp) and code == 0 {
    let start = header_end(inp, pos)
    let member_start = bytes.len(out)
    let (status, after) = inflate(if start < 0 then pos else start, inp, out)
    let stored_crc = u32_le(inp, after)
    let isize = u32_le(inp, after + 4)
    pos = after + 8
    code = if start < 0 then 1
    else if status != 0 then 2
    else if crc32(t, out, member_start) != stored_crc then 3
    else if int.band(bytes.len(out) - member_start, 4294967295) != isize then 4 else 0
  }
  code
}

fn error_text(code: Int) -> String = if code == 1 then "not gzip"
else if code == 2 then "corrupt deflate stream"
else if code == 3 then "crc mismatch" else "size mismatch"

