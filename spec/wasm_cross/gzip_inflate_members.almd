// @contract: C-326
// The 322-line gzip inflate as a cross-target fixture (#1696 step 2): bit
// reader through tuple returns, fixed AND dynamic Huffman blocks, LZ77
// back-copy into a mut Bytes, CRC-32 + ISIZE verification, two members.
// `inflate` selects stored/fixed/dynamic per block through a value-position
// match whose arms call tuple-form mut fns — the phase-4 hoist moves the
// write-back out of the branch, so the STRUCTURAL leg lowers the whole
// program (before the hoist it refused here, and before the #1688 wall it
// emitted this shape silently wrong). The embedded input is a 1,144-byte
// two-member gzip stream (member 1: 3,000 bytes of text under -9 dynamic
// Huffman with an FNAME header; member 2: one -1 fixed-Huffman line).
// (value, pos, buf, cnt)
fn bits(pos: Int, buf: Int, cnt: Int, inp: Bytes, need: Int) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  while c < need {
    b = int.bor(b, int.bshl(bytes.get_or(inp, p, 0), c))
    p = p + 1
    c = c + 8
  }
  (int.band(b, int.bshl(1, need) - 1), p, int.bshr(b, need), c - need)
}

// Huffman table packed in one list: [0..16) = count per length, [16..) = symbols by code.
fn construct(lengths: List[Int], n: Int) -> List[Int] = {
  var count = list.repeat(0, 16)
  var i = 0
  while i < n {
    count[lengths[i]] = count[lengths[i]] + 1
    i = i + 1
  }
  var offs = list.repeat(0, 16)
  var len = 1
  while len < 15 {
    offs[len + 1] = offs[len] + count[len]
    len = len + 1
  }
  var symbol = list.repeat(0, n)
  i = 0
  while i < n {
    if lengths[i] != 0 then {
      symbol[offs[lengths[i]]] = i
      offs[lengths[i]] = offs[lengths[i]] + 1
    } else ()
    i = i + 1
  }
  count + symbol
}

// (symbol or -1, pos, buf, cnt)
fn decode(pos: Int, buf: Int, cnt: Int, inp: Bytes, h: List[Int]) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  var code = 0
  var first = 0
  var index = 0
  var len = 1
  var result = 0 - 1
  while len <= 15 and result < 0 {
    let (bit, p2, b2, c2) = bits(p, b, c, inp, 1)
    p = p2
    b = b2
    c = c2
    code = int.bor(code, bit)
    let cnt_len = h[len]
    if code - cnt_len < first then {
      result = h[16 + index + (code - first)]
    } else {
      index = index + cnt_len
      first = int.bshl(first + cnt_len, 1)
      code = int.bshl(code, 1)
      len = len + 1
    }
  }
  (result, p, b, c)
}

