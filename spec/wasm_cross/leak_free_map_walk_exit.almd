// @contract: C-066
// An exit out of a `for (k, v) in m` body — a `!` that propagates —
// releases the map walk's hold on the map, as the loop's normal end does.
// The structural wasm leg released the walk's credit only after the loop, so
// an exit from the body left the map held forever and every call leaked the
// map with its entries (#3374). A `continue` stays in the frame and reaches
// the release itself; it runs here too. The program prints the same text on
// both targets and ends with no block live. A guard return and a `break` out
// of the body are judged in tests/leak_free_exits_test.rs: the native MIR
// brick walls them, and a fixture would add walled-real baseline rows.
fn chk(v: List[Int]) -> Result[Int, String] = if list.len(v) > 2 then err("big ${list.len(v)}") else ok(list.len(v))

fn walk_prop(m: Map[String, List[Int]]) -> Result[Int, String] = {
  var acc = 0
  for (_, v) in m {
    acc = acc + chk(v)!
  }
  ok(acc)
}

fn walk_continue(m: Map[String, List[Int]]) -> Int = {
  var small = 0
  for (_, v) in m {
    guard list.len(v) <= 2 else continue
    small = small + 1
  }
  small
}

fn walk_fresh_prop(i: Int) -> Result[Int, String] = {
  var acc = 0
  for (_, v) in map.from_list([
    ("a", [i]),
    ("b", list.repeat(i, 4))
  ]) {
    acc = acc + chk(v)!
  }
  ok(acc)
}

fn show(r: Result[Int, String]) -> String = match r {
  ok(n) => "ok ${n}",
  err(e) => "err ${e}",
}

effect fn main() -> Unit = {
  var total = 0
  for i in 0..<30 {
    let m = map.from_list([
      ("a", [1]),
      ("b" + int.to_string(i), list.repeat(i, i % 4)),
      ("c", [5, 6])
    ])
    total = total + walk_continue(m)
    total = total + (walk_prop(m) ?? 1) + (walk_fresh_prop(i) ?? 2)
  }
  let m = map.from_list([
    ("x", [1]),
    ("y", [1, 2, 3])
  ])
  println("${show(walk_prop(m))} ${show(walk_fresh_prop(3))} ${walk_continue(m)}")
  println(int.to_string(total))
}
