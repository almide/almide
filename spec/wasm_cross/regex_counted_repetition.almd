// @contract: C-032
// #4083: a counted repetition keeps the linear-time bound of #4019 up to the
// state limit. Every pattern below has close to 20,000 Pike VM states (its
// program's instructions, one copy of a repeated body per count), the most an
// accepted pattern may have (C-395), and the ones with two ways through each
// character are exponential for the backtracking walk: `^(a|a){0,2800}b` on
// 40 a's is 2^40 ways, hours for the walk alone, which is how a pattern this
// large used to be matched. The walk now runs under a step budget and the VM
// answers once it is spent, at every size up to the limit; the wasm_cross
// gate's per-run time limit turns a regression into a failure. 40 characters
// stay inside the reference interpreter's step fuel;
// tests/regex_pike_differential_test.rs runs the same shapes at 100,000
// characters natively, and holds the VM to the walk's answers over the whole
// fuzz grammar on both legs.
import regex

fn line(label: String, answer: Bool) -> String = "${label}=${answer}"

fn main() -> Unit = {
  let a40 = string.repeat("a", 40)
  // two equal alternatives under a big count: 2^n ways for the walk
  println(line("(a|a){0,2800}b miss", regex.is_match(regex.new("^(a|a){0,2800}b"), a40)))
  println(line("(a|a){0,2800}b hit", regex.is_match(regex.new("^(a|a){0,2800}b"), a40 + "b")))
  // nested counts multiplying: 300 x 10 copies
  println(line("nested miss", regex.is_full_match(regex.new("((a|a){10}){1,300}b"), a40 + "!")))
  println(line("nested hit", regex.is_full_match(regex.new("((a|a){10}){1,300}b"), a40 + "b")))
  // a group that can match empty, under a big minimum
  println(line("(a|a?){3,1000}$", regex.is_match(regex.new("^(a|a?){3,1000}$"), a40 + "b")))
  // a big count on a single character
  println(line("a{0,9000}b", regex.is_match(regex.new("a{0,9000}b"), a40)))
  println(line("a{30,9000}b", regex.is_match(regex.new("a{30,9000}b"), a40 + "b")))
  // the other operations go through the same VM
  println(ostr(regex.find(regex.new("(a|a){2,2800}?b"), "xaaab")))
  println(list.join(regex.find_all(regex.new("(a|a){2,2800}"), "aaaaa b aa a"), "|"))
  println(list.join(regex.split(regex.new("(b|b){0,2800}c"), "abcabbbcd"), "|"))
  println(regex.replace(regex.new("(x?){3,2000}y"), "xxyaxy", "<>"))
  println(regex.replace_first(regex.new("(a|a){1,2800}"), "baab", "<>"))
  // captures: the last instance of a repeated group, as the walk answers
  println(ostr(regex.captures(regex.new("^(a|a){2,2800}(a*)$"), a40) |> option.map((cs) => groups(cs))))
  println(ostr(regex.captures(regex.new("(a|ab)(c|bcd){1,1300}(d*)"), "abcdbcd") |> option.map((cs) => groups(cs))))
}

fn groups(cs: List[String?]) -> String = cs |> list.map((c) => c ?? "<none>") |> list.join(",")

fn ostr(o: String?) -> String = match o {
  some(s) => s,
  none => "NONE",
}
