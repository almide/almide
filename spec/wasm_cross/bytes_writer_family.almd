// @contract: C-213
// The `__`-named calls are the width primitives under the typed byte IO
// matrix's checked `get_` / `put_` wrappers (R-bytes-09/11): this fixture pins
// the primitives' own total domain, which the wrappers no longer reach.
// Cross-target differential fixture: the `bytes` BYTE-LEVEL WRITER family.
//
// One buffer, written through every shape the family has:
//   - `append_*`   — encode and extend (widths 1/2/4/8, both orders, floats)
//   - `set_*`      — splice at an offset, a silent no-op when it does not fit
//   - `append_/put_/get_<w>_le/be` — the sized surface with the order in the name
//   - the BE serialization cursor, bool + length-prefixed string (#1099)
//   - `fill` / `copy_from` / `copy_within`
//
// Every value is printed as its byte list, so the assertion is the exact
// layout — truncation of a wide value, two's-complement of a negative one, the
// f32 rounding, and the out-of-range writes that must change nothing.
//
// This is also the fixture that makes the interpreter a real third VOTE on the
// family (#1021): it deliberately avoids `hex.encode` and the other self-hosted
// bodies that reach `prim.handle`, which is the next abstain frontier.
fn show(label: String, b: Bytes) -> Unit = println(label + " " + "${bytes.to_list(b)}")

fn main() -> Unit = {
  // ── append: width, order, and the truncating cast ──
  var a = bytes.zeros(0)
  bytes.append_u8(a, 511)
  bytes.append_u16_le(a, 258)
  bytes.append_u16_be(a, 258)
  bytes.append_u32_le(a, 258)
  bytes.append_i32_be(a, -2)
  show("append", a)
  // A negative value and its unsigned twin write the SAME bytes — two's
  // complement, not a separate signed encoding.
  var s = bytes.zeros(0)
  bytes.append_i16_le(s, -2)
  bytes.append_u16_le(s, -2)
  bytes.append_i64_be(s, -1)
  show("signed", s)
  // ── floats: f32 rounds on the way in, f64 is exact ──
  var f = bytes.zeros(0)
  bytes.append_f32_le(f, 1.5)
  bytes.append_f64_be(f, 1.5)
  show("float", f)
  // ── set: splice in place; a window past the end changes nothing ──
  var p = bytes.zeros(6)
  bytes.__set_u32_le(p, 1, 258)
  show("set_fit", p)
  bytes.__set_u32_le(p, 4, 999)
  show("set_past_end", p)
  bytes.put_u8(p, 0, 511)
  p = bytes.set(p, 6, 7)
  show("set_at", p)
  // ── the sized surface with the order in the name ──
  var t = bytes.zeros(0)
  bytes.append_u16_le(t, 258)
  bytes.append_u16_be(t, 258)
  bytes.append_u32_be(t, 258)
  bytes.append_i32_le(t, -2)
  bytes.append_f32_le(t, 1.5)
  show("sized_append", t)
  var u = bytes.zeros(4)
  bytes.put_u32_le(u, 0, 258)
  bytes.put_u16_be(u, 2, 258)
  show("sized_set", u)
  // The read half round-trips the same bytes through both orders.
  let sr = bytes.from_list([
    2,
    1,
    0,
    0,
    1,
    2,
    0,
    0
  ])
  println(int.to_string(bytes.get_u16_le(sr, 0) ?? 0))
  println(int.to_string(bytes.get_u16_be(sr, 4) ?? 0))
  println(int.to_string(bytes.get_u32_le(sr, 0) ?? 0))
  println(int.to_string(bytes.get_i32_le(sr, 0) ?? 0))
  println(float.to_string(bytes.get_f32_le(bytes.from_list([0, 0, 192, 63]), 0) ?? 0.0))
  // ── the serialization cursor: BE twins, bool, and the length-prefixed
  // string (#1099 closed the wasm self-host gap) ──
  var w = bytes.zeros(0)
  bytes.push(w, 7)
  bytes.append_u32_be(w, 258)
  bytes.append_i64_be(w, -1)
  bytes.append_bool(w, true)
  bytes.append_bool(w, false)
  let hi = bytes.from_string("hi")
  bytes.append_u32_be(w, bytes.len(hi))
  bytes.append_bytes(w, hi)
  show("cursor", w)
  // f64 BE: 1.5 = 0x3FF8000000000000.
  var wf = bytes.zeros(0)
  bytes.append_f64_be(wf, 1.5)
  show("cursor_f64", wf)
  // A multibyte string counts BYTES in its prefix, not characters.
  var m = bytes.zeros(0)
  let e_acute = bytes.from_string("é")
  bytes.append_u32_be(m, bytes.len(e_acute))
  bytes.append_bytes(m, e_acute)
  show("cursor_utf8", m)
  // ── fill / copy_from / copy_within ──
  var g = bytes.zeros(3)
  bytes.fill(g, 511)
  show("fill", g)
  var empty = bytes.zeros(0)
  bytes.fill(empty, 7)
  show("fill_empty", empty)
  let src = bytes.from_list([7, 8, 9])
  var d = bytes.zeros(4)
  bytes.copy_from(d, src, 1, 0, 99)
  show("copy_from_clamped", d)
  var c = bytes.from_list([1, 2, 3, 0, 0])
  bytes.copy_within(c, 0, 3, 2)
  show("copy_within", c)
  var c2 = bytes.from_list([1, 2, 3])
  bytes.copy_within(c2, 0, 3, 1)
  show("copy_within_no_fit", c2)
}
