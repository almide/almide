// @contract: C-226
// A `mut` parameter passed across a call boundary mutates the caller's data
// identically on both targets — the #1207 shapes: a Unit effect fn forwarding
// its own mut param to another effect fn (repro B), tail recursion threading a
// mut Bytes buffer through an `if` (repro A, the Barnsley-fern chaos-game
// shape), and a growth writeback where the callee REALLOCATES the buffer
// (list.push through a guarded chain), so the caller must observe the
// successor handle, not the stale one. Loop-heavy call counts are part of the
// promise: an ownership imbalance in the write-back surfaces as a trap or a
// leak only under repetition.
import bytes

effect fn h(mut a: Int) -> Unit = println(int.to_string(a))

effect fn g(mut a: Int) -> Unit = {
  h(a)!
}

effect fn walk(mut buf: Bytes, n: Int) -> Unit = if n == 0 then ()
else {
  bytes.set_at(buf, n % 64, int.band(n, 255))
  walk(buf, n - 1)
}

effect fn poke(mut buf: Bytes, v: Int) -> Unit = bytes.set_at(buf, 0, v)

fn grow(mut xs: List[Int], x: Int) -> Unit = list.push(xs, x)

effect fn grow_if(mut xs: List[Int], x: Int) -> Unit = if x > 0 then grow(xs, x) else ()

effect fn main() -> Unit = {
  var v = 1
  g(v)!
  var buf = bytes.new(64)
  walk(buf, 2000)!
  var sum = 0
  for i in 0..<64 {
    sum = sum + bytes.get_or(buf, i, 0)
  }
  println("sum=${sum}")
  var i2 = 0
  while i2 < 10000 {
    poke(buf, int.band(i2, 255))!
    i2 = i2 + 1
  }
  println("p0=${bytes.get_or(buf, 0, 0)}")
  var xs: List[Int] = []
  var j = 0
  while j < 100 {
    grow_if(xs, j)!
    j = j + 1
  }
  println("grown=${list.len(xs)} last=${xs[list.len(xs) - 1]}")
}
