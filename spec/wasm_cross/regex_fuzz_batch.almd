  println("<" + regex.replace(regex.new("^|b+本+|.?\\."), "本a本b本", "<R>") + ">")
  println("<" + regex.replace(regex.new("b+?🦀"), "本", "<R>") + ">")
  println("<" + regex.replace(regex.new("^|b{0,2}"), "@_", "<R>") + ">")
  println("<" + regex.replace(regex.new(".{1,3}?.*?\\s*?|b{2}|...+?"), "xYz", "<R>") + ">")
  println("<" + regex.replace(regex.new(".?|\\+{2}|"), "ABC123xyz", "<R>") + ">")
  println("<" + regex.replace(regex.new("(?m)b*"), "abc", "<R>") + ">")
  println("<" + regex.replace(regex.new("^c*.[\\d]"), "..++..", "<R>") + ">")
  println("<" + regex.replace(regex.new("é{2}.?|a{1,3}a*?\\w|[^a-z]+"), "a\tb\nc", "<R>") + ">")
  println("<" + regex.replace(regex.new("é本|[^0-9]+[abc]|z?"), "z9z9z9", "<R>") + ">")
  println("<" + regex.replace(regex.new("(?m)[0-9]{2,}\\.*|\\..{2}.{1,3}?|b*\\w*?$"), "@ ", "<R>") + ">")
  println("<" + regex.replace(regex.new("a{2,}\\d{0,2}.{1,3}?|\\w*|本{1,3}?c+?b"), "a", "<R>") + ">")
  println("<" + regex.replace(regex.new("(?m)bb+."), "abc", "<R>") + ">")
  println("<" + regex.replace(regex.new("\\B{0,2}a{1,3}?|[\\w]*c{1,3}?c+?|\\S"), "z9z9z9", "<R>") + ">")
  println("<" + regex.replace(regex.new("a{1,3}?[本語]?"), "@", "<R>") + ">")
  println("<" + regex.replace(regex.new(".{0,2}[本語]??[^0-9]|.?|本?本{2,}.??$"), "..++..", "<R>") + ">")
  println("<" + regex.replace(regex.new("\\s+?.{2,}本{2,}"), "end", "<R>") + ">")
  println("<" + regex.replace(regex.new("^c{1,3}?|\\B{2}|a{2,}é{1,3}?c?"), "..++..", "<R>") + ">")
  println("<" + regex.replace(regex.new("[^0-9]{2,}|b+$"), "aaa", "<R>") + ">")
  println("<" + regex.replace(regex.new("a{0,2}"), "abc", "<R>") + ">")
  println("<" + regex.replace(regex.new("🦀[^a-z]{1,3}?[^\\d]{2,}|\\W[^a-z]|\\W??"), "a1b2c3", "<R>") + ">")
  println("<" + regex.replace(regex.new("\\D??a+"), "", "<R>") + ">")
  println("<" + regex.replace(regex.new("a{0,2}a.*"), " cca1  bca", "<R>") + ">")
  println("<" + regex.replace(regex.new(".*é{0,2}🦀{1,3}$"), "end", "<R>") + ">")
  println("<" + regex.replace(regex.new(".|"), "café", "<R>") + ">")
  println("<" + regex.replace_first(regex.new(".??b+?|🦀{0,2}..*|é+"), "user@host.com", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("|"), "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new(".+?.*|a+?a[本語]{2}"), "no_digits_here", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("|[a-z]{2,}z??z{2}"), "a1b2c3", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("(?m)^[.+*]|.?[\\d]{2}|🦀??z?$"), "2本_.2.", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("🦀[本語]"), ". c2本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("\\.{1,3}$"), "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new(".+?\\\\{0,2}\\d+|\\B*?"), "xYz", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("(?m)^本{2}[a-z0-9]{1,3}a+?"), "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("\\s{1,3}?||é*本*"), "日本語", "<R>") + ">")
  println("<" + regex.replace_first(regex.new(".{2}|"), "  spaced  ", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^|本+?.$"), "a1c本c  a", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("(?m)a??|\\d{2,}|\\D"), "ABC123xyz", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("\\S*?.?||é??本+"), "aaa", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^c?[^a-z]+?[^\\d]"), "1bc21 ", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^a*[a-z0-9]??"), "a", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("z{2,}"), "🦀rust🦀", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("b{1,3}?c{1,3}.{2}"), "café", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("b{2}"), "a..@b@ba 本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^.{2}|"), "start end", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^a+?.{2}$"), "no_digits_here", "<R>") + ">")
  println("<" + regex.replace_first(
    regex.new("|\\.{0,2}b+?|[.+*]{2}[\\d]{2,}[a-z]{1,3}?$"),
    "hello world",
    "<R>",
  ) + ">")
  println("<" + regex.replace_first(regex.new("|[a-z]??.+[^a-z]??|.."), "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("\\Wc*"), "..++..", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("[a-z]*?.+?\\s?"), "b.bc_2a ", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("a{1,3}$"), "a1b2c3", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("|\\W"), "._c本", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("(?m)"), "xYz", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^|é??本|[abc]b\\d{2,}$"), "a", "<R>") + ">")
  println("<" + regex.replace_first(regex.new("^|[a-z].{1,3}?|[本語]*🦀{2}"), "a1b2c3", "<R>") + ">")
}
