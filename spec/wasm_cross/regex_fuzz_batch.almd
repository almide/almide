  println("<" + regex.replace_first(".??b+?|🦀{0,2}..*|é+", "user@host.com", "<R>") + ">")
  println("<" + regex.replace_first("|", "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(".+?.*|a+?a[本語]{2}", "no_digits_here", "<R>") + ">")
  println("<" + regex.replace_first("|[a-z]{2,}z??z{2}", "a1b2c3", "<R>") + ">")
  println("<" + regex.replace_first("(?m)^[.+*]|.?[\\d]{2}|🦀??z?$", "2本_.2.", "<R>") + ">")
  println("<" + regex.replace_first("🦀[本語]", ". c2本", "<R>") + ">")
  println("<" + regex.replace_first("\\.{1,3}$", "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first(".+?\\\\{0,2}\\d+|\\B*?", "xYz", "<R>") + ">")
  println("<" + regex.replace_first("(?m)^本{2}[a-z0-9]{1,3}a+?", "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first("\\s{1,3}?||é*本*", "日本語", "<R>") + ">")
  println("<" + regex.replace_first(".{2}|", "  spaced  ", "<R>") + ">")
  println("<" + regex.replace_first("^|本+?.$", "a1c本c  a", "<R>") + ">")
  println("<" + regex.replace_first("(?m)a??|\\d{2,}|\\D", "ABC123xyz", "<R>") + ">")
  println("<" + regex.replace_first("\\S*?.?||é??本+", "aaa", "<R>") + ">")
  println("<" + regex.replace_first("^c?[^a-z]+?[^\\d]", "1bc21 ", "<R>") + ">")
  println("<" + regex.replace_first("^a*[a-z0-9]??", "a", "<R>") + ">")
  println("<" + regex.replace_first("z{2,}", "🦀rust🦀", "<R>") + ">")
  println("<" + regex.replace_first("b{1,3}?c{1,3}.{2}", "café", "<R>") + ">")
  println("<" + regex.replace_first("b{2}", "a..@b@ba 本", "<R>") + ">")
  println("<" + regex.replace_first("^.{2}|", "start end", "<R>") + ">")
  println("<" + regex.replace_first("^a+?.{2}$", "no_digits_here", "<R>") + ">")
  println("<" + regex.replace_first("|\\.{0,2}b+?|[.+*]{2}[\\d]{2,}[a-z]{1,3}?$", "hello world", "<R>") + ">")
  println("<" + regex.replace_first("|[a-z]??.+[^a-z]??|..", "本a本b本", "<R>") + ">")
  println("<" + regex.replace_first("\\Wc*", "..++..", "<R>") + ">")
  println("<" + regex.replace_first("[a-z]*?.+?\\s?", "b.bc_2a ", "<R>") + ">")
  println("<" + regex.replace_first("a{1,3}$", "a1b2c3", "<R>") + ">")
  println("<" + regex.replace_first("|\\W", "._c本", "<R>") + ">")
  println("<" + regex.replace_first("(?m)", "xYz", "<R>") + ">")
  println("<" + regex.replace_first("^|é??本|[abc]b\\d{2,}$", "a", "<R>") + ">")
  println("<" + regex.replace_first("^|[a-z].{1,3}?|[本語]*🦀{2}", "a1b2c3", "<R>") + ">")
}
