// @contract: C-223
// #2624: the softmax family answers native's IEEE result on every leg — for a
// row whose exps do not sum to a number, and for multi_head_attention's exp.
// - softmax_rows / attention_weights / scaled_dot_product_attention: a row
//   holding +inf (here an f64::MAX operand overflowing the Q·Kᵀ score) or all
//   -inf has `x - max = NaN`, so its sum is NaN and every entry is NaN, as the
//   native kernel and PyTorch answer. Both wasm legs substituted a uniform
//   `1/n` row, printing `[[0.5, 0.5]]` where native printed `[[NaN, NaN]]`
//   (differential fuzz, a matrix_composition_family mutation).
// - multi_head_attention exps through the vendored musl `exp` (C-223) on
//   every leg, scales by the reciprocal of the sum, and skips a weight of
//   exactly 0: the wasm legs used the fast-exp (every value ~1e-8 off
//   native on ordinary inputs), divided by the sum, and let an underflowed
//   key's `inf` value through as `inf * 0`.
effect fn main() -> Unit = {
  let inf = 1.0e308 * 10.0
  let ninf = 0.0 - inf
  println("${matrix.to_lists(matrix.softmax_rows(matrix.from_lists([
    [inf, inf],
    [0.7, 2.1]
  ])))}")
  println("${matrix.to_lists(matrix.softmax_rows(matrix.from_lists([
    [ninf, ninf, ninf],
    [inf, 1.0, 0.5]
  ])))}")
  let q = matrix.from_lists([
    [1.0, 1.7976931348623157e308, 3.0],
    [4.0, 5.0, 6.0]
  ])
  let kt = matrix.from_lists([
    [0.5, -1.0],
    [2.0, 8.0],
    [3.0, 0.25]
  ])
  println("${matrix.to_lists(matrix.attention_weights(q, kt, 0.25))}")
  let v = matrix.from_lists([
    [1.0],
    [2.0]
  ])
  println("${matrix.to_lists(matrix.scaled_dot_product_attention(q, kt, v, 0.25))}")
  let mq = matrix.from_lists([
    [0.3, 0.7, 1.1, -0.4],
    [0.9, -0.2, 0.05, 0.6]
  ])
  let mk = matrix.from_lists([
    [0.1, 0.9, 0.3, 0.7],
    [0.5, 0.2, -0.8, 0.11],
    [0.33, 0.17, 0.41, -0.29]
  ])
  let mv = matrix.from_lists([
    [0.123, 4.56, 7.89, 0.1],
    [3.3, 0.001, 2.7, 9.9],
    [1.7, 0.37, 0.61, 5.3]
  ])
  println("${matrix.to_lists(matrix.multi_head_attention(mq, mk, mv, 2))}")
  println("${matrix.to_lists(matrix.multi_head_attention(mq, mk, mv, 1))}")
  println("${matrix.to_lists(matrix.masked_multi_head_attention(mq, mk, mv, 2))}")
  let big = matrix.from_lists([
    [1.0e308, 1.0e308]
  ])
  println("${matrix.to_lists(matrix.multi_head_attention(big, big, matrix.from_lists([
    [1.0, 2.0]
  ]), 1))}")
  let far = matrix.from_lists([
    [1000.0],
    [0.0]
  ])
  println("${matrix.to_lists(matrix.multi_head_attention(
    matrix.from_lists([
      [1.0]
    ]),
    far,
    matrix.from_lists([
      [1.0],
      [inf]
    ]),
    1,
  ))}")
}
