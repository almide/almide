// grain gc.re — fib_gc (tuple-accumulator recursion; every iteration must
// free the previous tuple), loop_gc (per-iteration allocation abandoned by
// `continue` must still drop), match_issue893 (repeated scalar match calls),
// large_lists (deep TCO list build).
fn fib_help(n: Int, acc: (Int, Int)) -> Int = {
  let (cur, next) = acc
  if n == 0 then cur else fib_help(n - 1, (next, cur + next))
}

fn fib(x: Int) -> Int = fib_help(x, (0, 1))

fn classify(n: Int) -> Int = match n { 0 => 0, _ => 1 }

fn make_list(n: Int, acc: List[Int]) -> List[Int] =
  if n == 0 then acc else make_list(n - 1, [1] + acc)

fn main() -> Unit = {
  println(int.to_string(fib(30)))
  var i = 0
  var kept = 0
  while i < 512 {
    i = i + 1
    let s = "string${int.to_string(i)}"
    if i % 2 == 0 then { continue } else { () }
    kept = kept + string.len(s) - 6
  }
  println(int.to_string(kept))
  let _ = classify(1)
  let _ = classify(2)
  let _ = classify(3)
  println("4")
  println(int.to_string(list.len(make_list(2000, []))))
}
