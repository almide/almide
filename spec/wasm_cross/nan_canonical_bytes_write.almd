// @contract: C-210
// The BYTES-WRITE half of the NaN-canonical-observation contract: the float
// append fns are observation boundaries too, collapsing NaN to the same
// canonical patterns (f64 0x7FF8000000000000, f32 0x7FC00000) before the
// reinterpret hits the buffer. Separate file from the to_bits half so the
// reference interpreter keeps evaluating that one — the in-place byte-buffer
// append family is out of interp scope (#1021, ledgered).
effect fn main() -> Unit = {
  let z = 0.0
  let nan_div = z / z
  let canon = 0x7FF8000000000000
  var b = bytes.new(0)
  bytes.append_f64_le(b, nan_div)
  bytes.append_f32_le(b, nan_div)
  println(if bytes.read_i64_le(b, 0) == canon then "f64write:canonical" else "f64write:RAW-LEAK")
  println(if bytes.read_u32_le(b, 8) == 0x7FC00000 then "f32write:canonical" else "f32write:RAW-LEAK")
  // #3647: 0.0/0.0 is already the canonical pattern on aarch64, so it alone
  // could not see a raw write there. A from_bits payload NaN, a negated
  // (sign-set) NaN, and an arithmetic NaN (sign-set by x86's default, not by
  // aarch64's) must collapse too, through all four append fns: f64 le/be,
  // then f32 le/be.
  let payload = int.bits_to_float(0 - 256)
  let arith = 0.0 - nan_div
  for (name, x) in [("payload", payload), ("negated", -nan_div), ("arith", arith)] {
    var c = bytes.new(0)
    bytes.append_f64_le(c, x)
    bytes.append_f64_be(c, x)
    bytes.append_f32_le(c, x)
    bytes.append_f32_be(c, x)
    println("${name}=${bytes.to_list(c)}")
  }
}
