// @contract: C-276
// #1233: `list.sort_by` with a STRING key over HEAP elements (List[List[String]],
// List[String]). The scalar-element twin (`list.sort_by_str_key`) copies each
// element handle RAW, which is right for an Int element and a double-free for a
// heap one — so the heap instantiation used to wall the whole wasm leg
// (`sort_by_str_key_x` unlinked) and only native ever ran it. It now routes to
// `list.sort_by_str_key_rc`, whose fill ACQUIRES each copied handle so the source
// and result lists co-own their elements.
//
// Three observations: the ORDER (byte-lexicographic via string.cmp, stability on
// equal keys), the SOURCE list surviving the sort intact (it is borrowed, not
// consumed), and a create+sort+drop loop that TRAPS on wasm within a page if the
// co-own is unbalanced in either direction (a leak grows past 64KB; a missing
// acquire double-frees).
fn key_of(row: List[String]) -> String = list.get_or(row, 0, "")

fn tag_of(row: List[String]) -> String = list.get_or(row, 1, "")

fn render(rows: List[List[String]]) -> String = rows |> list.map((r) => "${key_of(r)}:${tag_of(r)}") |> list.join(",")

fn main() -> Unit = {
  let rows = [
    ["b", "2"],
    ["a", "1"],
    ["c", "3"]
  ]
  println(render(list.sort_by(rows, (r) => key_of(r))))
  // The source is borrowed, not moved: it still reads after the sort.
  println(render(rows))
  // Equal keys keep declaration order (stable insertion sort).
  let dup = [
    ["k", "first"],
    ["a", "only"],
    ["k", "second"]
  ]
  println(render(list.sort_by(dup, (r) => key_of(r))))
  // A List[String] element (the flat heap case).
  let words = ["pear", "fig", "apple"]
  println("${list.sort_by(words, (w) => w)}")
  // Leak/double-free gate: 20000 create+sort+drop rounds stay inside page 1
  // when the acquire and the recursive drop balance exactly.
  var i = 0
  while i < 20000 {
    let s = list.sort_by([
      ["y", "1"],
      ["x", "0"]
    ], (r) => key_of(r))
    let _ = list.len(s)
    i = i + 1
  }
  println("done")
}
