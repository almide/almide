// @contract: C-298
// Option[Int] / Option[Float] across present / missing / null (C-209's
// 3-state rule on NUMERIC fields): missing and null both fold to none,
// present decodes, and encode omits the none.
import json

type O: Codec = { oi: Int? = none, of: Float? = none, req: String }

effect fn main() -> Unit = {
  let present = O.decode(json.parse('{"oi": 5, "of": 2.5, "req": "r"}')!)!
  println(int.to_string(present.oi ?? (0 - 1)) + "/" + float.to_string(present.of ?? 0.0))
  let missing = O.decode(json.parse('{"req": "r"}')!)!
  println(int.to_string(missing.oi ?? (0 - 1)) + "/" + float.to_string(missing.of ?? 0.0))
  let nulled = O.decode(json.parse('{"oi": null, "of": null, "req": "r"}')!)!
  println(int.to_string(nulled.oi ?? (0 - 1)) + "/" + float.to_string(nulled.of ?? 0.0))
  println(json.stringify(O.encode(missing)))
}
