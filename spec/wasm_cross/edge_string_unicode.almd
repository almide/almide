// Unicode strings: multibyte slicing, len semantics, codepoints, case ops,
// split/join roundtrips with multibyte separators, interpolated nesting.
fn main() -> Unit = {
  let s = "aあ🦀é±x"
  println(int.to_string(string.len(s)))
  println(string.slice(s, 1, 3))
  println(string.take(s, 2))
  println(string.drop(s, 2))
  println(string.get(s, 2) ?? "?")
  println(string.to_upper("straße mix"))
  println(string.to_lower("İSTANBUL"))
  let parts = string.split("a🦀b🦀c", "🦀")
  println("${int.to_string(list.len(parts))}:${list.join(parts, "|")}")
  println(string.join(["α", "β", "γ"], "・"))
  println(string.replace("ααα", "α", "β"))
  println(string.from_codepoint(129408))
  println(string.from_codepoint(233))
  let t = "e${"n${"est"}ed"}!"
  println(t)
  println(string.repeat("ab", 3))
  println(if "a" < "b" then "lt" else "ge")
  println(if "あ" < "🦀" then "lt" else "ge")
  println(string.trim("  padded  "))
  println(int.to_string(string.len(string.repeat("é", 100))))
}
