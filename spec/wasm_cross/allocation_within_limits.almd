// @contract: C-197
// The CONVERGENT boundary of the linear-memory resource contract: allocation within
// both targets' limits is byte-identical (a growth-exercising push loop crossing many
// page boundaries). Beyond-limit allocation is the contracted divergence — wasm32
// aborts with the defined "Error: out of memory" line (never an OOB fault; the
// frontier-wrap and cap-wrap guards route unsatisfiable requests to $oom) while
// native's 64-bit address space may satisfy the same program.
fn main() -> Unit = {
  var xs: List[Int] = []
  for i in 0..<100000 {
    list.push(xs, i * 3)
  }
  println(int.to_string(list.len(xs)))
  println(int.to_string(xs[99999]))
}
