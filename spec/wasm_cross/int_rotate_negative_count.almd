// @contract: C-358
// `int.rotate_left` / `rotate_right` reduce the count into `[0, 64)`
// Euclidean-ly, so a negative count rotates the other way and any count is
// taken modulo 64, on every leg (#2492). Native computed `(n % bits) as u32`,
// which kept the sign of `n`: `-1 as u32` became an over-wide shift and every
// negative count returned 0. The register is the 64-bit Int (C-048).
fn main() -> Unit = {
  let rots = [
    (1, -1),
    (1, -65),
    (1, -129),
    (1, 63),
    (1, 65),
    (-9223372036854775807 - 1, -1),
    (255, -3),
    (5, -2),
    (1, 0),
    (1, 64),
    (1, -64),
    (-1, -1),
    (1, -9223372036854775807 - 1),
    (1, 9223372036854775807)
  ]
  for (a, n) in rots {
    println("rotl(${a}, ${n}) = ${int.rotate_left(a, n)} rotr = ${int.rotate_right(a, n)}")
  }
}
