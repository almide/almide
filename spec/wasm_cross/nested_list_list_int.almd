// @contract: C-293
// List[List[Int]] exhaustively: literal, grown, jagged, empty inners,
// indexing both levels, map/fold over inner lists, equality, and the
// aliasing question (does pushing into a copy mutate the source?).
fn show(xss: List[List[Int]]) -> String = list.join(list.map(xss, (xs) => "[${list.join(list.map(xs, (x) => int.to_string(x)), ",")}]"), " ")

fn main() -> Unit = {
  let lit: List[List[Int]] = [
    [1, 2],
    [],
    [3, 4, 5]
  ]
  println(show(lit))
  println(int.to_string(list.len(lit)))
  let inner = list.get(lit, 2) ?? []
  println(int.to_string(list.len(inner)))
  println(int.to_string(list.get(inner, 1) ?? (0 - 1)))
  println(int.to_string(list.get(list.get(lit, 0) ?? [], 0) ?? (0 - 1)))
  // grown form: push inner lists one by one
  var grown: List[List[Int]] = []
  var i = 0
  while i < 3 {
    var row: List[Int] = []
    var j = 0
    while j <= i {
      list.push(row, i * 10 + j)
      j = j + 1
    }
    list.push(grown, row)
    i = i + 1
  }
  println(show(grown))
  // fold: total across both levels
  let total = list.fold(grown, 0, (acc, xs) => acc + list.fold(xs, 0, (a, x) => a + x))
  println(int.to_string(total))
  // map at the outer level rebuilding inners
  println(show(list.map(lit, (xs) => list.map(xs, (x) => x * 2))))
  // equality at both depths
  println(if [
    [1],
    [2, 3]
  ] == [
    [1],
    [2, 3]
  ] then "eq" else "ne")
  println(if [
    [1],
    [2, 3]
  ] == [
    [1],
    [2]
  ] then "eq" else "ne")
  // aliasing: pushing into a fetched inner must not mutate the source
  var alias = list.get(lit, 0) ?? []
  list.push(alias, 99)
  println("${int.to_string(list.len(list.get(lit, 0) ?? []))} ${int.to_string(list.len(alias))}")
}
