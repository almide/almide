// @contract: C-004
// #1406: the fan MAPPER slot accepts a CAPABILITY-BEARING effect callback —
// one whose body reaches a wasm-implemented capability (fs) — and the result
// is byte-identical native == wasm, for BOTH callback spellings and BOTH
// consumption forms.
//
// This is the fixture C-004's sibling (fan_effect_mapper.almd) deliberately
// did not cover: that one measured capability-FREE effect callbacks and
// attributed the reported wall to `http.get`'s missing wasm implementation.
// The residual gap was real and had TWO independent causes, fixed together:
//
//   1. can-err ABI: an effect fn whose body is a bare capability call in TAIL
//      position (`effect fn helper(p) = fs.read_text(p)` — the PASSTHROUGH
//      shape) built no ResultErr node and carried no `!`/`?`, so the syntactic
//      seed missed it, the fn left `can_err`, and its raw-payload ABI broke the
//      mapper's uniform Result-carrier funcref contract
//      (`returns_foreign_result`, mod_p2.rs).
//   2. result-family tracking: the classify sites see the PRE-routing name
//      `fan.any_map` for all nine pairings, so the String-output pairings were
//      mis-familied as scalar len-as-tag and the `!`-desugar's match walled
//      ("UNTRACKED subject"). The family is now TYPE-split
//      (`is_fan_any_map` + `is_heap_ok_result`, mod_p5.rs).
//
// Shape B — inline lambda reaching fs DIRECTLY.
// Shape D — lambda calling an effect HELPER that wraps fs (the passthrough;
//           load-bearing for cause 1: helper itself seeds nothing).
// Both consumed via `??` (fallback) AND `!` (propagation), ok and err paths.
//
// SELF-CONTAINED: its own temp dir (never printed — the suffix differs per
// run), removed at the end. The err path reads a path under the temp dir that
// was never created, so the message is deterministic on both legs.
import fs

effect fn helper(p: String) -> Result[String, String] = fs.read_text(p)

effect fn main() -> Unit = {
  let d = fs.create_temp_dir("fanCap")!
  fs.write(d + "/a.txt", "alpha")!
  fs.write(d + "/b.txt", "beta")!
  // Shape B, ok path, `!` consumption.
  let b_ok = fan.any([d + "/a.txt"], (p) => fs.read_text(p))!
  println("B ok ${b_ok}")
  // Shape B, err path (no candidate exists), `??` consumption.
  let b_err = fan.any([d + "/missing1.txt", d + "/missing2.txt"], (p) => fs.read_text(p)) ?? "fb"
  println("B err ${b_err}")
  // Shape D, ok path, `!` consumption — first candidate missing, second ok:
  // fan.any skips the failure to find the Ok.
  let d_ok = fan.any([d + "/missing.txt", d + "/b.txt"], (p) => helper(p))!
  println("D ok ${d_ok}")
  // Shape D, err path, `??` consumption.
  let d_err = fan.any([d + "/nope.txt"], (p) => helper(p)) ?? "fb2"
  println("D err ${d_err}")
  // Shape D over fan.map (the collect-all mapper), ok path, `!` consumption —
  // the heap-Ok LIST payload family (`Result[List[String], String]`).
  let mapped = fan.map([d + "/a.txt", d + "/b.txt"], (p) => helper(p))!
  println("map ok ${mapped}")
  // fan.map err path: the FIRST failing element's err rides out (C-005's
  // first-err ordering), consumed via `??`.
  let map_err = fan.map([d + "/a.txt", d + "/gone.txt"], (p) => helper(p)) ?? ["fb3"]
  println("map err ${map_err}")
  fs.remove_all(d)!
}
