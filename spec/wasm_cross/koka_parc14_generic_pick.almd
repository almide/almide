// @contract: C-292
// koka parc14 (+parc7/8): two same-typed generic params, exactly ONE
// consumed per branch — the other must be dropped, not leaked. Instantiated
// at Int (no drop), String and List[Int] (drop required). Plus the scalar
// x + x dup (parc8) and the drop-the-second-param shape (parc7).
fn pick[T](x: Int, y: T, z: T) -> T = match x {
  0 => y,
  _ => z,
}

fn first_of[T](x: T, y: T) -> T = x

fn double(x: Int) -> Int = x + x

fn main() -> Unit = {
  println(int.to_string(pick(0, 1, 2)))
  println(int.to_string(pick(9, 1, 2)))
  println(pick(0, "keep" + "L", "drop" + "R"))
  println(pick(1, "drop" + "L", "keep" + "R"))
  let a = [1, 2, 3]
  let b = [9, 8]
  println(int.to_string(list.len(pick(0, a, b))))
  println(int.to_string(list.len(pick(1, a, b))))
  println(first_of("kept", "dropped"))
  println(int.to_string(double(21)))
}
