// @contract: C-420
// #4106: HMAC-SHA256 / HMAC-SHA512 (RFC 2104) are byte-identical native ==
// wasm and equal the RFC 4231 vectors, test cases 1-7: the short key (1), a
// key shorter than the data (2), 0xaa/0xdd fill (3), a 25-byte counting key
// (4), the 128-bit truncation of case 5 (taken with bytes.slice), and the
// 131-byte key that is hashed before use (6, 7). The key comes FIRST: each
// vector pins the argument order, so a swapped call fails here. The
// is_valid_* cells accept the right tag (raw, hex lower and upper case) and
// refuse a wrong one, a truncated one, odd-length hex and a non-hex char.
import hash
import hex

fn fill(x: Int, n: Int) -> Bytes = bytes.from_list(list.repeat(x, n))

fn s(t: String) -> Bytes = bytes.from_string(t)

fn check(name: String, got: String, want: String) -> Unit = {
  assert_eq(got, want)
  println("${name} ${got}")
}

fn main() -> Unit = {
  let k1 = fill(11, 20)
  let d1 = s("Hi There")
  check(
    "tc1 sha256",
    hash.hmac_sha256_hex(k1, d1),
    "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  )
  check(
    "tc1 sha512",
    hash.hmac_sha512_hex(k1, d1),
    "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
  )
  let k2 = s("Jefe")
  let d2 = s("what do ya want for nothing?")
  check(
    "tc2 sha256",
    hash.hmac_sha256_hex(k2, d2),
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
  )
  check(
    "tc2 sha512",
    hash.hmac_sha512_hex(k2, d2),
    "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
  )
  let k3 = fill(170, 20)
  let d3 = fill(221, 50)
  check(
    "tc3 sha256",
    hash.hmac_sha256_hex(k3, d3),
    "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
  )
  check(
    "tc3 sha512",
    hash.hmac_sha512_hex(k3, d3),
    "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
  )
  let k4 = bytes.from_list(list.range(1, 26))
  let d4 = fill(205, 50)
  check(
    "tc4 sha256",
    hash.hmac_sha256_hex(k4, d4),
    "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",
  )
  check(
    "tc4 sha512",
    hash.hmac_sha512_hex(k4, d4),
    "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
  )
  let k5 = fill(12, 20)
  let d5 = s("Test With Truncation")
  check(
    "tc5 sha256",
    hex.encode(bytes.slice(hash.hmac_sha256(k5, d5), 0, 16)),
    "a3b6167473100ee06e0c796c2955552b",
  )
  check(
    "tc5 sha512",
    hex.encode(bytes.slice(hash.hmac_sha512(k5, d5), 0, 16)),
    "415fad6271580a531d4179bc891d87a6",
  )
  let k6 = fill(170, 131)
  let d6 = s("Test Using Larger Than Block-Size Key - Hash Key First")
  check(
    "tc6 sha256",
    hash.hmac_sha256_hex(k6, d6),
    "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
  )
  check(
    "tc6 sha512",
    hash.hmac_sha512_hex(k6, d6),
    "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
  )
  let d7 = s("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")
  check(
    "tc7 sha256",
    hash.hmac_sha256_hex(k6, d7),
    "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
  )
  check(
    "tc7 sha512",
    hash.hmac_sha512_hex(k6, d7),
    "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
  )
  let tag2 = hash.hmac_sha256(k2, d2)
  let hex2 = hash.hmac_sha256_hex(k2, d2)
  println("valid256 raw ${hash.is_valid_hmac_sha256(k2, d2, tag2)}")
  println("valid256 hex ${hash.is_valid_hmac_sha256_hex(k2, d2, hex2)}")
  println("valid256 HEX ${hash.is_valid_hmac_sha256_hex(k2, d2, string.to_upper(hex2))}")
  println("valid256 wrong-data ${hash.is_valid_hmac_sha256(k2, s("what do ya want for nothing!"), tag2)}")
  println("valid256 wrong-key ${hash.is_valid_hmac_sha256_hex(s("jefe"), d2, hex2)}")
  println("valid256 truncated ${hash.is_valid_hmac_sha256(k2, d2, bytes.slice(tag2, 0, 16))}")
  println("valid256 odd-hex ${hash.is_valid_hmac_sha256_hex(k2, d2, string.slice(hex2, 0, 63))}")
  println("valid256 non-hex ${hash.is_valid_hmac_sha256_hex(k2, d2, "zz" + string.slice(hex2, 2, 64))}")
  println("valid256 empty ${hash.is_valid_hmac_sha256_hex(k2, d2, "")}")
  let tag5 = hash.hmac_sha512(k2, d2)
  let hex5 = hash.hmac_sha512_hex(k2, d2)
  println("valid512 raw ${hash.is_valid_hmac_sha512(k2, d2, tag5)}")
  println("valid512 hex ${hash.is_valid_hmac_sha512_hex(k2, d2, hex5)}")
  println("valid512 HEX ${hash.is_valid_hmac_sha512_hex(k2, d2, string.to_upper(hex5))}")
  println("valid512 wrong-data ${hash.is_valid_hmac_sha512(k2, s("x"), tag5)}")
  println("valid512 sha256-tag ${hash.is_valid_hmac_sha512(k2, d2, tag2)}")
  println("valid512 non-hex ${hash.is_valid_hmac_sha512_hex(k2, d2, string.slice(hex5, 0, 126) + "g0")}")
  println("empty-key ${hash.hmac_sha256_hex(bytes.from_list([]), bytes.from_list([]))}")
}
