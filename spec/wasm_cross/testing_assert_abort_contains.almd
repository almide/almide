// @contract: C-381
// ALS-T18 (#3747): a failing `testing.assert_contains` OUTSIDE a test block aborts with
// the T18 block (`Error: assertion failed` / `at: line N` / `expected:` /
// `found:`) on stderr and exit 1, byte-identical on both targets. Before:
// native leaked the raw Rust panic (exit 101) and wasm printed a value-less
// `assert_contains failed` line. The passing calls above it print nothing.
import testing

fn main() -> Unit = {
  testing.assert_contains("hello", "ell")
  testing.assert_contains("hello", "")
  println("before")
  testing.assert_contains("line one\nline two", "three")
  println("unreachable")
}
