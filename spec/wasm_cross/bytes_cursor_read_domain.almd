// @contract: C-229
// The `bytes.read_*_at` cursor family over the offset domain — the #1408 rule
// ("a negative offset is the type default for every `bytes.read_*`, never a
// panic") applied to the readers whose default is `(pos, none)`: when the
// window `[pos, pos + width)` leaves the buffer, the POSITION IS UNCHANGED and
// the value is `none`, on every leg, for every width and both endiannesses,
// and for `next_bool`, `next_bytes` and the length-prefixed string cursor
// composed from them alike.
//
// #2479, the residue of #1408: that fix reached the fourteen hand-written
// `set_*` accessors and recorded the readers as already `checked_add`-guarded,
// but the two cursor MACROS (`cursor_read_int!` / `cursor_read_float!`, every
// `read_*_at` of width 1/2/4/8) were not in the set. They cast `pos as usize`
// and ADDED: `read_u32_le_at(b, -2)` computed `usize::MAX - 1 + 4 = 2`, passed,
// and the slice index panicked `range start index 18446744073709551614`
// (exit 101) where both wasm legs answered `-2 none`. The wasm self-host had
// the OTHER end wrong: its `pos + W > n` wrapped for a pos near i64::MAX, so
// `read_u32_le_at(b, i64::MAX)` answered `(i64::MIN + 3, some(0))` there and
// `take_at(b, 2, i64::MAX)` asked the allocator for i64::MAX bytes. This is
// the family matrix: every width at -1, at -width, at -len, at a large
// negative, at i64::MIN, at i64::MAX and its neighbours, at the 2^32 boundary,
// at len - 1 (only the 1-byte reads fit), at len, and at 0 as the in-range
// control that proves the position advances. Float VALUES print as `some`
// only — the decoding is bytes_cursor_test's; the window is what is judged.
fn show_i(label: String, r: (Int?, Int)) -> String = {
  let (v, p) = r
  "${label}=${p}/${v}"
}

fn show_f(label: String, r: (Float?, Int)) -> String = {
  let (v, p) = r
  let tag = match v {
    some(_) => "some",
    none => "none",
  }
  "${label}=${p}/${tag}"
}

fn row(b: Bytes, pos: Int) -> String = {
  [
    show_i("u8", bytes.next_u8(b, pos)),
    show_i("u16le", bytes.next_u16_le(b, pos)),
    show_i("u16be", bytes.next_u16_be(b, pos)),
    show_i("i16le", bytes.next_i16_le(b, pos)),
    show_i("i16be", bytes.next_i16_be(b, pos)),
    show_i("u32le", bytes.next_u32_le(b, pos)),
    show_i("u32be", bytes.next_u32_be(b, pos)),
    show_i("i32le", bytes.next_i32_le(b, pos)),
    show_i("i32be", bytes.next_i32_be(b, pos)),
    show_i("i64le", bytes.next_i64_le(b, pos)),
    show_i("i64be", bytes.next_i64_be(b, pos)),
    show_f("f16le", bytes.next_f16_le(b, pos)),
    show_f("f32le", bytes.next_f32_le(b, pos)),
    show_f("f32be", bytes.next_f32_be(b, pos)),
    show_f("f64le", bytes.next_f64_le(b, pos)),
    show_f("f64be", bytes.next_f64_be(b, pos))
  ] |> list.join(" ")
}

// The length-prefixed string cursor, composed from the checked reads: a u32 BE
// length and that many bytes, `(pos, none)` unless both fit.
fn string_be_at(b: Bytes, pos: Int) -> (Int, String?) = match bytes.next_u32_be(b, pos) {
  (some(n), p) => match bytes.next_bytes(b, p, n) {
    (some(x), q) => (q, some(bytes.to_string_lossy(x))),
    (none, _) => (pos, none),
  },
  (none, _) => (pos, none),
}

fn misc(b: Bytes, pos: Int) -> String = {
  let (v1, p1) = bytes.next_bool(b, pos)
  let (v2, p2) = bytes.next_bytes(b, pos, 2)
  let t2 = match v2 {
    some(x) => "${bytes.to_list(x)}",
    none => "none",
  }
  let (p3, v3) = string_be_at(b, pos)
  "bool=${p1}/${v1} take=${p2}/${t2} sbe=${p3}/${v3}"
}

fn main() -> Unit = {
  let b = bytes.from_list([
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ])
  let hi = 9223372036854775807
  let positions = [
    -1,
    -2,
    -4,
    -8,
    -9,
    -999999,
    0 - hi,
    0 - hi - 1,
    hi,
    hi - 1,
    hi - 3,
    hi - 7,
    4294967296,
    4294967295,
    7,
    8,
    0
  ]
  for pos in positions {
    println("pos ${pos}: ${row(b, pos)}")
  }
  // next_bool / next_bytes / the string cursor on the same domain. The
  // string buffer carries a length prefix of 2 at 0 (`AB`) so the in-range
  // control answers a value; every other position is `none`.
  let s = bytes.from_list([
    0,
    0,
    0,
    2,
    65,
    66,
    7,
    8
  ])
  for pos in positions {
    println("pos ${pos}: ${misc(s, pos)}")
  }
  // take_at's LENGTH is the other half of its window: negative, huge, and
  // huge from a position near the top.
  for n in [
    -1,
    -2,
    0,
    1,
    hi,
    hi - 1,
    0 - hi - 1
  ] {
    let (v, p) = bytes.next_bytes(s, 2, n)
    let t = match v {
      some(x) => "${bytes.to_list(x)}",
      none => "none",
    }
    let (w, q) = bytes.next_bytes(s, hi - 1, n)
    let u = match w {
      some(x) => "${bytes.to_list(x)}",
      none => "none",
    }
    println("take n=${n}: at2=${p}/${t} athi=${q}/${u}")
  }
}
