// @contract: C-096
// The argv reader must work on the WASM target (was an emit ICE) and agree with
// native, built on WASM from WASI args_sizes_get / args_get. The full-argv
// spelling left the stdlib in dialect epoch 15; `env.args()` is argv without
// argv[0]. The cross-target harness runs both legs with NO extra program args,
// so the list is empty on both and this fixture never prints an element
// verbatim.
//
// The heap layout the bug (#645) got wrong — the result List and each inner
// String framed with a 4-byte header instead of the canonical 8-byte
// [len][cap][data] — is read through `list.len` and `list.get(args, 0)`. With
// argv[0] dropped the list is empty under the harness, so the element half of
// the probe (the STRING header) is not reached here; both lines are
// byte-identical.
import env

effect fn main() -> Unit = {
  let args = env.args()
  let first = list.get(args, 0) ?? ""
  println(int.to_string(list.len(args)))
  println(if string.len(first) > 0 then "first-nonempty" else "first-empty")
}
