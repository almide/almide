// @contract: C-292
// gleam test/language/int_test.gleam (~25 cases): int arithmetic with
// negative operands, block precedence, RADIX LITERALS (hex/octal/binary),
// underscore separators, and truncating division (3/2 == 1).
fn eq(x: Bool) -> String = if x then "1" else "0"

fn main() -> Unit = {
  println("${eq(1 + -3 == -2)}${eq(1 - -3 == 4)}${eq(-2 * 4 == -8)}${eq(2 * -4 == -8)}")
  println("${eq(2 * 2 + 3 == 7)}${eq(2 + 2 * 3 == 8)}${eq(2 * (2 + 3) == 10)}${eq((2 + 2) * 3 == 12)}")
  // radix literals all denote the same 15
  let fifteen = 7 + 8
  println("${eq(0xF == fifteen)}${eq(0o17 == fifteen)}${eq(0b00001111 == fifteen)}")
  println("${eq(1_000_000 == 1000000)}${eq(9_223_372_036_854_775_807 == 9223372036854775807)}")
  // truncating division through vars
  let three = 3
  let two = 2
  println(eq(three / two == 1))
  println(eq(1 / 1 == 1))
}
