// @contract: C-054
// The product cell of `bytes.repeat`: a count whose `len * n` WRAPS i64 must be
// judged on the true size, never the wrapped one. `[1, 2, 3]` x
// 6148914691236517206 is 2 in i64, so the wasm legs compared the wrapped
// product against their bound, sized a 2-byte block and the copy loop wrote
// past it into an out-of-bounds trap (exit 134) where native aborted in the
// defined form (#2782, nightly fuzz #2781). The bound is tested by division.
// Since #4154 that bound is the repeat family's shared 2^31-byte ceiling, so
// the wrapped cell ends in `Error: repeat result too large` + exit 1 on every
// leg (it was C-197's `out of memory` before bytes.repeat joined the ceiling).
// The in-range, empty and negative cells come first; the fixture ends at the abort.
import bytes

fn main() -> Unit = {
  let b = bytes.from_list([1, 2, 3])
  println("rep_ok=" + int.to_string(bytes.len(bytes.repeat(b, 4))))
  // An empty base is empty at any count, and a negative count is empty.
  println("rep_empty_max=" + int.to_string(bytes.len(bytes.repeat(bytes.from_list([]), 9223372036854775807))))
  println("rep_neg=" + int.to_string(bytes.len(bytes.repeat(b, 0 - 9223372036854775807))))
  println("rep_wrap=" + int.to_string(bytes.len(bytes.repeat(b, 6148914691236517206))))
  println("unreachable")
}
