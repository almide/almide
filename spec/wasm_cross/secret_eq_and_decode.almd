// @contract: C-424, C-425
// #4107: `==` on Secret[String] and Secret[Bytes] compares the revealed
// values (in constant time), at the top and inside a record, list, option
// and tuple; a Codec record decodes a Secret field from the value's wire
// form, honours a Secret field's default, and still renders it as
// Secret(***).
import json
import secret

type Login = { user: String, pw: Secret[String] }

type LoginInput: Codec = { user: String, password: Secret[String], pin: Secret[Int] = secret.new(0) }

effect fn main() -> Unit = {
  let a = secret.new("s3cret")
  let b = secret.new("s3cret")
  let c = secret.new("other")
  println("${a == b} ${a == c} ${a != c} ${a != b}")
  let la = Login { user: "u", pw: a }
  let lb = Login { user: "u", pw: b }
  let lc = Login { user: "u", pw: c }
  println("${la == lb} ${la == lc}")
  println("${[a, b] == [b, a]} ${[a] == [c]} ${[a] == [a, a]}")
  println("${some(a) == some(b)} ${some(a) == none} ${(1, a) == (1, c)}")
  let k1 = secret.new(bytes.from_string("k1"))
  println("${k1 == secret.new(bytes.from_string("k1"))} ${k1 == secret.new(bytes.from_string("k2"))} ${k1 == secret.new(bytes.from_string("k1x"))}")
  let input = LoginInput.decode(json.parse("{\"user\":\"ana\",\"password\":\"s3cret\"}")!)!
  println("${input}")
  println("${input.password == a} ${secret.reveal(input.pin)}")
  let pinned = LoginInput.decode(json.parse("{\"user\":\"ana\",\"password\":\"x\",\"pin\":42}")!)!
  println("${secret.reveal(pinned.pin)}")
  let missing: Result[LoginInput, String] = LoginInput.decode(json.parse("{\"user\":\"ana\"}")!)
  println("${result.is_err(missing)}")
}
