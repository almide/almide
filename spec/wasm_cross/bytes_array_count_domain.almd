// @contract: C-054
// The `count` of a `bytes.read_*_array` is the OUTPUT size, and its one portable
// rule is: NEGATIVE reads NOTHING. Before this, native read `count as usize`, so
// a negative count became ~1.8e19 and the reader looped that many times, while
// the self-host clamped it to 0 and answered an empty list — one leg answered,
// one leg did not come back.
//
// There is deliberately NO ceiling cell here (ratified A, 2026-08-17): a chosen
// cross-target cap briefly shipped for these readers and was withdrawn — each
// leg allocates to its own structural bound and takes C-197's defined abort
// beyond it, so the over-bound outcome differs by leg and is declared in
// proofs/domain-edges.toml, not pinned as a byte-identical observable.
//
// One reader stands for the family here; the matrix covers all sixteen.
import bytes

fn arr(n: Int) -> String = int.to_string(list.len(bytes.read_i32_le_array(bytes.from_list([1, 2, 3, 4, 5]), 0, n)))

fn main() -> Unit = {
  // In-range: 5 bytes hold one i32; the reader pads past EOF, so the count is
  // the answer.
  println("three=" + arr(3))
  println("zero=" + arr(0))
  // Negative: the empty list, not 1.8e19 iterations.
  println("neg=" + arr(0 - 1))
  println("i32min=" + arr(0 - 2147483648))
  // A large-but-sane count still answers. There is no ceiling cell any more:
  // under the ratified A there IS no chosen ceiling — each leg allocates to its
  // own structural bound and takes C-197's abort beyond it, so an over-bound
  // count is no longer a portable observable this fixture could pin.
  println("large=" + arr(4096))
}
