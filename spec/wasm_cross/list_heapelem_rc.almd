// @contract: C-164
// #850: rc-correct list modifiers and suffix copies over a heap element that is
// neither String nor Value. Every derived list below is held alongside the source
// to scope end, so an un-owned alias would trip the rc_dec sentinel on wasm; the
// final read-back of the source pins that no modifier mutated it.
type Pt = { x: Int, tag: String }

fn cell(p: (Float, Bool)) -> String = float.to_string(p.0) + (if p.1 then "T" else "F")

fn pshow(p: Pt) -> String = int.to_string(p.x) + p.tag

fn ints(xs: List[Int]) -> String = list.join(list.map(xs, int.to_string), "-")

effect fn main() -> Unit = {
  let tup: List[(Float, Bool)] = [(1.0, true), (2.0, false), (3.0, true), (4.0, false)]
  println("tup.remove_at = " + list.join(list.map(list.remove_at(tup, 1), cell), ","))
  println("tup.set       = " + list.join(list.map(list.set(tup, 0, (9.0, false)), cell), ","))
  println("tup.insert    = " + list.join(list.map(list.insert(tup, 2, (7.0, true)), cell), ","))
  println("tup.swap      = " + list.join(list.map(list.swap(tup, 0, 3), cell), ","))
  println("tup.take_end  = " + list.join(list.map(list.take_end(tup, 2), cell), ","))
  println("tup.drop_end  = " + list.join(list.map(list.drop_end(tup, 1), cell), ","))
  println("tup.tail      = " + list.join(list.map(list.tail(tup), cell), ","))
  println("tup.src       = " + list.join(list.map(tup, cell), ","))
  // `update` takes a FUNCTION, not a replacement value — a distinct twin from `set`.
  println("tup.update    = " + list.join(list.map(list.update(tup, 1, (p) => (8.0, true)), cell), ","))
  println("tup.update_oob= " + list.join(list.map(list.update(tup, 99, (p) => (8.0, true)), cell), ","))
  let recs: List[Pt] = [
    Pt { x: 1, tag: "a" },
    Pt { x: 2, tag: "b" },
    Pt { x: 3, tag: "c" }
  ]
  println("rec.remove_at = " + list.join(list.map(list.remove_at(recs, 1), pshow), ","))
  println("rec.set       = " + list.join(list.map(list.set(recs, 0, Pt { x: 9, tag: "z" }), pshow), ","))
  println("rec.tail      = " + list.join(list.map(list.tail(recs), pshow), ","))
  println("rec.src       = " + list.join(list.map(recs, pshow), ","))
  let nested: List[List[Int]] = [
    [1, 2],
    [3],
    [4, 5, 6]
  ]
  println("nest.remove_at= " + list.join(list.map(list.remove_at(nested, 0), ints), "|"))
  println("nest.take_end = " + list.join(list.map(list.take_end(nested, 2), ints), "|"))
  println("nest.swap     = " + list.join(list.map(list.swap(nested, 0, 2), ints), "|"))
  println("nest.src      = " + list.join(list.map(nested, ints), "|"))
  println("nest.update   = " + list.join(list.map(list.update(nested, 1, (v) => [7, 7]), ints), "|"))
}
