// @contract: C-101, C-054
// list.chunk / windows over a List[String] → List[List[String]]. Each cell is DEEP-COPIED into the
// inner chunk (single-owned, no double-free — the bug the generic i64 impl had). The result's
// scope-end Op::DropListListStr recursively frees each cell String + each row + the outer (the
// nested-list-drop machinery was already wired; only this rc-correct producer was missing). The chunk
// counts byte-match native; the recursive drop is leak-free (verified at scale separately).
effect fn main() -> Unit = {
  let xs = ["a", "b", "c", "d", "e"]
  println(int.to_string(list.len(list.chunk(xs, 2))))
  println(int.to_string(list.len(list.chunk(xs, 3))))
  println(int.to_string(list.len(list.chunk(xs, 1))))
  println(int.to_string(list.len(list.windows(xs, 2))))
  let one = ["solo"]
  println(int.to_string(list.len(list.chunk(one, 5))))
  // C-054's negative-count rule on the HEAP-element variants. The Int variants
  // gained their clamps with that contract; these _str twins in the same file
  // were left on the pre-clamp form, so `windows(xs, i32::MIN)` computed
  // `total - n + 1` ≈ 2^31 windows and looped two billion times on wasm against
  // native's instant `[]` (differential fuzz, seed 1785165458340124000 index
  // 803), and a negative chunk count reached an alloc as a negative length.
  // Negative n reads as v0's `n as usize`: chunk → ONE chunk holding
  // everything, windows → n > len → [].
  println(int.to_string(list.len(list.windows(xs, -2147483648))))
  println(int.to_string(list.len(list.windows(xs, -1))))
  println(int.to_string(list.len(list.chunk(xs, -2147483648))))
  println(int.to_string(list.len(list.chunk(one, -1))))
  // The POSITIVE extreme of the same domain, which nothing exercised: the
  // chunk count was `(total + n - 1) / n`, and that sum overflows i64 long
  // before any narrowing happens. At `n = i64::MAX` over a 5-element list the
  // wrap made the count 0, so wasm printed 0 chunks where native printed 1 —
  // both exit 0, so the two legs disagreed in silence; at `i64::MAX - 1` the
  // wrapped count reached the allocator and wasm died out of memory (found by
  // the differential fuzz, seed 510721188963 index 2460, mutating this very
  // file). Ceiling division is `total / n + (total % n != 0)` now, which
  // cannot overflow for a positive n. Int-element twin included: both
  // variants carried the same line.
  println(int.to_string(list.len(list.chunk(xs, 9223372036854775807))))
  println(int.to_string(list.len(list.chunk(xs, 9223372036854775806))))
  println(int.to_string(list.len(list.chunk(one, 9223372036854775807))))
  let ns = [1, 2, 3, 4, 5]
  println(int.to_string(list.len(list.chunk(ns, 9223372036854775807))))
  println(int.to_string(list.len(list.chunk(ns, 9223372036854775806))))
}
