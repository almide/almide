// @contract: C-245, C-246
// ALS-E16/E17 (docs/specs/als/expressions.md): string interpolation —
// `${expr}` segments (variable reference, arithmetic expression, multiple
// segments in one literal), the `\${` literal escape, and per-type display
// (String verbatim, Int decimal, Float canonical, Bool lowercase per
// ALS-E2); and the identifier expression resolving to its nearest binding.
// Identical observables on both targets.
effect fn main() -> Unit = {
  let name = "world"
  let n = 6
  println("hello ${name}")
  println("sum=${1 + 2}")
  println("n*7=${n * 7}")
  println("mix ${name}:${n} end")
  println("escaped \${not_interp}")
  let f = 1.5
  let b = false
  println("float=${f} bool=${b}")
}
