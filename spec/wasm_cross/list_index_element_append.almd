// @contract: C-186
//
// Appending an INLINE index read to a list accumulator — `acc = acc + [xs[i]]`
// — lowers and runs identically on both targets (#888, snaidhm's ttf
// `expand_implied` rotate).
//
// The element TYPE was already admitted (a scalar-only record's block is flat,
// so per-element `rc_dec` is its full free — C-183's physics). What had no
// lowering arm was the element EXPRESSION: an index read. The literal builder
// knew Block / ctor / Var / call elements and not this one, so the append
// declined, which dropped the enclosing `for` to its model-one-iteration
// fallback, which walled the loop variable under STRICT value mode, which
// collapsed the enclosing heap-result `if`. Three layers of fallback turned one
// missing arm into "heap-result `if` outside the executable subset", and a
// CONSUMER of the walled function saw only an unlinked `almide_rt_*` call.
//
// Writing the same thing as `let c = xs[i]` then `acc + [c]` always worked, and
// that is exactly the ownership this arm reproduces: the container keeps owning
// the element, the load is a borrow, and the `Dup` (rc_inc) is what makes the
// handle the literal stores an owned one.

type P = { x: Float, y: Float, on: Bool }

fn rotate_from(ps: List[P], start: Int) -> List[P] = {
  let n = list.len(ps)
  var out: List[P] = []
  for i in 0..<n {
    out = out + [ps[(i + start) % n]]
  }
  out
}

// The heap-result `if` the wall actually surfaced on: one arm returns the input
// list, the other builds a rotated copy.
fn maybe_rotate(ps: List[P], start: Int) -> List[P] =
  if start <= 0 then ps
  else rotate_from(ps, start)

fn show(ps: List[P]) -> String =
  ps |> list.map((p) => float.to_string(p.x)) |> list.join(",")

fn main() -> Unit = {
  let ps = [
    P { x: 1.0, y: 10.0, on: true },
    P { x: 2.0, y: 20.0, on: false },
    P { x: 3.0, y: 30.0, on: true },
  ]

  // Rotation by every offset, so each element is read from a different slot.
  println(show(rotate_from(ps, 0)))
  println(show(rotate_from(ps, 1)))
  println(show(rotate_from(ps, 2)))

  // Through the heap-result `if`, both arms.
  println(show(maybe_rotate(ps, 0)))
  println(show(maybe_rotate(ps, 2)))

  // The SOURCE list is untouched — the append borrows its elements and
  // rc_incs, so a wrong ownership decision here would show up as a freed or
  // mutated original.
  println(show(ps))
  println(int.to_string(list.len(ps)))

  // A second read of the same element in one expression, and an appended
  // element that is a fresh literal next to an indexed one — the two element
  // shapes side by side in one accumulator.
  var mixed: List[P] = []
  for i in 0..<list.len(ps) {
    mixed = mixed + [ps[i]]
    mixed = mixed + [P { x: 0.0, y: 0.0, on: false }]
  }
  println(show(mixed))
  println(int.to_string(list.len(mixed)))

  // The sharpest ownership probe: each source list is built, its elements are
  // appended elsewhere, and then the SOURCE goes out of scope while the copies
  // live on. A missing rc_inc would free the elements out from under `keep`, so
  // a wrong decision here shows up as garbage or a trap rather than as a wall.
  var keep: List[P] = []
  var k = 0
  while k < 8 {
    var src: List[P] = []
    for i in 0..<3 {
      src = src + [P { x: int.to_float(k * 10 + i), y: 0.0, on: true }]
    }
    for i in 0..<3 {
      keep = keep + [src[i]]
    }
    k = k + 1
  }
  println(int.to_string(list.len(keep)))
  println(float.to_string(keep |> list.map((p) => p.x) |> list.fold(0.0, (a, b) => a + b)))
}
