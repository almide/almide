// @contract: C-019
// Regression: wasm had no runtime fn / dispatch arm for run-length encoding
// so the codegen panicked (ICE) instead of emitting. The runs are now a fold
// over `string.to_list`, grouped by CODEPOINT (matching native `s.chars()`).
// ASCII here; the multibyte codepoint-grouping case (formerly byte-granular on
// wasm) is now fixed and pinned by spec/wasm_cross/string_split_rle_codepoint.almd
// (C-050).
// Runs of equal codepoints, folded over `string.to_list` (the stdlib's
// `run_length_encode` left in dialect epoch 15; this is its replacement).
fn run_length_encode(s: String) -> List[(String, Int)] = {
  let init: List[(String, Int)] = []
  string.to_list(s) |> list.fold(init, (runs, c) => match list.last(runs) {
    some((p, n)) => if p == c then list.drop_end(runs, 1) + [(c, n + 1)] else runs + [(c, 1)],
    none => [(c, 1)],
  })
}

fn show(s: String) -> String = run_length_encode(s) |> list.map((r) => {
  let (c, n) = r
  c + int.to_string(n)
}) |> list.join(",")

effect fn main() -> Unit = {
  println(show(""))
  // empty → no runs
  println(show("x"))
  // single char
  println(show("aaabbc"))
  // basic runs
  println(show("aaaa"))
  // one long run
  println(show("abcde"))
  // all distinct
  println(show("aabbaa"))
  // a repeated non-adjacently → separate runs
  // spaces and symbols
  println(show("  ##  "))
}
