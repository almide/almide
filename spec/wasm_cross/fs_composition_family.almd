// @contract: C-228
// The fs composition family answers identically on both targets: single-entry
// remove semantics (non-empty dir errs, file/empty-dir removes, missing errs),
// write_bytes round-trips (from a list and from a built buffer), the recursive
// walk (full paths, dirs included, flat-sorted), rename (round-trip +
// missing-src err), the no-follow is_symlink predicate, and the
// read_*_if_exists twins (missing → none, present → some, through the `!`
// unwrap into an Option match). Temp-dir paths carry entropy suffixes and are never printed.
import fs
import bytes

effect fn main() -> Unit = {
  let d = fs.create_temp_dir("b2")!
  fs.write_bytes(d + "/wb.bin", bytes.from_list([72, 105, 33, 300]))!
  println("wb=${fs.read_text(d + "/wb.bin")!}")
  var raw = bytes.zeros(3)
  bytes.put_u8(raw, 0, 65)
  bytes.put_u8(raw, 1, 66)
  bytes.put_u8(raw, 2, 67)
  fs.write_bytes(d + "/wr.bin", raw)!
  println("wr=${fs.read_text(d + "/wr.bin")!}")
  fs.mkdir_p(d + "/sub/inner")!
  fs.write_text(d + "/sub/a.txt", "x")!
  fs.write_text(d + "/sub/inner/b.txt", "y")!
  let all = fs.walk(d + "/sub")!
  let names = all |> list.map((p) => string.split(p, "/") |> list.last ?? "?")
  println("walk=${list.join(names, ",")} n=${list.len(all)}")
  let rm_nonempty = fs.remove(d + "/sub")
  match rm_nonempty {
    ok(_) => println("rm_nonempty=ok"),
    err(_) => println("rm_nonempty=err"),
  }
  fs.remove(d + "/sub/a.txt")!
  println("gone=${fs.exists(d + "/sub/a.txt")}")
  fs.remove(d + "/sub/inner/b.txt")!
  fs.remove(d + "/sub/inner")!
  println("inner_gone=${fs.exists(d + "/sub/inner")}")
  let rm_missing = fs.remove(d + "/nope")
  match rm_missing {
    ok(_) => println("rm_missing=ok"),
    err(_) => println("rm_missing=err"),
  }
  fs.remove_all(d)!
  let d = fs.create_temp_dir("b3")!
  fs.write_text(d + "/a.txt", "content")!
  fs.rename(d + "/a.txt", d + "/b.txt")!
  println("renamed=${fs.exists(d + "/b.txt")} old_gone=${fs.exists(d + "/a.txt")} body=${fs.read_text(d + "/b.txt")!}")
  let bad = fs.rename(d + "/nope", d + "/x")
  match bad {
    ok(_) => println("badrename=ok"),
    err(_) => println("badrename=err"),
  }
  println("sym_file=${fs.is_symlink(d + "/b.txt")} sym_dir=${fs.is_symlink(d)} sym_miss=${fs.is_symlink(d + "/nope")}")
  fs.remove_all(d)!
  let d = fs.create_temp_dir("ite")!
  fs.write_text(d + "/a.txt", "hello")!
  let present = fs.read_text_if_exists(d + "/a.txt")!
  match present {
    some(t) => println("present=${t}"),
    none => println("present=none"),
  }
  let absent = fs.read_text_if_exists(d + "/nope")!
  match absent {
    some(_) => println("absent=some"),
    none => println("absent=none"),
  }
  fs.remove_all(d)!
  let d = fs.create_temp_dir("ife")!
  fs.write_text(d + "/a.txt", "l1\nl2")!
  let pl = fs.read_lines_if_exists(d + "/a.txt")!
  match pl {
    some(ls) => println("lines=${list.len(ls)} first=${list.get(ls, 0) ?? "?"}"),
    none => println("lines=none"),
  }
  let al = fs.read_lines_if_exists(d + "/no")!
  match al {
    some(_) => println("albs=some"),
    none => println("albs=none"),
  }
  let pb = fs.read_bytes_if_exists(d + "/a.txt")!
  match pb {
    some(xs) => println("bytes=${bytes.len(xs)} b0=${bytes.get(xs, 0) ?? (0 - 1)}"),
    none => println("bytes=none"),
  }
  let ab = fs.read_bytes_if_exists(d + "/no")!
  match ab {
    some(_) => println("abbs=some"),
    none => println("abbs=none"),
  }
  let pr = fs.read_bytes_if_exists(d + "/a.txt")!
  match pr {
    some(b) => println("raw=${bytes.len(b)} r0=${bytes.get(b, 0) ?? (0 - 1)}"),
    none => println("raw=none"),
  }
  let ar = fs.read_bytes_if_exists(d + "/no")!
  match ar {
    some(_) => println("arbs=some"),
    none => println("arbs=none"),
  }
  fs.remove_all(d)!
}
