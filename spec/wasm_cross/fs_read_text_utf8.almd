// @contract: C-290
// #1506: the WASI read floor ($read_text_file) copied a file's bytes into a String
// with NO UTF-8 check, so `fs.read_text` on a non-UTF-8 file returned ok(<raw bytes>)
// on wasm where native (std::fs::read_to_string) returns
// err("stream did not contain valid UTF-8") — and the invalid String then trapped in
// rc_dec downstream (string.chars). A silent wrong Result branch, then a crash.
//
// This pins the text readers (read_text / read_lines / read_text_if_exists) against
// invalid, truncated, surrogate and overlong byte sequences — the exact table Rust's
// str::from_utf8 rejects — and the bytes readers (read_bytes / read_bytes_raw) beside
// them, which must keep handing back the raw bytes. Valid multibyte UTF-8 and ASCII
// stay ok so the fix cannot be "err on every high byte".
import fs

effect fn show(label: String, p: String) -> Unit = {
  println(match fs.read_text(p) {
    ok(v) => "${label} text=ok(${string.len(v)})",
    err(m) => "${label} text=err(${m})",
  })
  println(match fs.read_lines(p) {
    ok(xs) => "${label} lines=ok(${list.len(xs)})",
    err(m) => "${label} lines=err(${m})",
  })
  println(match fs.read_text_if_exists(p) {
    ok(o) => "${label} text_if=ok(${match o { some(v) => "some(${string.len(v)})", none => "none" }})",
    err(m) => "${label} text_if=err(${m})",
  })
  println(match fs.read_bytes(p) {
    ok(bs) => "${label} bytes=ok(${list.len(bs)})",
    err(m) => "${label} bytes=err(${m})",
  })
  println(match fs.read_bytes_raw(p) {
    ok(b) => "${label} raw=ok(${bytes.len(b)})",
    err(m) => "${label} raw=err(${m})",
  })
}

effect fn main() -> Unit = {
  let d = fs.create_temp_dir("utf8")!
  // Latin-1 bytes inside an otherwise-ASCII file (the teastia fixture that found it).
  fs.write_bytes(d + "/latin1.js", [99, 111, 110, 115, 116, 32, 120, 32, 61, 32, 34, 255, 254, 34, 59, 10])!
  // A truncated 3-byte sequence (E2 82 without its third byte).
  fs.write_bytes(d + "/truncated.bin", [226, 130])!
  // A UTF-16 surrogate encoded as UTF-8 (ED A0 80 = U+D800): rejected by the table.
  fs.write_bytes(d + "/surrogate.bin", [237, 160, 128])!
  // An overlong encoding of '/' (C0 AF): rejected by the table.
  fs.write_bytes(d + "/overlong.bin", [192, 175])!
  // Valid 2/3/4-byte UTF-8 ("é", "✓", U+1D11E) and plain ASCII stay readable.
  fs.write_bytes(d + "/valid.txt", [195, 169, 32, 226, 156, 147, 32, 240, 157, 132, 158, 10])!
  fs.write(d + "/ascii.txt", "plain\n")!
  show("latin1", d + "/latin1.js")!
  show("truncated", d + "/truncated.bin")!
  show("surrogate", d + "/surrogate.bin")!
  show("overlong", d + "/overlong.bin")!
  show("valid", d + "/valid.txt")!
  show("ascii", d + "/ascii.txt")!
}
