// gleam record_access_test (#1093) + record_update_test (#1379) +
// tuple_access_test (#1980) + anonymous_function_test (#1637) +
// record_with_field_named_constructor (~14 cases). Record update is spelled
// as explicit re-construction (`P { ..past, … }` spread does not exist);
// the new field READS the old record. Deep tuple chains use the
// parenthesised form — bare `t.0.1` lexes as the float 0.1.
type Person = { name: String, age: Int, country: String }
type Boxc = { constructor: Int }

fn id(x: Int) -> Int = x

fn apply(p: Person, f: (Person) -> String) -> String = f(p)

fn main() -> Unit = {
  let person = Person { name: "Quinn", age: 27, country: "Canada" }
  println("${person.name} ${int.to_string(person.age)}")
  // #1093: access through a HOF parameter
  println(apply(person, (x) => x.name))
  // record update, explicit form; age reads the OLD record (+ #1379's
  // pipe-in-update: the new field value flows through a pipe)
  let present = Person { name: person.name, age: person.age + 1, country: "USA" }
  let piped = Person { name: person.name, age: 6 |> id, country: person.country }
  println("${present.name} ${int.to_string(present.age)} ${present.country}")
  println("${int.to_string(piped.age)} ${person.country}")
  println(if person.age == 27 then "copy" else "aliased")
  // #1980: tuple access, flat and deep (parenthesised chain)
  let tup = (3, 4, 5)
  println(int.to_string(tup.2 * 100 + tup.1 * 10 + tup.0))
  let nest = ((4, 5), (6, 7))
  println(int.to_string((nest.0).1 * 1000 + (nest.1).1 * 100 + (nest.1).0 * 10 + (nest.0).0))
  // struct inside a tuple, tuple inside a struct
  let pair = (person, Person { name: "Nikita", age: 99, country: "Internet" })
  println((pair.1).name)
  // a record FIELD named `constructor` must not confuse codegen
  let bx = Boxc { constructor: 1 }
  let bx2 = Boxc { constructor: 1 }
  println(if bx == bx2 then "eq" else "ne")
  // #1637: a lambda param immediately shadowed by its own let
  let f = (x: Int) => { let x = x
    x }
  println(int.to_string(f(1)))
  // a fn value in a tuple slot, called through the projection
  let t = ((x: Int) => x + 7, 0)
  println(int.to_string((t.0)(5)))
}
