// @contract: C-423
// #4107: a value whose type declares its repr prints through that
// declaration on every renderer, wherever it sits. The canary CANARY4107x is
// planted in Secrets (in a record, a list, an Option, a Result, a tuple and a
// variant payload) and in a plain field that a user `T.repr`
// hides; no stdout or stderr byte of any leg may carry it. The run ends in a
// failing assert_eq over two records holding a Secret, so the T18 block on
// stderr is a renderer too.
import secret

type Account = { name: String, password: String }
fn Account.repr(a: Account) -> String = "Account(${a.name})"

type Login = { user: String, pw: Secret[String], acct: Account }

type Event = | Plain(Int) | Keyed(Secret[String]) | Rec { key: Secret[String], n: Int }

fn main() -> Unit = {
  let s = secret.new("CANARY4107x")
  let acct = Account { name: "ana", password: "CANARY4107x" }
  let l = Login { user: "ana", pw: s, acct: acct }
  println("${s}")
  println("${acct}")
  println("${l}")
  println("${[l, l]}")
  println("${some(s)}")
  let r: Result[Secret[String], String] = ok(s)
  println("${r}")
  println("${(1, s)}")
  println("${[Plain(1), Keyed(s), Rec { key: s, n: 2 }]}")
  println("${[acct]}")
  println("revealed length: ${string.len(secret.reveal(s))}")
  let other = Login { user: "bob", pw: secret.new("CANARY4107x-other"), acct: acct }
  assert_eq(l, other)
}
