// @contract: C-234, C-235
// ALS-E6/E7 (docs/specs/als/expressions.md): parenthesized grouping and the
// unary operators — parens override precedence and are otherwise
// semantically transparent; boolean negation is the keyword `not` (prefix
// `!` is a compile error steering to it — pinned by
// tests/unary_not_diag_test.rs); unary minus applies to literals (ALS-E1
// sign folding), variables, parenthesized expressions, and floats.
// Identical observables on both targets. The `(e,)` 1-tuple half of the
// grouping disambiguation lives in tuple_single.almd (kept apart from
// string interpolation while #1267 stands).
effect fn main() -> Unit = {
  println(int.to_string((1 + 2) * 3))
  println(int.to_string(1 + 2 * 3))
  let b = true
  let nb = not b
  let nn = not not b
  println("${nb} ${nn}")
  println(int.to_string(-(3 + 4)))
  println(int.to_string(-5))
  let x = 7
  println(int.to_string(-x))
  println(float.to_string(-(1.5)))
}
