// @contract: C-229
// Row selectors on an OUT-OF-RANGE schedule: a selected row whose byte range
// leaves the buffer is the ALL-ZERO row (the same defined OOB→zeros edge the
// full-matrix from_bytes_* loaders take, per selected row), a negative rid
// clamps to row 0, and a negative offset clamps to 0 — identically on both
// targets. Found by the fuzzer (run 31515916427, a C-228-fixture mutation):
// native panicked on an unchecked slice while wasm read undefined heap bytes.
//
// "The ALL-ZERO row, identically on both targets" is a claim about BIT PATTERNS,
// so the zeros are observed through the printed lists, which spell the sign
// (`0.0` vs `-0.0`) that `==` cannot see. (The Q1_0 / Q8_0 selectors whose
// dequantization-zero sign this fixture also pinned, #1358, left the stdlib at
// dialect epoch 14 for package almide/nn.)
import matrix
import bytes

effect fn main() -> Unit = {
  var f32d = bytes.new(32)
  bytes.set_f32_le(f32d, 0, 1.5)
  bytes.set_f32_le(f32d, 4, 2.5)
  bytes.set_f32_le(f32d, 8, 0.0 - 3.0)
  bytes.set_f32_le(f32d, 12, 4.0)
  bytes.set_f32_le(f32d, 16, 5.0)
  bytes.set_f32_le(f32d, 20, 6.5)
  bytes.set_f32_le(f32d, 24, 7.0)
  bytes.set_f32_le(f32d, 28, 8.0)
  // offset 8 leaves 3 aligned rows of 8 bytes; rid 3 would read 32..40 — OOB → zeros.
  let a = matrix.select_rows_f32(f32d, 8, 2, [3, 0, 1])
  println("f32_shifted=${matrix.to_lists(a)}")
  // rid 4 reads 32..40 — OOB → zeros; rid -1 clamps to row 0.
  let b = matrix.select_rows_f32(f32d, 0, 2, [4, 0 - 1, 0])
  println("f32_edge=${matrix.to_lists(b)}")
  // a negative offset clamps to 0 (native's `offset.max(0)`).
  let c = matrix.select_rows_f32(f32d, 0 - 8, 2, [0])
  println("f32_negoff=${matrix.to_lists(c)}")
}
