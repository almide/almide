// @contract: C-149
// The custom-E `option.to_result` route (#1114, ADR-0003 D1): a scalar payload
// with a VARIANT error value round-trips through the Result and matches back out
// with its payload intact, byte-identical native == wasm. Before the `_ve` twin,
// the type-blind registry link served the (Int?, String) body to EVERY scalar-A
// instantiation: its `__copy_str` read the VARIANT error block as string bytes,
// the match dispatched over the corrupt copy, and the err path printed NOTHING
// while native printed the payload — a silent wrong value on the verified default, and
// the exact shim-v1 failure mode docs/roadmap/active/selfhost-link-v2.md names.
// Three spellings pin the route: the inline ctor arg, the hoisted ctor, and the
// ok path (`some(7)` — the Ok arm must stay scalar-exact through the same twin).
type LoadError = | Missing(String) | Broken

fn show(r: Result[Int, LoadError]) -> String = match r {
  ok(n) => "ok:" + int.to_string(n),
  err(e) => match e {
    Missing(k) => "missing:" + k,
    Broken => "broken",
  },
}

fn main() -> Unit = {
  let o: Int? = none
  println(show(option.to_result(o, Missing("cfg"))))
  let fallback = Broken
  println(show(option.to_result(o, fallback)))
  println(show(option.to_result(some(7), Missing("unused"))))
}
