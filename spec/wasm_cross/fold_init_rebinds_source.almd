// @contract: C-258
// #2045 review: arguments are taken by value, left to right, so a fold's init
// that rebinds the variable its source names cannot change what is folded —
// the fold walks the list the source evaluated to. Once the wasm leg
// evaluated the source before the init, it held the source block as a bare
// borrow while the init ran; the rebind released that block and the loop
// read freed memory. Every fold-shaped arm is pinned: the plain and fused
// `list.fold`, `list.fold` over `list.enumerate` and `list.scan`, each
// with String elements so a stale read shows.
// #3801: `set.fold` and `map.fold` take their source by reference on
// native, which held a borrow of the variable across the init's rebind and
// rustc refused the program (E0506). Their arms are pinned here too, plus an
// init that reads the source before it rebinds it.
effect fn main() -> Unit = {
  var xs = ["a", "b", "c"]
  let plain = xs |> list.fold({
    xs = ["z"]
    ""
  }, (acc, x) => acc + x)
  println("plain=${plain} now=${list.len(xs)}")
  var ys = ["a", "b", "c"]
  let fused = ys |> list.map((x) => x + "!") |> list.fold(
    {
      ys = ["z"]
      ""
    },
    (acc, x) => acc + x,
  )
  println("fused=${fused} now=${list.len(ys)}")
  var es = ["a", "b", "c"]
  let indexed = list.enumerate(es) |> list.fold(
    {
      es = ["z"]
      0
    },
    (acc, p) => acc + p.0 + string.len(p.1),
  )
  println("indexed=${indexed} now=${list.len(es)}")
  var ss = ["a", "b", "c"]
  let running = ss |> list.scan({
    ss = ["z"]
    ""
  }, (acc, x) => acc + x)
  println("running=${running} now=${list.len(ss)}")
  var st = set.from_list(["a", "b"])
  let in_set = st |> set.fold({
    st = set.from_list(["z"])
    ""
  }, (acc, x) => acc + x)
  println("set=${in_set} now=${set.len(st)}")
  var m = ["a": "1", "b": "2"]
  let in_map = m |> map.fold({
    m = ["z": "9"]
    ""
  }, (acc, k, v) => acc + k + v)
  println("map=${in_map} now=${map.len(m)}")
  var sr = set.from_list(["a", "b", "c"])
  let read_then_rebind = sr |> set.fold(
    {
      let n = set.len(sr)
      sr = set.from_list(["z"])
      "${n}:"
    },
    (acc, x) => acc + x,
  )
  println("set read=${read_then_rebind} now=${set.len(sr)}")
  var mr = ["a": "1"]
  let map_read_then_rebind = mr |> map.fold(
    {
      let n = map.len(mr)
      mr = ["z": "9", "y": "8"]
      "${n}:"
    },
    (acc, k, v) => acc + k + v,
  )
  println("map read=${map_read_then_rebind} now=${map.len(mr)}")
}
