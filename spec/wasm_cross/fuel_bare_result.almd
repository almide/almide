// @contract: C-204, C-205
// T1-3: the BARE forms — `let r = fan.bounded(...)` / `fan.race { ... }`
// without `??` — produce a real Result[T, String] on BOTH targets (native
// rides the Res carrier + the outlined region wrap). The exact 3006/3005ns
// boundary pins that the wrap adds no metered cost to the region.
fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n {
    acc = (acc + i * 7) % 999983
    i = i + 1
  }
  acc
}

effect fn main() -> Unit = {
  let r = fan.bounded(compute.ns(3006)) { heavy(1000) }
  match r {
    ok(v) => println(int.to_string(v)),
    err(e) => println(e),
  }
  let s = fan.bounded(compute.ns(3005)) { heavy(1000) }
  match s {
    ok(v) => println(int.to_string(v)),
    err(e) => println(e),
  }
  let w = fan.race {
    heavy(1000)
    heavy(500)
  }
  match w {
    ok(v) => println(int.to_string(v)),
    err(e) => println(e),
  }
}
