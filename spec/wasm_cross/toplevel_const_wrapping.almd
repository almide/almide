// @contract: C-170
// Integer `+` / `-` / `*` wrap on two's complement in EVERY position — including
// a module-level `let`, and including a debug/`overflow-checks` build.
//
// They were emitted as bare Rust `+`/`-`/`*`, which only delivers the language's
// overflow law in a release profile: under `-C overflow-checks` they panic, and
// in a CONST-EVALUABLE position rustc rejects the program outright. So
// `let OVERFLOW = MAX_COUNT + 9223372036854775807` at module scope failed to
// BUILD after `check` accepted it, while the identical expression in a local
// binding wrapped correctly (differential fuzz).
let MAX_COUNT = 100
let ADD_OVERFLOW = MAX_COUNT + 9223372036854775807
let SUB_OVERFLOW = -9223372036854775808 - MAX_COUNT
let MUL_OVERFLOW = 9223372036854775807 * 3

fn main() -> Unit = {
  println(int.to_string(ADD_OVERFLOW))
  println(int.to_string(SUB_OVERFLOW))
  println(int.to_string(MUL_OVERFLOW))

  // The same expressions as LOCAL bindings — the position must not change the
  // result.
  let m = 100
  println(int.to_string(m + 9223372036854775807))
  println(int.to_string(-9223372036854775808 - m))
  println(int.to_string(9223372036854775807 * 3))

  // Ordinary arithmetic is unaffected.
  println(int.to_string(MAX_COUNT + 1))
  println(int.to_string(MAX_COUNT * 2))
  println(int.to_string(MAX_COUNT - 250))
}
