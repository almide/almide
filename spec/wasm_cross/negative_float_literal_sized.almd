// @contract: C-182
// A NEGATED float literal takes its CONTEXT's type (#890). Lowered as a UnOp
// over a bare-`Float` operand while the result claimed the annotated
// `Float32`, native emitted `-(2.5f64)` into an f32 slot (E0308 — the build
// failed) and wasm read the mismatched slot as `0.0` — a silent wrong value.
// The positive literal already took the context type, which is why only the
// negatives broke. Folded into the literal now, at the context type.
fn take32(f: Float32) -> String = float32.to_string(f)

fn take64(f: Float64) -> String = float.to_string(float.from(f))

// A carrier's payload gives a literal fallback its width before either
// backend runs. The None/Err arms used to retain f64 bits in a Float32 slot.
fn maybe32(b: Bool) -> Float32? = if b then some(-2.5) else none
fn result32(b: Bool) -> Result[Float32, String] = if b then ok(-2.5) else err("missing")

fn main() -> Unit = {
  let a: Float32 = -2.5
  let b: Float64 = -2.5
  let c: Float = -2.5
  println(float32.to_string(a))
  println(float.to_string(float.from(b)))
  println(float.to_string(c))
  println(take32(-1.25))
  println(take64(-1.25))
  // Positives are unchanged, and a negated expression (not a literal) still
  // negates at runtime.
  let p: Float32 = 2.5
  let q: Float = 1.5
  println(float32.to_string(p))
  println(float.to_string(0.0 - q))
  println(float32.to_string(maybe32(true) ?? -7.0))
  println(float32.to_string(maybe32(false) ?? -7.0))
  println(float32.to_string(result32(true) ?? -7.0))
  println(float32.to_string(result32(false) ?? -7.0))
}
