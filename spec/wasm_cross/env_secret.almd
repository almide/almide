// @contract: C-438
// env.secret(name) is env.get(name) with the value born a Secret[String]
// (security table row 20): some(Secret) exactly when env.get answers some,
// none when the name is unset. The value renders as Secret(***) at the top,
// inside the option and inside a record; its == is the constant-time compare
// of the revealed text (C-426); secret.reveal gives back env.get's bytes.
import env
import secret

type Config = { name: String, token: Secret[String] }

effect fn main() -> Unit = {
  env.set("ALMIDE_C438_TOKEN", "s3cret-token")!
  env.set("ALMIDE_C438_EMPTY", "")!
  let tok = env.secret("ALMIDE_C438_TOKEN")!
  println("${tok}")
  match tok {
    some(t) => {
      println("${t} ${Config { name: "svc", token: t }}")
      println("${t == secret.new("s3cret-token")} ${t == secret.new("s3cret-tokem")} ${t == secret.new("s3cret")}")
      let plain = env.get("ALMIDE_C438_TOKEN")!
      println("${some(secret.reveal(t)) == plain} ${string.len(secret.reveal(t))}")
    },
    none => println("unset"),
  }
  let unset = env.secret("ALMIDE_C438_UNSET")!
  let unset_plain = env.get("ALMIDE_C438_UNSET")!
  println("${unset} ${unset_plain}")
  let empty = env.secret("ALMIDE_C438_EMPTY")!
  println("${empty} ${option.is_some(empty)} ${empty == some(secret.new(""))}")
}
