// @contract: C-248, C-249
// ALS-E19/S2 (docs/specs/als/expressions.md): the for-in statement over a
// list (Int accumulate, String element), over a LIST OF TUPLES with head
// destructuring `for (i, v) in …`, and the let-destructure statement
// `let (p, q) = t`. Range heads are pinned by C-238, map iteration by
// C-240 — this fixture pins the list-family heads. Identical observables
// on both targets.
effect fn main() -> Unit = {
  var s = 0
  for x in [3, 1, 4] {
    s = s + x
  }
  println(int.to_string(s))
  for w in ["a", "bb"] {
    println(w)
  }
  let (p, q) = (1, 2)
  var t = 0
  for (i, v) in [(10, 1), (20, 2)] {
    t = t + i * v
  }
  println(int.to_string(t + p + q))
}
