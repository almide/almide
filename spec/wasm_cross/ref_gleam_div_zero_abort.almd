// @contract: C-292
// Trap corner in isolation: division by zero via non-literal operands
// (defeating the constant folder, per gleam's discipline). All three
// targets must abort with the SAME message after the SAME output.
fn denom(n: Int) -> Int = n - n

fn main() -> Unit = {
  println("before")
  println(int.to_string(7 / denom(3)))
  println("after")
}
