// @contract: C-238
// #1400 guard rails: a `let`-bound range whose ONLY use is a `for-in` head takes
// the counting loop instead of materializing a `list.range` block. The cell that
// can ONLY pass by not materializing (4294967294 iterations) lives in
// range_bind_huge.almd — alone, because it is the one cell the reference
// interpreter cannot vote on. Everything here is small enough for all THREE
// oracles, and exists to prove the deferral did not break the shapes
// range_first_class.almd already pins.
//
// The DISQUALIFYING shapes must still materialize and still be correct: a var
// that is also indexed or measured, and a var read by two separate heads. And
// the #1272 shape itself — an EMPTY bound range must iterate zero times, not
// once, on both legs.
fn upper() -> Int = 4

effect fn main() -> Unit = {
  // Exclusive, inclusive, non-zero start, call-typed bound — head-only, so all four
  // take the counting path now.
  let a = 0..<4
  var sa = 0
  for i in a {
    sa = sa + i
  }
  let b = 1...3
  var sb = 0
  for i in b {
    sb = sb + i
  }
  let c = 2..<5
  var sc = 0
  for i in c {
    sc = sc + i
  }
  let d = 0..<upper()
  var sd = 0
  for i in d {
    sd = sd + i
  }
  println("heads=" + int.to_string(sa) + "," + int.to_string(sb) + "," + int.to_string(sc) + "," + int.to_string(sd))
  // DISQUALIFIED, so still materialized: the var is indexed and measured as well as
  // iterated. All three readings must agree with the materializing behaviour.
  let idx = 0..<5
  var si = 0
  for i in idx {
    si = si + i
  }
  println("indexed=" + int.to_string(si) + " at2=" + int.to_string(idx[2]) + " len=" + int.to_string(list.len(idx)))
  // TWO heads over one var: both reads are heads, so the var stays on the counting
  // path and BOTH loops must run. (A deferral that consumed the range once would
  // print the second sum as 0.)
  let twice = 0..<3
  var t1 = 0
  var t2 = 0
  for i in twice {
    t1 = t1 + i
  }
  for i in twice {
    t2 = t2 + i
  }
  println("twice=" + int.to_string(t1) + "," + int.to_string(t2))
  // The #1272 shape: an EMPTY bound range iterates ZERO times. The sentinel stays
  // untouched — a leg that iterated once would print 100.
  let empty = 0..<0
  var e = 99
  for _i in empty {
    e = e + 1
  }
  println("empty=" + int.to_string(e))
  // Nested loops over the SAME bound range.
  let n = 0..<3
  var sn = 0
  for _i in n {
    for _j in n {
      sn = sn + 1
    }
  }
  println("nested=" + int.to_string(sn))
}
