// @contract: C-284
// The list cells of the fallible-HOF matrix beyond the first seven (#3163):
// `list.all(xs, (x) => p(x)!)` and every other callback-taking list fn take a
// fallible callback, as `list.map` always did — first-err short-circuit, one
// carrier per cell (`almide_types::fallible_hofs`). Each cell runs an all-ok
// input and an input with an err in it; the callbacks print every visit, so
// the stop point is part of the output all three judges compare. Before
// #3163 every cell here was E005 ("expects fn(Int) -> Bool") under a hint that
// said the core list HOFs accepted fallible callbacks.
effect fn chk(x: Int) -> Bool = {
  println("  visit " + int.to_string(x))
  if x < 0 then err("neg " + int.to_string(x))!
  else x > 2
}

effect fn key(x: Int) -> Int = {
  println("  key " + int.to_string(x))
  if x < 0 then err("bad key " + int.to_string(x))!
  else x % 3
}

effect fn add(a: Int, x: Int) -> Int = {
  println("  add " + int.to_string(x))
  if x < 0 then err("bad add " + int.to_string(x))!
  else a + x
}

fn ints(xs: List[Int]) -> String = "[" + (xs |> list.map((n) => int.to_string(n)) |> list.join(",")) + "]"

fn show[T](label: String, r: Result[T, String], f: (T) -> String) -> Unit = match r {
  ok(v) => println(label + " ok " + f(v)),
  err(e) => println(label + " err " + e),
}

fn b(v: Bool) -> String = if v then "true" else "false"

fn oi(o: Int?) -> String = match o {
  some(n) => "some " + int.to_string(n),
  none => "none",
}

effect fn main() -> Unit = {
  let good = [1, 3, 5]
  let bad = [1, -2, 3, -4]
  show("any", good |> list.any((x) => chk(x)!), b)
  show("any", bad |> list.any((x) => chk(x)!), b)
  show("all", good |> list.all((x) => chk(x)!), b)
  show("all", bad |> list.all((x) => chk(x)!), b)
  show("count", good |> list.count((x) => chk(x)!), (n) => int.to_string(n))
  show("count", bad |> list.count((x) => chk(x)!), (n) => int.to_string(n))
  show("find_index", good |> list.find_index((x) => chk(x)!), oi)
  show("find_index", bad |> list.find_index((x) => chk(x)!), oi)
  show("partition", good |> list.partition((x) => chk(x)!), (p) => ints(p.0) + ints(p.1))
  show("partition", bad |> list.partition((x) => chk(x)!), (p) => ints(p.0) + ints(p.1))
  show("take_while", [5, 4, 1, -1] |> list.take_while((x) => chk(x)!), ints)
  show("take_while", [5, -4, 1] |> list.take_while((x) => chk(x)!), ints)
  show("drop_while", [5, 4, 1, -1] |> list.drop_while((x) => chk(x)!), ints)
  show("drop_while", [5, -4, 1] |> list.drop_while((x) => chk(x)!), ints)
  show("reduce", good |> list.reduce((a, x) => add(a, x)!), oi)
  show("reduce", bad |> list.reduce((a, x) => add(a, x)!), oi)
  show("reduce", [] |> list.reduce((a: Int, x: Int) => add(a, x)!), oi)
  show("scan", good |> list.scan(10, (a, x) => add(a, x)!), ints)
  show("scan", bad |> list.scan(10, (a, x) => add(a, x)!), ints)
  show("sort_by", [5, 1, 4, 3] |> list.sort_by((x) => key(x)!), ints)
  show("sort_by", [5, -1, 4] |> list.sort_by((x) => key(x)!), ints)
  show(
    "group_by",
    [5, 1, 4, 3] |> list.group_by((x) => key(x)!),
    (m) => map.entries(m) |> list.map((e) => int.to_string(e.0) + ":" + ints(e.1)) |> list.join(" "),
  )
  show("group_by", [5, -1, 4] |> list.group_by((x) => key(x)!), (m) => int.to_string(map.len(m)))
  show("unique_by", [5, 1, 4, 3, 2] |> list.unique_by((x) => key(x)!), ints)
  show("unique_by", [5, -1, 4] |> list.unique_by((x) => key(x)!), ints)
  show("zip_with", list.zip_with([1, 2, 3], [10, 20], (a, x) => add(a, x)!), ints)
  show("zip_with", list.zip_with([1, 2, 3], [10, -20, 30], (a, x) => add(a, x)!), ints)
  show("update", list.update(good, 1, (x) => add(x, 100)!), ints)
  show("update", list.update(good, 7, (x) => add(x, -1)!), ints)
  show("update", list.update(good, 1, (x) => add(x, -1)!), ints)
  show("iterate", list.iterate(1, (x) => add(x, x)!, 4), ints)
  show("iterate", list.iterate(1, (x) => add(x, 0 - x)!, 3), ints)
  // A total callback keeps the total form on the same name.
  println("total all " + b(good |> list.all((x) => x > 0)))
}
