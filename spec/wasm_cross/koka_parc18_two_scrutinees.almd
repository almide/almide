// koka parc18: nested match on a SECOND list inside the first's arm, with
// the inner binding SHADOWING the outer one (z twice) — the taken arm must
// dup the inner z and drop BOTH scrutinees; the fallthrough arms return one
// scrutinee whole while dropping the other.
type SList = | SNil | SCons(String, SList)

fn show(xs: SList) -> String = match xs {
  SCons(h, t) => h + "." + show(t),
  SNil => "$",
}

fn merge_head(xs: SList, ys: SList) -> SList = match xs {
  SCons(z, _) => match ys {
    SCons(z, _) => SCons(z, SNil),
    SNil => xs,
  },
  SNil => ys,
}

fn main() -> Unit = {
  let a = SCons("a1", SCons("a2", SNil))
  let b = SCons("b1", SNil)
  println(show(merge_head(a, b)))
  println(show(merge_head(a, SNil)))
  println(show(merge_head(SNil, b)))
  println(show(merge_head(SNil, SNil)))
}
