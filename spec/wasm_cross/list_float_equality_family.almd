// @contract: C-289
// The Float equality family — unique / dedup / contains / index_of over
// List[Float] — compares with f64 `==` on both targets (#924's 2026-08-16
// fuzz finding, the `list.unique` cell): the generic scalar twins compared
// raw i64 slot bits, which diverges at exactly two cells. `-0.0 == 0.0`
// (bits differ, floats equal) collapses under unique on native but not on
// the bit-compare; `NaN != NaN` (bits can match, floats never equal) keeps
// every NaN on native while the bit-compare deduped them. The division
// below produces the NaN at runtime, so no constant fold hides the
// self-host path.
fn b2s(b: Bool) -> String = if b then "t" else "f"

fn oi2s(o: Int?) -> String = match o {
  some(i) => int.to_string(i),
  none => "n",
}

effect fn main() -> Unit = {
  let z: List[Float] = [0.0 - 0.0, 0.0]
  let nan = 0.0 / 0.0
  let a = int.to_string(list.len(list.unique(z)))
  println("unique ${a}")
  let b = int.to_string(list.len(list.dedup(z)))
  println("dedup ${b}")
  let c = b2s(list.contains(z, 0.0))
  println("contains ${c}")
  let d = oi2s(list.index_of([0.0 - 0.0], 0.0))
  println("index_of ${d}")
  let e = int.to_string(list.len(list.unique([nan, nan, 1.0])))
  println("nan_unique ${e}")
  let f = b2s(list.contains([nan], nan))
  println("nan_contains ${f}")
  let g = int.to_string(list.len(list.dedup([nan, nan, 1.0])))
  println("nan_dedup ${g}")
  let h = int.to_string(list.len(list.unique([100.0, 0.0 - 0.0, 123456789.12345679, 0.0])))
  println("fuzz_cell ${h}")
}
