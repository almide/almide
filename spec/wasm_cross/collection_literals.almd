// @contract: C-239, C-240
// ALS-E11/E12 (docs/specs/als/expressions.md): collection literals and
// indexing — list literal + nesting + `+` concat + `[i]` reads (Int and
// String elements), the square-bracket-colon map literal `["k": v]`, the
// empty spellings `[]` / `[:]`, and `m[k]` returning Option eliminated by
// `??`. Identical observables on both targets.
effect fn main() -> Unit = {
  let xs = [10, 20, 30]
  println(int.to_string(xs[0] + xs[2]))
  let ss = ["x", "y"]
  println(ss[1])
  let nested = [
    [1, 2],
    [3]
  ]
  println(int.to_string(list.len(nested)))
  let ys = [1] + [2, 3]
  println(int.to_string(list.len(ys)))
  let empty: List[Int] = []
  println(int.to_string(list.len(empty)))
  let m = ["a": 1, "b": 2]
  println(int.to_string((m["a"] ?? 0) + (m["b"] ?? 0)))
  let em: Map[String, Int] = [:]
  println(int.to_string(map.len(em)))
  println(int.to_string(m["zz"] ?? -1))
  let ordered = ["z": 1, "a": 2, "m": 3]
  for (k, v) in ordered {
    println("${k}=${int.to_string(v)}")
  }
}
