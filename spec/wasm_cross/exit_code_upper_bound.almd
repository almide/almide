// @contract: C-350
// The last code every leg delivers exits with its own value on every target.
//
// The twin of `exit_code_passthrough.almd`: 125 is the last code the shipped
// preview-1 artifact can deliver, so it must arrive as itself rather than
// being swept into that build's 126..=255 wall. Runtime-valued, and in a
// `guard … else` arm, for the two reasons `exit_code_out_of_range.almd` gives.
import process

effect fn chosen(k: Int) -> Int = k * 25

effect fn main() -> Unit = {
  println("before-exit")
  let code = chosen(5)!
  guard code < 0 else process.exit(code)
  println("unreachable")
}
