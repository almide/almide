// grain pattern_matching.re — guarded_match_1..10, constant_match_2..4:
// guard cascades over tuples and ADT payloads (same-ctor rows falling
// through failed guards, a constant-false guard row, the last-resort row),
// string/tuple constant patterns mixed with guards.
type ADT = | Foo(String, Int) | Bar

fn pick(v: ADT) -> Int = match v {
  Foo(s, n) if s == "abcd" and n == 4 => 42,
  Foo(s, n) if s == "wxyz" and n == 4 => 99,
  Foo(_, _) if false => 90,
  Foo(_, _) => 89,
  Bar => 79,
}

fn tup_guard(a: Int, c: Int) -> Int = match (a, 2, c) {
  (x, _, z) if x == 2 and z == 3 => 42,
  (x, _, _) if x == 1 => 41,
  _ => 99,
}

fn const_mix(s: String, n: Int, b: Bool) -> Bool = match (s, n, b) {
  ("bar", 5, false) => false,
  ("foo", _, true) => false,
  ("foo", _, false) => true,
  _ => false,
}

fn const_guard(p: (String, Int)) -> Bool = match p {
  ("foo", n) if n == 7 => false,
  ("foo", 9) if true => false,
  ("foo", n) if n == 5 => true,
  _ => false,
}

fn str_guard(s: String) -> Bool = match s {
  "foo" if false => false,
  "foo" if true => true,
  _ => false,
}

fn main() -> Unit = {
  println(int.to_string(pick(Foo("abcd", 4))))
  println(int.to_string(pick(Foo("abcd", 3))))
  println(int.to_string(pick(Foo("wxyz", 4))))
  println(int.to_string(pick(Foo("wxyz", 15))))
  println(int.to_string(pick(Bar)))
  println(int.to_string(tup_guard(1, 3)))
  println(int.to_string(tup_guard(2, 3)))
  println(int.to_string(tup_guard(8, 3)))
  println(if const_mix("foo", 5, false) then "T" else "F")
  println(if const_mix("bar", 5, false) then "F2" else "T2")
  println(if const_guard(("foo", 5)) then "T" else "F")
  println(if const_guard(("foo", 7)) then "F2" else "T2")
  println(if str_guard("foo") then "T" else "F")
}
