// @contract: C-004
// #1350: the fan MAPPER slot is effect-CAPABLE, and an effect callback is
// byte-identical native == wasm. The slot's `Ty::Fn` carried `is_effect: false`
// from the landing, which read as "mappers are pure by contract" — the issue
// filed the gap as a three-way disagreement between that declaration, the block
// heads (whose arms DO admit effects), and a wasm wall.
//
// The wall was mis-attributed. Measured 2026-08-14 against 0.57.0, holding the
// call shape constant and varying ONLY the callback, every effect spelling ran
// on both legs; the reported wall came from `http.get`, which has no wasm
// implementation and walls identically with no `fan` in the program at all
// (#1233's per-brick capability ledger). So the mapper slot was relaxed to
// `is_effect: true` to match what it already accepted and executed, and this
// fixture is the evidence that the acceptance is cross-target sound.
//
// Three cells, one per mapper head, covering both callback SPELLINGS — the
// #1055 lesson is that a capability decided by spelling is the bug, so an
// inline lambda over an effect fn and a bare effect-fn VALUE must agree:
//   fan.any   — inline lambda calling an effect fn
//   fan.map   — bare effect-fn value
//   fan.settle— inline lambda, mixed ok/err so the Err capture is exercised
effect fn probe(n: Int) -> Result[Int, String] = if n > 2 then ok(n * 10)
else err("too small: ${int.to_string(n)}")

effect fn main() -> Unit = {
  // any: first Ok in LIST order — 1 fails, 5 wins (NOT 9, and NOT wall-clock).
  let a = fan.any([1, 5, 9], (n) => probe(n))!
  println("any=" + int.to_string(a))
  // map: the bare effect-fn VALUE spelling, all-Ok, order preserved.
  let m = fan.map([3, 4], probe)!
  println("map=" + int.to_string(m[0]) + "," + int.to_string(m[1]))
  // settle: every element's Result in list order, Errs CAPTURED not propagated.
  // `r?` is the Result -> Option narrowing, so filter_map keeps only the Oks —
  // a settle that propagated instead of capturing would never reach this line.
  let s = fan.settle([1, 5, 9], (n) => probe(n))
  let oks = s |> list.filter_map((r) => r?)
  println("settle=" + int.to_string(list.len(s)) + " oks=" + int.to_string(list.len(oks)) + ":" + int.to_string(oks[0]) + "," + int.to_string(oks[1]))
}
