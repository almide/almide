// @contract: C-343
// generated by xtarget-fuzz — composition family
//
// Every probe wraps the literal K in operator round trips that hand the
// same payload back; the fallbacks carry K + 1. Known without running:
// @expect p0=6
// @expect p1=6
// @expect p2=6
// @expect p3=6
type P = { n: Int, s: String }

fn id_int(x: Int) -> Int = x

fn w_ok_int(x: Int) -> Result[Int, String] = ok(x)

fn w_some_int(x: Int) -> Int? = some(x)

fn id_rec(x: P) -> P = x

fn w_ok_rec(x: P) -> Result[P, String] = ok(x)

fn w_some_rec(x: P) -> P? = some(x)

fn id_str(x: String) -> String = x

fn w_ok_str(x: String) -> Result[String, String] = ok(x)

fn w_some_str(x: String) -> String? = some(x)

fn id_tup(x: (Int, String)) -> (Int, String) = x

fn w_ok_tup(x: (Int, String)) -> Result[(Int, String), String] = ok(x)

fn w_some_tup(x: (Int, String)) -> (Int, String)? = some(x)

effect fn probe_0() -> Int = id_int((w_some_int(6) ?? 7))

fn probe_1() -> String = ((match w_some_str((w_some_str(string.repeat("a", 6)) ?? string.repeat("a", 7))) {
  some(v) => v,
  none => string.repeat("a", 7),
}) |> id_str)

effect fn probe_2() -> (Int, String) = ((w_some_tup((6, "t")) ?? (7, "t")) |> id_tup)

effect fn probe_3() -> P = w_ok_rec((w_ok_rec((match w_some_rec(P { n: 6, s: "r" }) {
  some(v) => v,
  none => P { n: 7, s: "r" },
})) ?? P { n: 7, s: "r" }))!

effect fn main() -> Unit = {
  println("p0=" + int.to_string(probe_0()!))
  println("p1=" + int.to_string(string.len(probe_1())))
  println("p2=" + int.to_string(probe_2()!.0))
  println("p3=" + int.to_string(probe_3()!.n))
}
