// @contract: C-199
// A `fan { }` block joins EVERY sibling and reports the first `Err` in LIST ORDER —
// not the first to fail in wall-clock time, and nothing is cancelled.
//
// SPEC.md promised the opposite in two places ("the entire fan fails and siblings are
// cancelled", "fail-fast semantics — first error cancels all siblings") and #1023 is the
// report that neither was observable. The implementation was right and the prose was
// wrong: under deterministic data-parallelism (the answer to #1000,
// docs/roadmap/active/concurrency-stance.md) cancellation MUST NOT exist, because how far
// a cancelled sibling got before it was stopped is a function of scheduling, and that is
// exactly the dependence the model excludes. Joining every sibling and taking the
// list-order Err is what makes the outcome independent of which thread ran first.
//
// Both siblings fail here, so "first to fail" and "first in list order" would differ under
// any wall-clock rule. The abort names the FIRST one, byte-identically on both targets.
effect fn boom(tag: String) -> Result[Int, String] = err("fail:" + tag)

// The implicit effect ABI must carry its Result across the same arm boundary.
effect fn implicit_value(n: Int) -> Int = if n < 0 then err("implicit:${n}") else ok(n)

effect fn implicit_pair(left: Int, right: Int) -> Result[Int, String] = {
  let (a, b) = fan {
    implicit_value(left)
    implicit_value(right)
  }
  ok(a + b)
}

effect fn main() -> Unit = {
  let good: Result[Int, String] = implicit_pair(2, 3)
  let first: Result[Int, String] = implicit_pair(-1, -2)
  let second: Result[Int, String] = implicit_pair(1, -2)
  println("implicit good=${good == ok(5)} first=${first == err("implicit:-1")} second=${second == err("implicit:-2")}")
  let (a, b) = fan {
    boom("first")
    boom("second")
  }
  println("unreachable " + int.to_string(a) + " " + int.to_string(b))
}
