// @contract: C-340
// The Option-read-plus-fallback shape (`list.get(xs, i) ?? d`, `map.get`,
// `bytes.get`) on both targets: a hit answers the element, a miss the
// fallback, and `??` evaluates its fallback only on the miss, so a fallback
// that would abort never runs on a hit. (The eager get-with-default
// trio this fixture pinned before — #1919, fuzz seed 541988714664:692 — left
// the stdlib in dialect epoch 15 with its abort-on-a-hit cells.)
fn main() -> Unit = {
  let xs = [10, 20]
  let m = ["a": 1]
  var b = bytes.zeros(2)
  bytes.put_u8(b, 0, 7)
  println("hits: ${list.get(xs, 1) ?? 0} ${map.get(m, "a") ?? 0} ${bytes.get(b, 0) ?? 0}")
  println("misses: ${list.get(xs, 9) ?? -1} ${map.get(m, "z") ?? -1} ${bytes.get(b, 9) ?? -1}")
  println("lazy fallback keeps going: ${list.get(xs, 0) ?? int.clamp(5, 1, 0)} ${map.get(m, "a") ?? int.clamp(
    5,
    1,
    0,
  )}")
}
