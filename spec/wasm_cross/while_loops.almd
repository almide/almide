// @contract: C-244
// ALS-E15 (docs/specs/als/expressions.md): the while statement — a
// pre-tested condition loop over mutable state: a counter accumulation and
// a data-dependent iteration count (Collatz from 16), identical on both
// targets. break/continue are deliberately absent: they wall in the v1
// renderer (#1277, loud) and their rows stay UNWRITTEN until that brick.
effect fn main() -> Unit = {
  var i = 0
  var s = 0
  while i < 5 {
    s = s + i
    i = i + 1
  }
  println(int.to_string(s))
  println(int.to_string(i))
  var n = 16
  var steps = 0
  while n > 1 {
    n = if n % 2 == 0 then n / 2 else n * 3 + 1
    steps = steps + 1
  }
  println(int.to_string(steps))
}
