// Int edges: i64 boundaries, signed division/modulo corners, parse limits,
// hex parsing, byte truncation through bytes.from_list (the #1505 seam).
fn main() -> Unit = {
  let big = 9223372036854775807
  let small = (0 - 9223372036854775807) - 1
  println("${int.to_string(big)} ${int.to_string(small)}")
  println(int.to_string(big % 10))
  println(int.to_string(small % 10))
  println(int.to_string((0 - 7) / 2))
  println(int.to_string((0 - 7) % 2))
  println(int.to_string(7 / (0 - 2)))
  println(int.to_string(7 % (0 - 2)))
  let p1 = int.parse("9223372036854775807") ?? 0
  let p2 = int.parse("9223372036854775808") ?? (0 - 1)
  let p3 = int.parse("-42") ?? 0
  println("${int.to_string(p1)} ${int.to_string(p2)} ${int.to_string(p3)}")
  println(int.to_string(int.from_hex("ff") ?? 0))
  println(int.to_string(int.from_hex("FFFFFFFFFFFFFFFF") ?? (0 - 1)))
  let bs = bytes.from_list([0, 1, 127, 128, 255, 256, 300, 0 - 1, 0 - 128, 0 - 129])
  var out: List[String] = []
  var i = 0
  while i < bytes.len(bs) {
    list.push(out, int.to_string(bytes.get(bs, i) ?? (0 - 1)))
    i = i + 1
  }
  println(list.join(out, ","))
}
