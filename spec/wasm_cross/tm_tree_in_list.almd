// @contract: C-296
// GENERATED by tools/typematrix/gen.py — the type x operation conformance
// matrix (cell: tree x in_list). Regenerate rather than hand-edit; a cell
// that stops lowering moves to the wall inventory in the same PR.
type T = | Leaf(Int) | Node(List[T])

fn tsum(t: T) -> Int = match t {
  Leaf(n) => n,
  Node(kids) => list.fold(kids, 0, (a, k) => a + tsum(k)),
}

fn main() -> Unit = {
  let xs: List[T] = [
    Node([
      Leaf(1),
      Node([Leaf(2)]),
      Leaf(3)
    ]),
    Leaf(0)
  ]
  println(int.to_string(list.len(xs)))
  let h = list.get(xs, 0)
  println(match h {
    some(v) => int.to_string(tsum(v)),
    none => "-",
  })
}
