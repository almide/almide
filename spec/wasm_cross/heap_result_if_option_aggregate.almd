// @contract: C-287
// #1495: a TAIL-position heap-result `if`/`match` whose arms mix `none` with
// `some(<record literal>)` or `some(<list literal>)` executes the taken arm on
// both targets. The `none` side always lowered; the `some` side's arm router
// lagged the bind-position payload router — an ALL-SCALAR record fell through
// the recursive-drop gate into a heap path with no Record case, and a list
// literal had no arm at all — so `fn found(...) -> Match? = if id < 0 then
// none else some(Match { id: id, len: len })` walled its whole function.
// The dfa package's scanner return is exactly this shape.

type Match = { id: Int, len: Int }

fn found(id: Int, len: Int) -> Match? =
  if id < 0 then none else some(Match { id: id, len: len })

fn hits(n: Int) -> List[Int]? = if n < 0 then none else some([n, n + 1])

fn names(b: Bool) -> List[String]? = if b then some(["a", "bc"]) else none

// The match spelling shares the arm router — pin it too.
fn pick(x: Int) -> Match? = match x > 0 {
  true => some(Match { id: x, len: x * 2 }),
  false => none,
}

effect fn main() -> Unit = {
  match found(1, 2) {
    some(m) => println("f ${int.to_string(m.id)},${int.to_string(m.len)}"),
    none => println("f none"),
  }
  match found(0 - 1, 9) {
    some(m) => println("f ${int.to_string(m.id)}"),
    none => println("f none"),
  }
  match hits(3) {
    some(xs) => println("h ${int.to_string(list.get_or(xs, 0, 0))},${int.to_string(list.get_or(xs, 1, 0))}"),
    none => println("h none"),
  }
  match hits(0 - 1) {
    some(_) => println("h some"),
    none => println("h none"),
  }
  match names(true) {
    some(xs) => println("n ${list.join(xs, "+")}"),
    none => println("n none"),
  }
  match names(false) {
    some(_) => println("n some"),
    none => println("n none"),
  }
  match pick(5) {
    some(m) => println("p ${int.to_string(m.len)}"),
    none => println("p none"),
  }
  match pick(0 - 5) {
    some(_) => println("p some"),
    none => println("p none"),
  }
}
