// koka parc3/parc4: guard chains over a cons list — each arm must drop
// exactly the bindings the others hold (dup x on the taken arm, drop the
// scrutinee and the unused params). Payload-in-Option variant included.
type IList = | INil | ICons(Int, IList)

fn pick3(xs: IList, y: Int, z: Int) -> Int = match xs {
  ICons(x, _) if x == z => x,
  ICons(x, _) if x == y => y,
  ICons(_, _) if y == z => 2,
  ICons(_, _) => y,
  INil => y,
}

// NB: the parc4 shape (guard on a NESTED Option payload pattern) is a
// pinned wall — see walls/nested_payload_guard.almd.

fn main() -> Unit = {
  let xs = ICons(5, ICons(7, INil))
  println(int.to_string(pick3(xs, 9, 5)))
  println(int.to_string(pick3(xs, 5, 9)))
  println(int.to_string(pick3(xs, 4, 4)))
  println(int.to_string(pick3(xs, 8, 9)))
  println(int.to_string(pick3(INil, 3, 4)))
}
