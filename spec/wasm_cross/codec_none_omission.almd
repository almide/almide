// @contract: C-209
// Derived Codec encode OMITS a none Option field (proto3-style unset) instead
// of emitting an explicit null; decode keeps folding missing/null to none, so
// decode(encode(x)) == x while encode(decode(doc)) normalizes the document.
// `Value` passes through verbatim in both directions, which makes
// `Option[Value]` the 3-state escape hatch: missing → none, explicit null →
// some(null), value → some(v). List ELEMENTS keep null (an array position
// cannot be omitted). #1062 / #1058.
import json

type Attr: Codec = { stringValue: Option[String] = none, intValue: Option[String] = none }

type Doc: Codec = { id: String, parent: Option[String], meta: Value, extra: Option[Value], items: List[Value], tags: Option[List[String]] }

fn main() -> Unit = {
  // proto3 oneof via all-Option mirror: exactly one key present.
  println(json.stringify(Attr.encode(Attr { stringValue: some("hi") })))
  println(json.stringify(Attr.encode(Attr { intValue: some("42") })))
  // none omits (parent/extra/tags), Value verbatim (nested null preserved),
  // list elements keep null.
  let sub = json.parse('{"a":[1,2],"b":null}') ?? value.null()
  let d = Doc { id: "d1", parent: none, meta: sub, extra: none, items: [value.int(1), value.null()], tags: none }
  println(json.stringify(Doc.encode(d)))
  // some(...) emits in declaration position; some(null) emits an explicit null.
  let d2 = Doc { id: "d2", parent: some("p"), meta: value.null(), extra: some(value.null()), items: [], tags: some(["a"]) }
  println(json.stringify(Doc.encode(d2)))
  // decode: missing → none for Option fields, EXCEPT Option[Value], which
  // distinguishes absent (none) from explicit null (some(null)).
  match Doc.decode(json.parse('{"id":"x","meta":5,"items":[]}') ?? value.null()) {
    ok(v) => {
      let p = match v.parent {
        some(_) => "some",
        none => "none",
      }
      let e = match v.extra {
        some(_) => "some",
        none => "none",
      }
      let t = match v.tags {
        some(_) => "some",
        none => "none",
      }
      println("missing: parent=${p} extra=${e} tags=${t}")
    },
    err(e) => println("err ${e}"),
  }
  match Doc.decode(json.parse('{"id":"x","meta":5,"items":[],"parent":null,"extra":null,"tags":null}') ?? value.null()) {
    ok(v) => {
      let p = match v.parent {
        some(_) => "some",
        none => "none",
      }
      let e = match v.extra {
        some(x) => "some(" + json.stringify(x) + ")",
        none => "none",
      }
      let t = match v.tags {
        some(_) => "some",
        none => "none",
      }
      println("null: parent=${p} extra=${e} tags=${t}")
    },
    err(e) => println("err ${e}"),
  }
  // Retraction law on the 3-state cell: some(null) survives the roundtrip.
  let x = Doc { id: "rt", parent: none, meta: value.int(1), extra: some(value.null()), items: [value.str("k")], tags: some([]) }
  match Doc.decode(Doc.encode(x)) {
    ok(v) => println("roundtrip " + json.stringify(Doc.encode(v))),
    err(e) => println("rt err ${e}"),
  }
}
