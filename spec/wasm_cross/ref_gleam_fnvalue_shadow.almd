// @contract: C-292
// gleam#2400 + anonymous_function: a parameter that shadows the enclosing
// function's name, called in tail position (self-tail-call rewrite trap);
// closures stored in record fields and called through field access.
type FnBox = { f: (Int) -> Int, tag: String }

fn f(f: () -> Int) -> Int = f()

fn twice(g: (Int) -> Int) -> (Int) -> Int = (x) => g(g(x))

fn main() -> Unit = {
  println(int.to_string(f(() => 1)))
  let b = FnBox { f: (x) => x + 7, tag: "boxed" }
  println(int.to_string(b.f(5)))
  let h = twice(b.f)
  println(int.to_string(h(1)))
  // a function value passed through a variable then applied
  let g = twice
  let k = g((x) => x * 3)
  println(int.to_string(k(2)))
}
