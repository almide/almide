// @contract: C-153
// ALS-T18: the structured failure block survives a MULTI-LINE operand
// byte-identically on both targets. The operand's newlines are written `\n`
// by C-418's rule (#4262), so each field stays one line and no operand can
// forge a line of the block; `almide test` still diffs it line by line.
fn main() -> Unit = {
  let got: String = "line one\nline two\nline three"
  println("before")
  assert_eq(got, "line one\nline TWO\nline three")
  println("unreachable")
}
