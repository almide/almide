  println(if bytes.to_list(rt4) == bytes.to_list(data) then "compress-level-rt-ok" else "compress-level-rt-BAD")
  println(if bytes.to_list(rt5) == bytes.to_list(data) then "deflate-level-rt-ok" else "deflate-level-rt-BAD")
