  println(if bytes.to_string_lossy(zlib.decompress(z)!) == text then "decompress-ka-ok" else "decompress-ka-BAD")
  println(if bytes.to_string_lossy(zlib.inflate(d)!) == text then "inflate-ka-ok" else "inflate-ka-BAD")
  println(if bytes.to_string_lossy(zlib.gunzip(g)!) == text then "gunzip-ka-ok" else "gunzip-ka-BAD")
  let rt1 = zlib.decompress(zlib.compress(data)!)!
  let rt2 = zlib.inflate(zlib.deflate(data)!)!
  let rt3 = zlib.gunzip(zlib.gzip(data)!)!
  let rt4 = zlib.decompress(zlib.compress_level(data, 9)!)!
  let rt5 = zlib.inflate(zlib.deflate_level(data, 1)!)!
  println(if bytes.to_list(rt1) == bytes.to_list(data) then "compress-rt-ok" else "compress-rt-BAD")
  println(if bytes.to_list(rt2) == bytes.to_list(data) then "deflate-rt-ok" else "deflate-rt-BAD")
