// @contract: C-381
// ALS-T18 (#3747): a failing `testing.assert_some` OUTSIDE a test block aborts with
// the T18 block (`Error: assertion failed` / `at: line N` / `expected:` /
// `found:`) on stderr and exit 1, byte-identical on both targets. Before:
// native leaked the raw Rust panic (exit 101) and wasm printed a value-less
// `assert_some failed` line. The passing calls above it print nothing.
import testing

fn find(xs: List[Int], x: Int) -> Int? = xs |> list.find((y) => y == x)

fn main() -> Unit = {
  testing.assert_some(find([1, 2, 3], 2))
  testing.assert_some(some("s"))
  println("before")
  testing.assert_some(find([1, 2, 3], 9))
  println("unreachable")
}
