// @contract: C-062, C-376
import ffi

// Cross-target differential fixture: the Region bridge (ADR-0031). A Region
// carries base, length, permission and owner; every `ffi.read` / `ffi.write`
// is checked against the region's own length before it touches memory, so
// an access outside it is an err on both targets, and a region made from a
// Bytes value refuses every write. The base address differs per target and
// is never printed; only the bytes moved through a region, and the errs, are
// observed, so stdout is byte-identical.
fn show(b: Bytes) -> String = bytes.to_list(b) |> list.map((x) => int.to_string(x)) |> list.join(",")

fn read_text(r: Result[Bytes, String]) -> String = match r {
  ok(b) => "ok " + show(b),
  err(e) => "err " + e,
}

fn write_text(r: Result[Unit, String]) -> String = match r {
  ok(_) => "ok",
  err(e) => "err " + e,
}

// #3420, by ownership: a Region holds its Bytes, so the block outlives every
// view of it — a tail call whose last argument is the block's last use, a
// temporary built inside the argument, a view held in a `let` while another
// block is allocated, and a view that comes out of a helper fn. Each read
// sees the block's own bytes, never a free-list header.
effect fn copy_out(r: Region, n: Int) -> Bytes = ffi.read(r, 0, n)!

effect fn round_trip(s: String) -> Bytes = {
  let b = bytes.from_string(s)
  copy_out(ffi.region(b), bytes.len(b))!
}

effect fn round_trip_temp(s: String) -> Bytes = copy_out(
  ffi.region(bytes.from_string(s)),
  string.len(s),
)!

effect fn round_trip_held(s: String) -> Bytes = {
  let r = ffi.region(bytes.from_string(s))
  let other = bytes.from_string("a block allocated in between")
  copy_out(r, ffi.len(r) + bytes.len(other) - 28)!
}

fn view_of(b: Bytes) -> Region = if bytes.len(b) > 1000000 then ffi.region(bytes.new()) else ffi.region(b)

effect fn round_trip_helper(s: String) -> Bytes = {
  let b = bytes.from_string(s)
  copy_out(view_of(b), bytes.len(b))!
}

fn fillers(tag: String) -> List[Bytes] = list.range(0, 50) |> list.map((i) => bytes.from_string("AAAAAAAAAAAAAAAAAAAAAAA${tag}${i}"))

// #4153, by ownership: rebinding the var a region was made from leaves the
// region's block alone — the region keeps it — and the region stays the
// var's OLD bytes, read-only. Before Regions an address outlived its block
// here and a write through it overwrote a live filler.
effect fn rebind_then_read() -> Unit = {
  var b = bytes.from_string("secret-token-0123456789")
  let r = ffi.region(b)
  b = bytes.from_string("x")
  let filler = fillers("a")
  println("rebind: ${read_text(ffi.read(r, 0, 8))}; ${list.len(filler)}; b=${bytes.len(b)}")
  println("rebind: ${write_text(ffi.write(r, 0, bytes.from_string("PWNED")))}")
}

// Rebound many times in a loop under one region.
effect fn rebind_in_loop() -> Unit = {
  var b = bytes.from_string("loop-held-block-0123456")
  let r = ffi.region(b)
  var i = 0
  while i < 20 {
    b = bytes.from_string("AAAAAAAAAAAAAAAAAAAAAAA${i}")
    i = i + 1
  }
  let filler = fillers("d")
  println("loop: ${read_text(ffi.read(r, 0, 9))}; ${list.len(filler)}; b=${bytes.to_string(b) ?? "?"}")
}

// Grown in place: the var moves to a fresh block, the region keeps the old one.
effect fn grow_in_place() -> Unit = {
  var b = bytes.from_string("grow")
  let r = ffi.region(b)
  var i = 0
  while i < 64 {
    bytes.append_i64_le(b, i)
    i = i + 1
  }
  let filler = fillers("e")
  println("grow: ${read_text(ffi.read(r, 0, 4))}; ${read_text(ffi.read(r, 0, 5))}; ${list.len(filler)}; b=${bytes.len(b)}")
}

// #3966, by construction: the only writable region is a fresh allocation, so
// a write can never reach a `let`.
effect fn write_reaches_no_let() -> Unit = {
  let b = bytes.from_list([1, 2, 3, 4])
  let w = ffi.alloc(4)!
  println("alloc: ${write_text(ffi.write(w, 0, b))}; ${write_text(ffi.write(w, 2, bytes.from_list([9])))}")
  println("alloc: ${read_text(ffi.read(w, 0, 4))}; let ${show(b)}")
  println("alloc: ${write_text(ffi.write(ffi.region(b), 0, bytes.from_list([9])))}; let ${show(b)}")
}

// The bounds check, at every edge: past the end, at the length, a negative
// offset or count, an offset near i64::MAX (no wrap), and an empty region.
effect fn edges() -> Unit = {
  let r = ffi.region(bytes.from_list([65, 66, 67, 68]))
  println("edge: ${read_text(ffi.read(r, 0, 4))}")
  println("edge: ${read_text(ffi.read(r, 1, 4))}")
  println("edge: ${read_text(ffi.read(r, 4, 1))}")
  println("edge: ${read_text(ffi.read(r, 4, 0))}")
  println("edge: ${read_text(ffi.read(r, -1, 1))}")
  println("edge: ${read_text(ffi.read(r, 0, -1))}")
  println("edge: ${read_text(ffi.read(r, 9223372036854775807, 1))}")
  let w = ffi.alloc(3)!
  println("edge: ${write_text(ffi.write(w, 1, bytes.from_list([1, 2, 3])))}")
  println("edge: ${write_text(ffi.write(w, -9223372036854775807, bytes.from_list([1])))}")
  println("edge: ${read_text(ffi.read(w, 0, 3))}")
  let e = ffi.region(bytes.zeros(-1))
  println("empty: ${ffi.len(e)} ${read_text(ffi.read(e, 0, 0))} ${read_text(ffi.read(e, 0, 1))}")
  let neg = match ffi.alloc(-1) {
    ok(_) => "ok",
    err(e) => "err " + e,
  }
  println("alloc: ${neg}")
}

fn slice_text(r: Result[Region, String]) -> String = match r {
  ok(v) => "ok ${ffi.len(v)} writable ${ffi.is_writable(v)}",
  err(e) => "err " + e,
}

// `ffi.slice` narrows a Region inside its parent's bounds: read-only even
// from a writable parent, a view of the parent's memory (a later write to the
// parent shows through it), and holding the parent's block, so the view
// outlives the parent value. Out of range, or a negative argument, is an err.
effect fn slices() -> Unit = {
  let r = ffi.region(bytes.from_list([65, 66, 67, 68]))
  let mid = ffi.slice(r, 1, 2)!
  println("slice: ${read_text(ffi.read(mid, 0, 2))}; ${read_text(ffi.read(mid, 1, 2))}")
  println("slice: ${slice_text(ffi.slice(r, 4, 0))}; ${slice_text(ffi.slice(r, 3, 2))}")
  println("slice: ${slice_text(ffi.slice(r, -1, 1))}; ${slice_text(ffi.slice(r, 0, -1))}")
  println("slice: ${slice_text(ffi.slice(r, 9223372036854775807, 1))}")
  let w = ffi.alloc(4)!
  let view = ffi.slice(w, 1, 3)!
  println("slice: ${slice_text(ffi.slice(w, 1, 3))}; ${write_text(ffi.write(view, 0, bytes.from_list([5])))}")
  println("slice: ${write_text(ffi.write(w, 1, bytes.from_list([6, 7])))}; ${read_text(ffi.read(view, 0, 3))}")
  println("slice: ${slice_text(ffi.slice(view, 1, 3))}; ${read_text(ffi.read(ffi.slice(view, 2, 1)!, 0, 1))}")
  let kept = ffi.slice(ffi.region(bytes.from_string("parent-block-held")), 7, 5)!
  let filler = fillers("s")
  println("slice: ${read_text(ffi.read(kept, 0, 5))}; ${list.len(filler)}")
}

effect fn main() -> Unit = {
  println(show(round_trip("hello, world")!))
  println(show(round_trip("añb")!))
  println(show(round_trip_temp("a temporary")!))
  println(show(round_trip_held("held")!))
  println(show(round_trip_helper("helper")!))
  rebind_then_read()!
  rebind_in_loop()!
  grow_in_place()!
  write_reaches_no_let()!
  edges()!
  slices()!
}
