// @contract: C-278
// The rope_at burn-down (#1423 frontier): `rope_rotate_at` and
// `rope_rotate_neox_at` were native-only — the exact hole the #1419 defect
// family hid in, since no cross-target fixture could ever be written for
// them. Both now have self-host bodies, and this file pins the cells.
//
// It ALSO pins a divergence the burn-down itself surfaced: the self-host
// rope computed inv_freq with the deg-6 fast-exp while native uses
// `1.0 / libm_pow(theta, e)` — bit-divergent at any NON-ZERO exponent
// (0.9899501670824986 native vs 0.9899501671727345 wasm, both exit 0: the
// silent-wrong class). Every prior fixture used head_dim <= 3, whose only
// pair has exponent 0, so the divergence was an unexecuted polarity. The
// self-host now computes `1.0 / math.fpow(theta, e)` — the bit-exact
// vendored-libm pow transcription — and the dim-4 cells here are the pin.
fn row_str(m: Matrix, r: Int, cols: Int) -> String = list.range(0, cols) |> list.map((c) => float.to_string(matrix.get(m, r, c))) |> list.join(",")

fn main() -> Unit = {
  let x = matrix.ones(2, 4)
  // The healed exponent>0 cell: head_dim 4 exercises inv_freq at e = 0.5.
  let plain = matrix.rope_rotate(x, 1, 4, 10000.0)
  println("dim4=" + row_str(plain, 1, 4))
  // start_pos 0 must reproduce the plain spelling exactly.
  let at0 = matrix.rope_rotate_at(x, 2, 2, 10000.0, 0)
  let p22 = matrix.rope_rotate(x, 2, 2, 10000.0)
  println("at0_eq_plain=" + (if row_str(at0, 1, 4) == row_str(p22, 1, 4) then "yes" else "no"))
  // A positive start shifts the absolute position of every row.
  let at5 = matrix.rope_rotate_at(x, 2, 2, 10000.0, 5)
  println("at5_row0=" + row_str(at5, 0, 4))
  // A negative start clamps to 0 (the native `start_pos.max(0)`).
  let neg = matrix.rope_rotate_at(x, 2, 2, 10000.0, 0 - 7)
  println("neg_clamps=" + (if row_str(neg, 1, 4) == row_str(p22, 1, 4) then "yes" else "no"))
  // NeoX pairing: (j, j+half) within the head — a DIFFERENT layout from the
  // interleaved (2i, 2i+1), pinned at a position that actually rotates.
  let nx = matrix.rope_rotate_neox_at(x, 1, 4, 10000.0, 1)
  println("neox=" + row_str(nx, 0, 4))
  // The #1419 geometry rules hold on the _at spellings too: under-coverage
  // copies the tail through (columns 4..5 keep the input).
  let y = matrix.ones(1, 6)
  let under = matrix.rope_rotate_at(y, 1, 4, 10000.0, 3)
  println("under_tail=" + float.to_string(matrix.get(under, 0, 4)) + "," + float.to_string(matrix.get(under, 0, 5)))
}
