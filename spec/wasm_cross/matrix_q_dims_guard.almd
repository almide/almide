// @contract: C-161, C-229
// #1525, the q-family half of #849's ceiling: an element count above the
// shared 2^28 ceiling ABORTS in the unified T6 form — one `Error: matrix
// dimensions too large` line on stderr and exit 1, byte-identical native ==
// wasm. Before, `from_q1_0_bytes` with a huge POSITIVE `cols` took a raw-vec
// `capacity overflow` panic natively (exit 101, the ALS-T6-forbidden form)
// while wasm answered a clean OOM (exit 1) — the v0.57.2 release-gate
// divergence (run 32105580062, seed 513689280998): the #1503 sweep clamped
// this family's negatives but skipped the ceiling. In-ceiling shapes stay on
// the family's defined OOB→zeros edge, so the first call still answers.
import bytes
import matrix

effect fn main() -> Unit = {
  var z = bytes.new(18)
  let m0 = matrix.from_q1_0_bytes(z, 0, 1, 128)
  println("ok: " + int.to_string(matrix.rows(m0)))
  let huge = matrix.from_q1_0_bytes(z, 0, 1, 9223372036854775807)
  println("unreachable: " + int.to_string(matrix.rows(huge)))
}
