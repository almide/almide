// @contract: C-195
// Value-position variant match over a RUNTIME checked-conversion scrutinee
// executes on both targets (#958). Before this brick, `let v = match
// int.from_checked(rt) { some(x) => x, none => -1 }` walled the v1
// renderer whenever the scrutinee could not fold: the checked-conversion
// admission list was maintained point-wise and drifted when #956 completed
// the matrix — `int.from_checked(UInt64)` and every sized-module cell
// (`int8.from_checked(UInt8)`, …) were missing. The family is now admitted by
// SHAPE (numeric module × `from_checked`), gated by the derived
// matrix test `checked_conversion_family_is_admitted`.
//
// `n` is runtime (env.args length = 0 in the harness), so nothing here
// folds; every match reads a real tag at runtime.
import env

fn classify(v: Int) -> String = match int8.from_checked(int64.from(v)) {
  some(x) => "fits ${int.to_string(int64.from(x))}",
  none => "overflows",
}

effect fn main() -> Unit = {
  let n = list.len(env.args())
  // let-bound, some arm taken (the issue's repro (a) shape, unfoldable)
  let small: UInt64 = uint64.from_wrapping(n + 42)
  let a = match int.from_checked(small) {
    some(x) => x,
    none => 0 - 1,
  }
  println(int.to_string(a))
  // let-bound, none arm taken
  let big = int64.from(n + 300)
  let b = match int8.from_checked(big) {
    some(x) => int64.from(x),
    none => 0 - 1,
  }
  println(int.to_string(b))
  // call-arg position
  println(int.to_string(match uint8.from_checked(n + 200) {
    some(u) => int64.from(u),
    none => 0 - 1,
  }))
  // unwrap-! over a sized-module cell (the issue's repro (b) shape)
  let u5 = uint8.from_wrapping(n + 5)
  println(int.to_string(int64.from(int8.from_checked(u5)!)))
  // float carrier cell
  let f = float.from(n + 7)
  println(int.to_string(match int32.from_checked(f) {
    some(x) => int64.from(x),
    none => 0 - 1,
  }))
  // return-position match inside a user fn, both arms exercised
  println(classify(n + 12))
  println(classify(n + 999))
}
