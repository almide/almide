// @contract: C-195
// Value-position variant match over a RUNTIME checked-conversion scrutinee
// executes on both targets (#958). Before this brick, `let v = match
// int.from_uint64_checked(rt) { some(x) => x, none => -1 }` walled the v1
// renderer whenever the scrutinee could not fold: the checked-conversion
// admission list was maintained point-wise and drifted when #956 completed
// the matrix — `int.from_uint64_checked` and every sized-module cell
// (`uint8.to_int8_checked`, …) were missing. The family is now admitted by
// SHAPE (numeric module × `to_/from_*_checked`), gated by the derived
// matrix test `checked_conversion_family_is_admitted`.
//
// `n` is runtime (env.args length = 0 in the harness), so nothing here
// folds; every match reads a real tag at runtime.

import env

fn classify(v: Int) -> String =
  match int64.to_int8_checked(int.to_int64(v)) {
    some(x) => "fits ${int.to_string(x.to_int64())}",
    none => "overflows",
  }

effect fn main() -> Unit = {
  let n = list.len(env.args())

  // let-bound, some arm taken (the issue's repro (a) shape, unfoldable)
  let small: UInt64 = int.to_uint64(n + 42)
  let a = match int.from_uint64_checked(small) {
    some(x) => x,
    none => 0 - 1,
  }
  println(int.to_string(a))

  // let-bound, none arm taken
  let big = int.to_int64(n + 300)
  let b = match int64.to_int8_checked(big) {
    some(x) => x.to_int64(),
    none => 0 - 1,
  }
  println(int.to_string(b))

  // call-arg position
  println(int.to_string(match int.to_uint8_checked(n + 200) { some(u) => u.to_int64(), none => 0 - 1 }))

  // unwrap-! over a sized-module cell (the issue's repro (b) shape)
  let u5 = int.to_uint8(n + 5)
  println(int.to_string(uint8.to_int8_checked(u5)!.to_int64()))

  // float carrier cell
  let f = float.from_int(n + 7)
  println(int.to_string(match float.to_int32_checked(f) { some(x) => x.to_int64(), none => 0 - 1 }))

  // return-position match inside a user fn, both arms exercised
  println(classify(n + 12))
  println(classify(n + 999))
}
