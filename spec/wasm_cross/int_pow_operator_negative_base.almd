// @contract: C-184
//
// The `^` OPERATOR is the same total exponentiation as `math.pow` on BOTH
// targets. The native emit used to render it as `{left}.pow({right} as u32)`,
// an OPERATOR form with two divergences from the wasm leg (which has always
// routed `^` through math.pow):
//
//   * PRECEDENCE — Rust binds a method call tighter than unary minus, so a
//     const-folded negative base rendered `-3i64.pow(2)` == `-(3.pow(2))`
//     == -9 where wasm said 9. Odd exponents agreed by coincidence, which is
//     how this survived to 0.36.0 (#895).
//   * NEGATIVE EXPONENT — `as u32` wrapped `-1` into 4294967295 and computed
//     garbage; wasm aborted. `^` is total (C-047), so it aborts.
//
// Both legs now go through `almide_pow!` / `math.pow`: the same
// exponentiation-by-squaring with wrapping multiply, at the base's own width.
fn main() -> Unit = {
  // Negative base, EVEN exponent — the precedence trap. -3^2 is (-3)*(-3) = 9,
  // never -(3^2).
  let n = 0 - 3
  println(int.to_string(n ^ 2))
  // The same through a literal-folded form, which is what actually reached the
  // emitter as `-3i64.pow(..)`.
  println(int.to_string((0 - 3) ^ 2))
  // Odd exponent: agrees either way, pinned so a regression cannot hide behind
  // the coincidence.
  println(int.to_string(n ^ 3))
  // Sized-int base keeps its OWN width — the accumulator starts at one of the
  // base's type, so this wraps at i32, not i64.
  let a: Int32 = 0 - 3
  println(int32.to_string(a ^ 2))
  // Zero exponent is one; zero base with a positive exponent is zero.
  println(int.to_string(n ^ 0))
  println(int.to_string(0 ^ 5))
  // Wrapping overflow, same as math.pow: 2^64 == 0.
  println(int.to_string(2 ^ 64))
}
