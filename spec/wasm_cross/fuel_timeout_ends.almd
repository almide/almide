// @contract: C-208
// fan.timeout (T5-1, oracle tier): the two DETERMINISTIC ends of the
// wall-clock deadline — a generous deadline always completes (Ok), and a
// DIVERGING body under a tiny deadline is always cut at a charge site (Err,
// the fallback runs, the program continues). Everything between the ends is
// omega-relative (which check fires depends on the host) and is pinned by
// the record/replay gate instead, never by this fixture.
fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n { acc = (acc + i * 7) % 999983; i = i + 1 }
  acc
}

fn spin(n: Int) -> Int = {
  var i = 0
  var acc = n
  while true { acc = (acc + 7) % 999983; i = i + 1 }
  acc
}

effect fn main() -> Unit = {
  let a = fan.timeout(duration.s(10)) { heavy(1000) } ?? -1
  println(int.to_string(a))
  let b = fan.timeout(duration.ms(50)) { spin(1) } ?? -1
  println(int.to_string(b))
  println(int.to_string(42))
}
