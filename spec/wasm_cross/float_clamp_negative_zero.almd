// @contract: C-167
// `float.clamp` returns its INPUT — sign bit included — whenever the input is
// already in range, so `clamp(-0.0, 0.0, hi)` is `-0.0` on both targets.
//
// The self-hosted implementation was `fmin(fmax(n, lo), hi)`, which is not what
// Rust's `f64::clamp` does: wasm's `f64.max` is specified to prefer the POSITIVE
// zero when both operands are zero, so the wasm leg returned `+0.0` where native
// returned `-0.0` — a sign flip on a value the equivalence claim covers
// (differential fuzz). Written as the comparison chain `f64::clamp` actually is,
// the sign rides through untouched.
fn main() -> Unit = {
  // The case that diverged: an in-range negative zero against a `0.0` lower bound.
  println("${float.clamp(-0.0, 0.0, 1000000.0)}")
  println("${float.clamp(-0.0, -1.0, 1.0)}")
  // Both bounds still clamp.
  println("${float.clamp(5.0, 0.0, 3.0)}")
  println("${float.clamp(-5.0, 0.0, 3.0)}")
  // In-range values pass through.
  println("${float.clamp(1.5, 0.0, 3.0)}")
  // NaN fails both comparisons and lands on the upper bound — the same result
  // the `fmin`/`fmax` form produced, so this is unchanged.
  println("${float.clamp(0.0 / 0.0, 0.0, 3.0)}")
  // The neighbouring min/max follow IEEE-754-2019 zero ordering (C-049:
  // max tie -> +0, min tie -> -0): this contract is about `clamp` alone.
  println("${float.max(-0.0, 0.0)}:${float.min(-0.0, 0.0)}")
}
