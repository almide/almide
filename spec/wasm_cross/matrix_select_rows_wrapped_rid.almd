// @contract: C-229
// A selected row id near i64::MAX is past the buffer, so it is the all-zero row
// on the selector (the Q1_0 / Q8_0 siblings that shared the rule left the
// stdlib at dialect epoch 14). Every leg tested the window as
// `off + rid·row_bytes + row_bytes > len`, and `rid·row_bytes` wrapped to
// `-row_bytes`: with `offset = row_bytes` the window landed on row 0, passed,
// and BOTH targets answered row 0's values for an out-of-range row (#2677).
// With `offset = 0`, native sliced from a wrapped start and panicked while wasm
// read the bytes before the buffer (fuzz-nightly run 36244677099 on
// v0.64.0-rc1, seed 579914833587 index 9386). Row 0 is nonzero here, so a
// window that wraps onto it prints its values instead of zeros.
import matrix
import bytes

// The f32 row selector (it left the stdlib for module nn.kernels of package almide-graphics/nn in
// dialect epoch 15), composed from the loader and the gather: decode the whole
// aligned rows after the offset (a negative offset reads from 0), then gather
// them (an out-of-range id is the all-zero row, a negative id is row 0).
fn select_rows_f32(b: Bytes, offset: Int, cols: Int, ids: List[Int]) -> Matrix = {
  let off = int.max(offset, 0)
  let rows = int.max(bytes.len(b) - off, 0) / (4 * cols)
  let m = matrix.from_bytes_f32_le(b, off, rows, cols) ?? matrix.zeros(0, cols)
  matrix.gather_rows(m, ids |> list.map((i) => int.max(i, 0)))
}

effect fn main() -> Unit = {
  var f32d = bytes.zeros(8)
  bytes.put_f32_le(f32d, 0, 1.5)
  bytes.put_f32_le(f32d, 4, 2.5)
  let mf = select_rows_f32(f32d, 4, 1, [9223372036854775807, 0])
  println("f32=${matrix.to_lists(mf)}")
}
