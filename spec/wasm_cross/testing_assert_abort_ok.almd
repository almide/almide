// @contract: C-381
// ALS-T18 (#3747): a failing `testing.assert_ok` OUTSIDE a test block aborts with
// the T18 block (`Error: assertion failed` / `at: line N` / `expected:` /
// `found:`) on stderr and exit 1, byte-identical on both targets. Before:
// native leaked the raw Rust panic (exit 101) and wasm printed a value-less
// `assert_ok failed` line. The passing calls above it print nothing.
import testing

fn main() -> Unit = {
  testing.assert_ok(int.parse("42"))
  testing.assert_ok((ok(["x"]): Result[List[String], String]))
  println("before")
  testing.assert_ok((err("bad input"): Result[Int, String]))
  println("unreachable")
}
