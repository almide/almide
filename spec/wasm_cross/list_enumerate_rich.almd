// @contract: C-288
// #1496: `list.enumerate` over a RICH-variant list executes on both targets.
// The router used to send any non-String heap element to the deliberately
// unregistered `list.enumerate_h`, walling the whole function — the honest
// refusal, because the pair list's drop had no route that recursed into the
// element. The route is now registered (the rc-share fill is identical to
// enumerate_str's) and the result drop-routes to the generated
// `$__drop_list_int_<V>`; an element class the drop generator cannot name
// still walls, as `list.enumerate_x`. Source stays live after the enumerate —
// the rc-share must co-own, not alias.

type Node = | Leaf(Int) | Tag(String) | Chain(List[Node])

fn show(n: Node) -> String = match n {
  Leaf(k) => "L${int.to_string(k)}",
  Tag(s) => "T${s}",
  Chain(xs) => "C${int.to_string(list.len(xs))}",
}

effect fn main() -> Unit = {
  let src = [Leaf(1), Tag("ab"), Chain([Leaf(2), Tag("z")])]
  let es = list.enumerate(src)
  for e in es {
    let (i, n) = e
    println("${int.to_string(i)}:${show(n)}")
  }
  println(show(list.get_or(src, 2, Leaf(0))))
}
