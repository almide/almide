// @contract: C-161
// An r×0 matrix keeps its r rows on both targets. `zeros(3, 0)` and a
// `from_bytes_*` whose width clamps from a negative to 0 have empty data but
// a row count of r: `rows` answers r and `to_lists` answers r empty rows.
// The native row iterator was `data.chunks(cols.max(1))`, which yielded no
// rows at all for empty data — `to_lists` printed `[]` while `rows` said 3
// and the wasm leg printed `[[], [], []]` (differential fuzz, seed
// 544254236199 index 170, a mutation of matrix_from_bytes_offset_domain).
// The converse holds too: a 0×c matrix has NO columns — `shape` is (0, 0)
// and `cols` is 0 whatever width the constructor was asked for. The wasm
// byte loaders and `select_rows_f32` wrote the requested width into the
// header and answered (0, 3) where native answered (0, 0) (#2627,
// differential fuzz seed 576831800136 index 11987).
fn shape(m: Matrix) -> String = "rows=${matrix.rows(m)} cols=${matrix.cols(m)} lists=${matrix.to_lists(m)}"

fn dims(m: Matrix) -> String = {
  let (r, c) = matrix.shape(m)
  "(${r}, ${c})"
}

fn main() -> Unit = {
  let f = bytes.new(8)
  println("zeros3x0: ${shape(matrix.zeros(3, 0))}")
  println("zeros1x-1: ${shape(matrix.zeros(1, -1))}")
  println("zeros0x3: ${shape(matrix.zeros(0, 3))}")
  println("ones2x0: ${shape(matrix.ones(2, 0))}")
  println("f32 2x0: ${shape(matrix.from_bytes_f32_le(f, 0, 2, 0))}")
  println("f32 past-end 1xMIN: ${shape(matrix.from_bytes_f32_le(f, 8, 1, -9223372036854775808))}")
  println("f16 1x-1: ${shape(matrix.from_bytes_f16_le(f, 0, 1, -1))}")
  println("f64 1x-1: ${shape(matrix.from_bytes_f64_le(f, 0, 1, -1))}")
  println("lists3x0: ${shape(matrix.from_lists([
    [],
    [],
    []
  ]))}")
  println("add3x0: ${shape(matrix.add(matrix.zeros(3, 0), matrix.zeros(3, 0)))}")
  let b3 = matrix.to_bytes_f32_le(matrix.from_lists([
    [0.5, 1.5, 2.5]
  ]))
  println("zeros0x3 shape: ${dims(matrix.zeros(0, 3))}")
  println("f32 0x3: ${shape(matrix.from_bytes_f32_le(b3, 0, 0, 3))}")
  println("f32 0x3 off1: ${dims(matrix.from_bytes_f32_le(b3, 1, 0, 3))}")
  println("f32 0x3 empty buf: ${dims(matrix.from_bytes_f32_le(bytes.new(0), 0, 0, 3))}")
  println("f16 0x3: ${shape(matrix.from_bytes_f16_le(b3, 0, 0, 3))}")
  println("f64 0x3 past-end: ${shape(matrix.from_bytes_f64_le(b3, 99, 0, 3))}")
  println("select none x3: ${shape(matrix.select_rows_f32(b3, 0, 3, []))}")
  println("transpose3x0: ${shape(matrix.transpose(matrix.zeros(3, 0)))}")
}
