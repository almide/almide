// @contract: C-221
// A NAMED fn referenced as a VALUE rides the SAME carrier semantics the
// lambda fixture pins (#1148): an effect fn's value IS the
// `(A) -> Result[B, String]` closure on every leg — annotated let, pipe,
// unannotated let, and the effect param slot — and a PURE named fn filling
// an effect slot is ok-wrapped. The err path propagates through `!` to
// main's unified abort, byte-identically.
effect fn parse_twice(s: String) -> Int = {
  let n = int.parse(s)!
  n * 2
}

fn pure_len3(s: String) -> Int = string.len(s) * 3

effect fn apply_slot(f: effect (String) -> Int, s: String) -> Int = f(s)!

effect fn main() -> Unit = {
  let h: effect (String) -> Int = parse_twice
  let a = h("21")!
  let b = ("10" |> h)!
  let g = parse_twice
  let c = g("4")!
  let d = apply_slot(parse_twice, "3")!
  let p: effect (String) -> Int = pure_len3
  let e = p("ab")!
  let f = apply_slot(pure_len3, "abcd")!
  println("${a} ${b} ${c} ${d} ${e} ${f}")
  let boom = h("bad")!
  println("unreachable ${boom}")
}
