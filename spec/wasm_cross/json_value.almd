// @contract: C-031
import json

fn main() -> Unit = {
  // Parse array
  let arr = json.parse("[1, 2, 3, 4, 5]") ?? value.null()
  let items = value.as_array(arr) ?? []
  println(int.to_string(list.len(items)))
  // Parse object + get
  let obj = json.parse('{"name":"almide","version":42}') ?? value.null()
  let name = value.field(obj, "name") ?? value.null()
  let name_str = value.as_string(name) ?? "?"
  println(name_str)
  let ver = value.field(obj, "version") ?? value.null()
  let ver_int = value.as_int(ver) ?? -1
  println(int.to_string(ver_int))
  // Nested
  let nested = json.parse('{"data":{"x":10}}') ?? value.null()
  let data = value.field(nested, "data") ?? value.null()
  let x = value.field(data, "x") ?? value.null()
  let x_val = value.as_int(x) ?? -1
  println(int.to_string(x_val))
  // Stringify roundtrip
  let v = json.parse("[true, false, null]") ?? value.null()
  println(value.stringify(v))
  // Missing key
  let missing = value.field(obj, "nonexistent") ?? value.null()
  let r = value.stringify(missing)
  println(r)
}
