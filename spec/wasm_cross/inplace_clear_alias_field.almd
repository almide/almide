// @contract: C-033
// The alias-observes-clear shape over a RECORD FIELD (#2465): `string.clear(r.name)`
// / `bytes.clear(r.buf)` / `list.clear(r.xs)` / `map.clear(r.m)` on a local
// record var, and the same four through a `mut` record parameter. A record
// alias bound before the clear keeps every field. The structural leg refuses
// the string field receiver (`string-clear-nonvar`), so the default route
// serves this fixture from the incumbent: the incumbent's clear rewrite
// (`rewrite_clear`) routes a field receiver through FieldAssign — the C-132
// mut-param write-back shape `list.push(h.xs, v)` already takes — instead of
// the shared-block self-host twin that cleared the alias's field on 0.62.0.
// tests/incumbent_clear_alias_test.rs holds native, the default route and the
// forced incumbent to the same bytes; the var shapes are the sibling
// inplace_clear_alias.almd.
type R = { name: String, buf: Bytes, xs: List[Int], m: Map[String, Int] }

fn wipe_record(mut r: R) -> Unit = {
  string.clear(r.name)
  bytes.clear(r.buf)
  list.clear(r.xs)
  map.clear(r.m)
}

fn show(r: R) -> String = "[" + r.name + "] " + int.to_string(bytes.len(r.buf)) + " " + int.to_string(list.len(r.xs)) + " " + int.to_string(map.len(r.m))

fn main() -> Unit = {
  // C. a record field: the record alias keeps its field.
  var m0: Map[String, Int] = map.new()
  map.insert(m0, "k", 1)
  var r = R { name: "hi", buf: bytes.from_list([1, 2]), xs: [7, 8, 9], m: m0 }
  let r2 = r
  string.clear(r.name)
  bytes.clear(r.buf)
  list.clear(r.xs)
  map.clear(r.m)
  println("C.r=" + show(r) + " r2=" + show(r2))
  // D. a record field through a mut record parameter.
  string.push(r.name, "x")
  r.buf = bytes.from_list([5])
  list.push(r.xs, 6)
  r.m = m0
  let r3 = r
  wipe_record(r)
  println("D.r=" + show(r) + " r3=" + show(r3))
}
