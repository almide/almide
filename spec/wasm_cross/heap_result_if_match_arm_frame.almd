// @contract: C-106
// A heap-result `if` whose THEN arm is a `match <call(temp)> {..}` (the yaml parse_number 0x shape):
// `if starts_with(c,"0x") then match int.parse_radix(string.drop(c,2), 16) { ok(n)=>value.int(n), err=>.. }
// else value.string(c)`. The `string.drop(c,2)` arg temp is materialized in the THEN arm; it must be
// freed WITHIN that arm (inside the wasm `then`), not at the function scope-end — else the ELSE path
// ("hello", not 0x) hits an UNCONDITIONAL rc_dec of an uninitialized local = rc_dec(0) trap. Byte-
// matches v0 for both arms.
import json

fn pn(c: String) -> Value =
  if string.starts_with(c, "0x") then match int.parse_radix(string.drop(c, 2), 16) {
    ok(n) => value.int(n),
    err(_) => value.string(c),
  } else value.string(c)

fn main() -> Unit = {
  println(json.stringify(pn("hello")))
  println(json.stringify(pn("0xff")))
}
