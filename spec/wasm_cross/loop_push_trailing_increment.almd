// @contract: C-131
// The Hang-finding shape (#796): a `list.push` that is NOT the loop body's
// last statement. The temp list's drop then trails the increment, and the
// exact-5-op self-append window missed it — every push stayed a full-copy
// concat, O(n²) in time (the doubling variant effectively hung the wasm leg:
// ~100 minutes where native finishes instantly). The widened window scans the
// straight-line region for the trailing drop (occ == 3 proves nothing between
// references the temp), so this shape appends in place, amortized O(1).
fn main() -> Unit = {
  var cur: List[Int] = [1, 2, 3]
  var w = 0
  while w < 12 {
    var merged: List[Int] = []
    let n = list.len(cur)
    var j = -128
    while j < n * 2 {
      list.push(merged, j)
      j = j + 1
    }
    cur = merged
    w = w + 1
  }
  // n_{k+1} = 2·n_k + 128, n_0 = 3  ⇒  n_12 = 131·2^12 − 128
  println(int.to_string(list.len(cur)))
}
