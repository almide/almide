// @contract: C-183
// A loop-carried append of a LIST-OF-SCALAR-RECORDS (`gs = gs + [build(i)]`
// where the element is `List[P]` and `P` has only scalar fields) executes on
// both targets (#888 — snaidhm's ttf `contours = contours + [pts]`). The inner
// list is a block of FLAT element blocks, so the nested two-level drop sweep
// is exact: it frees each inner element, each inner block, then the outer.
type P = { x: Int, y: Int, on: Bool }

fn build(n: Int) -> List[P] = {
  var ps: List[P] = []
  for i in 0..n {
    ps = ps + [{ x: i, y: i * 2, on: i == 1 }]
  }
  ps
}

fn groups(n: Int) -> List[List[P]] = {
  var gs: List[List[P]] = []
  for i in 0..n {
    gs = gs + [build(i)]
  }
  gs
}

fn main() -> Unit = {
  let ps = build(3)
  println(int.to_string(list.len(ps)))
  let gs = groups(3)
  println(int.to_string(list.len(gs)))
  // Read back through both levels so a wrong element handle would show.
  let inner = list.get_or(gs, 2, [])
  println(int.to_string(list.len(inner)))
  println(int.to_string(list.get_or(ps, 2, { x: -1, y: -1, on: false }).y))
}
