// @contract: C-155
// The IN-DOMAIN wide half: a `to_fixed` precision LARGER than the value's exact
// decimal expansion must pad with zeros, byte-identically on both targets.
//
// The dragon fixed-mode self-host generated `n = k + nd` digits into a scratch
// buffer sized for an f64's ~1074-digit exact expansion (1104 bytes). Any `nd`
// past that ran off the end and `__dgf_render` copied adjacent heap back out —
// native printed trailing zeros where wasm printed block headers, first differing
// at char ~1106 (differential-fuzz, seed 1784965210163815000). The buffer is now
// sized for the whole domain: k ≤ 309 plus nd ≤ 4096 plus the carry digit.
//
// The pre-existing hi-domain fixture could not catch this: it truncated the
// expansion to its first 6 characters, far before the boundary. These cases read
// ACROSS the boundary — the segment 1060..1140 straddles it exactly.
fn main() -> Unit = {
  let a = float.to_fixed(1.5, 4096)
  println("len   = ${string.len(a)}")
  println("cross = ${string.slice(a, 1060, 1140)}")
  println("tail  = ${string.slice(a, 4080, 4098)}")

  // A large magnitude drives k up, so `n` reaches its maximum.
  let b = float.to_fixed(1.7976931348623157e308, 4096)
  println("big.len   = ${string.len(b)}")
  println("big.cross = ${string.slice(b, 1400, 1460)}")

  // A subnormal drives k down, so the leading zeros path is exercised wide.
  let c = float.to_fixed(5.0e-324, 4096)
  println("sub.len   = ${string.len(c)}")
  println("sub.cross = ${string.slice(c, 1060, 1120)}")

  // Negative, and a rounding-carry case, both past the boundary.
  let d = float.to_fixed(0.0 - 12345.6789, 3000)
  println("neg.len   = ${string.len(d)}")
  println("neg.cross = ${string.slice(d, 1060, 1120)}")

  let e = float.to_fixed(0.999999, 2048)
  println("carry.len = ${string.len(e)}")
  println("carry.cross = ${string.slice(e, 1060, 1120)}")
}
