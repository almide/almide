// @contract: C-296
// GENERATED by tools/typematrix/gen.py — the type x operation conformance
// matrix (cell: tree x eq). Regenerate rather than hand-edit; a cell
// that stops lowering moves to the wall inventory in the same PR.
type T = | Leaf(Int) | Node(List[T])

fn tsum(t: T) -> Int = match t {
  Leaf(n) => n,
  Node(kids) => list.fold(kids, 0, (a, k) => a + tsum(k)),
}

fn main() -> Unit = {
  let a: T = Node([
    Leaf(1),
    Node([Leaf(2)]),
    Leaf(3)
  ])
  let b: T = Node([
    Leaf(1),
    Node([Leaf(2)]),
    Leaf(3)
  ])
  let c: T = Leaf(0)
  println(if a == b then "eq" else "ne")
  println(if a == c then "eq" else "ne")
}
