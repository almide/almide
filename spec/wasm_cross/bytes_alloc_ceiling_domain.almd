// @contract: C-197
// The four bytes allocators' PORTABLE cells: negative pads are the input
// unchanged, in-range allocations answer, and `chunks` computes its count
// without the `(total + size - 1)` rounding trick, whose sum overflows for a
// large `size` — `bytes.chunks(b, i64::MAX)` is ONE chunk, not a wrapped count
// (the identical ceiling-division defect `list.chunk` had).
//
// What is deliberately NOT here (ratified A, 2026-08-17): an over-bound
// allocation cell. A chosen 2 GiB cross-target ceiling briefly shipped for
// these four and was withdrawn — a nine-compiler survey found zero precedent
// (../almide-references/RESEARCH-allocation-ceilings.md), and the cap cut 2-4
// GiB allocations that 0.57.0 satisfied on BOTH legs. Each leg now allocates to
// its own structural bound and fails beyond it in C-197's single form (`Error:
// out of memory`, exit 1) — measured on 0.57.0's wasm leg for 2.5 GiB, u32::MAX
// and i64::MAX alike, never a raw trap. Native success where wasm's bound is
// smaller is the contracted divergence C-197 itself declares.
import bytes

fn main() -> Unit = {
  let b = bytes.from_list([1, 2])
  // Negative target: the input, unchanged. Was an allocation abort on native.
  println("pad_neg=" + int.to_string(bytes.len(bytes.pad_left(b, 0 - 1, 9))))
  println("pad_min=" + int.to_string(bytes.len(bytes.pad_right(b, 0 - 9223372036854775807, 9))))
  // In range: the pad still happens.
  println("pad_ok=" + int.to_string(bytes.len(bytes.pad_right(b, 5, 9))))
  // new: in range answers, over the ceiling is C-197's abort.
  println("new_ok=" + int.to_string(bytes.len(bytes.new(8))))
  // repeat: the ceiling is on the PRODUCT, tested by division — `blen * n` is
  // the multiplication that overflows, so a guard computed from it tests nothing.
  println("rep_ok=" + int.to_string(bytes.len(bytes.repeat(b, 3))))
  // chunks: a size past the buffer is ONE chunk, not a wrapped count.
  println("chunks_max=" + int.to_string(list.len(bytes.chunks(bytes.from_list([1, 2, 3]), 9223372036854775807))))
  println("chunks_ok=" + int.to_string(list.len(bytes.chunks(bytes.from_list([1, 2, 3]), 2))))
}
