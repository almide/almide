// @contract: C-067
// The FULL-i64 clause: an index >= 2^32 must abort, not wrap into range. The
// scalar read/write guards compared `i32.wrap_i64(idx)` first, so `xs[2^32+1]`
// truncated to `xs[1]` and silently read/wrote the wrong slot where native
// aborts. The compare now runs on the full i64 (len < 2^31, so the
// zero-extended len compare is exact). In-bounds access stays correct.
effect fn main() -> Unit = {
  var xs = [10, 20, 30]
  xs[1] = 99
  println(int.to_string(xs[1]))
  println(int.to_string(xs[0]))
  println(int.to_string(xs[4294967297]))
}
