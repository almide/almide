// @contract: C-222
// #1183: an expression-NESTED scalar `!` — inside an assign's concat-list
// element, a binop operand, straight-line or in a `for` body — PROPAGATES the
// err identically on both legs. Before the ANF hoist the wasm leg read the
// err block's payload slot as the element value (released 0.56.0 printed
// `ok2: 8457` for the loop sum below — a silent wrong value) while native
// propagated.
fn conv(s: String) -> Int! = int.parse(s)

fn collect(s: String) -> List[Int]! = {
  var out: List[Int] = []
  out = out + [
    conv(s)!
  ]
  out
}

fn sum_all(xs: List[String]) -> Int! = {
  var total = 0
  for x in xs {
    total = total + conv(x)!
  }
  total
}

effect fn main() -> Unit = {
  match collect("7") {
    ok(v) => println("collect ok: ${list.len(v)}"),
    err(e) => println("collect err: ${e}"),
  }
  match collect("x") {
    ok(v) => println("collect2 ok: ${list.len(v)}"),
    err(e) => println("collect2 err: ${e}"),
  }
  match sum_all(["1", "2", "3"]) {
    ok(n) => println("sum ok: ${n}"),
    err(e) => println("sum err: ${e}"),
  }
  match sum_all(["1", "x"]) {
    ok(n) => println("sum2 ok: ${n}"),
    err(e) => println("sum2 err: ${e}"),
  }
}
