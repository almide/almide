// @contract: C-116, C-413
// float.parse on the IEEE 754 special spellings inf / infinity / nan (case-insensitive, optional
// sign). They once diverged (native accepted, the v1 self-host refused), then both legs accepted
// them; since C-413 (#4121) float.parse is FINITE-ONLY and every leg refuses them as
// `invalid float literal`, so each special row prints ERR. Normal floats + junk (infx/na) unaffected.
fn show(s: String) -> String = match float.parse(s) {
  ok(v) => float.to_string(v),
  err(e) => "ERR",
}

effect fn main() -> Unit = {
  println(show("inf"))
  println(show("-inf"))
  println(show("Infinity"))
  println(show("INF"))
  println(show("nan"))
  println(show("NaN"))
  println(show("  +inf  "))
  println(show("3.14"))
  println(show("1e3"))
  println(show("infx"))
  println(show("na"))
}
