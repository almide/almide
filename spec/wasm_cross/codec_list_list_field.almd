// @contract: C-298
// A List[List[String]] Codec field with jagged and EMPTY inner lists — the
// nested-unkeyed-container shape; empties must survive the round trip.
import json

type G: Codec = { grid: List[List[String]], rows: Int }

effect fn main() -> Unit = {
  let g = G { grid: [
    ["a", "b"],
    [],
    ["c"]
  ], rows: 3 }
  let enc = json.stringify(G.encode(g))
  println(enc)
  let d = G.decode(json.parse(enc)!)!
  println(int.to_string(list.len(d.grid)))
  println(match list.get(d.grid, 1) {
    some(inner) => "mid=" + int.to_string(list.len(inner)),
    none => "-",
  })
  println(match list.get(d.grid, 2) {
    some(inner) => list.join(inner, ""),
    none => "-",
  })
}
