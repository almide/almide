// @contract: C-197
// An allocation NEITHER target can satisfy takes the SAME defined abort on
// both: `Error: out of memory` on stderr, exit 1 — never a raw Rust
// allocator SIGABRT on native (fuzz seed 500705518626 index 711) and never
// an OOB fault on wasm. Output printed before the exhaustion survives
// byte-identically.
fn main() -> Unit = {
  let small = bytes.from_list([1, 2, 3])
  println("before ${bytes.len(small)}")
  let huge = bytes.new(9223372036854775807)
  println("unreachable ${bytes.len(huge)}")
}
