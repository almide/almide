// @contract: C-158
// #1579: a Result tuple whose element is a variant returns the real pair
// whatever the CASE-PAYLOAD SPELLING (record `Down { d: Int }` vs positional
// `Down(Int)` — one registered constructor resolves both; only the
// owned-heap-field router keyed on the Call kind) and whatever the SLOT MIX
// (the second measured axis: a SCALAR first slot beside a heap-payload
// variant — `(Int, RNote("a", n))!` — declined the variant-pair family,
// whose slot classes covered variants/records/String/Bytes but not a raw
// scalar; the ctor now stores the scalar directly and the generated
// `$__drop_vp_scalar_<B>` skips that slot, since an rc_dec there would dec
// a non-handle). The mixed pair's 2000-iteration churn is leak-free under a
// 256 KB heap cap (measured while landing; the carrier spelling cannot loop
// — `!` in a loop body is its own subset).
type A = { x: Int }

type V = | Won { n: Int } | Lost

type W = | Up | Down { d: Int }

type RT = | RQuiet | RNote(String, Int)

type RR = | Quiet | Note { s: String, d: Int }

fn rec_var(n: Int) -> (A, W)! = {
  (A { x: n }, Down { d: n + 1 })
}

fn var_var(n: Int) -> (V, W)! = {
  (Won { n: n }, Down { d: n + 1 })
}

fn guarded(n: Int) -> (A, W)! = {
  guard n > 0 else err("neg")
  (A { x: n }, Down { d: n + 1 })
}

fn guarded_x(n: Int) -> Int! = {
  let s = guarded(n)!
  s.0.x
}

fn mixed_tup(n: Int) -> (Int, RT)! = {
  (n, RNote("a-" + int.to_string(n), n + 1))
}

fn mixed_rec(n: Int) -> (Int, RR)! = {
  (n * 2, Note { s: "b-" + int.to_string(n), d: n + 2 })
}

effect fn main() -> Unit = {
  let p = rec_var(41)!
  println("${p.0.x}")
  // 41
  let pw = p.1
  match pw {
    Up => println("up"),
    Down { d } => println("${d}"),
  }
  // 42
  let q = var_var(41)!
  let qv = q.0
  match qv {
    Won { n } => println("${n}"),
    Lost => println("lost"),
  }
  // 41
  let ok_x = guarded_x(41) ?? -1
  println("${ok_x}")
  // 41
  let err_x = guarded_x(-1) ?? -1
  println("${err_x}")
  // -1 — the err path takes the fallback
  let m = mixed_tup(41)!
  println("${m.0}")
  // 41
  let mv = m.1
  match mv {
    RQuiet => println("quiet"),
    RNote(s, d) => println("${s}-${d}"),
  }
  // a-41-42
  let r = mixed_rec(41)!
  println("${r.0}")
  // 82
  let rv = r.1
  // b-41-43
  match rv {
    Quiet => println("quiet"),
    Note { s, d } => println("${s}-${d}"),
  }
}
