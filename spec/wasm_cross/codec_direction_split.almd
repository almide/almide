// @contract: C-435
// C-435: `Codec` is `Encode + Decode`. A `: Decode` type derives `decode`
// (and, for a record, `decode_strict`) and no `encode`; a `: Encode` type
// derives `encode` and no `decode`; a `: Codec` type derives both. The derived
// halves answer exactly as the `: Codec` derive's do (ALS-D6): lenient
// `decode` ignores an unknown key, `decode_strict` refuses it, a variant is
// externally tagged, a record nests its own input type.
import json

type TagInput: Decode = { label: String }

type NameInput: Decode = { name: String, tags: List[TagInput] = [], nick: String? }

type Shape: Decode = | Dot | Sized(Int) | Pair(Int, Int)

type Report: Encode = { title: String, count: Int, note: String? }

type Note: Codec = { text: String }

effect fn main() -> Unit = {
  let v = json.parse("{\"name\":\"m\",\"zz\":1,\"tags\":[{\"label\":\"a\",\"extra\":true}]}")!
  println(match NameInput.decode(v) {
    ok(i) => "decode ok ${i.name} tags=${list.len(i.tags)} nick=${i.nick ?? "-"}",
    err(e) => "decode err ${e}",
  })
  println(match NameInput.decode_strict(v) {
    ok(i) => "strict ok ${i.name}",
    err(e) => "strict err ${e}",
  })
  println(match NameInput.decode(json.parse("{\"tags\":[]}")!) {
    ok(i) => "missing ok ${i.name}",
    err(e) => "missing err ${e}",
  })
  for src in ["{\"Sized\":[3]}", "{\"Dot\":null}", "{\"Pair\":[1,2]}", "{\"Tri\":1}"] {
    println(match Shape.decode(json.parse(src)!) {
      ok(s) => "shape ${s}",
      err(e) => "shape err ${e}",
    })
  }
  println(json.stringify(Report.encode(Report { title: "t", count: 2, note: none })))
  println(json.stringify(Report.encode(Report { title: "u", count: 0, note: some("n") })))
  let n = Note.decode(json.parse("{\"text\":\"hi\",\"zz\":0}")!)!
  println(json.stringify(Note.encode(n)))
}
