// @contract: C-292
// koka #894: TWO SEQUENTIAL statement-position matches where an arm calls a
// 2-ARG function — the second match's dispatch was corrupted by the first
// arm's multi-arg call (the 1-arg spelling passed). Both spellings side by
// side; every branch prints so a misdispatch is visible.
type MyVal = | MStr(String) | MInt(Int)

fn my_get(doc: List[(String, MyVal)], key: String) -> Option[MyVal] = {
  let hit = list.find(doc, (e) => match e { (k, _) => k == key })
  option.map(hit, (e) => match e { (_, v) => v })
}

fn check1(b: Bool) -> String = if b then "ok" else "FAIL"

fn check2(b: Bool, msg: String) -> String = if b then "ok:" + msg else "FAIL:" + msg

fn main() -> Unit = {
  let doc: List[(String, MyVal)] = [("title", MStr("hello")), ("count", MInt(42))]
  var out: List[String] = []
  match my_get(doc, "title") {
    some(MStr(v)) => list.push(out, check2(v == "hello", "title")),
    some(MInt(_)) => list.push(out, check2(false, "type")),
    none => list.push(out, check2(false, "missing")),
  }
  match my_get(doc, "count") {
    some(MInt(n)) => list.push(out, check2(n == 42, "count")),
    some(MStr(_)) => list.push(out, check2(false, "type")),
    none => list.push(out, check2(false, "missing")),
  }
  println(list.join(out, " "))
  // 1-arg control, same sequence
  var c: List[String] = []
  match my_get(doc, "title") {
    some(MStr(v)) => list.push(c, check1(v == "hello")),
    _ => list.push(c, check1(false)),
  }
  match my_get(doc, "count") {
    some(MInt(_)) => list.push(c, check1(true)),
    _ => list.push(c, check1(false)),
  }
  println(list.join(c, " "))
}
