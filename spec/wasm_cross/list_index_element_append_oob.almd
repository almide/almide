// @contract: C-186
// The EXHAUST side of the inline-index-read element arm: `keep + [src[i]]`
// with `i` OUT OF BOUNDS must abort "Error: index out of bounds" + exit 1 on
// BOTH targets BEFORE anything is appended or printed. The arm's original
// manual address arithmetic (`h + 12 + i*8`) had no bounds check, so wasm
// loaded a garbage handle from the empty list's payload, Dup'd it, printed a
// fully-populated list, and died later with a bare trap (exit 134) while
// native aborted at the read (xtarget-fuzz seed=20260817 index=11180, a
// mutation of list_index_element_append.almd). The fix routes the arm through
// the len-checked `$elem_addr_chk`, the same checker every user-facing scalar
// index read already used.
type P = { x: Float, y: Float, on: Bool }

fn main() -> Unit = {
  var keep: List[P] = []
  var src: List[P] = []
  keep = keep + [src[0]]
  println(int.to_string(list.len(keep)))
}
