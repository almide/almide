// @contract: C-181
// The `args` module's whole surface behaves identically on both targets, with
// `positional(options)` returning EVERY non-flag argument (#891 — it dropped the
// first, because `env.args()` already excludes argv[0] and the body dropped
// one more). The flag/option lookups are written as recursions rather than
// combinators over CAPTURING lambdas: a capture inside a BUNDLED module
// mislowers on wasm (#892), which garbled `${args.has_flag(..)}` to a truncated
// string.
import args
import env

effect fn main() -> Result[Unit, String] = {
  println("args=" + list.join(env.args(), ","))
  println("pos=" + list.join(args.positional(["out"])!, ","))
  println("flag_q=${args.has_flag("quiet")!}")
  println("flag_v=${args.has_flag("verbose")!}")
  println("opt=" + (args.option("out")! ?? "NONE"))
  println("opt_missing=" + (args.option("nope")! ?? "NONE"))
  ok(())
}
