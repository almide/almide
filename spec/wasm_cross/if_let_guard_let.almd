// @contract: C-224
// `if let` / `guard let` over HEAP payloads, records and a heap Err — pinned
// byte-identical on both legs. Until this fixture the two constructs had
// spec/lang tests (scalar and String, all at fn-body top level) but ZERO
// presence in the byte corpus, so "both legs agree" was untested for exactly
// the shapes where it is hard: a heap payload bound across an early exit, a
// record payload projected in the then-branch, and an Err arm whose message
// block must be released on the path not taken.
//
// The loop form (`for … { guard let … else { continue } }`) is NOT here: it
// walls honestly on the wasm leg (break/continue in a for body is a declared
// frontier) and is regression-tested natively in spec/lang/guard_let_test.almd,
// where it panicked the COMPILER until #1204.
// Shape sweep: heap payloads, early exit, loops, records, heap-Err.
type Cfg = { name: String, port: Int }

fn heap_bind(xs: List[String]) -> String = {
  guard let head = list.first(xs) else { "EMPTY" }
  head + "!"
}

fn heap_exit(xs: List[String]) -> String = {
  guard let head = list.first(xs) else { "fallback-" + "made" }
  head
}

fn iflet_heap(o: String?) -> String = if let s = o {
  s + "/then"
} else {
  "else"
}

fn iflet_rec(o: Cfg?) -> String = if let c = o {
  c.name + ":" + int.to_string(c.port)
} else {
  "no-cfg"
}

fn guard_rec(o: Cfg?) -> Int = {
  guard let c = o else { 0 - 1 }
  c.port + string.len(c.name)
}

fn heap_err(r: Result[Int, String]) -> String = if let v = r {
  int.to_string(v)
} else {
  "E"
}

effect fn main() -> Unit = {
  println(heap_bind(["a", "b"]))
  println(heap_bind([]))
  println(heap_exit(["zz"]))
  println(heap_exit([]))
  println(iflet_heap(some("payload")))
  println(iflet_heap(none))
  println(iflet_rec(some(Cfg { name: "svc", port: 8080 })))
  println(iflet_rec(none))
  println(int.to_string(guard_rec(some(Cfg { name: "abc", port: 7 }))))
  println(int.to_string(guard_rec(none)))
  println(heap_err(ok(42)))
  println(heap_err(err("boom")))
}
