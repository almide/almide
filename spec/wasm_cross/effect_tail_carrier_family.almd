// @contract: C-281
// The effect-fn ok-tail CARRIER matrix — {what makes the fn can-err} x {tail
// type}. An `effect fn -> T` returns `Result[T, String]`, so every ok exit must
// leave the body wrapped in that carrier. The wrap has two sources: the `!`
// propagation rewrite (which wraps the tail it threads) and the shared ABI
// retype. The retype wrapped the Unit tail explicitly and the Option family
// (#1410), and left the SCALAR tail to "the machinery downstream" — which is
// the propagation rewrite, so it only ran when the fn was can-err BECAUSE of a
// `!`. A fn made can-err by a bare `err(..)` has no propagation to piggyback
// on: its root was retyped to the carrier while its tail stayed a raw scalar,
// the callee returned i64 where every consumer read an i32 Result block, and
// the module failed wasm VALIDATION (almide#1431 — `almide check` accepted,
// native ran correctly, and the wasm artifact was invalid: exactly the
// acceptance-gap class). The retype now wraps every non-Unit return position.
//
// All four cells below run identically on both legs; the two `!` cells are the
// regression pins that the widened wrap does not DOUBLE-wrap what the
// propagation rewrite already wrapped.
effect fn bare_err_scalar_tail(x: Int) -> Int = {
  let sub: Result[Int, String] = err("charlie")
  match sub {
    ok(_v) => println("unreachable-ok"),
    err(_e) => println("bare/scalar: err arm"),
  }
  7
}

effect fn bare_err_unit_tail(x: Int) -> Unit = {
  let sub: Result[Int, String] = err("delta")
  match sub {
    ok(_v) => println("unreachable-ok"),
    err(_e) => println("bare/unit: err arm"),
  }
}

effect fn prop_scalar_tail(x: Int) -> Int = {
  let n = int.parse("7")!
  n + x
}

effect fn prop_unit_tail(x: Int) -> Unit = {
  let n = int.parse("7")!
  println("prop/unit: " + int.to_string(n + x))
}

effect fn main() -> Unit = {
  match bare_err_scalar_tail(0) {
    ok(v) => println("bare/scalar ok=${int.to_string(v)}"),
    err(_e) => println("bare/scalar UNEXPECTED err"),
  }
  match bare_err_unit_tail(0) {
    ok(_v) => println("bare/unit ok"),
    err(_e) => println("bare/unit UNEXPECTED err"),
  }
  match prop_scalar_tail(1) {
    ok(v) => println("prop/scalar ok=${int.to_string(v)}"),
    err(_e) => println("prop/scalar UNEXPECTED err"),
  }
  match prop_unit_tail(2) {
    ok(_v) => println("prop/unit ok"),
    err(_e) => println("prop/unit UNEXPECTED err"),
  }
}
