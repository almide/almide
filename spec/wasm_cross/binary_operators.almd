// @contract: C-267
// ALS-E29 (docs/specs/als/expressions.md): the binary operator surface —
// Int arithmetic including the SIGNED division/remainder rulings
// (-7 / 3 = -2 truncating toward zero, -7 % 3 = -1 taking the dividend's
// sign), Float addition, the overloaded `+` on String and List, the six
// comparisons, `==`/`!=` on Int and String, the `and`/`or`/`not` keywords,
// and `**`. Identical observables on both targets.
effect fn main() -> Unit = {
  println(int.to_string(7 + 3))
  println(int.to_string(7 - 3))
  println(int.to_string(7 * 3))
  println(int.to_string(7 / 3))
  println(int.to_string(7 % 3))
  println(int.to_string(-7 / 3))
  println(int.to_string(-7 % 3))
  println(float.to_string(1.5 + 0.25))
  println("cat" + "dog")
  println(int.to_string(list.len([1, 2] + [3])))
  println("${7 < 3} ${7 <= 7} ${7 > 3} ${3 >= 7}")
  println("${7 == 7} ${7 != 7} ${"a" == "a"}")
  println("${true and false} ${true or false} ${not true}")
  println(int.to_string(2 ^ 10))
}
