// @contract: C-223
// #1197 step 2: `matrix.softmax_rows` / `gelu` / `swiglu_gate` compute their
// transcendental with the CANONICAL fast-exp on BOTH legs — the native SIMD
// kernel and the wasm self-host now run the same unfused algorithm, the same
// reduction order (one left-to-right sum over the stored exps), and the same
// scaling spelling (reciprocal-multiply, not divide). Each of those three was
// worth a byte: before the port this program printed
// `0.1454055037778682` on native and `0.1454055037792031` on wasm.
// VARIED values are the point — the corpus's older matrix fixtures feed
// `matrix.ones`, whose uniform rows cancel every one of these differences.
effect fn main() -> Unit = {
  let m = matrix.from_lists([
    [0.7, 1.3, 2.1],
    [0.4, 1.9, 0.11],
    [3.7, 0.03, 1.55]
  ])
  println("${matrix.to_lists(matrix.softmax_rows(m))}")
  let wide = matrix.from_lists([
    [
      -40.0,
      0.25,
      17.5,
      -3.75,
      9.0,
      0.0,
      2.5
    ]
  ])
  println("${matrix.to_lists(matrix.softmax_rows(wide))}")
  println("${matrix.to_lists(matrix.gelu(m))}")
}
