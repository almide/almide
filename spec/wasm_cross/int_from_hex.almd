// @contract: C-028
// Cross-target differential fixture: hex parsing through `int.parse_radix(s, 16)`
// (the hex-only parser left the stdlib in dialect epoch 15). The input is
// trimmed, takes one optional sign, then one optional `0x` / `0X`, then hex
// digits. The inputs are the old fixture's quirk set — `0x` prefixes in both
// cases and repeated, an underscore, surrounding whitespace, signs before and
// after a prefix, empty input, the i64 rails — and both legs must answer the
// same `ok` / err text.
fn show(label: String, r: Result[Int, String]) -> Unit = {
  match r {
    ok(v) => println(label + " ok:" + int.to_string(v)),
    err(e) => println(label + " err:" + e),
  }
}

fn main() -> Unit = {
  show("ff", int.parse_radix("ff", 16))
  show("FF", int.parse_radix("FF", 16))
  show("0xff", int.parse_radix("0xff", 16))
  show("0Xff", int.parse_radix("0Xff", 16))
  show("0X10", int.parse_radix("0X10", 16))
  show("0x0xff", int.parse_radix("0x0xff", 16))
  show("0x0x0x10", int.parse_radix("0x0x0x10", 16))
  show("f_f", int.parse_radix("f_f", 16))
  show("ws", int.parse_radix("  ff  ", 16))
  show("-ff", int.parse_radix("-ff", 16))
  show("+ff", int.parse_radix("+ff", 16))
  show("0x-ff", int.parse_radix("0x-ff", 16))
  show("-0xff", int.parse_radix("-0xff", 16))
  show("empty", int.parse_radix("", 16))
  show("0x", int.parse_radix("0x", 16))
  show("0x0x", int.parse_radix("0x0x", 16))
  show("plus", int.parse_radix("+", 16))
  show("z", int.parse_radix("z", 16))
  show("00xff", int.parse_radix("00xff", 16))
  show("max", int.parse_radix("7fffffffffffffff", 16))
  show("over", int.parse_radix("8000000000000000", 16))
  show("min", int.parse_radix("-8000000000000000", 16))
}
