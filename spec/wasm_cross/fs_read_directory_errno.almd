// @contract: C-215
// #1368: the WASI read floor ($read_text_file) DROPPED fd_read's errno. path_open
// SUCCEEDS on a directory — the failure only surfaces at fd_read — so every reader
// built on that floor returned ok("") on wasm where native returns
// err("Is a directory (os error 21)"). A silent wrong Result branch, not a wall.
//
// This pins the whole read family against a directory-at-path: the plain readers,
// the _if_exists twins (whose NotFound classification must NOT swallow a real IO
// error into ok(none)), and the ordinary file/empty-file/missing-file paths beside
// them so the fix cannot be "err on everything". The message text is native's
// std::io Display, byte-for-byte.
import fs

effect fn main() -> Unit = {
  let d = fs.create_temp_dir("readdir")!
  let f = d + "/f.txt"
  fs.write(f, "hi\n")!
  let e = d + "/empty.txt"
  fs.write(e, "")!
  let missing = d + "/nope.txt"
  // A DIRECTORY at the path: the same err on every reader, plain and _if_exists.
  println(match fs.read_text(d) {
    ok(v) => "text=ok(${v})",
    err(m) => "text=err(${m})",
  })
  println(match fs.read_lines(d) {
    ok(xs) => "lines=ok(${list.len(xs)})",
    err(m) => "lines=err(${m})",
  })
  println(match fs.read_bytes(d) {
    ok(bs) => "bytes=ok(${list.len(bs)})",
    err(m) => "bytes=err(${m})",
  })
  println(match fs.read_text_if_exists(d) {
    ok(o) => "text_if=ok(${o ?? "<none>"})",
    err(m) => "text_if=err(${m})",
  })
  println(match fs.read_lines_if_exists(d) {
    ok(o) => "lines_if=ok(${list.len(o ?? [])})",
    err(m) => "lines_if=err(${m})",
  })
  println(match fs.read_bytes_if_exists(d) {
    ok(o) => "bytes_if=ok(${list.len(o ?? [])})",
    err(m) => "bytes_if=err(${m})",
  })
  // A REGULAR FILE beside it still reads: the errno carry must not err on success.
  println(match fs.read_text(f) {
    ok(v) => "file=ok(${v})",
    err(m) => "file=err(${m})",
  })
  println(match fs.read_text_if_exists(f) {
    ok(o) => "file_if=ok(${o ?? "<none>"})",
    err(m) => "file_if=err(${m})",
  })
  // An EMPTY file is a zero-length read, not a failure.
  println(match fs.read_text(e) {
    ok(v) => "empty=ok(${string.len(v)})",
    err(m) => "empty=err(${m})",
  })
  // A MISSING path stays absence-is-a-value on the _if_exists twin, err on the plain one.
  println(match fs.read_text_if_exists(missing) {
    ok(o) => "missing_if=ok(${o ?? "<none>"})",
    err(m) => "missing_if=err(${m})",
  })
  println(match fs.read_text(missing) {
    ok(v) => "missing=ok(${v})",
    err(m) => "missing=err(${m})",
  })
}
