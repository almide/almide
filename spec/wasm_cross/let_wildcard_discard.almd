// @contract: C-217
// ADR-0008 D2 (#1123 N+1): `let _ = f()` is the sanctioned intentional
// discard — the err does NOT propagate (pre-switch it did, via auto-?). The
// enclosing fn completes normally on both targets.
effect fn fail_call() -> Result[Int, String] = err("boom")

effect fn ok_call() -> Result[Int, String] = ok(7)

effect fn main() -> Unit = {
  let _ = fail_call()
  let _ = ok_call()
  println("done")
}
