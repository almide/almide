// @contract: C-355
// `matrix.neg` is IEEE-754 NEGATION — a sign flip — so `neg(+0.0)` is -0.0
// and `neg(-0.0)` is +0.0, identically on both targets. The self-hosted body
// spelled it `0.0 - x`, and IEEE `0.0 - 0.0` is +0.0: a matrix of zeros came
// back +0.0 on both wasm legs where native's `-x` answered -0.0 (#2484). The
// sign is invisible to `==` and to `float.to_string`'s rounding, so it is
// observed through `1.0 / z` (`-inf` vs `inf`) as well as printed.
//
// This is the OPPOSITE ruling to the dequantization zero (C-229/#1358), and
// deliberately so: a dequantized element of zero magnitude encodes no
// direction, so its sign is an artifact of the spelling and is pinned to
// +0.0, while a negated datum's sign IS the datum — the same reason the
// float DECODERS keep a stored -0.0 (C-270).
//
// The rest of the elementwise surface is pinned alongside it, because "is
// this op spelled as a subtraction from zero?" is exactly the question that
// has to be asked of every cell, not just the one the issue named:
// `scale(m, -1.0)` and `map(m, (x) => -x)` are multiplications/negations and
// keep the sign, `sub(zeros, zeros)` is a SUBTRACTION and is +0.0 by IEEE on
// both legs, and the norms/activations that route a zero through a product
// keep whatever the product gives.
fn recip(m: Matrix, r: Int, c: Int) -> String = float.to_string(1.0 / matrix.get(m, r, c))

fn main() -> Unit = {
  let z = matrix.from_lists([
    [0.0, -0.0, 1.0, -1.0]
  ])
  let n = matrix.neg(z)
  println("neg=${matrix.to_lists(n)}")
  println("neg_recip=${recip(n, 0, 0)},${recip(n, 0, 1)},${recip(n, 0, 2)},${recip(n, 0, 3)}")
  // Negating twice returns the original bits.
  println("neg_neg=${matrix.to_lists(matrix.neg(n))}")
  // scale by -1 is a MULTIPLICATION: the sign flips by the product rule.
  let s = matrix.scale(z, -1.0)
  println("scale_recip=${recip(s, 0, 0)},${recip(s, 0, 1)}")
  // map with a unary minus is the scalar negation (`f64.neg`).
  let mp = matrix.map(z, (x) => -x)
  println("map_recip=${recip(mp, 0, 0)},${recip(mp, 0, 1)}")
  // sub IS a subtraction: `0.0 - 0.0` is +0.0 on both legs, by IEEE.
  let sb = matrix.sub(matrix.zeros(1, 1), matrix.zeros(1, 1))
  println("sub_recip=${recip(sb, 0, 0)}")
  // A stored -0.0 survives from_lists / to_lists / transpose unchanged.
  let t = matrix.transpose(z)
  println("transpose_recip=${recip(t, 1, 0)}")
}
