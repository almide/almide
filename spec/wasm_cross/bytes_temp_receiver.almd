// @contract: C-213
// Cross-target differential fixture: the receiver of a Unit-returning `bytes`
// mutator (#1849, narrowed by #2466).
//
// Before #2466 the in-place writers took a NON-`mut` receiver (`fn
// append_i16_be(b: Bytes, val: Int) -> Unit`), so the checker admitted a
// temporary (`bytes.new(2)`) and a `let` binding where `push`'s `mut b` was
// E032, and this fixture pinned what each leg did with them. #2466 declared the
// whole family's receiver `mut` (the runtime takes `&mut Vec<u8>` first), so a
// temporary and a `let` are now E032 like `push` — pinned by
// tests/diagnostics/e032-bytes-writer-{let,temporary,param} — and every receiver
// here is a `var`:
//   - a fresh `var` per statement — the shape a temporary had to become. Its
//     arguments still evaluate in order, exactly once
//   - a long-lived `var` — the write-back the family always had
// plus the aliasing probe: a `var` bound to a call that BORROWS a live binding's
// block (a fn returning its parameter) is written as a copy, and the original
// binding is untouched (value semantics, C-033).
fn show(label: String, b: Bytes) -> Unit = println(label + " " + "${bytes.to_list(b)}")

fn same(b: Bytes) -> Bytes = b

fn traced(v: Int) -> Int = {
  println("arg ${v}")
  v
}

fn main() -> Unit = {
  // ── a fresh var per statement: the write lands and is observable ──
  var t0 = bytes.from_list([1, 2, 3, 4, 5])
  bytes.append_i16_be(t0, 0)
  show("fresh_append_i16_be", t0)
  var t1 = bytes.new(2)
  bytes.append_i16_le(t1, 258)
  bytes.append_u8(t1, 511)
  bytes.append_u16_be(t1, 258)
  bytes.append_u32_le(t1, 258)
  bytes.append_i32_be(t1, -2)
  bytes.append_i64_le(t1, -1)
  bytes.append_f32_le(t1, 1.5)
  bytes.append_f64_be(t1, 1.5)
  show("fresh_appends", t1)
  var t2 = bytes.new(0)
  bytes.write_u8(t2, 7)
  bytes.write_u32_be(t2, 258)
  bytes.write_i64_be(t2, -1)
  bytes.write_f64_be(t2, 1.5)
  bytes.write_bool(t2, true)
  bytes.write_string_be(t2, "hi")
  bytes.write_uint16(t2, 258, LittleEndian)
  bytes.write_float32(t2, 1.5, BigEndian)
  show("fresh_cursor", t2)
  var t3 = bytes.new(2)
  bytes.set_uint16(t3, 0, 258, BigEndian)
  show("fresh_set_uint16", t3)
  var t4 = bytes.new(2)
  bytes.set_u16_be(t4, 0, 258)
  bytes.set_u8(t4, 0, 511)
  show("fresh_set", t4)
  var t5 = bytes.new(2)
  bytes.fill(t5, 7)
  show("fresh_fill", t5)
  var t6 = bytes.new(3)
  bytes.copy_from(t6, bytes.from_list([7, 8, 9]), 0, 0, 3)
  show("fresh_copy_from", t6)
  // ── the receiver's and the value's arguments evaluate, in order, exactly once ──
  var r0 = bytes.from_list([traced(1)])
  bytes.append_i16_be(r0, traced(2))
  var r1 = bytes.new(traced(3))
  bytes.append_u8(r1, traced(4))
  var r2 = bytes.new(traced(5))
  bytes.set_uint16(r2, traced(6), 258, LittleEndian)
  show("traced_0", r0)
  show("traced_1", r1)
  show("traced_2", r2)
  // ── long-lived var receivers: the write-back the family always had ──
  var v = bytes.new(0)
  bytes.append_i16_be(v, 258)
  bytes.append_i16_le(v, 258)
  bytes.append_u8(v, 511)
  show("var_append", v)
  var w = bytes.new(4)
  bytes.set_uint16(w, 0, 258, LittleEndian)
  bytes.set_uint16(w, 2, 258, BigEndian)
  show("var_set_uint16", w)
  var g = bytes.new(3)
  bytes.fill(g, 9)
  bytes.copy_from(g, bytes.from_list([7, 8]), 1, 0, 2)
  show("var_fill_copy_from", g)
  // ── aliasing: a var bound to a borrow of another block is written as a copy ──
  let x = bytes.from_list([1, 2])
  var a1 = same(x)
  bytes.append_u8(a1, 7)
  var a2 = same(x)
  bytes.append_i16_be(a2, 7)
  var a3 = same(x)
  bytes.write_u8(a3, 7)
  var a4 = same(x)
  bytes.fill(a4, 9)
  var a5 = same(x)
  bytes.copy_from(a5, bytes.from_list([7, 8]), 0, 0, 2)
  show("alias_untouched", x)
  show("alias_written_1", a1)
  show("alias_written_2", a2)
  show("alias_written_3", a3)
  show("alias_written_4", a4)
  show("alias_written_5", a5)
  var y = bytes.from_list([1, 2])
  let snap = y
  bytes.append_u8(y, 7)
  show("var_after", y)
  show("snapshot_before", snap)
  // ── a fresh receiver per loop round: the mutated block is released every
  // round, so 60k statements run to completion where a leaked block would
  // have doubled the heap ──
  for _i in 0..<20000 {
    var l0 = bytes.new(64)
    bytes.append_i16_be(l0, 1)
    var l1 = bytes.new(64)
    bytes.append_u8(l1, 1)
    var l2 = bytes.new(64)
    bytes.write_u8(l2, 1)
  }
  println("loop ok")
}
