// gleam test/language/precedence_test.gleam (11 cases): the mixed-operator
// matrix ending in the unary-minus torture rows — every operand of
// `-a + -b / -c * -d - -e * -f` negated, both as literals and through vars
// (the var form defeats any folder).
fn eq(x: Bool) -> String = if x then "1" else "0"

fn main() -> Unit = {
  println("${eq(7 == 1 + 2 * 3)}${eq(5 == 3 * 1 + 2)}${eq(9 == (1 + 2) * 3)}${eq(9 == 3 * (1 + 2))}")
  println("${eq(11 == 1 + 2 * 3 + 4)}${eq(26 == 2 * 3 + 4 * 5)}${eq(4 == 2 * (3 + 1) / 2)}")
  println("${eq(-17 == 5 + 3 / 3 * 2 - 6 * 4)}${eq(-31 == -5 + -3 / -3 * -2 - -6 * -4)}")
  let a = 5
  let b = 3
  let c = 3
  let d = 2
  let e = 6
  let f = 4
  println(eq(-17 == a + b / c * d - e * f))
  println(eq(-31 == -a + -b / -c * -d - -e * -f))
}
