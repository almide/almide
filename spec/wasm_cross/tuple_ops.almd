// @contract: C-236, C-249
// ALS-E8 (docs/specs/als/expressions.md): tuples — heterogeneous literal,
// let-destructure, positional index `.k`, parameter and return positions,
// nesting (chained index requires grouping: `(n.0).1`, since `n.0.1` lexes
// `0.1` as a float literal), and structural equality. No string
// interpolation in this file (#1267). Identical observables on both targets.
fn swap(p: (Int, Int)) -> (Int, Int) = (p.1, p.0)

effect fn main() -> Unit = {
  let t = (1, "a")
  let (x, y) = t
  println(int.to_string(x))
  println(y)
  println(int.to_string(t.0))
  println(t.1)
  let s = swap((1, 2))
  println(int.to_string(s.0))
  println(int.to_string(s.1))
  let n = ((1, 2), 3)
  println(int.to_string((n.0).1 + n.1))
  let eq = (1, 2) == (1, 2)
  println(if eq then "eq" else "ne")
}
