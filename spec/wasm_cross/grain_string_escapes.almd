// @contract: C-292
// grain strings.re + chars.re — toString_escape1/4/5/6/7/9 (the QUOTED
// debug rendering of a tuple escapes backslash, newline — literal AND
// escaped spelling, carriage return, tab, quote identically on every
// target), char_eq1/2 (single-grapheme string equality incl. astral),
// multiline string literals, concat.
fn show(t: (String, Int)) -> String = "${t}"

fn main() -> Unit = {
  println(show(("foo\\bar", 1)))
  println(show(("foo\nbar", 1)))
  let literal_newline = "foo
bar"
  println(show((literal_newline, 1)))
  println(show(("foo\rbar", 1)))
  println(show(("foo\tbar", 1)))
  println(show(("foo\"bar", 1)))
  println("foo" + "bar")
  println(if "🌾" == "🌾" then "T" else "F")
  println(if "🌾" == "💯" then "F2" else "T2")
  println(int.to_string(string.len("💯")))
  let multi = "foo
bar
baz"
  println(int.to_string(string.len(multi)))
  println(string.join(string.split(multi, "\n"), "|"))
}
