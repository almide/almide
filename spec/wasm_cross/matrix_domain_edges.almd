// @contract: C-223, C-229
// Two matrix cells the differential fuzz found on the same night, both of them
// a DOMAIN EDGE the byte-match fixtures never reached because they feed ordinary
// values.
//
// 1. gelu at the top of the float range (C-223). The native kernel spells the
//    scaling `0.5 * x * (1.0 + tanh)`, which Rust parses as
//    `(0.5 * x) * (1.0 + tanh)` — halve FIRST, then double. The self-host had
//    transcribed v0's `0.5 * ((1 + t) * x)`, which doubles first, and `2.0 * x`
//    overflows to `inf` for an `x` near f64::MAX where the native order stays
//    finite. Native answered the value, wasm answered `inf`, both exit 0. The
//    self-host now follows the native association; all four native lanes
//    (naive/avx/neon/chunked) already agreed on it.
//
//    Note what this says about #1197's byte-match discipline: matching the
//    OPERANDS and the reduction ORDER is not enough — the ASSOCIATION is part of
//    the algorithm, and only an operand at the range's edge can tell you so.
//
// 2. from_q1_0_bytes past the end of its buffer (C-229). The full-matrix loader
//    had no `limit` at all, while its row-subset twin `select_rows_q1_0` had
//    carried the per-row OOB->zeros edge since #1408. A rows/cols pair asking
//    for more 18-byte blocks than the buffer holds read straight past it: native
//    bounds-checked its slice and died with a raw panic (exit 101, the form
//    ALS-T6 forbids) while wasm read whatever linear memory held and answered.
//    Both legs now take the same per-ROW edge, so a row whose blocks would fall
//    outside is the all-zero row.
import bytes
import matrix

fn cell(m: Matrix, r: Int, c: Int) -> String = float.to_string(list.get(list.get(matrix.to_lists(m), r) ?? [], c) ?? 9.9)

effect fn main() -> Unit = {
  // gelu is ~identity for a large positive x; the wasm leg used to print `inf`.
  let big = matrix.from_lists([
    [1.7976931348623157e308, 1.0]
  ])
  println("gelu_max=" + cell(matrix.gelu(big), 0, 0))
  // The ordinary cell alongside it, so the association change is pinned not to
  // have moved a normal value.
  println("gelu_one=" + cell(matrix.gelu(big), 0, 1))
  // 18 bytes holds exactly ONE q1_0 block (2 scale + 16 bits = 128 weights).
  // Row 0 is in range; rows 1..3 are not, and are the all-zero row on both legs.
  var z = bytes.new(18)
  let m = matrix.from_q1_0_bytes(z, 0, 4, 128)
  println("q10_rows=" + int.to_string(matrix.rows(m)))
  println("q10_r0=" + cell(m, 0, 0) + " q10_r3=" + cell(m, 3, 0))
  // The in-range shape must be untouched by the new bound.
  let m1 = matrix.from_q1_0_bytes(z, 0, 1, 128)
  println("q10_inrange=" + int.to_string(matrix.rows(m1)) + "," + cell(m1, 0, 0))
}
