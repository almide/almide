// @contract: C-087, C-401
// The edges json.parse used to accept leniently, now each an err with one
// text on every leg (ALS-T3, almide/almide#4111, #4112). The cases are the
// ones this fixture pinned while the leniency was the rule, kept so the file
// shows what each old shape answers now:
//
//   - An error names the CHAR index of the offending position, not the byte
//     offset. A 3-byte 日 and a 4-byte emoji before the bad token each count
//     once.
//   - Whitespace is JSON whitespace (space, tab, LF, CR). Ideographic space,
//     NBSP, em space, NEL, LINE SEPARATOR and the ASCII VT/FF are not, so
//     between tokens they are an unexpected char, and after the value they
//     are trailing data.
//   - Trailing content after the top-level value, a missing `,`, an unquoted
//     key and a trailing comma are each an err; a number must match RFC 8259's
//     grammar whole.
import json

fn s(text: String) -> String = match json.parse(text) {
  ok(v) => json.stringify(v),
  err(e) => "ERR " + e,
}

fn main() -> Unit = {
  // Error position is a char index: 8 here, where the byte offset is 14.
  println(s('["日本語", x]'))
  // 5 here, where the byte offset is 8 (the emoji is 4 bytes).
  println(s('["😀",é]'))
  // The bad char itself may be multi-byte.
  println(s('[¿]'))
  println(s('[1,]'))
  // Unicode whitespace between every token.
  println(s('{\u{3000}"k"\u{00A0}:\u{2028}1\u{85}}'))
  println(s('[\u{2003}1\u{3000},\u{00A0}2\u{0B}]'))
  println(s('\u{0C}\u{3000}true'))
  // Leniency: trailing content is ignored; a missing separator closes the container.
  println(s('true false'))
  println(s('[1 2]'))
  println(s('{"a":1 "b":2}'))
  // A key is hunted through the string reader: the unquoted key swallows the
  // rest of the input, and the value is then missing.
  println(s('{x: 1}'))
  println(s('{日: 1}'))
  println(s('{"a":1,}'))
  // Bare literals that are not quite literals.
  println(s('tru'))
  println(s('nul'))
  println(s('fals'))
  // Number-parse messages pass through from the host parser.
  println(s('-'))
  println(s('--1'))
  println(s('1e'))
  // Empty and whitespace-only input.
  println(s(''))
  println(s('   '))
  println(s('\u{3000}'))
}
