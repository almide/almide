// @contract: C-191
// A module-level global referenced in BOTH arms of a real branch reads its true
// value on every path. The per-function materialization memo used to serve the
// sibling arm a ValueId whose defining op sits in the UNTAKEN arm's block — on
// wasm that local is 0, so `base + count > CAP` compared against 0 and took the
// wrong side with no error (#945: aivarium's glTF loader rejected every
// primitive and a 52849-vertex model loaded as zero geometry). The heap twin
// (`s == TAG` in both arms) and the zero-iteration-loop shape (first use inside
// a `while` body, second after it) fail the same way and are pinned here too.

let CAP = 2097152
let TAG = "alpha"

fn inner(n: Int, count: Int) -> Int = {
  let base = 0
  if count < 0 then {
    if base + n > CAP then 0 - 13 else n
  }
  else {
    if base + count > CAP then 0 - 14
    else count
  }
}

fn pick(flag: Bool, s: String) -> String = {
  if flag then {
    if s == TAG then "then-hit" else "then-miss"
  } else {
    if s == TAG then "else-hit" else "else-miss"
  }
}

fn loop_then_after(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n {
    acc = acc + CAP
    i = i + 1
  }
  if acc > CAP then 1 else 0
}

fn main() -> Unit = {
  // The reported shape: the else arm must compare against the REAL cap.
  println(int.to_string(inner(10, 2574)))
  // Each arm on its own path, both sides of each comparison.
  println(int.to_string(inner(10, 0 - 5)))
  println(int.to_string(inner(2097153, 0 - 5)))
  println(int.to_string(inner(10, 2097153)))
  // The heap twin: the else arm must hold the real TAG bytes.
  println(pick(true, "alpha"))
  println(pick(false, "alpha"))
  println(pick(false, "beta"))
  // Zero iterations: the post-loop read must not depend on a body-materialized copy.
  println(int.to_string(loop_then_after(0)))
  println(int.to_string(loop_then_after(3)))
}
