// @contract: C-163
// #860: a heap-result `if`/`match` BOUND to a let/var executes the taken arm on
// both targets. The call-ARGUMENT and TAIL positions of the same shape already
// lowered; only the BIND position walled, so `let v = ok(if c then some(a) else
// some(b))` — the archived café fuzz finding, two String-LITERAL `Some` arms —
// put its whole enclosing function outside the subset.
//
// The literal payload was the missing case: the heap `some(...)` arm admitted a
// Var, a call result and a list concat, but not a `LitStr`. Native computed the
// value, the wasm leg declined; now both print the same bytes.
effect fn main() -> Unit = {
  let c: Bool = true
  // The café shape: an Option-of-literal `if` inside an `ok(...)` payload.
  let v: Result[Option[String], String] = ok(if c then some("ΑΒΓ") else some("café"))
  match v {
    ok(inner) => println("v = " + (inner ?? "nil")),
    err(e) => println("v err = " + e),
  }
  let w: Result[Option[String], String] = ok(if not c then some("ΑΒΓ") else some("café"))
  match w {
    ok(inner) => println("w = " + (inner ?? "nil")),
    err(e) => println("w err = " + e),
  }
  // The plain bind position, String and List results.
  let s = if c then string.to_upper("ab") else string.repeat("z", 2)
  let ys = if c then list.take(["a", "b", "c"], 2)
  else list.drop(["a", "b", "c"], 1)
  println("s = " + s)
  println("ys = " + list.join(ys, "-"))
  // A `match` in the same position, with a heap result.
  let m = match list.len(ys) {
    0 => "zero",
    2 => "two",
    _ => "many",
  }
  println("m = " + m)
  // A none arm alongside a literal some arm.
  let o = if c then some("hit") else none
  println("o = " + (o ?? "nil"))
}
