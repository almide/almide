// @contract: C-067
// #857: the WRITE-ONLY var shape. A `var` whose ONLY use is an index-assign is
// never READ, so `use_count` stays 0 and dead-binding elimination stripped the
// `let` while the write-back still named it — native codegen emitted E0425
// (`cannot find value 'ys'`), and the wasm leg walled on the same shape. DCE now
// consults the mutation targets, so the binding survives and BOTH legs reach the
// bounds guard: byte-identical "Error: index out of bounds\n" + exit 1.
//
// The in-bounds write comes first to pin that the surviving binding still
// mutates correctly; only the second write is out of range.
effect fn main() -> Unit = {
  var ys = ["a", "b"]
  ys[0] = "y"
  println("wrote in-bounds")
  ys[3] = "Z"
  println("unreachable")
}
