// @contract: C-105
// #2310's gate: the accumulator `acc + [x]` over a HEAP element is linear, in
// both spellings, at a size the quadratic form cannot reach. Before the fix the
// in-place append window refused a 4-byte handle slot and the concat path
// copied the whole list per step — 100,000 String appends took 10.5 s against
// 11 ms for `Int`, and a 200,000-element accumulator reached C-197 (#2291 had
// to write `list.iterate` with `list.push` because of it). One million here:
// the quadratic form would be ~10^12 element copies, so a regression cannot
// pass this fixture by being merely slow.
//
// What the credit discipline has to keep, and what this pins: every element is
// pushed EXACTLY once into the spine, so the join reads each string once and
// the length is exact. A missing +1 frees a live element (the join would read
// freed bytes); a doubled one leaks (the allocation ledger sees it). The
// specific un-Dup'd-push spelling is C-186's fixture; this one is the volume.
fn build(n: Int, acc: List[String]) -> List[String] =
  if n <= 0 then acc else build(n - 1, acc + ["ab"])

fn grow(n: Int) -> List[String] = {
  var out: List[String] = []
  var i = 0
  while i < n {
    out = out + ["ab"]
    i = i + 1
  }
  out
}

fn main() -> Unit = {
  let tail = build(1000000, [])
  println("${list.len(tail)}")
  let loop_form = grow(1000000)
  println("${list.len(loop_form)}")
  // The elements survive the growth chain: read one from each end of both.
  println("${tail[0]}${tail[999999]}${loop_form[0]}${loop_form[999999]}")
  // A borrowed element pushed from a var takes its own credit, and the source
  // stays readable afterwards — the shape the Dup discipline exists for.
  let s = "cd"
  var pair: List[String] = []
  pair = pair + [s]
  pair = pair + [s]
  println("${s}:${list.join(pair, ",")}")
}
