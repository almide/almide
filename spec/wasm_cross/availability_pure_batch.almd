// @contract: C-327
// #1423 stage 4: the pure pending-self-host rows of hex and html close on
// the STRUCTURAL leg. Each fn prints over its documented edge cases; native
// is the oracle and every wasm leg must match byte for byte. hex.decode joins
// the sum-builder whitelist tier; the html newtype
// (`mod type SafeHtml = String`) erases to its payload before lowering. (The
// path `SafePath` rows and the value case transforms left the stdlib in
// dialect epoch 15.)
import hex
import html

fn show_hex(s: String) -> String = match hex.decode(s) {
  ok(b) => "ok ${hex.encode(b)} len=${bytes.len(b)}",
  err(e) => "err ${e}",
}

fn main() -> Unit = {
  // hex.decode: both cases, mixed, empty, odd length, first bad char
  println(show_hex(""))
  println(show_hex("00ff"))
  println(show_hex("00FF"))
  println(show_hex("aBcD01"))
  println(show_hex("abc"))
  println(show_hex("zz"))
  println(show_hex("0g"))
  println(show_hex("ab cd"))
  // html.escape: the five metacharacters, & first (no double escape)
  println(html.to_string(html.escape("<a href=\"x\">Tom & Jerry's</a>")))
  println(html.to_string(html.escape("&lt;")))
  println("[${html.to_string(html.escape(""))}]")
  println(html.to_string(html.raw("<br>")))
  println("[${html.to_string(html.empty())}]")
  let frag = ["<b>", "x&y"] |> list.map((i) => html.escape(i)) |> list.fold(
    html.empty(),
    (acc, f) => html.concat(acc, f),
  )
  println(html.to_string(html.concat(frag, html.raw("<hr>"))))
}
