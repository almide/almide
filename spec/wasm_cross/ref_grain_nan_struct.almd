// grain nan_equality + roc NaN collapse: NaN self-inequality in every
// position, the isNaN idiom, and whether STRUCTURAL equality of a variant
// carrying NaN agrees with bare float equality — the C-289 twin seam.
type FBox = | FB(Float)

fn is_nan(x: Float) -> Bool = not (x == x)

fn main() -> Unit = {
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  println(if nan == nan then "eq" else "ne")
  println(if is_nan(nan) then "T" else "F")
  println(if is_nan(inf - inf) then "T" else "F")
  println(if is_nan(1.5) then "T" else "F")
  // structural equality over a NaN payload, both spellings
  let a = FB(nan)
  let b = FB(nan)
  println(if a == b then "struct-eq" else "struct-ne")
  let xs = [nan]
  let ys = [nan]
  println(if xs == ys then "list-eq" else "list-ne")
  // formatting: NaN / inf / -inf spelling must agree across targets
  println("${float.to_string(nan)} ${float.to_string(inf)} ${float.to_string(0.0 - inf)}")
  // sign of a computed -0.0 through min/max
  println(float.to_string(float.min(0.0 - 0.0, 0.0)))
}
