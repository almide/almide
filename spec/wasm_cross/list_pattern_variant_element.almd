// @contract: C-070
// #3400: a list pattern whose element is a variant pattern with a binder
// tests the element's case and binds the payload on both targets.
type Item =
  | Named(String)
  | Plain(Int)

fn only_plain(xs: List[Item]) -> Int = match xs {
  [Plain(n)] => n,
  _ => -1,
}

fn pair_names(xs: List[Item]) -> String = match xs {
  [Named(a), Named(b)] => a + b,
  [Named(a), Plain(n)] => a + int.to_string(n),
  _ => "?",
}

fn main() -> Unit = {
  println(int.to_string(only_plain([Plain(7)])))
  println(int.to_string(only_plain([Named("x")])))
  println(int.to_string(only_plain([Plain(1), Plain(2)])))
  println(int.to_string(only_plain([])))
  println(pair_names([Named("a"), Named("b")]))
  println(pair_names([Named("a"), Plain(3)]))
  println(pair_names([Plain(3), Named("a")]))
}
