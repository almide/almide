// @contract: C-161
// `matrix.from_bytes_f32_le(data, offset, rows, cols)` builds a `rows x cols`
// matrix, so that shape takes the shared 2^28 element ceiling before anything
// is allocated, as native's constructor does. The f32 row selector (now in
// module nn.kernels of package almide-graphics/nn) shared the hazard: the structural wasm leg formed the
// byte size `n * cols * 8` first, so `cols = 2^62` wrapped it to 0, passed
// the out-of-memory bound and answered `(1, 0)` with exit 0, where native
// aborts with `Error: matrix dimensions too large` + exit 1 (found in the
// #2783 sweep). The in-range cell comes first; the fixture ends at the abort.
fn show(m: Matrix?) -> String = match m {
  some(x) => {
    let (r, c) = matrix.shape(x)
    int.to_string(r) + " x " + int.to_string(c)
  },
  none => "none",
}

fn main() -> Unit = {
  let data = bytes.from_list([
    0,
    0,
    128,
    63,
    0,
    0,
    0,
    64
  ])
  println("in_range=" + show(matrix.from_bytes_f32_le(data, 0, 1, 2)))
  // One row of 2^62 columns: the byte size wraps i64 to 0.
  println("wrap=" + show(matrix.from_bytes_f32_le(data, 0, 1, 4611686018427387904)))
  println("unreachable")
}
