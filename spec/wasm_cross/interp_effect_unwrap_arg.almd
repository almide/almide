// @contract: C-192
// An auto-unwrapped effect call INSIDE a string interpolation in call-argument
// position lowers and runs: the `?`-early-return lifts out of the interpolation
// part exactly as it lifts out of a plain call argument. `println("a=${fetch()}")`
// walled the whole wasm render while its hoisted twin (`let v = fetch()`) built —
// the ANF-lift extractor had no StringInterp arm, so the unwrap reached the
// interp lowering intact (#950). Every part is evaluated unconditionally, left
// to right, which is what makes the lift sound.

effect fn fetch() -> Result[String, String] = ok("hi")
effect fn boom() -> Result[String, String] = err("nope")
effect fn count() -> Result[Int, String] = ok(42)

// Two unwraps in one interpolation: the fixpoint lifts them one at a time.
effect fn run_ok() -> Result[Unit, String] = {
  println("a=${fetch()} n=${count()}")
  ok(())
}

// The err path: the lifted unwrap must PROPAGATE (early-return the err), so
// nothing after it in the interpolation — or the statement — runs.
effect fn run_err() -> Result[Unit, String] = {
  println("never=${boom()}")
  ok(())
}

effect fn main() -> Unit = {
  match run_ok() {
    ok(_) => println("ok-path done")
    err(e) => println("unexpected ${e}")
  }
  match run_err() {
    ok(_) => println("unexpected ok")
    err(e) => println("propagated: ${e}")
  }
}
