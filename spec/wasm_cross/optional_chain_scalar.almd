// @contract: C-264
// ALS-E28 (docs/specs/als/expressions.md): the optional chain `p?.x` over a
// SCALAR record field — some path yields some(field), none path yields none,
// both consumed by `??`. Un-walled on the wasm leg by #1329 (the desugar
// moved to the shared optimize cut point, so the synthesized helper is a
// Named call that lowers in every position). Heap-payload fields (`u?.name`
// over String) stay on the older route behind a measured pre-existing brick
// — deliberately outside this fixture.
type Pt = { x: Int, y: Int }

effect fn main() -> Unit = {
  let p: Pt? = some({ x: 3, y: 4 })
  let px = p?.x
  println(int.to_string(px ?? 0))
  let np: Pt? = none
  println(int.to_string(np?.x ?? -9))
}
