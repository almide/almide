// @contract: C-398
// #4146: `path.join_within(base, child)` admits only a child that stays
// inside `base` — relative, no `..` segment on either separator, no leading
// `~`, no drive letter, no NUL — and refuses every other child. (The
// `SafePath` constructor that shared the rule left the stdlib in dialect
// epoch 15; the probes run through `join_within` now.)
// Negative control: the pre-#4146 check split on `/` only and looked for
// `..` alone, so `/etc/passwd`, `..\..\windows\win.ini` and `~/.ssh/id_rsa`
// were admitted, and `path.join` lets an absolute child replace the base.
import path

fn show(label: String, r: Result[String, String]) -> Unit = match r {
  ok(v) => println("${label}: ok ${v}"),
  err(e) => println("${label}: err ${e}"),
}

fn main() -> Unit = {
  let probes = [
    "/etc/passwd",
    "..\\..\\windows\\win.ini",
    "a/%2e%2e/b",
    "~/.ssh/id_rsa",
    "a/../b",
    "\\server\\share",
    "C:\\Windows",
    "c:/x",
    "a/./b",
    "uploads/report.txt",
    ""
  ]
  for p in probes {
    show("join_within ${p}", path.join_within("base", p))
  }
  println("join_within NUL: ${result.is_err(path.join_within("base", "a/\u{0}b"))}")
  show("join_within abs", path.join_within("/srv/uploads", "/etc/passwd"))
  show("join_within up", path.join_within("/srv/uploads", "../../etc/passwd"))
  show("join_within ok", path.join_within("/srv/uploads", "a/b.txt"))
  println("join abs ${path.join("/srv/uploads", "/etc/passwd")}")
}
