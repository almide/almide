// @contract: C-185
//
// A `??` chain yields the FIRST Ok in source order on both targets, whichever
// position it is in — the selection `fan.any { }` used to spell (removed in
// dialect epoch 14, ADR-0028).
//
// History: on wasm the fan combinators were inlined; the pre-J3 form reused
// ONE cloned Ok arm for every chain level, so every level bound the SAME VarId
// — and the renderer resolves a VarId to one local at one binding site, the
// innermost it saw. An outer level extracted its payload into a local nothing
// read, and the duplicated body read the inner level's local, which on that
// path was never stored. The result was a plausible 0 rather than a trap or a
// wall (#900). Only "the winning candidate is LAST" aliased to the right
// local, which is the shape the docs happened to use. Every arrangement is
// pinned here, eight chained selections in one function (the linearity
// ratchet: this exact main once expanded ~1,700-fold into a 231KB names
// witness; corpus-wall's MAX_WITNESS_LINE gate turns any regression back to
// duplication into a fast red naming this function).
effect fn ok11() -> Result[Int, String] = ok(11)

effect fn ok22() -> Result[Int, String] = ok(22)

effect fn ok33() -> Result[Int, String] = ok(33)

effect fn boom() -> Result[Int, String] = err("boom")

effect fn main() -> Result[Unit, String] = {
  // Winner FIRST — the case that returned 0.
  let a = ok11() ?? ok22() ?? -1
  println("a=" + int.to_string(a))
  // Winner first, loser after.
  let b = ok11() ?? boom() ?? -1
  println("b=" + int.to_string(b))
  // Winner last: the arrangement that always worked.
  let c = boom() ?? ok22() ?? -1
  println("c=" + int.to_string(c))
  // Three levels, so the chain is deeper than the single nesting.
  let d = ok11() ?? ok22() ?? ok33() ?? -1
  println("d=" + int.to_string(d))
  let e = boom() ?? ok22() ?? ok33() ?? -1
  println("e=" + int.to_string(e))
  let f = boom() ?? boom() ?? ok33() ?? -1
  println("f=" + int.to_string(f))
  // The same selection printed through a match on a bound Result, and the
  // all-failed fallback.
  let m = ok11() ?? ok22() ?? -1
  println("m=" + int.to_string(m))
  let g = boom() ?? boom() ?? -1
  println("g=" + int.to_string(g))
  ok(())
}
