// @contract: C-041
// The WASI HOST-FLOOR String constructor obeys the allocator's block-size
// invariant, so a freed host-built String is safe to reuse (#892 / #903).
//
// `$alloc`'s free-list reuse test has no record of a block's size: it RECOMPUTES
// it from the block's own `cap` field as `LIST_HEADER + cap*ELEM_SIZE`. Every
// String therefore has to be allocated at exactly that many bytes, with `cap`
// counted in ELEMENTS. The three host-floor constructors (`$args_get_list`,
// `$env_get`, `$rtf_str` — the WASI exits that turn raw host bytes into an
// Almide String) instead allocated `LIST_HEADER + len` bytes and stored
// `cap := len`, a BYTE count. A 1-byte host String then occupied 13 bytes while
// advertising 20, so the next `alloc(20)` matched it on the free list and got
// the 13-byte hole back: the new block's header and payload wrote 7 bytes INTO
// the live neighbour. Nothing traps on that — `$rc_dec`'s double-free sentinel
// never fires, because no refcount is wrong — it is silent corruption of an
// unrelated value. That is how it surfaced: `args.option_or("a","-") +
// args.option_or("b","=")` in ONE expression printed `45,61,3,0,61,59` on wasm
// against `45,61,59,45,61,59` native — a block HEADER (len 3) had landed inside
// a live string's bytes.
//
// What this LOCKS: host-floor Strings of EVERY byte-length residue mod
// ELEM_SIZE (widths 0..17 cover each class twice), held live two at a time
// while correctly-sized program Strings are allocated around them — the
// arrangement that lets a mis-sized hole be handed to a live value — and then
// all 18 live at once in a list. Byte-identical output native == wasm means no
// reused block ever overlapped another.
//
// The `??` fallbacks (rather than `!`) keep every effect call out of a `!`
// unwrap inside a loop body, which is a separate MIR-lowering-subset wall.

import fs

fn path_of(dir: String, n: Int) -> String = dir + "/f" + int.to_string(n) + ".txt"

// Width-n file of `n` payload bytes; returns n so the caller can `??` it.
effect fn seed(dir: String, n: Int) -> Int = {
  let _ = fs.write(path_of(dir, n), string.repeat("x", n))!
  n
}

// One host-floor read behind a call boundary, so a caller can hold two of them
// live in a single expression.
effect fn read_at(dir: String, n: Int) -> String = fs.read_text(path_of(dir, n))!

effect fn main() -> Unit = {
  let dir = "almide_xt_hostfloor_tmp"
  let _ = fs.mkdir_p(dir)!
  // Widths 0..17: two full passes over the ELEM_SIZE=8 residue classes, so a
  // per-residue rounding error cannot hide behind one lucky size.
  var w = 0
  var seeded = 0
  while w < 18 {
    seeded = seeded + (seed(dir, w) ?? -1)
    w = w + 1
  }
  println("seeded=" + int.to_string(seeded))
  // Two host-floor Strings live at once, of complementary widths, concatenated
  // into a growing accumulator: every iteration frees a differently-sized host
  // String than it allocates, so a mis-sized free-list entry is offered to the
  // NEXT program allocation instead of back to an identical request.
  var acc = ""
  var i = 0
  while i < 18 {
    acc = acc + (read_at(dir, i) ?? "?") + "|" + (read_at(dir, 17 - i) ?? "?") + ";"
    i = i + 1
  }
  println(int.to_string(string.len(acc)))
  println(acc)
  // A byte census, not just the text: a clobbered byte that happens to stay
  // printable would still move this number.
  var census = 0
  var c = 0
  let bytes = string.to_bytes(acc)
  while c < list.len(bytes) {
    census = census + (list.get(bytes, c) ?? 0)
    c = c + 1
  }
  println("census=" + int.to_string(census))
  // All 18 host-floor Strings live SIMULTANEOUSLY, then joined — the widest
  // interleaving of host blocks and program blocks this fixture can build.
  var all: List[String] = []
  var k = 0
  while k < 18 {
    let s = read_at(dir, k) ?? "?"
    list.push(all, s)
    k = k + 1
  }
  println(list.join(all, "-"))
  let _ = fs.remove_all(dir)!
  let left = fs.exists(dir)
  println(if left then "leaked" else "cleaned")
}
