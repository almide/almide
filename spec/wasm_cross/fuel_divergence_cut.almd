// @contract: C-204
// T1-1 divergence cut: a non-terminating body is CUT at the first charge
// site past exhaustion (W1: every cycle passes one) — the verdict is Err,
// the fallback runs, and the program CONTINUES, on both targets.
fn loop_forever(n: Int) -> Int = {
  var i = 0
  var acc = n
  while true { acc = (acc + 7) % 999983; i = i + 1 }
  acc
}

effect fn main() -> Unit = {
  let b = fan.bounded(compute.ms(10)) { loop_forever(1) } ?? -1
  println(int.to_string(b))
  println(int.to_string(42))
}
