// @contract: C-272
// fs.list_dir returns the WHOLE directory on both targets, at every fd_readdir
// buffer boundary. WASI's fd_readdir is a RESUMABLE api: one pass fills the
// caller's buffer and reports how many bytes it wrote, and the listing continues
// from the last entry's d_next cookie until a pass returns FEWER bytes than the
// buffer. The wasm floor ($read_dir) did ONE cookie=0 pass into 4 KiB and parsed
// whatever landed there, so every directory whose dirents did not fit came back
// SILENTLY SHORT wrapped in ok(...) — a wrong value, not a wall and not an err,
// indistinguishable from a genuinely smaller directory (#1384).
//
// Sizing (a WASI dirent is a 24-byte header + the name; wasmtime yields "." and
// ".." too, so a listing starts 25 + 26 = 51 bytes in):
//   empty / one   the degenerate ends
//   exact4096     129 x 7-byte names (3999) + one 22-byte name (46) = 4096 EXACTLY.
//                 A pass that exactly fills the buffer is NOT necessarily the end,
//                 so the sweep must re-read and get an empty pass, never stop here.
//   over4096      the same plus one more 7-byte name = 4127: the first entry the
//                 single pass could not see at all (130 where native says 131).
//   straddle      129 x 7-byte names + one 40-byte name = 4114: the last record's
//                 HEADER fits at 4050 but its NAME runs past 4096, so the host
//                 writes a partial record. The old parser trusted d_namlen and
//                 read 18 bytes of neighbouring HEAP into the name.
//   big200        the issue's own repro: 200 entries answered 130 = (4096-51)/31.
//   long60x76     60 x 76-byte names answered 41, and the first name came back
//                 with heap garbage spliced onto it — the straddle, observable.
//
// ORDERING is contractual, not incidental: both legs return the names sorted
// lexicographically by BYTES (native `names.sort()` over `String` = `str` Ord;
// wasm's insertion sort over `$str_lt`), so the filesystem's arbitrary readdir
// order is never observable and this fixture cannot pass by luck of it. The
// entries are created here, so first/last/joined-length are fixed strings. The
// byte totals above bracket the 4 KiB boundary on any host; WHICH record lands
// on it depends on readdir order, and the claim asserted is native == wasm.
// Temp-dir paths carry entropy suffixes and are never printed.
import fs

fn short_name(i: Int, namelen: Int) -> String = string.pad_end("f" + string.pad_start(int.to_string(i), 6, "0"), namelen, "x")

effect fn probe(label: String, n: Int, namelen: Int, extralen: Int) -> Unit = {
  let d = fs.create_temp_dir("ld")!
  for i in 0..<n {
    fs.write(d + "/" + short_name(i, namelen), "")!
  }
  for _k in 0..<(if extralen > 0 then 1 else 0) {
    fs.write(d + "/" + string.pad_end("z", extralen, "z"), "")!
  }
  let names = fs.list_dir(d)!
  let got = list.len(names)
  let joined = names |> list.join(",")
  println("${label} n=${int.to_string(got)} bytes=${int.to_string(string.len(joined))} first=${list.get(names, 0) ?? "-"} last=${list.get(names, got - 1) ?? "-"}")
  fs.remove_all(d)!
}

effect fn main() -> Unit = {
  probe("empty", 0, 7, 0)!
  probe("one", 1, 7, 0)!
  probe("exact4096", 129, 7, 22)!
  probe("over4096", 130, 7, 22)!
  probe("straddle", 129, 7, 40)!
  probe("big200", 200, 7, 0)!
  probe("long60x76", 60, 76, 0)!
}
