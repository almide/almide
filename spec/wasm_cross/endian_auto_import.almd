// @contract: C-213
// Cross-target differential fixture: a stdlib-declared variant type spelled in
// every position a program can, beside an endian VALUE dispatched to the
// endian-suffixed bytes reads / appends / puts.
//
// The stdlib `bytes.Endian` left in dialect epoch 15 (R-bytes-04: the endian is
// in the function name), so the dispatch half now runs over the program's own
// `Endian` — still a bound VALUE routed to `get_*_le` / `get_*_be`, the shape
// that walled on the structural leg before #1839. The stdlib-declared half
// moved to `net.IpAddr`, the remaining stdlib variant type with bare ctors:
// a `let` annotation, a ctor bound to a name, a fn parameter, a fn result, a
// `match` subject, an `==`, an interpolation and a list element. No auto-imported
// stdlib variant type remains, so that half needs `import net`.
import net

type Endian = | LittleEndian | BigEndian

fn host(a: IpAddr) -> String = match a {
  V4(x, y, z, w) => "${x}.${y}.${z}.${w}",
  V6(parts) => "v6:${list.len(parts)}",
}

fn loopback(v6: Bool) -> IpAddr = if v6 then V6([
  0,
  0,
  0,
  0,
  0,
  0,
  0,
  1
])
else V4(127, 0, 0, 1)

fn name(e: Endian) -> String = match e {
  LittleEndian => "le",
  BigEndian => "be",
}

fn pick(big: Bool) -> Endian = if big then BigEndian else LittleEndian

fn flip(e: Endian) -> Endian = match e {
  LittleEndian => BigEndian,
  BigEndian => LittleEndian,
}

fn read_u16(b: Bytes, pos: Int, e: Endian) -> Int = match e {
  LittleEndian => bytes.get_u16_le(b, pos) ?? 0,
  BigEndian => bytes.get_u16_be(b, pos) ?? 0,
}

fn read_u32(b: Bytes, pos: Int, e: Endian) -> Int = match e {
  LittleEndian => bytes.get_u32_le(b, pos) ?? 0,
  BigEndian => bytes.get_u32_be(b, pos) ?? 0,
}

fn read_i32(b: Bytes, pos: Int, e: Endian) -> Int = match e {
  LittleEndian => bytes.get_i32_le(b, pos) ?? 0,
  BigEndian => bytes.get_i32_be(b, pos) ?? 0,
}

fn read_f32(b: Bytes, pos: Int, e: Endian) -> Float = match e {
  LittleEndian => bytes.get_f32_le(b, pos) ?? 0.0,
  BigEndian => bytes.get_f32_be(b, pos) ?? 0.0,
}

fn append_u16(mut b: Bytes, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.append_u16_le(b, x),
  BigEndian => bytes.append_u16_be(b, x),
}

fn append_u32(mut b: Bytes, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.append_u32_le(b, x),
  BigEndian => bytes.append_u32_be(b, x),
}

fn append_i32(mut b: Bytes, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.append_i32_le(b, x),
  BigEndian => bytes.append_i32_be(b, x),
}

fn append_f32(mut b: Bytes, x: Float, e: Endian) -> Unit = match e {
  LittleEndian => bytes.append_f32_le(b, x),
  BigEndian => bytes.append_f32_be(b, x),
}

fn put_u16(mut b: Bytes, pos: Int, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.put_u16_le(b, pos, x),
  BigEndian => bytes.put_u16_be(b, pos, x),
}

fn put_u32(mut b: Bytes, pos: Int, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.put_u32_le(b, pos, x),
  BigEndian => bytes.put_u32_be(b, pos, x),
}

fn put_i32(mut b: Bytes, pos: Int, x: Int, e: Endian) -> Unit = match e {
  LittleEndian => bytes.put_i32_le(b, pos, x),
  BigEndian => bytes.put_i32_be(b, pos, x),
}

fn main() -> Unit = {
  // ── the type as a value: bind, param, result, match, ==, repr ──
  let e: Endian = BigEndian
  let f = pick(false)
  println(name(e) + " " + name(f) + " " + name(flip(e)))
  println("${e} ${f} ${flip(f)}")
  println("${e == BigEndian} ${e == f} ${flip(e) == f}")
  let names = [LittleEndian, BigEndian, pick(true)] |> list.map((x) => name(x))
  println("${names}")
  // ── a stdlib-declared variant type as a value ──
  let ip: IpAddr = V4(10, 0, 0, 2)
  let lo = loopback(false)
  println(host(ip) + " " + host(lo) + " " + host(loopback(true)))
  println("${ip} ${lo == V4(127, 0, 0, 1)} ${ip == lo}")
  println("${[ip, lo, loopback(true)] |> list.map((x) => host(x))}")
  // ── an Endian VALUE dispatched to the endian-suffixed reads (the bound form) ──
  let b = bytes.from_list([1, 2, 3, 4])
  println("${read_u16(b, 0, e)} ${read_u16(b, 0, f)}")
  println("${read_u32(b, 0, pick(true))} ${read_i32(b, 0, flip(e))}")
  println(float.to_string(read_f32(bytes.from_list([63, 192, 0, 0]), 0, e)))
  // ── and the bare ctor form beside it (one representation) ──
  println("${read_u16(b, 2, LittleEndian)} ${read_u16(b, 2, BigEndian)}")
  // ── appends and puts with the bound value ──
  var w = bytes.zeros(0)
  append_u16(w, 258, e)
  append_u32(w, 258, f)
  append_i32(w, -2, flip(f))
  append_f32(w, 1.5, e)
  println("${bytes.to_list(w)}")
  var s = bytes.zeros(8)
  put_u16(s, 0, 258, e)
  put_u32(s, 2, 258, f)
  put_i32(s, 4, -2, pick(false))
  println("${bytes.to_list(s)}")
}
