// @contract: C-292
// gleam test/language/float_test.gleam (~50 cases): float arithmetic and
// block precedence, then the scientific-notation identity battery — a
// literal that is not correctly rounded at lex time fails one of these
// exact equalities. Division by zero prints the OBSERVED value (Almide is
// IEEE inf, unlike gleam's total-zero choice) so three targets must agree.
fn eq(x: Bool) -> String = if x then "1" else "0"

fn main() -> Unit = {
  println("${eq(0.0 + 0.0 == 0.0)}${eq(1.0 + 1.0 == 2.0)}${eq(1.0 + -3.0 == -2.0)}${eq(1.0 - -3.0 == 4.0)}${eq(1.0 - 4.5 == -3.5)}${eq(-2.0 * 4.0 == -8.0)}${eq(2.0 * -4.0 == -8.0)}")
  // block precedence
  println("${eq(2.0 * 2.0 + 3.0 == 7.0)}${eq(2.0 + 2.0 * 3.0 == 8.0)}${eq(2.0 * (2.0 + 3.0) == 10.0)}${eq((2.0 + 2.0) * 3.0 == 12.0)}")
  // scientific notation: addition
  println("${eq(0.0e0 + 0.0 == 0.0)}${eq(0.0e-0 + 0.0 == 0.0)}${eq(1.0e3 + 1.0 == 1001.0)}${eq(5.0 + 1.0e3 == 1005.0)}${eq(1.0e5 + -3.0e5 == -200_000.0)}${eq(1.0e50 + -1.0e50 == 0.0)}${eq(1.0e-3 + 1.0 == 1.001)}${eq(5.0 + 1.0e-3 == 5.001)}${eq(10.0e-2 + -3.0e-2 == 0.07)}")
  // subtraction
  println("${eq(1.0e3 - 1.0 == 999.0)}${eq(5.0 - 1.0e3 == -995.0)}${eq(1.0e5 - 1.0e5 == 0.0)}${eq(1.0e-3 - 1.0 == -0.999)}${eq(5.0 - 1.0e-3 == 4.999)}${eq(10.0e-2 - -3.0e-2 == 0.13)}")
  // multiplication
  println("${eq(2.0e1 * 2.0e1 == 400.0)}${eq(1.0e-5 * 1.0e5 == 1.0)}${eq(2.0e5 * 2.0e-5 == 4.0)}${eq(2.0e5 * 4.0e-4 == 80.0)}${eq(2.0e5 * 4.0e-5 == 8.0)}${eq(-2.0e-5 * 2.0e5 == -4.0)}${eq(-2.0e5 * -4.0e-5 == 8.0)}")
  // division, operands through lets so nothing folds
  let two = 2.0
  let zero = 0.0
  println(eq(two / two == 1.0))
  println(float.to_string(two / zero))
}
