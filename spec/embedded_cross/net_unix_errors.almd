// @contract: C-383
// net's Unix-domain sockets and shared-memory files on their error paths
// (#3620; the embedded lane's interim ops 104..=116). Every call answers an
// `err`, never a crash, and the text is the same on native and the embedded
// host: the argument checks are Almide's own, and an OS failure keeps the
// platform's wording, which both legs read from the same machine. A
// descriptor the program does not hold (never issued, a standard stream, or
// already closed) is refused before any system call. The socket path, a
// fresh name in the temp dir, is masked as `<path>`.
import env
import fs
import net
import random

fn masked(e: String, path: String) -> String = string.replace(e, path, "<path>")

fn show_int(r: Result[Int, String], path: String) -> String = match r {
  ok(_) => "ok",
  err(e) => "err ${masked(e, path)}",
}

fn show_unit(r: Result[Unit, String]) -> String = match r {
  ok(_) => "ok",
  err(e) => "err ${e}",
}

fn show_bytes(r: Result[Bytes, String]) -> String = match r {
  ok(b) => "ok ${bytes.len(b)}",
  err(e) => "err ${e}",
}

fn show_bool(r: Result[Bool, String]) -> String = match r {
  ok(v) => "ok ${v}",
  err(e) => "err ${e}",
}

fn show_list(r: Result[List[Int], String]) -> String = match r {
  ok(v) => "ok ${list.len(v)}",
  err(e) => "err ${e}",
}

effect fn main() -> Unit = {
  // A fresh socket path in the temp dir (a random name, so two runs at
  // once cannot meet), removed again before the closing line.
  let path = "${env.temp_dir()}/almide-unix-${random.int(0, 999999999)}.sock"
  let x = bytes.from_string("x")
  // Paths.
  println(show_int(net.unix_connect(path), path))
  println(show_int(net.unix_connect(""), path))
  let l = net.unix_listen(path)!
  println(show_int(net.unix_listen(path), path))
  let c = net.unix_connect(path)!
  let s = net.unix_accept(l)!
  // Descriptors the program does not hold: negative, a standard stream, and
  // a closed one, whose number differs between the legs and prints as
  // `closed`.
  let f = net.shm_create(4)!
  net.unix_close(f)!
  for fd in [-1, 0, 2, f] {
    let name = if fd == f then "closed" else int.to_string(fd)
    let lines = [
      show_int(net.unix_accept(fd), path),
      show_unit(net.unix_send(fd, x, [])),
      show_bytes(net.unix_recv(fd, 4)),
      "take ${list.len(net.unix_take_fds(fd))}",
      show_bool(net.unix_poll(fd, 0)),
      show_list(net.unix_wait([s, fd], 0)),
      show_unit(net.unix_close(fd)),
      show_unit(net.shm_resize(fd, 8)),
      show_unit(net.shm_write(fd, 0, x)),
      show_bytes(net.shm_read(fd, 0, 1))
    ]
    println("fd ${name}")
    for line in lines {
      println("  ${string.replace(line, "descriptor ${fd} ", "descriptor ${name} ")}")
    }
  }
  println(show_unit(net.unix_send(c, x, [s, 0])))
  println(show_unit(net.unix_send(c, x, [s, -5])))
  // Argument domains.
  let m = net.shm_create(16)!
  println(show_int(net.shm_create(-1), path))
  println(show_unit(net.shm_resize(m, -1)))
  println(show_unit(net.shm_write(m, -1, x)))
  println(show_bytes(net.shm_read(m, -1, 1)))
  println(show_bytes(net.shm_read(m, 0, -1)))
  let many = list.repeat(m, 29)
  println(show_unit(net.unix_send(c, x, many)))
  // The right descriptor for the wrong call: the OS refuses it.
  println(show_int(net.unix_accept(s), path))
  println(show_bytes(net.unix_recv(m, 4)))
  println(show_unit(net.unix_send(m, x, [])))
  println(show_unit(net.shm_write(c, 0, x)))
  println(show_bytes(net.shm_read(l, 0, 1)))
  // Nothing was sent: no descriptors wait, and the socket is idle.
  println("take ${list.len(net.unix_take_fds(s))}")
  println(show_bool(net.unix_poll(s, 0)))
  net.unix_close(m)!
  net.unix_close(c)!
  net.unix_close(s)!
  net.unix_close(l)!
  println(string.replace(show_unit(net.unix_close(l)), "descriptor ${l} ", "descriptor <listener> "))
  fs.remove(path)!
  println("done")
}
