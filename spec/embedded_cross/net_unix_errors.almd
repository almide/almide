// @contract: C-383
// unix's Unix-domain sockets and shared-memory files on their error paths
// (#3620, R-unix-01; the embedded lane's interim ops 104..=116). Every call
// answers an `err`, never a crash, and the text is the same on native and the
// embedded host: the argument checks are Almide's own, and an OS failure keeps
// the platform's wording, which both legs read from the same machine. A
// descriptor the program has closed is refused before any system call; one it
// never held cannot be written at all, since `unix.Fd` is opaque. (A
// shm_write out of the file's range aborts, so it is not staged here.) The
// socket path, a fresh name in the temp dir, is masked as `<path>`.
import env
import unix
import io
import fs
import random

fn masked(e: String, path: String) -> String = string.replace(e, path, "<path>")

// `descriptor <n> ` → `descriptor <name> `: the number is the OS's.
fn __mask_descriptor(line: String, name: String) -> String = match string.index_of(
  line,
  "descriptor ",
) {
  none => line,
  some(i) => {
    let rest = string.drop(line, i + 11)
    let digits = string.to_list(rest) |> list.take_while((ch) => string.contains("0123456789", ch)) |> list.len
    string.take(line, i + 11) + name + string.drop(rest, digits)
  },
}

fn show_int[A](r: Result[A, String], path: String) -> String = match r {
  ok(_) => "ok",
  err(e) => "err ${masked(e, path)}",
}

fn show_unit(r: Result[Unit, String]) -> String = match r {
  ok(_) => "ok",
  err(e) => "err ${e}",
}

fn show_bytes(r: Result[Bytes, String]) -> String = match r {
  ok(b) => "ok ${bytes.len(b)}",
  err(e) => "err ${e}",
}

fn show_bool(r: Result[Bool, String]) -> String = match r {
  ok(v) => "ok ${v}",
  err(e) => "err ${e}",
}

fn show_list[A](r: Result[List[A], String]) -> String = match r {
  ok(v) => "ok ${list.len(v)}",
  err(e) => "err ${e}",
}

effect fn main() -> Unit = {
  // A fresh socket path in the temp dir (a random name, so two runs at
  // once cannot meet), removed again before the closing line.
  let path = "${env.temp_dir()}/almide-unix-${random.int(0, 999999999)}.sock"
  let x = bytes.from_string("x")
  // Paths.
  println(show_int(unix.connect(path), path))
  println(show_int(unix.connect(""), path))
  let l = unix.listen(path)!
  println(show_int(unix.listen(path), path))
  let c = unix.connect(path)!
  let s = unix.accept(l)!
  // A descriptor the program closed; its number differs between the legs
  // and prints as `closed`.
  let f = unix.shm_create(4)!
  io.close(f)!
  for fd in [f] {
    let name = "closed"
    let lines = [
      show_int(unix.accept(fd), path),
      show_unit(unix.write_fds(fd, x, [])),
      show_bytes(io.read(fd, 4)),
      "take ${list.len(unix.take_fds(fd)!)}",
      show_bool((unix.select([fd], 0) |> result.map((xs) => list.len(xs) > 0))),
      show_list(unix.select([s, fd], 0)),
      show_unit(io.close(fd)),
      show_unit(unix.shm_resize(fd, 8)),
      show_bytes(unix.shm_read(fd, 0, 1))
    ]
    println("fd ${name}")
    for line in lines {
      println("  ${__mask_descriptor(line, name)}")
    }
  }
  println(__mask_descriptor(show_unit(unix.write_fds(c, x, [s, f])), "closed"))
  // Argument domains.
  let m = unix.shm_create(16)!
  println(show_int(unix.shm_create(-1), path))
  println(show_unit(unix.shm_resize(m, -1)))
  println(show_bytes(unix.shm_read(m, -1, 1)))
  println(show_bytes(unix.shm_read(m, 0, -1)))
  let many = list.repeat(m, 29)
  println(show_unit(unix.write_fds(c, x, many)))
  // The right descriptor for the wrong call: the OS refuses it.
  println(show_int(unix.accept(s), path))
  println(show_bytes(io.read(m, 4)))
  println(show_unit(unix.write_fds(m, x, [])))
  println(show_unit(unix.shm_write(c, 0, x)))
  println(show_bytes(unix.shm_read(l, 0, 1)))
  // Nothing was sent: no descriptors wait, and the socket is idle.
  println("take ${list.len(unix.take_fds(s)!)}")
  println(show_bool((unix.select([s], 0) |> result.map((xs) => list.len(xs) > 0))))
  io.close(m)!
  io.close(c)!
  io.close(s)!
  io.close(l)!
  println(__mask_descriptor(show_unit(io.close(l)), "<listener>"))
  fs.remove(path)!
  println("done")
}
