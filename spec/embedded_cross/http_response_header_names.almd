// @contract: C-455
// A fetched response's header list names every field in ASCII lowercase on
// every lane (C-455), in wire order with repeats kept and values unchanged,
// and leaves out the fields the client manages (C-370's nine, so
// `Transfer-Encoding` too). Lookups by name stay case-insensitive. The
// program is its own server: it listens on 127.0.0.1 port 0, `http.start`
// dials and writes the request, the program accepts, reads the request head
// and answers with mixed-case names, and `http.wait` reads the answer.
// Native and the embedded lane print the same transcript.
import http
import net
import io

effect fn read_head(s: net.TcpStream, acc: String) -> Result[String, String] = {
  if string.contains(acc, "\r\n\r\n") then ok(acc)
  else {
    let b = io.read(s, 4096)!
    if bytes.len(b) == 0 then ok(acc)
    else read_head(s, acc + bytes.to_string_lossy(b))
  }
}

effect fn exchange(l: net.TcpListener, port: Int, tag: String, reply: String) -> Unit = {
  match http.start(http.new_request("GET", "http://127.0.0.1:${port}/h", "", []), { total_ms: 0, idle_ms: 0 }) {
    err(e) => println("${tag}: start err ${e}"),
    ok(call) => {
      let s = net.tcp_accept(l)!
      let _ = read_head(s, "")!
      io.write(s, bytes.from_string(reply))!
      let answer = match http.wait(call) {
        ok(r) => "${http.status(r)} ${http.headers(r)} ${http.header(r, "X-Custom-Name") ?? "-"} ${http.header_values(r, "SET-COOKIE")} ${http.body(r)}",
        err(e) => "err ${e}",
      }
      let _ = io.close(s)
      println("${tag}: ${answer}")
    },
  }
}

effect fn main() -> Unit = {
  let l = net.tcp_listen("127.0.0.1", 0)!
  let port = net.tcp_local_port(l)!
  exchange(
    l,
    port,
    "length",
    "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Custom-Name: V\r\nSet-Cookie: a=1\r\nset-cookie: b=2\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi",
  )!
  exchange(
    l,
    port,
    "chunked",
    "HTTP/1.1 404 Not Found\r\nX-CUSTOM-NAME: W\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r\ngone\r\n0\r\n\r\n",
  )!
  let _ = io.close(l)
}
