// map.upsert — single-lookup insert-or-update: present → f(old) in place
// (insertion position preserved), absent → append init. The aggregation
// hot-loop form; get + set spells the same thing with two lookups.
test "absent key inserts init" {
  let m = map.upsert(map.new(), "a", 1, (v) => v + 100)
  assert_eq(map.get(m, "a"), some(1))
}

test "present key applies f to the old value" {
  let m0 = map.set(map.new(), "a", 10)
  let m = map.upsert(m0, "a", 999, (v) => v + 1)
  assert_eq(map.get(m, "a"), some(11))
  assert_eq(map.len(m), 1)
}

test "insertion order is preserved across upserts" {
  var m = map.new()
  for k in ["b", "a", "b", "c", "a"] {
    m = map.upsert(m, k, 1, (v) => v + 1)
  }
  assert_eq(map.keys(m), ["b", "a", "c"])
  assert_eq(map.get_or(m, "b", 0), 2)
  assert_eq(map.get_or(m, "a", 0), 2)
  assert_eq(map.get_or(m, "c", 0), 1)
}

test "a reused source stays intact (consume + clone-on-later-use)" {
  let m1 = map.set(map.new(), "k", 5)
  let m2 = map.upsert(m1, "k", 0, (v) => v * 2)
  assert_eq(map.get(m1, "k"), some(5))
  assert_eq(map.get(m2, "k"), some(10))
}

test "fold aggregation shape" {
  let counts = ["x", "y", "x"] |> list.fold(map.new(), (acc, k) => map.upsert(acc, k, 1, (n) => n + 1))
  assert_eq(map.get_or(counts, "x", 0), 2)
  assert_eq(map.get_or(counts, "y", 0), 1)
}
