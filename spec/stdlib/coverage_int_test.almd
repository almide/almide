// Coverage tests for int stdlib functions
test "int.wrap_add" {
  assert(int.wrap_add(255, 1, 8) == 0)
  assert(int.wrap_add(100, 200, 16) == 300)
}

test "int.wrap_mul" {
  assert(int.wrap_mul(2, 3, 8) == 6)
  assert(int.wrap_mul(16, 16, 8) == 0)
}

test "int.rotate_right" {
  assert_eq(int.rotate_right(1, 1, 8), 128)
  assert_eq(int.rotate_right(128, 1, 8), 64)
}

test "int.rotate_left" {
  assert_eq(int.rotate_left(1, 1, 8), 2)
  assert_eq(int.rotate_left(128, 1, 8), 1)
}

// #2492 — the count is reduced into [0, bits) Euclidean-ly: a negative count
// rotates the other way (it used to become an over-wide shift and return 0).
test "int.rotate_* with a negative count rotates the other way" {
  assert_eq(int.rotate_left(1, -1, 8), 128)
  assert_eq(int.rotate_right(1, -1, 8), 2)
  assert_eq(int.rotate_left(1, -9, 8), 128)
  assert_eq(int.rotate_right(128, -1, 8), 1)
  assert_eq(int.rotate_left(1, -1, 64), -9223372036854775808)
  assert_eq(int.rotate_right(1, -63, 64), -9223372036854775808)
  assert_eq(int.rotate_left(1, -64, 64), 1)
}

test "int.to_u32" {
  assert_eq(int.to_u32(255), 255)
  assert_eq(int.to_u32(0), 0)
  assert_eq(int.to_u32(4294967296), 0)
}

test "int.to_u8" {
  assert_eq(int.to_u8(255), 255)
  assert_eq(int.to_u8(256), 0)
  assert_eq(int.to_u8(300), 44)
}

test "int.bits_to_float" {
  assert_eq(int.bits_to_float(4607182418800017408), 1.0)
  assert_eq(int.bits_to_float(0), 0.0)
  assert_eq(float.to_bits(int.bits_to_float(4614253070214989087)), 4614253070214989087)
}
