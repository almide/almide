test "map index assignment mutates in place" {
  var m = map.new()
  m = map.set(m, "a", 1)
  m = map.set(m, "b", 2)
  assert_eq(map.len(m), 2)
  assert_eq(map.get(m, "a"), some(1))
  assert_eq(map.get(m, "b"), some(2))
}

test "map index assignment overwrites existing key" {
  var m = map.new()
  m = map.set(m, "x", 10)
  m = map.set(m, "x", 20)
  assert_eq(map.len(m), 1)
  assert_eq(map.get(m, "x"), some(20))
}

test "map.remove removes key in place" {
  var m = map.new()
  m = map.set(m, "a", 1)
  m = map.set(m, "b", 2)
  m = map.remove(m, "a")
  assert_eq(map.len(m), 1)
  assert_eq(map.get(m, "a"), none)
  assert_eq(map.get(m, "b"), some(2))
}

test "map.clear removes all entries" {
  var m = map.new()
  m = map.set(m, "a", 1)
  m = map.set(m, "b", 2)
  map.clear(m)
  assert_eq(map.len(m), 0)
  assert(map.is_empty(m))
}
