// bytes.xor / pad_left / pad_right / copy_from
test "xor pairwise" {
  var a = bytes.new()
  bytes.append_u8(a, 0xFF)
  bytes.append_u8(a, 0x0F)
  bytes.append_u8(a, 0xAA)
  var b = bytes.new()
  bytes.append_u8(b, 0x55)
  bytes.append_u8(b, 0xF0)
  bytes.append_u8(b, 0xAA)
  let r = bytes.xor(a, b)
  assert_eq(bytes.len(r), 3)
  assert_eq(bytes.get(r, 0) ?? 0, 0xAA)
  // 0xFF ^ 0x55
  assert_eq(bytes.get(r, 1) ?? 0, 0xFF)
  // 0x0F ^ 0xF0
  // 0xAA ^ 0xAA
  assert_eq(bytes.get(r, 2) ?? 0, 0x00)
}

test "xor short result is min length" {
  var a = bytes.new()
  bytes.append_u8(a, 1)
  bytes.append_u8(a, 2)
  bytes.append_u8(a, 3)
  var b = bytes.new()
  bytes.append_u8(b, 1)
  let r = bytes.xor(a, b)
  assert_eq(bytes.len(r), 1)
  assert_eq(bytes.get(r, 0) ?? 0, 0)
}

test "pad_left fills with val" {
  var b = bytes.new()
  bytes.append_u8(b, 0xAA)
  bytes.append_u8(b, 0xBB)
  let p = bytes.pad_start(b, 5, 0)
  assert_eq(bytes.len(p), 5)
  assert_eq(bytes.get(p, 0) ?? 0, 0)
  assert_eq(bytes.get(p, 2) ?? 0, 0)
  assert_eq(bytes.get(p, 3) ?? 0, 0xAA)
  assert_eq(bytes.get(p, 4) ?? 0, 0xBB)
}

test "pad_right fills with val" {
  var b = bytes.new()
  bytes.append_u8(b, 0xAA)
  bytes.append_u8(b, 0xBB)
  let p = bytes.pad_end(b, 5, 0xFF)
  assert_eq(bytes.len(p), 5)
  assert_eq(bytes.get(p, 0) ?? 0, 0xAA)
  assert_eq(bytes.get(p, 1) ?? 0, 0xBB)
  assert_eq(bytes.get(p, 2) ?? 0, 0xFF)
  assert_eq(bytes.get(p, 4) ?? 0, 0xFF)
}

test "pad_left already long enough returns clone" {
  let b = bytes.from_string("hello")
  let p = bytes.pad_start(b, 3, 0)
  assert_eq(bytes.len(p), 5)
}

test "copy_from in-place" {
  var dst = bytes.zeros(8)
  bytes.fill(dst, 0)
  let src = bytes.from_string("ABCD")
  bytes.copy_from(dst, src, 2, 0, 4)
  assert_eq(bytes.get(dst, 0) ?? 0, 0)
  assert_eq(bytes.get(dst, 1) ?? 0, 0)
  assert_eq(bytes.get(dst, 2) ?? 0, 0x41)
  assert_eq(bytes.get(dst, 5) ?? 0, 0x44)
  assert_eq(bytes.get(dst, 6) ?? 0, 0)
}

test "copy_from clamps length" {
  var dst = bytes.zeros(4)
  bytes.fill(dst, 0)
  let src = bytes.from_string("ABCDEFGH")
  // Try to copy 100 bytes — should clamp to dst size remaining
  bytes.copy_from(dst, src, 1, 0, 100)
  assert_eq(bytes.get(dst, 0) ?? 0, 0)
  assert_eq(bytes.get(dst, 1) ?? 0, 0x41)
  assert_eq(bytes.get(dst, 3) ?? 0, 0x43)
}

test "copy_from out-of-range no-op" {
  var dst = bytes.zeros(4)
  bytes.fill(dst, 0xFF)
  let src = bytes.from_string("ABCD")
  bytes.copy_from(dst, src, 100, 0, 4)
  // dst unchanged (no out-of-range write)
  assert_eq(bytes.get(dst, 0) ?? 0, 0xFF)
}
