// wasm:skip
// Executable check on the worked example in docs/stdlib/mem.md.
//
// Separate from bundled_module_docs_test.almd because `mem.save`/`restore` walls
// inside a PROMOTED TEST fn — "scalar binding outside the value subset" — even
// though the identical code runs on both legs from `main`. That is a test-mode
// subset gap rather than a `mem` defect, and leaving it in the shared file took
// four other passing doc tests to the native fallback with it.
import mem

test "docs mem save/restore round-trip" {
  let mark = mem.save()
  mem.restore(mark)
  assert_eq(1, 1)
}
