// heap (R-heap-01, R-heap-02): a min-first priority queue. The order comes
// from the empty constructor — natural (`new`, `from_list`), a key
// (`new_by`) or a comparator (`new_with`) — and equal elements leave in the
// order they went in. push / pop / clear are in-place `mut` verbs. Each fn
// runs with Int and String elements and meets the empty heap.
import heap

local fn desc(a: Int, b: Int) -> Int = if a > b then -1
else if a < b then 1 else 0

local fn drain(h: Heap[(Int, String)]) -> List[String] = {
  var q = h
  var out: List[String] = []
  for _ in 0..<heap.len(h) {
    let next = heap.pop(q) ?? (0, "")
    list.push(out, next.1)
  }
  out
}

test "new, push, pop and peek: the least comes out first" {
  var h: Heap[Int] = heap.new()
  for x in [5, 1, 4, 1, 3] {
    heap.push(h, x)
  }
  assert_eq(heap.len(h), 5)
  assert_eq(heap.peek(h), some(1))
  assert_eq(heap.pop(h), some(1))
  assert_eq(heap.pop(h), some(1))
  assert_eq(heap.pop(h), some(3))
  assert_eq(heap.len(h), 2)
  var w: Heap[String] = heap.new()
  heap.push(w, "pear")
  heap.push(w, "apple")
  heap.push(w, "fig")
  assert_eq(heap.pop(w), some("apple"))
  assert_eq(heap.peek(w), some("fig"))
  let e: Heap[Int] = heap.new()
  assert_eq(heap.peek(e), none)
  assert_eq(heap.is_empty(e), true)
  var e2: Heap[Int] = heap.new()
  assert_eq(heap.pop(e2), none)
}

test "from_list and to_list: to_list is the pop order, list.sort's order" {
  let xs = [
    9,
    2,
    7,
    2,
    5,
    0,
    8,
    1
  ]
  let h = heap.from_list(xs)
  assert_eq(heap.to_list(h), list.sort(xs))
  assert_eq(heap.len(h), 8)
  let w = heap.from_list(["b", "c", "a"])
  assert_eq(heap.to_list(w), ["a", "b", "c"])
  let e: Heap[String] = heap.from_list([])
  assert_eq(heap.to_list(e), [])
  var big: Heap[Int] = heap.new()
  for i in 0..<60 {
    heap.push(big, (i * 37) % 60)
  }
  assert_eq(heap.to_list(big), list.range(0, 60))
}

test "new_with orders by the comparator" {
  var h = heap.new_with(desc)
  for x in [3, 7, 1, 7] {
    heap.push(h, x)
  }
  assert_eq(heap.pop(h), some(7))
  assert_eq(heap.to_list(h), [7, 3, 1])
  var w = heap.new_with((a: String, b: String) => string.len(a) - string.len(b))
  heap.push(w, "ccc")
  heap.push(w, "a")
  heap.push(w, "bb")
  assert_eq(heap.to_list(w), ["a", "bb", "ccc"])
}

test "new_by orders by the key, and equal keys leave in push order" {
  var h = heap.new_by((p: (Int, String)) => p.0)
  heap.push(h, (2, "b1"))
  heap.push(h, (1, "a1"))
  heap.push(h, (2, "b2"))
  heap.push(h, (1, "a2"))
  heap.push(h, (2, "b3"))
  assert_eq(drain(h), ["a1", "a2", "b1", "b2", "b3"])
  var w = heap.new_by((s: String) => string.len(s))
  heap.push(w, "xx")
  heap.push(w, "y")
  heap.push(w, "zz")
  assert_eq(heap.to_list(w), ["y", "xx", "zz"])
}

test "clear empties in place and keeps the order" {
  var h = heap.new_with(desc)
  heap.push(h, 1)
  heap.push(h, 2)
  heap.clear(h)
  assert_eq(heap.is_empty(h), true)
  heap.push(h, 1)
  heap.push(h, 5)
  assert_eq(heap.peek(h), some(5))
  var w = heap.from_list(["a"])
  heap.clear(w)
  assert_eq(heap.len(w), 0)
}

test "contains, any, all, count and filter do not depend on the inner order" {
  let h = heap.from_list([4, 1, 3, 2])
  assert_eq(heap.contains(h, 3), true)
  assert_eq(heap.contains(h, 9), false)
  assert_eq(heap.any(h, (x) => x > 3), true)
  assert_eq(heap.all(h, (x) => x > 1), false)
  assert_eq(heap.count(h, (x) => x % 2 == 0), 2)
  assert_eq(heap.to_list(heap.filter(h, (x) => x > 1)), list.filter(heap.to_list(h), (x) => x > 1))
  var t = heap.new_by((p: (Int, String)) => p.0)
  heap.push(t, (2, "b1"))
  heap.push(t, (1, "a1"))
  heap.push(t, (2, "b2"))
  let kept = heap.filter(t, (p) => p.0 == 2)
  assert_eq(drain(kept), ["b1", "b2"])
  assert_eq(heap.len(t), 3)
  let w = heap.from_list(["pear", "fig"])
  assert_eq(heap.contains(w, "fig"), true)
  assert_eq(heap.count(w, (s) => string.len(s) > 3), 1)
  let e: Heap[Int] = heap.new()
  assert_eq(heap.contains(e, 1), false)
  assert_eq(heap.any(e, (x) => x > 0), false)
  assert_eq(heap.all(e, (x) => x > 0), true)
  assert_eq(heap.count(e, (x) => x > 0), 0)
  assert_eq(heap.is_empty(heap.filter(e, (x) => x > 0)), true)
}
