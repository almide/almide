// sum and product over any Numeric element (R-L0-42): every number type adds
// with its own operator (integers wrap), the empty fold is the type's zero or
// one, and List, Set and Deque all fold the same way.
import bigint

test "list.sum and list.product per element type" {
  assert_eq(list.sum([1, 2, 3]), 6)
  assert_eq(list.product([2, 3, 4]), 24)
  let empty: List[Int] = []
  assert_eq(list.sum(empty), 0)
  assert_eq(list.product(empty), 1)
  assert_eq(list.sum([1.5, 2.25]), 3.75)
  assert_eq(list.product([1.5, 2.0]), 3.0)
  assert_eq(int.from(list.sum([int8.from(100), int8.from(20)])), 120)
  assert_eq(int.from(list.sum([int8.from(100), int8.from(100)])), -56)
  assert_eq(int.from(list.product([uint8.from(16), uint8.from(16)])), 0)
  assert_eq(uint64.to_string(list.sum([uint64.max_value(), uint64.from(1)])), "0")
  assert_eq(int.from(list.sum([int64.from(5), int64.from(-7)])), -2)
  assert_eq(float.from(list.sum([float32.from(0.5), float32.from(0.25)])), 0.75)
  assert_eq(float.from(list.product([float64.from(3), float64.from(0.5)])), 1.5)
  assert_eq(list.sum([int.max_value(), 1]), int.min_value())
}

test "sum and product of BigInt do not wrap" {
  let big = bigint.from(int.max_value())
  assert_eq(bigint.to_string(list.sum([big, big, bigint.from(2)])), "18446744073709551616")
  assert_eq(bigint.to_string(list.product([big, big])), "85070591730234615847396907784232501249")
  let empty: List[BigInt] = []
  assert_eq(bigint.to_string(list.sum(empty)), "0")
  assert_eq(bigint.to_string(list.product(empty)), "1")
}

test "Set and Deque fold like List" {
  assert_eq(set.sum(set.from_list([1, 2, 2, 3])), 6)
  assert_eq(set.product(set.from_list([2, 5])), 10)
  assert_eq(deque.sum(deque.from_list([1.5, 1.5])), 3.0)
  assert_eq(deque.product(deque.from_list([2, 2, 2])), 8)
  assert_eq(int.from(deque.sum(deque.from_list([int16.from(30000), int16.from(1)]))), 30001)
}

test "pipe and method forms" {
  assert_eq([1, 2, 3] |> list.sum, 6)
  assert_eq([4, 5].sum(), 9)
}
