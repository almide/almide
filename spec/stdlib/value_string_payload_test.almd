// ADR-0013 stage 2 step 6: a Value's string payload is the Almide String
// itself (natively, the shared buffer under ALMIDE_SHARED_STR). Every way a
// string enters or leaves a Value must keep its bytes, and a payload must not
// follow later edits of the string it was built from.
import json

type User: Codec = { name: String, tags: List[String] }

test "a string put into a Value comes back unchanged" {
  let s = string.repeat("ab", 3)
  let v = value.str(s)
  assert_eq(value.as_string(v), ok("ababab"))
}

test "a Value payload does not follow a later push on its source" {
  var s = "base"
  let v = value.str(s)
  string.push(s, "-more")
  assert_eq(s, "base-more")
  assert_eq(value.as_string(v), ok("base"))
}

test "string payloads survive parse, field reads and stringify" {
  let v = json.parse("{\"name\": \"Ada \\\"L\\\"\", \"tags\": [\"x\", \"y\\n\"]}")!
  assert_eq(json.get_string(v, "name"), some("Ada \"L\""))
  assert_eq(json.stringify(v), "{\"name\":\"Ada \\\"L\\\"\",\"tags\":[\"x\",\"y\\n\"]}")
}

test "a derived decode and encode round-trips string fields" {
  let u = User { name: "Grace", tags: ["a", "bb"] }
  let back = User.decode(User.encode(u))!
  assert_eq(back.name, "Grace")
  assert_eq(back.tags, ["a", "bb"])
}

test "one string shared by many Values keeps every copy equal" {
  let s = string.repeat("z", 64)
  let vs = list.range(0, 100) |> list.map((i) => value.str(s))
  assert_eq(list.all(vs, (v) => value.as_string(v) == ok(s)), true)
}
