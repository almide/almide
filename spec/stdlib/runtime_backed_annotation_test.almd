// #1053: runtime-backed stdlib nominals (`HttpRequest`/`HttpResponse`) and
// `value.Path` are annotatable in USER signatures — bare or module-qualified —
// whenever the owner module is imported. The stdlib's own docs spell these
// types, so a typed helper over them must be writable.
import http

fn tag(resp: HttpResponse) -> http.HttpResponse = http.set_header(resp, "x-t", "1")

fn extend(p: value.Path, k: String) -> value.Path = value.key(p, k)

test "HttpResponse is annotatable in a typed helper" {
  let r = tag(http.response(200, "body"))
  assert_eq(http.header(r, "x-t") ?? "", "1")
  assert_eq(http.body(r), "body")
}

test "value.Path is annotatable in a typed helper" {
  let obj = value.object([
    ("a", value.object([("b", value.int(3))]))
  ])
  let p = extend(extend(value.root(), "a"), "b")
  match value.get_path(obj, p) {
    some(v) => assert_eq(value.as_int(v)?, some(3)),
    none => assert(false, "path should hit"),
  }
}
