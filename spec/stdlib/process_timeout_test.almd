// #1040 / C-214 — `process.exec_status_timeout`: the one admissible timeout.
// Spawning a process is already outside the byte-identity contract, so
// bounding it adds no nondeterminism the spawn did not. The contract's two
// halves: IF the deadline fires, the err value is exactly
// `exec timed out after <ms>ms` and the child is killed; WHETHER it fires is a
// function of the host — which is why the firing case below uses a WIDE margin
// (a 5s sleeper against a 100ms bound fires on any plausible machine, the
// C-200 fan-trap fixture discipline).
//
// The sleeper is `perl -e 'sleep 5'` because perl exists on every CI image
// (macOS / Ubuntu / Windows) while `sleep(1)` does not — the perl here is the
// FIXTURE's stopwatch, not a port dependency (#1040 removed that).
import process

test "a fast child completes under a generous bound" {
  match process.exec_status_timeout("perl", ["-e", 'print "hi"'], 30000) {
    ok(st) => {
      assert_eq(st.code, 0)
      assert_eq(st.stdout, "hi")
    },
    err(e) => {
      println(e)
      assert(false)
    },
  }
}

test "the deadline kills a hung child with the pinned err value" {
  match process.exec_status_timeout("perl", ["-e", "sleep 5"], 100) {
    ok(_) => assert(false),
    err(e) => assert_eq(e, "exec timed out after 100ms"),
  }
}

test "a chatty child cannot deadlock the drain" {
  // ~1MB of output — far past any pipe buffer; the reader threads must drain
  // it while the parent polls, or this hangs into the 30s bound.
  match process.exec_status_timeout("perl", ["-e", 'print "x" x 1000000'], 30000) {
    ok(st) => assert_eq(string.len(st.stdout), 1000000),
    err(_) => assert(false),
  }
}

test "a missing binary is the exec error, not a timeout" {
  match process.exec_status_timeout("almide-no-such-binary-1040", [], 1000) {
    ok(_) => assert(false),
    err(e) => assert(string.starts_with(e, "exec failed:")),
  }
}
