// map higher-order function tests — fold, any, all, count, find, update, entries, merge, from_list, keys, values
test "map.fold sums all values" {
  let m = ["a": 10, "b": 20, "c": 30]
  let total = map.fold(m, 0, (acc, (k, v)) => acc + v)
  assert_eq(total, 60)
}

test "map.fold on empty map" {
  let m: Map[String, Int] = [:]
  let result = map.fold(m, 42, (acc, (k, v)) => acc + v)
  assert_eq(result, 42)
}

test "map.fold multiplies values" {
  let m = ["x": 2, "y": 3, "z": 5]
  let product = map.fold(m, 1, (acc, (k, v)) => acc * v)
  assert_eq(product, 30)
}

test "map.fold counts entries" {
  let m = ["a": 1, "b": 2]
  let count = map.fold(m, 0, (acc, (k, v)) => acc + 1)
  assert_eq(count, 2)
}

test "map.any on empty map" {
  let m: Map[String, Int] = [:]
  assert_eq(map.any(m, (k, v) => v > 0), false)
}

test "map.any checks by key" {
  let m = ["admin": 1, "user": 2]
  assert_eq(map.any(m, (k, v) => k == "admin"), true)
  assert_eq(map.any(m, (k, v) => k == "root"), false)
}

test "map.any positive" {
  let m = ["a": 1, "b": 100]
  assert_eq(map.any(m, (k, v) => v >= 100), true)
}

test "map.any negative" {
  let m = ["a": 1, "b": 2]
  assert_eq(map.any(m, (k, v) => v > 50), false)
}

test "map.all on empty map" {
  let m: Map[String, Int] = [:]
  assert_eq(map.all(m, (k, v) => v > 0), true)
}

test "map.all all match" {
  let m = ["a": 5, "b": 10]
  assert_eq(map.all(m, (k, v) => v > 0), true)
}

test "map.all not all match" {
  let m = ["a": 5, "b": 0]
  assert_eq(map.all(m, (k, v) => v > 0), false)
}

test "map.count on empty map" {
  let m: Map[String, Int] = [:]
  assert_eq(map.count(m, (k, v) => v > 0), 0)
}

test "map.count all match" {
  let m = ["a": 1, "b": 2, "c": 3]
  assert_eq(map.count(m, (k, v) => v > 0), 3)
}

test "map.count none match" {
  let m = ["a": 1, "b": 2]
  assert_eq(map.count(m, (k, v) => v > 10), 0)
}

test "map.count some match" {
  let m = ["a": 1, "b": 5, "c": 10]
  assert_eq(map.count(m, (k, v) => v >= 5), 2)
}

test "map.find on empty map" {
  let m: Map[String, Int] = [:]
  let found = map.find(m, (k, v) => v > 0)
  assert_eq(option.is_none(found), true)
}

test "map.find no match" {
  let m = ["a": 1, "b": 2]
  let found = map.find(m, (k, v) => v > 100)
  assert_eq(option.is_none(found), true)
}

test "map.find match exists" {
  let m = ["a": 1, "b": 50, "c": 100]
  let found = map.find(m, (k, v) => v >= 50)
  assert_eq(option.is_some(found), true)
}

test "map.update existing key" {
  let m = ["score": 100]
  let m2 = map.update(m, "score", (v) => v + 50)
  assert_eq(map.get(m2, "score"), some(150))
}

test "map.update multiply" {
  let m = ["x": 3]
  let m2 = map.update(m, "x", (v) => v * 10)
  assert_eq(map.get(m2, "x"), some(30))
}

test "map.to_list returns pairs" {
  let m = ["b": 2, "a": 1, "c": 3]
  let es = map.to_list(m)
  assert_eq(list.len(es), 3)
}

test "map.to_list on empty" {
  let m: Map[String, Int] = [:]
  let es = map.to_list(m)
  assert_eq(list.len(es), 0)
}

test "map.merge overlapping keys" {
  let a = ["x": 1, "y": 2]
  let b = ["y": 20, "z": 30]
  let c = map.merge(a, b)
  assert_eq(map.get(c, "x"), some(1))
  assert_eq(map.get(c, "y"), some(20))
  assert_eq(map.get(c, "z"), some(30))
  assert_eq(map.len(c), 3)
}

test "map.merge with empty" {
  let a = ["a": 1]
  let b: Map[String, Int] = [:]
  assert_eq(map.len(map.merge(a, b)), 1)
  assert_eq(map.len(map.merge(b, a)), 1)
}

test "map.merge both empty" {
  let a: Map[String, Int] = [:]
  let b: Map[String, Int] = [:]
  assert_eq(map.len(map.merge(a, b)), 0)
}

test "map.from_list duplicates last wins" {
  let m = map.from_list([("a", 1), ("a", 2)])
  assert_eq(map.get(m, "a"), some(2))
}

test "map.from_list basic" {
  let m = map.from_list([("x", 10), ("y", 20)])
  assert_eq(map.get(m, "x"), some(10))
  assert_eq(map.get(m, "y"), some(20))
}

test "map.keys returns all keys" {
  let m = ["x": 10, "y": 20, "z": 30]
  let ks = map.keys(m)
  assert_eq(list.len(ks), 3)
  assert_eq(list.contains(ks, "x"), true)
  assert_eq(list.contains(ks, "y"), true)
  assert_eq(list.contains(ks, "z"), true)
}

test "map.keys on empty" {
  let m: Map[String, Int] = [:]
  assert_eq(list.len(map.keys(m)), 0)
}

test "map.values returns all values" {
  let m = ["a": 10, "b": 20]
  let vs = map.values(m)
  assert_eq(list.len(vs), 2)
  assert_eq(list.contains(vs, 10), true)
  assert_eq(list.contains(vs, 20), true)
}

test "map.values on empty" {
  let m: Map[String, Int] = [:]
  assert_eq(list.len(map.values(m)), 0)
}

test "map.is_empty on empty" {
  let m: Map[String, Int] = [:]
  assert_eq(map.is_empty(m), true)
}

test "map.is_empty on non-empty" {
  let m = ["a": 1]
  assert_eq(map.is_empty(m), false)
}

test "map.contains existing" {
  let m = ["a": 1, "b": 2]
  assert_eq(map.contains(m, "a"), true)
}

test "map.contains missing" {
  let m = ["a": 1]
  assert_eq(map.contains(m, "z"), false)
}

test "map.remove existing key" {
  let m = ["a": 1, "b": 2]
  let m2 = map.remove(m, "a")
  assert_eq(map.len(m2), 1)
  assert_eq(map.contains(m2, "a"), false)
}

test "map.remove non-existent key" {
  let m = ["a": 1]
  let m2 = map.remove(m, "z")
  assert_eq(map.len(m2), 1)
}

test "map.get ?? existing" {
  let m = ["a": 10]
  assert_eq(map.get(m, "a") ?? 0, 10)
}

test "map.get ?? missing" {
  let m = ["a": 10]
  assert_eq(map.get(m, "z") ?? 99, 99)
}

test "map.get ?? string values existing" {
  let m = ["a": "x", "b": "y"]
  assert_eq(map.get(m, "b") ?? "fallback", "y")
}

test "map.get ?? string values missing" {
  let m = ["a": "x"]
  assert_eq(map.get(m, "z") ?? "fallback", "fallback")
}

test "map.get ?? nested scalar-value map" {
  let inner: Map[String, Bool] = ["x": true]
  let nested: Map[String, Map[String, Bool]] = [
    "k0": ["a": false],
    "k1": ["b": true]
  ]
  let hit = map.get(nested, "k0") ?? inner
  let miss = map.get(nested, "zz") ?? inner
  assert_eq(map.contains(hit, "a"), true)
  assert_eq(map.contains(miss, "x"), true)
}

test "map.get ?? option-valued map" {
  let m: Map[String, String?] = ["k": some("z"), "n": none]
  assert_eq(map.get(m, "k") ?? none, some("z"))
  assert_eq(map.get(m, "n") ?? some("x"), none)
  assert_eq(map.get(m, "zz") ?? some("fb"), some("fb"))
}

test "map.fold into an option-valued map accumulator" {
  let src: Map[String, Int] = ["a": 1, "b": 2]
  let acc0: Map[String, String?] = [:]
  let r = map.fold(src, acc0, ((acc, (k, v)) => ["k": some("v")]))
  assert_eq(map.get(r, "k") ?? none, some("v"))
}

test "option-valued map literal churn" {
  var hits = 0
  for i in [1, 2, 3, 4, 5] {
    let m: Map[String, String?] = ["k": some("z"), "n": none]
    assert_eq(map.get(m, "k") ?? none, some("z"))
    hits = hits + 1
  }
  assert_eq(hits, 5)
}

test "map.get ?? on a tuple-valued map" {
  let m: Map[String, (String, String)] = ["k0": ("a", "b"), "k1": ("c", "d")]
  let got = map.get(m, "k0") ?? ("x", "y")
  let (l, r) = got
  assert_eq(l + r, "ab")
  let miss = map.get(m, "zz") ?? ("x", "y")
  let (l2, r2) = miss
  assert_eq(l2 + r2, "xy")
}

test "tuple-valued map literal churn" {
  var hits = 0
  for i in [1, 2, 3] {
    let m: Map[String, (String, String)] = ["k": ("p", "q")]
    let (l, r) = map.get(m, "k") ?? ("x", "y")
    assert_eq(l + r, "pq")
    hits = hits + 1
  }
  assert_eq(hits, 3)
}

test "list of option-maps: literal and get_or" {
  let n1: Map[String, Bool] = ["x": true]
  let y2: Map[String, Bool]? = none
  let xs = [
    some(["a": true]),
    some(n1),
    none
  ]
  assert_eq(list.len(xs), 3)
  let got = list.get(xs, 0) ?? y2
  assert_eq(map.contains(option.unwrap_or(got, n1), "a"), true)
}

test "option-map list churn" {
  var hits = 0
  for i in [1, 2, 3] {
    let m: Map[String, Bool] = ["k": true]
    let xs = [
      some(m),
      some(["b": false]),
      none
    ]
    assert_eq(list.len(xs), 3)
    hits = hits + 1
  }
  assert_eq(hits, 3)
}

test "map.get ?? and remove on a result-valued map" {
  let s0: Result[Int, String] = err("boom")
  let okv: Result[Int, String] = ok(7)
  let m: Map[String, Result[Int, String]] = ["k0": s0, "k1": okv]
  assert_eq(result.unwrap_or(map.get(m, "k1") ?? err("d"), 0), 7)
  assert_eq(result.unwrap_or(map.get(m, "k0") ?? err("d"), 42), 42)
  let m2 = map.remove(m, "k0")
  assert_eq(result.unwrap_or(map.get(m2, "k0") ?? ok(9), 0), 9)
  assert_eq(result.unwrap_or(map.get(m2, "k1") ?? err("d"), 0), 7)
}

test "result-valued map literal churn" {
  var total = 0
  for i in [1, 2, 3] {
    let m: Map[String, Result[Int, String]] = ["a": ok(i), "b": err("x")]
    total = total + result.unwrap_or(map.get(m, "a") ?? ok(0), 0)
  }
  assert_eq(total, 6)
}

test "nested scalar-value map literal churn" {
  var count = 0
  for i in [1, 2, 3, 4, 5] {
    let nested: Map[String, Map[String, Int]] = [
      "k0": ["v": i],
      "k1": ["w": i + 1]
    ]
    let d: Map[String, Int] = [:]
    let got = map.get(nested, "k0") ?? d
    count = count + map.get(got, "v") ?? 0
  }
  assert_eq(count, 15)
}

test "list of bare maps: literal, index and get_or" {
  let xs: List[Map[String, Bool]] = [
    ["k0": true, "k1": false],
    ["k2": true]
  ]
  assert_eq(list.len(xs), 2)
  let d: Map[String, Bool] = [:]
  assert_eq(map.get(list.get(xs, 0) ?? d, "k0") ?? false, true)
  assert_eq(map.get(list.get(xs, 0) ?? d, "k1") ?? true, false)
  assert_eq(map.get(list.get(xs, 1) ?? d, "k2") ?? false, true)
  assert_eq(map.get(list.get(xs, 9) ?? d, "k0") ?? false, false)
}

test "bare-map list literal churn" {
  var hits = 0
  for i in [1, 2, 3, 4, 5] {
    let xs: List[Map[String, Int]] = [
      ["a": i],
      ["b": i + 1],
      ["c": i + 2]
    ]
    let d: Map[String, Int] = [:]
    hits = hits + map.get(list.get(xs, 2) ?? d, "c") ?? 0
  }
  assert_eq(hits, 25)
}

test "bare-map list literal with a computed element" {
  let one: Map[String, Bool] = ["x": true]
  let xs: List[Map[String, Bool]] = [
    one,
    ["y": false],
    ["z": true]
  ]
  let d: Map[String, Bool] = [:]
  assert_eq(list.len(xs), 3)
  assert_eq(map.get(list.get(xs, 0) ?? d, "x") ?? false, true)
  assert_eq(map.contains(one, "x"), true)
}

// R-map-09: the entry callbacks take the entry as ONE (K, V) tuple — the
// element map.to_list yields — written as a tuple pattern, a plain
// parameter, two parameters read as the tuple's elements, or a named fn.
fn heavy(e: (String, Int)) -> Bool = e.1 >= 5

test "map entry callbacks take the entry tuple" {
  let m = ["a": 1, "b": 5, "c": 10]
  assert_eq(map.count(m, ((k, v)) => v >= 5), 2)
  assert_eq(map.count(m, (e) => e.1 >= 5), 2)
  assert_eq(map.count(m, (k, v) => v >= 5), 2)
  assert_eq(map.count(m, heavy), 2)
  assert_eq(map.filter(m, heavy), ["b": 5, "c": 10])
  assert_eq(map.any(m, (e) => e.0 == "c"), true)
  assert_eq(map.all(m, heavy), false)
  assert_eq(map.find(m, (e) => e.1 > 1), some(("b", 5)))
  assert_eq(map.fold(m, "", (acc, e) => acc + e.0), "abc")
  assert_eq(map.fold(m, 0, (acc, (_, v)) => acc + v), 16)
}

test "a two-parameter lambda reads a tuple element's parts" {
  let pairs = [(1, 2), (3, 4)]
  assert_eq(list.map(pairs, (a, b) => a + b), [3, 7])
  assert_eq(pairs |> list.filter((a, b) => a > 1), [(3, 4)])
}
