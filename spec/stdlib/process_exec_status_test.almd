import process
import env

test "process.output returns a ProcessStatus on success" {
  let s = process.output(process.ProcessCommand { cmd: "echo", args: ["hi"] })!
  assert_eq(s.code, 0)
  assert(string.contains(s.stdout, "hi"))
}

test "process.output on failing command returns non-zero code" {
  // `false` is a POSIX command that always exits 1
  let is_win = (env.get("OS") ?? "") == "Windows_NT"
  if not is_win then {
    let s = process.output(process.ProcessCommand { cmd: "false", args: [] })!
    assert(s.code != 0)
  } else {
  }
}

test "process.output on nonexistent command returns err" {
  let r = process.output(process.ProcessCommand { cmd: "nonexistent_command_xyz_12345", args: [] })
  match r {
    ok(_) => assert(false),
    err(msg) => assert(string.len(msg) > 0),
  }
}
