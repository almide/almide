// The sized→sized half of the integer conversion matrix (#956): every LOSSY
// ordered pair carries `to_<dst>_checked` / `to_<dst>_saturating`, every
// carrier has `min_value`/`max_value`, and `UInt64 → Int` (the one lossy
// widening) is `int.from_uint64_checked/_saturating`. The SHAPE of the
// surface is machine-enforced by the numeric-matrix gate in
// `almide docs-gen --check`; this file pins the SEMANTICS: reject/accept at
// the exact boundaries, clamp direction, and the UInt64 upper half that a
// signed pivot would misread. The Int-source row is covered by
// sized_conversion_safety_test.almd.
//
// Some-side values are asserted with `(checked(...) ?? sentinel).to_int64()`
// instead of `!`: an unwrap whose scrutinee is a RUNTIME value lowers to a
// value-position variant match, which is an honest unshipped v1 brick (the
// corpus walled-real ratchet rejects it) — the safety test's `!` survives only
// because its literal arguments let the whole Option fold at compile time.
// Sentinels are 0 and every expected value is non-zero, so the coalesce form
// distinguishes Some(v) from None exactly as the unwrap would.
// ── signed → unsigned (negative rejects / clamps to zero) ──
test "int8 to uint8: negative is the lossy side" {
  let neg = int.to_int8(-5)
  assert_eq(int8.to_uint8_checked(neg).is_none(), true)
  assert_eq((int8.to_uint8_checked(int.to_int8(127)) ?? int.to_uint8(0)).to_int64(), 127)
  assert_eq(int8.to_uint8_saturating(neg).to_int64(), 0)
  assert_eq(int8.to_uint64_checked(neg).is_none(), true)
  assert_eq(int8.to_uint64_saturating(neg).to_int64(), 0)
}

test "int64 to unsigned: negative rejects, positive passes" {
  let neg = int.to_int64(-1)
  assert_eq(int64.to_uint32_checked(neg).is_none(), true)
  assert_eq(int64.to_uint32_saturating(neg).to_int64(), 0)
  assert_eq((int64.to_uint64_checked(int.to_int64(42)) ?? int.to_uint64(0)).to_int64(), 42)
}

// ── signed narrowing (both overflow directions) ──
test "int16 to int8: overflow both ways" {
  assert_eq(int16.to_int8_checked(int.to_int16(300)).is_none(), true)
  assert_eq(int16.to_int8_checked(int.to_int16(-300)).is_none(), true)
  assert_eq((int16.to_int8_checked(int.to_int16(-128)) ?? int.to_int8(0)).to_int64(), -128)
  assert_eq(int16.to_int8_saturating(int.to_int16(300)).to_int64(), 127)
  assert_eq(int16.to_int8_saturating(int.to_int16(-300)).to_int64(), -128)
}

test "int32 and int64 narrowing boundaries" {
  assert_eq(int32.to_int16_checked(int.to_int32(32768)).is_none(), true)
  assert_eq(int32.to_int16_saturating(int.to_int32(32768)).to_int64(), 32767)
  assert_eq(int64.to_int32_checked(int.to_int64(2147483648)).is_none(), true)
  assert_eq(int64.to_int32_saturating(int.to_int64(-2147483649)).to_int64(), -2147483648)
  assert_eq(int64.to_int8_saturating(int.to_int64(1000)).to_int64(), 127)
}

// ── unsigned → signed (high half rejects / clamps to max) ──
test "uint8 to int8: the single lossy uint8 pair" {
  let u200 = int.to_uint8(200)
  assert_eq(uint8.to_int8_checked(u200).is_none(), true)
  assert_eq(uint8.to_int8_saturating(u200).to_int64(), 127)
  assert_eq((uint8.to_int8_checked(int.to_uint8(5)) ?? int.to_int8(0)).to_int64(), 5)
}

test "uint16 and uint32 to signed boundaries" {
  assert_eq(uint16.to_int8_checked(int.to_uint16(128)).is_none(), true)
  assert_eq(uint16.to_int16_checked(int.to_uint16(32768)).is_none(), true)
  assert_eq(uint16.to_int16_saturating(int.to_uint16(65535)).to_int64(), 32767)
  assert_eq(uint32.to_int32_checked(int.to_uint32(2147483648)).is_none(), true)
  assert_eq(uint32.to_int32_saturating(int.to_uint32(4294967295)).to_int64(), 2147483647)
  assert_eq(uint32.to_uint16_saturating(int.to_uint32(70000)).to_int64(), 65535)
}

// ── UInt64 source: the upper half (> i64::MAX) must NOT pivot signed ──
test "uint64 upper half rejects and clamps as unsigned" {
  let umax = uint64.max_value()
  assert_eq(uint64.to_uint32_checked(umax).is_none(), true)
  assert_eq(uint64.to_uint32_saturating(umax).to_int64(), 4294967295)
  assert_eq(uint64.to_int64_checked(umax).is_none(), true)
  assert_eq(int64.to_string(uint64.to_int64_saturating(umax)), "9223372036854775807")
  assert_eq(uint64.to_int8_saturating(umax).to_int64(), 127)
  assert_eq(uint64.to_uint8_saturating(umax).to_int64(), 255)
}

test "uint64 lower half converts exactly" {
  let small: UInt64 = 42
  assert_eq((uint64.to_int8_checked(small) ?? int.to_int8(0)).to_int64(), 42)
  assert_eq((uint64.to_uint16_checked(small) ?? int.to_uint16(0)).to_int64(), 42)
  assert_eq(int.from_int64(uint64.to_int64_checked(small) ?? int.to_int64(0)), 42)
}

test "uint64 to Int widening trio on the int module" {
  let umax = uint64.max_value()
  assert_eq(int.from_uint64_checked(umax).is_none(), true)
  assert_eq(int.from_uint64_saturating(umax), 9223372036854775807)
  let small: UInt64 = 42
  // `?? 0` rather than `!` — see the header note on runtime-scrutinee unwraps.
  assert_eq(int.from_uint64_checked(small) ?? 0, 42)
  assert_eq(int.from_uint64_saturating(small), 42)
}

// ── bounds on every carrier ──
test "min_value and max_value on all nine carriers" {
  assert_eq(int.max_value(), 9223372036854775807)
  assert_eq(int.min_value(), -9223372036854775807 - 1)
  assert_eq(int8.min_value().to_int64(), -128)
  assert_eq(int8.max_value().to_int64(), 127)
  assert_eq(int16.min_value().to_int64(), -32768)
  assert_eq(int16.max_value().to_int64(), 32767)
  assert_eq(int32.min_value().to_int64(), -2147483648)
  assert_eq(int32.max_value().to_int64(), 2147483647)
  assert_eq(int64.to_string(int64.min_value()), "-9223372036854775808")
  assert_eq(int64.to_string(int64.max_value()), "9223372036854775807")
  assert_eq(uint8.min_value().to_int64(), 0)
  assert_eq(uint8.max_value().to_int64(), 255)
  assert_eq(uint16.max_value().to_int64(), 65535)
  assert_eq(uint32.max_value().to_int64(), 4294967295)
  assert_eq(uint64.min_value().to_int64(), 0)
  assert_eq(uint64.to_string(uint64.max_value()), "18446744073709551615")
}
