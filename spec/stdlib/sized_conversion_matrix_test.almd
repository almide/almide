// The sized→sized half of the integer conversion matrix (#956): every LOSSY
// ordered pair carries `to_<dst>_checked` / `to_<dst>_saturating`, every
// carrier has `min_value`/`max_value`, and `UInt64 → Int` (the one lossy
// widening) is `int.from_checked/_saturating`. The SHAPE of the
// surface is machine-enforced by the numeric-matrix gate in
// `almide docs-gen --check`; this file pins the SEMANTICS: reject/accept at
// the exact boundaries, clamp direction, and the UInt64 upper half that a
// signed pivot would misread. The Int-source row is covered by
// sized_conversion_safety_test.almd.
//
// Some-side values are asserted with `(checked(...) ?? sentinel).to_int64()`
// instead of `!`: an unwrap whose scrutinee is a RUNTIME value lowers to a
// value-position variant match, which is an honest unshipped v1 brick (the
// corpus walled-real ratchet rejects it) — the safety test's `!` survives only
// because its literal arguments let the whole Option fold at compile time.
// Sentinels are 0 and every expected value is non-zero, so the coalesce form
// distinguishes Some(v) from None exactly as the unwrap would.
// ── signed → unsigned (negative rejects / clamps to zero) ──
test "int8 to uint8: negative is the lossy side" {
  let neg = int8.from(-5)
  assert_eq(uint8.from_checked(neg).is_none(), true)
  assert_eq(int.from(uint8.from_checked(int8.from(127)) ?? uint8.from(0)), 127)
  assert_eq(int.from(uint8.from_saturating(neg)), 0)
  assert_eq(uint64.from_checked(neg).is_none(), true)
  assert_eq(int.from(uint64.from_saturating(neg)), 0)
}

test "int64 to unsigned: negative rejects, positive passes" {
  let neg = int64.from(-1)
  assert_eq(uint32.from_checked(neg).is_none(), true)
  assert_eq(int.from(uint32.from_saturating(neg)), 0)
  assert_eq(int.from(uint64.from_checked(int64.from(42)) ?? uint64.from(0)), 42)
}

// ── signed narrowing (both overflow directions) ──
test "int16 to int8: overflow both ways" {
  assert_eq(int8.from_checked(int16.from(300)).is_none(), true)
  assert_eq(int8.from_checked(int16.from(-300)).is_none(), true)
  assert_eq(int.from(int8.from_checked(int16.from(-128)) ?? int8.from(0)), -128)
  assert_eq(int.from(int8.from_saturating(int16.from(300))), 127)
  assert_eq(int.from(int8.from_saturating(int16.from(-300))), -128)
}

test "int32 and int64 narrowing boundaries" {
  assert_eq(int16.from_checked(int32.from(32768)).is_none(), true)
  assert_eq(int.from(int16.from_saturating(int32.from(32768))), 32767)
  assert_eq(int32.from_checked(int64.from(2147483648)).is_none(), true)
  assert_eq(int.from(int32.from_saturating(int64.from(-2147483649))), -2147483648)
  assert_eq(int.from(int8.from_saturating(int64.from(1000))), 127)
}

// ── unsigned → signed (high half rejects / clamps to max) ──
test "uint8 to int8: the single lossy uint8 pair" {
  let u200 = uint8.from(200)
  assert_eq(int8.from_checked(u200).is_none(), true)
  assert_eq(int.from(int8.from_saturating(u200)), 127)
  assert_eq(int.from(int8.from_checked(uint8.from(5)) ?? int8.from(0)), 5)
}

test "uint16 and uint32 to signed boundaries" {
  assert_eq(int8.from_checked(uint16.from(128)).is_none(), true)
  assert_eq(int16.from_checked(uint16.from(32768)).is_none(), true)
  assert_eq(int.from(int16.from_saturating(uint16.from(65535))), 32767)
  assert_eq(int32.from_checked(uint32.from(2147483648)).is_none(), true)
  assert_eq(int.from(int32.from_saturating(uint32.from(4294967295))), 2147483647)
  assert_eq(int.from(uint16.from_saturating(uint32.from(70000))), 65535)
}

// ── UInt64 source: the upper half (> i64::MAX) must NOT pivot signed ──
test "uint64 upper half rejects and clamps as unsigned" {
  let umax = uint64.max_value()
  assert_eq(uint32.from_checked(umax).is_none(), true)
  assert_eq(int.from(uint32.from_saturating(umax)), 4294967295)
  assert_eq(int64.from_checked(umax).is_none(), true)
  assert_eq(int64.to_string(int64.from_saturating(umax)), "9223372036854775807")
  assert_eq(int.from(int8.from_saturating(umax)), 127)
  assert_eq(int.from(uint8.from_saturating(umax)), 255)
}

test "uint64 lower half converts exactly" {
  let small: UInt64 = 42
  assert_eq(int.from(int8.from_checked(small) ?? int8.from(0)), 42)
  assert_eq(int.from(uint16.from_checked(small) ?? uint16.from(0)), 42)
  assert_eq(int.from(int64.from_checked(small) ?? int64.from(0)), 42)
}

test "uint64 to Int widening trio on the int module" {
  let umax = uint64.max_value()
  assert_eq(int.from_checked(umax).is_none(), true)
  assert_eq(int.from_saturating(umax), 9223372036854775807)
  let small: UInt64 = 42
  // `?? 0` rather than `!` — see the header note on runtime-scrutinee unwraps.
  assert_eq(int.from_checked(small) ?? 0, 42)
  assert_eq(int.from_saturating(small), 42)
}

// ── bounds on every carrier ──
test "min_value and max_value on all nine carriers" {
  assert_eq(int.max_value(), 9223372036854775807)
  assert_eq(int.min_value(), -9223372036854775807 - 1)
  assert_eq(int.from(int8.min_value()), -128)
  assert_eq(int.from(int8.max_value()), 127)
  assert_eq(int.from(int16.min_value()), -32768)
  assert_eq(int.from(int16.max_value()), 32767)
  assert_eq(int.from(int32.min_value()), -2147483648)
  assert_eq(int.from(int32.max_value()), 2147483647)
  assert_eq(int64.to_string(int64.min_value()), "-9223372036854775808")
  assert_eq(int64.to_string(int64.max_value()), "9223372036854775807")
  assert_eq(int.from(uint8.min_value()), 0)
  assert_eq(int.from(uint8.max_value()), 255)
  assert_eq(int.from(uint16.max_value()), 65535)
  assert_eq(int.from(uint32.max_value()), 4294967295)
  assert_eq(int.from(uint64.min_value()), 0)
  assert_eq(uint64.to_string(uint64.max_value()), "18446744073709551615")
}
