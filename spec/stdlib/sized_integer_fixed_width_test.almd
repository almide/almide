// The FixedWidthInteger requirements on the eight fixed-width integer types: wrapping
// arithmetic and rotation in the type's own width (R-int-12 — no `bits` argument, the
// type is the width), `bit_length` (R-int-11), and `parse` (R-sized-02: the int.parse
// grammar, and an out-of-range numeral is an err, never a wrapped value).
fn i8(n: Int) -> Int8 = int8.from_wrapping(n)

fn i16(n: Int) -> Int16 = int16.from_wrapping(n)

fn i32(n: Int) -> Int32 = int32.from_wrapping(n)

fn i64(n: Int) -> Int64 = int64.from(n)

fn u8(n: Int) -> UInt8 = uint8.from_wrapping(n)

fn u16(n: Int) -> UInt16 = uint16.from_wrapping(n)

fn u32(n: Int) -> UInt32 = uint32.from_wrapping(n)

fn u64(n: Int) -> UInt64 = uint64.from_wrapping(n)

// ── wrap_add / wrap_sub / wrap_mul ──
test "wrapping arithmetic on signed types" {
  assert_eq(int8.wrap_add(int8.max_value(), i8(1)), int8.min_value())
  assert_eq(int8.wrap_sub(int8.min_value(), i8(1)), int8.max_value())
  assert_eq(int8.wrap_mul(i8(16), i8(16)), i8(0))
  assert_eq(int8.wrap_mul(int8.min_value(), i8(-1)), int8.min_value())
  assert_eq(int8.wrap_add(i8(3), i8(-5)), i8(-2))
  assert_eq(int16.wrap_add(int16.max_value(), i16(1)), int16.min_value())
  assert_eq(int16.wrap_mul(i16(256), i16(256)), i16(0))
  assert_eq(int32.wrap_add(int32.max_value(), i32(1)), int32.min_value())
  assert_eq(int32.wrap_mul(i32(65536), i32(65536)), i32(0))
  assert_eq(int64.wrap_add(int64.max_value(), i64(1)), int64.min_value())
  assert_eq(int64.wrap_sub(int64.min_value(), i64(1)), int64.max_value())
  assert_eq(int64.wrap_mul(int64.max_value(), i64(2)), i64(-2))
}

test "wrapping arithmetic on unsigned types" {
  assert_eq(uint8.wrap_add(u8(255), u8(1)), u8(0))
  assert_eq(uint8.wrap_sub(u8(0), u8(1)), u8(255))
  assert_eq(uint8.wrap_mul(u8(16), u8(16)), u8(0))
  assert_eq(uint16.wrap_sub(u16(0), u16(1)), u16(65535))
  assert_eq(uint16.wrap_add(u16(65535), u16(2)), u16(1))
  assert_eq(uint32.wrap_add(u32(4294967295), u32(2)), u32(1))
  assert_eq(uint32.wrap_mul(u32(65536), u32(65536)), u32(0))
  assert_eq(uint64.wrap_add(uint64.max_value(), u64(1)), u64(0))
  assert_eq(uint64.wrap_sub(u64(0), u64(1)), uint64.max_value())
  assert_eq(uint64.wrap_mul(uint64.max_value(), uint64.max_value()), u64(1))
}

// ── rotate_left / rotate_right ──
test "rotation moves bits around the type's width" {
  assert_eq(int8.rotate_left(int8.min_value(), 1), i8(1))
  assert_eq(int8.rotate_left(i8(1), -1), int8.min_value())
  assert_eq(int8.rotate_right(i8(1), 1), int8.min_value())
  assert_eq(int8.rotate_left(i8(-127), 4), i8(24))
  assert_eq(int8.rotate_right(i8(-127), 4), i8(24))
  assert_eq(int8.rotate_left(i8(5), 8), i8(5))
  assert_eq(int8.rotate_right(i8(5), 0), i8(5))
  assert_eq(int16.rotate_left(int16.min_value(), 1), i16(1))
  assert_eq(int16.rotate_right(i16(1), 1), int16.min_value())
  assert_eq(int16.rotate_left(i16(4660), 4), i16(9025))
  assert_eq(int32.rotate_left(i32(305419896), 8), i32(878082066))
  assert_eq(int32.rotate_right(i32(1), 1), int32.min_value())
  assert_eq(int64.rotate_left(int64.min_value(), 1), i64(1))
  assert_eq(int64.rotate_right(i64(1), 1), int64.min_value())
  assert_eq(int64.rotate_left(i64(72623859790382856), 8), i64(144964032628459521))
  assert_eq(uint8.rotate_left(u8(129), 1), u8(3))
  assert_eq(uint8.rotate_right(u8(3), 1), u8(129))
  assert_eq(uint16.rotate_right(u16(1), 1), u16(32768))
  assert_eq(uint32.rotate_left(u32(2147483648), 1), u32(1))
  assert_eq(uint32.rotate_right(u32(1), 33), u32(2147483648))
  assert_eq(uint64.rotate_left(uint64.pow(u64(2), 63), 1), u64(1))
  assert_eq(uint64.to_string(uint64.rotate_right(u64(1), 1)), "9223372036854775808")
  assert_eq(uint64.rotate_left(u64(1), 64), u64(1))
  assert_eq(uint64.to_string(uint64.rotate_left(u64(3), 63)), "9223372036854775809")
}

// ── bit_length ──
test "bit_length counts the bits up to the highest set one" {
  assert_eq(int8.bit_length(i8(0)), 0)
  assert_eq(int8.bit_length(i8(1)), 1)
  assert_eq(int8.bit_length(int8.max_value()), 7)
  assert_eq(int8.bit_length(i8(-1)), 8)
  assert_eq(int16.bit_length(i16(-1)), 16)
  assert_eq(int32.bit_length(i32(255)), 8)
  assert_eq(int64.bit_length(i64(-1)), 64)
  assert_eq(int64.bit_length(int64.max_value()), 63)
  assert_eq(uint8.bit_length(u8(255)), 8)
  assert_eq(uint16.bit_length(u16(256)), 9)
  assert_eq(uint32.bit_length(u32(4294967295)), 32)
  assert_eq(uint64.bit_length(uint64.max_value()), 64)
  assert_eq(uint64.bit_length(u64(0)), 0)
}

// ── parse ──
test "signed parse accepts exactly the type's range" {
  assert_eq(int8.parse("127"), ok(i8(127)))
  assert_eq(int8.parse("-128"), ok(i8(-128)))
  assert_eq(int8.parse(" 42 "), ok(i8(42)))
  assert_eq(int8.parse("128"), err("number too large to fit in target type"))
  assert_eq(int8.parse("-129"), err("number too small to fit in target type"))
  assert_eq(int8.parse("abc"), err("invalid digit found in string"))
  assert_eq(int16.parse("32767"), ok(i16(32767)))
  assert_eq(int16.parse("40000"), err("number too large to fit in target type"))
  assert_eq(int32.parse("-2147483648"), ok(i32(-2147483648)))
  assert_eq(int32.parse("-2147483649"), err("number too small to fit in target type"))
  assert_eq(int64.parse("9223372036854775807"), ok(int64.max_value()))
  assert_eq(int64.parse("9223372036854775808"), err("number too large to fit in target type"))
}

test "unsigned parse refuses a minus sign and values above the range" {
  assert_eq(uint8.parse("255"), ok(u8(255)))
  assert_eq(uint8.parse("+7"), ok(u8(7)))
  assert_eq(uint8.parse("256"), err("number too large to fit in target type"))
  assert_eq(uint8.parse("-1"), err("invalid digit found in string"))
  assert_eq(uint8.parse("-0"), err("invalid digit found in string"))
  assert_eq(uint16.parse("65535"), ok(u16(65535)))
  assert_eq(uint16.parse("65536"), err("number too large to fit in target type"))
  assert_eq(uint32.parse("4294967295"), ok(u32(4294967295)))
  assert_eq(uint32.parse("4294967296"), err("number too large to fit in target type"))
}

test "uint64 parse reaches 2^64-1" {
  assert_eq(uint64.parse("18446744073709551615"), ok(uint64.max_value()))
  assert_eq(uint64.parse(" +18446744073709551615 "), ok(uint64.max_value()))
  assert_eq(uint64.parse("9223372036854775808"), ok(uint64.pow(u64(2), 63)))
  assert_eq(uint64.parse("1"), ok(u64(1)))
  assert_eq(uint64.parse("18446744073709551616"), err("number too large to fit in target type"))
  assert_eq(uint64.parse("99999999999999999999"), err("number too large to fit in target type"))
  assert_eq(uint64.parse("-5"), err("invalid digit found in string"))
  assert_eq(uint64.parse("1844674407370955161x"), err("invalid digit found in string"))
}
