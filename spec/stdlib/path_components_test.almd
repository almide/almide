// path.components / relative_to (R-path-01) and path.with_extension (R-path-03).
import path

test "components are the segments of the normalized path" {
  assert_eq(path.components("/a/./b//c/"), ["/", "a", "b", "c"])
  assert_eq(path.components("a/b"), ["a", "b"])
  assert_eq(path.components("x/../y"), ["y"])
  assert_eq(path.components("../a"), ["..", "a"])
  assert_eq(path.components(""), ["."])
  assert_eq(path.components("/"), ["/"])
}

test "components of a relative path join back to its normalized form" {
  let p = "a/./b/../c//d"
  assert_eq(string.join(path.components(p), "/"), path.normalize(p))
}

test "relative_to is lexical and never climbs" {
  assert_eq(path.relative_to("/a/b/c", "/a"), some("b/c"))
  assert_eq(path.relative_to("/a/b", "/a/b/"), some("."))
  assert_eq(path.relative_to("a/b", "."), some("a/b"))
  assert_eq(path.relative_to("/a/b", "/"), some("a/b"))
  assert_eq(path.relative_to("/ab", "/a"), none)
  assert_eq(path.relative_to("a/b", "/a"), none)
  assert_eq(path.relative_to("/a", "a"), none)
  assert_eq(path.relative_to("../x", "."), none)
  assert_eq(path.relative_to("/a/../b", "/a"), none)
}

test "relative_to round-trips through join" {
  let base = "/srv/app"
  let p = "/srv/app/static/./css/site.css"
  assert_eq(path.join(base, path.relative_to(p, base) ?? ""), path.normalize(p))
}

test "with_extension replaces, adds or removes the last extension" {
  assert_eq(path.with_extension("dir/file.txt", "md"), "dir/file.md")
  assert_eq(path.with_extension("archive.tar.gz", "zip"), "archive.tar.zip")
  assert_eq(path.with_extension("README", "md"), "README.md")
  assert_eq(path.with_extension("a.tar.gz", ""), "a.tar")
  assert_eq(path.with_extension(".bashrc", "bak"), ".bashrc.bak")
  assert_eq(path.with_extension("a/b/", "c"), "a/b.c")
}

test "with_extension leaves a path without a file name alone" {
  assert_eq(path.with_extension("", "txt"), "")
  assert_eq(path.with_extension("/", "txt"), "/")
  assert_eq(path.with_extension("a/..", "txt"), "a/..")
}
