// wasm:skip — the TEST harness's wasm lane renders through the incumbent
// brick, which has no http op capability; the run/embedded lane DOES serve
// this family (#1710 increment 3) and spec/embedded_cross/http_framed_errs
// pins it. This skip retires with the render_wasm switchover (#1584).
//
// http.get_response / http.send answer the whole response for any complete
// response; Err is transport-only. The record (#1791) carries — status, every header line (repeats kept), body —
// pinned below by a loopback round-trip against a canned raw response
// served over `net`: the listener is bound on port 0 BEFORE the `fan` (a
// fixed port collides with whatever else holds it, #4313), the server arm
// accepts on it (the net handle tables are the program's, C-377) and the
// client arm dials the port the OS chose, its dial queued in the backlog
// until the server arm accepts. Probes follow the net_test.almd
// discipline: the effectful call is BOUND first and the pure local is matched,
// so branch-lift synthesizes no real fn (the walled-real ratchet stays empty).
// The closed-local-port probe exercises the transport-Err path with no
// external network; the status-code unit is declared out-of-band in
// docs/stdlib/semantics-manifest.toml.
import io
import http
import net

fn verdict(code: Int) -> String = if code == 404 then "available" else "taken"

test "status verdict is a pure branch on the code" {
  assert_eq(verdict(404), "available")
  assert_eq(verdict(200), "taken")
}

test "send to a closed local port is a transport err, headers given" {
  let result = http.send(http.new_request("GET", "http://127.0.0.1:1", "", [("User-Agent", "almide-test")]))
  match result {
    ok(_) => assert(false),
    err(_) => assert(true),
  }
}

test "get_response to a closed local port is a transport err" {
  let result = http.get_response("http://127.0.0.1:1")
  match result {
    ok(_) => assert(false),
    err(_) => assert(true),
  }
}

test "send of a built request to a closed local port is a transport err" {
  let result = http.send(http.new_request("GET", "http://127.0.0.1:1", "", []))
  match result {
    ok(_) => assert(false),
    err(_) => assert(true),
  }
}

// The server arm accepts on the test's listener and answers once.
effect fn answer_once(server: net.TcpListener, reply: String) -> Result[Unit, String] = {
  let peer = net.tcp_accept(server)!
  let _ = io.read(peer, 4096)!
  io.write(peer, bytes.from_string(reply))!
  io.close(peer)!
  io.close(server)!
  ok(())
}

test "send keeps status, every header and the body of a 3xx" {
  let reply = "HTTP/1.1 302 Found\r\nLocation: /next\r\nSet-Cookie: a=1; HttpOnly\r\nSet-Cookie: b=2; Secure\r\nX-Frame-Options: DENY\r\nContent-Length: 5\r\n\r\nmoved"
  let server = net.tcp_listen("127.0.0.1", 0)!
  let port = net.tcp_local_port(server)!
  let (_, resp) = fan {
    answer_once(server, reply)
    http.send(http.new_request("GET", "http://127.0.0.1:${port}/old", "", [("User-Agent", "almide-test")]))
  }
  assert_eq(http.status(resp), 302)
  assert_eq(http.body(resp), "moved")
  assert_eq(http.header(resp, "location") ?? "none", "/next")
  assert_eq(http.header(resp, "Set-Cookie") ?? "none", "a=1; HttpOnly")
  assert_eq(http.header_values(resp, "set-cookie"), ["a=1; HttpOnly", "b=2; Secure"])
  assert_eq(
    http.headers(resp),
    [("Location", "/next"), ("Set-Cookie", "a=1; HttpOnly"), ("Set-Cookie", "b=2; Secure"), ("X-Frame-Options", "DENY"), ("Content-Length", "5")],
  )
}

test "get_response is the GET cell of the family and a 404 is Ok" {
  let reply = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 4\r\n\r\ngone"
  let server = net.tcp_listen("127.0.0.1", 0)!
  let port = net.tcp_local_port(server)!
  let (_, resp) = fan {
    answer_once(server, reply)
    http.get_response("http://127.0.0.1:${port}/missing")
  }
  assert_eq(http.status(resp), 404)
  assert_eq(http.body(resp), "gone")
  assert_eq(http.headers(resp), [("Content-Type", "text/plain"), ("Content-Length", "4")])
}
