// http.get_status / http.request_status return (status_code, body) for any
// complete response; Err is transport-only. Probes live INSIDE test blocks so
// no top-level fn walls on the wasm leg (the walled-real ratchet) — the same
// discipline as net_test.almd. The closed-local-port probe exercises the
// transport-Err path without touching any external network; the status-code
// semantics are declared out-of-band in docs/stdlib/semantics-manifest.toml.
import http

fn verdict(code: Int) -> String = if code == 404 then "available" else "taken"

test "status verdict is a pure branch on the code" {
  assert_eq(verdict(404), "available")
  assert_eq(verdict(200), "taken")
}

test "request_status to a closed local port is a transport err" {
  let got = match http.request_status("GET", "http://127.0.0.1:1", "", ["User-Agent": "almide-test"]) {
    ok(_) => "response",
    err(_) => "transport-err",
  }
  assert_eq(got, "transport-err")
}

test "get_status to a closed local port is a transport err" {
  let got = match http.get_status("http://127.0.0.1:1") {
    ok(_) => "response",
    err(_) => "transport-err",
  }
  assert_eq(got, "transport-err")
}
