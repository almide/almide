// The `from` family (R-L0-40): every numeric type converts FROM any other with
// `<T>.from` (toward zero; a value outside T, NaN or an infinity aborts),
// `from_checked` (none unless exact), `from_saturating` (clamped; NaN is 0) and,
// for integer sources, `from_wrapping` (the low bits, two's complement).
// The cases sit on the edges: the ends of each range, UInt64 at and past 2^63,
// fractions, NaN and the infinities, and the one rounding a Float detour would
// get wrong.
import bigint
import testing

fn u64_top() -> UInt64 = uint64.max_value()

fn u64_half() -> UInt64 = uint64.from_wrapping(int.min_value())

fn big(x: BigInt) -> String = bigint.to_string(x)

test "integer to integer: plain, checked, saturating" {
  assert_eq(int.from(int8.from(-128)), -128)
  assert_eq(int.from(uint8.from(255)), 255)
  assert_eq(int.from(int32.from(int16.from(-32768))), -32768)
  assert_eq(int8.from_checked(127) == none, false)
  assert_eq(int8.from_checked(128), none)
  assert_eq(uint8.from_checked(-1), none)
  assert_eq(int.from(uint8.from_saturating(-5)), 0)
  assert_eq(int.from(uint8.from_saturating(1000)), 255)
  assert_eq(int.from(int16.from_saturating(-100000)), -32768)
  assert_eq(int.from(uint32.from_saturating(int.max_value())), 4294967295)
  assert_eq(int.from(int64.from(int.min_value())), int.min_value())
  assert_eq(int.from_checked(int64.from(42)), some(42))
}

test "integer to integer: wrapping keeps the low bits" {
  assert_eq(int.from(int8.from_wrapping(200)), -56)
  assert_eq(int.from(int8.from_wrapping(300)), 44)
  assert_eq(int.from(uint8.from_wrapping(-1)), 255)
  assert_eq(int.from(int16.from_wrapping(70000)), 4464)
  assert_eq(int.from(int32.from_wrapping(4294967301)), 5)
  assert_eq(int.from(uint32.from_wrapping(-1)), 4294967295)
  assert_eq(int.from(uint16.from_wrapping(int8.from(-1))), 65535)
  assert_eq(int.from_wrapping(uint8.from(200)), 200)
}

test "UInt64 at and past 2^63" {
  assert_eq(uint64.to_string(uint64.from_wrapping(-1)), "18446744073709551615")
  assert_eq(uint64.to_string(u64_half()), "9223372036854775808")
  assert_eq(int.from_checked(u64_top()), none)
  assert_eq(int.from_checked(u64_half()), none)
  assert_eq(int.from_saturating(u64_top()), int.max_value())
  assert_eq(int.from_wrapping(u64_top()), -1)
  assert_eq(int.from_wrapping(u64_half()), int.min_value())
  assert_eq(int.from(int8.from_saturating(u64_top())), 127)
  assert_eq(int.from(int8.from_wrapping(u64_top())), -1)
  assert_eq(int.from(uint8.from_wrapping(u64_top())), 255)
  assert_eq(int.from(uint32.from_saturating(u64_half())), 4294967295)
  assert_eq(uint64.from_checked(u64_top()) == none, false)
  assert_eq(uint64.from_checked(-1), none)
  assert_eq(uint64.to_string(uint64.from_saturating(-1)), "0")
  assert_eq(float.from(u64_top()), 18446744073709551616.0)
  assert_eq(float.from_checked(u64_top()), none)
  assert_eq(float.from_checked(u64_half()), some(9223372036854775808.0))
  assert_eq(big(bigint.from(u64_top())), "18446744073709551615")
}

test "the plain form aborts outside the target" {
  testing.assert_aborts("int8.from", () => int.from(int8.from(300)))
  testing.assert_aborts("uint8.from", () => int.from(uint8.from(-1)))
  testing.assert_aborts("int.from", () => int.from(u64_top()))
  testing.assert_aborts("uint64.from", () => uint64.to_string(uint64.from(-1)))
  testing.assert_aborts("int.from", () => int.from(float.nan()))
  testing.assert_aborts("int.from", () => int.from(9223372036854775808.0))
  testing.assert_aborts("int8.from", () => int.from(int8.from(128.0)))
  testing.assert_aborts("bigint.from", () => big(bigint.from(float.infinity())))
}

test "float to integer: toward zero, exact, clamped" {
  assert_eq(int.from(2.9), 2)
  assert_eq(int.from(-2.9), -2)
  assert_eq(int.from(int8.from(127.9)), 127)
  assert_eq(int.from(uint8.from(-0.5)), 0)
  assert_eq(int.from_checked(2.5), none)
  assert_eq(int.from_checked(-3.0), some(-3))
  assert_eq(int.from_checked(-9223372036854775808.0), some(int.min_value()))
  assert_eq(int.from_checked(float.nan()), none)
  assert_eq(int.from_checked(float.infinity()), none)
  assert_eq(int.from_saturating(float.nan()), 0)
  assert_eq(int.from_saturating(1e30), int.max_value())
  assert_eq(int.from_saturating(-1e30), int.min_value())
  assert_eq(int.from(int8.from_saturating(-1000.5)), -128)
  assert_eq(uint64.to_string(uint64.from(18446744073709549568.0)), "18446744073709549568")
  assert_eq(uint64.from_checked(18446744073709551616.0), none)
  assert_eq(uint64.to_string(uint64.from_saturating(1e30)), "18446744073709551615")
  assert_eq(int.from(float32.from(2.5)), 2)
  assert_eq(int.from_checked(float32.from(16777216)), some(16777216))
  assert_eq(int.from_checked(float64.from(-7)), some(-7))
}

test "to a float: nearest, and checked only when exact" {
  assert_eq(float.from(3), 3.0)
  assert_eq(float.from(int8.from(-5)), -5.0)
  assert_eq(float.from_checked(9007199254740992), some(9007199254740992.0))
  assert_eq(float.from_checked(9007199254740993), none)
  assert_eq(float.from_checked(int.max_value()), none)
  assert_eq(float.from_checked(float.nan()), none)
  assert_eq(float.is_nan(float.from(float.nan())), true)
  assert_eq(float.from(float32.from(16777217)), 16777216.0)
  assert_eq(float32.from_checked(16777217), none)
  assert_eq(float32.from_checked(0.1), none)
  assert_eq(float32.from_checked(0.5) == none, false)
  assert_eq(float32.is_infinite(float32.from(1e300)), true)
  assert_eq(float.from(float64.from(int16.from(-300))), -300.0)
  assert_eq(float64.from_checked(float32.from(0.1)) == none, false)
}

test "an integer rounds to Float32 once, not through Float" {
  // 2^54 + 2^30 + 1: Float would round it to 2^54 + 2^30, a Float32 tie that
  // goes down to 2^54; rounded once it goes up to 2^54 + 2^31.
  assert_eq(float.from(float32.from(18014399583223809)), 18014400656965632.0)
}

test "bigint from any number" {
  assert_eq(big(bigint.from(int.min_value())), "-9223372036854775808")
  assert_eq(big(bigint.from(int8.from(-7))), "-7")
  assert_eq(big(bigint.from(2.5)), "2")
  assert_eq(bigint.from_checked(2.5), none)
  assert_eq(big(bigint.from(1e20)), "100000000000000000000")
  assert_eq(big(bigint.from(-1180591620717411303424.0)), "-1180591620717411303424")
  assert_eq(bigint.from_checked(float.nan()), none)
}

test "pipe form" {
  assert_eq(7 |> float.from, 7.0)
  assert_eq(2.75 |> int.from_saturating, 2)
}
