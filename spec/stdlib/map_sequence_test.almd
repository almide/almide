// The map additions of the stdlib redesign (wave 1): the sequence algorithms
// over the entries (R-L0-42). A map is a sequence of (key, value) pairs in
// insertion order, so every fn here gives what the same-named list fn gives on
// `map.entries(m)`, and each callback takes one entry pair (R-map-09). Each fn
// runs on Int and String values and meets the empty map.
local fn by_value(a: (String, Int), b: (String, Int)) -> Int = if a.1 < b.1 then -1
else if a.1 > b.1 then 1 else 0

local fn by_text_len(a: (Int, String), b: (Int, String)) -> Int = string.len(a.1) - string.len(b.1)

test "enumerate, zip and zip_with walk insertion order" {
  let m = map.from_list([("b", 2), ("a", 1)])
  assert_eq(map.enumerate(m), [(0, ("b", 2)), (1, ("a", 1))])
  assert_eq(map.zip(m, [10, 20, 30]), [(("b", 2), 10), (("a", 1), 20)])
  assert_eq(map.zip_with(m, [10, 20], ((k, v), y) => k + int.to_string(v + y)), ["b12", "a21"])
  let t = map.from_list([(1, "x"), (2, "yy")])
  assert_eq(map.enumerate(t), [(0, (1, "x")), (1, (2, "yy"))])
  assert_eq(map.zip(t, ["p"]), [((1, "x"), "p")])
  let e: Map[String, Int] = map.new()
  assert_eq(map.enumerate(e), [])
  assert_eq(map.zip(e, [1]), [])
  assert_eq(map.zip_with(e, [1], ((k, _), y) => k + int.to_string(y)), [])
}

test "filter_map, find_map, reduce and scan" {
  let m = map.from_list([("a", 1), ("b", 2), ("c", 3)])
  assert_eq(map.filter_map(m, ((k, v)) => if v % 2 == 1 then some(k) else none), ["a", "c"])
  assert_eq(map.find_map(m, ((k, v)) => if v > 1 then some(k) else none), some("b"))
  assert_eq(map.reduce(m, ((ka, va), (kb, vb)) => (ka + kb, va + vb)), some(("abc", 6)))
  assert_eq(map.scan(m, 0, (acc, (_, v)) => acc + v), [1, 3, 6])
  let t = map.from_list([(1, "x"), (2, "yy")])
  assert_eq(map.filter_map(t, ((k, v)) => if string.len(v) == 2 then some(k) else none), [2])
  assert_eq(map.find_map(t, ((_, v)) => if v == "x" then some(v + "!") else none), some("x!"))
  assert_eq(map.scan(t, "", (acc, (_, v)) => acc + v), ["x", "xyy"])
  let e: Map[String, Int] = map.new()
  assert_eq(map.filter_map(e, ((k, _)) => some(k)), [])
  assert_eq(map.find_map(e, ((k, _)) => some(k)), none)
  assert_eq(map.reduce(e, (a, _) => a), none)
  assert_eq(map.scan(e, 0, (acc, (_, v)) => acc + v), [])
}

test "partition and group_by" {
  let m = map.from_list([("a", 1), ("b", 2), ("c", 3)])
  let (big, small) = map.partition(m, ((_, v)) => v > 1)
  assert_eq(big, [("b", 2), ("c", 3)])
  assert_eq(small, [("a", 1)])
  let g = map.group_by(m, ((_, v)) => v % 2)
  let odd = map.get(g, 1) ?? []
  let even = map.get(g, 0) ?? []
  assert_eq(odd, [("a", 1), ("c", 3)])
  assert_eq(even, [("b", 2)])
  let t = map.from_list([(1, "x"), (2, "yy")])
  let (hi, lo) = map.partition(t, ((k, _)) => k > 1)
  assert_eq(hi, [(2, "yy")])
  assert_eq(lo, [(1, "x")])
  assert_eq(map.keys(map.group_by(t, ((_, v)) => string.len(v))), [1, 2])
  let e: Map[String, Int] = map.new()
  let (ey, en) = map.partition(e, ((_, v)) => v > 0)
  assert_eq(ey, [])
  assert_eq(en, [])
  assert_eq(map.len(map.group_by(e, ((k, _)) => k)), 0)
}

test "sort_by and sort_with order the entries, stable" {
  let m = map.from_list([("c", 1), ("a", 3), ("b", 1)])
  assert_eq(map.sort_by(m, ((k, _)) => k), [("a", 3), ("b", 1), ("c", 1)])
  assert_eq(map.sort_by(m, ((_, v)) => v), [("c", 1), ("b", 1), ("a", 3)])
  assert_eq(map.sort_with(m, by_value), [("c", 1), ("b", 1), ("a", 3)])
  let t = map.from_list([(1, "ccc"), (2, "a"), (3, "bb")])
  assert_eq(map.sort_with(t, by_text_len), [(2, "a"), (3, "bb"), (1, "ccc")])
  let e: Map[String, Int] = map.new()
  assert_eq(map.sort_by(e, ((k, _)) => k), [])
  assert_eq(map.sort_with(e, by_value), [])
}

test "min_by, max_by, min_with and max_with take the first entry on a tie" {
  let m = map.from_list([("a", 2), ("b", 1), ("c", 2), ("d", 1)])
  assert_eq(map.min_by(m, ((_, v)) => v), some(("b", 1)))
  assert_eq(map.max_by(m, ((_, v)) => v), some(("a", 2)))
  assert_eq(map.min_with(m, by_value), some(("b", 1)))
  assert_eq(map.max_with(m, by_value), some(("a", 2)))
  let t = map.from_list([(1, "ccc"), (2, "a"), (3, "bbb")])
  assert_eq(map.min_by(t, ((_, v)) => string.len(v)), some((2, "a")))
  assert_eq(map.max_by(t, ((_, v)) => string.len(v)), some((1, "ccc")))
  assert_eq(map.min_with(t, by_text_len), some((2, "a")))
  assert_eq(map.max_with(t, by_text_len), some((1, "ccc")))
  let e: Map[String, Int] = map.new()
  assert_eq(map.min_by(e, ((_, v)) => v), none)
  assert_eq(map.max_by(e, ((_, v)) => v), none)
  assert_eq(map.min_with(e, by_value), none)
  assert_eq(map.max_with(e, by_value), none)
}
