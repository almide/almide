// @contract: C-392
// fs.open_root / fs.root_* (#4022): paths stay inside the root.
import fs

effect fn scratch(tag: String) -> Result[String, String] = {
  let d = fs.create_temp_dir(tag)!
  fs.mkdir_p(d + "/root/sub")!
  fs.write(d + "/root/sub/a.txt", "inside")!
  fs.write(d + "/out.txt", "outside")!
  ok(d)
}

test "a nested path inside the root is read" {
  let d = scratch("froot_a")!
  let root = fs.open_root(d + "/root/")!
  assert_eq(fs.root_read_text(root, "sub/a.txt"), ok("inside"))
  assert_eq(fs.root_read_text(root, "sub/./../sub/a.txt"), ok("inside"))
  fs.remove_all(d)!
}

test "a dotdot past the root and an absolute path are refused" {
  let d = scratch("froot_b")!
  let root = fs.open_root(d + "/root")!
  assert_eq(fs.root_read_text(root, "../out.txt"), err("fs: path escapes root: ../out.txt"))
  assert_eq(
    fs.root_read_text(root, "sub/../../out.txt"),
    err("fs: path escapes root: sub/../../out.txt"),
  )
  assert_eq(
    fs.root_read_text(root, d + "/out.txt"),
    err("fs: path escapes root: " + d + "/out.txt"),
  )
  assert_eq(fs.root_write_text(root, "../made.txt", "x"), err("fs: path escapes root: ../made.txt"))
  assert_eq(fs.exists(d + "/made.txt"), false)
  fs.remove_all(d)!
}

test "write, list, exists and remove act inside the root" {
  let d = scratch("froot_c")!
  let root = fs.open_root(d + "/root")!
  fs.root_write_text(root, "sub/b.txt", "new")!
  assert_eq(fs.root_list_dir(root, "sub"), ok(["a.txt", "b.txt"]))
  assert_eq(fs.root_exists(root, "sub/b.txt"), ok(true))
  assert_eq(fs.root_read_bytes(root, "sub/b.txt") |> result.map((b) => bytes.len(b)), ok(3))
  assert_eq(fs.root_read_bytes(root, "../out.txt") |> result.is_err, true)
  fs.root_remove(root, "sub/b.txt")!
  assert_eq(fs.root_exists(root, "sub/b.txt"), ok(false))
  assert_eq(fs.root_read_text(fs.open_root(d + "/root")!, ""), fs.read_text(d + "/root"))
  fs.remove_all(d)!
}

test "open_root of a missing directory errs" {
  assert_eq(fs.open_root("no_such_root_4022") |> result.is_err, true)
}
