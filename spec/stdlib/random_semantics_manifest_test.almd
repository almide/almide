import random

// GENERATED by scripts/check-semantics-manifest.sh from
// docs/stdlib/semantics-manifest.toml — DO NOT EDIT (the gate
// regenerates and diffs). Each case executes a manifest probe; a
// failure here means the implementation drifted from the DECLARED
// semantic dimension (#419 class).
test "random.int unit=value" {
  let r = random.int(1, 6)
  let collapsed = random.int(9, 3)
  assert_eq("${r >= 1 and r <= 6 and collapsed == 9}", "true")
}

test "random.seeded unit=value" {
  assert_eq("${random.next_int(random.seeded(0), 1, 6).0}", "4")
}

test "random.next_int unit=value" {
  let r = random.next_int(random.seeded(7), 1, 6).0
  let collapsed = random.next_int(random.seeded(7), 9, 3).0
  assert_eq("${r >= 1 and r <= 6 and collapsed == 9}", "true")
}

test "random.bytes unit=byte-count" {
  let b = random.bytes(13)
  let e = random.bytes(0)
  assert_eq("${bytes.len(b) == 13 and bytes.len(e) == 0}", "true")
}
