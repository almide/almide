// bytes.map — closure-taking transform. Works on Rust + WASM.
test "map_each adds 1 to every byte" {
  let b = bytes.from_string("abc")
  let r = bytes.map(b, (x) => x + 1)
  assert_eq(bytes.get(r, 0) ?? 0, 0x62)
  // 'b'
  assert_eq(bytes.get(r, 1) ?? 0, 0x63)
  // 'c'
  // 'd'
  assert_eq(bytes.get(r, 2) ?? 0, 0x64)
}

test "map_each xor with constant" {
  var b = bytes.new()
  bytes.append_u8(b, 0xFF)
  bytes.append_u8(b, 0x0F)
  let r = bytes.map(b, (x) => int.bxor(x, 0xFF))
  assert_eq(bytes.get(r, 0) ?? 0, 0x00)
  assert_eq(bytes.get(r, 1) ?? 0, 0xF0)
}
