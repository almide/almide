// #3163: every callback-taking fn of list / map / set / option takes a
// fallible callback (ADR-0006: the callback is `!` ⇒ the HOF is `!`), not only
// the seven list cells that did before. The full matrix with visit traces is
// spec/wasm_cross/fallible_hof_matrix_{list,containers}.almd; this file pins
// the values through the `?? fallback` consumer.
//
// L9: inside a TEST block a lambda's `!` is plain unwrap, so the fallible
// forms are built in top-level helpers and the tests assert their values.
fn pos(x: Int) -> Bool! = if x < 0 then err("neg") else ok(x > 1)

fn key(x: Int) -> Int! = if x < 0 then err("neg") else ok(x % 3)

fn ok_all() -> Bool = list.all([2, 3], (x) => pos(x)!) ?? false

fn err_all() -> String = match list.all([2, -1, 0], (x) => pos(x)!) {
  ok(_) => "unexpected",
  err(e) => e,
}

fn any_hit() -> Bool = list.any([0, 1, 5], (x) => pos(x)!) ?? false

fn count_hits() -> Int = list.count([0, 2, 5], (x) => pos(x)!) ?? -1

fn sorted() -> List[Int] = list.sort_by([5, 3, 4], (x) => key(x)!) ?? []

fn uniq() -> List[Int] = list.unique_by([5, 2, 4, 1], (x) => key(x)!) ?? []

fn taken() -> List[Int] = list.take_while([3, 2, 1, 4], (x) => pos(x)!) ?? []

fn dropped() -> List[Int] = list.drop_while([3, 2, 1, -4], (x) => pos(x)!) ?? []

fn map_fold() -> Int = map.fold(
  map.from_list([("a", 1), ("b", 2)]),
  0,
  (acc, k, v) => acc + key(v)!,
) ?? -1

fn map_any() -> Bool = map.any(map.from_list([("a", 1), ("b", 2)]), (k, v) => pos(v)!) ?? false

fn set_all() -> Bool = set.all(set.from_list([2, 3]), (x) => pos(x)!) ?? false

fn option_mapped() -> Int = (option.map(some(4), (x) => key(x)!) ?? none) ?? -1

test "list.all takes a fallible predicate (#3163)" {
  assert_eq(ok_all(), true)
  assert_eq(err_all(), "neg")
}

test "the other predicate and key-extracting cells" {
  assert_eq(any_hit(), true)
  assert_eq(count_hits(), 2)
  assert_eq(sorted(), [3, 4, 5])
  assert_eq(uniq(), [5, 4])
  assert_eq(taken(), [3, 2])
  assert_eq(dropped(), [1, -4])
}

test "map / set / option cells" {
  assert_eq(map_fold(), 3)
  assert_eq(map_any(), true)
  assert_eq(set_all(), true)
  assert_eq(option_mapped(), 1)
}
