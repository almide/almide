// The bytes additions: readers (R-bytes-03/15/25), slices, the Text
// requirements (R-bytes-27) and the sequence algorithms (R-bytes-18/20,
// R-L0-42). An element is one byte as an Int in 0..255.
import testing

fn b(xs: List[Int]) -> Bytes = bytes.from_list(xs)

fn l(x: Bytes) -> List[Int] = bytes.to_list(x)

test "get_i8, next_i8" {
  assert_eq(bytes.get_i8(b([127, 128, 255]), 1), some(-128))
  assert_eq(bytes.get_i8(b([255]), 0), some(-1))
  assert_eq(bytes.next_i8(b([1, 254]), 1), (some(-2), 2))
  assert_eq(bytes.next_i8(b([1]), 1), (none, 1))
}

test "big-endian half floats" {
  assert_eq(bytes.get_f16_be(b([60, 0]), 0), some(1.0))
  assert_eq(bytes.get_f16_be(b([192, 0, 1]), 0), some(-2.0))
  assert_eq(bytes.get_f16_be(b([60]), 0), none)
  assert_eq(bytes.get_f16_be(b([60, 0]), -1), none)
  assert_eq(bytes.next_f16_be(b([0, 60, 0]), 1), (some(1.0), 3))
  assert_eq(bytes.next_f16_be(b([60]), 0), (none, 0))
  assert_eq(bytes.get_f16_be_array(b([60, 0, 64, 0]), 0, 2), some([1.0, 2.0]))
  assert_eq(bytes.get_f16_be_array(b([60, 0, 64]), 0, 2), none)
  assert_eq(bytes.get_f16_be_array(b([60, 0]), 0, 0), some([]))
  assert_eq(bytes.get_f16_be_array(b([60, 0]), 0, -1), none)
}

test "take, drop, take_end, drop_end, split_at clamp and abort" {
  let x = b([1, 2, 3])
  assert_eq(l(bytes.take(x, 2)), [1, 2])
  assert_eq(l(bytes.take(x, 9)), [1, 2, 3])
  assert_eq(l(bytes.drop(x, 2)), [3])
  assert_eq(l(bytes.drop(x, 9)), [])
  assert_eq(l(bytes.take_end(x, 2)), [2, 3])
  assert_eq(l(bytes.take_end(x, 9)), [1, 2, 3])
  assert_eq(l(bytes.drop_end(x, 1)), [1, 2])
  assert_eq(l(bytes.drop_end(x, 9)), [])
  let (p, q) = bytes.split_at(x, 1)
  assert_eq((l(p), l(q)), ([1], [2, 3]))
  testing.assert_aborts("bytes.take", () => bytes.take(bytes.from_list([1, 2, 3]), -1))
  testing.assert_aborts("bytes.drop", () => bytes.drop(bytes.from_list([1, 2, 3]), -1))
  testing.assert_aborts("bytes.take_end", () => bytes.take_end(bytes.from_list([1, 2, 3]), -1))
  testing.assert_aborts("bytes.drop_end", () => bytes.drop_end(bytes.from_list([1, 2, 3]), -1))
  testing.assert_aborts("bytes.split_at", () => bytes.split_at(bytes.from_list([1, 2, 3]), -1))
}

test "first, last, filter, fold, any, all, count, find, find_index" {
  let x = b([3, 8, 5, 8])
  assert_eq(bytes.first(x), some(3))
  assert_eq(bytes.last(x), some(8))
  assert_eq(bytes.first(b([])), none)
  assert_eq(l(bytes.filter(x, (v) => v > 4)), [8, 5, 8])
  assert_eq(bytes.fold(x, 0, (acc, v) => acc + v), 24)
  assert_eq(bytes.any(x, (v) => v == 5), true)
  assert_eq(bytes.all(x, (v) => v > 2), true)
  assert_eq(bytes.all(b([]), (v) => v > 2), true)
  assert_eq(bytes.count(x, (v) => v == 8), 2)
  assert_eq(bytes.find(x, (v) => v > 4), some(8))
  assert_eq(bytes.find_index(x, (v) => v == 5), some(2))
  assert_eq(bytes.find_index(x, (v) => v == 9), none)
}

test "enumerate, zip, zip_with, filter_map, find_map, reduce, scan" {
  let x = b([1, 2, 3])
  assert_eq(bytes.enumerate(b([9, 8])), [(0, 9), (1, 8)])
  assert_eq(bytes.zip(x, ["a", "b"]), [(1, "a"), (2, "b")])
  assert_eq(bytes.zip_with(x, [10, 20, 30], (p, q) => p + q), [11, 22, 33])
  assert_eq(bytes.filter_map(x, (v) => if v % 2 == 1 then some(v * 10) else none), [10, 30])
  let found = bytes.find_map(x, (v) => if v > 1 then some(v * 10) else none)
  assert_eq(found, some(20))
  assert_eq(bytes.reduce(x, (p, q) => p * 10 + q), some(123))
  assert_eq(bytes.reduce(b([]), (p, q) => p + q), none)
  assert_eq(bytes.scan(x, 0, (acc, v) => acc + v), [1, 3, 6])
}

test "partition, group_by, sort, sort_by, sort_with" {
  let x = b([5, 2, 8, 1])
  assert_eq(bytes.partition(x, (v) => v > 3), ([5, 8], [2, 1]))
  assert_eq(map.get(bytes.group_by(x, (v) => v % 2), 0), some([2, 8]))
  assert_eq(bytes.sort(x), [1, 2, 5, 8])
  assert_eq(bytes.sort_by(x, (v) => 0 - v), [8, 5, 2, 1])
  assert_eq(bytes.sort_with(x, (p, q) => q - p), [8, 5, 2, 1])
}

test "min, max and their _by and _with forms, sum, product" {
  let x = b([5, 2, 8, 2])
  assert_eq(bytes.min(x), some(2))
  assert_eq(bytes.max(x), some(8))
  assert_eq(bytes.min(b([])), none)
  assert_eq(bytes.min_by(x, (v) => 0 - v), some(8))
  assert_eq(bytes.max_by(x, (v) => 0 - v), some(2))
  assert_eq(bytes.min_with(x, (p, q) => p - q), some(2))
  assert_eq(bytes.max_with(x, (p, q) => p - q), some(8))
  assert_eq(bytes.max_with(b([]), (p, q) => p - q), none)
  assert_eq(bytes.sum(x), 17)
  assert_eq(bytes.sum(b([])), 0)
  assert_eq(bytes.product(x), 160)
  assert_eq(bytes.product(b([])), 1)
}

test "take_while, drop_while, window, dedup, intersperse, unique, unique_by" {
  let x = b([
    1,
    1,
    2,
    3,
    3,
    1
  ])
  assert_eq(l(bytes.take_while(x, (v) => v < 2)), [1, 1])
  assert_eq(l(bytes.drop_while(x, (v) => v < 2)), [2, 3, 3, 1])
  assert_eq(bytes.window(b([1, 2, 3]), 2) |> list.map((w) => l(w)), [
    [1, 2],
    [2, 3]
  ])
  assert_eq(list.len(bytes.window(b([1]), 2)), 0)
  testing.assert_aborts("bytes.window", () => bytes.window(bytes.from_list([1, 2, 3]), 0))
  assert_eq(l(bytes.dedup(x)), [1, 2, 3, 1])
  assert_eq(l(bytes.intersperse(b([1, 2, 3]), 0)), [1, 0, 2, 0, 3])
  assert_eq(l(bytes.unique(x)), [1, 2, 3])
  assert_eq(l(bytes.unique_by(x, (v) => v % 2)), [1, 2])
}

test "last_index_of, count_matches, replace, replace_first" {
  let x = b([1, 2, 1, 2, 3])
  assert_eq(bytes.last_index_of(x, b([1, 2])), some(2))
  assert_eq(bytes.last_index_of(x, b([4])), none)
  assert_eq(bytes.last_index_of(x, b([])), some(5))
  assert_eq(bytes.count_matches(x, b([1, 2])), 2)
  assert_eq(bytes.count_matches(b([1, 1, 1]), b([1, 1])), 1)
  assert_eq(bytes.count_matches(b([1, 2]), b([])), 3)
  assert_eq(l(bytes.replace(x, b([1, 2]), b([9]))), [9, 9, 3])
  assert_eq(l(bytes.replace(x, b([7]), b([9]))), [1, 2, 1, 2, 3])
  assert_eq(l(bytes.replace(b([1, 2]), b([]), b([0]))), [0, 1, 0, 2, 0])
  assert_eq(l(bytes.replace_first(x, b([1, 2]), b([]))), [1, 2, 3])
  assert_eq(l(bytes.replace_first(b([1, 2]), b([]), b([0]))), [0, 1, 2])
}

test "strip_prefix and strip_suffix" {
  let x = b([1, 2, 3])
  assert_eq(bytes.strip_prefix(x, b([1, 2])) |> option.map((r) => l(r)), some([3]))
  assert_eq(bytes.strip_prefix(x, b([2])) |> option.map((r) => l(r)), none)
  assert_eq(bytes.strip_suffix(x, b([3])) |> option.map((r) => l(r)), some([1, 2]))
  assert_eq(bytes.strip_suffix(x, b([])) |> option.map((r) => l(r)), some([1, 2, 3]))
}
