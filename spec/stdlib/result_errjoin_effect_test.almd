// The List[String]-err JOIN on `!`: unwrapping a Result[_, List[String]]
// inside a String-err effect fn joins the errors with ", " (v0's
// `.map_err(|errs| errs.join(", "))?`). The removed result.collect was the
// original producer of the shape (ADR-0007); a user gather fn pins the SAME
// conversion — the rule outlives the retired name.
fn gather_ints(rs: List[Result[Int, String]]) -> Result[List[Int], List[String]] = {
  let (oks, errs) = result.partition(rs)
  if list.is_empty(errs) then ok(oks) else err(errs)
}

effect fn parse_int_strict(s: String) -> Result[Int, String] = {
  let n = int.parse(s)!
  ok(n)
}

effect fn parse_all(strs: List[String]) -> Result[List[Int], String] = {
  let vals = strs |> list.map(parse_int_strict) |> gather_ints!
  ok(vals)
}

test "errjoin! success in effect fn" {
  assert_eq(parse_all(["1", "2", "3"]), ok([1, 2, 3]))
}

test "errjoin! failure in effect fn joins every error" {
  match parse_all(["1", "abc", "3"]) {
    err(e) => assert(string.len(e) > 0),
    ok(_) => assert(false, "should fail"),
  }
}

// The polymorphic first-err replacement for the removed collect_map (E=String
// directly — no join involved).
effect fn parse_all_firsterr(strs: List[String]) -> Result[List[Int], String] = {
  let vals = list.map(strs, (s) => parse_int_strict(s)!)!
  ok(vals)
}

test "first-err traversal replaces collect_map" {
  assert_eq(parse_all_firsterr(["10", "20", "30"]), ok([10, 20, 30]))
  match parse_all_firsterr(["10", "abc", "30"]) {
    err(e) => assert(string.len(e) > 0),
    ok(_) => assert(false, "should fail"),
  }
}
