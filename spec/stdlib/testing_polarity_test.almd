// wasm:skip — the wrong-polarity probes ride assert_throws, and WASM cannot
// catch panics (unreachable trap; same skip as coverage_assert_throws_test).
// The assertion family covers BOTH polarities of each 2-way sum type
// (#1110): assert_some/assert_none over Option, assert_ok/assert_err over
// Result. Positive-path instantiations stay on the wasm self-host twins'
// typed sigs (Option[String] / Result[String, String] — the len-as-tag /
// cap-as-tag readers); other instantiations ride the failure-path probes,
// which are native by construction (assert_throws).
import testing

test "option polarities" {
  testing.assert_some(some("v"))
  testing.assert_none(none: Option[String])
}

test "result polarities" {
  let good: Result[String, String] = ok("1")
  let bad: Result[String, String] = err("x")
  testing.assert_ok(good)
  testing.assert_err(bad)
}

test "wrong polarity fails" {
  testing.assert_throws(() => testing.assert_none(some(1)), "assert_none failed")
  testing.assert_throws(() => testing.assert_err(ok(0): Result[Int, String]), "assert_err failed")
}
