// @contract: C-275
// ADR-0032, security row 11e: a response's Content-Type is its body's type.
// Each Body states its own media type; `set_header` and `with_headers` refuse
// the Content-Type name, `set_body` / `with_body` replace the body and its
// type together, `http.typed` builds any other media type that runs no
// script and the stdlib does not own, and the application's own body type
// serves its literal. Header names here are computed (`name`) where a literal would
// be E116 at check time, so the run-time refusal is what runs. Every
// assertion holds on native and on wasm alike.
import html
import http
import testing

// A header name the checker cannot read as a literal.
fn name(s: String) -> String = s

// An application's own body type (ADR-0032 D7): it serves the literal its
// media fn states. text/csv runs no script, so it needs no grant.
type Csv: Body = { rows: String }

fn Csv.__self_media_type(self) -> String = "text/csv"

fn Csv.__self_to_text(self) -> String = self.rows

test "each body type gives the response its Content-Type" {
  assert_eq(
    http.header(http.response(200, "hi"), "Content-Type"),
    some("text/plain; charset=utf-8"),
  )
  assert_eq(
    http.header(http.response(200, bytes.from_string("hi")), "Content-Type"),
    some("application/octet-stream"),
  )
  assert_eq(http.header(http.response(200, value.int(1)), "Content-Type"), some("application/json"))
  assert_eq(
    http.header(http.response(200, html.escape("x")), "Content-Type"),
    some("text/html; charset=utf-8"),
  )
  assert_eq(
    http.header(
      http.response(200, http.typed("text/csv", bytes.from_string("a,b"))),
      "Content-Type",
    ),
    some("text/csv"),
  )
  assert_eq(http.header(http.redirect("/next"), "Content-Type"), some("text/plain; charset=utf-8"))
  assert_eq(http.header(http.json(200, "{}"), "Content-Type"), some("application/json"))
}

test "each body type gives the response its bytes" {
  assert_eq(
    http.body(http.response(200, html.escape("<script>alert(1)</script>"))),
    "&lt;script&gt;alert(1)&lt;/script&gt;",
  )
  assert_eq(http.body(http.response(200, value.object([("a", value.int(1))]))), "{\"a\":1}")
  assert_eq(http.body(http.response(200, http.typed("text/csv", bytes.from_string("a,b")))), "a,b")
}

test "set_header and with_headers refuse Content-Type in any spelling" {
  testing.assert_aborts(
    "http.set_header: `Content-Type` is written from the body's type, never by name",
    () => http.set_header(
      http.response(200, "<script>alert(1)</script>"),
      name("Content-Type"),
      "text/html",
    ),
  )
  testing.assert_aborts(
    "http.set_header: `content-TYPE` is written from the body's type, never by name",
    () => http.set_header(http.response(200, "x"), name("content-TYPE"), "text/plain"),
  )
  testing.assert_aborts(
    "http.with_headers: `content-type` is written from the body's type, never by name",
    () => http.with_headers(200, "x", [("X-A", "1"), (name("content-type"), "image/svg+xml")]),
  )
}

test "set_body and with_body replace the body and its type together" {
  let page = http.response(200, html.escape("hi"))
  let text = http.set_body(page, "<script>alert(1)</script>")
  assert_eq(http.header(text, "Content-Type"), some("text/plain; charset=utf-8"))
  assert_eq(http.body(text), "<script>alert(1)</script>")
  let raw = http.set_body_bytes(page, bytes.from_string("<b>"))
  assert_eq(http.header(raw, "Content-Type"), some("application/octet-stream"))
  let back = http.with_body(text, html.escape("<b>"))
  assert_eq(http.header(back, "Content-Type"), some("text/html; charset=utf-8"))
  assert_eq(http.body(back), "&lt;b&gt;")
}

test "other headers, the status and the header order stay as written" {
  let resp = http.with_headers(201, html.escape("hi"), [("X-Frame-Options", "DENY"), ("X-A", "1")]) |> http.set_header(
    "x-a",
    "2",
  )
  assert_eq(http.status(resp), 201)
  assert_eq(
    http.headers(resp),
    [("Content-Type", "text/html; charset=utf-8"), ("X-Frame-Options", "DENY"), ("X-A", "2")],
  )
}

test "a request is not a response body, so it may carry any Content-Type" {
  let req = http.set_header(
    http.new_request("POST", "/pages", "<p>draft</p>", []),
    name("Content-Type"),
    "text/html",
  )
  assert_eq(http.header(req, "Content-Type"), some("text/html"))
  assert_eq(http.body(http.set_body(req, "<p>v2</p>")), "<p>v2</p>")
  assert_eq(http.header(http.set_body(req, "<p>v2</p>"), "Content-Type"), some("text/html"))
}

test "an application's own body type serves its literal media type" {
  let r = http.response(200, Csv { rows: "a,b" })
  assert_eq(http.header(r, "Content-Type"), some("text/csv"))
  assert_eq(http.body(r), "a,b")
  assert_eq(http.header(http.with_body(r, "x"), "Content-Type"), some("text/plain; charset=utf-8"))
}
