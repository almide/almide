// The sized-integer bit and wrapping matrix: every fixed-width type (Int8 ..
// Int64, UInt8 .. UInt64) x every cell of its bit / wrapping / bounds family —
// band, bor, bxor, bnot, is_even, is_odd, wrap_add, wrap_sub, wrap_mul,
// rotate_left, rotate_right, min_value, max_value, from_wrapping. Matrix, not
// point-wise (CLAUDE.md: API families are extended by matrix): each type runs
// the SAME cells over the SAME Int inputs, each wrapped into the type's width,
// and the expected answers are the two's-complement values in that width. An
// omitted cell would be an omitted test block, which the stdlib test-coverage
// ledger (proofs/stdlib-test-coverage.txt) refuses.
test "int8: the bit / wrapping / bounds matrix" {
  let a = int8.from_wrapping(-100)
  let b = int8.from_wrapping(12)
  let one = int8.from_wrapping(1)
  // bounds
  assert_eq(int8.to_string(int8.min_value()), "-128")
  assert_eq(int8.to_string(int8.max_value()), "127")
  // from_wrapping: reduced mod 2^8
  assert_eq(int8.to_string(a), "-100")
  assert_eq(int8.to_string(int8.from_wrapping(-1)), "-1")
  assert_eq(int8.to_string(int8.from_wrapping(261)), "5")
  assert_eq(int8.to_string(int8.from_wrapping(128)), "-128")
  // band / bor / bxor / bnot
  assert_eq(int8.to_string(int8.band(a, b)), "12")
  assert_eq(int8.to_string(int8.bor(a, b)), "-100")
  assert_eq(int8.to_string(int8.bxor(a, b)), "-112")
  assert_eq(int8.to_string(int8.bnot(a)), "99")
  assert_eq(int8.to_string(int8.bnot(int8.min_value())), "127")
  assert_eq(int8.to_string(int8.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(int8.is_even(a), true)
  assert_eq(int8.is_odd(a), false)
  assert_eq(int8.is_even(int8.max_value()), false)
  assert_eq(int8.is_odd(int8.max_value()), true)
  assert_eq(int8.is_even(int8.min_value()), true)
  assert_eq(int8.is_odd(int8.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(int8.to_string(int8.wrap_add(a, b)), "-88")
  assert_eq(int8.to_string(int8.wrap_add(int8.max_value(), one)), "-128")
  assert_eq(int8.to_string(int8.wrap_sub(b, a)), "112")
  assert_eq(int8.to_string(int8.wrap_sub(int8.min_value(), one)), "127")
  assert_eq(int8.to_string(int8.wrap_mul(a, b)), "80")
  assert_eq(int8.to_string(int8.wrap_mul(int8.max_value(), int8.from_wrapping(2))), "-2")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 8
  assert_eq(int8.to_string(int8.rotate_left(one, 7)), "-128")
  assert_eq(int8.to_string(int8.rotate_left(one, 8)), "1")
  assert_eq(int8.to_string(int8.rotate_left(a, 3)), "-28")
  assert_eq(int8.to_string(int8.rotate_right(one, 1)), "-128")
  assert_eq(int8.to_string(int8.rotate_right(a, 3)), "-109")
  assert_eq(int8.to_string(int8.rotate_right(int8.rotate_left(a, 5), 5)), "-100")
}

test "int16: the bit / wrapping / bounds matrix" {
  let a = int16.from_wrapping(-100)
  let b = int16.from_wrapping(12)
  let one = int16.from_wrapping(1)
  // bounds
  assert_eq(int16.to_string(int16.min_value()), "-32768")
  assert_eq(int16.to_string(int16.max_value()), "32767")
  // from_wrapping: reduced mod 2^16
  assert_eq(int16.to_string(a), "-100")
  assert_eq(int16.to_string(int16.from_wrapping(-1)), "-1")
  assert_eq(int16.to_string(int16.from_wrapping(65541)), "5")
  assert_eq(int16.to_string(int16.from_wrapping(32768)), "-32768")
  // band / bor / bxor / bnot
  assert_eq(int16.to_string(int16.band(a, b)), "12")
  assert_eq(int16.to_string(int16.bor(a, b)), "-100")
  assert_eq(int16.to_string(int16.bxor(a, b)), "-112")
  assert_eq(int16.to_string(int16.bnot(a)), "99")
  assert_eq(int16.to_string(int16.bnot(int16.min_value())), "32767")
  assert_eq(int16.to_string(int16.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(int16.is_even(a), true)
  assert_eq(int16.is_odd(a), false)
  assert_eq(int16.is_even(int16.max_value()), false)
  assert_eq(int16.is_odd(int16.max_value()), true)
  assert_eq(int16.is_even(int16.min_value()), true)
  assert_eq(int16.is_odd(int16.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(int16.to_string(int16.wrap_add(a, b)), "-88")
  assert_eq(int16.to_string(int16.wrap_add(int16.max_value(), one)), "-32768")
  assert_eq(int16.to_string(int16.wrap_sub(b, a)), "112")
  assert_eq(int16.to_string(int16.wrap_sub(int16.min_value(), one)), "32767")
  assert_eq(int16.to_string(int16.wrap_mul(a, b)), "-1200")
  assert_eq(int16.to_string(int16.wrap_mul(int16.max_value(), int16.from_wrapping(2))), "-2")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 16
  assert_eq(int16.to_string(int16.rotate_left(one, 15)), "-32768")
  assert_eq(int16.to_string(int16.rotate_left(one, 16)), "1")
  assert_eq(int16.to_string(int16.rotate_left(a, 3)), "-793")
  assert_eq(int16.to_string(int16.rotate_right(one, 1)), "-32768")
  assert_eq(int16.to_string(int16.rotate_right(a, 3)), "-24589")
  assert_eq(int16.to_string(int16.rotate_right(int16.rotate_left(a, 5), 5)), "-100")
}

test "int32: the bit / wrapping / bounds matrix" {
  let a = int32.from_wrapping(-100)
  let b = int32.from_wrapping(12)
  let one = int32.from_wrapping(1)
  // bounds
  assert_eq(int32.to_string(int32.min_value()), "-2147483648")
  assert_eq(int32.to_string(int32.max_value()), "2147483647")
  // from_wrapping: reduced mod 2^32
  assert_eq(int32.to_string(a), "-100")
  assert_eq(int32.to_string(int32.from_wrapping(-1)), "-1")
  assert_eq(int32.to_string(int32.from_wrapping(4294967301)), "5")
  assert_eq(int32.to_string(int32.from_wrapping(2147483648)), "-2147483648")
  // band / bor / bxor / bnot
  assert_eq(int32.to_string(int32.band(a, b)), "12")
  assert_eq(int32.to_string(int32.bor(a, b)), "-100")
  assert_eq(int32.to_string(int32.bxor(a, b)), "-112")
  assert_eq(int32.to_string(int32.bnot(a)), "99")
  assert_eq(int32.to_string(int32.bnot(int32.min_value())), "2147483647")
  assert_eq(int32.to_string(int32.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(int32.is_even(a), true)
  assert_eq(int32.is_odd(a), false)
  assert_eq(int32.is_even(int32.max_value()), false)
  assert_eq(int32.is_odd(int32.max_value()), true)
  assert_eq(int32.is_even(int32.min_value()), true)
  assert_eq(int32.is_odd(int32.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(int32.to_string(int32.wrap_add(a, b)), "-88")
  assert_eq(int32.to_string(int32.wrap_add(int32.max_value(), one)), "-2147483648")
  assert_eq(int32.to_string(int32.wrap_sub(b, a)), "112")
  assert_eq(int32.to_string(int32.wrap_sub(int32.min_value(), one)), "2147483647")
  assert_eq(int32.to_string(int32.wrap_mul(a, b)), "-1200")
  assert_eq(int32.to_string(int32.wrap_mul(int32.max_value(), int32.from_wrapping(2))), "-2")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 32
  assert_eq(int32.to_string(int32.rotate_left(one, 31)), "-2147483648")
  assert_eq(int32.to_string(int32.rotate_left(one, 32)), "1")
  assert_eq(int32.to_string(int32.rotate_left(a, 3)), "-793")
  assert_eq(int32.to_string(int32.rotate_right(one, 1)), "-2147483648")
  assert_eq(int32.to_string(int32.rotate_right(a, 3)), "-1610612749")
  assert_eq(int32.to_string(int32.rotate_right(int32.rotate_left(a, 5), 5)), "-100")
}

test "int64: the bit / wrapping / bounds matrix" {
  let a = int64.from_wrapping(-100)
  let b = int64.from_wrapping(12)
  let one = int64.from_wrapping(1)
  // bounds
  assert_eq(int64.to_string(int64.min_value()), "-9223372036854775808")
  assert_eq(int64.to_string(int64.max_value()), "9223372036854775807")
  // from_wrapping: reduced mod 2^64
  assert_eq(int64.to_string(a), "-100")
  assert_eq(int64.to_string(int64.from_wrapping(-1)), "-1")
  assert_eq(int64.to_string(int64.from_wrapping(9223372036854775807)), "9223372036854775807")
  assert_eq(int64.to_string(int64.from_wrapping(-9223372036854775808)), "-9223372036854775808")
  // band / bor / bxor / bnot
  assert_eq(int64.to_string(int64.band(a, b)), "12")
  assert_eq(int64.to_string(int64.bor(a, b)), "-100")
  assert_eq(int64.to_string(int64.bxor(a, b)), "-112")
  assert_eq(int64.to_string(int64.bnot(a)), "99")
  assert_eq(int64.to_string(int64.bnot(int64.min_value())), "9223372036854775807")
  assert_eq(int64.to_string(int64.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(int64.is_even(a), true)
  assert_eq(int64.is_odd(a), false)
  assert_eq(int64.is_even(int64.max_value()), false)
  assert_eq(int64.is_odd(int64.max_value()), true)
  assert_eq(int64.is_even(int64.min_value()), true)
  assert_eq(int64.is_odd(int64.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(int64.to_string(int64.wrap_add(a, b)), "-88")
  assert_eq(int64.to_string(int64.wrap_add(int64.max_value(), one)), "-9223372036854775808")
  assert_eq(int64.to_string(int64.wrap_sub(b, a)), "112")
  assert_eq(int64.to_string(int64.wrap_sub(int64.min_value(), one)), "9223372036854775807")
  assert_eq(int64.to_string(int64.wrap_mul(a, b)), "-1200")
  assert_eq(int64.to_string(int64.wrap_mul(int64.max_value(), int64.from_wrapping(2))), "-2")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 64
  assert_eq(int64.to_string(int64.rotate_left(one, 63)), "-9223372036854775808")
  assert_eq(int64.to_string(int64.rotate_left(one, 64)), "1")
  assert_eq(int64.to_string(int64.rotate_left(a, 3)), "-793")
  assert_eq(int64.to_string(int64.rotate_right(one, 1)), "-9223372036854775808")
  assert_eq(int64.to_string(int64.rotate_right(a, 3)), "-6917529027641081869")
  assert_eq(int64.to_string(int64.rotate_right(int64.rotate_left(a, 5), 5)), "-100")
}

test "uint8: the bit / wrapping / bounds matrix" {
  let a = uint8.from_wrapping(-100)
  let b = uint8.from_wrapping(12)
  let one = uint8.from_wrapping(1)
  // bounds
  assert_eq(uint8.to_string(uint8.min_value()), "0")
  assert_eq(uint8.to_string(uint8.max_value()), "255")
  // from_wrapping: reduced mod 2^8
  assert_eq(uint8.to_string(a), "156")
  assert_eq(uint8.to_string(uint8.from_wrapping(-1)), "255")
  assert_eq(uint8.to_string(uint8.from_wrapping(261)), "5")
  assert_eq(uint8.to_string(uint8.from_wrapping(128)), "128")
  // band / bor / bxor / bnot
  assert_eq(uint8.to_string(uint8.band(a, b)), "12")
  assert_eq(uint8.to_string(uint8.bor(a, b)), "156")
  assert_eq(uint8.to_string(uint8.bxor(a, b)), "144")
  assert_eq(uint8.to_string(uint8.bnot(a)), "99")
  assert_eq(uint8.to_string(uint8.bnot(uint8.min_value())), "255")
  assert_eq(uint8.to_string(uint8.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(uint8.is_even(a), true)
  assert_eq(uint8.is_odd(a), false)
  assert_eq(uint8.is_even(uint8.max_value()), false)
  assert_eq(uint8.is_odd(uint8.max_value()), true)
  assert_eq(uint8.is_even(uint8.min_value()), true)
  assert_eq(uint8.is_odd(uint8.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(uint8.to_string(uint8.wrap_add(a, b)), "168")
  assert_eq(uint8.to_string(uint8.wrap_add(uint8.max_value(), one)), "0")
  assert_eq(uint8.to_string(uint8.wrap_sub(b, a)), "112")
  assert_eq(uint8.to_string(uint8.wrap_sub(uint8.min_value(), one)), "255")
  assert_eq(uint8.to_string(uint8.wrap_mul(a, b)), "80")
  assert_eq(uint8.to_string(uint8.wrap_mul(uint8.max_value(), uint8.from_wrapping(2))), "254")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 8
  assert_eq(uint8.to_string(uint8.rotate_left(one, 7)), "128")
  assert_eq(uint8.to_string(uint8.rotate_left(one, 8)), "1")
  assert_eq(uint8.to_string(uint8.rotate_left(a, 3)), "228")
  assert_eq(uint8.to_string(uint8.rotate_right(one, 1)), "128")
  assert_eq(uint8.to_string(uint8.rotate_right(a, 3)), "147")
  assert_eq(uint8.to_string(uint8.rotate_right(uint8.rotate_left(a, 5), 5)), "156")
}

test "uint16: the bit / wrapping / bounds matrix" {
  let a = uint16.from_wrapping(-100)
  let b = uint16.from_wrapping(12)
  let one = uint16.from_wrapping(1)
  // bounds
  assert_eq(uint16.to_string(uint16.min_value()), "0")
  assert_eq(uint16.to_string(uint16.max_value()), "65535")
  // from_wrapping: reduced mod 2^16
  assert_eq(uint16.to_string(a), "65436")
  assert_eq(uint16.to_string(uint16.from_wrapping(-1)), "65535")
  assert_eq(uint16.to_string(uint16.from_wrapping(65541)), "5")
  assert_eq(uint16.to_string(uint16.from_wrapping(32768)), "32768")
  // band / bor / bxor / bnot
  assert_eq(uint16.to_string(uint16.band(a, b)), "12")
  assert_eq(uint16.to_string(uint16.bor(a, b)), "65436")
  assert_eq(uint16.to_string(uint16.bxor(a, b)), "65424")
  assert_eq(uint16.to_string(uint16.bnot(a)), "99")
  assert_eq(uint16.to_string(uint16.bnot(uint16.min_value())), "65535")
  assert_eq(uint16.to_string(uint16.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(uint16.is_even(a), true)
  assert_eq(uint16.is_odd(a), false)
  assert_eq(uint16.is_even(uint16.max_value()), false)
  assert_eq(uint16.is_odd(uint16.max_value()), true)
  assert_eq(uint16.is_even(uint16.min_value()), true)
  assert_eq(uint16.is_odd(uint16.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(uint16.to_string(uint16.wrap_add(a, b)), "65448")
  assert_eq(uint16.to_string(uint16.wrap_add(uint16.max_value(), one)), "0")
  assert_eq(uint16.to_string(uint16.wrap_sub(b, a)), "112")
  assert_eq(uint16.to_string(uint16.wrap_sub(uint16.min_value(), one)), "65535")
  assert_eq(uint16.to_string(uint16.wrap_mul(a, b)), "64336")
  assert_eq(uint16.to_string(uint16.wrap_mul(uint16.max_value(), uint16.from_wrapping(2))), "65534")
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 16
  assert_eq(uint16.to_string(uint16.rotate_left(one, 15)), "32768")
  assert_eq(uint16.to_string(uint16.rotate_left(one, 16)), "1")
  assert_eq(uint16.to_string(uint16.rotate_left(a, 3)), "64743")
  assert_eq(uint16.to_string(uint16.rotate_right(one, 1)), "32768")
  assert_eq(uint16.to_string(uint16.rotate_right(a, 3)), "40947")
  assert_eq(uint16.to_string(uint16.rotate_right(uint16.rotate_left(a, 5), 5)), "65436")
}

test "uint32: the bit / wrapping / bounds matrix" {
  let a = uint32.from_wrapping(-100)
  let b = uint32.from_wrapping(12)
  let one = uint32.from_wrapping(1)
  // bounds
  assert_eq(uint32.to_string(uint32.min_value()), "0")
  assert_eq(uint32.to_string(uint32.max_value()), "4294967295")
  // from_wrapping: reduced mod 2^32
  assert_eq(uint32.to_string(a), "4294967196")
  assert_eq(uint32.to_string(uint32.from_wrapping(-1)), "4294967295")
  assert_eq(uint32.to_string(uint32.from_wrapping(4294967301)), "5")
  assert_eq(uint32.to_string(uint32.from_wrapping(2147483648)), "2147483648")
  // band / bor / bxor / bnot
  assert_eq(uint32.to_string(uint32.band(a, b)), "12")
  assert_eq(uint32.to_string(uint32.bor(a, b)), "4294967196")
  assert_eq(uint32.to_string(uint32.bxor(a, b)), "4294967184")
  assert_eq(uint32.to_string(uint32.bnot(a)), "99")
  assert_eq(uint32.to_string(uint32.bnot(uint32.min_value())), "4294967295")
  assert_eq(uint32.to_string(uint32.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(uint32.is_even(a), true)
  assert_eq(uint32.is_odd(a), false)
  assert_eq(uint32.is_even(uint32.max_value()), false)
  assert_eq(uint32.is_odd(uint32.max_value()), true)
  assert_eq(uint32.is_even(uint32.min_value()), true)
  assert_eq(uint32.is_odd(uint32.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(uint32.to_string(uint32.wrap_add(a, b)), "4294967208")
  assert_eq(uint32.to_string(uint32.wrap_add(uint32.max_value(), one)), "0")
  assert_eq(uint32.to_string(uint32.wrap_sub(b, a)), "112")
  assert_eq(uint32.to_string(uint32.wrap_sub(uint32.min_value(), one)), "4294967295")
  assert_eq(uint32.to_string(uint32.wrap_mul(a, b)), "4294966096")
  assert_eq(
    uint32.to_string(uint32.wrap_mul(uint32.max_value(), uint32.from_wrapping(2))),
    "4294967294",
  )
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 32
  assert_eq(uint32.to_string(uint32.rotate_left(one, 31)), "2147483648")
  assert_eq(uint32.to_string(uint32.rotate_left(one, 32)), "1")
  assert_eq(uint32.to_string(uint32.rotate_left(a, 3)), "4294966503")
  assert_eq(uint32.to_string(uint32.rotate_right(one, 1)), "2147483648")
  assert_eq(uint32.to_string(uint32.rotate_right(a, 3)), "2684354547")
  assert_eq(uint32.to_string(uint32.rotate_right(uint32.rotate_left(a, 5), 5)), "4294967196")
}

test "uint64: the bit / wrapping / bounds matrix" {
  let a = uint64.from_wrapping(-100)
  let b = uint64.from_wrapping(12)
  let one = uint64.from_wrapping(1)
  // bounds
  assert_eq(uint64.to_string(uint64.min_value()), "0")
  assert_eq(uint64.to_string(uint64.max_value()), "18446744073709551615")
  // from_wrapping: reduced mod 2^64
  assert_eq(uint64.to_string(a), "18446744073709551516")
  assert_eq(uint64.to_string(uint64.from_wrapping(-1)), "18446744073709551615")
  assert_eq(uint64.to_string(uint64.from_wrapping(9223372036854775807)), "9223372036854775807")
  assert_eq(uint64.to_string(uint64.from_wrapping(-9223372036854775808)), "9223372036854775808")
  // band / bor / bxor / bnot
  assert_eq(uint64.to_string(uint64.band(a, b)), "12")
  assert_eq(uint64.to_string(uint64.bor(a, b)), "18446744073709551516")
  assert_eq(uint64.to_string(uint64.bxor(a, b)), "18446744073709551504")
  assert_eq(uint64.to_string(uint64.bnot(a)), "99")
  assert_eq(uint64.to_string(uint64.bnot(uint64.min_value())), "18446744073709551615")
  assert_eq(uint64.to_string(uint64.bxor(a, a)), "0")
  // is_even / is_odd, at both rails
  assert_eq(uint64.is_even(a), true)
  assert_eq(uint64.is_odd(a), false)
  assert_eq(uint64.is_even(uint64.max_value()), false)
  assert_eq(uint64.is_odd(uint64.max_value()), true)
  assert_eq(uint64.is_even(uint64.min_value()), true)
  assert_eq(uint64.is_odd(uint64.from_wrapping(-3)), true)
  // wrap_add / wrap_sub / wrap_mul: in range, and across each rail
  assert_eq(uint64.to_string(uint64.wrap_add(a, b)), "18446744073709551528")
  assert_eq(uint64.to_string(uint64.wrap_add(uint64.max_value(), one)), "0")
  assert_eq(uint64.to_string(uint64.wrap_sub(b, a)), "112")
  assert_eq(uint64.to_string(uint64.wrap_sub(uint64.min_value(), one)), "18446744073709551615")
  assert_eq(uint64.to_string(uint64.wrap_mul(a, b)), "18446744073709550416")
  assert_eq(
    uint64.to_string(uint64.wrap_mul(uint64.max_value(), uint64.from_wrapping(2))),
    "18446744073709551614",
  )
  // rotate_left / rotate_right: bits leave one end and enter the other; the count is mod 64
  assert_eq(uint64.to_string(uint64.rotate_left(one, 63)), "9223372036854775808")
  assert_eq(uint64.to_string(uint64.rotate_left(one, 64)), "1")
  assert_eq(uint64.to_string(uint64.rotate_left(a, 3)), "18446744073709550823")
  assert_eq(uint64.to_string(uint64.rotate_right(one, 1)), "9223372036854775808")
  assert_eq(uint64.to_string(uint64.rotate_right(a, 3)), "11529215046068469747")
  assert_eq(
    uint64.to_string(uint64.rotate_right(uint64.rotate_left(a, 5), 5)),
    "18446744073709551516",
  )
}
