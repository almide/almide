// list.join over any Text (R-L0-42): String and Bytes, each through its own
// module's join, with the separator between the parts and nothing for [].
test "join Strings" {
  assert_eq(list.join(["a", "b", "c"], ", "), "a, b, c")
  assert_eq(list.join(["solo"], "-"), "solo")
  let empty: List[String] = []
  assert_eq(list.join(empty, "-"), "")
  assert_eq(["x", "y"] |> list.join(""), "xy")
}

test "join Bytes" {
  let parts = [bytes.from_string("ab"), bytes.from_string(""), bytes.from_string("c")]
  assert_eq(
    bytes.to_list(list.join(parts, bytes.from_string("/"))),
    bytes.to_list(bytes.from_string("ab//c")),
  )
  let empty: List[Bytes] = []
  assert_eq(bytes.len(list.join(empty, bytes.from_string("/"))), 0)
  assert_eq(
    bytes.to_list(list.join([
      bytes.from_list([1, 2])
    ], bytes.from_list([9]))),
    [1, 2],
  )
}
