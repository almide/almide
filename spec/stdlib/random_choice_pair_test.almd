// #1169: `random.choice` over `(String, String)` elements — the omikuji table
// shape — links the `random.choice_pair` twin on the wasm leg instead of the
// unlinked `_x` wall (the picked pair is shared by handle into some(); the
// scalar and String element classes keep their existing twins). Entropy makes
// the pick nondeterministic, so the assertions pin MEMBERSHIP and the
// empty-list none, not a specific pick.
import random
import testing

let TABLE = [("A", "Ship it."), ("B", "Do not deploy.")]

effect fn pick_ok() -> Result[Bool, String] = {
  let p = random.choice(TABLE)!
  let k = p.0 == "A" or p.0 == "B"
  let v = p.1 == "Ship it." or p.1 == "Do not deploy."
  ok(k and v)
}

test "a picked pair is a table row" {
  assert_eq(pick_ok()!, true)
  assert_eq(pick_ok()!, true)
  assert_eq(pick_ok()!, true)
}

test "the empty table picks none" {
  let empty: List[(String, String)] = []
  match random.choice(empty) {
    some(_) => testing.assert_contains("unexpected", "never"),
    none => assert_eq(1, 1),
  }
}
