// Regression guard: bundled-Almide stdlib dispatch.
// list.bundled_probe / split_at are defined in stdlib/list.almd with no
// TOML/Rust runtime. If any of these fail, the codegen rt_ bypass is
// broken on Rust or WASM — see docs/roadmap/done/bundled-almide-dispatch.md.
test "list.bundled_probe (bundled-Almide dispatch smoke)" {
  assert_eq(list.bundled_probe(41), 42)
}

test "list.split_at (bundled fn calling TOML fns)" {
  let xs = [1, 2, 3, 4, 5]
  let p = list.split_at(xs, 2)
  let (a, b) = p
  assert_eq(a, [1, 2])
  assert_eq(b, [3, 4, 5])
}

test "list.split_at past end" {
  let xs = [1, 2, 3]
  let p = list.split_at(xs, 10)
  let (a, b) = p
  assert_eq(a, [1, 2, 3])
  assert_eq(b, [])
}

test "list.iterate (pure-Almide body)" {
  assert_eq(list.iterate(1, (x) => x * 2, 5), [1, 2, 4, 8, 16])
}

test "list.iterate zero" {
  assert_eq(list.iterate(7, (x) => x + 1, 0), [])
}

test "list.iterate negative count" {
  assert_eq(list.iterate(7, (x) => x + 1, -3), [])
}

// #2306: the recursive body took one frame per element — a stack overflow at
// about 10,000 elements on wasm and 50,000 natively.
test "list.iterate a million elements" {
  let xs = list.iterate(0, (x) => x + 1, 1000000)
  assert_eq(list.len(xs), 1000000)
  assert_eq(list.last(xs), some(999999))
}

// A heap element: the result must grow in place, not be copied per element.
test "list.iterate a heap element" {
  let xs = list.iterate("a", (s) => if string.len(s) >= 3 then "a" else s + "a", 200000)
  assert_eq(list.len(xs), 200000)
  assert_eq(list.get(xs, 199999), some("aa"))
}

test "list.* TOML fns coexist with bundled fns" {
  assert_eq(list.sum([1, 2, 3]), 6)
  assert_eq(list.len([1, 2, 3]), 3)
}

test "list.length alias" {
  assert_eq(list.length([1, 2, 3]), 3)
  let xs: List[Int] = []
  assert_eq(list.length(xs), 0)
  assert_eq(list.length([1, 2, 3]), list.len([1, 2, 3]))
}
