// #1041 — the try_* family: an effectful pipeline keeps the combinator shape.
// Each try_<core> lifts its core's callback to `-> Result[_, E]`, yields
// `Result[_, E]`, and SHORT-CIRCUITS on the first err. The family completeness
// rule (which cores have twins, which omissions are deliberate) is pinned by
// tests/list_try_family_gate_test.rs; this file pins the behavior.
fn parse(s: String) -> Result[Int, String] = int.parse(s)

// A step that errs on a marker value — the err payload NAMES the input, so a
// short-circuit test can prove WHICH element failed first.
fn step(n: Int) -> Result[Int, String] = if n < 0 then err("neg:${n}")
else ok(n * 10)

test "try_map collects ok values" {
  assert_eq(list.try_map(["1", "2", "3"], (s) => parse(s)), ok([1, 2, 3]))
  let empty: List[String] = []
  let got: Result[List[Int], String] = list.try_map(empty, (s) => parse(s))
  let want: List[Int] = []
  assert_eq(got, ok(want))
}

test "try_map short-circuits on the FIRST err" {
  // -7 errs; -9 after it must never be evaluated — the payload proves order.
  assert_eq(list.try_map([1, -7, -9], (n) => step(n)), err("neg:-7"))
}

test "try_filter keeps by an erring predicate" {
  let evens: Result[List[Int], String] = list.try_filter([1, 2, 3, 4], (n) => ok(n % 2 == 0))
  assert_eq(evens, ok([2, 4]))
  assert_eq(list.try_filter([2, -1, 4], (n) => if n < 0 then err("neg:${n}")
  else ok(true)), err("neg:-1"))
}

test "try_flat_map concatenates and short-circuits" {
  let doubled: Result[List[Int], String] = list.try_flat_map([1, 2], (n) => ok([n, n]))
  assert_eq(doubled, ok([1, 1, 2, 2]))
  assert_eq(list.try_flat_map([1, -2, -3], (n) => if n < 0 then err("neg:${n}")
  else ok([n])), err("neg:-2"))
}

test "try_filter_map keeps ok(some), drops ok(none), stops at err" {
  let r: Result[List[Int], String] = list.try_filter_map(["1", "x", "3"], (s) => ok(int.parse(s)?))
  assert_eq(r, ok([1, 3]))
  assert_eq(list.try_filter_map(["1", "!"], (s) => if s == "!" then err("bang")
  else ok(int.parse(s)?)), err("bang"))
}

test "try_fold threads the accumulator and stops at err" {
  let sum: Result[Int, String] = list.try_fold([1, 2, 3], 0, (acc, n) => ok(acc + n))
  assert_eq(sum, ok(6))
  assert_eq(list.try_fold([1, -2, -3], 0, (acc, n) => if n < 0 then err("neg:${n}")
  else ok(acc + n)), err("neg:-2"))
  let none_in: List[Int] = []
  let kept: Result[Int, String] = list.try_fold(none_in, 42, (acc, n) => ok(acc + n))
  assert_eq(kept, ok(42))
}

test "try_find returns ok(some/none) and propagates err" {
  let hit: Result[Int?, String] = list.try_find([1, 2, 3], (n) => ok(n > 1))
  assert_eq(hit, ok(some(2)))
  let miss: Result[Int?, String] = list.try_find([1, 2, 3], (n) => ok(n > 9))
  assert_eq(miss, ok(none))
  assert_eq(list.try_find([1, -2, 3], (n) => if n < 0 then err("neg:${n}")
  else ok(false)), err("neg:-2"))
}

test "try_each runs to completion or stops at the first err" {
  let done: Result[Unit, String] = list.try_each([1, 2], (n) => ok(()))
  assert_eq(done, ok(()))
  assert_eq(list.try_each([1, -2, -3], (n) => if n < 0 then err("neg:${n}")
  else ok(())), err("neg:-2"))
}

// The motivating shape: inside an effect fn, an effectful body in the callback
// produces the Result the family consumes — no `var + for`.
effect fn parse_all(xs: List[String]) -> Result[List[Int], String] = xs |> list.try_map((s) => int.parse(s))

test "the effect-fn pipeline shape (#1041's motivating case)" {
  assert_eq(parse_all(["10", "20"]), ok([10, 20]))
  match parse_all(["10", "x"]) {
    ok(_) => assert(false),
    err(e) => assert_eq(e, "invalid digit found in string"),
  }
}
