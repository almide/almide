// io.read_line (#2539, R-io-01): `none` at the end of input, so it is never
// confused with an empty line, which is `some("")`. `almide test` runs a file
// with stdin closed on every leg, so the first read here is already at the
// end. The empty-line half needs piped stdin and lives in
// tests/io_read_line_opt_test.rs.
import io

test "read_line is none at the end of input" {
  assert_eq(io.read_line(), none)
}

test "read_line stays none on a second read at the end of input" {
  assert_eq(io.read_line(), none)
  assert_eq(io.read_line() ?? "end", "end")
}
