// @contract: C-220
// fs.fold_lines_range — the chunk-parallel worker's walker. Ownership rule:
// a line belongs to the chunk containing the byte BEFORE its first byte
// (line 0 to the chunk containing byte 0), so folding any partition of
// [0, file_size) visits every line exactly once, whatever the boundaries.
import fs

effect fn tmp() -> String = fs.create_temp_dir("range")!

effect fn collect_partition(path: String, cuts: List[Int]) -> List[String] = {
  var out: List[String] = []
  for i in 0..<(list.len(cuts) - 1) {
    let part = fs.fold_lines_range(path, cuts[i], cuts[i + 1], [], (acc, line) => acc + [line])!
    out = out + part
  }
  out
}

test "every partition folds every line exactly once" {
  let d = tmp()!
  let p = d + "/data.txt"
  // lines: "aa"(0..2) "bbb"(3..6) "c"(7..8) "dddd"(9..13), size 14
  fs.write(p, "aa\nbbb\nc\ndddd\n")!
  let whole = fs.read_lines(p)!
  let size = fs.file_size(p)!
  let partitions = [
    [0, size],
    [0, 7, size],
    [0, 1, size],
    [0, 3, size],
    [0, 4, 9, size],
    [0, 0, size],
    [0, 2, 3, 8, size]
  ]
  for cuts in partitions {
    assert_eq(collect_partition(p, cuts)!, whole)
  }
}

test "no trailing newline still partitions exactly" {
  let d = tmp()!
  let p = d + "/tail.txt"
  fs.write(p, "one\ntwo\nthree")!
  let whole = fs.read_lines(p)!
  let size = fs.file_size(p)!
  for cuts in [
    [0, 5, size],
    [0, 4, size],
    [0, 12, size]
  ] {
    assert_eq(collect_partition(p, cuts)!, whole)
  }
}

test "crlf boundary cuts stay exact" {
  let d = tmp()!
  let p = d + "/crlf.txt"
  fs.write(p, "a\r\nbb\r\nc\r\n")!
  let whole = fs.read_lines(p)!
  let size = fs.file_size(p)!
  for cuts in [
    [0, 2, size],
    [0, 3, size],
    [0, 4, 7, size]
  ] {
    assert_eq(collect_partition(p, cuts)!, whole)
  }
}

test "empty range folds to init" {
  let d = tmp()!
  let p = d + "/e.txt"
  fs.write(p, "x\ny\n")!
  assert_eq(fs.fold_lines_range(p, 2, 2, ["seed"], (acc, line) => acc + [line])!, ["seed"])
}

test "the range twin matrix: every accumulator type folds the same lines" {
  let d = tmp()!
  let p = d + "/cells.txt"
  fs.write(p, "alpha\nbeta\ngamma\ndelta\n")!
  // Int acc (_i): byte-length sum — the range [0, 6) owns only "alpha"
  // (beta STARTS at byte 6, and a line folds only while its start < end).
  assert_eq(fs.fold_lines_range(p, 0, 6, 100, (acc: Int, line) => acc + string.len(line))!, 105)
  // String acc (_s): concat over the range starting inside line 1.
  assert_eq(fs.fold_lines_range(p, 7, 17, "", (acc: String, line) => acc + line + "|")!, "gamma|")
  // List[String] acc (_ls): the whole file.
  assert_eq(fs.fold_lines_range(p, 0, 999, [], (acc, line) => acc + [line])!, ["alpha", "beta", "gamma", "delta"])
  // Map[String, Int] acc (_msi): line -> byte length.
  let z: Map[String, Int] = [:]
  let m = fs.fold_lines_range(p, 0, 999, z, (acc: Map[String, Int], line) => map.set(acc, line, string.len(line)))!
  assert_eq(map.len(m), 4)
  assert_eq(map.get(m, "delta") ?? -1, 5)
}
