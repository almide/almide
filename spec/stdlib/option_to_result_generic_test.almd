// option.to_result is E-generic (#1114): the String spelling stays source
// compatible, and a variant error type flows through with match-ability
// intact (ADR-0003 D1 route).
import testing

type LoadError = | Missing(String) | Broken

test "string form is unchanged" {
  let o: Option[Int] = none
  assert_eq(option.to_result(o, "gone"), err("gone"): Result[Int, String])
  assert_eq(option.to_result(some(7), "gone"), ok(7): Result[Int, String])
}

test "custom E flows through" {
  let o: Option[Int] = none
  let r: Result[Int, LoadError] = option.to_result(o, Missing("cfg"))
  match r {
    err(Missing(k)) => assert_eq(k, "cfg"),
    _               => testing.assert_contains("unexpected", "never"),
  }
}
