// @contract: C-220
// fs.fold_lines_chunked — one range worker per chunk on real threads inside
// the runtime, partials returned in CHUNK ORDER. Merging the partials with
// any associative fold must equal the sequential fold_lines result for every
// worker count — including workers > lines, workers = 1, and w <= 0 (clamped
// to 1). Determinism: partial ORDER is chunk order, never thread order.
import fs
import testing

effect fn tmp() -> String = fs.create_temp_dir("chunked")!

fn count_step(acc: Map[String, Int], line: String) -> Map[String, Int] = map.upsert(acc, line, 1, (n) => n + 1)

effect fn seq_counts(path: String) -> Map[String, Int] = fs.fold_lines(path, map.new(), (acc, line) => count_step(acc, line))!

effect fn par_counts(path: String, workers: Int) -> Map[String, Int] = {
  let partials = fs.fold_lines_chunked(path, workers, map.new(), count_step)!
  partials |> list.fold(map.new(), (acc, m) => combine(acc, m))
}

// NOT map.merge: counts must ADD on key collision, merge overwrites.
fn combine(a: Map[String, Int], b: Map[String, Int]) -> Map[String, Int] = map.entries(b) |> list.fold(a, (acc, e) => {
  let (k, v) = e
  map.upsert(acc, k, v, (n) => n + v)
})

test "every worker count folds every line exactly once" {
  let d = tmp()!
  let p = d + "/data.txt"
  fs.write(p, "x\ny\nx\nz\nx\ny\nw\n")!
  let seq = seq_counts(p)!
  for w in [1, 2, 3, 5, 16] {
    let par = par_counts(p, w)!
    assert_eq(map.get_or(par, "x", 0), map.get_or(seq, "x", 0))
    assert_eq(map.get_or(par, "y", 0), map.get_or(seq, "y", 0))
    assert_eq(map.get_or(par, "z", 0), map.get_or(seq, "z", 0))
    assert_eq(map.get_or(par, "w", 0), map.get_or(seq, "w", 0))
    assert_eq(map.len(par), map.len(seq))
  }
}

test "workers below one clamp to one" {
  let d = tmp()!
  let p = d + "/one.txt"
  fs.write(p, "a\nb\n")!
  let partials = fs.fold_lines_chunked(p, 0, [], (acc, line) => acc + [line])!
  assert_eq(list.len(partials), 1)
  assert_eq(partials[0], ["a", "b"])
}

test "empty file yields no partials" {
  let d = tmp()!
  let p = d + "/empty.txt"
  fs.write(p, "")!
  let partials = fs.fold_lines_chunked(p, 4, 0, (acc, line) => acc + 1)!
  assert_eq(partials, [])
}

test "partials arrive in chunk order" {
  let d = tmp()!
  let p = d + "/ord.txt"
  // 8 bytes, 2 workers → chunk width 8/2+1 = 5, cut at byte 5: the line
  // starting at byte 4 ("c") is owned by the first chunk (start 4 < 5).
  fs.write(p, "a\nb\nc\nd\n")!
  let partials = fs.fold_lines_chunked(p, 2, [], (acc, line) => acc + [line])!
  assert_eq(list.len(partials), 2)
  assert_eq(partials[0], ["a", "b", "c"])
  assert_eq(partials[1], ["d"])
}

test "a missing file is an err" {
  let d = tmp()!
  testing.assert_err(fs.fold_lines_chunked(d + "/nope.txt", 4, 0, (acc, line) => acc))
}
