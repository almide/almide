// #4106: HMAC (RFC 2104 / RFC 4231) and the constant-time compare. The key
// and the tag are Secret[Bytes] (security table row 20): the tag's == is the
// constant-time one (C-426), and its hex is hex.encode(secret.reveal(tag)).
import hash
import hex
import secret

fn s(t: String) -> Bytes = bytes.from_string(t)

fn k(t: String) -> Secret[Bytes] = secret.new(bytes.from_string(t))

fn hex_of(tag: Secret[Bytes]) -> String = hex.encode(secret.reveal(tag))

fn from_hex(sig: String) -> Secret[Bytes] = secret.new(hex.decode(sig) ?? bytes.from_list([]))

test "hmac_sha256 and hmac_sha512 equal RFC 4231 test case 2, key first" {
  assert_eq(
    hex_of(hash.hmac_sha256(k("Jefe"), s("what do ya want for nothing?"))),
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
  )
  assert_eq(
    hex_of(hash.hmac_sha512(k("Jefe"), s("what do ya want for nothing?"))),
    "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
  )
  assert(hash.hmac_sha256(k("what do ya want for nothing?"), s("Jefe")) != hash.hmac_sha256(
    k("Jefe"),
    s("what do ya want for nothing?"),
  ))
}

test "a key longer than the block is hashed first (RFC 4231 test case 6)" {
  let key = secret.new(bytes.from_list(list.repeat(170, 131)))
  assert_eq(
    hex_of(hash.hmac_sha256(key, s("Test Using Larger Than Block-Size Key - Hash Key First"))),
    "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
  )
}

test "the tags have the digest lengths and print as Secret(***)" {
  let key = k("k")
  let m = s("m")
  assert_eq(bytes.len(secret.reveal(hash.hmac_sha256(key, m))), 32)
  assert_eq(bytes.len(secret.reveal(hash.hmac_sha512(key, m))), 64)
  assert_eq("${hash.hmac_sha256(key, m)}", "Secret(***)")
}

test "a tag's == is the constant-time compare of the revealed bytes" {
  let key = k("key")
  let m = s("message")
  assert(hash.hmac_sha256(key, m) == hash.hmac_sha256(k("key"), s("message")))
  assert(hash.hmac_sha256(key, m) != hash.hmac_sha256(key, s("massage")))
  assert(hash.hmac_sha256(key, m) != hash.hmac_sha512(key, m))
}

test "is_valid_ accepts the right tag only" {
  let key = k("key")
  let m = s("message")
  let tag = hash.hmac_sha256(key, m)
  let h = hex_of(tag)
  assert(hash.is_valid_hmac_sha256(key, m, tag))
  assert(hash.is_valid_hmac_sha256(key, m, from_hex(h)))
  assert(hash.is_valid_hmac_sha256(key, m, from_hex(string.to_upper(h))))
  assert(not hash.is_valid_hmac_sha256(key, s("massage"), tag))
  assert(not hash.is_valid_hmac_sha256(key, m, secret.new(bytes.slice(secret.reveal(tag), 0, 31))))
  assert(not hash.is_valid_hmac_sha256(key, m, from_hex("not hex")))
  assert(not hash.is_valid_hmac_sha256(key, m, from_hex(string.slice(h, 0, 63))))
  assert(hash.is_valid_hmac_sha512(key, m, hash.hmac_sha512(key, m)))
  assert(not hash.is_valid_hmac_sha512(key, m, tag))
}

test "is_equal_constant_time answers what == answers" {
  assert(bytes.is_equal_constant_time(s("abc"), s("abc")))
  assert(not bytes.is_equal_constant_time(s("abc"), s("abd")))
  assert(not bytes.is_equal_constant_time(s("abc"), s("ab")))
  assert(bytes.is_equal_constant_time(s(""), s("")))
  assert(string.is_equal_constant_time("token", "token"))
  assert(not string.is_equal_constant_time("token", "tokem"))
  assert(not string.is_equal_constant_time("token", "tokens"))
}
