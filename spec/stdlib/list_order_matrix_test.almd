// The list additions of the stdlib redesign (wave 1): the Container
// constructors (R-list-20), the `_with` / `_by` cells of the sort / min / max /
// binary_search matrix (R-list-06, R-list-17, R-list-19), `unzip` (R-list-07)
// and `range_step` (R-list-09). Each generic fn runs with Int and String
// elements, and each one meets its empty input.
import testing

local fn desc(a: Int, b: Int) -> Int = if a > b then -1
else if a < b then 1 else 0

local fn by_len(a: String, b: String) -> Int = string.len(a) - string.len(b)

local fn asc(a: Int, b: Int) -> Int = if a < b then -1
else if a > b then 1 else 0

test "new, from_list and to_list are the plain list" {
  let e: List[Int] = list.new()
  assert_eq(e, [])
  assert_eq(list.from_list([1, 2, 3]), [1, 2, 3])
  assert_eq(list.to_list(["a", "b"]), ["a", "b"])
  let es: List[String] = list.to_list([])
  assert_eq(es, [])
}

test "sort_with orders by the comparator and is stable" {
  assert_eq(list.sort_with([3, 1, 2, 5, 4], desc), [5, 4, 3, 2, 1])
  assert_eq(list.sort_with(["ccc", "a", "bb", "b", "aa"], by_len), ["a", "b", "bb", "aa", "ccc"])
  assert_eq(list.sort_with([2, 1, 2, 1], asc), list.sort([2, 1, 2, 1]))
  let e: List[Int] = []
  assert_eq(list.sort_with(e, desc), [])
  assert_eq(list.sort_with([7], desc), [7])
}

test "min_by and max_by take the first element on a tied key" {
  assert_eq(list.min_by(["bb", "a", "cc", "d"], (s) => string.len(s)), some("a"))
  assert_eq(list.max_by(["bb", "a", "cc", "d"], (s) => string.len(s)), some("bb"))
  assert_eq(list.min_by([3, -4, 4, 1], (x) => x * x), some(1))
  assert_eq(list.max_by([3, -4, 4, 1], (x) => x * x), some(-4))
  let e: List[Int] = []
  assert_eq(list.min_by(e, (x) => x), none)
  assert_eq(list.max_by(e, (x) => x), none)
}

test "min_with and max_with take the first element on a tie" {
  assert_eq(list.min_with([3, 1, 2], asc), list.min([3, 1, 2]))
  assert_eq(list.max_with([3, 1, 2], asc), list.max([3, 1, 2]))
  assert_eq(list.min_with([3, 1, 2], desc), some(3))
  assert_eq(list.min_with(["bb", "a", "cc", "d"], by_len), some("a"))
  assert_eq(list.max_with(["bb", "a", "cc", "d"], by_len), some("bb"))
  let e: List[String] = []
  assert_eq(list.min_with(e, by_len), none)
  assert_eq(list.max_with(e, by_len), none)
}

test "binary_search_by finds a key of a list sorted by that key" {
  let words = ["a", "bb", "ccc", "dddd"]
  assert_eq(list.binary_search_by(words, 3, (s) => string.len(s)), some(2))
  assert_eq(list.binary_search_by(words, 1, (s) => string.len(s)), some(0))
  assert_eq(list.binary_search_by(words, 5, (s) => string.len(s)), none)
  assert_eq(list.binary_search_by([1, 3, 5], 3, (x) => x), list.binary_search([1, 3, 5], 3))
  assert_eq(
    list.binary_search_by([2, 2, 2, 2, 2], 2, (x) => x),
    list.binary_search([2, 2, 2, 2, 2], 2),
  )
  let e: List[String] = []
  assert_eq(list.binary_search_by(e, 1, (s) => string.len(s)), none)
}

test "binary_search_with finds a value of a list sorted by the comparator" {
  assert_eq(list.binary_search_with([9, 7, 5, 3], 5, desc), some(2))
  assert_eq(list.binary_search_with([9, 7, 5, 3], 4, desc), none)
  assert_eq(list.binary_search_with(["a", "bb", "ccc"], "xx", by_len), some(1))
  assert_eq(list.binary_search_with([1, 3, 5, 7], 7, asc), list.binary_search([1, 3, 5, 7], 7))
  let e: List[Int] = []
  assert_eq(list.binary_search_with(e, 1, asc), none)
}

test "unzip is the inverse of zip" {
  let r1 = list.unzip([(1, "a"), (2, "b")])
  assert_eq(r1.0, [1, 2])
  assert_eq(r1.1, ["a", "b"])
  let xs = [1, 2, 3]
  let ys = ["x", "y", "z"]
  let back = list.unzip(list.zip(xs, ys))
  assert_eq(back.0, xs)
  assert_eq(back.1, ys)
  let e: List[(Int, String)] = []
  let r2 = list.unzip(e)
  assert_eq(list.len(r2.0), 0)
  assert_eq(list.len(r2.1), 0)
}

test "range_step counts up, counts down, and is half-open like range" {
  assert_eq(list.range_step(0, 10, 3), [0, 3, 6, 9])
  assert_eq(list.range_step(0, 9, 3), [0, 3, 6])
  assert_eq(list.range_step(2, 7, 1), list.range(2, 7))
  assert_eq(list.range_step(5, 0, -2), [5, 3, 1])
  assert_eq(list.range_step(5, -1, -2), [5, 3, 1])
  assert_eq(list.range_step(3, 3, 1), [])
  assert_eq(list.range_step(5, 0, 1), [])
  assert_eq(list.range_step(0, 5, -1), [])
}

test "range_step aborts on a zero step" {
  testing.assert_aborts("step must not be 0", () => list.range_step(0, 5, 0))
}
