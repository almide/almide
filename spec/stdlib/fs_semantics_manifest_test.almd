import env
import fs

test "fs.file_size unit=byte-count" {
  let p = fs.create_temp_file("almide_manifest_file_size_")!
  fs.write_text(p, "aé")!
  let n = fs.file_size(p)!
  fs.remove(p)!
  assert_eq("${n}", "3")
}

test "fs.modified_at unit=second" {
  let p = fs.create_temp_file("almide_manifest_modified_at_")!
  let now = env.unix_timestamp()
  let mt = fs.modified_at(p)!
  fs.remove(p)!
  assert_eq("${mt > now - 300 and mt < now + 300}", "true")
}
