// GENERATED by scripts/check-semantics-manifest.sh from
// docs/stdlib/semantics-manifest.toml — DO NOT EDIT (the gate
// regenerates and diffs). Each case executes a manifest probe; a
// failure here means the implementation drifted from the DECLARED
// semantic dimension (#419 class).
import env
import fs

test "fs.read_bytes unit=byte-value" {
  let p = fs.create_temp_file("almide_manifest_read_bytes_")!
  fs.write(p, "aé")!
  let bs = fs.read_bytes(p)!
  fs.remove(p)!
  assert_eq("${bs}", "[97, 195, 169]")
}

test "fs.write_bytes unit=byte-value" {
  let p = fs.create_temp_file("almide_manifest_write_bytes_")!
  fs.write_bytes(p, [0, 65, 255])!
  let bs = fs.read_bytes(p)!
  fs.remove(p)!
  assert_eq("${bs}", "[0, 65, 255]")
}

test "fs.read_bytes_if_exists unit=byte-value" {
  let p = fs.create_temp_file("almide_manifest_read_bytes_if_exists_")!
  fs.write_bytes(p, [1, 2])!
  let hit = fs.read_bytes_if_exists(p)!
  fs.remove(p)!
  let miss = fs.read_bytes_if_exists(p)!
  assert_eq("${(hit ?? []) + (miss ?? [])}", "[1, 2]")
}

test "fs.file_size unit=byte-count" {
  let p = fs.create_temp_file("almide_manifest_file_size_")!
  fs.write(p, "aé")!
  let n = fs.file_size(p)!
  fs.remove(p)!
  assert_eq("${n}", "3")
}

test "fs.modified_at unit=second" {
  let p = fs.create_temp_file("almide_manifest_modified_at_")!
  let now = env.unix_timestamp()
  let mt = fs.modified_at(p)!
  fs.remove(p)!
  assert_eq("${mt > now - 300 and mt < now + 300}", "true")
}
