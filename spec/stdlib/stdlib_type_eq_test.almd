// #4383: `==` / `!=` on a stdlib-declared type built by a module-qualified
// constructor. Runs on both legs (`almide test --target wasm` lowers it).
import net
import regex
import url

test "eq on a Result of a stdlib variant" {
  assert_eq(net.parse_ip("1.2.3.4"), ok(net.V4(1, 2, 3, 4)))
}

test "eq and ne on a bare stdlib variant" {
  let a = net.parse_ip("::1") ?? net.V4(0, 0, 0, 0)
  assert(a == net.V6([
    0,
    0,
    0,
    0,
    0,
    0,
    0,
    1
  ]))
  assert(a != net.V4(0, 0, 0, 0))
}

test "eq on a stdlib variant inside an Option and a List" {
  let o: net.IpAddr? = some(net.V4(127, 0, 0, 1))
  assert_eq(o, some(net.V4(127, 0, 0, 1)))
  assert_ne(o, none)
  let xs = [
    net.V4(10, 0, 0, 1),
    net.V6([
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
    ])
  ]
  assert_eq(
    xs,
    [
      net.V4(10, 0, 0, 1),
      net.V6([
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ])
    ],
  )
  assert_ne(xs, [
    net.V4(10, 0, 0, 1)
  ])
}

test "eq on stdlib records" {
  assert_eq(url.parse("http://a/b?c=1"), url.parse("http://a/b?c=1"))
  assert_ne(url.parse("http://a/b"), url.parse("http://a/c"))
  assert_eq(regex.new("a+"), regex.new("a+"))
  assert_ne(some(regex.new("a+")), some(regex.new("b")))
}
