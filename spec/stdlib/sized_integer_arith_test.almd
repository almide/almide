// The Integer requirements on the eight fixed-width integer types (R-sized-02 compare,
// R-sized-08 min/max/clamp, R-sized-10 floor_div/pow/is_even/is_odd/abs/sign). The
// SHAPE (every type has every cell) is the numeric protocol matrix gate in
// `almide docs-gen --check`; this file pins the semantics at the edges: unsigned order
// in the upper half, the four sign quadrants of floor_div, wrapping like `*`, and the
// aborts (b == 0, lo > hi, exp < 0).
import testing

fn i8(n: Int) -> Int8 = int.to_int8(n)

fn i16(n: Int) -> Int16 = int.to_int16(n)

fn i32(n: Int) -> Int32 = int.to_int32(n)

fn i64(n: Int) -> Int64 = int.to_int64(n)

fn u8(n: Int) -> UInt8 = int.to_uint8(n)

fn u16(n: Int) -> UInt16 = int.to_uint16(n)

fn u32(n: Int) -> UInt32 = int.to_uint32(n)

fn u64(n: Int) -> UInt64 = int.to_uint64(n)

// ── compare / min / max ──
test "signed compare, min and max" {
  assert_eq(int8.compare(i8(-5), i8(3)), -1)
  assert_eq(int8.compare(i8(3), i8(3)), 0)
  assert_eq(int8.compare(i8(3), i8(-5)), 1)
  assert_eq(int8.min(i8(-5), i8(3)), i8(-5))
  assert_eq(int8.max(i8(-5), i8(3)), i8(3))
  assert_eq(int16.compare(i16(-32768), i16(32767)), -1)
  assert_eq(int16.min(i16(-32768), i16(32767)), i16(-32768))
  assert_eq(int16.max(i16(-32768), i16(32767)), i16(32767))
  assert_eq(int32.compare(i32(7), i32(-7)), 1)
  assert_eq(int32.min(i32(7), i32(-7)), i32(-7))
  assert_eq(int32.max(i32(7), i32(-7)), i32(7))
  assert_eq(int64.compare(int64.min_value(), int64.max_value()), -1)
  assert_eq(int64.compare(i64(4), i64(4)), 0)
  assert_eq(int64.min(int64.min_value(), i64(0)), int64.min_value())
  assert_eq(int64.max(int64.min_value(), i64(0)), i64(0))
}

test "unsigned compare reads the top bit as magnitude" {
  assert_eq(uint8.compare(u8(200), u8(100)), 1)
  assert_eq(uint8.min(u8(200), u8(100)), u8(100))
  assert_eq(uint8.max(u8(200), u8(100)), u8(200))
  assert_eq(uint16.compare(u16(65535), u16(1)), 1)
  assert_eq(uint16.min(u16(65535), u16(1)), u16(1))
  assert_eq(uint16.max(u16(65535), u16(1)), u16(65535))
  assert_eq(uint32.compare(u32(0), u32(4294967295)), -1)
  assert_eq(uint32.min(u32(0), u32(4294967295)), u32(0))
  assert_eq(uint32.max(u32(0), u32(4294967295)), u32(4294967295))
  // 2^64-1 is above 1, though its Int reinterpretation is -1
  assert_eq(uint64.compare(uint64.max_value(), u64(1)), 1)
  assert_eq(uint64.compare(u64(1), uint64.max_value()), -1)
  assert_eq(uint64.compare(uint64.max_value(), uint64.max_value()), 0)
  assert_eq(uint64.min(uint64.max_value(), u64(1)), u64(1))
  assert_eq(uint64.max(uint64.max_value(), u64(1)), uint64.max_value())
}

// ── clamp ──
test "clamp limits to lo..hi on every type" {
  assert_eq(int8.clamp(i8(100), i8(-10), i8(10)), i8(10))
  assert_eq(int8.clamp(i8(-100), i8(-10), i8(10)), i8(-10))
  assert_eq(int8.clamp(i8(5), i8(-10), i8(10)), i8(5))
  assert_eq(int16.clamp(i16(-300), i16(-200), i16(200)), i16(-200))
  assert_eq(int32.clamp(i32(300), i32(-200), i32(200)), i32(200))
  assert_eq(int64.clamp(int64.max_value(), i64(0), i64(9)), i64(9))
  assert_eq(uint8.clamp(u8(250), u8(10), u8(200)), u8(200))
  assert_eq(uint16.clamp(u16(3), u16(10), u16(200)), u16(10))
  assert_eq(uint32.clamp(u32(4294967295), u32(0), u32(70000)), u32(70000))
  // the upper half orders above the lower half
  assert_eq(uint64.clamp(uint64.max_value(), u64(5), u64(-2)), u64(-2))
  assert_eq(uint64.clamp(u64(1), u64(5), u64(-2)), u64(5))
  assert_eq(uint64.clamp(u64(-3), u64(5), u64(-2)), u64(-3))
}

test "clamp aborts when lo > hi" {
  testing.assert_aborts(
    "clamp requires min <= max",
    () => int8.clamp(int.to_int8(0), int.to_int8(5), int.to_int8(1)),
  )
  testing.assert_aborts(
    "clamp requires min <= max",
    () => uint32.clamp(int.to_uint32(0), int.to_uint32(5), int.to_uint32(1)),
  )
  // lo = 2^64-1 is above hi = 2, whatever its Int reinterpretation says
  testing.assert_aborts(
    "clamp requires min <= max",
    () => uint64.clamp(int.to_uint64(1), int.to_uint64(-1), int.to_uint64(2)),
  )
}

// ── floor_div ──
test "floor_div rounds toward -inf in all four sign quadrants" {
  assert_eq(int8.floor_div(i8(7), i8(2)), i8(3))
  assert_eq(int8.floor_div(i8(-7), i8(2)), i8(-4))
  assert_eq(int8.floor_div(i8(7), i8(-2)), i8(-4))
  assert_eq(int8.floor_div(i8(-7), i8(-2)), i8(3))
  assert_eq(int8.floor_div(i8(6), i8(-3)), i8(-2))
  assert_eq(int16.floor_div(i16(-7), i16(2)), i16(-4))
  assert_eq(int32.floor_div(i32(7), i32(-2)), i32(-4))
  assert_eq(int64.floor_div(i64(-7), i64(2)), i64(-4))
  assert_eq(int64.floor_div(i64(-7), i64(-2)), i64(3))
}

test "floor_div of min_value by -1 wraps like the type's arithmetic" {
  assert_eq(int8.floor_div(int8.min_value(), i8(-1)), int8.min_value())
  assert_eq(int16.floor_div(int16.min_value(), i16(-1)), int16.min_value())
  assert_eq(int32.floor_div(int32.min_value(), i32(-1)), int32.min_value())
  assert_eq(int64.floor_div(int64.min_value(), i64(-1)), int64.min_value())
  assert_eq(int8.floor_div(i8(5), i8(-1)), i8(-5))
}

test "unsigned floor_div is plain division, the upper half included" {
  assert_eq(uint8.floor_div(u8(200), u8(7)), u8(28))
  assert_eq(uint16.floor_div(u16(65535), u16(256)), u16(255))
  assert_eq(uint32.floor_div(u32(4294967295), u32(2)), u32(2147483647))
  assert_eq(uint64.to_string(uint64.floor_div(uint64.max_value(), u64(10))), "1844674407370955161")
  assert_eq(uint64.to_string(uint64.floor_div(uint64.max_value(), u64(2))), "9223372036854775807")
}

test "floor_div by zero aborts" {
  testing.assert_aborts("division by zero", () => int8.floor_div(int.to_int8(5), int.to_int8(0)))
  testing.assert_aborts("division by zero", () => int64.floor_div(int.to_int64(5), int.to_int64(0)))
  testing.assert_aborts(
    "division by zero",
    () => uint64.floor_div(int.to_uint64(5), int.to_uint64(0)),
  )
}

// ── pow ──
test "pow wraps to the type's width like *" {
  assert_eq(int8.pow(i8(3), 4), i8(81))
  assert_eq(int8.pow(i8(2), 7), i8(-128))
  assert_eq(int8.pow(i8(2), 8), i8(0))
  assert_eq(int8.pow(i8(-2), 3), i8(-8))
  assert_eq(int8.pow(i8(5), 0), i8(1))
  assert_eq(int16.pow(i16(2), 15), i16(-32768))
  assert_eq(int32.pow(i32(2), 31), i32(-2147483648))
  assert_eq(int64.pow(i64(2), 63), int64.min_value())
  assert_eq(int64.pow(i64(3), 40), i64(-6289078614652622815))
  assert_eq(uint8.pow(u8(3), 5), u8(243))
  assert_eq(uint8.pow(u8(2), 8), u8(0))
  assert_eq(uint16.pow(u16(2), 16), u16(0))
  assert_eq(uint32.pow(u32(2), 32), u32(0))
  assert_eq(uint64.to_string(uint64.pow(u64(2), 63)), "9223372036854775808")
  assert_eq(uint64.to_string(uint64.pow(u64(3), 40)), "12157665459056928801")
}

test "pow with a negative exponent aborts" {
  testing.assert_aborts("negative exponent", () => int8.pow(int.to_int8(2), -1))
  testing.assert_aborts("negative exponent", () => uint64.pow(int.to_uint64(2), -1))
}

// ── parity ──
test "is_even and is_odd on every type" {
  assert_eq(int8.is_even(i8(-4)), true)
  assert_eq(int8.is_odd(i8(-3)), true)
  assert_eq(int8.is_even(i8(0)), true)
  assert_eq(int8.is_odd(int8.min_value()), false)
  assert_eq(int16.is_odd(i16(32767)), true)
  assert_eq(int32.is_even(i32(-2)), true)
  assert_eq(int64.is_odd(int64.max_value()), true)
  assert_eq(int64.is_even(int64.min_value()), true)
  assert_eq(uint8.is_odd(u8(255)), true)
  assert_eq(uint16.is_even(u16(65534)), true)
  assert_eq(uint32.is_odd(u32(4294967295)), true)
  assert_eq(uint64.is_odd(uint64.max_value()), true)
  assert_eq(uint64.is_even(uint64.max_value()), false)
  assert_eq(uint64.is_even(u64(-2)), true)
}

// ── abs / sign (signed types) ──
test "abs is the magnitude; min_value wraps to itself" {
  assert_eq(int8.abs(i8(-5)), i8(5))
  assert_eq(int8.abs(i8(5)), i8(5))
  assert_eq(int8.abs(int8.min_value()), int8.min_value())
  assert_eq(int16.abs(int16.min_value()), int16.min_value())
  assert_eq(int16.abs(i16(-300)), i16(300))
  assert_eq(int32.abs(int32.min_value()), int32.min_value())
  assert_eq(int32.abs(i32(-70000)), i32(70000))
  assert_eq(int64.abs(int64.min_value()), int64.min_value())
  assert_eq(int64.abs(i64(-9)), i64(9))
}

test "sign is -1, 0 or 1" {
  assert_eq(int8.sign(i8(-5)), -1)
  assert_eq(int8.sign(i8(0)), 0)
  assert_eq(int8.sign(i8(7)), 1)
  assert_eq(int16.sign(int16.min_value()), -1)
  assert_eq(int32.sign(int32.max_value()), 1)
  assert_eq(int64.sign(int64.min_value()), -1)
  assert_eq(int64.sign(i64(0)), 0)
}
