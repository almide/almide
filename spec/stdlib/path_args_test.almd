// path / args — bundled-module coverage.
// Regression guard: `path.is_absolute` and `args.flag` were `?`-suffixed
// declarations that stopped parsing when trailing-`?` identifiers were
// removed; parser error-recovery silently dropped them and no test noticed.
import path
import args

test "path basics" {
  assert_eq(path.join("/usr", "bin"), "/usr/bin")
  assert_eq(path.dirname("/usr/bin/node"), "/usr/bin")
  assert_eq(path.basename("/usr/bin/node"), "node")
  assert_eq(path.extension("file.txt"), some("txt"))
  assert_eq(path.extension("Makefile"), none)
}

test "path.is_absolute" {
  assert_eq(path.is_absolute("/usr"), true)
  assert_eq(path.is_absolute("relative/path"), false)
}

test "args.flag on empty argv" {
  // The test harness runs with no program args: flag lookups must miss.
  assert_eq(args.flag("verbose"), false)
  assert_eq(args.option("output"), none)
  assert_eq(args.option_or("output", "out.txt"), "out.txt")
}
