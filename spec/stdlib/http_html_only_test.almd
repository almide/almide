// @contract: C-275
// Security row 11e: a response serves HTML only from SafeHtml. `http.html`
// is the one writer of an HTML Content-Type; a String header write naming an
// HTML media type aborts, and so does a non-empty String body written into a
// response that is already HTML. The header values here are computed (`ct`),
// so the check-time refusal (E115, which needs literals) stays out of the way
// and the run-time refusal is what runs. Every assertion holds on native and
// on wasm alike.
import html
import http
import testing

// A Content-Type value the checker cannot read as a literal.
fn ct(s: String) -> String = s

test "http.html serves SafeHtml as text/html, escaped" {
  let resp = http.html(200, html.escape("<script>alert(1)</script>"))
  assert_eq(http.header(resp, "Content-Type"), some("text/html; charset=utf-8"))
  assert_eq(http.body(resp), "&lt;script&gt;alert(1)&lt;/script&gt;")
}

test "set_header refuses an HTML Content-Type, in every spelling a browser reads as HTML" {
  testing.assert_aborts(
    "http.set_header: an HTML Content-Type is served only from SafeHtml",
    () => http.set_header(http.response(200, "<script>alert(1)</script>"), "Content-Type", ct("text/html")),
  )
  testing.assert_aborts(
    "http.set_header: an HTML Content-Type is served only from SafeHtml",
    () => http.set_header(http.response(200, "x"), "content-type", ct(" TEXT/HTML ; charset=utf-8")),
  )
  testing.assert_aborts(
    "http.set_header: an HTML Content-Type is served only from SafeHtml",
    () => http.set_header(http.response(200, "x"), "CONTENT-TYPE", ct("application/xhtml+xml")),
  )
  testing.assert_aborts(
    "http.set_header: an HTML Content-Type is served only from SafeHtml",
    () => http.set_header(http.response(200, "x"), "Content-Type", ct("text/plain, text/html")),
  )
  testing.assert_aborts(
    "http.set_header: an HTML Content-Type is served only from SafeHtml",
    () => http.set_header(http.html(200, html.escape("x")), "Content-Type", ct("text/html")),
  )
}

test "with_headers refuses an HTML Content-Type anywhere in its list" {
  testing.assert_aborts(
    "http.with_headers: an HTML Content-Type is served only from SafeHtml",
    () => http.with_headers(200, "<script>alert(1)</script>", [("Content-Type", ct("text/html"))]),
  )
  testing.assert_aborts(
    "http.with_headers: an HTML Content-Type is served only from SafeHtml",
    () => http.with_headers(200, "x", [("X-A", "1"), ("content-type", ct("text/html")), ("Content-Type", "text/plain")]),
  )
}

test "set_body refuses a String body on an HTML response" {
  testing.assert_aborts(
    "http.set_body: this response is text/html, so its body is SafeHtml",
    () => http.set_body(http.html(200, html.escape("x")), "<script>alert(1)</script>"),
  )
  testing.assert_aborts(
    "http.set_body: this response is text/html, so its body is SafeHtml",
    () => http.set_body_bytes(http.html(200, html.escape("x")), bytes.from_string("<script>alert(1)</script>")),
  )
}

test "control: the same writes with a media type that is not HTML pass" {
  let a = http.set_header(http.response(200, "<b>"), "Content-Type", ct("text/csv"))
  assert_eq(http.header(a, "Content-Type"), some("text/csv"))
  let b = http.with_headers(200, "<b>", [("Content-Type", ct("text/markdown; charset=utf-8"))])
  assert_eq(http.header(b, "content-type"), some("text/markdown; charset=utf-8"))
  let c = http.set_header(http.response(200, "<b>"), "X-Note", ct("text/html"))
  assert_eq(http.header(c, "X-Note"), some("text/html"))
  let d = http.set_body(http.response(200, "a"), "<b>")
  assert_eq(http.body(d), "<b>")
}

test "an HTML response keeps its other writes: headers, status and an empty body" {
  let page = http.html(200, html.escape("hi"))
  let tagged = http.set_status(http.set_header(page, "X-Frame-Options", "DENY"), 404)
  assert_eq(http.status(tagged), 404)
  assert_eq(http.header(tagged, "X-Frame-Options"), some("DENY"))
  assert_eq(http.body(http.set_body(tagged, "")), "")
}

test "a request is not served, so it may carry any Content-Type" {
  let req = http.set_header(http.new_request("POST", "/pages", "<p>draft</p>", []), "Content-Type", ct("text/html"))
  assert_eq(http.header(req, "Content-Type"), some("text/html"))
  assert_eq(http.body(http.set_body(req, "<p>v2</p>")), "<p>v2</p>")
}
