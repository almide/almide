// The set additions of the stdlib redesign (wave 1): `count` / `find` /
// `clear` (R-L0-37 Container cells, R-set) and the sequence algorithms
// (R-L0-42). A set walks its members in insertion order, so every fn here
// gives what the same-named list fn gives on `set.to_list(s)`. Each fn runs
// with Int and String members and meets the empty set.
local fn asc(a: Int, b: Int) -> Int = if a < b then -1
else if a > b then 1 else 0

local fn by_len(a: String, b: String) -> Int = string.len(a) - string.len(b)

test "count, find and clear" {
  let s = set.from_list([4, 1, 3, 2])
  assert_eq(set.count(s, (x) => x > 1), 3)
  assert_eq(set.find(s, (x) => x < 4), some(1))
  assert_eq(set.find(s, (x) => x > 9), none)
  let w = set.from_list(["b", "a", "cc"])
  assert_eq(set.count(w, (x) => string.len(x) == 1), 2)
  assert_eq(set.find(w, (x) => string.len(x) == 2), some("cc"))
  var m = set.from_list([1, 2, 3])
  set.clear(m)
  assert_eq(set.len(m), 0)
  m = set.insert(m, 9)
  assert_eq(set.to_list(m), [9])
  var ws = set.from_list(["x"])
  set.clear(ws)
  assert_eq(set.is_empty(ws), true)
  let e: Set[Int] = set.new()
  assert_eq(set.count(e, (x) => x > 0), 0)
  assert_eq(set.find(e, (x) => x > 0), none)
}

test "enumerate, zip and zip_with walk insertion order" {
  let s = set.from_list([3, 1, 3, 2])
  assert_eq(set.enumerate(s), [(0, 3), (1, 1), (2, 2)])
  assert_eq(set.zip(s, ["a", "b"]), [(3, "a"), (1, "b")])
  assert_eq(set.zip_with(s, [10, 20, 30, 40], (a, b) => a + b), [13, 21, 32])
  let w = set.from_list(["b", "a"])
  assert_eq(set.enumerate(w), [(0, "b"), (1, "a")])
  assert_eq(set.zip(w, [1, 2, 3]), [("b", 1), ("a", 2)])
  let e: Set[String] = set.new()
  assert_eq(set.enumerate(e), [])
  assert_eq(set.zip(e, [1]), [])
  assert_eq(set.zip_with(e, [1], (a, b) => a + int.to_string(b)), [])
}

test "filter_map, find_map, reduce and scan" {
  let s = set.from_list([1, 2, 3, 4])
  assert_eq(set.filter_map(s, (x) => if x % 2 == 0 then some(x * 10) else none), [20, 40])
  assert_eq(set.find_map(s, (x) => if x > 2 then some(x) else none), some(3))
  assert_eq(set.reduce(s, (a, b) => a + b), some(10))
  assert_eq(set.scan(s, 0, (a, b) => a + b), [1, 3, 6, 10])
  let w = set.from_list(["a", "bb", "c"])
  assert_eq(
    set.filter_map(w, (x) => if string.len(x) == 1 then some(x + "!") else none),
    ["a!", "c!"],
  )
  assert_eq(set.find_map(w, (x) => if string.len(x) == 2 then some(x) else none), some("bb"))
  assert_eq(set.reduce(w, (a, b) => a + b), some("abbc"))
  assert_eq(set.scan(w, "", (a, b) => a + b), ["a", "abb", "abbc"])
  let e: Set[Int] = set.new()
  assert_eq(set.filter_map(e, (x) => some(x)), [])
  assert_eq(set.find_map(e, (x) => some(x)), none)
  assert_eq(set.reduce(e, (a, b) => a + b), none)
  assert_eq(set.scan(e, 0, (a, b) => a + b), [])
}

test "partition and group_by" {
  let s = set.from_list([1, 2, 3, 4, 5])
  let r1 = set.partition(s, (x) => x % 2 == 1)
  assert_eq(r1.0, [1, 3, 5])
  assert_eq(r1.1, [2, 4])
  let g = set.group_by(s, (x) => x % 2)
  assert_eq(map.get(g, 1), some([1, 3, 5]))
  assert_eq(map.get(g, 0), some([2, 4]))
  let w = set.from_list(["aa", "b", "cc"])
  let r2 = set.partition(w, (x) => string.len(x) == 2)
  assert_eq(r2.0, ["aa", "cc"])
  assert_eq(r2.1, ["b"])
  assert_eq(map.keys(set.group_by(w, (x) => string.len(x))), [2, 1])
  let e: Set[String] = set.new()
  let r3 = set.partition(e, (x) => x == "")
  assert_eq(list.len(r3.0), 0)
  assert_eq(list.len(r3.1), 0)
  assert_eq(map.len(set.group_by(e, (x) => x)), 0)
}

test "sort, sort_by and sort_with" {
  let s = set.from_list([3, 1, 2])
  assert_eq(set.sort(s), [1, 2, 3])
  assert_eq(set.sort_by(s, (x) => 0 - x), [3, 2, 1])
  assert_eq(set.sort_with(s, asc), [1, 2, 3])
  let w = set.from_list(["ccc", "a", "bb", "b"])
  assert_eq(set.sort(w), ["a", "b", "bb", "ccc"])
  assert_eq(set.sort_by(w, (x) => string.len(x)), ["a", "b", "bb", "ccc"])
  assert_eq(set.sort_with(w, by_len), ["a", "b", "bb", "ccc"])
  let e: Set[Int] = set.new()
  assert_eq(set.sort(e), [])
  assert_eq(set.sort_by(e, (x) => x), [])
  assert_eq(set.sort_with(e, asc), [])
}

test "min, max and their _by / _with forms" {
  let s = set.from_list([3, -4, 4, 1])
  assert_eq(set.min(s), some(-4))
  assert_eq(set.max(s), some(4))
  assert_eq(set.min_by(s, (x) => x * x), some(1))
  assert_eq(set.max_by(s, (x) => x * x), some(-4))
  assert_eq(set.min_with(s, asc), some(-4))
  assert_eq(set.max_with(s, asc), some(4))
  let w = set.from_list(["bb", "a", "cc", "d"])
  assert_eq(set.min(w), some("a"))
  assert_eq(set.max(w), some("d"))
  assert_eq(set.min_by(w, (x) => string.len(x)), some("a"))
  assert_eq(set.max_by(w, (x) => string.len(x)), some("bb"))
  assert_eq(set.min_with(w, by_len), some("a"))
  assert_eq(set.max_with(w, by_len), some("bb"))
  let e: Set[String] = set.new()
  assert_eq(set.min(e), none)
  assert_eq(set.max(e), none)
  assert_eq(set.min_by(e, (x) => string.len(x)), none)
  assert_eq(set.max_by(e, (x) => string.len(x)), none)
  assert_eq(set.min_with(e, by_len), none)
  assert_eq(set.max_with(e, by_len), none)
}
