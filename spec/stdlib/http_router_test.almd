// @contract: C-368
// #2588 — http.router / route / mount / wrap / new_request / param /
// decode_json. A handler is a plain function from a request to a response,
// and so are a router and a wrapped app, so a whole app is tested by calling
// it with a request built in code: no socket. Every assertion here holds on
// native and on wasm alike.
import http

type User: Codec = { name: String, age: Int }

effect fn get_user(req: HttpRequest) -> HttpResponse = http.response(
  200,
  "user " + (http.param(req, "id") ?? "-"),
)

effect fn me(req: HttpRequest) -> HttpResponse = http.response(200, "me")

effect fn create_user(req: HttpRequest) -> HttpResponse = match http.decode_json(
  req,
  (v) => User.decode(v),
) {
  ok(u) => http.response(201, "${u.name}:${u.age}"),
  err(bad) => bad,
}

effect fn serve_file(req: HttpRequest) -> HttpResponse = http.response(
  200,
  "file " + (http.param(req, "path") ?? "-"),
)

effect fn any_health(req: HttpRequest) -> HttpResponse = http.response(
  200,
  "health " + http.req_method(req),
)

effect fn get_health(req: HttpRequest) -> HttpResponse = http.response(200, "get health")

effect fn echo(req: HttpRequest) -> HttpResponse = http.response(
  200,
  http.req_path(req) + " " + (http.param(req, "org") ?? "-"),
)

effect fn boom(req: HttpRequest) -> HttpResponse = {
  let n = int.parse("x")!
  http.response(200, "${n}")
}

effect fn app() -> HttpHandler = http.router([
  http.route("GET /users/{id}", get_user),
  http.route("GET /users/me", me),
  http.route("POST /users", create_user),
  http.route("GET /static/{path...}", serve_file),
  http.route("/health", any_health),
  http.route("GET /health", get_health),
  http.route("GET /boom", boom)
])!

fn req(method: String, target: String) -> HttpRequest = http.new_request(method, target, "", [:])

fn show(res: HttpResponse) -> String = "${http.status_code(res)} ${http.body(res)}"

// Each helper binds the response before reading it: the argument-position
// form `show(h(r)!)` traps on wasm today (#2658).
effect fn call(h: HttpHandler, method: String, target: String) -> String = {
  let res = h(req(method, target))!
  show(res)
}

effect fn call_body(h: HttpHandler, method: String, target: String, body: String) -> String = {
  let res = h(http.new_request(method, target, body, [:]))!
  show(res)
}

fn header_or_none(res: HttpResponse, name: String) -> String = http.get_header(res, name) ?? "(none)"

effect fn header_of(h: HttpHandler, method: String, target: String, name: String) -> String = {
  let res = h(req(method, target))!
  header_or_none(res, name)
}

effect fn fails(h: HttpHandler, target: String) -> Bool = match h(req("GET", target)) {
  ok(_) => false,
  err(_) => true,
}

fn tag(next: HttpHandler) -> HttpHandler = (r) => {
  let res = next(r)!
  http.set_header(res, "X-Trail", (http.get_header(res, "X-Trail") ?? "") + "a")
}

fn tag_b(next: HttpHandler) -> HttpHandler = (r) => {
  let res = next(r)!
  http.set_header(res, "X-Trail", (http.get_header(res, "X-Trail") ?? "") + "b")
}

// A middleware that answers without calling the handler it wraps.
fn deny(next: HttpHandler) -> HttpHandler = (r) => if http.req_header(r, "authorization") == none then http.response(
  401,
  "no token",
)
else next(r)!

effect fn refusal(routes: List[HttpRoute]) -> String = match http.router(routes) {
  ok(_) => "accepted",
  err(e) => e,
}

test "a request built in code answers every reader" {
  let r = http.new_request("PUT", "/a/b?k=v&k=w&e=%20x", "payload", ["X-Token": "t1"])
  assert_eq(http.req_method(r), "PUT")
  assert_eq(http.req_path(r), "/a/b?k=v&k=w&e=%20x")
  assert_eq(http.req_body(r), "payload")
  assert_eq(http.req_header(r, "x-token"), some("t1"))
  assert_eq(http.req_header(r, "X-Other"), none)
  assert_eq(map.get(http.query_params(r), "k"), some("w"))
  assert_eq(map.get(http.query_params(r), "e"), some(" x"))
  assert_eq(http.param(r, "id"), none)
}

test "a {name} segment binds its percent-decoded value, a plus stays a plus" {
  let h = app()!
  assert_eq(call(h, "GET", "/users/42")!, "200 user 42")
  assert_eq(call(h, "GET", "/users/a%20b+c")!, "200 user a b+c")
}

test "the most specific route wins, whatever the order" {
  let h = app()!
  assert_eq(call(h, "GET", "/users/me")!, "200 me")
  assert_eq(call(h, "GET", "/health")!, "200 get health")
  assert_eq(call(h, "POST", "/health")!, "200 health POST")
}

test "a trailing {name...} binds the rest of the path" {
  let h = app()!
  assert_eq(call(h, "GET", "/static/css/site.css")!, "200 file css/site.css")
  assert_eq(call(h, "GET", "/static")!, "200 file ")
}

test "matching ignores the query string and a trailing slash" {
  let h = app()!
  assert_eq(call(h, "GET", "/users/9?verbose=1")!, "200 user 9")
  assert_eq(call(h, "GET", "/users/9/")!, "200 user 9")
}

test "a path no route matches is 404" {
  let h = app()!
  assert_eq(call(h, "GET", "/nope")!, "404 Not Found")
  assert_eq(call(h, "GET", "/users/1/extra")!, "404 Not Found")
}

test "a path matched only under other methods is 405 with Allow" {
  let h = app()!
  assert_eq(call(h, "DELETE", "/users/1")!, "405 Method Not Allowed")
  assert_eq(header_of(h, "DELETE", "/users/1", "Allow")!, "GET, HEAD")
  assert_eq(header_of(h, "PUT", "/users", "Allow")!, "POST")
  assert_eq(header_of(h, "GET", "/users/1", "Allow")!, "(none)")
}

test "HEAD answers through the GET route without the body" {
  let h = app()!
  assert_eq(call(h, "HEAD", "/users/7")!, "200 ")
  assert_eq(header_of(h, "HEAD", "/users/7", "Content-Type")!, "text/plain")
}

test "bad input is a 400, not a 500" {
  let h = app()!
  assert_eq(
    call(h, "GET", "/users/%zz")!,
    "400 Bad Request: malformed percent-encoding in the path",
  )
  assert_eq(call(h, "GET", "users/1")!, "400 Bad Request: the request target must start with /")
  assert_eq(
    call_body(h, "POST", "/users", "{\"name\":1,\"age\":2}")!,
    "400 Bad Request: expected Str, received Int, at name",
  )
  assert_eq(
    call_body(h, "POST", "/users", "not json")!,
    "400 Bad Request: the body is not JSON (expected null)",
  )
  assert_eq(call_body(h, "POST", "/users", "{\"name\":\"ann\",\"age\":3}")!, "201 ann:3")
}

test "a handler err stays an err: serve turns it into its 500" {
  let h = app()!
  assert_eq(fails(h, "/boom")!, true)
  assert_eq(fails(h, "/users/1")!, false)
}

test "overlapping routes with no most specific one are refused" {
  assert_eq(
    refusal([http.route("GET /a/{x}", me), http.route("GET /{y}/b", me)])!,
    "http.router: \"GET /a/{x}\" and \"GET /{y}/b\" conflict",
  )
  assert_eq(
    refusal([http.route("GET /x", me), http.route("GET  /x", me)])!,
    "http.router: \"GET /x\" and \"GET  /x\" conflict",
  )
  assert_eq(refusal([http.route("GET /x/{a}", me), http.route("POST /x/{b}", me)])!, "accepted")
}

test "a malformed pattern is refused" {
  assert_eq(
    refusal([http.route("GET /files/{rest...}/raw", me)])!,
    "http.router: \"GET /files/{rest...}/raw\": a segment is a literal, {name} or a last {name...}",
  )
  assert_eq(
    refusal([http.route("get /x", me)])!,
    "http.router: \"get /x\": the method must be upper-case letters",
  )
  assert_eq(
    refusal([http.route("GET x", me)])!,
    "http.router: \"GET x\": the path must start with /",
  )
  assert_eq(
    refusal([http.route("GET /{a}/{a}", me)])!,
    "http.router: \"GET /{a}/{a}\": a name is bound twice",
  )
  assert_eq(
    refusal([http.route("GET /{}", me)])!,
    "http.router: \"GET /{}\": a segment is a literal, {name} or a last {name...}",
  )
}

test "mount hands the rest of the path and the query to a sub-app" {
  let api = http.router([http.route("GET /items/{id}", echo)])!
  let root = http.router([http.mount("/api", api), http.route("GET /api/version", me)])!
  assert_eq(call(root, "GET", "/api/items/a%2Fb?t=1")!, "200 /items/a%2Fb?t=1 -")
  assert_eq(call(root, "GET", "/api/version")!, "200 me")
  assert_eq(call(root, "GET", "/api/nope")!, "404 Not Found")
}

test "a mount's own parameters stay visible to the sub-app" {
  let repos = http.router([http.route("GET /repos", echo)])!
  let root = http.router([http.mount("/orgs/{org}", repos)])!
  assert_eq(call(root, "GET", "/orgs/almide/repos")!, "200 /repos almide")
}

test "middleware composes, the first in the list outermost" {
  let h = http.wrap(app()!, [tag, tag_b])
  let res = h(req("GET", "/users/1"))!
  assert_eq(http.get_header(res, "X-Trail"), some("ba"))
  assert_eq(http.body(res), "user 1")
  let bare = http.wrap(app()!, [])
  assert_eq(http.get_header(bare(req("GET", "/users/1"))!, "X-Trail"), none)
}

test "a middleware can answer without calling the handler" {
  let h = http.wrap(app()!, [deny])
  assert_eq(call(h, "GET", "/users/1")!, "401 no token")
  let res = h(http.new_request("GET", "/users/1", "", ["Authorization": "t"]))!
  assert_eq(http.body(res), "user 1")
}
