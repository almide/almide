test "bytes.cmp unit=ordering" {
  let sm_out = "${bytes.cmp(bytes.from_list([1, 2]), bytes.from_list([1, 3]))} ${bytes.cmp(bytes.from_list([1, 2]), bytes.from_list([1, 2]))} ${bytes.cmp(bytes.from_list([1, 3]), bytes.from_list([1, 2]))}"
  assert_eq("${sm_out}", "-1 0 1")
}

test "bytes.copy_from unit=byte-offset" {
  var dst = bytes.new(4)
  bytes.copy_from(dst, bytes.from_list([9, 8, 7, 6]), 1, 2, 2)
  assert_eq("${bytes.to_list(dst)}", "[0, 7, 6, 0]")
}

test "bytes.copy_to_ptr unit=byte-count" {
  var dst = bytes.new(4)
  let n = bytes.copy_to_ptr(bytes.from_list([9, 8, 7]), bytes.as_mut_ptr(dst), 2)
  let sm_out = "${n} ${bytes.to_list(dst)}"
  assert_eq("${sm_out}", "2 [9, 8, 0, 0]")
}

test "bytes.data_ptr unit=address" {
  assert_eq("${bytes.data_ptr(bytes.from_list([1])) != 0}", "true")
}

test "bytes.eof unit=byte-offset" {
  let b8 = bytes.from_list([
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ])
  let sm_out = "${bytes.eof(b8, 7)} ${bytes.eof(b8, 8)}"
  assert_eq("${sm_out}", "false true")
}

