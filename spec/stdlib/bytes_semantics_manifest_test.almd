test "bytes.read_bool unit=byte-offset" {
  let bb = bytes.from_list([0, 1, 2])
  let sm_out = "${bytes.read_bool(bb, 0)} ${bytes.read_bool(bb, 1)} ${bytes.read_bool(bb, 2)}"
  assert_eq("${sm_out}", "false true true")
}

test "bytes.read_length_prefixed_strings_le unit=element-count" {
  var b = bytes.new(0)
  bytes.append_u32_le(b, 1)
  bytes.append_u8(b, 65)
  bytes.append_u32_le(b, 2)
  bytes.append_u8(b, 66)
  bytes.append_u8(b, 67)
  assert_eq("${bytes.read_length_prefixed_strings_le(b, 0, 2) |> list.join(",")}", "A,BC")
}

test "bytes.read_string_at unit=byte-count" {
  assert_eq("${bytes.read_string_at(bytes.from_string("héllo"), 1, 2)}", "é")
}

test "bytes.read_string_be unit=byte-offset" {
  var b = bytes.new(0)
  bytes.write_string_be(b, "hi")
  assert_eq("${bytes.read_string_be(b, 0)}", "hi")
}

test "bytes.remove_at unit=byte-offset" {
  assert_eq("${bytes.to_list(bytes.remove_at(bytes.from_list([1, 2, 3]), 1))}", "[1, 3]")
}

test "bytes.repeat unit=count" {
  assert_eq("${bytes.to_list(bytes.repeat(bytes.from_list([1, 2]), 3))}", "[1, 2, 1, 2, 1, 2]")
}

test "bytes.set unit=byte-offset" {
  let a = bytes.from_list([1, 2])
  let c = bytes.set(a, 0, 9)
  let sm_out = "${bytes.to_list(a)} ${bytes.to_list(c)}"
  assert_eq("${sm_out}", "[1, 2] [9, 2]")
}

test "bytes.set_f32_be unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_f32_be(b, 1, 1.5)
  assert_eq("${bytes.to_list(b)}", "[0, 63, 192, 0, 0, 0]")
}

test "bytes.set_f32_le unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_f32_le(b, 1, 1.5)
  assert_eq("${bytes.to_list(b)}", "[0, 0, 0, 192, 63, 0]")
}

test "bytes.set_f64_be unit=byte-offset" {
  var b = bytes.new(10)
  bytes.set_f64_be(b, 1, 1.5)
  assert_eq("${bytes.to_list(b)}", "[0, 63, 248, 0, 0, 0, 0, 0, 0, 0]")
}

test "bytes.set_f64_le unit=byte-offset" {
  var b = bytes.new(10)
  bytes.set_f64_le(b, 1, 1.5)
  assert_eq("${bytes.to_list(b)}", "[0, 0, 0, 0, 0, 0, 0, 248, 63, 0]")
}

test "bytes.set_i16_be unit=byte-offset" {
  var b = bytes.new(4)
  bytes.set_i16_be(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 254, 0]")
}

test "bytes.set_i16_le unit=byte-offset" {
  var b = bytes.new(4)
  bytes.set_i16_le(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 254, 255, 0]")
}

test "bytes.set_i32_be unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_i32_be(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 255, 255, 254, 0]")
}

test "bytes.set_i32_le unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_i32_le(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 254, 255, 255, 255, 0]")
}

test "bytes.set_i64_be unit=byte-offset" {
  var b = bytes.new(10)
  bytes.set_i64_be(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 255, 255, 255, 255, 255, 255, 254, 0]")
}

test "bytes.set_i64_le unit=byte-offset" {
  var b = bytes.new(10)
  bytes.set_i64_le(b, 1, -2)
  assert_eq("${bytes.to_list(b)}", "[0, 254, 255, 255, 255, 255, 255, 255, 255, 0]")
