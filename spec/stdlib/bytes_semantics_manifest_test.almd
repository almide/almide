test "bytes.set_u16_be unit=byte-offset" {
  var b = bytes.new(4)
  bytes.set_u16_be(b, 1, 65534)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 254, 0]")
}

test "bytes.set_u16_le unit=byte-offset" {
  var b = bytes.new(4)
  bytes.set_u16_le(b, 1, 65534)
  assert_eq("${bytes.to_list(b)}", "[0, 254, 255, 0]")
}

test "bytes.set_u32_be unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_u32_be(b, 1, 4294967294)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 255, 255, 254, 0]")
}

test "bytes.set_u32_le unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_u32_le(b, 1, 4294967294)
  assert_eq("${bytes.to_list(b)}", "[0, 254, 255, 255, 255, 0]")
}

test "bytes.set_u8 unit=byte-offset" {
  var b = bytes.new(3)
  bytes.set_u8(b, 1, 200)
  assert_eq("${bytes.to_list(b)}", "[0, 200, 0]")
}

test "bytes.skip unit=cursor" {
  let b8 = bytes.from_list([
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ])
  let sm_out = "${bytes.skip(b8, 2, 3)} ${bytes.skip(b8, 6, 5)}"
  assert_eq("${sm_out}", "5 8")
}

test "bytes.skip_length_prefixed_le unit=cursor" {
  var b = bytes.new(0)
  bytes.append_u32_le(b, 1)
  bytes.append_u8(b, 65)
  bytes.append_u32_le(b, 2)
  bytes.append_u8(b, 66)
  bytes.append_u8(b, 67)
  assert_eq("${bytes.skip_length_prefixed_le(b, 0, 2)}", "11")
}

test "bytes.slice unit=byte-offset" {
  assert_eq("${bytes.to_list(bytes.slice(bytes.from_list([
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ]), 2, 5))}", "[3, 4, 5]")
}

test "bytes.take_at unit=cursor" {
  let (p, t) = bytes.take_at(bytes.from_list([
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ]), 2, 3)
  let ts = match t {
    some(v) => v,
    none => bytes.new(0),
  }
  let sm_out = "${p} ${bytes.to_list(ts)}"
  assert_eq("${sm_out}", "5 [3, 4, 5]")
}

test "bytes.to_list unit=byte-value" {
  assert_eq("${bytes.to_list(bytes.from_list([200, 255]))}", "[200, 255]")
}

test "bytes.write_i64_be unit=value" {
  var b = bytes.new(0)
  bytes.write_i64_be(b, 258)
  assert_eq("${bytes.to_list(b)}", "[0, 0, 0, 0, 0, 0, 1, 2]")
}

test "bytes.write_u32_be unit=value" {
  var b = bytes.new(0)
  bytes.write_u32_be(b, 258)
  assert_eq("${bytes.to_list(b)}", "[0, 0, 1, 2]")
}

test "bytes.write_u8 unit=value" {
  var b = bytes.new(0)
  bytes.write_u8(b, 200)
  assert_eq("${bytes.to_list(b)}", "[200]")
}

test "bytes.heap_save unit=address" {
  let cp1 = bytes.heap_save()
  let _spacer = bytes.new(64)
  let cp2 = bytes.heap_save()
  assert_eq("${cp2 >= cp1}", "true")
}

test "bytes.heap_restore unit=address" {
  let cp = bytes.heap_save()
  let _spacer = bytes.new(64)
  bytes.heap_restore(cp)
  let after = bytes.from_list([5, 6])
  assert_eq("${bytes.to_list(after)}", "[5, 6]")
}

test "bytes.read_uint16 unit=value" {
  let tb = bytes.from_list([1, 2, 3, 4])
  let sm_out = "${bytes.read_uint16(tb, 0, BigEndian).to_int64()} ${bytes.read_uint16(tb, 0, LittleEndian).to_int64()}"
  assert_eq("${sm_out}", "258 513")
}

test "bytes.read_uint32 unit=value" {
  let tb = bytes.from_list([1, 2, 3, 4])
  let sm_out = "${bytes.read_uint32(tb, 0, BigEndian).to_int64()} ${bytes.read_uint32(tb, 0, LittleEndian).to_int64()}"
  assert_eq("${sm_out}", "16909060 67305985")
}

test "bytes.read_int32 unit=value" {
  let nb = bytes.from_list([255, 255, 255, 254])
  assert_eq("${bytes.read_int32(nb, 0, BigEndian).to_int64()}", "-2")
}

test "bytes.read_float32 unit=value" {
  var fb = bytes.new(4)
  bytes.set_f32_be(fb, 0, 1.5)
  let fv = bytes.read_float32(fb, 0, BigEndian).to_float64()
  assert_eq("${float.to_string(fv)}", "1.5")
}

test "bytes.set_uint16 unit=byte-offset" {
  var b = bytes.new(4)
  bytes.set_uint16(b, 1, (258).to_uint16(), BigEndian)
  assert_eq("${bytes.to_list(b)}", "[0, 1, 2, 0]")
}

test "bytes.set_uint32 unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_uint32(b, 1, (258).to_uint32(), BigEndian)
  assert_eq("${bytes.to_list(b)}", "[0, 0, 0, 1, 2, 0]")
}

test "bytes.set_int32 unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_int32(b, 1, (-2).to_int32(), BigEndian)
  assert_eq("${bytes.to_list(b)}", "[0, 255, 255, 255, 254, 0]")
}

test "bytes.set_float32 unit=byte-offset" {
  var b = bytes.new(6)
  bytes.set_float32(b, 1, 1.5.to_float32(), BigEndian)
  assert_eq("${bytes.to_list(b)}", "[0, 63, 192, 0, 0, 0]")
}
