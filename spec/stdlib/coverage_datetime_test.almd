// Coverage tests for datetime functions
import datetime

test "datetime.add_days" {
  let d = 0
  let d2 = datetime.add_days(d, 1)
  assert_eq(d2, 86400)
}

test "datetime.add_hours" {
  let d = 0
  let d2 = datetime.add_hours(d, 2)
  assert_eq(d2, 7200)
}

test "datetime.add_minutes" {
  let d = 0
  let d2 = datetime.add_minutes(d, 30)
  assert_eq(d2, 1800)
}

test "datetime.add_seconds" {
  let d = 0
  let d2 = datetime.add_seconds(d, 45)
  assert_eq(d2, 45)
}

test "datetime.now returns positive timestamp" {
  let ts = datetime.now()
  assert(ts > 0)
}

// The ORIGIN is unspecified and target-dependent (native counts from the first
// call, WASI from its own epoch), so only these two properties are asserted —
// they are the whole documented contract.
test "datetime.monotonic_ns never goes backwards" {
  let a = datetime.monotonic_ns()
  let b = datetime.monotonic_ns()
  assert(a >= 0)
  assert(b >= a)
}
