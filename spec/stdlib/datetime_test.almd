import datetime

// datetime module tests — pure functions with runtime implementations only
test "datetime.from_parts basic" {
  let ts = datetime.from_parts(2024, 1, 15, 12, 0, 0)
  assert_eq(datetime.year(ts), 2024)
  assert_eq(datetime.month(ts), 1)
  assert_eq(datetime.day(ts), 15)
}

test "datetime.from_parts midnight" {
  let ts = datetime.from_parts(2024, 6, 1, 0, 0, 0)
  assert_eq(datetime.hour(ts), 0)
  assert_eq(datetime.minute(ts), 0)
  assert_eq(datetime.second(ts), 0)
}

test "datetime.from_parts end of day" {
  let ts = datetime.from_parts(2024, 12, 31, 23, 59, 59)
  assert_eq(datetime.hour(ts), 23)
  assert_eq(datetime.minute(ts), 59)
  assert_eq(datetime.second(ts), 59)
}

test "datetime.year 2000" {
  let ts = datetime.from_parts(2000, 1, 1, 0, 0, 0)
  assert_eq(datetime.year(ts), 2000)
}

test "datetime.month extraction" {
  let ts = datetime.from_parts(2024, 7, 15, 12, 0, 0)
  assert_eq(datetime.month(ts), 7)
}

test "datetime.day extraction" {
  let ts = datetime.from_parts(2024, 3, 25, 12, 0, 0)
  assert_eq(datetime.day(ts), 25)
}

test "datetime.hour extraction" {
  let ts = datetime.from_parts(2024, 1, 1, 15, 30, 0)
  assert_eq(datetime.hour(ts), 15)
}

test "datetime.minute extraction" {
  let ts = datetime.from_parts(2024, 1, 1, 0, 45, 0)
  assert_eq(datetime.minute(ts), 45)
}

test "datetime.second extraction" {
  let ts = datetime.from_parts(2024, 1, 1, 0, 0, 33)
  assert_eq(datetime.second(ts), 33)
}

test "datetime.to_iso roundtrip" {
  let ts = datetime.from_parts(2024, 1, 15, 12, 0, 0)
  let iso = datetime.to_iso(ts)
  assert_eq(string.contains(iso, "2024"), true)
  assert_eq(string.contains(iso, "15"), true)
}

test "datetime.format substitutes strftime specifiers" {
  let ts = datetime.from_parts(2024, 3, 5, 13, 7, 9)
  assert_eq(datetime.format(ts, "%Y-%m-%d"), "2024-03-05")
  assert_eq(datetime.format(ts, "%H:%M:%S"), "13:07:09")
  assert_eq(datetime.format(ts, "%Y-%m-%dT%H:%M:%SZ"), "2024-03-05T13:07:09Z")
  // '%' is only special before a recognized specifier; '%%' / '%q' pass through.
  assert_eq(datetime.format(ts, "%Y%% %q"), "2024%% %q")
}

test "datetime.weekday returns string" {
  let ts = datetime.from_parts(2024, 1, 15, 0, 0, 0)
  let wd = datetime.weekday(ts)
  assert_eq(string.len(wd) > 0, true)
}

test "datetime.weekday Monday" {
  let ts = datetime.from_parts(2024, 1, 15, 0, 0, 0)
  assert_eq(datetime.weekday(ts), "Monday")
}

test "datetime.parse_iso valid" {
  match datetime.parse_iso("2024-01-15T12:00:00Z") {
    ok(ts) => {
      assert_eq(datetime.year(ts), 2024)
      assert_eq(datetime.month(ts), 1)
      assert_eq(datetime.day(ts), 15)
    },
    err(_) => assert(false, "should parse"),
  }
}

test "datetime.parse_iso invalid" {
  match datetime.parse_iso("not-a-date") {
    ok(_) => assert(false, "should fail"),
    err(e) => assert(string.len(e) > 0),
  }
}

test "datetime.parse_iso then format" {
  match datetime.parse_iso("2024-06-01T08:30:00Z") {
    ok(ts) => {
      assert_eq(datetime.year(ts), 2024)
      assert_eq(datetime.month(ts), 6)
      assert_eq(datetime.hour(ts), 8)
      assert_eq(datetime.minute(ts), 30)
    },
    err(_) => assert(false, "should parse"),
  }
}

test "datetime.year on epoch" {
  let ts = datetime.from_parts(1970, 1, 1, 0, 0, 0)
  assert_eq(datetime.year(ts), 1970)
}

test "datetime.from_parts february" {
  let ts = datetime.from_parts(2024, 2, 29, 12, 0, 0)
  assert_eq(datetime.month(ts), 2)
  assert_eq(datetime.day(ts), 29)
}

test "datetime.to_iso format check" {
  let ts = datetime.from_parts(2024, 1, 1, 0, 0, 0)
  let iso = datetime.to_iso(ts)
  assert_eq(string.contains(iso, "T"), true)
}

test "datetime.from_parts all months" {
  let jan = datetime.from_parts(2024, 1, 1, 0, 0, 0)
  let dec = datetime.from_parts(2024, 12, 1, 0, 0, 0)
  assert_eq(datetime.month(jan), 1)
  assert_eq(datetime.month(dec), 12)
}

test "datetime.from_parts different years" {
  let ts1 = datetime.from_parts(2020, 6, 15, 0, 0, 0)
  let ts2 = datetime.from_parts(2025, 6, 15, 0, 0, 0)
  assert_eq(datetime.year(ts1), 2020)
  assert_eq(datetime.year(ts2), 2025)
}

test "datetime.to_iso contains Z" {
  let ts = datetime.from_parts(2024, 6, 15, 12, 0, 0)
  let iso = datetime.to_iso(ts)
  assert_eq(string.contains(iso, "Z"), true)
}

test "pre-epoch timestamps floor to their own day (#2488)" {
  assert_eq(datetime.to_iso(-1), "1969-12-31T23:59:59Z")
  assert_eq(datetime.weekday(-1), "Wednesday")
  assert_eq(datetime.year(-1), 1969)
  assert_eq(datetime.month(-1), 12)
  assert_eq(datetime.day(-1), 31)
  assert_eq(datetime.to_iso(-86399), "1969-12-31T00:00:01Z")
  assert_eq(datetime.to_iso(-86400), "1969-12-31T00:00:00Z")
  assert_eq(datetime.to_iso(-86401), "1969-12-30T23:59:59Z")
  assert_eq(datetime.weekday(-86401), "Tuesday")
  assert_eq(datetime.format(-1, "%Y-%m-%d %H:%M:%S"), "1969-12-31 23:59:59")
  // the inverse still agrees with the forward direction across the epoch
  assert_eq(datetime.from_parts(1969, 12, 31, 23, 59, 59), -1)
  assert_eq(datetime.to_iso(-62135596801), "0000-12-31T23:59:59Z")
}

test "datetime.format %Y is the variable-width year to_iso renders" {
  assert_eq(datetime.format(9223372036854775807, "%Y"), "292277026596")
  assert_eq(datetime.format(0 - 9223372036854775807 - 1, "%Y"), "-292277022657")
  assert_eq(datetime.format(-62135596801, "%Y"), "0000")
}

test "datetime.parse_iso applies a UTC offset (#2489)" {
  assert_eq(datetime.parse_iso("2024-01-15T10:30:00Z") ?? -1, 1705314600)
  assert_eq(datetime.parse_iso("2024-01-15T10:30:00") ?? -1, 1705314600)
  assert_eq(datetime.parse_iso("2024-01-15T10:30:00+00:00") ?? -1, 1705314600)
  assert_eq(datetime.parse_iso("2024-01-15T10:30:00+09:00") ?? -1, 1705282200)
  assert_eq(datetime.parse_iso("2024-01-15T10:30:00-05:30") ?? -1, 1705334400)
  assert_eq(datetime.parse_iso("2024-1-5T1:2:3") ?? -1, 1704416523)
  assert_eq(datetime.parse_iso(" 2024-01-15T10:30:00Z ") ?? -1, 1705314600)
  assert_eq(datetime.parse_iso("1969-12-31T23:59:59Z") ?? 0, -1)
}

fn parse_err(s: String) -> String = match datetime.parse_iso(s) {
  ok(n) => "ok(${n})",
  err(e) => e,
}

test "datetime.parse_iso rejects out-of-range fields by name (#2489)" {
  assert_eq(parse_err("2024-13-45T99:99:99Z"), "month out of range: 13")
  assert_eq(parse_err("2024-00-15T10:30:00Z"), "month out of range: 0")
  assert_eq(parse_err("2024-01-00T10:30:00Z"), "day out of range: 0")
  assert_eq(parse_err("2024-04-31T00:00:00Z"), "day out of range: 31")
  assert_eq(parse_err("2023-02-29T00:00:00Z"), "day out of range: 29")
  assert_eq(parse_err("2100-02-29T00:00:00Z"), "day out of range: 29")
  assert_eq(parse_err("2024-02-29T00:00:00Z"), "ok(1709164800)")
  assert_eq(parse_err("2000-02-29T00:00:00Z"), "ok(951782400)")
  assert_eq(parse_err("2024-01-15T24:00:00Z"), "hour out of range: 24")
  assert_eq(parse_err("2024-01-15T10:60:00Z"), "minute out of range: 60")
  assert_eq(parse_err("2024-12-31T23:59:60Z"), "second out of range: 60")
  assert_eq(parse_err("2024-01-15T10:30:00+24:00"), "invalid offset: +24:00")
  assert_eq(parse_err("2024-01-15T10:30:00+09:60"), "invalid offset: +09:60")
  assert_eq(parse_err("2024-01-15T10:30:00+9"), "invalid offset: +9")
  assert_eq(parse_err("2024-01-15T10:30:00Z+09:00"), "invalid datetime format")
  assert_eq(parse_err("2024-01-15T10:30:00ZZ"), "invalid datetime format")
  assert_eq(parse_err("2024-01-15-junkT10:30:00Z"), "invalid datetime format")
  assert_eq(parse_err("2024-01-15T10:30:00:xx"), "invalid datetime format")
  assert_eq(parse_err("+2024-01-15T10:30:00Z"), "invalid datetime format")
  assert_eq(parse_err("2024-01-15T10:30"), "invalid datetime format")
  assert_eq(parse_err("2024-01-15"), "expected YYYY-MM-DDTHH:MM:SSZ")
}
