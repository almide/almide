// string.split_once — the split-at-first-separator pair of split (the split
// surface is exactly {split, split_once}; rsplit_once / splitn intentionally
// absent). none ⇔ separator absent; the rest keeps later separators intact.
test "splits at the first separator only" {
  assert_eq(string.split_once("a;b;c", ";"), some(("a", "b;c")))
  assert_eq(string.split_once("Abha;12.3", ";"), some(("Abha", "12.3")))
}

test "absent separator is none" {
  assert_eq(string.split_once("abc", ";"), none)
  assert_eq(string.split_once("", ";"), none)
}

test "empty sides survive" {
  assert_eq(string.split_once(";x", ";"), some(("", "x")))
  assert_eq(string.split_once("x;", ";"), some(("x", "")))
  assert_eq(string.split_once(";", ";"), some(("", "")))
}

test "multi-byte separator" {
  assert_eq(string.split_once("a::b::c", "::"), some(("a", "b::c")))
}

test "agrees with split's first piece" {
  let s = "one,two,three"
  let parts = string.split(s, ",")
  assert_eq(string.split_once(s, ","), some((parts[0], "two,three")))
}
