// #4785: list.join over List[Bytes] sizes the result once and fills it. The
// separator goes between every pair, empty parts and an empty separator
// included.
test "list.join over Bytes puts the separator between every pair" {
  let sep = bytes.from_list([0])
  assert_eq(
    bytes.to_list(list.join([
      bytes.from_list([1, 2]),
      bytes.from_list([3])
    ], sep)),
    [1, 2, 0, 3],
  )
  assert_eq(
    bytes.to_list(list.join([
      bytes.new(),
      bytes.from_list([3]),
      bytes.new()
    ], sep)),
    [0, 3, 0],
  )
  assert_eq(bytes.to_list(list.join([bytes.new(), bytes.new()], sep)), [0])
}

test "list.join over Bytes with an empty separator or one part" {
  assert_eq(
    bytes.to_list(list.join([
      bytes.from_list([1]),
      bytes.from_list([2, 3])
    ], bytes.new())),
    [1, 2, 3],
  )
  assert_eq(bytes.to_list(list.join([
    bytes.from_list([9])
  ], bytes.from_list([5, 5]))), [9])
  let parts: List[Bytes] = []
  assert_eq(bytes.len(list.join(parts, bytes.from_list([5]))), 0)
}
