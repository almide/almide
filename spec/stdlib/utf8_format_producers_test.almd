// The UTF-8 producer evidence for the number formatters, the byte encoders
// and the small text producers (#4005 A4, proofs/utf8-producers.toml). The
// formatters take no bytes, so their evidence pairs every edge value with the
// invalid-byte corpus fed to the parsers beside them, whose err texts quote
// their input; the encoders take the corpus's raw invalid bytes directly.
import base64
import bigint
import env
import hash
import hex
import net
import uuid

// ── the oracle: RFC 3629 well-formedness of a String's bytes ──
fn utf8_in(bs: List[Int], i: Int, lo: Int, hi: Int) -> Bool = match list.get(bs, i) {
  some(b) => b >= lo and b <= hi,
  none => false,
}

fn utf8_cont(bs: List[Int], i: Int, n: Int) -> Bool =
  if n == 0 then true
  else utf8_in(bs, i, 128, 191) and utf8_cont(bs, i + 1, n - 1)

fn utf8_width(bs: List[Int], i: Int, b: Int) -> Int =
  if b < 128 then 1
  else if b >= 194 and b <= 223 then (if utf8_cont(bs, i + 1, 1) then 2 else 0)
  else if b == 224 then (if utf8_in(bs, i + 1, 160, 191) and utf8_cont(bs, i + 2, 1) then 3 else 0)
  else if b == 237 then (if utf8_in(bs, i + 1, 128, 159) and utf8_cont(bs, i + 2, 1) then 3 else 0)
  else if b >= 225 and b <= 239 then (if utf8_cont(bs, i + 1, 2) then 3 else 0)
  else if b == 240 then (if utf8_in(bs, i + 1, 144, 191) and utf8_cont(bs, i + 2, 2) then 4 else 0)
  else if b >= 241 and b <= 243 then (if utf8_cont(bs, i + 1, 3) then 4 else 0)
  else if b == 244 then (if utf8_in(bs, i + 1, 128, 143) and utf8_cont(bs, i + 2, 2) then 4 else 0)
  else 0

fn utf8_from(bs: List[Int], i: Int, n: Int) -> Bool =
  if i >= n then true
  else {
    let w = utf8_width(bs, i, list.get(bs, i) ?? 0)
    if w == 0 then false
    else utf8_from(bs, i + w, n)
  }

fn utf8_ok(s: String) -> Bool = {
  let bs = bytes.to_list(bytes.from_string(s))
  utf8_from(bs, 0, list.len(bs))
}

// ── the invalid input: every class of ill-formed UTF-8 ──
fn invalid_corpus() -> List[Bytes] = [
  bytes.from_list([0xFF]),
  bytes.from_list([0xFE, 0x41]),
  bytes.from_list([0xC0, 0xAF]),
  bytes.from_list([0xC1, 0xBF]),
  bytes.from_list([0xE0, 0x80, 0xAF]),
  bytes.from_list([0xED, 0xA0, 0x80]),
  bytes.from_list([0xED, 0xBF, 0xBF]),
  bytes.from_list([0xF4, 0x90, 0x80, 0x80]),
  bytes.from_list([0xF5, 0x80, 0x80, 0x80]),
  bytes.from_list([0xF8, 0x88, 0x80, 0x80, 0x80]),
  bytes.from_list([0x80]),
  bytes.from_list([0x61, 0xBF, 0x62]),
  bytes.from_list([0xE2, 0x82]),
  bytes.from_list([0xF0, 0x9F, 0x98]),
  bytes.from_list([0xC3]),
  bytes.from_list([
    0x61,
    0xE2,
    0x82,
    0x61,
    0xF0,
    0x9F,
    0x98,
    0x80,
    0xFF
  ]),
  bytes.from_list([0xE2, 0x82, 0xAC, 0xC3]),
  bytes.from_list([
    0x0A,
    0xFF,
    0x0D,
    0x0A,
    0xC3,
    0x0A
  ])
]

// ── valid text beside every boundary a cut or a case map can hit ──
fn edge_strings() -> List[String] = [
  "",
  "a",
  "ab",
  "é",
  "€",
  "😀",
  "\u{10FFFF}",
  "\u{FFFD}",
  "\u{7F}\u{80}\u{7FF}\u{800}\u{FFFF}\u{10000}",
  "\u{23A}\u{2C65}\u{23E}",
  "\u{130}\u{131}\u{1E9E}\u{DF}",
  "\u{FB03}\u{390}\u{3B0}\u{1F80}",
  "\u{3A3}\u{3C3}\u{3C2}",
  "e\u{301}",
  "a😀b€cé",
  " \t\u{3000}x\u{A0}\u{2028} ",
  "\u{FEFF}bom",
  "日本語テキスト",
  "line\nnext\r\nlast\r",
  "a,b,,c"
]

fn adversary() -> List[String] = (invalid_corpus() |> list.map((b) => bytes.to_string_lossy(b))) + edge_strings()

fn ints() -> List[Int] = [
  0,
  1,
  -1,
  7,
  -128,
  127,
  255,
  65535,
  -2147483648,
  4294967295,
  9223372036854775807,
  -9223372036854775807 - 1
]

fn parse_texts() -> List[String] = adversary() + [
  "",
  "12",
  "-0",
  "+7",
  "0x1F",
  "1e5",
  "1.5",
  "  3 ",
  "true",
  "false",
  "zz",
  "99999999999999999999999"
]

fn err_ok[T](r: Result[T, String]) -> Bool = match r {
  ok(_) => true,
  err(e) => utf8_ok(e),
}

test "int formatting and parsing stay valid" {
  for n in ints() {
    assert(utf8_ok(int.to_string(n)))
    assert(utf8_ok(int.to_hex(n)))
    for r in [2, 8, 10, 16, 36] {
      assert(utf8_ok(int.to_string_radix(n, r)))
    }
  }
  for s in parse_texts() {
    assert(err_ok(int.parse(s)))
    for r in [2, 10, 16, 36] {
      assert(err_ok(int.parse_radix(s, r)))
    }
  }
}

test "sized int formatting and parsing stay valid" {
  for n in ints() {
    for r in [2, 10, 16, 36] {
      assert(utf8_ok(int8.to_string_radix(int8.from_saturating(n), r)))
      assert(utf8_ok(int16.to_string_radix(int16.from_saturating(n), r)))
      assert(utf8_ok(int32.to_string_radix(int32.from_saturating(n), r)))
      assert(utf8_ok(int64.to_string_radix(int64.from_saturating(n), r)))
      assert(utf8_ok(uint8.to_string_radix(uint8.from_saturating(n), r)))
      assert(utf8_ok(uint16.to_string_radix(uint16.from_saturating(n), r)))
      assert(utf8_ok(uint32.to_string_radix(uint32.from_saturating(n), r)))
      assert(utf8_ok(uint64.to_string_radix(uint64.from_saturating(n), r)))
    }
    assert(utf8_ok(int8.to_string(int8.from_saturating(n))))
    assert(utf8_ok(int16.to_string(int16.from_saturating(n))))
    assert(utf8_ok(int32.to_string(int32.from_saturating(n))))
    assert(utf8_ok(int64.to_string(int64.from_saturating(n))))
    assert(utf8_ok(uint8.to_string(uint8.from_saturating(n))))
    assert(utf8_ok(uint16.to_string(uint16.from_saturating(n))))
    assert(utf8_ok(uint32.to_string(uint32.from_saturating(n))))
    assert(utf8_ok(uint64.to_string(uint64.from_saturating(n))))
  }
  for s in parse_texts() {
    assert(err_ok(int8.parse(s)) and err_ok(int8.parse_radix(s, 16)))
    assert(err_ok(int16.parse(s)) and err_ok(int16.parse_radix(s, 16)))
    assert(err_ok(int32.parse(s)) and err_ok(int32.parse_radix(s, 16)))
    assert(err_ok(int64.parse(s)) and err_ok(int64.parse_radix(s, 16)))
    assert(err_ok(uint8.parse(s)) and err_ok(uint8.parse_radix(s, 16)))
    assert(err_ok(uint16.parse(s)) and err_ok(uint16.parse_radix(s, 16)))
    assert(err_ok(uint32.parse(s)) and err_ok(uint32.parse_radix(s, 16)))
    assert(err_ok(uint64.parse(s)) and err_ok(uint64.parse_radix(s, 16)))
  }
}

test "bigint formatting and parsing stay valid" {
  for n in ints() {
    let x = bigint.pow(bigint.from(n), 3)
    assert(utf8_ok(bigint.to_string(x)))
    for r in [2, 16, 36] {
      assert(utf8_ok(bigint.to_string_radix(x, r)))
    }
  }
  for s in parse_texts() {
    assert(err_ok(bigint.parse(s)) and err_ok(bigint.parse_radix(s, 16)))
  }
}

test "float and bool formatting and parsing stay valid" {
  let xs = [
    0.0,
    -0.0,
    1.5,
    -2.25,
    1.0e300,
    1.0e-300,
    float.max_value(),
    float.min_value(),
    float.epsilon(),
    float.infinity(),
    float.nan()
  ]
  for x in xs {
    assert(utf8_ok(float.to_string(x)))
    assert(utf8_ok(float64.to_string(float64.from(x))))
    assert(utf8_ok(float32.to_string(float32.from(x))))
    for d in [0, 2, 17] {
      assert(utf8_ok(float.to_fixed(x, d)))
    }
  }
  assert(utf8_ok(bool.to_string(true)) and utf8_ok(bool.to_string(false)))
  for s in parse_texts() {
    assert(err_ok(float.parse(s)))
    assert(err_ok(float32.parse(s)))
    assert(err_ok(float64.parse(s)))
    assert(err_ok(bool.parse(s)))
  }
}

test "datetime formatting and parsing stay valid" {
  let stamps = [
    0,
    1,
    -1,
    86399,
    951782400,
    4102444800,
    -62135596800
  ]
  for ts in stamps {
    assert(utf8_ok(datetime.to_iso(ts)))
    assert(utf8_ok(datetime.weekday(ts)))
    for p in adversary() + ["%Y-%m-%d %H:%M:%S", "%a %b %e %j", "%%", "%"] {
      assert(utf8_ok(datetime.format(ts, p)))
    }
  }
  for s in parse_texts() + ["2024-02-29T12:00:00Z", "2023-02-29T00:00:00Z"] {
    assert(err_ok(datetime.parse_iso(s)))
  }
  assert(err_ok(datetime.from_parts(2023, 2, 29, 0, 0, 0)))
  assert(err_ok(datetime.from_parts(2024, 13, 1, 25, 61, 61)))
}

test "byte encoders turn invalid bytes into ASCII" {
  for b in invalid_corpus() {
    assert(utf8_ok(base64.encode(b)) and utf8_ok(base64.encode_url(b)))
    assert(utf8_ok(hex.encode(b)) and utf8_ok(hex.encode_upper(b)))
    assert(utf8_ok(hash.sha256_hex(b)) and utf8_ok(hash.sha512_hex(b)))
  }
  for s in parse_texts() + ["AAEC", "_-8=", "ff0", "zz"] {
    assert(err_ok(base64.decode(s)) and err_ok(base64.decode_url(s)))
    assert(err_ok(hex.decode(s)))
  }
}

test "uuid text stays valid" {
  for b in invalid_corpus() + [
    bytes.from_list(list.map(list.range(0, 16), (_) => 0xFF))
  ] {
    match uuid.from_bytes(b) {
      ok(u) => assert(utf8_ok(uuid.to_string(u))),
      err(e) => assert(utf8_ok(e)),
    }
  }
  for s in parse_texts() + ["00000000-0000-0000-0000-000000000000", "ffffffff-ffff-ffff-ffff-fffffffffff€"] {
    match uuid.parse(s) {
      ok(u) => assert(utf8_ok(uuid.to_string(u))),
      err(e) => assert(utf8_ok(e)),
    }
  }
}

test "ip text and the os name stay valid" {
  for s in parse_texts() + ["127.0.0.1", "::1", "fe80::1%eth0", "1.2.3.256", "::ffff:1.2.3.4"] {
    match net.parse_ip(s) {
      ok(ip) => assert(utf8_ok(net.ip_to_string(ip))),
      err(e) => assert(utf8_ok(e)),
    }
  }
  assert(utf8_ok(env.os()))
}
