  assert_eq(l(a), [63, 192, 0, 0])
  var p = bytes.zeros(6)
  bytes.put_f32_be(p, 1, 1.5)
  assert_eq(l(p), [
    0,
    63,
    192,
    0,
    0,
    0
  ])
  assert_eq(bytes.get_f32_be(p, 1), some(1.5))
  assert_eq(bytes.get_f32_be(p, 2), some(-2.0))
  assert_eq(bytes.get_f32_be(p, 3), none)
  assert_eq(bytes.get_f32_be(p, -1), none)
  assert_eq(bytes.get_f32_be(p, 9223372036854775807), none)
  assert_eq(bytes.next_f32_be(p, 1), (some(1.5), 5))
  assert_eq(bytes.next_f32_be(p, 3), (none, 3))
  assert_eq(bytes.next_f32_be(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_f32_be(two, 1.5)
  bytes.append_f32_be(two, 1.5)
  assert_eq(bytes.get_f32_be_array(two, 0, 2), some([1.5, 1.5]))
  assert_eq(bytes.get_f32_be_array(two, 0, 0), some([]))
  assert_eq(bytes.get_f32_be_array(two, 1, 2), none)
  assert_eq(bytes.get_f32_be_array(two, 0, 3), none)
  assert_eq(bytes.get_f32_be_array(two, 0, -1), none)
  assert_eq(bytes.get_f32_be_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_f32_be(q, 3, 1.5)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_f32_be(q, -1, 1.5)
    },
  )
}

test "f64_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_f64_le(a, -2.25)
  assert_eq(l(a), [
    0,
    0,
    0,
    0,
    0,
    0,
    2,
    192
  ])
  var p = bytes.zeros(10)
  bytes.put_f64_le(p, 1, -2.25)
  assert_eq(l(p), [
    0,
    0,
    0,
    0,
    0,
    0,
    0,
    2,
    192,
    0
  ])
  assert_eq(bytes.get_f64_le(p, 1), some(-2.25))
  assert_eq(bytes.get_f64_le(p, 2), some(4.559176336081256e-305))
  assert_eq(bytes.get_f64_le(p, 3), none)
  assert_eq(bytes.get_f64_le(p, -1), none)
  assert_eq(bytes.get_f64_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_f64_le(p, 1), (some(-2.25), 9))
  assert_eq(bytes.next_f64_le(p, 3), (none, 3))
  assert_eq(bytes.next_f64_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_f64_le(two, -2.25)
  bytes.append_f64_le(two, -2.25)
  assert_eq(bytes.get_f64_le_array(two, 0, 2), some([-2.25, -2.25]))
  assert_eq(bytes.get_f64_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_f64_le_array(two, 1, 2), none)
  assert_eq(bytes.get_f64_le_array(two, 0, 3), none)
  assert_eq(bytes.get_f64_le_array(two, 0, -1), none)
  assert_eq(bytes.get_f64_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(10)
      bytes.put_f64_le(q, 3, -2.25)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(10)
      bytes.put_f64_le(q, -1, -2.25)
    },
  )
}

test "f64_be: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_f64_be(a, -2.25)
  assert_eq(l(a), [
    192,
    2,
    0,
    0,
    0,
    0,
    0,
    0
  ])
  var p = bytes.zeros(10)
  bytes.put_f64_be(p, 1, -2.25)
  assert_eq(l(p), [
    0,
    192,
    2,
    0,
    0,
    0,
    0,
    0,
    0,
    0
  ])
  assert_eq(bytes.get_f64_be(p, 1), some(-2.25))
  assert_eq(bytes.get_f64_be(p, 2), some(4.778309726736481e-299))
