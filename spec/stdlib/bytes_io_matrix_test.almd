// The typed byte IO matrix (R-bytes-01/03/09/11/13/15/25): every cell of
// get_ / next_ / get_<t>_array / put_ / append_ over every type row and byte
// order, on both legs. Each row checks the byte layout of the write, the read
// back through every reader, the out-of-range answers (none, the position
// kept) and the abort of an out-of-range position write.
import testing

fn b(xs: List[Int]) -> Bytes = bytes.from_list(xs)

fn l(x: Bytes) -> List[Int] = bytes.to_list(x)

test "u16_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_u16_le(a, 48879)
  assert_eq(l(a), [239, 190])
  var p = bytes.zeros(4)
  bytes.put_u16_le(p, 1, 48879)
  assert_eq(l(p), [0, 239, 190, 0])
  assert_eq(bytes.get_u16_le(p, 1), some(48879))
  assert_eq(bytes.get_u16_le(p, 2), some(190))
  assert_eq(bytes.get_u16_le(p, 3), none)
  assert_eq(bytes.get_u16_le(p, -1), none)
  assert_eq(bytes.get_u16_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_u16_le(p, 1), (some(48879), 3))
  assert_eq(bytes.next_u16_le(p, 3), (none, 3))
  assert_eq(bytes.next_u16_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_u16_le(two, 48879)
  bytes.append_u16_le(two, 48879)
  assert_eq(bytes.get_u16_le_array(two, 0, 2), some([48879, 48879]))
  assert_eq(bytes.get_u16_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_u16_le_array(two, 1, 2), none)
  assert_eq(bytes.get_u16_le_array(two, 0, 3), none)
  assert_eq(bytes.get_u16_le_array(two, 0, -1), none)
  assert_eq(bytes.get_u16_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(4)
      bytes.put_u16_le(q, 3, 48879)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(4)
      bytes.put_u16_le(q, -1, 48879)
    },
  )
}

test "u16_be: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_u16_be(a, 48879)
  assert_eq(l(a), [190, 239])
  var p = bytes.zeros(4)
  bytes.put_u16_be(p, 1, 48879)
  assert_eq(l(p), [0, 190, 239, 0])
  assert_eq(bytes.get_u16_be(p, 1), some(48879))
  assert_eq(bytes.get_u16_be(p, 2), some(61184))
  assert_eq(bytes.get_u16_be(p, 3), none)
  assert_eq(bytes.get_u16_be(p, -1), none)
  assert_eq(bytes.get_u16_be(p, 9223372036854775807), none)
  assert_eq(bytes.next_u16_be(p, 1), (some(48879), 3))
  assert_eq(bytes.next_u16_be(p, 3), (none, 3))
  assert_eq(bytes.next_u16_be(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_u16_be(two, 48879)
  bytes.append_u16_be(two, 48879)
  assert_eq(bytes.get_u16_be_array(two, 0, 2), some([48879, 48879]))
  assert_eq(bytes.get_u16_be_array(two, 0, 0), some([]))
  assert_eq(bytes.get_u16_be_array(two, 1, 2), none)
  assert_eq(bytes.get_u16_be_array(two, 0, 3), none)
  assert_eq(bytes.get_u16_be_array(two, 0, -1), none)
  assert_eq(bytes.get_u16_be_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(4)
      bytes.put_u16_be(q, 3, 48879)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(4)
      bytes.put_u16_be(q, -1, 48879)
    },
  )
}

