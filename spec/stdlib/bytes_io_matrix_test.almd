  assert_eq(bytes.get_f64_be(p, -1), none)
  assert_eq(bytes.get_f64_be(p, 9223372036854775807), none)
  assert_eq(bytes.next_f64_be(p, 1), (some(-2.25), 9))
  assert_eq(bytes.next_f64_be(p, 3), (none, 3))
  assert_eq(bytes.next_f64_be(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_f64_be(two, -2.25)
  bytes.append_f64_be(two, -2.25)
  assert_eq(bytes.get_f64_be_array(two, 0, 2), some([-2.25, -2.25]))
  assert_eq(bytes.get_f64_be_array(two, 0, 0), some([]))
  assert_eq(bytes.get_f64_be_array(two, 1, 2), none)
  assert_eq(bytes.get_f64_be_array(two, 0, 3), none)
  assert_eq(bytes.get_f64_be_array(two, 0, -1), none)
  assert_eq(bytes.get_f64_be_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
