test "i64_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_i64_le(a, -4611686018427387909)
  assert_eq(l(a), [
    251,
    255,
    255,
    255,
    255,
    255,
    255,
    191
  ])
  var p = bytes.zeros(10)
  bytes.put_i64_le(p, 1, -4611686018427387909)
  assert_eq(
    l(p),
    [
      0,
      251,
      255,
      255,
      255,
      255,
      255,
      255,
      191,
      0
    ],
  )
  assert_eq(bytes.get_i64_le(p, 1), some(-4611686018427387909))
  assert_eq(bytes.get_i64_le(p, 2), some(54043195528445951))
  assert_eq(bytes.get_i64_le(p, 3), none)
  assert_eq(bytes.get_i64_le(p, -1), none)
  assert_eq(bytes.get_i64_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_i64_le(p, 1), (some(-4611686018427387909), 9))
  assert_eq(bytes.next_i64_le(p, 3), (none, 3))
  assert_eq(bytes.next_i64_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_i64_le(two, -4611686018427387909)
  bytes.append_i64_le(two, -4611686018427387909)
  assert_eq(bytes.get_i64_le_array(two, 0, 2), some([-4611686018427387909, -4611686018427387909]))
  assert_eq(bytes.get_i64_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_i64_le_array(two, 1, 2), none)
  assert_eq(bytes.get_i64_le_array(two, 0, 3), none)
  assert_eq(bytes.get_i64_le_array(two, 0, -1), none)
  assert_eq(bytes.get_i64_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(10)
      bytes.put_i64_le(q, 3, -4611686018427387909)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(10)
      bytes.put_i64_le(q, -1, -4611686018427387909)
    },
  )
}

