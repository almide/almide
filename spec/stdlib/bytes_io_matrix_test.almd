test "i32_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_i32_le(a, -123456789)
  assert_eq(l(a), [235, 50, 164, 248])
  var p = bytes.zeros(6)
  bytes.put_i32_le(p, 1, -123456789)
  assert_eq(l(p), [
    0,
    235,
    50,
    164,
    248,
    0
  ])
  assert_eq(bytes.get_i32_le(p, 1), some(-123456789))
  assert_eq(bytes.get_i32_le(p, 2), some(16294962))
  assert_eq(bytes.get_i32_le(p, 3), none)
  assert_eq(bytes.get_i32_le(p, -1), none)
  assert_eq(bytes.get_i32_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_i32_le(p, 1), (some(-123456789), 5))
  assert_eq(bytes.next_i32_le(p, 3), (none, 3))
  assert_eq(bytes.next_i32_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_i32_le(two, -123456789)
  bytes.append_i32_le(two, -123456789)
  assert_eq(bytes.get_i32_le_array(two, 0, 2), some([-123456789, -123456789]))
  assert_eq(bytes.get_i32_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_i32_le_array(two, 1, 2), none)
  assert_eq(bytes.get_i32_le_array(two, 0, 3), none)
  assert_eq(bytes.get_i32_le_array(two, 0, -1), none)
  assert_eq(bytes.get_i32_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_i32_le(q, 3, -123456789)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_i32_le(q, -1, -123456789)
    },
  )
}

