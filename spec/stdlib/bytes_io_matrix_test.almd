test "u32_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_u32_le(a, 3735928559)
  assert_eq(l(a), [239, 190, 173, 222])
  var p = bytes.zeros(6)
  bytes.put_u32_le(p, 1, 3735928559)
  assert_eq(l(p), [
    0,
    239,
    190,
    173,
    222,
    0
  ])
  assert_eq(bytes.get_u32_le(p, 1), some(3735928559))
  assert_eq(bytes.get_u32_le(p, 2), some(14593470))
  assert_eq(bytes.get_u32_le(p, 3), none)
  assert_eq(bytes.get_u32_le(p, -1), none)
  assert_eq(bytes.get_u32_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_u32_le(p, 1), (some(3735928559), 5))
  assert_eq(bytes.next_u32_le(p, 3), (none, 3))
  assert_eq(bytes.next_u32_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_u32_le(two, 3735928559)
  bytes.append_u32_le(two, 3735928559)
  assert_eq(bytes.get_u32_le_array(two, 0, 2), some([3735928559, 3735928559]))
  assert_eq(bytes.get_u32_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_u32_le_array(two, 1, 2), none)
  assert_eq(bytes.get_u32_le_array(two, 0, 3), none)
  assert_eq(bytes.get_u32_le_array(two, 0, -1), none)
  assert_eq(bytes.get_u32_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_u32_le(q, 3, 3735928559)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_u32_le(q, -1, 3735928559)
    },
  )
}

