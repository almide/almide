test "f32_le: append, put, get, next, array" {
  var a = bytes.new()
  bytes.append_f32_le(a, 1.5)
  assert_eq(l(a), [0, 0, 192, 63])
  var p = bytes.zeros(6)
  bytes.put_f32_le(p, 1, 1.5)
  assert_eq(l(p), [
    0,
    0,
    0,
    192,
    63,
    0
  ])
  assert_eq(bytes.get_f32_le(p, 1), some(1.5))
  assert_eq(bytes.get_f32_le(p, 2), some(5.85451288007194e-39))
  assert_eq(bytes.get_f32_le(p, 3), none)
  assert_eq(bytes.get_f32_le(p, -1), none)
  assert_eq(bytes.get_f32_le(p, 9223372036854775807), none)
  assert_eq(bytes.next_f32_le(p, 1), (some(1.5), 5))
  assert_eq(bytes.next_f32_le(p, 3), (none, 3))
  assert_eq(bytes.next_f32_le(p, -1), (none, -1))
  var two = bytes.new()
  bytes.append_f32_le(two, 1.5)
  bytes.append_f32_le(two, 1.5)
  assert_eq(bytes.get_f32_le_array(two, 0, 2), some([1.5, 1.5]))
  assert_eq(bytes.get_f32_le_array(two, 0, 0), some([]))
  assert_eq(bytes.get_f32_le_array(two, 1, 2), none)
  assert_eq(bytes.get_f32_le_array(two, 0, 3), none)
  assert_eq(bytes.get_f32_le_array(two, 0, -1), none)
  assert_eq(bytes.get_f32_le_array(two, 0, 9223372036854775807), none)
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_f32_le(q, 3, 1.5)
    },
  )
  testing.assert_aborts(
    "out of range",
    () => {
      var q = bytes.zeros(6)
      bytes.put_f32_le(q, -1, 1.5)
    },
  )
}

