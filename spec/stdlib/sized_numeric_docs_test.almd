// Executable check on the worked examples in the sized-numeric stdlib pages
// (docs/stdlib/{int8,int16,int32,uint8,uint16,uint32,uint64,float32}.md).
//
// The pages document `int.from(x)` as the idiom rather than a narrower
// conversion because a narrow result passed to an `Int`-taking fn is accepted by
// `check` and then rejected by rustc (#867). These assertions are the shape the
// pages actually show.
test "docs sized-numeric conversions" {
  let a: Int8 = 12
  assert_eq(int.from(a), 12)
  assert_eq(a.to_string(), "12")
  let u: UInt8 = 200
  assert_eq(int.from(u), 200)
  assert_eq(u.to_string(), "200")
  let w: UInt32 = 4000000000
  assert_eq(int.from(w), 4000000000)
  let f: Float32 = 1.5
  assert_eq(float.from(f), 1.5)
}

test "docs sized-numeric narrowing wraps rather than trapping" {
  // The pages state narrowing WRAPS (two's complement), never traps.
  let big: Int = 200
  assert_eq(int.from(int8.from_wrapping(big)), -56)
  let neg: Int = -1
  assert_eq(int.from(uint8.from_wrapping(neg)), 255)
}

test "docs sized-numeric float-to-int saturates" {
  // The pages state float → integer is saturating truncation.
  assert_eq(int8.from_wrapping(int.from_saturating(300.0)), int8.from_wrapping(300))
  assert_eq(int.from_saturating(0.0 / 0.0), 0)
}
