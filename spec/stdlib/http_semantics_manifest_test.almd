import html
import http

// GENERATED by scripts/check-semantics-manifest.sh from
// docs/stdlib/semantics-manifest.toml — DO NOT EDIT (the gate
// regenerates and diffs). Each case executes a manifest probe; a
// failure here means the implementation drifted from the DECLARED
// semantic dimension (#419 class).
test "http.response unit=status-code" {
  let r = http.response(200, "hi")
  assert_eq("${http.body(r) + " " + (http.header(r, "Content-Type") ?? "none")}", "hi text/plain")
}

test "http.json unit=status-code" {
  let r = http.json(201, "{}")
  assert_eq(
    "${http.body(r) + " " + (http.header(r, "Content-Type") ?? "none")}",
    "{} application/json",
  )
}

test "http.html unit=status-code" {
  let r = http.html(201, html.escape("<b>"))
  assert_eq(
    "${http.body(r) + " " + (http.header(r, "Content-Type") ?? "none")}",
    "&lt;b&gt; text/html; charset=utf-8",
  )
}

test "http.with_headers unit=status-code" {
  let r = http.with_headers(202, "wh", [("X-A", "1")])
  assert_eq("${http.body(r) + " " + (http.header(r, "X-A") ?? "none")}", "wh 1")
}

test "http.set_status unit=status-code" {
  let r = http.set_status(http.response(200, "sb"), 404)
  assert_eq(
    "${http.body(r) + " " + (http.header(r, "Content-Type") ?? "none") + " " + int.to_string(http.status(r))}",
    "sb text/plain 404",
  )
}

test "http.status unit=status-code" {
  assert_eq("${http.status(http.set_status(http.response(200, "sb"), 418))}", "418")
}

test "http.serve unit=port" {
  assert_eq("${1}", "1")
}
