import http

test "http.response unit=status-code" {
  let r = http.response(200, "hi")
  assert_eq("${http.body(r) + " " + (http.get_header(r, "Content-Type") ?? "none")}", "hi text/plain")
}

test "http.json unit=status-code" {
  let r = http.json(201, "{}")
  assert_eq("${http.body(r) + " " + (http.get_header(r, "Content-Type") ?? "none")}", "{} application/json")
}

test "http.with_headers unit=status-code" {
  let r = http.with_headers(202, "wh", ["X-A": "1"])
  assert_eq("${http.body(r) + " " + (http.get_header(r, "X-A") ?? "none")}", "wh 1")
}

test "http.status unit=status-code" {
  let r = http.status(http.response(200, "sb"), 404)
  assert_eq("${http.body(r) + " " + (http.get_header(r, "Content-Type") ?? "none")}", "sb text/plain")
}

test "http.serve unit=port" {
  assert_eq("${1}", "1")
}
