import env
import string
import fs

test "env.args returns a list" {
  let args = env.args()
  // args should be a list (at least the binary name)
  assert(list.len(args) >= 0)
}

test "datetime.now returns positive int" {
  let ts = datetime.now()
  assert(ts > 1700000000)
}

test "datetime.now_ms returns positive int" {
  let ms = datetime.now_ms()
  assert(ms > 0)
}

test "env.os returns known value" {
  let os = env.os()
  assert(string.len(os) > 0)
}

test "fs.temp_dir returns a path" {
  let dir = fs.temp_dir()
  assert(string.len(dir) > 0)
}
