// @contract: C-220
// @contract: C-274
// wasm:skip — this file's accumulator shapes (String/Int/List[String] fold_lines,
// for_each_line) have no self-host twins yet — only the Map[String, Int] msi pair
// and fold_lines_range_ls landed (#1134 endgame) — and tmp() rides
// fs.create_temp_dir (its own brick). The wasm render walls honestly;
// remove this skip when the wasm leg lands.
// Streaming line walkers {fold_lines, for_each_line}: line-by-line over a
// file with O(longest line) memory, line semantics byte-matching read_lines.
//
// The C-274 half at the bottom is the ADR-0006 FALLIBLE callback form
// (#1144). Its cross-target proof is spec/wasm_cross/fs_fallible_stream_callback.almd
// (the Map[String,Int] fold_lines cell, which HAS a wasm twin); what lives
// here is the `for_each_line` cell — native-only for the same reason the
// plain for_each_line above is, and the Int/String fold accumulators, whose
// twins have not landed either.
import fs
import testing

effect fn tmp() -> String = fs.create_temp_dir("streaming")!

test "fold_lines folds every line in order" {
  let d = tmp()!
  let p = d + "/data.txt"
  fs.write(p, "a\nbb\nccc\n")!
  assert_eq(fs.fold_lines(p, "", (acc, line) => acc + line)!, "abbccc")
  assert_eq(fs.fold_lines(p, 0, (acc, line) => acc + string.len(line))!, 6)
}

test "for_each_line visits every line, captured var mutation works" {
  let d = tmp()!
  let p = d + "/data.txt"
  fs.write(p, "x\ny\nz\n")!
  var seen: List[String] = []
  fs.for_each_line(p, (line) => { list.push(seen, line) })!
  assert_eq(seen, ["x", "y", "z"])
}

test "empty file folds to init with zero callback invocations" {
  let d = tmp()!
  let p = d + "/empty.txt"
  fs.write(p, "")!
  assert_eq(fs.fold_lines(p, 41, (acc, line) => acc + 1000)!, 41)
  var calls = 0
  fs.for_each_line(p, (line) => {
    calls = calls + 1
  })!
  assert_eq(calls, 0)
}

test "line semantics byte-match read_lines across edge shapes" {
  let d = tmp()!
  // trailing newline: no phantom empty line; final \n-less line still yielded;
  // CRLF strips one \r; interior empty lines survive
  let shapes = ["a\nb\n", "a\nb", "a\r\nb\r\n", "a\n\nb", ""]
  for content in shapes {
    let p = d + "/shape.txt"
    fs.write(p, content)!
    let eager = fs.read_lines(p)!
    let streamed = fs.fold_lines(p, [], (acc, line) => acc + [line])!
    assert_eq(streamed, eager)
  }
}

test "a missing file is the same err as read_lines" {
  let d = tmp()!
  let missing = d + "/nope.txt"
  testing.assert_err(fs.fold_lines(missing, 0, (acc, line) => acc))
  testing.assert_err(fs.for_each_line(missing, (line) => ()))
}

test "fold_lines drives a Map accumulator (the aggregation shape)" {
  let d = tmp()!
  let p = d + "/kv.txt"
  fs.write(p, "a;1\nb;2\na;3\n")!
  let counts = fs.fold_lines(p, map.new(), (acc, line) => {
    let parts = string.split(line, ";")
    let key = parts[0]
    map.set(acc, key, map.get_or(acc, key, 0) + 1)
  })!
  assert_eq(map.get(counts, "a"), some(2))
  assert_eq(map.get(counts, "b"), some(1))
}

// ── C-274: the ADR-0006 fallible callback form (#1144) ──
//
// Why these cases are top-level fns: inside a `test` block a callback's `!` is
// plain unwrap and does NOT instantiate the fallible form (the L9 fork), so
// the blessed spelling only exists in an ordinary fn body — the same reason
// spec/stdlib/list_fallible_hof_test.almd is written this way.
// Each invocation appends its line to `log` BEFORE deciding, so the log is the
// invocation trace: a form that kept calling after the err would show it.
local effect fn traced_step(log: String, acc: Int, line: String) -> Int = {
  fs.append(log, line + ";")!
  if line == "bad" then err("boom") else ok(acc + string.len(line))
}

local effect fn traced_note(log: String, line: String) -> Unit = {
  fs.append(log, line + ";")!
  if line == "bad" then err("boom") else ok(())
}

local effect fn fold_traced(p: String, log: String) -> Int = fs.fold_lines(p, 0, (acc, line) => traced_step(log, acc, line)!)!

// `each_traced` is a REAL function in the corpus-wall scan (proofs/corpus-wall.sh
// enumerates functions, not runnable files, so this file's `wasm:skip` does not
// shield it). It must therefore LOWER — `proofs/walled-real-baseline.txt` is
// permanently 0 and a new walled-real row is a reviewed regression, not a fix.
// It does lower: the capability witness admits `fs.__fallible_for_each_line`
// (crates/almide-mir/src/lower/calls.rs), so the honest refusal lands in the
// RENDERER on the unlinked twin name — the same layer the total family's `_x`
// accumulator cells wall at, not in lower_function.
local effect fn each_traced(p: String, log: String) -> Unit = fs.for_each_line(p, (line) => traced_note(log, line)!)!

test "fold_lines with a fallible callback stops at the FIRST err" {
  let d = tmp()!
  let p = d + "/data.txt"
  let log = d + "/log.txt"
  fs.write(p, "a\nbb\nbad\nccc\ndddd\n")!
  fs.write(log, "")!
  testing.assert_err(fold_traced(p, log))
  // The trace is the proof: `ccc` and `dddd` never reached the callback.
  assert_eq(fs.read_text(log)!, "a;bb;bad;")
}

test "for_each_line with a fallible callback stops at the FIRST err" {
  let d = tmp()!
  let p = d + "/data.txt"
  let log = d + "/log.txt"
  fs.write(p, "a\nbb\nbad\nccc\n")!
  fs.write(log, "")!
  testing.assert_err(each_traced(p, log))
  assert_eq(fs.read_text(log)!, "a;bb;bad;")
}

test "a fallible callback that never errs folds every line" {
  let d = tmp()!
  let p = d + "/data.txt"
  let log = d + "/log.txt"
  fs.write(p, "a\nbb\nccc\n")!
  fs.write(log, "")!
  assert_eq(fold_traced(p, log), ok(6))
  assert_eq(fs.read_text(log)!, "a;bb;ccc;")
}

test "an empty file runs a fallible callback zero times" {
  let d = tmp()!
  let p = d + "/empty.txt"
  let log = d + "/log.txt"
  fs.write(p, "")!
  fs.write(log, "")!
  assert_eq(fold_traced(p, log), ok(0))
  assert_eq(fs.read_text(log)!, "")
  each_traced(p, log)!
  assert_eq(fs.read_text(log)!, "")
}

test "a missing file errs before the fallible callback runs at all" {
  let d = tmp()!
  let log = d + "/log.txt"
  fs.write(log, "")!
  testing.assert_err(fold_traced(d + "/nope.txt", log))
  testing.assert_err(each_traced(d + "/nope.txt", log))
  assert_eq(fs.read_text(log)!, "")
}
