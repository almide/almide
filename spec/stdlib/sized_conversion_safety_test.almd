// Stage 3: range-checked + saturating numeric conversions.
// Covers the narrow int targets and float → int / float → float32
// paths where Rust `as`-semantics alone silently lose information.
// ── Int → sized int: _checked ──
test "int8.from_checked inside range" {
  assert_eq(int.from(int8.from_checked(42)!), 42)
  assert_eq(int.from(int8.from_checked(-128)!), -128)
  assert_eq(int.from(int8.from_checked(127)!), 127)
}

test "int8.from_checked rejects overflow" {
  assert_eq(int8.from_checked(128).is_none(), true)
  assert_eq(int8.from_checked(-129).is_none(), true)
  assert_eq(int8.from_checked(100000).is_none(), true)
}

test "uint8.from_checked rejects negative and overflow" {
  assert_eq(int.from(uint8.from_checked(0)!), 0)
  assert_eq(int.from(uint8.from_checked(255)!), 255)
  assert_eq(uint8.from_checked(-1).is_none(), true)
  assert_eq(uint8.from_checked(256).is_none(), true)
}

test "uint16.from_checked boundaries" {
  assert_eq(int.from(uint16.from_checked(65535)!), 65535)
  assert_eq(uint16.from_checked(65536).is_none(), true)
  assert_eq(uint16.from_checked(-1).is_none(), true)
}

test "int32.from_checked boundaries" {
  assert_eq(int.from(int32.from_checked(2147483647)!), 2147483647)
  assert_eq(int32.from_checked(2147483648).is_none(), true)
  assert_eq(int.from(int32.from_checked(-2147483648)!), -2147483648)
  assert_eq(int32.from_checked(-2147483649).is_none(), true)
}

test "uint32.from_checked boundaries" {
  assert_eq(int.from(uint32.from_checked(4294967295)!), 4294967295)
  assert_eq(uint32.from_checked(4294967296).is_none(), true)
  assert_eq(uint32.from_checked(-1).is_none(), true)
}

test "uint64.from_checked only rejects negative" {
  assert_eq(int.from(uint64.from_checked(0)!), 0)
  assert_eq(int.from(uint64.from_checked(9223372036854775807)!), 9223372036854775807)
  assert_eq(uint64.from_checked(-1).is_none(), true)
}

test "float32.from_checked detects precision loss" {
  // 2^24 = 16777216 is the last exactly-representable positive int in f32.
  assert_eq(float32.from_checked(16777216).is_some(), true)
  assert_eq(float32.from_checked(-16777216).is_some(), true)
  // 2^24 + 1 cannot round-trip — would alias to 2^24 in f32.
  assert_eq(float32.from_checked(16777217).is_none(), true)
}

// #2487 — the family rule: a `_checked` cell never trusts a round trip through
// a conversion that wraps or saturates. `int.max_value()` rounds to 2^63 as an
// f32; the saturating `int.from_saturating` read that back as `max_value` and the cell
// said `some`. The bound is on the widened value now.
test "float32.from_checked at the Int bounds" {
  assert_eq(float32.from_checked(int.max_value()).is_none(), true)
  // 2^63 - 512 also rounds to 2^63 as an f32.
  assert_eq(float32.from_checked(9223372036854775296).is_none(), true)
  // -2^63 IS an f32 (a power of two).
  assert_eq(float32.from_checked(int.min_value()).is_some(), true)
  // 2^63 - 2^39 = 2^39 * (2^24 - 1): the largest f32 below 2^63.
  assert_eq(float32.from_checked(9223371487098961920).is_some(), true)
  assert_eq(float32.from_checked(4611686018427387904).is_some(), true)
  assert_eq(float32.from_checked(-9223372036854775807).is_none(), true)
}

// ── Int → sized int: _saturating ──
test "int8.from_saturating clamps to range" {
  assert_eq(int.from(int8.from_saturating(200)), 127)
  assert_eq(int.from(int8.from_saturating(-200)), -128)
  assert_eq(int.from(int8.from_saturating(0)), 0)
  assert_eq(int.from(int8.from_saturating(100)), 100)
}

test "uint8.from_saturating clamps" {
  assert_eq(int.from(uint8.from_saturating(-1)), 0)
  assert_eq(int.from(uint8.from_saturating(500)), 255)
  assert_eq(int.from(uint8.from_saturating(42)), 42)
}

test "int32.from_saturating clamps" {
  assert_eq(int.from(int32.from_saturating(3000000000)), 2147483647)
  assert_eq(int.from(int32.from_saturating(-3000000000)), -2147483648)
  assert_eq(int.from(int32.from_saturating(42)), 42)
}

test "uint64.from_saturating clamps negatives to zero" {
  assert_eq(int.from(uint64.from_saturating(-1)), 0)
  assert_eq(int.from(uint64.from_saturating(42)), 42)
}

// ── Float → sized int: _checked ──
test "int8.from_checked exact integers in range" {
  assert_eq(int.from(int8.from_checked(42.0)!), 42)
  assert_eq(int.from(int8.from_checked(-128.0)!), -128)
  assert_eq(int.from(int8.from_checked(127.0)!), 127)
}

test "int8.from_checked rejects out-of-range" {
  assert_eq(int8.from_checked(128.0).is_none(), true)
  assert_eq(int8.from_checked(-129.0).is_none(), true)
  assert_eq(int8.from_checked(10000000000.0).is_none(), true)
}

test "int8.from_checked rejects fractionals" {
  // Swift `Int(exactly:)` semantics — fractional part means not exact.
  assert_eq(int8.from_checked(42.5).is_none(), true)
  assert_eq(int8.from_checked(0.1).is_none(), true)
}

test "int32.from_checked rejects NaN and infinity" {
  let nan: Float = 0.0 / 0.0
  let inf: Float = 1.0 / 0.0
  assert_eq(int32.from_checked(nan).is_none(), true)
  assert_eq(int32.from_checked(inf).is_none(), true)
  assert_eq(int32.from_checked(-inf).is_none(), true)
  assert_eq(int.from(int32.from_checked(42.0)!), 42)
}

test "uint8.from_checked rejects negatives and NaN" {
  let nan: Float = 0.0 / 0.0
  assert_eq(uint8.from_checked(nan).is_none(), true)
  assert_eq(uint8.from_checked(-1.0).is_none(), true)
  assert_eq(uint8.from_checked(256.0).is_none(), true)
  assert_eq(int.from(uint8.from_checked(255.0)!), 255)
}

// #2487 — every Float → T cell at its EXACT bounds (MIN, MIN - 1, MAX, the
// first value outside, a half at the edge). `to_uint64_checked` compared its
// round trip through `int.from_wrapping`, which reinterprets [2^63, 2^64) as a
// negative Int, and answered `none` for every value at or above 2^63.
test "uint64.from_checked accepts the upper half of UInt64" {
  assert_eq(
    uint64.to_string(uint64.from_checked(9223372036854775808.0) ?? uint64.from(0)),
    "9223372036854775808",
  )
  // The largest f64 below 2^64.
  assert_eq(
    uint64.to_string(uint64.from_checked(18446744073709549568.0) ?? uint64.from(0)),
    "18446744073709549568",
  )
  assert_eq(uint64.from_checked(18446744073709551616.0).is_none(), true)
  // 2^63 + 0.5 IS 2^63 in f64 (the ulp there is 2048): still some.
  assert_eq(
    uint64.to_string(uint64.from_checked(9223372036854775808.0 + 0.5) ?? uint64.from(0)),
    "9223372036854775808",
  )
  assert_eq(uint64.from_checked(4503599627370495.5).is_none(), true)
  assert_eq(
    uint64.to_string(uint64.from_checked(4611686018427387904.0) ?? uint64.from(0)),
    "4611686018427387904",
  )
  assert_eq(uint64.from_checked(-1.0).is_none(), true)
  assert_eq(int.from(uint64.from_checked(-0.0)!), 0)
}

test "int64.from_checked at the Int64 bounds" {
  assert_eq(int.from(int64.from_checked(-9223372036854775808.0)!), -9223372036854775808)
  // The next f64 below -2^63.
  assert_eq(int64.from_checked(-9223372036854777856.0).is_none(), true)
  // The largest f64 below 2^63.
  assert_eq(int.from(int64.from_checked(9223372036854774784.0)!), 9223372036854774784)
  assert_eq(int64.from_checked(9223372036854775808.0).is_none(), true)
  assert_eq(int64.from_checked(4503599627370495.5).is_none(), true)
}

test "float to narrow int _checked: MIN, MIN - 1, MAX, MAX + 1, a half" {
  assert_eq(int.from(int8.from_checked(-128.0)!), -128)
  assert_eq(int8.from_checked(-129.0).is_none(), true)
  assert_eq(int8.from_checked(127.5).is_none(), true)
  assert_eq(int8.from_checked(-128.5).is_none(), true)
  assert_eq(int.from(int16.from_checked(-32768.0)!), -32768)
  assert_eq(int16.from_checked(-32769.0).is_none(), true)
  assert_eq(int.from(int16.from_checked(32767.0)!), 32767)
  assert_eq(int16.from_checked(32768.0).is_none(), true)
  assert_eq(int.from(int32.from_checked(-2147483648.0)!), -2147483648)
  assert_eq(int32.from_checked(-2147483649.0).is_none(), true)
  assert_eq(int.from(int32.from_checked(2147483647.0)!), 2147483647)
  assert_eq(int32.from_checked(2147483648.0).is_none(), true)
  assert_eq(int32.from_checked(2147483647.5).is_none(), true)
  assert_eq(uint8.from_checked(-0.5).is_none(), true)
  assert_eq(int.from(uint16.from_checked(65535.0)!), 65535)
  assert_eq(uint16.from_checked(65536.0).is_none(), true)
  assert_eq(int.from(uint32.from_checked(4294967295.0)!), 4294967295)
  assert_eq(uint32.from_checked(4294967296.0).is_none(), true)
  assert_eq(uint32.from_checked(4294967295.5).is_none(), true)
}

// ── Float → sized int: _saturating ──
test "int32.from_saturating clamps NaN and range" {
  let nan: Float = 0.0 / 0.0
  assert_eq(int.from(int32.from_saturating(nan)), 0)
  assert_eq(int.from(int32.from_saturating(100000000000000000000.0)), 2147483647)
  assert_eq(int.from(int32.from_saturating(-100000000000000000000.0)), -2147483648)
  assert_eq(int.from(int32.from_saturating(42.7)), 42)
}

test "uint16.from_saturating clamps" {
  let inf: Float = 1.0 / 0.0
  assert_eq(int.from(uint16.from_saturating(inf)), 65535)
  assert_eq(int.from(uint16.from_saturating(-1.0)), 0)
  assert_eq(int.from(uint16.from_saturating(1000.0)), 1000)
}

// ── Float → Float32: _checked (precision detection) ──
test "float32.from_checked round-trip exact" {
  assert_eq(float32.from_checked(0.5).is_some(), true)
  assert_eq(float32.from_checked(1.0).is_some(), true)
  assert_eq(float32.from_checked(-42.0).is_some(), true)
}

test "float32.from_checked rejects NaN and the infinities" {
  let nan: Float = 0.0 / 0.0
  let inf: Float = 1.0 / 0.0
  assert_eq(float32.from_checked(nan).is_none(), true)
  // C-307 rules the whole checked family the same way: ±inf is none, although
  // an f32 has both infinities and the round trip through them is exact.
  assert_eq(float32.from_checked(inf).is_none(), true)
  assert_eq(float32.from_checked(0.0 - inf).is_none(), true)
}

test "float32.from_checked rejects precision loss" {
  // 1.1 is not exactly representable in f32 (nor f64, but f32 rounds
  // to a different value — the round-trip detects the mismatch).
  assert_eq(float32.from_checked(1.1).is_none(), true)
}
