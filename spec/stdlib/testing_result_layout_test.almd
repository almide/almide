// The Result-assert payload-class matrix (#1233): assert_ok/assert_err read
// ONLY the variant tag, whose OFFSET follows the Ok side's layout — heap-Ok
// = cap-as-tag @16 (the plain twins), scalar-Ok = len-as-tag @4 (the `_sc`
// twins the v1 dispatch renames to). Each cell below EXECUTES on the wasm
// leg; a wrong tag offset dies (the twin's own prim.die), failing the test.
import testing

test "result asserts read the right tag on both layouts" {
  let a: Result[String, String] = ok("s")
  testing.assert_ok(a)
  let b: Result[List[Int], String] = err("boom")
  testing.assert_err(b)
  let c: Result[Int, String] = ok(1)
  testing.assert_ok(c)
  let d: Result[Int, String] = err("boom")
  testing.assert_err(d)
}
