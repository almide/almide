// wasm:skip — the server arm is `net`, which has no wasm host (#1628), and
// the test runner builds the stock artifact, which refuses the handle (E081,
// proofs/target-availability.toml). The handle itself runs on the embedded
// wasm lane (#2633): tests/http_call_handle_test.rs drives these cases on
// both legs against a Rust loopback server, byte-identical.
// #2631 / C-366 — the http call handle. `http.start` returns at once; `poll`
// and `read_new` never block; `wait` ends at the call's own limits; `cancel`
// closes the connection. A fired limit names itself:
// `request timeout: total_ms <n> exceeded` / `request timeout: idle_ms <n>
// exceeded`; a cancelled call is `request cancelled`. WHETHER a limit fires
// is the host's (the C-214 discipline), so the firing cases use wide margins:
// a server that talks every 50 ms for up to 10 s against a 400 ms wall clock,
// a server silent for 2 s against a 300 ms idle limit.
//
// Each test listens on port 0 BEFORE its `fan` and hands the listener to the
// server arm and the port the OS chose to the client arm (#4313: fixed ports
// collided with whatever else held them). The net handle tables are the
// program's, not a thread's (C-377), so an arm accepts on the test's
// listener, and the client's dial queues in the listen backlog until it does.
// The server arm proves the close from ITS side: it reads between events, and
// a read that answers end-of-stream or a reset is the client having closed
// the connection. A write the close answered first is the same end of the
// stream: EPIPE or ECONNRESET on unix, WSAECONNABORTED on Windows. A server
// that stopped early for any other reason ends the response, and the client's
// own verdict (a fired limit, a cancelled call) would not hold.
import env
import io
import http
import net

// Listen on a port the OS chooses: the listener and its port.
effect fn listen_any() -> Result[(net.TcpListener, Int), String] = {
  let server = net.tcp_listen("127.0.0.1", 0)!
  ok((server, net.tcp_local_port(server)!))
}

// Accept the client and read its request: the client's stream.
effect fn accept_real(server: net.TcpListener) -> Result[net.TcpStream, String] = {
  let peer = net.tcp_accept(server)!
  let _ = io.read(peer, 4096)!
  ok(peer)
}

// Has the client closed the connection? A read that answers end-of-stream
// says so. A read that errs is a quiet 50 ms or a reset (the answer to an
// event written after the close); a second, short read tells them apart — a
// live connection times out again, a reset one answers end-of-stream.
effect fn peer_closed(peer: net.TcpStream) -> Result[Bool, String] = match net.tcp_read_timeout(
  peer,
  64,
  50,
) {
  ok(b) => ok(bytes.len(b) == 0),
  err(_) => match net.tcp_read_timeout(peer, 64, 1) {
    ok(b) => ok(bytes.len(b) == 0),
    err(_) => ok(false),
  },
}

// Talk every 50 ms until the client closes; the number of events it took.
// The close shows as a read (`peer_closed`) or, when it lands between that
// read and the next event, as the event's write failing.
// A client that never closes ends the arm with an err after 200 events.
effect fn trickle(peer: net.TcpStream, i: Int) -> Result[Int, String] =
  if i >= 200 then err("the client never closed the connection")
  else if peer_closed(peer)! then ok(i)
  else match io.write(peer, bytes.from_string("data: ${i}\n\n")) {
    ok(_) => trickle(peer, i + 1),
    err(_) => ok(i),
  }

effect fn trickle_server(server: net.TcpListener) -> Result[Int, String] = {
  let peer = accept_real(server)!
  io.write(peer, bytes.from_string("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n\r\n"))!
  let n = trickle(peer, 0)!
  io.close(peer)!
  io.close(server)!
  ok(n)
}

effect fn silent_server(server: net.TcpListener) -> Result[Unit, String] = {
  let peer = accept_real(server)!
  env.sleep_ms(2000)
  io.close(peer)!
  io.close(server)!
  ok(())
}

effect fn answer_server(server: net.TcpListener, reply: String) -> Result[Unit, String] = {
  let peer = accept_real(server)!
  io.write(peer, bytes.from_string(reply))!
  io.close(peer)!
  io.close(server)!
  ok(())
}

fn outcome(r: Result[HttpResponse, String]) -> String = match r {
  ok(resp) => "${http.status(resp)} ${http.body(resp)}",
  err(e) => e,
}

fn polled(p: Result[HttpResponse, String]?) -> String = match p {
  some(r) => outcome(r),
  none => "pending",
}

effect fn wait_with(port: Int, total_ms: Int, idle_ms: Int) -> Result[String, String] = {
  let c = http.start(
    http.new_request("GET", "http://127.0.0.1:${port}/", "", []),
    { total_ms: total_ms, idle_ms: idle_ms },
  )!
  ok(outcome(http.wait(c)))
}

// Read for `rounds` turns of 100 ms without blocking; everything read.
effect fn gather(c: HttpCall, rounds: Int, acc: String) -> Result[String, String] = {
  let next = acc + http.read_new(c)
  if rounds == 0 then ok(next)
  else {
    env.sleep_ms(100)
    gather(c, rounds - 1, next)
  }
}

effect fn cancel_client(port: Int) -> Result[(String, String, String, String), String] = {
  let c = http.start(
    http.new_request("GET", "http://127.0.0.1:${port}/", "", []),
    { total_ms: 0, idle_ms: 0 },
  )!
  let before = polled(http.poll(c))
  let seen = gather(c, 5, "")!
  http.cancel(c)
  let after = gather(c, 3, "")!
  http.cancel(c)
  ok((before, seen, after, polled(http.poll(c))))
}

test "total_ms is a wall clock: a stream that keeps talking ends at it" {
  let (server, port) = listen_any()!
  let (served, answer) = fan {
    trickle_server(server)
    wait_with(port, 400, 0)
  }
  assert_eq(answer, "request timeout: total_ms 400 exceeded")
  // The server saw the close long before its own 200-event cap.
  assert(served < 150)
}

test "idle_ms bounds the wait for the first byte" {
  let (server, port) = listen_any()!
  let (_, answer) = fan {
    silent_server(server)
    wait_with(port, 0, 300)
  }
  assert_eq(answer, "request timeout: idle_ms 300 exceeded")
}

test "poll never blocks, cancel closes the connection and nothing arrives after it" {
  let (server, port) = listen_any()!
  let (served, (before, seen, after, final)) = fan {
    trickle_server(server)
    cancel_client(port)
  }
  assert_eq(before, "pending")
  assert(string.starts_with(seen, "data: 0\n\n"))
  assert_eq(after, "")
  assert_eq(final, "request cancelled")
  assert(served < 150)
}

test "wait answers the whole response, any status" {
  let (server, port) = listen_any()!
  let (_, answer) = fan {
    answer_server(server, "HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\n\r\ngone")
    wait_with(port, 5000, 0)
  }
  assert_eq(answer, "404 gone")
}

test "a limit below zero is refused at start" {
  let r = http.start(
    http.new_request("GET", "http://127.0.0.1:1/", "", []),
    { total_ms: 0, idle_ms: -1 },
  )
  match r {
    ok(_) => assert(false),
    err(e) => assert(string.starts_with(e, "invalid limits: ")),
  }
}
