// int64 / float64 — the two sized-numeric widths that had no module (#894).
//
// Every other width (`int8`, `int16`, `int32`, `uint8`, `uint16`, `uint32`,
// `uint64`, `float32`) shipped one; `Int64` and `Float64` did not, so the only
// route was the canonical pivot `int.to_string(int.from(x))` — which a
// reader who has used `int32.to_string` has no reason to look for. UFCS did not
// cover them either: `n.to_float64()` reported `expected Int64 but got
// fn() -> Float64` because the receiver-type table had no entry.
test "int64 conversions match the canonical pivot" {
  let n: Int64 = 7
  assert_eq(int64.to_string(n), "7")
  assert_eq(int64.to_string(n), int.to_string(int.from(n)))
  assert_eq(int32.from_wrapping(n), int32.from_wrapping(int.from(n)))
  assert_eq(float64.from(n), float64.from(int.from(n)))
}

test "float64 conversions match the canonical pivot" {
  let x: Float64 = 2.5
  assert_eq(float64.to_string(x), "2.5")
  assert_eq(float64.to_string(x), float.to_string(float.from(x)))
  assert_eq(int32.from_saturating(x), int32.from_saturating(float.from(x)))
  assert_eq(float32.from(x), float32.from(float.from(x)))
}

test "int64 and float64 dispatch through UFCS" {
  let n: Int64 = 7
  let x: Float64 = 2.5
  assert_eq(n.to_string(), "7")
  assert_eq(x.to_string(), "2.5")
  assert_eq(float64.from(n), 7.0)
  assert_eq(int64.from_saturating(x), 2)
}

test "negative values keep their sign through both modules" {
  let n: Int64 = 0 - 7
  let x: Float64 = 0.0 - 2.5
  assert_eq(int64.to_string(n), "-7")
  assert_eq(float64.to_string(x), "-2.5")
  // Float → int is a saturating TRUNCATION toward zero, not a round.
  assert_eq(int32.from_saturating(x), 0 - 2)
  assert_eq(float64.from(n), 0.0 - 7.0)
}

test "narrowing wraps rather than trapping, as in every other width" {
  let big: Int64 = 300
  assert_eq(int8.from_wrapping(big), int8.from_wrapping(300))
  assert_eq(uint8.from_wrapping(big), uint8.from_wrapping(300))
}
