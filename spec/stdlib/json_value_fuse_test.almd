// json_value_fuse_test — the optimizer's Value fusion against the tree.
//
// The reader: `json.parse(t) ?? value.null()` read once through
// `(value.as_array(_) ?? []) |> list.map(<a static Int path>)` runs a
// directed validating reader instead of building the tree. Every generated
// document (escapes, `\u`, repeated keys at every depth, deep nesting,
// numbers at the Int / Float boundary, every whitespace form, truncated and
// trailing-garbage inputs) must read the same through it as through the
// tree: where the reader answers, its column is the tree's; where the text
// is not a document, the reader refuses and the parser's verdict stands.
//
// The writer: `json.stringify(value.array(xs |> list.map(f)))` over a
// function whose tail is a constructor tree writes the text directly; it
// must be the runtime writer's text for every value.
import json

// ── generated documents ─────────────────────────────────────────────────
fn mix(x: Int) -> Int = (x % 2147483648 * 1103515245 + 12345) % 2147483648

fn pick(seed: Int, k: Int, n: Int) -> Int = mix(mix(seed + k * 7919) + k) / 8 % n

fn sub(seed: Int, k: Int) -> Int = mix(mix(seed) + k * 104729 + 1)

fn cp(n: Int) -> String = string.from_codepoint(n) ?? ""

fn ws(seed: Int, k: Int) -> String = match pick(seed, k, 9) {
  0 => " ",
  1 => "\n",
  2 => "\t",
  3 => "\r\n ",
  _ => "",
}

fn num(seed: Int) -> String = match pick(seed, 1, 26) {
  0 => "0",
  1 => "-0",
  2 => "12",
  3 => "-7",
  4 => "123456789012345678",
  5 => "-123456789012345678",
  6 => "9223372036854775807",
  7 => "9223372036854775808",
  8 => "-9223372036854775808",
  9 => "1.5",
  10 => "-0.25",
  11 => "1e5",
  12 => "1E-2",
  13 => "01",
  14 => "1.",
  15 => ".5",
  16 => "-",
  17 => "1e",
  18 => "1e999",
  19 => "1234567890123456789",
  20 => "0.0",
  21 => "2.50e+3",
  22 => "+1",
  23 => "1-2",
  _ => int.to_string(pick(seed, 2, 1000)),
}

fn str_body(seed: Int) -> String = match pick(seed, 3, 22) {
  0 => "",
  1 => "user_7",
  2 => "a b",
  3 => "\\n",
  4 => "\\\"",
  5 => "\\\\",
  6 => "\\/",
  7 => "\\u00e9",
  8 => "\\ud83d\\ude00",
  9 => "\\ud800",
  10 => "\\x",
  11 => cp(1),
  12 => "é",
  13 => cp(65535),
  14 => cp(64256),
  15 => cp(128512),
  16 => "\\u12",
  17 => "\\",
  _ => "abc",
}

fn str(seed: Int) -> String = "\"" + str_body(seed) + "\""

fn key(seed: Int) -> String = match pick(seed, 4, 16) {
  0 => "\"meta\"",
  1 => "\"score\"",
  2 => "\"id\"",
  3 => "\"name\"",
  4 => "\"a\"",
  5 => "\"b\"",
  6 => "\"c\"",
  7 => "\"active\"",
  8 => "\"x y\"",
  9 => "\"m\\u0065ta\"",
  10 => "\"é\"",
  11 => "\"\"",
  12 => "\"sc\\\"ore\"",
  13 => "\"scor\"",
  _ => "\"score\"",
}

fn val(seed: Int, depth: Int) -> String = match pick(seed, 5, 13) {
  0 => num(seed),
  1 => num(sub(seed, 1)),
  2 => int.to_string(pick(seed, 6, 100000)),
  3 => str(seed),
  4 => str(sub(seed, 2)),
  5 => "true",
  6 => "false",
  7 => "null",
  8 => "tru",
  9 => if depth < 4 then arr(sub(seed, 3), depth + 1) else "[]",
  _ => if depth < 4 then obj(sub(seed, 4), depth + 1) else "{}",
}

fn arr_items(seed: Int, depth: Int, i: Int, n: Int, acc: String) -> String =
  if i >= n then acc
  else {
    let sep = if i == 0 then ""
    else if pick(seed, 40 + i, 60) == 0 then " " else ","
    arr_items(
      seed,
      depth,
      i + 1,
      n,
      acc + sep + ws(seed, 50 + i) + val(sub(seed, 10 + i), depth) + ws(seed, 60 + i),
    )
  }

fn arr(seed: Int, depth: Int) -> String = {
  let n = pick(seed, 7, 5)
  let close = if n > 0 and pick(seed, 8, 40) == 0 then ",]" else "]"
  "[" + ws(seed, 9) + arr_items(seed, depth, 0, n, "") + close
}

fn field(seed: Int, depth: Int) -> String = {
  let colon = match pick(seed, 11, 50) {
    0 => " ",
    _ => ":",
  }
  let k = if pick(seed, 12, 50) == 0 then "id" else key(seed)
  k + ws(seed, 13) + colon + ws(seed, 14) + val(sub(seed, 5), depth)
}

fn obj_items(seed: Int, depth: Int, i: Int, n: Int, acc: String) -> String =
  if i >= n then acc
  else {
    // a repeated key now and then: the same field seed twice
    let fs = if i > 0 and pick(seed, 70 + i, 12) == 0 then sub(seed, 20) else sub(seed, 20 + i)
    obj_items(
      seed,
      depth,
      i + 1,
      n,
      acc + (if i == 0 then "" else ",") + ws(seed, 80 + i) + field(fs, depth),
    )
  }

fn obj(seed: Int, depth: Int) -> String = {
  let n = pick(seed, 15, 5)
  let close = if n > 0 and pick(seed, 16, 40) == 0 then ",}" else "}"
  "{" + ws(seed, 17) + obj_items(seed, depth, 0, n, "") + close
}

fn meta(seed: Int) -> String = match pick(seed, 18, 12) {
  0 => "{\"score\":" + num(seed) + ",\"active\":true}",
  1 => "{\"active\":false}",
  2 => "{\"score\":\"7\"}",
  3 => "7",
  4 => "[{\"score\":1}]",
  5 => "{\"score\":1,\"score\":2}",
  6 => "{\"score\":{\"score\":3}}",
  7 => "{ \"other\" : " + val(sub(seed, 6), 2) + " , \"score\" :\t" + int.to_string(pick(seed, 19, 1000)) + " }",
  8 => "null",
  _ => "{\"score\":" + int.to_string(pick(seed, 19, 1000) - 500) + ",\"active\":" + (if pick(
    seed,
    20,
    2,
  ) == 0 then "true" else "false") + "}",
}

fn record(seed: Int) -> String = match pick(seed, 21, 10) {
  0 => "{\"meta\":" + meta(seed) + "}",
  1 => "{\"score\":" + num(seed) + ",\"meta\":" + meta(seed) + "}",
  2 => "{\"a\":{\"b\":{\"c\":" + num(seed) + "}},\"meta\":" + meta(seed) + "}",
  3 => "{\"a\":{\"b\":{\"c\":" + int.to_string(pick(seed, 22, 99)) + ",\"d\":" + str(seed) + "}},\"score\":" + int.to_string(pick(seed, 23, 99)) + "}",
  4 => "{\"m\\u0065ta\":" + meta(seed) + "}",
  5 => "{\"meta\":" + meta(seed) + ",\"tags\":" + arr(sub(seed, 7), 2) + ",\"meta\":1}",
  _ => "{" + ws(seed, 24) + "\"id\"" + ws(seed, 25) + ":" + int.to_string(pick(seed, 26, 50000)) + ",\"name\":" + str(seed) + ",\"tags\":[\"t" + int.to_string(pick(seed, 27, 7)) + "\"," + str(sub(seed, 8)) + "]," + ws(
    seed,
    28,
  ) + "\"meta\":" + ws(seed, 29) + meta(seed) + ws(seed, 30) + "}",
}

fn elems(seed: Int, i: Int, n: Int, acc: String) -> String =
  if i >= n then acc
  else {
    let s = sub(seed, 30 + i)
    let e = if pick(s, 31, 4) == 0 then val(s, 1) else record(s)
    elems(seed, i + 1, n, acc + (if i == 0 then "" else ",") + ws(s, 32) + e + ws(s, 33))
  }

fn deep(d: Int) -> String = string.repeat("[", d) + "1" + string.repeat("]", d)

fn body(seed: Int) -> String = match pick(seed, 34, 24) {
  0 => obj(seed, 0),
  1 => val(seed, 3),
  2 => deep(200),
  3 => deep(300),
  4 => deep(1000),
  5 => deep(1001),
  6 => string.repeat("[{\"a\":", 150) + "1" + string.repeat("}]", 150),
  7 => "",
  _ => ws(seed, 35) + "[" + ws(seed, 36) + elems(seed, 0, pick(seed, 37, 7), "") + "]" + ws(
    seed,
    38,
  ),
}

fn doc(seed: Int) -> String = {
  let t = body(seed)
  match pick(seed, 39, 24) {
    0 => string.take(t, pick(seed, 40, string.len(t) + 1)),
    1 => t + "x",
    2 => t + " ]",
    3 => "," + t,
    4 => t + " \n",
    5 => t + ",",
    _ => t,
  }
}

// ── the tree's reading, spelled so that no rewrite applies ───────────────
fn leaf_ref(v: Value, keys: List[String], i: Int, d: Int) -> Int =
  if i + 1 >= list.len(keys) then value.get_int(v, list.get(keys, i) ?? "") ?? d
  else leaf_ref(value.get(v, list.get(keys, i) ?? "") ?? value.null(), keys, i + 1, d)

fn col_ref(xs: List[Value], keys: List[String], d: Int, i: Int, acc: List[Int]) -> List[Int] =
  if i >= list.len(xs) then acc
  else col_ref(
    xs,
    keys,
    d,
    i + 1,
    acc + [
      leaf_ref(list.get(xs, i) ?? value.null(), keys, 0, d)
    ],
  )

fn tree(text: String, keys: List[String], d: Int) -> List[Int] = match json.parse(text) {
  ok(v) => match value.as_array(v) {
    ok(xs) => col_ref(xs, keys, d, 0, []),
    err(_) => [],
  },
  err(_) => [],
}

// ── the same readings in the shape the rewrite takes ────────────────────
fn score_a(r: Value) -> Int = value.get_int(value.get(r, "meta") ?? value.null(), "score") ?? 0

fn fused_a(text: String) -> List[Int] = {
  let back = json.parse(text) ?? value.null()
  (value.as_array(back) ?? []) |> list.map(score_a)
}

fn fused_b(text: String) -> List[Int] = (value.as_array(json.parse(text) ?? value.null()) ?? []) |> list.map((r) => value.get_int(r, "score") ?? -1)

fn score_c(r: Value) -> Int = value.get_int(
  value.get(value.get(r, "a") ?? value.null(), "b") ?? value.null(),
  "c",
) ?? 7

fn fused_c(text: String) -> List[Int] = {
  let back = json.parse(text) ?? value.null()
  let col = (value.as_array(back) ?? []) |> list.map((r) => score_c(r))
  col
}

fn agree(text: String) -> Bool = fused_a(text) == tree(text, ["meta", "score"], 0) and fused_b(text) == tree(
  text,
  ["score"],
  -1,
) and fused_c(text) == tree(text, ["a", "b", "c"], 7)

fn first_bad(i: Int, n: Int) -> String =
  if i >= n then ""
  else {
    let t = doc(i * 2654435 + 17)
    if agree(t) then first_bad(i + 1, n) else "seed ${i}: ${t}"
  }

test "the directed reader reads generated documents as the tree does" {
  assert_eq(first_bad(0, 800), "")
  assert_eq(first_bad(800, 1600), "")
  assert_eq(first_bad(1600, 2400), "")
}

test "the directed reader on the documents written by hand" {
  let good = "[{\"id\":1,\"meta\":{\"score\":5,\"active\":true}}, {\"meta\":{\"score\":-12}} ,{\"meta\":{}}, 3, \"s\", null, [], {}]"
  assert_eq(fused_a(good), [
    5,
    -12,
    0,
    0,
    0,
    0,
    0,
    0
  ])
  assert_eq(fused_a("[]"), [])
  assert_eq(fused_a(" [ ] "), [])
  assert_eq(fused_a("[{\"meta\":{\"score\":1.0}}]"), [0])
  assert_eq(fused_a("[{\"meta\":{\"score\":9223372036854775807}}]"), [9223372036854775807])
  assert_eq(fused_a("[{\"meta\":{\"score\":-9223372036854775808}}]"), [-9223372036854775807 - 1])
  assert_eq(fused_a("[{\"meta\":{\"score\":9223372036854775808}}]"), [])
  assert_eq(fused_a("[{\"m\\u0065ta\":{\"score\":4}}]"), [4])
  assert_eq(fused_a("[{\"meta\":{\"score\":4},\"meta\":{\"score\":5}}]"), [])
  assert_eq(fused_a("[{\"meta\":{\"score\":4}},]"), [])
  assert_eq(fused_a("[{\"meta\":{\"score\":4}}] x"), [])
  assert_eq(fused_a("{\"meta\":{\"score\":4}}"), [])
  assert_eq(fused_a(""), [])
  assert_eq(fused_b("[{\"score\":3},{\"scor\":3},{\"score\":\"3\"}]"), [3, -1, -1])
  assert_eq(
    fused_c("[{\"a\":{\"b\":{\"c\":1}}},{\"a\":{\"b\":2}},{\"a\":[{\"b\":{\"c\":3}}]}]"),
    [1, 7, 7],
  )
}

// ── the writer ──────────────────────────────────────────────────────────
fn label(i: Int) -> String = match i % 9 {
  0 => "plain",
  1 => "quo\"te",
  2 => "back\\slash",
  3 => "line\nbreak",
  4 => "é ü",
  5 => cp(1) + "ctl",
  6 => cp(128512),
  7 => "",
  _ => "tab\there",
}

fn ratio(i: Int) -> Float = match i % 6 {
  0 => 1.0,
  1 => 0.1,
  2 => -2.5e10,
  3 => 0.0 / 0.0,
  4 => 1.0 / 0.0,
  _ => 22.0 / 7.0,
}

fn opaque(i: Int) -> Value =
  if i % 2 == 0 then value.string(label(i))
  else value.array([value.int(i), value.null()])

fn rec(i: Int) -> Value = value.object([
  ("id", value.int(i)),
  ("name", value.string("user_${i}")),
  ("neg", value.int(0 - i * 1000003)),
  ("ok", value.bool(i % 3 == 0)),
  ("flag", value.string("on=${i % 2 == 0} n=${i}")),
  ("tags", value.array([value.string("t${i % 7}"), value.string(label(i)), value.string("fixed")])),
  ("meta", value.object([("score", value.int(i * 37 % 1000)), ("none", value.null()), ("f", value.float(ratio(i)))])),
  ("raw", opaque(i)),
  ("empty", value.object([])),
  ("list", value.array([]))
])

fn pair(a: Int, b: Int) -> Value = {
  let lo = int.min(a, b)
  let hi = int.max(a, b)
  value.array([value.int(lo), value.int(hi), rec(lo)])
}

// The runtime writer's text: the tree is held twice, so nothing is fused.
fn written(v: Value) -> String = {
  let both = [v, v]
  json.stringify(list.get(both, 1) ?? value.null())
}

fn rec_written(i: Int) -> String = {
  let v = rec(i)
  written(v)
}

fn first_bad_rec(i: Int, n: Int) -> String =
  if i >= n then ""
  else if json.stringify(rec(i)) == rec_written(i) then first_bad_rec(i + 1, n)
  else "rec ${i}: ${json.stringify(rec(i))}"

test "a constructor tree is written as the runtime writer writes it" {
  assert_eq(first_bad_rec(0, 300), "")
  assert_eq(json.stringify(rec(-9223372036854775807 - 1)), rec_written(-9223372036854775807 - 1))
  assert_eq(json.stringify(pair(9, 4)), written(pair(9, 4)))
}

test "an array of produced records is written as the runtime writer writes it" {
  let direct = json.stringify(value.array(list.range(0, 120) |> list.map(rec)))
  let doc = value.array(list.range(0, 120) |> list.map(rec))
  let text = json.stringify(doc)
  let held = value.array(list.range(0, 120) |> list.map(rec))
  let n = list.len(value.as_array(held) ?? [])
  assert_eq(n, 120)
  assert_eq(direct, json.stringify(held))
  assert_eq(text, json.stringify(held))
  assert_eq(json.stringify(value.array(list.range(0, 0) |> list.map(rec))), "[]")
  let inline = json.stringify(value.object([("k", value.int(n)), ("s", value.string("a\"b")), ("v", held)]))
  assert_eq(string.starts_with(inline, "{\"k\":120,\"s\":\"a\\\"b\",\"v\":[{\"id\":0,"), true)
}

fn wrap(i: Int) -> Value = value.object([("r", rec(i)), ("p", pair(i, 3)), ("o", opaque(i))])

test "a producer that calls producers is written as the runtime writer writes it" {
  let held = value.array(list.range(0, 60) |> list.map(wrap))
  assert_eq(list.len(value.as_array(held) ?? []), 60)
  assert_eq(json.stringify(value.array(list.range(0, 60) |> list.map(wrap))), json.stringify(held))
  let pairs = value.array(list.range(0, 9) |> list.map((i) => pair_of(i)))
  assert_eq(
    json.stringify(pairs),
    written(value.array(list.range(0, 9) |> list.map((i) => pair_of(i)))),
  )
}

fn pair_of(i: Int) -> Value = pair(i * 7 % 5, i)

test "a written document reads back through the directed reader" {
  let text = json.stringify(value.array(list.range(0, 500) |> list.map(rec)))
  let back = json.parse(text) ?? value.null()
  let sum = (value.as_array(back) ?? []) |> list.map(score_a) |> list.sum
  assert_eq(sum, tree(text, ["meta", "score"], 0) |> list.sum)
  assert_eq(sum > 0, true)
}

// ── every leaf kind, several leaves per element, aliases, rows under a key,
//    a document read as an object, `match` and `!` spellings of the parse ──
fn show_i(o: Int?) -> String = match o {
  some(n) => "i${n}",
  none => "-",
}

// The bits, so that -0.0, an infinity and every last digit count.
fn show_f(o: Float?) -> String = match o {
  some(f) => "f${float.to_bits(f)}",
  none => "-",
}

fn show_b(o: Bool?) -> String = match o {
  some(b) => if b then "T" else "F",
  none => "-",
}

fn show_s(o: String?) -> String = match o {
  some(s) => "s${string.len(s)}<${s}>",
  none => "-",
}

// The tree's reading, spelled so that no rewrite applies: the keys are
// values and every function takes the tree with something else.
fn at(v: Value, keys: List[String], i: Int) -> Value =
  if i >= list.len(keys) then v
  else at(value.get(v, list.get(keys, i) ?? "") ?? value.null(), keys, i + 1)

fn cell_ref(v: Value, keys: List[String], k: String) -> String = {
  let o = at(v, keys, 0)
  show_i(value.get_int(o, k)) + show_f(value.get_float(o, k)) + show_b(value.get_bool(o, k)) + show_s(value.get_string(o, k))
}

fn row_ref(v: Value, sep: String) -> String = cell_ref(v, [], "score") + "|" + cell_ref(
  v,
  ["meta"],
  "score",
) + "|" + cell_ref(v, ["meta"], "active") + "|" + cell_ref(v, [], "name") + "|" + cell_ref(
  v,
  [],
  "id",
) + "|" + cell_ref(v, ["a", "b"], "c") + "|" + cell_ref(v, ["a", "b"], "d") + sep

// The same 28 readings as a reader function: four kinds at seven paths,
// two of the objects on the way held in aliases.
fn row_fused(x: Value) -> String = {
  let m = value.get(x, "meta") ?? value.null()
  let ab = value.get(value.get(x, "a") ?? value.null(), "b") ?? value.null()
  show_i(value.get_int(x, "score")) + show_f(value.get_float(x, "score")) + show_b(value.get_bool(x, "score")) + show_s(value.get_string(x, "score")) + "|" + show_i(value.get_int(m, "score")) + show_f(value.get_float(m, "score")) + show_b(value.get_bool(m, "score")) + show_s(value.get_string(m, "score")) + "|" + show_i(value.get_int(m, "active")) + show_f(value.get_float(m, "active")) + show_b(value.get_bool(m, "active")) + show_s(value.get_string(m, "active")) + "|" + show_i(value.get_int(x, "name")) + show_f(value.get_float(x, "name")) + show_b(value.get_bool(x, "name")) + show_s(value.get_string(x, "name")) + "|" + show_i(value.get_int(x, "id")) + show_f(value.get_float(x, "id")) + show_b(value.get_bool(x, "id")) + show_s(value.get_string(x, "id")) + "|" + show_i(value.get_int(ab, "c")) + show_f(value.get_float(ab, "c")) + show_b(value.get_bool(ab, "c")) + show_s(value.get_string(ab, "c")) + "|" + show_i(value.get_int(ab, "d")) + show_f(value.get_float(ab, "d")) + show_b(value.get_bool(ab, "d")) + show_s(value.get_string(ab, "d"))
}

fn rows_ref(text: String) -> List[String] = match json.parse(text) {
  ok(v) => match value.as_array(v) {
    ok(xs) => xs |> list.map((e) => row_ref(e, "")),
    err(_) => [],
  },
  err(_) => [],
}

fn rows_fused(text: String) -> List[String] = {
  let d = json.parse(text) ?? value.null()
  (value.as_array(d) ?? []) |> list.map((x) => row_fused(x))
}

// A fold straight over the rows, the parse spelled as a match.
fn fold_ref(text: String) -> String = match json.parse(text) {
  ok(v) => match value.as_array(v) {
    ok(xs) => xs |> list.fold(
      "",
      (acc, e) => acc + cell_ref(e, [], "id") + cell_ref(e, ["meta"], "score") + ";",
    ),
    err(_) => "",
  },
  err(_) => "",
}

fn fold_fused(text: String) -> String = {
  let d = match json.parse(text) {
    ok(v) => v,
    err(_) => value.null(),
  }
  list.fold(
    value.as_array(d) ?? [],
    "",
    (acc, x) => {
      let m = value.get(x, "meta") ?? value.null()
      acc + show_i(value.get_int(x, "id")) + show_f(value.get_float(x, "id")) + show_b(value.get_bool(x, "id")) + show_s(value.get_string(x, "id")) + show_i(value.get_int(m, "score")) + show_f(value.get_float(m, "score")) + show_b(value.get_bool(m, "score")) + show_s(value.get_string(m, "score")) + ";"
    },
  )
}

// A document read as an object: leaves of the root, an object under a key
// handed to the reader function, the rows under another key counted and
// filtered without a list of them.
fn wrapped(seed: Int) -> String = match pick(seed, 41, 6) {
  0 => record(seed),
  1 => doc(seed),
  2 => "{\"data\":" + doc(seed) + ",\"total\":" + num(sub(seed, 51)) + "}",
  _ => "{\"total\":" + num(sub(seed, 51)) + ",\"owner\":" + record(sub(seed, 50)) + ",\"data\":" + doc(seed) + "}",
}

fn obj_ref(text: String) -> String = match json.parse(text) {
  ok(v) => {
    let rows = match value.as_array(at(v, ["data"], 0)) {
      ok(xs) => xs,
      err(_) => [],
    }
    let ids = rows |> list.filter_map((e) => value.get_int(at(e, [], 0), list.get(["id"], 0) ?? ""))
    cell_ref(v, [], "total") + "/" + row_ref(at(v, ["owner"], 0), "") + "/" + cell_ref(
      v,
      ["owner", "meta"],
      "score",
    ) + "/${ids}"
  },
  err(e) => "E",
}

fn obj_fused(text: String) -> String = {
  let d = json.parse(text) ?? value.null()
  let total = show_i(value.get_int(d, "total")) + show_f(value.get_float(d, "total")) + show_b(value.get_bool(d, "total")) + show_s(value.get_string(d, "total"))
  let owner = value.get(d, "owner") ?? value.null()
  let om = value.get(owner, "meta") ?? value.null()
  let deep = show_i(value.get_int(om, "score")) + show_f(value.get_float(om, "score")) + show_b(value.get_bool(om, "score")) + show_s(value.get_string(om, "score"))
  let ids = (value.get_array(d, "data") ?? []) |> list.filter_map((x) => value.get_int(x, "id"))
  total + "/" + row_fused(owner) + "/" + deep + "/${ids}"
}

fn obj_ref_or_e(text: String) -> String = match json.parse(text) {
  ok(_) => obj_ref(text),
  err(_) => total_of_null(),
}

// What obj_fused answers for a text that is no document: every read of null.
fn total_of_null() -> String = "----/" + row_ref(value.null(), "") + "/----/[]"

// The parse unwrapped with `!`: the error is the parser's, text and all.
effect fn strict_fused(text: String) -> Result[String, String] = {
  let d = json.parse(text)!
  let n = (value.as_array(d) ?? []) |> list.map((x) => value.get_int(x, "score") ?? 0) |> list.sum
  ok("${n}")
}

effect fn strict_ref(text: String) -> Result[String, String] = match json.parse(text) {
  ok(v) => ok("${tree(text, ["score"], 0) |> list.sum}"),
  err(e) => err(e),
}

fn shown(r: Result[String, String]) -> String = match r {
  ok(s) => "ok " + s,
  err(e) => "err " + e,
}

fn agree_wide(text: String) -> Bool = rows_fused(text) == rows_ref(text) and fold_fused(text) == fold_ref(text) and obj_fused(text) == obj_ref_or_e(text)

fn first_bad_wide(i: Int, n: Int) -> String =
  if i >= n then ""
  else {
    let a = doc(i * 2654435 + 17)
    let b = wrapped(i * 40503 + 5)
    if not agree_wide(a) then "doc ${i}: ${a}"
    else if not agree_wide(b) then "wrapped ${i}: ${b}"
    else first_bad_wide(i + 1, n)
  }

test "every leaf kind at several paths reads generated documents as the tree does" {
  assert_eq(first_bad_wide(0, 600), "")
  assert_eq(first_bad_wide(600, 1200), "")
  assert_eq(first_bad_wide(1200, 1800), "")
  assert_eq(first_bad_wide(1800, 2400), "")
}

test "a parse unwrapped with ! keeps the parser's error for every generated document" {
  for i in list.range(0, 2400) {
    let a = doc(i * 2654435 + 17)
    assert_eq(shown(strict_fused(a)), shown(strict_ref(a)))
  }
  for i in list.range(0, 54) {
    let t = "[{\"score\":" + edge_num(i) + "},{\"score\":1}]"
    assert_eq(shown(strict_fused(t)), shown(strict_ref(t)))
  }
}

// ── boundary families: every number and string form on the path, off the
//    path, as a bare element and as a key ──
fn edge_num(i: Int) -> String = list.get(
  [
    "9223372036854775807",
    "9223372036854775808",
    "-9223372036854775808",
    "-9223372036854775809",
    "999999999999999999",
    "1000000000000000000",
    "9999999999999999999",
    "10000000000000000000",
    "99999999999999999999",
    "-999999999999999999",
    "-1000000000000000000",
    "-9999999999999999999",
    "0",
    "-0",
    "00",
    "01",
    "-01",
    "0.0",
    "-0.0",
    "1e0",
    "1E+0",
    "1e-0",
    "0e0",
    "-0e0",
    "1e",
    "1e+",
    "1.e1",
    "1.5e",
    "1.0e308",
    "1.7976931348623157e308",
    "1e309",
    "-1e309",
    "1e-400",
    "4.9e-324",
    "123456789012345678901234567890.5",
    "123456789012345678901234567890",
    "0.1e1",
    "0.30000000000000004",
    "2.5",
    "100",
    "1E5",
    "1e05",
    "-",
    "--1",
    "+1",
    "0x10",
    "1_000",
    "Infinity",
    "NaN",
    ".5",
    "5.",
    "1 2",
    "1e1.5"
  ],
  i,
) ?? ""

fn edge_str(i: Int) -> String = list.get(
  [
    "",
    "plain",
    "é",
    "日本語",
    cp(128512),
    cp(65533),
    cp(65535),
    cp(65534),
    cp(64976),
    cp(65279),
    cp(983039),
    cp(1114111),
    cp(127),
    cp(1),
    cp(31),
    "\\u0000",
    "\\u00e9",
    "\\ud83d\\ude00",
    "\\ud800",
    "\\udc00",
    "\\ud83d\\u0041",
    "\\ud83dx",
    "\\uFFFF",
    "\\ufdd0",
    "\\uD834\\uDD1E",
    "\\b\\f\\n\\r\\t\\/\\\\\\\"",
    "\\x",
    "\\u12",
    "\\u12g4",
    "\\",
    "a\\u0062c",
    "tab\\tand " + cp(128512),
    "é\\n",
    "q\\\"q"
  ],
  i,
) ?? ""

fn edge_docs(v: String) -> List[String] = [
  "[{\"score\":" + v + ",\"id\":" + v + ",\"name\":" + v + "}]",
  "[{\"meta\":{\"score\":" + v + ",\"active\":" + v + "}}]",
  "[{\"other\":" + v + ",\"score\":5,\"name\":\"n\"}]",
  "[" + v + ",{\"id\":3}]",
  "[{\"a\":{\"b\":{\"c\":" + v + ",\"d\":" + v + "}}}," + v + "]",
  "{\"total\":" + v + ",\"owner\":{\"name\":" + v + ",\"meta\":{\"score\":" + v + "}},\"data\":[{\"id\":" + v + "}]}",
  "{\"data\":[{\"id\":1}],\"extra\":[" + v + "],\"total\":7}"
]

fn first_bad_edge(vs: List[String]) -> String = vs |> list.flat_map(edge_docs) |> list.find((t) => not agree_wide(t)) ?? ""

test "numbers at every boundary read as the tree reads them, on and off the path" {
  assert_eq(first_bad_edge(list.range(0, 54) |> list.map(edge_num)), "")
}

test "strings in every spelling read as the tree reads them, on and off the path" {
  assert_eq(first_bad_edge(list.range(0, 35) |> list.map((i) => "\"" + edge_str(i) + "\"")), "")
}

test "keys in every spelling are found, missed or refused as the tree has them" {
  let keys = list.range(0, 35) |> list.map((i) => "\"" + edge_str(i) + "\"")
  let docs = keys |> list.flat_map((k) => [
    "[{" + k + ":1,\"score\":2,\"id\":3}]",
    "[{\"score\":2," + k + ":{\"score\":9}," + k + ":1}]",
    "{" + k + ":{\"meta\":{\"score\":4}},\"total\":1,\"data\":[{" + k + ":5,\"id\":6}]}",
    "[{\"a\":1,\"\\u0061\":2,\"score\":3}]",
    "[{\"score\":1,\"sc\\u006fre\":2}]"
  ])
  assert_eq(docs |> list.find((t) => not agree_wide(t)) ?? "", "")
}

test "the wide readers on documents written by hand" {
  let t = "[{\"id\":7,\"name\":\"a\\u00e9\\n\",\"score\":1.5e1,\"meta\":{\"score\":-3,\"active\":true}},{\"a\":{\"b\":{\"c\":null,\"d\":\"x\"}}}]"
  assert_eq(rows_fused(t), rows_ref(t))
  assert_eq(list.len(rows_fused(t)), 2)
  assert_eq(fold_fused(t), "i7f${float.to_bits(7.0)}--i-3f${float.to_bits(-3.0)}--;--------;")
  let o = "{\"total\":1234567890123456789,\"owner\":{\"name\":\"" + cp(128512) + "\",\"meta\":{\"score\":true}},\"data\":[{\"id\":1},{\"id\":2.0},3,{\"id\":4}]}"
  assert_eq(obj_fused(o), obj_ref(o))
  assert_eq(string.ends_with(obj_fused(o), "/--T-/[1, 4]"), true)
  assert_eq(shown(strict_fused("[{\"score\":2},{\"score\":40}]")), "ok 42")
  assert_eq(shown(strict_fused("[{\"score\":2},]")), shown(strict_ref("[{\"score\":2},]")))
  assert_eq(string.starts_with(shown(strict_fused("[1,]")), "err "), true)
}
