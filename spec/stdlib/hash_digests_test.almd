// hash.crc32 / adler32 (R-hash-02) and md5 / sha1 / sha512 with their _hex
// forms (R-hash-03). Vectors: RFC 1321, FIPS 180-4, and the CRC-32 check value.
import hash

fn b(s: String) -> Bytes = bytes.from_string(s)

test "crc32 and adler32 check values" {
  assert_eq(hash.crc32(b("123456789")), 3421780262)
  assert_eq(hash.crc32(b("")), 0)
  assert_eq(hash.crc32(b("The quick brown fox jumps over the lazy dog")), 1095738169)
  assert_eq(hash.adler32(b("Wikipedia")), 300286872)
  assert_eq(hash.adler32(b("")), 1)
}

test "md5 RFC 1321 vectors" {
  assert_eq(hash.md5_hex(b("")), "d41d8cd98f00b204e9800998ecf8427e")
  assert_eq(hash.md5_hex(b("abc")), "900150983cd24fb0d6963f7d28e17f72")
  assert_eq(hash.md5_hex(b("message digest")), "f96b697d7cb7938d525a2f31aaf161d0")
  assert_eq(
    hash.md5_hex(b("12345678901234567890123456789012345678901234567890123456789012345678901234567890")),
    "57edf4a22be3c955ac49da2e2107b67a",
  )
  assert_eq(bytes.len(hash.md5(b("abc"))), 16)
}

test "sha1 FIPS 180-4 vectors" {
  assert_eq(hash.sha1_hex(b("")), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
  assert_eq(hash.sha1_hex(b("abc")), "a9993e364706816aba3e25717850c26c9cd0d89d")
  assert_eq(
    hash.sha1_hex(b("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
    "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
  )
  assert_eq(bytes.len(hash.sha1(b("abc"))), 20)
}

test "sha512 FIPS 180-4 vectors" {
  assert_eq(
    hash.sha512_hex(b("abc")),
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
  )
  assert_eq(
    hash.sha512_hex(b("")),
    "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
  )
  assert_eq(bytes.len(hash.sha512(b("abc"))), 64)
}

test "padding edges at the block boundary" {
  assert_eq(hash.md5_hex(b(string.repeat("a", 55))), "ef1772b6dff9a122358552954ad0df65")
  assert_eq(hash.md5_hex(b(string.repeat("a", 56))), "3b0c8ac703f828b04c6c197006d17218")
  assert_eq(hash.sha1_hex(b(string.repeat("a", 64))), "0098ba824b5c16427bd7a1122a5a442a25ec644d")
  assert_eq(
    hash.sha512_hex(b(string.repeat("a", 112))),
    "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca",
  )
}

test "the bytes form and the hex form agree" {
  let x = b("hello")
  assert_eq(
    hash.md5_hex(x),
    list.join(
      bytes.to_list(hash.md5(x)) |> list.map((n) => string.pad_start(int.to_hex(n), 2, "0")),
      "",
    ),
  )
  assert_eq(
    hash.sha1_hex(x),
    list.join(
      bytes.to_list(hash.sha1(x)) |> list.map((n) => string.pad_start(int.to_hex(n), 2, "0")),
      "",
    ),
  )
}
