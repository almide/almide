// ALS-B1..B11 — the bounded profile's ADMISSIBLE side, as value assertions
// (C-308, C-310, C-311, C-313, C-314, C-318). The rejections live in
// tests/diagnostics/e07x-bounded-*/.
type State = { pos: Int, vel: Int }

@bounded
fn scale(x: Int) -> Int = x * 3

@bounded
fn double(x: Int) -> Int = x * 2

@bounded
fn quadruple(x: Int) -> Int = double(double(x))

@bounded
fn triangle() -> Int = {
  var acc = 0
  for i in 1...10 { acc = acc + i }
  acc
}

@bounded
fn grid_sum() -> Int = {
  var acc = 0
  for i in 0..<4 { for j in 0..<3 { acc = acc + i * j } }
  acc
}

@bounded
fn factorial_10() -> Int = {
  var acc = 1
  for i in 1...10 { acc = acc * i }
  acc
}

@bounded
fn dot(xs: List[Int], ys: List[Int]) -> Int = {
  var acc = 0
  for i in 0..<3 { acc = acc + (list.get(xs, i) ?? 0) * (list.get(ys, i) ?? 0) }
  acc
}

@bounded
fn step(s: State, accel: Int) -> State = State { pos: s.pos + s.vel, vel: s.vel + accel }

@bounded
fn simulate(accel: Int) -> State = {
  var s = State { pos: 0, vel: 0 }
  for i in 0..<10 { s = step(s, accel) }
  s
}

test "B1: a @bounded function is an ordinary function" {
  assert_eq(scale(4), 12)
}

test "B3: counted loops with literal bounds, nested, are admissible" {
  assert_eq(triangle(), 55)
  assert_eq(grid_sum(), 18)
}

test "B4: reading heap values inside a counted loop is admissible" {
  assert_eq(dot([1, 2, 3], [4, 5, 6]), 32)
}

test "B6: iteration replaces recursion" {
  assert_eq(factorial_10(), 3628800)
}

test "B7: @bounded calls @bounded and first-order stdlib" {
  assert_eq(quadruple(5), 20)
  assert_eq(math.max(quadruple(1), 3), 4)
}

test "B11: defaulting inside the loop is admissible; records flow through" {
  let s = simulate(2)
  assert_eq(s.pos, 90)
  assert_eq(s.vel, 20)
}
