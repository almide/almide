// The UTF-8 producer evidence for the producers no signature names: string
// concatenation, interpolation and the display of every container shape
// (#4005 A4, proofs/utf8-producers.toml, the [[mint]] and [[helper]] rows),
// over the invalid-byte corpus (through the validating front door) and the
// valid text beside every boundary.

// ── the oracle: RFC 3629 well-formedness of a String's bytes ──
fn utf8_in(bs: List[Int], i: Int, lo: Int, hi: Int) -> Bool = match list.get(bs, i) {
  some(b) => b >= lo and b <= hi,
  none => false,
}

fn utf8_cont(bs: List[Int], i: Int, n: Int) -> Bool =
  if n == 0 then true
  else utf8_in(bs, i, 128, 191) and utf8_cont(bs, i + 1, n - 1)

fn utf8_width(bs: List[Int], i: Int, b: Int) -> Int =
  if b < 128 then 1
  else if b >= 194 and b <= 223 then (if utf8_cont(bs, i + 1, 1) then 2 else 0)
  else if b == 224 then (if utf8_in(bs, i + 1, 160, 191) and utf8_cont(bs, i + 2, 1) then 3 else 0)
  else if b == 237 then (if utf8_in(bs, i + 1, 128, 159) and utf8_cont(bs, i + 2, 1) then 3 else 0)
  else if b >= 225 and b <= 239 then (if utf8_cont(bs, i + 1, 2) then 3 else 0)
  else if b == 240 then (if utf8_in(bs, i + 1, 144, 191) and utf8_cont(bs, i + 2, 2) then 4 else 0)
  else if b >= 241 and b <= 243 then (if utf8_cont(bs, i + 1, 3) then 4 else 0)
  else if b == 244 then (if utf8_in(bs, i + 1, 128, 143) and utf8_cont(bs, i + 2, 2) then 4 else 0)
  else 0

fn utf8_from(bs: List[Int], i: Int, n: Int) -> Bool =
  if i >= n then true
  else {
    let w = utf8_width(bs, i, list.get(bs, i) ?? 0)
    if w == 0 then false else utf8_from(bs, i + w, n)
  }

fn utf8_ok(s: String) -> Bool = {
  let bs = bytes.to_list(bytes.from_string(s))
  utf8_from(bs, 0, list.len(bs))
}

// ── the invalid input: every class of ill-formed UTF-8 ──
fn invalid_corpus() -> List[Bytes] = [
  bytes.from_list([0xFF]),
  bytes.from_list([0xFE, 0x41]),
  bytes.from_list([0xC0, 0xAF]),
  bytes.from_list([0xC1, 0xBF]),
  bytes.from_list([0xE0, 0x80, 0xAF]),
  bytes.from_list([0xED, 0xA0, 0x80]),
  bytes.from_list([0xED, 0xBF, 0xBF]),
  bytes.from_list([0xF4, 0x90, 0x80, 0x80]),
  bytes.from_list([0xF5, 0x80, 0x80, 0x80]),
  bytes.from_list([0xF8, 0x88, 0x80, 0x80, 0x80]),
  bytes.from_list([0x80]),
  bytes.from_list([0x61, 0xBF, 0x62]),
  bytes.from_list([0xE2, 0x82]),
  bytes.from_list([0xF0, 0x9F, 0x98]),
  bytes.from_list([0xC3]),
  bytes.from_list([0x61, 0xE2, 0x82, 0x61, 0xF0, 0x9F, 0x98, 0x80, 0xFF]),
  bytes.from_list([0xE2, 0x82, 0xAC, 0xC3]),
  bytes.from_list([0x0A, 0xFF, 0x0D, 0x0A, 0xC3, 0x0A]),
]

// ── valid text beside every boundary a cut or a case map can hit ──
fn edge_strings() -> List[String] = [
  "",
  "a",
  "ab",
  "é",
  "€",
  "😀",
  "\u{10FFFF}",
  "\u{FFFD}",
  "\u{7F}\u{80}\u{7FF}\u{800}\u{FFFF}\u{10000}",
  "\u{23A}\u{2C65}\u{23E}",
  "\u{130}\u{131}\u{1E9E}\u{DF}",
  "\u{FB03}\u{390}\u{3B0}\u{1F80}",
  "\u{3A3}\u{3C3}\u{3C2}",
  "e\u{301}",
  "a😀b€cé",
  " \t\u{3000}x\u{A0}\u{2028} ",
  "\u{FEFF}bom",
  "日本語テキスト",
  "line\nnext\r\nlast\r",
  "a,b,,c",
]

fn adversary() -> List[String] = (invalid_corpus() |> list.map((b) => bytes.to_string_lossy(b))) + edge_strings()

type Pair = { name: String, n: Int }

type Shape =
  | Named(String)
  | Plain
  | Both(String, Int)

test "concatenation and interpolation of valid pieces stay valid" {
  let strs = adversary()
  for a in strs {
    for b in strs {
      assert(utf8_ok(a + b))
      assert(utf8_ok("${a}${b}"))
      assert(utf8_ok("[${a}|${string.len(b)}|${true}|${1.5}]"))
    }
    var acc = ""
    for b in strs {
      acc = acc + a + b
    }
    assert(utf8_ok(acc))
  }
}

test "the display of every container shape stays valid" {
  let strs = adversary()
  let ints = [0, -1, 9223372036854775807]
  for s in strs {
    let one = [s, s + "\"", "\\" + s]
    assert(utf8_ok("${one}"))
    assert(utf8_ok("${[one, []]}"))
    assert(utf8_ok("${[(s, 1), (s, -2)]}"))
    assert(utf8_ok("${[some(s), none]}"))
    let rs: List[Result[String, String]] = [ok(s), err(s)]
    assert(utf8_ok("${rs}"))
    assert(utf8_ok("${map.from_list([(s, 1)])}"))
    assert(utf8_ok("${map.from_list([(s, s)])}"))
    assert(utf8_ok("${map.from_list([(s, true)])}"))
    assert(utf8_ok("${map.from_list([(s, 1.5)])}"))
    assert(utf8_ok("${set.from_list(one)}"))
    assert(utf8_ok("${some(s)}"))
    assert(utf8_ok("${some(one)}"))
    assert(utf8_ok("${some(some(s))}"))
    let r1: Result[String, String] = ok(s)
    let r2: Result[Int, String] = err(s)
    let r3: Result[List[String], String] = ok(one)
    assert(utf8_ok("${r1}") and utf8_ok("${r2}") and utf8_ok("${r3}"))
    assert(utf8_ok("${Pair { name: s, n: 1 }}"))
    assert(utf8_ok("${[Named(s), Plain, Both(s, 2)]}"))
  }
  assert(utf8_ok("${ints} ${[true]} ${[1.5]} ${[[1], []]} ${set.from_list(ints)} ${some(ints)} ${some(1.5)} ${some(true)} ${some(some(1))}"))
  let ro: Result[Option[Int], String] = ok(some(1))
  let rl: Result[List[Float], String] = ok([1.5])
  assert(utf8_ok("${ro} ${rl}"))
}
