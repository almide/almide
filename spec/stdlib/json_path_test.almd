import json

// ── value.root / value.key / value.index constructors ──
test "value.root creates path" {
  let p = value.root()
  let obj = value.object([("a", value.int(1))])
  let v = value.get_path(obj, p)
  // root path returns the entire object
  assert_eq(option.is_some(v), true)
}

test "value.key creates field path" {
  let obj = value.object([("name", value.string("Alice"))])
  let p = value.key(value.root(), "name")
  let v = value.get_path(obj, p)
  assert_eq(option.is_some(v), true)
  match v {
    some(val) => assert_eq(value.as_string(val)?, some("Alice")),
    none => assert(false, "should find name"),
  }
}

test "value.key missing key returns none" {
  let obj = value.object([("name", value.string("Alice"))])
  let p = value.key(value.root(), "age")
  let v = value.get_path(obj, p)
  assert_eq(option.is_none(v), true)
}

test "value.key nested path" {
  let inner = value.object([("x", value.int(42))])
  let outer = value.object([("data", inner)])
  let p = value.key(value.key(value.root(), "data"), "x")
  let v = value.get_path(outer, p)
  assert_eq(option.is_some(v), true)
  match v {
    some(val) => assert_eq(value.as_int(val)?, some(42)),
    none => assert(false, "should find nested value"),
  }
}

test "value.index on array" {
  let arr = value.array([value.string("a"), value.string("b"), value.string("c")])
  let p = value.index(value.root(), 1)
  let v = value.get_path(arr, p)
  assert_eq(option.is_some(v), true)
  match v {
    some(val) => assert_eq(value.as_string(val)?, some("b")),
    none => assert(false, "should find index"),
  }
}

test "value.index out of bounds" {
  let arr = value.array([value.int(1)])
  let p = value.index(value.root(), 5)
  let v = value.get_path(arr, p)
  assert_eq(option.is_none(v), true)
}

test "value.key then index" {
  let obj = value.object([
    ("items", value.array([value.int(10), value.int(20)]))
  ])
  let p = value.index(value.key(value.root(), "items"), 0)
  let v = value.get_path(obj, p)
  assert_eq(option.is_some(v), true)
  match v {
    some(val) => assert_eq(value.as_int(val)?, some(10)),
    none => assert(false, "should find nested array element"),
  }
}

// ── value.set_path ──
test "value.set_path simple field" {
  let obj = value.object([("name", value.string("Alice"))])
  let p = value.key(value.root(), "name")
  match value.set_path(obj, p, value.string("Bob")) {
    ok(result) => {
      let name = value.get(result, "name")
      match name {
        some(v) => assert_eq(value.as_string(v)?, some("Bob")),
        none => assert(false, "should have name"),
      }
    },
    err(e) => assert(false, e),
  }
}

test "value.set_path nested field" {
  let inner = value.object([("x", value.int(1))])
  let outer = value.object([("data", inner)])
  let p = value.key(value.key(value.root(), "data"), "x")
  match value.set_path(outer, p, value.int(99)) {
    ok(result) => {
      let data = value.get(result, "data")
      assert_eq(option.is_some(data), true)
      match data {
        some(d) => {
          let x = value.get(d, "x")
          match x {
            some(v) => assert_eq(value.as_int(v)?, some(99)),
            none => assert(false, "missing x"),
          }
        },
        none => assert(false, "missing data"),
      }
    },
    err(e) => assert(false, e),
  }
}

test "value.set_path on array index" {
  let arr = value.array([value.int(1), value.int(2), value.int(3)])
  let p = value.index(value.root(), 1)
  match value.set_path(arr, p, value.int(99)) {
    ok(result) => {
      let items = value.as_array(result)?
      assert_eq(option.is_some(items), true)
    },
    err(e) => assert(false, e),
  }
}

test "value.set_path adds new key" {
  let obj = value.object([("a", value.int(1))])
  let p = value.key(value.root(), "b")
  match value.set_path(obj, p, value.int(2)) {
    ok(result) => {
      let ks = list.map(value.as_object(result) ?? [], (kv) => kv.0)
      assert_eq(list.len(ks), 2)
      assert_eq(list.contains(ks, "b"), true)
    },
    err(e) => assert(false, e),
  }
}

// ── value.remove_path ──
test "value.remove_path field" {
  let obj = value.object([("a", value.int(1)), ("b", value.int(2))])
  let p = value.key(value.root(), "a")
  let result = value.remove_path(obj, p)
  let ks = list.map(value.as_object(result) ?? [], (kv) => kv.0)
  assert_eq(list.len(ks), 1)
  assert_eq(list.contains(ks, "b"), true)
  assert_eq(list.contains(ks, "a"), false)
}

test "value.remove_path nested field" {
  let inner = value.object([("x", value.int(1)), ("y", value.int(2))])
  let outer = value.object([("data", inner)])
  let p = value.key(value.key(value.root(), "data"), "x")
  let result = value.remove_path(outer, p)
  let data = value.get(result, "data")
  assert_eq(option.is_some(data), true)
  match data {
    some(d) => {
      let ks = list.map(value.as_object(d) ?? [], (kv) => kv.0)
      assert_eq(list.len(ks), 1)
      assert_eq(list.contains(ks, "y"), true)
      assert_eq(list.contains(ks, "x"), false)
    },
    none => assert(false, "missing data"),
  }
}

test "value.remove_path array element" {
  let arr = value.array([value.int(1), value.int(2), value.int(3)])
  let p = value.index(value.root(), 1)
  let result = value.remove_path(arr, p)
  let items = value.as_array(result)?
  match items {
    some(xs) => assert_eq(list.len(xs), 2),
    none => assert(false, "should be array"),
  }
}

test "value.remove_path missing key is noop" {
  let obj = value.object([("a", value.int(1))])
  let p = value.key(value.root(), "z")
  let result = value.remove_path(obj, p)
  let ks = list.map(value.as_object(result) ?? [], (kv) => kv.0)
  assert_eq(list.len(ks), 1)
  assert_eq(list.contains(ks, "a"), true)
}

fn deep_path(d: Int) -> value.Path = list.range(0, d) |> list.fold(
  value.root(),
  (acc, _i) => value.key(acc, "k"),
)

fn deep_array(d: Int) -> Value = list.range(0, d) |> list.fold(
  value.int(1),
  (acc, _i) => value.array([acc]),
)

test "value.set_path builds up to parse's nesting bound (#4209)" {
  let doc = value.object([])
  match value.set_path(doc, deep_path(1000), value.int(1)) {
    ok(v) => assert_eq(json.parse(json.stringify(v)) |> result.is_ok, true),
    err(e) => assert(false, e),
  }
  match value.set_path(doc, deep_path(600), deep_array(400)) {
    ok(v) => assert_eq(json.parse(json.stringify(v)) |> result.is_ok, true),
    err(e) => assert(false, e),
  }
}

test "value.set_path refuses a value nested past 1000 with parse's text (#4209)" {
  let doc = value.object([])
  assert_eq(
    value.set_path(doc, deep_path(1001), value.int(1)),
    err("json: nesting deeper than 1000"),
  )
  assert_eq(
    value.set_path(doc, deep_path(1000), value.array([])),
    err("json: nesting deeper than 1000"),
  )
  assert_eq(
    value.set_path(doc, deep_path(600), deep_array(401)),
    err("json: nesting deeper than 1000"),
  )
  assert_eq(
    value.set_path(doc, value.root(), deep_array(1001)),
    err("json: nesting deeper than 1000"),
  )
  assert_eq(
    value.set_path(doc, deep_path(50000), value.int(1)),
    err("json: nesting deeper than 1000"),
  )
}
