// #1942 / #1904: `??` over an Option/Result whose payload is a TUPLE with a
// heap component, in the let-bound and the inline-extraction positions. On
// the incumbent wasm leg the let-bound form read the String half back as a
// garbage handle (exit 0, no wall) and the inline `(o ?? d).0` walled, while
// the eager `option.unwrap_or` call lowered — the D4 window recommended the
// spelling that was wrong. Both take the proven bind-position match route now.
fn pick(o: (String, Int)?) -> String = {
  let t = o ?? ("dflt", 7)
  "${t.0}/${int.to_string(t.1)}"
}

fn head(o: (String, Int)?) -> String = (o ?? ("", 0)).0

test "let-bound ?? over a heap tuple payload" {
  assert_eq(pick(some(("a", 1))), "a/1")
  assert_eq(pick(none), "dflt/7")
}

test "inline extraction through ?? over a heap tuple payload" {
  assert_eq(head(some(("h", 2))), "h")
  assert_eq(head(none), "")
}
