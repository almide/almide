// wasm:enabled
// Locks in the `??` chain over effect calls — the first-Ok-in-source-order selection
// that replaced `fan.any` (dialect epoch 14, ADR-0028). `a() ?? b()` evaluates its right
// side only when the left failed, so later candidates never run once one succeeds, and
// when every candidate fails the chain yields its final fallback. Byte-identical to
// v0 --target wasm.
effect fn okn(n: Int) -> Result[Int, String] = ok(n * 3)

effect fn failing() -> Result[Int, String] = err("boom")

effect fn main() -> Unit = {
  // the FIRST Ok in source order wins
  let any = failing() ?? okn(7) ?? okn(99) ?? -1
  println("any=" + int.to_string(any))
  // every candidate fails: the fallback
  let all_fail = failing() ?? failing() ?? -1
  println("all_fail=" + int.to_string(all_fail))
  let got = failing() ?? okn(88) ?? -1
  println("unwrap=" + int.to_string(got))
}
