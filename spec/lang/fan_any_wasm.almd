// wasm:enabled
// Locks in `fan.any` over a LITERAL thunk list. On wasm the fan combinators are DETERMINISTIC:
// `fan.any` returns the FIRST candidate that succeeds, in list order (NOT wall-clock fastest).
// The trust-spine desugars it into a per-thunk match chain, avoiding an unrepresentable
// `List[funcref]`. Byte-identical to v0 --target wasm.
//
// The `fan.race` cases this file also carried were removed with the combinator in 0.42.0
// (E027 tombstone); `fan.any` exercises the same literal-thunk-list lowering path.
effect fn okn(n: Int) -> Result[Int, String] = ok(n * 3)

effect fn failing() -> Result[Int, String] = err("boom")

effect fn main() -> Unit = {
  // fan.any: the FIRST Ok in list order wins; if every candidate errs, v0's fixed
  // `fan.any: all candidates failed` message. Inlined into a per-thunk match chain.
  match fan.any([
    () => failing(),
    () => okn(7),
    () => okn(99)
  ]) {
    ok(v) => println("any=" + int.to_string(v)),
    err(e) => println("any_err=" + e),
  }
  match fan.any([
    () => failing(),
    () => failing()
  ]) {
    ok(v) => println("any_ok"),
    err(e) => println("all_fail=" + e),
  }
  let got = fan.any([
    () => failing(),
    () => okn(88)
  ])
  println("unwrap=" + int.to_string(got))
}
