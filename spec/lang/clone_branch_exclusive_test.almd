// Branch-exclusive last-use moves (#1143): the clone pass counts syntactic
// uses over the WHOLE fn, so without sibling deduction a use inside one
// if/match branch still counts the mutually-exclusive sibling's uses — the
// genuine last use on a path could never reach zero and every branch tail
// paid a spurious clone (the fold-accumulator `map.set(acc, …)` cloned the
// whole Map per line). These tests pin the SEMANTIC half: moves happen only
// where the source is truly dead, and a source used after the call is still
// cloned (persistence preserved).
test "map.set leaves a reused source intact" {
  let m1 = map.set(map.new(), "a", 1)
  let m2 = map.set(m1, "b", 2)
  assert_eq(map.len(m1), 1)
  assert_eq(map.len(m2), 2)
  assert_eq(map.get(m1, "b"), none)
}

test "match arms each consume the accumulator exactly once" {
  var acc = map.new()
  for k in ["x", "y", "x", "z", "x"] {
    acc = match map.get(acc, k) {
      some(n) => map.set(acc, k, n + 1),
      none => map.set(acc, k, 1),
    }
  }
  assert_eq(map.get_or(acc, "x", 0), 3)
  assert_eq(map.get_or(acc, "y", 0), 1)
  assert_eq(map.get_or(acc, "z", 0), 1)
}

test "if branches with exclusive last uses" {
  let base = map.set(map.new(), "k", 10)
  let flag = map.len(base) == 1
  let out = if flag then map.set(base, "k2", 20)
  else base
  assert_eq(map.len(out), 2)
}

test "fold with map accumulator threads without corruption" {
  let counts = [1, 2, 1, 3, 1] |> list.fold(map.new(), (acc, n) => map.set(acc, n, map.get_or(acc, n, 0) + 1))
  assert_eq(map.get_or(counts, 1, 0), 3)
  assert_eq(map.get_or(counts, 2, 0), 1)
  assert_eq(map.get_or(counts, 3, 0), 1)
}
