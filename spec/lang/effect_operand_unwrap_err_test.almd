// #1050 / #2196 err-propagation twin: a can-err CALL as a binary operand
// propagates through its `!` — the failure leaves the operand exactly as it
// would leave a `let`. The lowering A-normalizes the Try operand into the
// proven heap-result-bind brick (auto_try), so this renders on the trust spine.
effect fn parse_sum(s: String) -> Int = int.parse(s)! + 1

test "a can-err call operand propagates its err" {
  assert_eq(parse_sum("5")!, 6)
  assert(result.is_err(parse_sum("x")), "parse failure propagates out of the operand")
}
