// #1925: a String bound by a match-arm pattern, captured by a `move`
// closure handed to a stdlib higher-order fn, then reused in the same arm.
// The capture pre-clone pass scoped only `let` bindings and params, so the
// closure moved the binding and the later use was rustc E0382 behind a
// green check. (`List[String]` rather than the report's `List[List[String]]`
// so the file runs on the wasm leg too — the incumbent brick has no linked
// `list.find` over a list-of-lists; the capture shape is the same.)
fn check(o: String?, acc: List[String]) -> Result[Int, String] = {
  match o {
    none => ok(0),
    some(key) => match list.find(acc, (p) => p == key) {
      some(_) => err("dup: ${key}"),
      none => ok(0),
    },
  }
}

fn show(r: Result[Int, String]) -> String = match r {
  ok(n) => "ok ${n}",
  err(e) => e,
}

test "arm binding captured by a closure and reused" {
  assert_eq(show(check(some("a"), ["a"])), "dup: a")
  assert_eq(show(check(some("z"), ["a"])), "ok 0")
  assert_eq(show(check(none, [])), "ok 0")
}

// #1948: the same arm binding, captured by a closure handed to `list.filter`
// and then read again by a string interpolation AFTER the closure call — the
// use-after-capture shape from a real CLI (`peek`). Fixed on develop by the
// #1925 scoping (this file's first case); pinned here because the report
// reached 0.62.0 with the second use in interpolation rather than a match.
effect fn pick(names: List[String], want: Option[String]) -> Result[String, String] = match want {
  some(name) => {
    let near = list.filter(names, (s) => string.contains(string.to_lower(s), string.to_lower(name)))
    err("no `${name}` (near: ${list.join(near, ", ")})")
  },
  none => ok("all"),
}

fn show_pick(r: Result[String, String]) -> String = match r {
  ok(s) => s,
  err(e) => e,
}

test "arm binding captured by a filter closure and interpolated after" {
  assert_eq(show_pick(pick(["apply", "applied"], some("Appl"))), "no `Appl` (near: apply, applied)")
  assert_eq(show_pick(pick(["apply"], none)), "all")
}
