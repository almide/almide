// The capability rule (#1055, ADR-0009 D2) keys on what an identifier RESOLVES
// to, not on how it is SPELLED — in BOTH directions.
//
// The rule exists because a bare `eff` reference laundered its effect bit past
// a pure caller while `(x) => eff(x)` was correctly rejected. The first version
// of the check read the function table by NAME, which reintroduced the same
// error inverted: a LOCAL binding sharing a name with an effect fn, passed as
// a CALL ARGUMENT, was reported as a call to that fn. In tools/almide-gates a
// plain `let run = take_path_run(line, at)` made `string.len(run)` "cannot call
// effect function 'run' from a pure function", because a SIBLING module
// declared `effect fn run` — and the pure gate stopped compiling.
//
// The ARGUMENT POSITION is what matters: the check walks a call's args, so
// `take + 1` never reached it and only `f(take)` did. Both appear below.
//
// Resolution order is local → top-level let → const param → function
// (`infer_expr_g2_ident`); this pins that the capability check follows it.
effect fn take(n: Int) -> Int = n + 1

let boil: Int = 7

fn twice(n: Int) -> Int = n * 2

fn local_shadow_as_call_arg(xs: List[Int]) -> Int = {
  // `take` is a LOCAL Int here, shadowing the effect fn above — and it is
  // passed as a call ARGUMENT, the position the capability check walks.
  let take = list.len(xs)
  twice(take)
}

fn top_let_shadow_as_call_arg() -> Int = twice(boil)

test "a local shadowing an effect fn is a value in argument position" {
  assert_eq(local_shadow_as_call_arg([1, 2, 3]), 6)
}

test "a top-level let shadowing an effect fn is a value in argument position" {
  assert_eq(top_let_shadow_as_call_arg(), 14)
}
