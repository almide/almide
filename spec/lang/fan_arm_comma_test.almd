// Fan arm separators: `,` or a newline — arms are PARALLEL SIBLINGS and take
// the enumeration separator (match arms, list literals). `;` between arms is
// a targeted parse error; INSIDE a block arm it stays legal (a block arm
// really is sequential). fmt canonicalizes to newline-per-arm, so the
// comma-form ACCEPTANCE and the `;` diagnostic are pinned by the rust-side
// tests/fan_arm_separator_test.rs; this file pins the canonical form's
// runtime behavior on both legs.
effect fn ea() -> Result[Int, String] = ok(1)

effect fn eb() -> Result[Int, String] = ok(2)

test "fan block arms in canonical newline form" {
  let (x, y) = fan {
    ea()
    eb()
  }
  assert_eq(x + y, 3)
}

test "fan.any arms in canonical newline form" {
  let n = fan.any {
    ea()
    eb()
  }!
  assert_eq(n, 1)
}

test "fan.settle arms in canonical newline form" {
  let (ra, rb) = fan.settle {
    ea()
    eb()
  }
  assert_eq((ra ?? -1) + (rb ?? -1), 3)
}
