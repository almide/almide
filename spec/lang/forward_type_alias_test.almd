// #3407: a type alias may spell a type declared further down. Declaration
// order is not meaningful: an alias registers after every alias it names.
// v0.64.0 registered aliases in source order, so `First` kept the name
// `Pair2` and a tuple index on it was E045.
type First = Pair2

type Pair2 = (Int, Int)

type Twice[T] = Both[List[T]]

type Both[T] = (T, T)

type Line = { from: Point, to: Point, tag: Label }

type Point = (Int, Int)

type Label = Tag

type Tag = String

type Box[T] = { item: T, count: Count }

type Count = Int

type Move =
  | Step(Delta)
  | Stay

type Delta = Point

fn first(p: First) -> Int = p.0

fn sizes(t: Twice[String]) -> Int = list.len(t.0) * 10 + list.len(t.1)

fn length(l: Line) -> Int = (l.to.0 - l.from.0) + (l.to.1 - l.from.1)

fn dx(m: Move) -> Int = match m {
  Step(d) => d.0,
  Stay => 0,
}

test "an alias of a later alias is its body" {
  assert_eq(first((7, 8)), 7)
  let p: First = (1, 2)
  assert_eq(p.1, 2)
}

test "a generic alias of a later generic alias substitutes" {
  assert_eq(sizes((["a", "b"], ["c"])), 21)
}

test "a record field spells an alias declared after the record" {
  let l: Line = { from: (1, 1), to: (4, 5), tag: "edge" }
  assert_eq(length(l), 7)
  assert_eq(l.tag + "!", "edge!")
}

test "a generic record stays nominal over a later alias" {
  let b: Box[String] = { item: "x", count: 2 }
  assert_eq(b.count + 1, 3)
  assert_eq(b.item, "x")
}

test "a variant payload spells a later alias of a later alias" {
  let moved = dx(Step((3, 0)))
  let stayed = dx(Stay)
  assert_eq(moved + stayed, 3)
}
