// The `??` chain (first Ok in SOURCE order — the respelling of the retired
// `fan.any { }`, dialect epoch 14) and fan.settle.
// The chain is DETERMINISTIC: it tries each candidate in source order, yields
// the FIRST Ok's payload, and falls to the final fallback when all fail.
effect fn succeed(x: Int) -> Result[Int, String] = ok(x)

effect fn fail(msg: String) -> Result[Int, String] = err(msg)

// ── `??` chain — first success in source order wins (deterministic) ──
test "chain first success" {
  let result = succeed(42) ?? succeed(99) ?? -1
  assert_eq(result, 42)
}

test "chain skips failures" {
  let result = fail("nope") ?? succeed(7) ?? -1
  assert_eq(result, 7)
}

test "chain all fail yields the fallback" {
  let result = fail("a") ?? fail("b") ?? -1
  assert_eq(result, -1)
}

// ── fan.settle — collect all results (a TUPLE of per-arm Results, T2-4) ──
test "fan.settle collects all" {
  let (r1, r2, r3) = fan.settle {
    succeed(1)
    fail("bad")
    succeed(3)
  }
  assert_eq(r1, ok(1))
  assert_eq(r2, err("bad"))
  assert_eq(r3, ok(3))
}
