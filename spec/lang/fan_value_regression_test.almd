// Value-asserting regression tests for the fan.* cross-target bugs.
// The original fan specs only checked lengths / race winners, so corrupt
// settled payloads and dropped/invalid fan.any results all slipped
// through. These lock in the actual values.
effect fn succeed(x: Int) -> Result[Int, String] = ok(x)

effect fn fail_with(msg: String) -> Result[Int, String] = err(msg)

effect fn pick(s: String) -> Result[String, String] = ok(s)

// ── fan.settle — every settled payload must survive (was zeroed/corrupt) ──
test "fan.settle preserves ok and err payloads" {
  let (r1, r2, r3) = fan.settle {
    succeed(11)
    fail_with("boom")
    succeed(33)
  }
  assert_eq(r1, ok(11))
  assert_eq(r2, err("boom"))
  assert_eq(r3, ok(33))
}

// ── fan.any returning Int — must produce a valid module + correct value ──
// fan.any is now Result[T, String]; the test-block binding is the full Result.
test "fan.any returns the Int winner" {
  let w = fan.any {
    succeed(5)
  }
  assert_eq(w, ok(5))
}

// ── fan.any returning String — must not silently drop the winner ──
// fan.any is now DETERMINISTIC (first Ok in list order) on BOTH targets, so the
// winner is always the first success ("alpha"). The original regression was that
// a valid String result was dropped/garbage on wasm; this locks in the value.
test "fan.any returns the String winner" {
  let w = fan.any {
    pick("alpha")
    pick("beta")
  }
  assert_eq(w, ok("alpha"))
}

// ── a fan combinator's Result bound to a Result let — ?? and == must type-check ──
// (was written against fan.race, removed in 0.42.0; the regression is about the BINDING,
// not about which combinator produced it, so fan.any over a succeeding thunk pins it.)
test "fan combinator result supports ?? and ==" {
  let r: Result[Int, String] = fan.any {
    succeed(42)
  }
  assert_eq(r ?? -1, 42)
  assert(r == ok(42))
}

// ── CAPTURING thunks (native E0308 / E0277) ───────────────────────────────
// The cases above use non-capturing thunks, which coerce to fn pointers and so
// compiled natively even before the fix. A thunk that CAPTURES a local is a
// distinct anonymous closure type: two of them cannot share one `Vec<impl Fn>`
// (E0308), and a captured closure VALUE is `Rc<dyn Fn>`, neither Send nor Sync
// (E0277). The native runner (`almide test --target rust`) is what exercises
// this — the wasm runner table-dispatches closures and never hit the bug.
// Written against fan.race, removed in 0.42.0. The regression is TWO capturing thunks
// sharing one list — the shape that produced E0308 — not which combinator consumed them,
// so it moves to fan.settle, which keeps both thunks live and stays distinct from the
// fan.any case below.
test "two capturing thunks share one fan thunk list (native E0308)" {
  let a = 4
  let b = 5
  let (ra, rb) = fan.settle {
    succeed(a + 5)
    succeed(b + 4)
  }
  assert_eq(ra, ok(9))
  assert_eq(rb, ok(9))
}

test "fan.any over capturing thunks picks the lone success" {
  let lo = 2
  let hi = 8
  let msg = "skip"
  let w = fan.any {
    fail_with(msg)
    succeed(hi - lo)
  }
  assert_eq(w, ok(6))
}

test "fan.settle over capturing thunks preserves order and payloads" {
  let x = 1
  let oops = "boom"
  let z = 3
  let (r1, r2, r3) = fan.settle {
    succeed(x * 10)
    fail_with(oops)
    succeed(z * 10)
  }
  assert_eq(r1, ok(10))
  assert_eq(r2, err("boom"))
  assert_eq(r3, ok(30))
}

test "fan.map over a captured closure value (native E0277)" {
  let k = 3
  let f = (n: Int) => succeed(n + k)
  let out = fan.map([1, 2, 3], f)
  assert_eq(out, ok([4, 5, 6]))
}

test "fan.map over a capturing literal lambda" {
  let base = 100
  let out = fan.map([1, 2, 3], (n: Int) => succeed(base + n))
  assert_eq(out, ok([101, 102, 103]))
}
