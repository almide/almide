// The fan mapper COMPLETENESS MATRIX gate (the rule lives on
// `fan_map_call_name` in almide-mir): every (A, B) pairing with
// A, B ∈ {Int, Float, String} must link a self-host on BOTH mapper heads —
// fan.map (collect, first-Err short-circuit) and fan.any (first Ok wins).
// Function-VALUE callbacks are used on purpose: a literal lambda can ride the
// defunc inliner, but a fn value goes through the type-routed registry — the
// path a missing pairing turns into a wasm wall. fan.settle is exempt from
// the table by design (it desugars to list.map and is generic for free);
// Bool payloads intentionally ride Int 0/1 until a dogfood need appears.
// EFFECT-CALLBACK column (#1350 stage 2 / #1406): every mapper head —
// fan.map, fan.any, AND fan.settle — has one row whose callback reaches a
// real capability (fs, wasm-available), as an inline lambda and as an
// effect-fn VALUE. fan.race is the reasoned omission: its mapper meters a
// PURE body by the checker (E006 names the effect fn), so it has no effect
// cell on either target. These rows use the plain spelling (`f(p)`, no `!`)
// because a test block's `!` is a plain unwrap (L9); the `!` / compound /
// value spellings are pinned cross-target by
// spec/embedded_cross/fan_mapper_effect_callback_forms.almd.
import fs

effect fn read_one(p: String) -> Result[String, String] = fs.read_text(p)

fn m_ii(x: Int) -> Result[Int, String] = ok(x + 1)

fn m_is(x: Int) -> Result[String, String] = ok(int.to_string(x))

fn m_if(x: Int) -> Result[Float, String] = ok(float.from_int(x) * 0.5)

fn m_si(s: String) -> Result[Int, String] = ok(string.len(s))

fn m_ss(s: String) -> Result[String, String] = ok(s + "!")

fn m_sf(s: String) -> Result[Float, String] = ok(float.from_int(string.len(s)) + 0.5)

fn m_fi(x: Float) -> Result[Int, String] = ok(float.to_int(x * 2.0))

fn m_fs(x: Float) -> Result[String, String] = ok(float.to_string(x))

fn m_ff(x: Float) -> Result[Float, String] = ok(x * 2.0)

// ── fan.map: all 9 cells ──
test "map matrix Int->Int" {
  assert_eq(fan.map([1, 2], m_ii), ok([2, 3]))
}

test "map matrix Int->String" {
  assert_eq(fan.map([7], m_is), ok(["7"]))
}

test "map matrix Int->Float" {
  assert_eq(fan.map([4], m_if), ok([2.0]))
}

test "map matrix String->Int" {
  assert_eq(fan.map(["ab"], m_si), ok([2]))
}

test "map matrix String->String" {
  assert_eq(fan.map(["a"], m_ss), ok(["a!"]))
}

test "map matrix String->Float" {
  assert_eq(fan.map(["ab"], m_sf), ok([2.5]))
}

test "map matrix Float->Int" {
  assert_eq(fan.map([1.5], m_fi), ok([3]))
}

test "map matrix Float->String" {
  assert_eq(fan.map([1.5], m_fs), ok(["1.5"]))
}

test "map matrix Float->Float" {
  assert_eq(fan.map([1.5, 2.5], m_ff), ok([3.0, 5.0]))
}

// ── fan.any: all 9 cells ──
test "any matrix Int->Int" {
  assert_eq(fan.any([1], m_ii), ok(2))
}

test "any matrix Int->String" {
  assert_eq(fan.any([7], m_is), ok("7"))
}

test "any matrix Int->Float" {
  assert_eq(fan.any([4], m_if), ok(2.0))
}

test "any matrix String->Int" {
  assert_eq(fan.any(["ab"], m_si), ok(2))
}

test "any matrix String->String" {
  assert_eq(fan.any(["a"], m_ss), ok("a!"))
}

test "any matrix String->Float" {
  assert_eq(fan.any(["ab"], m_sf), ok(2.5))
}

test "any matrix Float->Int" {
  assert_eq(fan.any([1.5], m_fi), ok(3))
}

test "any matrix Float->String" {
  assert_eq(fan.any([1.5], m_fs), ok("1.5"))
}

test "any matrix Float->Float" {
  assert_eq(fan.any([1.5], m_ff), ok(3.0))
}

// ── literal lambdas take the same table (any has no defunc bypass) ──
test "any Float literal lambda links" {
  assert_eq(fan.any([1.5, 2.5], (x) => ok(x * 2.0)), ok(3.0))
}

test "map Float fn-value and literal agree" {
  let via_value = fan.map([1.5], m_ff)
  let via_literal = fan.map([1.5], (x) => ok(x * 2.0))
  assert_eq(via_value, via_literal)
}

// ── settle rides list.map generically (exempt from the table) ──
test "settle Float fn-value is generic" {
  let rs = fan.settle([1.5, 2.5], m_ff)
  assert_eq(list.len(rs), 2)
  assert_eq(rs[0], ok(3.0))
}

// ── edges the matrix must hold at ──
test "map empty list is ok-empty on every cell type" {
  assert_eq(fan.map([], m_ff), ok([]))
}

test "any empty list fails closed with the ledger Err" {
  assert_eq(fan.any([], m_ff), err("fan.any: all candidates failed"))
}

test "map first Err short-circuits in list order" {
  let r = fan.map([1.0, -1.0, 2.0], (x) => if x < 0.0 then err("neg") else ok(x))
  assert_eq(r, err("neg"))
}

test "any Err disqualifies the element only" {
  let r = fan.any([-1.0, 2.0], (x) => if x < 0.0 then err("neg") else ok(x))
  assert_eq(r, ok(2.0))
}

// ── effect-callback column: one row per mapper head, fs-backed ──
test "map effect callback reaches fs" {
  let d = fs.create_temp_dir("fanMx")!
  fs.write(d + "/a.txt", "alpha")!
  fs.write(d + "/b.txt", "beta")!
  assert_eq(fan.map([d + "/a.txt", d + "/b.txt"], (p) => fs.read_text(p)), ok(["alpha", "beta"]))
  assert_eq(fan.map([d + "/a.txt", d + "/b.txt"], read_one), ok(["alpha", "beta"]))
  // the FIRST err (list order) is the whole result
  let r = fan.map([d + "/a.txt", d + "/gone.txt"], read_one)
  assert_eq(r, err("No such file or directory (os error 2)"))
  fs.remove_all(d)!
}

test "any effect callback reaches fs" {
  let d = fs.create_temp_dir("fanMx")!
  fs.write(d + "/a.txt", "alpha")!
  // the missing candidate's err skips; the first readable file wins
  assert_eq(fan.any([d + "/gone.txt", d + "/a.txt"], (p) => fs.read_text(p)), ok("alpha"))
  assert_eq(fan.any([d + "/gone.txt", d + "/a.txt"], read_one), ok("alpha"))
  assert_eq(fan.any([d + "/gone.txt"], read_one), err("fan.any: all candidates failed"))
  fs.remove_all(d)!
}

// settle's rows compare through `show`: the test harness's wasm lane is the
// incumbent brick, which walls a heap-Result equality in a returned position
// ("heap-result `match` outside the executable subset") and would route the
// whole file to the native fallback — the row must RUN on the wasm lane.
fn show(r: Result[String, String]) -> String = match r {
  ok(v) => "ok " + v,
  err(e) => "err " + e,
}

test "settle effect callback reaches fs" {
  let d = fs.create_temp_dir("fanMx")!
  fs.write(d + "/a.txt", "alpha")!
  // EVERY element's Result, errs captured in list order
  let rs = fan.settle([d + "/gone.txt", d + "/a.txt"], (p) => fs.read_text(p)) |> list.map((r) => show(r))
  assert_eq(rs, [
    "err No such file or directory (os error 2)",
    "ok alpha"
  ])
  let vs = fan.settle([d + "/gone.txt", d + "/a.txt"], read_one) |> list.map((r) => show(r))
  assert_eq(vs, rs)
  fs.remove_all(d)!
}
