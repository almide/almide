// A String-list literal carrying an `if` ELEMENT with literal arms — Wave 4 L2's
// fuzz shape. Reachable whenever const-fold declines to collapse the cond, so the
// conds here are RUNTIME-derived (a folded `if false then …` would not exercise
// the lowering path this pins).
fn runtime_flag(s: String) -> Bool = string.len(s) > 2

test "if element with runtime cond, then arm" {
  let c = runtime_flag("long enough")
  let xs = [
    "a",
    (if c then "b" else "d"),
    "e"
  ]
  assert_eq(list.len(xs), 3)
  assert_eq(list.join(xs, ","), "a,b,e")
}

test "if element with runtime cond, else arm" {
  let c = runtime_flag("x")
  let xs = [
    "a",
    (if c then "b" else "d")
  ]
  assert_eq(list.join(xs, ","), "a,d")
}

test "if element inside a HOF condition list" {
  let c = runtime_flag("x")
  let hit = list.any([
    "αβγ",
    (if c then "日本語" else "ﬁle"),
    "café"
  ], ((s) => s == "ﬁle"))
  assert_eq(hit, true)
}

test "if element with a call-valued condition" {
  let s = "hello world"
  let xs: List[String] = [
    (if string.starts_with(s, "hello") then "yes" else s),
    "tail"
  ]
  assert_eq(list.len(xs), 2)
  assert_eq(list.get_or(xs, 0, ""), "yes")
}

test "if element whose else arm is a variable" {
  let fallback = "fb"
  let xs: List[String] = [
    (if string.contains(fallback, "z") then "hit" else fallback),
    "tail"
  ]
  assert_eq(list.get_or(xs, 0, ""), "fb")
}

test "if element nested inside the condition of another if" {
  let r = "abc"
  let xs: List[String] = [
    (if string.starts_with(r, (if true then "a" else r)) then "outer" else r),
    "z"
  ]
  assert_eq(list.get_or(xs, 0, ""), "outer")
  assert_eq(list.len(xs), 2)
}
