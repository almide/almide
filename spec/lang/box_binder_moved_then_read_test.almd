// #4292: a match binder MOVED into an owned slot while a later sibling still
// reads it is cloned there whichever way the subject is matched, so the
// subject param is borrowed — and a boxed binder's copy, read through the
// reference the borrowed match binds, is the boxed VALUE (`(**l).clone()`),
// not a copy of the box. The ownership certifier's C4 refused the owned form.
type Tree = | Leaf | Node(Tree, Int, Tree)

fn depth(t: Tree) -> Int =
  match t {
    Leaf => 0,
    Node(l, _, r) => 1 + (if depth(l) > depth(r) then depth(l) else depth(r)),
  }

fn keep(t: Tree, a: Int) -> Tree = if a > 100 then Leaf else t

// The boxed binder moved into an owned call slot, then read by a borrowing one.
fn moved_after(t: Tree) -> Tree =
  match t {
    Leaf => Leaf,
    Node(l, _, _) => keep(l, depth(l)),
  }

// The boxed binder moved into a constructor, then read.
fn regrow(t: Tree) -> Tree =
  match t {
    Leaf => Leaf,
    Node(l, v, _) => Node(l, v + depth(l), Leaf),
  }

// A heap payload that is not boxed, moved then read.
type Bag = | Empty | Items(List[Int])

fn take_all(xs: List[Int], n: Int) -> List[Int] = if n > 10 then [] else xs

fn moved_items(b: Bag) -> List[Int] =
  match b {
    Empty => [],
    Items(xs) => take_all(xs, list.len(xs)),
  }

test "a boxed binder moved into an owned slot then read" {
  let t = Node(Node(Node(Leaf, 1, Leaf), 2, Leaf), 3, Leaf)
  assert_eq(depth(moved_after(t)), 2)
  // `t` is still live: the callee borrowed it.
  assert_eq(depth(t), 3)
}

test "a boxed binder moved into a constructor then read" {
  let t = Node(Node(Leaf, 5, Leaf), 7, Node(Leaf, 9, Leaf))
  assert_eq(depth(regrow(t)), 2)
  assert_eq(depth(t), 2)
  assert_eq(regrow(t), Node(Node(Leaf, 5, Leaf), 8, Leaf))
}

test "an unboxed heap binder moved then read" {
  let b = Items([1, 2, 3])
  assert_eq(moved_items(b), [1, 2, 3])
  assert_eq(moved_items(b), [1, 2, 3])
  assert_eq(moved_items(Empty), [])
}
