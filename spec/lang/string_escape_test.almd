// String literal numeric / Unicode escapes (#746, #1263, #1264).
//
// `\xNN` (two hex digits, codepoint 0..=0xFF) and `\u{...}` (one to six hex
// digits, any Unicode scalar) decode to the codepoint. Escapes are resolved at
// lex time, so the resulting bytes are identical on the native and wasm
// targets.
//
// #1263: the ESCAPE SPELLINGS below used to be a casualty of `almide fmt`,
// which reprinted every string from its decoded VALUE — this file was
// committed with a raw ESC byte and a bare `あ` in place of `\x1b` / `\u{3042}`.
// fmt now reprints a literal's source text, so what is written here is what
// stays here.
//
// #1264: an escape the decoder does NOT define is a check-time error (E046),
// not silent literal text. `\\users` below is a DOUBLED backslash — one
// literal `\` followed by `users` — which is how a non-escape is spelled.
test "hex escape \\xNN decodes to a codepoint" {
  assert_eq("\x41", "A")
  assert_eq("\x1b", string.from_codepoint(27))
}

test "unicode escape \\u{...} decodes to a codepoint" {
  assert_eq("\u{41}", "A")
  assert_eq("\u{1b}", string.from_codepoint(27))
  assert_eq("\u{3042}", string.from_codepoint(12354))
  // An astral codepoint is a single codepoint (string.len counts codepoints).
  assert_eq(string.len("\u{1f600}"), 1)
  // The range boundary: U+10FFFF is the last scalar value there is.
  assert_eq(string.len("\u{10FFFF}"), 1)
}

test "basic escapes still work and a doubled backslash is one backslash" {
  assert_eq(string.len("\n\t"), 2)
  assert_eq("\\users", string.from_codepoint(92) + "users")
  assert_eq("\\xyz", string.from_codepoint(92) + "xyz")
  // A raw string has no escape layer at all.
  assert_eq(r"\d+", string.from_codepoint(92) + "d+")
}
