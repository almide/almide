// Some(<tuple payload>) across the tuple family — the payload may be a literal OR a
// call result, and the two must agree for every cell (Wave 6 R3: three of four cells
// were keyed by expression SHAPE while `(Int, String)` was keyed by TYPE, so only that
// one admitted a call-result payload).
test "some of a str-int tuple call result" {
  let s0: Option[(String, Int)] = none
  let r = option.unwrap_or(some(option.unwrap_or(s0, ("a", 1))), ("b", 2))
  let (l, n) = r
  assert_eq(l, "a")
  assert_eq(n, 1)
}

test "some of an int-str tuple call result" {
  let s0: Option[(Int, String)] = none
  let r = option.unwrap_or(some(option.unwrap_or(s0, (1, "a"))), (2, "b"))
  let (n, l) = r
  assert_eq(n, 1)
  assert_eq(l, "a")
}

test "some of a str-str tuple call result" {
  let s0: Option[(String, String)] = none
  let r = option.unwrap_or(some(option.unwrap_or(s0, ("a", "x"))), ("b", "y"))
  let (p, q) = r
  assert_eq(p + q, "ax")
}

test "some of a tuple literal still works for every cell" {
  let a = option.unwrap_or(some(("a", 1)), ("b", 2))
  let (al, an) = a
  assert_eq(al + int.to_string(an), "a1")
  let b = option.unwrap_or(some((1, "a")), (2, "b"))
  let (bn, bl) = b
  assert_eq(int.to_string(bn) + bl, "1a")
  let c = option.unwrap_or(some(("a", "x")), ("b", "y"))
  let (cp, cq) = c
  assert_eq(cp + cq, "ax")
}

test "some of a tuple call result under churn" {
  var total = 0
  for i in [1, 2, 3, 4, 5] {
    let s0: Option[(String, Int)] = none
    let r = option.unwrap_or(some(option.unwrap_or(s0, ("k", i))), ("z", 0))
    let (_l, n) = r
    total = total + n
  }
  assert_eq(total, 15)
}
