// A module-level Bytes `var` handed to a callee, on both legs.
//
// wasm: a call in a function's result leaf may MOVE a dying local into the
// callee (the frame ends there), and the move plan listed a global too —
// `fn show(p) = f(arena, p)` emptied `arena` for every later reader.
// native: a global stores the raw buffer, and a stdlib function with an Almide
// body (`bytes.get_i8`) or a user `mut` parameter takes the mapped one — the
// call did not compile (E0308).
var arena = bytes.from_list([1, 2, 3])

var scratch = bytes.zeros(4)

fn cursor(b: Bytes, pos: Int) -> (Int?, Int) = match bytes.get_u16_le(b, pos) {
  some(v) => (some(v), pos + 2),
  none => (none, pos),
}

fn read_at(pos: Int) -> Int = cursor(arena, pos).1

fn next_at(pos: Int) -> Int = bytes.next_u16_le(arena, pos).1

fn grow(mut b: Bytes, x: Int) -> Unit = bytes.push(b, x)

fn stamp(pos: Int) -> Unit = bytes.put_u16_be(scratch, pos, 258)

test "a global read in a result leaf stays in its slot" {
  assert_eq(read_at(0), 2)
  assert_eq(read_at(1), 3)
  assert_eq(next_at(0), 2)
  assert_eq(next_at(2), 2)
  assert_eq(bytes.to_list(arena), [1, 2, 3])
}

test "a global reaches an Almide-bodied stdlib function and a mut parameter" {
  assert_eq(bytes.get_i8(arena, 2), some(3))
  assert_eq(bytes.first(arena), some(1))
  grow(scratch, 9)
  stamp(0)
  assert_eq(bytes.to_list(scratch), [1, 2, 0, 0, 9])
}
