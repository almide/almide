// Radix-prefixed integer literals (#873): 0x hex, 0b binary, 0o octal,
// case-insensitive, with `_` separators — one value pipeline for all
// three (`literals::radix_and_digits`), identical on every target.
//
// The lexer claims a prefix only when at least one digit of that radix
// follows: a bare `0x` (or `0b2`, `0xg`) lexes as `0` + identifier and
// fails to resolve, instead of silently folding the literal to 0.
test "hex literals" {
  assert_eq(0xFF, 255)
  assert_eq(0Xff, 255)
  assert_eq(0x1_00, 256)
  assert_eq(-0x10, -16)
}

test "binary literals" {
  assert_eq(0b1010, 10)
  assert_eq(0B11, 3)
  assert_eq(0b1_0000_0000, 256)
  assert_eq(-0b100, -4)
}

test "octal literals" {
  assert_eq(0o17, 15)
  assert_eq(0O7_7, 63)
  assert_eq(-0o10, -8)
}

test "radix literals mix with arithmetic and decimal" {
  assert_eq(0xFF + 0b1 + 0o10 + 6, 270)
  assert_eq(0b1010 * 0o12, 100)
}
