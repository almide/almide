// #1079 — a `??` whose OPERAND is a plain USER function (not a self-host stdlib
// call, not a Var) lowers through `try_lower_option_unwrap_or`'s
// `is_named_variant_call` route and emits ONE synthetic unwrap helper
// (`option.unwrap_or_str` / `result.value_unwrap_or`). The caps counter in
// `classify_corpus` credited that shape 0, so the corpus wall saw
// `mir_calls > ir_calls` — the one direction the elided-call soundness backstop
// forbids, because an over-count can mask a real elision and falsely de-taint a
// Stdout-reaching function.
//
// The programs below always RAN correctly on both targets; the defect was the
// accounting invariant. So the real guard is `proofs/corpus-wall.sh` sweeping
// this file — these tests pin the behavior, and the wall pins the caps ledger.
// Both the call-ARGUMENT position (`println(f(x) ?? d)`) and the bound position
// (`let a = f(x) ?? d`) tripped it.
fn first_char(s: String) -> String? = string.get(s, 0)

fn maybe_int(s: String) -> Int? = int.parse(s)?

// A user fn whose operand is used in the call-argument position — the exact
// #1079 repro shape.
fn shout_first(s: String) -> String = string.to_upper(first_char(s) ?? "<none>")

// The same `??`, bound first. Also breached before the fix.
fn bound_first(s: String) -> String = {
  let c = first_char(s) ?? "<none>"
  c + "!"
}

test "user-fn Option[String] operand in call-argument position (#1079)" {
  assert_eq(shout_first("hi"), "H")
  assert_eq(shout_first(""), "<NONE>")
}

test "user-fn Option[String] operand bound first (#1079)" {
  assert_eq(bound_first("hi"), "h!")
  assert_eq(bound_first(""), "<none>!")
}

test "user-fn Option[Int] operand keeps the scalar route (#1079)" {
  // A scalar `??` lowers inline (no helper call), so it must NOT be credited —
  // over-crediting here would leave mir < ir and taint the function for nothing.
  assert_eq(maybe_int("41") ?? -1, 41)
  assert_eq(maybe_int("nope") ?? -1, -1)
}
