test "int elements: the source list survives every family in a repeated body" {
  assert_eq(for_int_find_opt_map(), 30)
  assert_eq(closure_int_find_opt_map(), 30)
  assert_eq(for_int_find_index(), 1)
  assert_eq(closure_int_find_index(), 1)
  assert_eq(for_int_find_map(), 30)
  assert_eq(closure_int_find_map(), 30)
  assert_eq(for_int_any(), 2)
  assert_eq(closure_int_any(), 2)
  assert_eq(for_int_count(), 2)
  assert_eq(closure_int_count(), 2)
  assert_eq(for_int_filter_find(), 2)
  assert_eq(closure_int_filter_find(), 2)
  assert_eq(for_int_fold_elem(), 30)
  assert_eq(closure_int_fold_elem(), 30)
  assert_eq(for_int_map_keep(), 120)
  assert_eq(closure_int_map_keep(), 120)
  assert_eq(for_int_for_in_keep(), 120)
  assert_eq(closure_int_for_in_keep(), 120)
}

test "str elements: the source list survives every family in a repeated body" {
  assert_eq(for_str_find_opt_map(), 3)
  assert_eq(closure_str_find_opt_map(), 3)
  assert_eq(for_str_find_index(), 1)
  assert_eq(closure_str_find_index(), 1)
  assert_eq(for_str_find_map(), 3)
  assert_eq(closure_str_find_map(), 3)
  assert_eq(for_str_any(), 2)
  assert_eq(closure_str_any(), 2)
  assert_eq(for_str_count(), 2)
  assert_eq(closure_str_count(), 2)
  assert_eq(for_str_filter_find(), 2)
  assert_eq(closure_str_filter_find(), 2)
  assert_eq(for_str_fold_elem(), 3)
  assert_eq(closure_str_fold_elem(), 3)
  assert_eq(for_str_map_keep(), 12)
  assert_eq(closure_str_map_keep(), 12)
  assert_eq(for_str_for_in_keep(), 12)
  assert_eq(closure_str_for_in_keep(), 12)
}

test "lst elements: the source list survives every family in a repeated body" {
  assert_eq(for_lst_find_opt_map(), 3)
  assert_eq(closure_lst_find_opt_map(), 3)
  assert_eq(for_lst_find_index(), 1)
  assert_eq(closure_lst_find_index(), 1)
  assert_eq(for_lst_find_map(), 3)
  assert_eq(closure_lst_find_map(), 3)
  assert_eq(for_lst_any(), 2)
  assert_eq(closure_lst_any(), 2)
  assert_eq(for_lst_count(), 2)
  assert_eq(closure_lst_count(), 2)
  assert_eq(for_lst_filter_find(), 2)
  assert_eq(closure_lst_filter_find(), 2)
  assert_eq(for_lst_fold_elem(), 3)
  assert_eq(closure_lst_fold_elem(), 3)
  assert_eq(for_lst_map_keep(), 12)
  assert_eq(closure_lst_map_keep(), 12)
  assert_eq(for_lst_for_in_keep(), 12)
  assert_eq(closure_lst_for_in_keep(), 12)
}
