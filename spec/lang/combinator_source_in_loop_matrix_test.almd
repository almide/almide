// #3208 matrix: one op per combinator family x three element types x two
// repeated-body positions (a for body, a closure body). Each fn binds its
// list locally and reads it once inside the repeated body; native used to
// move it on the first iteration (rustc E0382). Expected values are the
// wasm leg's answers. `js` is local here; its param-shaped twin is
// combinator_source_param_matrix_test.almd (certifier C4, #3214).
fn for_int_find_opt_map() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (list.find(ids, (x) => x == j) |> option.map((y) => y * 10) ?? 0)
  }
  n
}

fn closure_int_find_opt_map() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (j) => list.find(ids, (x) => x == j) |> option.map((y) => y * 10) ?? 0)
  n = n + list.sum(r)
  n
}

fn for_int_find_index() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (list.find_index(ids, (x) => x == j) ?? -1)
  }
  n
}

fn closure_int_find_index() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (j) => list.find_index(ids, (x) => x == j) ?? -1)
  n = n + list.sum(r)
  n
}

fn for_int_find_map() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (list.find_map(ids, (x) => if x == j then some(x * 10) else none) ?? 0)
  }
  n
}

fn closure_int_find_map() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (j) => list.find_map(ids, (x) => if x == j then some(x * 10) else none) ?? 0)
  n = n + list.sum(r)
  n
}

fn for_int_any() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (if list.any(ids, (x) => x == j) then 1 else 0)
  }
  n
}

fn closure_int_any() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (j) => if list.any(ids, (x) => x == j) then 1 else 0)
  n = n + list.sum(r)
  n
}

fn for_int_count() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (list.count(ids, (x) => x == j))
  }
  n
}

fn closure_int_count() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (j) => list.count(ids, (x) => x == j))
  n = n + list.sum(r)
  n
}

fn for_int_filter_find() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (if option.is_some(list.filter(ids, (x) => x != j) |> list.find((x) => x != j)) then 1 else 0)
  }
  n
}

fn closure_int_filter_find() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(
    js,
    (j) => if option.is_some(list.filter(ids, (x) => x != j) |> list.find((x) => x != j)) then 1 else 0,
  )
  n = n + list.sum(r)
  n
}

fn for_int_fold_elem() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for j in js {
    n = n + (match list.fold(ids, none, (a, x) => if x == j then some(x) else a) {
      some(y) => y * 10,
      none => 0,
    })
  }
  n
}

fn closure_int_fold_elem() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(
    js,
    (j) => match list.fold(ids, none, (a, x) => if x == j then some(x) else a) {
      some(y) => y * 10,
      none => 0,
    },
  )
  n = n + list.sum(r)
  n
}

fn for_int_map_keep() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for _j in js {
    n = n + (list.map(ids, (x) => x) |> list.fold(0, (a, x) => a + x * 10))
  }
  n
}

fn closure_int_map_keep() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(js, (_j) => list.map(ids, (x) => x) |> list.fold(0, (a, x) => a + x * 10))
  n = n + list.sum(r)
  n
}

fn for_int_for_in_keep() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  for _j in js {
    n = n + ({
      var c = 0
      for x in ids {
        c = c + x * 10
      }
      c
    })
  }
  n
}

fn closure_int_for_in_keep() -> Int = {
  let js = [1, 2]
  let ids = [1, 2, 3]
  var n = 0
  let r = list.map(
    js,
    (_j) => {
      var c = 0
      for x in ids {
        c = c + x * 10
      }
      c
    },
  )
  n = n + list.sum(r)
  n
}

