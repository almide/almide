// #1060: a tuple pattern in LAMBDA parameter position. The parser has produced
// `tuple_names` since the form was introduced, but nothing downstream read it —
// so the second name was undefined and the writer got E003 on a variable they
// had just written, with nothing saying tuple params were unsupported.
//
// `let` could already destructure, which is why CLAUDE.md documented the
// one-line-tax rewrite as the idiom. Supporting the direct form removes that
// rewrite from the set of things a generator has to know NOT to write.
test "a tuple parameter binds every name (#1060)" {
  let pairs = [(1, "a"), (2, "b")]
  assert_eq(pairs |> list.map(((n, s)) => "${n}${s}"), ["1a", "2b"])
}

test "map.entries pairs destructure directly (#1060)" {
  let m: Map[String, Int] = ["a": 1, "b": 2]
  assert_eq(map.entries(m) |> list.map(((k, v)) => "${k}=${v}"), ["a=1", "b=2"])
}

test "list.enumerate pairs destructure directly (#1060)" {
  assert_eq(["x", "y"] |> list.enumerate |> list.map(((i, s)) => "${i}:${s}"), ["0:x", "1:y"])
}

test "the let-destructure rewrite still means the same thing (#1060)" {
  // The idiom the tuple param replaces — both spellings must agree.
  let pairs = [(3, "c")]
  let direct = pairs |> list.map(((n, s)) => "${n}${s}")
  let rewritten = pairs |> list.map((entry) => {
    let (n, s) = entry
    "${n}${s}"
  })
  assert_eq(direct, rewritten)
}

test "an underscore discards a tuple element (#1060)" {
  let pairs = [(1, "a"), (2, "b")]
  assert_eq(pairs |> list.map(((_, s)) => s), ["a", "b"])
}
