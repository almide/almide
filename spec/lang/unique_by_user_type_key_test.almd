// wasm:skip — native pin (#1812): the structural leg's record/variant key rows live in C-053's fixture
// list.unique_by keyed by a USER type on the native leg (#1812). The runtime's
// `almide_rt_list_unique_by` wanted `K: Eq + Hash` for its `HashSet` seen set,
// which a record or variant — deriving `Clone, Debug, PartialEq` only — never
// satisfies: `almide check` passed and rustc failed with E0277 (ALS-T6). The
// seen set is a `PartialEq` scan now, so any equatable key dedups with the
// first-seen, first-occurrence discipline the structural leg already had.
type K = { a: String, n: Int }

type Parity = | Even | Odd

type Tag = | Lo(Int) | Hi

test "unique_by keyed by a record keeps the first of each key" {
  assert_eq(list.unique_by([
    "ab",
    "abc",
    "ad",
    "bc",
    "b",
    "bd"
  ], (s) => K { a: string.take(s, 1), n: string.len(s) % 2 }), ["ab", "abc", "bc", "b"])
}

test "unique_by keyed by a nullary variant keeps the first of each tag" {
  assert_eq(list.unique_by([1, 2, 3, 4, 5], (x) => if x % 2 == 0 then Even else Odd), [1, 2])
}

test "unique_by keyed by a payload variant compares tag then payload" {
  assert_eq(list.unique_by([
    1,
    4,
    7,
    10,
    12,
    2
  ], (x) => if x < 10 then Lo(x % 3) else Hi), [1, 10, 2])
}

test "unique_by keyed by a Float follows PartialEq: -0.0 == 0.0, NaN never matches" {
  assert_eq(list.unique_by([1, 2, 3], (x) => if x == 1 then 0.0 else -0.0), [1])
  assert_eq(list.unique_by([1, 2, 3], (x) => 0.0 / 0.0), [1, 2, 3])
}
