// #1322 — a scalar `let` of a loop-carried var must copy AT BIND TIME.
// The v1 spine aliased `let t = y` to y's stable local, so after `y = x % y`
// ran its SetLocal, t read the POST-assignment value: the gcd swap degenerated
// to x == y and every gcd came out 0 (identically wrong on native-v1 and wasm,
// so the cross-target gate stayed green — only v0/codegen-v3 was right).
fn gcd(a: Int, b: Int) -> Int = {
  var x = a
  var y = b
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  x
}

fn last_pre_assign_copy() -> Int = {
  var y = 18
  var once = true
  var seen = -1
  while once {
    let t = y
    y = 0
    seen = t
    once = false
  }
  seen
}

test "gcd via let-temp swap survives the loop" {
  assert_eq(gcd(5, 26), 1)
  assert_eq(gcd(6, 26), 2)
  assert_eq(gcd(15, 26), 1)
  assert_eq(gcd(12, 18), 6)
  assert_eq(gcd(0, 7), 7)
}

test "let inside a while body reads the pre-assignment value" {
  assert_eq(last_pre_assign_copy(), 18)
}
