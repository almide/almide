// #3164: a top-level `let` may name a LATER top-level `let`, and a function
// declared above both reads the chain's inferred type — not the registration
// seed. Registration seeds each `let` in source order, so `TABLE`'s seed was
// `List[(Int, Unknown)]` while `WORD` was not yet typed; `all_words` read that
// seed, its loop variable stayed `(Int, Unknown)`, and the build panicked in
// `ConcretizeTypes` behind a green `almide check`. Declaration order does not
// matter for functions, so it does not matter for these either.
fn all_words() -> String = {
  var out = ""
  for p in PAIRS {
    out = out + p.1 + ";"
  }
  out
}

fn total() -> Int = list.fold(PAIRS, 0, (acc, p) => acc + string.len(p.1) + p.0)

fn names() -> List[String] = TABLE |> list.map((p) => p.1)

let TABLE = [(1, WORD), (2, WORD + "!")]

let PAIRS = TABLE

let WORD = PREFIX + "x"

let PREFIX = greet("hi")

fn greet(s: String) -> String = s + "-"

// The same order with a user type in the chain: the pre-pass that types the
// lets first must hand the function `List[Shape]`, the type the program
// spells, not a pre-pass-internal qualified name.
type Shape = | Circle(Int) | Square(Int)

fn area(s: Shape) -> Int = match s {
  Circle(r) => 3 * r * r,
  Square(w) => w * w,
}

fn total_area() -> Int = SHAPES |> list.fold(0, (a, s) => a + area(s))

let SHAPES = [Circle(SIDE), Square(SIDE + 1)]

let SIDE = 2

test "a fn above a let chain reads the chain's type" {
  assert_eq(all_words(), "hi-x;hi-x!;")
  assert_eq(total(), 12)
  assert_eq(names(), ["hi-x", "hi-x!"])
}

test "the issue's shape: a list of pairs naming a later let" {
  assert_eq(PAIRS, [(1, "hi-x"), (2, "hi-x!")])
}

test "a user-typed let chain read from above" {
  assert_eq(total_area(), 21)
}
