// #1461 — list-rest patterns (ALS-E18): `[h, ..t]` matches any list of
// length >= the prefix and binds the tail as a list; `[h, ..]` ignores
// it. The rest slot is last-only (parse error otherwise). The Rust leg's
// coverage ladder terminates a fully-covered chain without a wildcard.
fn total(xs: List[Int]) -> Int = match xs {
  [] => 0,
  [h, ..t] => h + total(t),
}

fn shape(xs: List[Int]) -> String = match xs {
  [] => "empty",
  [x] => "one:${x}",
  [a, b, ..] => "many:${a},${b}",
}

fn heads(xs: List[String]) -> String = match xs {
  [h, ..t] if list.len(t) > 0 => "${h}+${list.len(t)}",
  [h, ..] => "solo:${h}",
  [] => "none",
}

test "recursive sum through the rest tail" {
  assert_eq(total([1, 2, 3, 4, 5]), 15)
  assert_eq(total([]), 0)
}

test "coverage ladder terminates the natural chain" {
  assert_eq(shape([]), "empty")
  assert_eq(shape([7]), "one:7")
  assert_eq(shape([9, 8, 7]), "many:9,8")
}

test "guards on rest arms and the ignored-rest form" {
  assert_eq(heads(["a", "b", "c"]), "a+2")
  assert_eq(heads(["z"]), "solo:z")
  assert_eq(heads([]), "none")
}

test "whole-list rest binds the subject list" {
  let t = match ["x", "y"] {
    [..all] => all
  }
  assert_eq(list.join(t, "+"), "x+y")
}

// ── #1934: tuple patterns as list-pattern elements ──
// #1934: a list pattern whose element is a TUPLE pattern (`[(name, n), ..rest]`)
// bound nothing for `name` / `n` on the native leg — the list-pattern
// lowering handled only a plain bind per element, so rustc saw free names
// behind a green check. The structural leg lowered it all along. A nested
// irrefutable tuple binds each element through its index; a wildcard inside
// stays unbound.
fn first_len(xs: List[(String, Int)]) -> Int = match xs {
  [] => 0,
  [(name, n), ..rest] => list.len(rest |> list.filter((p) => string.starts_with(p.0, name))) + n + string.len(name),
}

fn head_pair(xs: List[(String, Int)]) -> String = match xs {
  [(a, _), (b, m)] => "${a}/${b}:${m}",
  [(only, _)] => only,
  _ => "-",
}

fn nested(xs: List[((Int, Int), String)]) -> Int = match xs {
  [((x, y), _), ..] => x * 10 + y,
  [] => -1,
}

test "tuple head of a list-rest pattern binds" {
  assert_eq(first_len([("ab", 1), ("abc", 2), ("x", 3)]), 4)
  assert_eq(first_len([]), 0)
}

test "tuple elements in exact-length list patterns bind" {
  assert_eq(head_pair([("p", 1), ("q", 2)]), "p/q:2")
  assert_eq(head_pair([("solo", 9)]), "solo")
  assert_eq(head_pair([]), "-")
}

test "nested tuple pattern in a list pattern binds" {
  assert_eq(nested([((4, 2), "z")]), 42)
  assert_eq(nested([]), -1)
}
