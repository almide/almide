// scalar_identity_test — the PR-gated twin of the fuzzer's identity family
// (#1332, tools/xtarget-fuzz/src/generator/identity.rs).
//
// Each test below is ONE of the generator's identity blocks: a statement
// group that provably restores its accumulator, so the expected value is
// known by construction rather than by comparing two backends. That is the
// property the nightly generator randomizes and composes; here it is one
// fixed instance per block kind, running in the PR suite.
//
// Why both: the generator explores compositions no one wrote down, but it
// only runs nightly. #1322 (a scalar let-alias miscompile) survived from
// v0.57.0 because native and wasm share almide-mir and were identically
// wrong, so the 394 cross-target parity fixtures all stayed green. A
// single-leg oracle catches that class; these run on every PR.
//
// Keep this list in step with `enum Block` in identity.rs — a block kind
// with no test here is a shape only the nightly can catch.
fn xf_add(x: Int, d: Int) -> Int = x + d

fn xf_sub(x: Int, d: Int) -> Int = x - d

// Block::AddSub — the additive inverse pair, with a nested body between.
test "add/sub pair is an identity across a nested body" {
  var a = 41
  a = a + 1796
  a = a * 3
  a = a / 3
  a = a - 1796
  assert_eq(a, 41)
}

// Block::Snapshot — THE #1322 shape. Sound only if `let s = a` copies the
// scalar instead of aliasing the mutable slot; an aliasing lowering
// restores the PERTURBED value and this fails.
test "let-of-var snapshot restores the pre-perturbation value" {
  var a = 41
  let snap = a
  a = a + 1796
  a = a - 7
  a = snap
  assert_eq(a, 41)
}

// Block::Swap — two three-way swaps between mutable slots compose to
// identity. The same alias question, across two accumulators.
test "double swap of two accumulators is an identity" {
  var a = 41
  var b = -7
  let t1 = a
  a = b
  b = t1
  let t2 = a
  a = b
  b = t2
  assert_eq(a, 41)
  assert_eq(b, -7)
}

// Block::Negate / Block::Xor / Block::MulDiv — self-inverse and paired ops.
test "negate, xor and mul/div pairs are identities" {
  var a = 41
  a = 0 - a
  a = 0 - a
  assert_eq(a, 41)
  a = int.bxor(a, 20250813)
  a = int.bxor(a, 20250813)
  assert_eq(a, 41)
  a = a * 7
  a = a / 7
  assert_eq(a, 41)
}

// Block::FnRound / Block::ClosureRound — the round trip through a named fn
// and through captured closures.
test "fn and closure round trips are identities" {
  var a = 41
  a = xf_add(a, 3571)
  a = xf_sub(a, 3571)
  assert_eq(a, 41)
  let up = (x: Int) => x + 77
  let dn = (x: Int) => x - 77
  a = up(a)
  a = dn(a)
  assert_eq(a, 41)
}

// Block::MatchBalanced — the SAME let-bound subject decides both matches,
// so whichever arm is taken cancels itself. Which arm that is never enters
// the oracle.
test "balanced match arms on one subject cancel" {
  var a = 41
  let key = a % 3
  a = a + match key {
    0 => 4189,
    1 => -7166,
    _ => 4965,
  }
  a = a - match key {
    0 => 4189,
    1 => -7166,
    _ => 4965,
  }
  assert_eq(a, 41)
}

// Block::BranchBalanced — branch-arm assignment, mirrored. Identity for
// EITHER value of the condition.
test "mirrored branch-arm assignment is an identity" {
  var a = 41
  let c = a > 5
  if c then {
    a = a + 8943
  } else {
    a = a - 8943
  }
  if c then {
    a = a - 8943
  } else {
    a = a + 8943
  }
  assert_eq(a, 41)
}

// Block::BranchNest — both arms hold the SAME identity body, so the taken
// arm cannot matter.
test "identical identity bodies in both branch arms" {
  var a = 41
  if a % 2 == 0 then {
    a = a + 13
    a = a - 13
  } else {
    a = a + 13
    a = a - 13
  }
  assert_eq(a, 41)
}

// Block::WhileNest — an identity body run N times is still an identity.
test "an identity body inside a while loop stays an identity" {
  var a = 41
  var i = 0
  while i < 6 {
    let s = a
    a = a + 101
    a = s
    i = i + 1
  }
  assert_eq(a, 41)
}

// Block::WhileCarry — loop-CARRIED scalar state, compensated by the
// literal `d * trips`, with the loop body reading through a `let` (the
// #1322 shape inside loop-carried state).
test "loop-carried accumulation compensates exactly" {
  var a = 41
  var i = 0
  while i < 3 {
    let cur = a
    a = cur + 896
    i = i + 1
  }
  a = a - 2688
  assert_eq(a, 41)
}

// Block::ForRange — the optimized range path, compensated by the
// triangular number.
test "for over a range compensates by the triangular number" {
  var a = 41
  for i in 0..<24 {
    a = a + i
  }
  a = a - 276
  assert_eq(a, 41)
}

// Block::ForListZero — a list whose elements sum to zero BY CONSTRUCTION,
// so no compensating literal is needed at all.
test "for over a zero-sum list needs no compensation" {
  var a = 41
  for x in [3700, -8, -3700, 8] {
    a = a + x
  }
  assert_eq(a, 41)
}

// Block::TupleRound / Block::ListRound / Block::BlockExpr — the value's
// round trip through a tuple, a list and a block expression.
test "tuple, list and block-expression round trips are identities" {
  var a = 41
  let p = (a, 12)
  let (u, v) = p
  a = u + v - 12
  assert_eq(a, 41)
  let xs: List[Int] = [a, 3700]
  a = list.get(xs, 0) ?? -999999919
  assert_eq(a, 41)
  a = {
    let t = a + 31
    t - 31
  }
  assert_eq(a, 41)
}
