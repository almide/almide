// #1168: `!` in a for-in ITERABLE HEAD desugars to the hoisted bind
// (`let $t = <head>!; for … in $t`) so the loop lowers on both legs — the
// user's manual workaround, automated. Covers the bare-body form (the fn IS
// the loop), the mid-block form, and the err path propagating out of the head.
import testing

let FACES = [
  ["+---+", "|   |"],
  ["+---+", "| o |"]
]

effect fn face_lines(n: Int) -> Result[Int, String] = {
  var count = 0
  for row in list.get(FACES, n - 1)! {
    count = count + string.len(row) * 0 + 1
  }
  ok(count)
}

effect fn bare_body(n: Int) -> Result[Unit, String] = {
  for row in list.get(FACES, n - 1)! {
    let _ = string.len(row)
  }
  ok(())
}

test "for-in head ! iterates the looked-up row set" {
  assert_eq(face_lines(1)!, 2)
  assert_eq(face_lines(2)!, 2)
}

test "for-in head ! propagates the miss as err" {
  match face_lines(9) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => assert_eq(e, "none"),
  }
  match bare_body(9) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => assert_eq(e, "none"),
  }
}
