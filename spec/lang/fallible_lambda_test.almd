// ADR-0006 D1 / ADR-0009 (#1108 Phase 2b): lambdas are fallibility-inferred
// "mini fallible fns". The ratified rules (2026-08-07, L1–L9):
//   L1 first-class everywhere (not HOF-arg-only)   L2 usage-driven (a `!` in
//   the body marks it)   L3 E = String   L4 none → err("none")   L5 value
//   tails lift into ok(...)   L6 any `!` in a core-HOF callback = first-err
//   L7/L8 `(A) -> B!` fn-type slots; an explicit slot's user HOF composes
//   L9 test-block lambdas keep unwrap semantics (asserted directly below;
//   the fallible-lambda rules are exercised through pure helper fns, since
//   the test context deliberately opts out of the channel).
import testing

fn parse1(s: String) -> Result[Int, String] = int.parse(s)

fn halve(n: Int) -> Result[Int, String] = if n % 2 == 0 then ok(n / 2)
else err("odd:${n}")

// L1: bind, call, consume — first-class in a pure fn body.
fn use_first_class() -> (Int, Int) = {
  let g = (x) => parse1(x)! * 2
  (g("21") ?? -1, g("z") ?? -1)
}

// L2 + L5: usage-driven bit; guard + value tail lift inside the lambda.
fn use_guarded() -> (Int, Int, Int) = {
  let h = (x) => {
    let n = parse1(x)!
    guard n > 0 else err("neg")
    n + 100
  }
  let total = (x) => x * 3
  (h("7") ?? -1, h("-5") ?? -1, total(4))
}

// L4: an Option operand's none maps to err("none").
fn use_option_operand() -> (Int, String) = {
  let first_or = (xs) => list.first(xs)! + 1
  let empty: List[Int] = []
  let msg = match first_or(empty) {
    ok(_) => "unexpected",
    err(e) => e,
  }
  (first_or([41]) ?? -1, msg)
}

// L6: a compound fallible callback instantiates the first-err form.
fn use_compound_ok() -> List[Int] = list.map(["4", "8"], (s) => halve(parse1(s)!)!) ?? []

fn use_compound_err() -> String = match list.map(["4", "7", "x"], (s) => halve(parse1(s)!)!) {
  ok(_) => "unexpected",
  err(e) => e,
}

// L7/L8: an explicit fallible slot — a USER HOF over a fallible callback.
fn retryer(op: (Int) -> Int!, seed: Int) -> Int! = op(seed)!

fn twice(op: (Int) -> Int!, seed: Int) -> Int! = op(op(seed)!)!

fn use_explicit_slot() -> (Int, Int, Int) = {
  let a = retryer((n) => parse1(int.to_string(n))! + 1, 41) ?? -1
  let b = retryer((n) => parse1("x")! + n, 1) ?? -1
  let c = twice((n) => parse1(int.to_string(n))! + 1, 40) ?? -1
  (a, b, c)
}

test "L1: first-class fallible lambda" {
  assert_eq(use_first_class(), (42, -1))
}

test "L2+L5: usage-driven bit, guard, value-tail lift" {
  assert_eq(use_guarded(), (107, -1, 12))
}

test "L4: none maps to err none" {
  let (v, msg) = use_option_operand()
  assert_eq(v, 42)
  testing.assert_contains(msg, "none")
}

test "L6: compound callback is first-err" {
  assert_eq(use_compound_ok(), [2, 4])
  testing.assert_contains(use_compound_err(), "odd:7")
}

test "L7+L8: explicit fallible slots compose" {
  assert_eq(use_explicit_slot(), (42, -1, 42))
}

test "L9: test-block lambda bang stays unwrap, map stays map" {
  let r = ["1", "2"] |> list.map((x) => int.parse(x)!)
  assert_eq(r, [1, 2])
}
