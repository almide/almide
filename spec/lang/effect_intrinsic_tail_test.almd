// wasm:skip — http.serve has no STOCK wasm artifact (a p1 module has no TCP
// listener; it serves on the embedded lane only, #2650 / #2659), so this file
// is compiled+run on the native target only.
//
// Intrinsic effect tails must follow the runtime's actual return ABI.
// http.serve now returns Unit in both the declaration and runtime; normal
// effect tail wrapping applies, just as for io.print and io.read_line.
// The listener's callback still returns Result[HttpResponse, String].
// These functions are compiled even though the test does not invoke the
// blocking listener or stdin reader. Live server behavior is covered by
// http_serve_cross_test and http_serve_handler_abort_test.
import http
import io

effect fn _serve_demo() -> Unit = {
  http.serve(8080, (req) => http.response(200, http.path(req)))
}

effect fn _print_tail() -> Unit = {
  let s = "hello"
  io.print(s)
}

effect fn _read_tail() -> String? = io.read_line()

test "effect-fn tail call to an intrinsic effect fn compiles" {
  assert_eq(1, 1)
}
