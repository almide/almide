// A pure fn may call `panic` and keep a pure signature (ADR-0022).
fn fail(n: Int) -> Unit = panic("negative: ${n}")

fn safe_half(n: Int) -> Int = {
  if n < 0 then fail(n) else ()
  n / 2
}

test "panic compiles in dead branch" {
  let x = 42
  if x == 0 then panic("unreachable") else ()
  assert_eq(x, 42)
}

test "panic in guard else" {
  let x = 10
  guard x > 0 else panic("x must be positive")
  assert_eq(x, 10)
}

test "a pure fn that may panic returns its value when it does not" {
  assert_eq(safe_half(10), 5)
}
