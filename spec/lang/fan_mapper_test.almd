// fan.settle MAPPER form (T2-3, the Wave 2 surface): a dynamic list + one
// callback, collecting EVERY element's Result (it IS list.map by desugar).
// The first-Ok-in-list-order selection that `fan.any(xs, f)` used to spell
// (removed in dialect epoch 14, ADR-0028) is `list.find_map(xs, (x) => f(x)?)`:
// `?` turns an element's Err into none so that element is skipped, the early
// cut is structural (later elements never run), and all-fail is the `??`
// fallback. Both deterministic on both targets.
effect fn probe(n: Int) -> Result[Int, String] = if n > 2 then ok(n * 10) else err("too small")

test "list.find_map returns the first Ok in list order" {
  let w = list.find_map([1, 3, 5], (n) => probe(n)?) ?? -1
  assert_eq(w, 30)
}

test "list.find_map all-fail is the fallback" {
  let x = list.find_map([1, 2], (n) => probe(n)?) ?? -1
  assert_eq(x, -1)
}

test "list.find_map over an empty list is the fallback" {
  let x = list.find_map([], (n: Int) => probe(n)?) ?? -1
  assert_eq(x, -1)
}

test "fan.settle mapper collects every Result" {
  let rs = fan.settle([1, 3, 5], (n) => probe(n))
  assert_eq(list.len(rs), 3)
}
