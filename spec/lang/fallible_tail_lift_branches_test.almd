// #3385: in a `-> T!` body every value exit lifts into `ok(..)` on its own
// (ADR-0002 D3). An `if` lifts per branch exactly as a `match` lifts per
// arm, so a plain value beside an explicit `ok(..)` / `err(..)` is no
// mismatch in either form.

fn if_value_then_ok(b: Bool) -> Int! =
  if b then {
    let x = 1
    x
  } else ok(2)

fn if_ok_then_value(b: Bool) -> Int! = if b then ok(1) else 2

fn if_err_then_value(b: Bool) -> Int! = if b then err("no") else 1

fn match_value_and_ok(b: Bool) -> Int! = match b {
  true => 1,
  false => ok(2),
}

fn match_mixed(x: Int) -> Int! = match x {
  0 => ok(10),
  1 => err("one"),
  _ => x,
}

fn nested(a: Bool, b: Bool) -> Int! = if a then (if b then 1 else ok(2)) else 3

fn block_tail(b: Bool) -> String! = {
  let base = "v"
  if b then base else ok("${base}!")
}

fn sized(b: Bool) -> Int8! = if b then 1 else ok(2)

test "if branches lift one by one" {
  assert_eq(if_value_then_ok(true), ok(1))
  assert_eq(if_value_then_ok(false), ok(2))
  assert_eq(if_ok_then_value(true), ok(1))
  assert_eq(if_ok_then_value(false), ok(2))
  assert_eq(if_err_then_value(true), err("no"))
  assert_eq(if_err_then_value(false), ok(1))
}

test "match arms lift one by one" {
  assert_eq(match_value_and_ok(true), ok(1))
  assert_eq(match_value_and_ok(false), ok(2))
  assert_eq(match_mixed(0), ok(10))
  assert_eq(match_mixed(1), err("one"))
  assert_eq(match_mixed(5), ok(5))
}

test "nested, block-tail and sized lifts" {
  assert_eq(nested(true, true), ok(1))
  assert_eq(nested(true, false), ok(2))
  assert_eq(nested(false, true), ok(3))
  assert_eq(block_tail(true), ok("v"))
  assert_eq(block_tail(false), ok("v!"))
  assert_eq(sized(true), ok(1))
  assert_eq(sized(false), ok(2))
}
