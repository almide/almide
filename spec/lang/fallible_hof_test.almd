// ADR-0006 D1 (#1108 Phase 2a): the 1-bit fallibility rule — a CANONICAL
// fallible callback instantiates the core list HOF's fallible form:
//     list.map(xs, (x) => f(x)!)   ≡ first-err short-circuit → List[B]!
//     list.map(xs, parse)          — a named `-> T!` fn carries the bit too
// The lambda's `!` is the propagation marker (Swift's `try xs.map(f)` shape);
// E is String (ADR-0002 D2). A total callback keeps the total HOF — the two
// meanings coexist on ONE name per combinator.
import testing

fn parse_pos(s: String) -> Int! = {
  let n = int.parse(s)!
  guard n > 0 else err("must be positive")
  ok(n)
}

fn is_small(n: Int) -> Bool! = if n < 0 then err("negative has no size class") else ok(n < 10)

fn record_seen(n: Int) -> Unit! = if n < 0 then err("cannot record a negative") else ok(())

fn halves(n: Int) -> List[Int]! = if n % 2 == 0 then ok([n / 2, n / 2])
else err("odd cannot halve")

fn maybe_double(n: Int) -> Int?! = if n < 0 then err("negative")
else if n % 2 == 0 then ok(some(n * 2)) else ok(none)

fn add_checked(a: Int, x: Int) -> Int! = if x > 100 then err("too big") else ok(a + x)

test "map: fallible lambda — ok path and first-err short-circuit" {
  assert_eq(list.map(["1", "2", "3"], (s) => parse_pos(s)!) ?? [], [1, 2, 3])
  match list.map(["1", "-7", "x"], (s) => parse_pos(s)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "positive"),
  }
}

test "map: a named -> T! fn is a fallible callback" {
  assert_eq(list.map(["4", "5"], parse_pos) ?? [], [4, 5])
}

test "map: pipe spelling" {
  match ["1", "2"] |> list.map((s) => parse_pos(s)!) {
    ok(v) => assert_eq(v, [1, 2]),
    err(_) => testing.assert_contains("unexpected", "never"),
  }
}

// #1127 regression: the pipe-position `??` over a Result-producing call must
// take the RESULT-shaped unwrap (it lowered an Option-shaped Some/None match
// — check green, rustc E0308 — until 0.56.1).
test "map: pipe spelling with ?? fallback" {
  assert_eq(["1", "2"] |> list.map((s) => parse_pos(s)!) ?? [0], [1, 2])
  assert_eq(["1", "x"] |> list.map((s) => parse_pos(s)!) ?? [0], [0])
}

test "filter: fallible predicate" {
  assert_eq(list.filter([1, 20, 3], (n) => is_small(n)!) ?? [], [1, 3])
  match list.filter([1, -2, 3], (n) => is_small(n)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "size class"),
  }
}

test "flat_map and filter_map: fallible callbacks" {
  assert_eq(list.flat_map([2, 4], (n) => halves(n)!) ?? [], [1, 1, 2, 2])
  match list.flat_map([2, 3], (n) => halves(n)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "odd"),
  }
  assert_eq(list.filter_map([2, 3, 4], (n) => maybe_double(n)!) ?? [], [4, 8])
  match list.filter_map([2, -1], (n) => maybe_double(n)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "negative"),
  }
}

test "fold: fallible two-arg callback" {
  assert_eq(list.fold([1, 2, 3], 0, (a, x) => add_checked(a, x)!) ?? -1, 6)
  match list.fold([1, 200], 0, (a, x) => add_checked(a, x)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "too big"),
  }
}

test "find: fallible predicate" {
  assert_eq((list.find([1, 20, 3], (n) => is_small(n)!) ?? none) ?? -1, 1)
  match list.find([-5, 1], (n) => is_small(n)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "size class"),
  }
}

test "each: fallible callback short-circuits" {
  match list.each([1, 2], (n) => record_seen(n)!) {
    ok(_) => testing.assert_contains("fine", "fine"),
    err(_) => testing.assert_contains("unexpected", "never"),
  }
  match list.each([1, -2], (n) => record_seen(n)!) {
    ok(_) => testing.assert_contains("unexpected", "never"),
    err(e) => testing.assert_contains(e, "record"),
  }
}
