// effect_fn_value_test — a NAMED fn referenced as a VALUE carries the effect
// carrier in its type (#1148): an effect fn's value is a
// `(A) -> Result[B, String]` closure (the checker bakes the carrier), and a
// PURE fn filling an `effect (A) -> B` slot is ok-wrapped at the slot — both
// the let-annotation site and the call-arg site.
effect fn parse_twice(s: String) -> Int = {
  let n = int.parse(s)!
  n * 2
}

fn pure_len3(s: String) -> Int = string.len(s) * 3

effect fn apply_slot(f: effect (String) -> Int, s: String) -> Int = f(s)!

test "effect fn value: annotated let, direct call" {
  let h: effect (String) -> Int = parse_twice
  assert_eq(h("21")!, 42)
}

test "effect fn value: unannotated let, direct call" {
  let h = parse_twice
  assert_eq(h("21")!, 42)
}

test "effect fn value: pipe call" {
  let h: effect (String) -> Int = parse_twice
  let a = ("21" |> h)!
  assert_eq(a, 42)
}

test "named effect fn into an effect param slot" {
  assert_eq(apply_slot(parse_twice, "21")!, 42)
}

test "pure fn into an effect-annotated let is ok-wrapped" {
  let h: effect (String) -> Int = pure_len3
  assert_eq(h("ab")!, 6)
}

test "pure fn into an effect param slot is ok-wrapped" {
  assert_eq(apply_slot(pure_len3, "ab")!, 6)
}

effect fn first_of(xs: List[Result[Int, String]]) -> Int = xs[0]!

test "effect fn value through a pure HOF yields carriers" {
  let xs = ["1", "2"] |> list.map(parse_twice)
  assert_eq(list.len(xs), 2)
  assert_eq(first_of(xs)!, 2)
}
