// `xs = list.set(xs, i, v)` writes the slot in place (#2244): the same value
// semantics as the copying `list.set`, without the copy. What a program can
// observe is pinned here — the write, an alias's independence, the tolerant
// bounds, single evaluation of the index, a value read from the list itself,
// the UFCS spelling. Nested and record elements are pinned on both targets by
// tests/list_set_in_place_test.rs (the wasm TEST lane walls heap-element
// stores, so they cannot sit in a spec test that must run on that lane).
var calls = 0

fn next_index() -> Int = {
  calls = calls + 1
  1
}

test "self-assigned set writes the slot" {
  var xs = ["a", "b", "c"]
  xs = list.set(xs, 1, "B")
  assert_eq(xs, ["a", "B", "c"])
}

test "an alias taken before the set keeps the old value" {
  var xs = [1, 2, 3]
  let ys = xs
  xs = list.set(xs, 1, 9)
  assert_eq(ys, [1, 2, 3])
  assert_eq(xs, [1, 9, 3])
}

test "out of range on either side is a no-op, as list.set is" {
  var xs = [1, 2, 3]
  xs = list.set(xs, -1, 9)
  xs = list.set(xs, 3, 9)
  assert_eq(xs, [1, 2, 3])
  assert_eq(list.set([1, 2, 3], 3, 9), [1, 2, 3])
}

test "the index is evaluated once and the value may read the list" {
  var xs = ["a", "b", "c"]
  xs = list.set(xs, next_index(), xs[0] + xs[2])
  assert_eq(xs, ["a", "ac", "c"])
  assert_eq(calls, 1)
}

test "the UFCS spelling is the same statement" {
  var xs = [1, 2, 3]
  xs = xs.set(0, 7)
  assert_eq(xs, [7, 2, 3])
}

test "a set assigned to another list still copies" {
  var xs = [1, 2, 3]
  let zs = list.set(xs, 2, 9)
  assert_eq(xs, [1, 2, 3])
  assert_eq(zs, [1, 2, 9])
}

test "a loop of self-assigned sets is linear" {
  var xs: List[Int] = []
  var i = 0
  while i < 4000 {
    list.push(xs, 0)
    i = i + 1
  }
  var j = 0
  while j < 4000 {
    xs = list.set(xs, j, j)
    j = j + 1
  }
  assert_eq(xs[0], 0)
  assert_eq(xs[3999], 3999)
  assert_eq(list.len(xs), 4000)
}
