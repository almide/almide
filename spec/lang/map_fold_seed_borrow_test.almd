// Regression #866: a `map.fold` whose SEED expression consumes the fold's own
// SUBJECT — `map.fold(acc, (if p then other else acc), f)` — used to emit
// `almide_rt_map_fold(&acc, … acc …)`: the subject borrow lives until the call
// executes, so the seed's move of the same var was E0505 after `check`
// accepted. The clone-insertion E0505 guard now covers intrinsic-lowered
// `RuntimeCall`s too (it only knew `Call` nodes — the #809 fix), so the seed
// occurrence clones. Sibling of #809; the borrow-vs-move authority inside one
// call is rustc's borrow live-range, not the flat last-use count.

fn pick(base: Map[String, Int], grow: Bool) -> Int = {
  let seeded = map.fold(
    base,
    (if grow then ["k": 1] else base),
    (acc, k, v) => map.set(acc, k, v + 1),
  )
  map.len(seeded)
}

test "fold seed may reference the fold subject" {
  let m: Map[String, Int] = ["a": 10, "b": 20]
  assert_eq(pick(m, false), 2)
  assert_eq(pick(m, true), 3)
}

test "nested fold with subject-consuming seed builds and runs" {
  let acc: Map[String, Bool] = [:]
  let r = map.fold(
    map.fold(acc, (if map.get_or(["k0": false], "x", true) then ["k0": true] else acc), (a, k, v) => map.set(a, k, v)),
    "z",
    (a, k, v) => a + "!",
  )
  assert_eq(r, "z!")
}
