// wasm:enabled
// Locks in `${Option[T]}` interpolation — v0's `some(<T>)` / `none` compound repr — for the element
// types the trust-spine self-hosts (Int, String, Bool). Each `option.to_string*` is self-host .almd
// (a 2-arm Option match + repr build), routed per element type exactly like the List family; a String
// element is quoted+escaped like a List[String] element. Byte-identical to v0 --target wasm.
effect fn main() -> Unit = {
  let a: Int? = some(42)
  let b: Int? = some(-7)
  let c: Int? = none
  println("${a}")
  println("${b}")
  println("${c}")
  println("val=${a} end")
  let s: String? = some("hi")
  let sq: String? = some('a "b" c')
  let sn: String? = none
  println("${s}")
  println("${sq}")
  println("${sn}")
  let fa: Float? = some(3.5)
  let fb: Float? = some(3.0)
  let fc: Float? = none
  println("${fa}")
  println("${fb}")
  println("${fc}")
  let t: Bool? = some(true)
  let f: Bool? = some(false)
  let n: Bool? = none
  println("${t}")
  println("${f}")
  println("${n}")
}
