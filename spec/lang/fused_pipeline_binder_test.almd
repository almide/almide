// Fused list pipelines must agree with the unfused spelling — including when
// every callback is a BARE fn name.
//
// A bare fn argument is eta-expanded into a lambda whose params are named
// `_fn_arg<i>` counting from zero, so a pipeline written entirely with bare
// names hands the egg-saturation fusion rules several lambdas whose params
// share a name. The two rules that build a TWO-element binder list
// (map-into-fold, filter_map-into-fold) then emitted
// `move |_fn_arg0: i64, _fn_arg0: i64|` — rustc E0415, the whole program
// failed to build (found by spec/regression/monkey23_higher_order_test.almd).
//
// Fixing the NAMES then exposed the second half: the same pipeline returned 21
// where the unfused spelling returned 35. So this file asserts VALUES against
// the lambda spelling, not just that the program compiles — a fused pipeline
// that builds and answers wrong is worse than one that refuses to build.
local fn dbl(x: Int) -> Int = x * 2

local fn inc(x: Int) -> Int = x + 1

local fn pos(x: Int) -> Bool = x > 0

local fn add(a: Int, b: Int) -> Int = a + b

local fn mul(a: Int, b: Int) -> Int = a * b

local fn pair(x: Int) -> List[Int] = [x, x]

// bare-name spellings (fusion fires)
local fn bare_map_fold(xs: List[Int]) -> Int = xs |> list.map(dbl) |> list.fold(0, add)

local fn bare_map_filter_fold(xs: List[Int]) -> Int = xs |> list.map(dbl) |> list.filter(pos) |> list.fold(0, add)

local fn bare_long(xs: List[Int]) -> Int = xs |> list.map(dbl) |> list.filter(pos) |> list.map(inc) |> list.fold(0, add)

local fn bare_flatmap_fold(xs: List[Int]) -> Int = xs |> list.flat_map(pair) |> list.map(dbl) |> list.fold(0, add)

local fn bare_mul_fold(xs: List[Int]) -> Int = xs |> list.filter(pos) |> list.map(dbl) |> list.fold(1, mul)

// lambda spellings (the oracle)
local fn lam_map_fold(xs: List[Int]) -> Int = xs |> list.map((v) => dbl(v)) |> list.fold(0, (p, q) => add(p, q))

local fn lam_map_filter_fold(xs: List[Int]) -> Int = xs |> list.map((v) => dbl(v)) |> list.filter((v) => pos(v)) |> list.fold(0, (p, q) => add(p, q))

local fn lam_long(xs: List[Int]) -> Int = xs |> list.map((v) => dbl(v)) |> list.filter((v) => pos(v)) |> list.map((v) => inc(v)) |> list.fold(0, (p, q) => add(p, q))

local fn lam_flatmap_fold(xs: List[Int]) -> Int = xs |> list.flat_map((v) => pair(v)) |> list.map((v) => dbl(v)) |> list.fold(0, (p, q) => add(p, q))

local fn lam_mul_fold(xs: List[Int]) -> Int = xs |> list.filter((v) => pos(v)) |> list.map((v) => dbl(v)) |> list.fold(1, (p, q) => mul(p, q))

test "a bare-name pipeline agrees with its lambda spelling" {
  let xs = [1, 2, 3]
  assert_eq(bare_map_fold(xs), lam_map_fold(xs))
  assert_eq(bare_map_filter_fold(xs), lam_map_filter_fold(xs))
  assert_eq(bare_long(xs), lam_long(xs))
  assert_eq(bare_flatmap_fold(xs), lam_flatmap_fold(xs))
  assert_eq(bare_mul_fold(xs), lam_mul_fold(xs))
}

test "the fused values are the hand-computed ones, not merely self-consistent" {
  // Pinning the answers too: two wrong-but-equal implementations would satisfy
  // the differential test above and nothing else.
  let xs = [1, 2, 3]
  assert_eq(bare_map_fold(xs), 12)
  assert_eq(bare_map_filter_fold(xs), 12)
  assert_eq(bare_long(xs), 15)
  assert_eq(bare_flatmap_fold(xs), 24)
  assert_eq(bare_mul_fold(xs), 48)
}

test "the five-element chain that first surfaced the wrong value" {
  // 35, not 21: [1..5] -> double -> all positive -> inc -> sum.
  assert_eq(bare_long([1, 2, 3, 4, 5]), 35)
}
