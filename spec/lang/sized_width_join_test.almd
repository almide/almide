// A PEER JOIN that mixes a sized numeric with bare literals settles on the SIZED
// width, and the literals adopt it (#880).
//
// The join used to take the FIRST peer's type, so `[1, u]` typed `List[Int]`
// while `[u, 1]` typed `List[UInt8]` — the same list with its elements swapped,
// two different types. The `Int` reading emitted `vec![1i64, 3u8]` natively
// (rustc E0308) while wasm ran it anyway, every scalar riding one i64 lane: an
// `almide check` pass that only one target could build. These are the accepted
// shapes; the rejections (a canonical VALUE peer, and a sized value returned
// into a canonical `Int` slot) live in tests/sized_width_peer_join_test.rs.

fn widen(u: UInt8) -> Int = int.from_uint8(u)

test "a list literal joins to the sized element width" {
  let u: UInt8 = 3
  let xs = [1, u]
  assert_eq(list.len(xs), 2)
}

test "if arms join to the sized width" {
  let u: UInt8 = 3
  let v = if false then 1 else u
  assert_eq(uint8.to_string(v), "3")
  let w = if true then 1 else u
  assert_eq(uint8.to_string(w), "1")
}

test "match arms join to the sized width" {
  let u: UInt8 = 9
  let v = match 2 { 0 => 1, _ => u }
  assert_eq(uint8.to_string(v), "9")
  let w = match 0 { 0 => 1, _ => u }
  assert_eq(uint8.to_string(w), "1")
}

test "an assert compares a literal against a sized value" {
  let u: UInt8 = 3
  assert_eq(3, u)
}

test "a sized value widens explicitly at the return" {
  assert_eq(widen(3), 3)
}
