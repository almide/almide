// ADR-0021 (#2723): a lambda's failure channel carries the error type its
// `!`s agree on — the context's when it has one (a typed slot, a typed `let`,
// the fn the result propagates into), else the join of the operands, `String`
// as the top. Every spelling of #2601 and its comment types the same way:
// canonical, braces, pipe, a branch, a mid-block `let`, a guard's `err(..)`,
// a value consumer (`match` re-wrap), a typed slot, a typed `let`. The
// String-join case (disagreeing `!`s, a typed error as Debug text) is pinned
// with ADR-0021 step 4 (#2725), once both wasm legs render it.
type StepErr: Eq, Repr = | Neg(Int) | Bad(String)

fn step(acc: Int, x: Int) -> Int!StepErr = {
  guard x >= 0 else err(Neg(x))
  acc + x
}

fn one(x: Int) -> Int!StepErr = step(0, x)

fn fold_canonical(xs: List[Int]) -> Int!StepErr = xs |> list.fold(0, (acc, x) => step(acc, x)!)!

fn fold_braced(xs: List[Int]) -> Int!StepErr = xs |> list.fold(0, (acc, x) => {
  step(acc, x)!
})!

fn fold_piped(xs: List[Int]) -> Int!StepErr = xs |> list.fold(0, (acc, x) => acc |> step(x)!)!

fn fold_branch(xs: List[Int]) -> Int!StepErr = xs |> list.fold(
  0,
  (acc, x) => if x == 100 then acc
  else step(acc, x)!,
)!

fn fold_mid_block(xs: List[Int]) -> Int!StepErr = xs |> list.fold(
  0,
  (acc, x) => {
    let v = step(acc, x)!
    v * 1
  },
)!

fn fold_guarded(xs: List[Int]) -> Int!StepErr = xs |> list.fold(
  0,
  (acc, x) => {
    guard x != 100 else err(Bad("hundred"))
    step(acc, x)!
  },
)!

fn map_err_arm(xs: List[Int]) -> List[Int]!StepErr = {
  let r = xs |> list.map((x) => match x {
    0 => 0,
    _ => one(x)!,
  })
  match r {
    ok(v) => ok(v),
    err(e) => err(e),
  }
}

fn sum_with(xs: List[Int], f: (Int) -> Int!StepErr) -> Int!StepErr = xs |> list.fold(
  0,
  (a, x) => a + f(x)!,
)!

fn typed_slot(xs: List[Int]) -> Int!StepErr = sum_with(xs, (n) => one(n)! * 2)

fn typed_let(xs: List[Int]) -> Int!StepErr = {
  let f: (Int) -> Int!StepErr = (n) => one(n)! + 1
  sum_with(xs, f)
}

test "L3: the channel takes the error type its bangs agree on" {
  assert_eq(fold_canonical([1, 2]), ok(3))
  assert_eq(fold_canonical([1, -2]), err(Neg(-2)))
  assert_eq(fold_braced([1, -2]), err(Neg(-2)))
  assert_eq(fold_piped([1, -2]), err(Neg(-2)))
  assert_eq(fold_branch([1, 100, 2]), ok(3))
  assert_eq(fold_branch([1, -2]), err(Neg(-2)))
  assert_eq(fold_mid_block([4, -1]), err(Neg(-1)))
  assert_eq(fold_guarded([1, 100]), err(Bad("hundred")))
  assert_eq(map_err_arm([1, 0, 2]), ok([1, 0, 2]))
  assert_eq(map_err_arm([1, -3]), err(Neg(-3)))
}

test "L3: a typed slot or a typed let decides the channel" {
  assert_eq(typed_slot([1, 2]), ok(6))
  assert_eq(typed_slot([1, -2]), err(Neg(-2)))
  assert_eq(typed_let([1, 2]), ok(5))
  assert_eq(typed_let([-4]), err(Neg(-4)))
}
