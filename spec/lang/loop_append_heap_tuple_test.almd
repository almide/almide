// Appending a `(record, Int)` tuple whose record holds heap fields, inside a
// `for` over a list of such records: through a `let`-bound tuple, an inline
// tuple, and inside a branch of a recursive walk (the ceangal paint shape).
type Style = { absolute: Bool, overlay: Bool }

type Node = { n: Int, name: String, style: Style, children: List[Node] }

var overlays: List[(Node, Int)] = []

fn subtree_len(v: Node) -> Int = 1 + list.sum(list.map(v.children, (c) => subtree_len(c)))

fn paint(v: Node, idx: Int) -> Int = {
  var next = idx + v.n
  for c in v.children {
    if not c.style.absolute then {
      next = paint(c, next)
    } else ()
  }
  for c in v.children {
    if c.style.overlay then {
      list.push(overlays, (c, next))
      next = next + subtree_len(c)
    } else if c.style.absolute then {
      next = paint(c, next)
    } else ()
  }
  next
}

fn pairs(vs: List[Node]) -> List[(Node, Int)] = {
  var out: List[(Node, Int)] = []
  var k = 0
  for c in vs {
    let t = (c, k)
    list.push(out, t)
    list.push(out, (c, k + 10))
    k = k + 1
  }
  out
}

fn plain() -> Style = { absolute: false, overlay: false }

test "a let-bound and an inline tuple append keep each record" {
  let a: Node = { n: 1, name: "a", style: plain(), children: [] }
  let b: Node = { n: 2, name: "b", style: plain(), children: [] }
  let got = pairs([a, b])
  assert_eq(list.map(got, (p) => "${p.0.name}${p.1}"), ["a0", "a10", "b1", "b11"])
}

test "a recursive walk appends overlays from a branch" {
  let leaf: Node = { n: 1, name: "leaf", style: plain(), children: [] }
  let abs: Node = { n: 10, name: "abs", style: { absolute: true, overlay: false }, children: [] }
  let ov: Node = { n: 100, name: "ov", style: { absolute: false, overlay: true }, children: [leaf] }
  let root: Node = { n: 0, name: "root", style: plain(), children: [leaf, abs, ov, leaf] }
  assert_eq(paint(root, 0), 115)
  assert_eq(list.map(overlays, (p) => "${p.0.name}@${p.1}"), ["ov@113"])
}
