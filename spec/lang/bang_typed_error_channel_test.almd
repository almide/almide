// #2635: `!` passes an error on unchanged, so inside a fn whose error type is
// a user type it only accepts operands that fail with that same type. The
// `String`-failing operands (an effect call of any non-Result return, a
// `Result[_, String]`, an `Option`) are handled in place instead — these are
// the spellings the E022 hint names, and they must run on both targets.
type Failure: Eq, Repr = | Slow | Broken(String)

effect fn flag(b: Bool) -> Bool = b

effect fn tidy() -> Unit = ()

effect fn count(n: Int) -> Int = n

effect fn name(s: String) -> String = s

fn digits(s: String) -> Result[Int, String] = match int.parse(s) {
  ok(v) => ok(v),
  err(_) => err("not a number: " + s),
}

fn as_failure(r: Result[Int, String]) -> Result[Int, Failure] = match r {
  ok(v) => ok(v),
  err(e) => err(Broken(e)),
}

fn same(n: Int) -> Result[Int, Failure] = if n > 0 then ok(n) else err(Slow)

effect fn step(b: Bool, s: String) -> Result[Int, Failure] = {
  let _ = tidy()
  let n = as_failure(digits(s))!
  let m = same(n)!
  let first = list.first([m]) ?? 0
  if flag(b) ?? false then ok(first + (count(1) ?? 0) + string.len(name("ab") ?? ""))
  else err(Slow)
}

test "typed error fn handles String-failing calls in place" {
  assert_eq(step(true, "4"), ok(7))
  assert_eq(step(false, "4"), err(Slow))
  assert_eq(step(true, "x"), err(Broken("not a number: x")))
  assert_eq(step(true, "0"), err(Slow))
}
