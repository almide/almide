// #2635: `!` passes an error on unchanged, so inside a fn whose error type is
// a user type it only accepts operands that fail with that same type. The
// `String`-failing operands (an effect call of any non-Result return, a
// `Result[_, String]`, an `Option`) are handled in place instead — these are
// the spellings the E022 hint names, and they must run on both targets.
type Failure: Eq, Repr = | Slow | Broken(Int)

effect fn flag(b: Bool) -> Bool = b

effect fn tidy() -> Unit = ()

effect fn count(n: Int) -> Int = n

effect fn name(s: String) -> String = s

fn digits(s: String) -> Result[Int, String] = match int.parse(s) {
  ok(v) => ok(v),
  err(_) => err("not a number: " + s),
}

effect fn extra() -> Int = {
  let _ = tidy()
  let first = list.first([2]) ?? 0
  first + (count(1) ?? 0) + string.len(name("ab") ?? "")
}

// A `Result[_, String]` handled by `match`: its error becomes a `Failure` case.
fn code(open: Bool, r: Result[Int, String], more: Int) -> Int = match r {
  ok(n) => if open then n + more else -1,
  err(e) => -2 - string.len(e),
}

fn to_result(c: Int) -> Result[Int, Failure] = if c > 0 then ok(c)
else if c == -1 or c == 0 then err(Slow) else err(Broken(-2 - c))

effect fn step(b: Bool, s: String) -> Result[Int, Failure] = to_result(code(flag(b) ?? false, digits(s), extra() ?? 0))

test "typed error fn handles String-failing calls in place" {
  assert_eq(step(true, "4"), ok(9))
  assert_eq(step(false, "4"), err(Slow))
  assert_eq(step(true, "x"), err(Broken(15)))
  assert_eq(step(true, "-5"), err(Slow))
}
