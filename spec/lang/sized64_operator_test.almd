// The arithmetic operators on Int64 and Float64 (#4055): the checker accepted
// them, and lowering then stopped with an IR verify ICE.
fn add(a: Int64, b: Int64) -> Int64 = a + b

fn sub(a: Int64, b: Int64) -> Int64 = a - b

fn mul(a: Int64, b: Int64) -> Int64 = a * b

fn div(a: Int64, b: Int64) -> Int64 = a / b

fn rem(a: Int64, b: Int64) -> Int64 = a % b

fn neg(a: Int64) -> Int64 = -a

fn fadd(a: Float64, b: Float64) -> Float64 = a + b

fn fsub(a: Float64, b: Float64) -> Float64 = a - b

fn fmul(a: Float64, b: Float64) -> Float64 = a * b

fn fdiv(a: Float64, b: Float64) -> Float64 = a / b

fn fneg(a: Float64) -> Float64 = -a

fn i(n: Int) -> Int64 = int.to_int64(n)

fn f(x: Float) -> Float64 = float.to_float64(x)

test "Int64 arithmetic operators" {
  assert_eq(int64.to_string(add(i(2), i(3))), "5")
  assert_eq(int64.to_string(sub(i(2), i(3))), "-1")
  assert_eq(int64.to_string(mul(i(6), i(7))), "42")
  assert_eq(int64.to_string(div(i(17), i(5))), "3")
  assert_eq(int64.to_string(rem(i(17), i(5))), "2")
  assert_eq(int64.to_string(neg(i(9))), "-9")
}

test "Int64 comparisons" {
  assert(i(2) < i(3))
  assert(i(3) >= i(3))
  assert(i(4) != i(5))
}

test "Float64 arithmetic operators" {
  assert_eq(float64.to_string(fadd(f(1.5), f(2.0))), "3.5")
  assert_eq(float64.to_string(fsub(f(1.5), f(2.0))), "-0.5")
  assert_eq(float64.to_string(fmul(f(1.5), f(2.0))), "3.0")
  assert_eq(float64.to_string(fdiv(f(3.0), f(2.0))), "1.5")
  assert_eq(float64.to_string(fneg(f(2.5))), "-2.5")
}
