fn check(age: Int) -> Result[Int, String] = if age < 0 then err("negative")
else if age > 150 then err("too large") else ok(age)

fn label(age: Int) -> String = match check(age) {
  ok(a) => "ok:" + int.to_string(a),
  err(e) => "bad:" + e,
}

fn main() -> Unit = {
  println(label(30))
  println(label(-5))
  println(label(200))
}
