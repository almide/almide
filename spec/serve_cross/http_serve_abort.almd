// @contract: C-432
// A SERVER fixture for a runtime abort inside an `http.serve` handler
// (almide/almide#4203): no generic runner executes it. The driver
// (tests/http_serve_cross_test.rs in almide/almide) starts it natively and
// on the embedded lane, waits for the "ready" line on stderr, and sends
// POST bodies: a 1-byte body is served (`val=20`); a 5-byte body indexes the
// 3-element list out of bounds (an `Error: index out of bounds` abort); the
// body `P` reaches `panic`. Each abort must fail only its request — the
// fixed C-409 500, one `handler aborted` stderr line, the abort text never
// in the response — and the next request is served. Each leg must answer
// the same.
// Usage: almide run http_serve_abort.almd [--target wasm] -- <port>
import env
import http

effect fn handle(req: HttpRequest) -> HttpResponse = {
  let body = http.req_body(req)
  match body {
    "P" => panic("boom \"quoted\""),
    _ => {
      let xs = [10, 20, 30]
      http.response(200, "val=" + int.to_string(xs[string.len(body)]))
    },
  }
}

effect fn main() -> Unit = {
  let port = env.args() |> list.get(0) ?? "0"
  eprintln("ready")
  http.serve(int.parse(port) ?? 0, (req) => handle(req)!)!
}
