// @contract: C-367
// A SERVER fixture: it never exits, so no generic runner executes it. The
// driver (tests/http_serve_cross_test.rs in almide/almide) starts it with
// `almide run` natively and with `almide run --target wasm`, waits for the
// "ready" line on stderr, replays one request script against each and
// compares each response's status code, header set and de-framed body (the
// reason phrase and the framing fields are the host's) and the stderr
// transcripts as multisets of lines.
// Usage: almide run http_serve_replay.almd [--target wasm] -- <port>
import env
import http
import random

fn deny(path: String) -> Result[Unit, String] = err("denied ${path}")

// Query parameters in key order: map iteration order is not the promise here.
fn render_query(req: HttpRequest) -> String = {
  let q = http.query_params(req)
  map.keys(q) |> list.sort |> list.map((k) => "${k}=${map.get(q, k) ?? ""}") |> list.join("&")
}

effect fn handle(req: HttpRequest) -> HttpResponse = {
  let method = http.req_method(req)
  let path = http.req_path(req)
  let route = string.split(path, "?") |> list.get(0) ?? path
  eprintln("${method} ${path}")
  match route {
    "/hello" => http.response(200, "hello"),
    "/echo" => http.with_headers(
      201,
      "${method} ${http.req_body(req)}",
      [
        "X-Echo": http.req_header(req, "x-token") ?? "none",
        "Content-Type": "text/plain; charset=utf-8"
      ],
    ),
    "/query" => http.json(200, "\"${render_query(req)}\""),
    "/teapot" => http.response(200, "short and stout") |> http.status(418) |> http.set_header(
      "x-kind",
      "teapot",
    ),
    "/redirect" => http.redirect("/hello"),
    // A draw in the handler: the app is instance-closed (ADR-0020 §5.2), so
    // nothing ties two requests' draws together, only the answer's shape.
    "/boot" => {
      let boot = random.int(1, 1000000000)
      http.response(200, "${boot >= 1 and boot <= 1000000000}")
    },
    // Clock reads in the handler (#2703): the values differ per run, the
    // answer does not.
    "/clock" => {
      let started = env.millis()
      http.response(200, "${env.millis() >= started} ${datetime.now() >= started / 1000}")
    },
    "/fail" => {
      deny(route)!
      http.response(200, "unreachable")
    },
    _ => http.response(404, "not found: ${route}"),
  }
}

effect fn main() -> Unit = {
  let port = env.args() |> list.get(0) ?? "0"
  // A clock read in main before serve (#2703). The app below reads no local
  // of main: it is instance-closed (ADR-0020 §5.2, E095).
  let started = env.millis()
  eprintln(if started >= 0 then "ready" else "a clock before the epoch")
  http.serve(int.parse(port) ?? 0, (req) => handle(req)!)!
}
