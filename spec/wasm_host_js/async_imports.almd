// @leg: structural
// @host-flags: --async-import kv_get,kv_count
// Async JS imports through JSPI (#3353): `kv_get` and `kv_count` hooks
// return Promises and the module suspends on them; `log_line` stays a
// synchronous hook. Exports that can reach an async import (`lookup`,
// `total` through a closure, `must_get`, `main`) are async in the glue; the
// rest (`width`, `log_twice`) stay synchronous. The host-side checks live in
// async_imports.host.mjs.
@extern(wasm, "js", "kv_get")
fn kv_get(key: String) -> String

@extern(wasm, "js", "kv_count")
fn kv_count(prefix: String) -> Int

@extern(wasm, "js", "log_line")
fn log_line(msg: String) -> Unit

local fn present(v: String, key: String) -> Result[String, String] = if string.len(v) > 0 then ok(v) else err("missing ${key}")

fn lookup(key: String) -> String = "value=" + kv_get(key)

fn total(keys: List[String]) -> Int = keys |> list.map((k) => kv_count(k)) |> list.fold(
  0,
  (a, b) => a + b,
)

effect fn must_get(key: String) -> String = present(kv_get(key), key)!

fn width(s: String) -> Int = string.len(s)

fn log_twice(s: String) -> Unit = {
  log_line(s)
  log_line(s + "!")
}

fn main() -> Unit = println(lookup("main"))
