// @leg: structural
// ADR-0031 D3, D7: a Region crosses an `@extern(wasm)` import as two
// scalars, its base and the length the runtime holds for it — the host never
// gets a length the caller typed, and no Int spelling of an address exists.
// #3420, by ownership: the Region holds its Bytes, so the block outlives the
// host call. Each shape below once freed the block before the host read it
// (`js_peek` saw the free-list header over the first four bytes,
// "\0\0\0\0o, world"): a tail call whose last argument is the block's last
// use, a temporary built inside the argument, a view held in a `let` across
// another allocation, and a view that comes out of a helper fn.
import ffi

@extern(wasm, "js", "js_peek")
fn js_peek(buf: Region) -> Int

fn send(s: String) -> Int = {
  let b = bytes.from_string(s)
  js_peek(ffi.region(b))
}

fn send_temp(s: String) -> Int = js_peek(ffi.region(bytes.from_string(s)))

fn send_temp_bound(s: String) -> Int = {
  let n = js_peek(ffi.region(bytes.from_string(s)))
  n
}

fn send_held(s: String) -> Int = {
  let r = ffi.region(bytes.from_string(s))
  let other = bytes.from_string("a block allocated in between")
  js_peek(r) + bytes.len(other) - 28
}

local fn view_of(b: Bytes) -> Region = if bytes.len(b) > 1000000 then ffi.region(bytes.new()) else ffi.region(b)

fn send_helper(s: String) -> Int = {
  let b = bytes.from_string(s)
  js_peek(view_of(b))
}

fn send_helper_temp(s: String) -> Int = js_peek(view_of(bytes.from_string(s)))

fn main() -> Unit = {
  let total = send("hello, world") + send("añb") + send_temp("temporary") + send_temp_bound("bound temporary") + send_held("held address") + send_helper("helper address") + send_helper_temp("helper temporary")
  println("bytes seen: ${total}")
}
