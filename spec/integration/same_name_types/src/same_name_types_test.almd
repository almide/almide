// #3401 on the test lanes: same-named types in two modules of one package.
import self.a
import self.b

test "a module's bare type name is its own declaration" {
  assert_eq(a.count(["x", "y", "z"]), 3)
  assert_eq(a.first_len(["hello"]), 5)
  assert_eq(b.width(b.Ctx { label: "ab" }), 2)
  assert_eq(a.labelled(b.Ctx { label: "abc" }), 3)
}

test "same-named variant cases build each module's own variant" {
  assert_eq(a.size_of(0), 0)
  assert_eq(a.size_of(4), 4)
  assert_eq(b.size_of(""), 100)
  assert_eq(b.size_of("xy"), 2)
}
