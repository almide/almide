// #2645: a same-named `Step` (different shape from `tletqa.Step`) held by
// annotated top-level `let`s, read inside this module and from the importer.
type Step = { name: String }

let STEPS: List[Step] = [
  Step { name: "x" },
  Step { name: "yy" }
]

let MAYBE: Step? = some(Step { name: "m" })

fn names() -> String = STEPS |> list.map((s) => s.name) |> list.join(",")

fn maybe_name() -> String = match MAYBE {
  some(s) => s.name,
  none => "none",
}
