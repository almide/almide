// @contract: C-009
// A module type's repr prints the DECLARED name on every leg (#1836): the
// module a value came from is no more part of its repr than the entry file is
// part of a root type's. Before the fix native printed the post-flatten
// `almide_rt_reprlib_Cfg { … }` and wasm / the interp the qualified
// `reprlib.Cfg { … }` — three spellings, none the source's. `almide test spec/`
// (native) and `almide test spec/ --target wasm` both run these blocks;
// tests/module_type_repr_test.rs pins the interp and incumbent legs on the
// issue's program, and cross_module_repr_derive_test.almd carries the shapes
// the wasm TEST lane's v1 renderer still walls on.
import reprlib

test "cross-module record repr prints the declared name (#1836)" {
  assert_eq("${reprlib.mk()}", "Cfg { a: 1, b: 2 }")
}

test "cross-module variant repr: tuple payload, record case, nullary" {
  assert_eq("${reprlib.circle(3)}", "Circle(3)")
  assert_eq("${reprlib.rect(3, 4)}", "Rect { w: 3, h: 4 }")
  assert_eq("${reprlib.dot()}", "Dot")
}

test "cross-module nested record-in-record repr" {
  assert_eq("${reprlib.outer()}", "Outer { name: \"x\", cfg: Cfg { a: 1, b: 2 } }")
}
