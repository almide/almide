// recshape — recursive variant types consumed cross-module (#844 regression).
// The record-payload case (`Group { patterns: List[Pat] }`) is the exact
// shape that miscompiled: IrLinkFlatten mangled `recshape.Pat` to
// `almide_rt_recshape_Pat` without remapping `recursive_enums`, so the enum
// decl dropped its Box while construction sites kept boxing.
type Pat = | Leaf(String) | Group { name: String, patterns: List[Pat] }

type Tree = | Tip(Int) | Node(Tree, Tree)

fn emit(p: Pat) -> String = match p {
  Leaf(s) => s,
  Group { name, patterns } => {
    let inner = patterns |> list.map((q) => emit(q)) |> list.join(",")
    "${name}[${inner}]"
  },
}

fn sum(t: Tree) -> Int = match t {
  Tip(n) => n,
  Node(l, r) => sum(l) + sum(r),
}
