// #3384: variant constructors named in a selective import are the
// constructors — the import passed check and the lowering then called a
// function `selvar.A` that does not exist (IR verify ICE).
import selvar.{T, V, A, size}

fn mk() -> T = A(V(1), V(2))

test "selectively imported constructors construct" {
  assert_eq(size(mk()), 2)
  assert_eq(size(A(mk(), V(0))), 3)
}

test "selectively imported constructor as a function value" {
  assert_eq(list.map([1, 2], V) |> list.map((t) => size(t)), [1, 1])
}
