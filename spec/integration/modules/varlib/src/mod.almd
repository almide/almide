type Policy = | Never | OnFailure | Always

type Wrapper = | Wrap(Int) | Empty

type Shape = | Circle { radius: Int } | Dot

type Pigment: Codec = { r: Int, g: Int, b: Int }

fn parse_tag(s: String) -> Option[String] = if string.starts_with(s, "tag:") then some(string.slice(s, 4, string.len(s)))
else none

// Test: function reference used within the same module (intra-module)
fn tag_count(items: List[String]) -> Int = items |> list.filter_map(parse_tag) |> list.len

// #631: a PRODUCER fn inside the owning module constructs the variant via the
// BARE constructor and returns it. The ctor-call result type must be pinned to
// the owner-qualified `varlib.Wrapper` / `varlib.Shape`, or the #433 name-pin
// guard aborts codegen on BOTH targets even though `check` passed.
fn make_wrap(n: Int) -> Wrapper = Wrap(n)

fn make_circle(r: Int) -> Shape = Circle { radius: r }

// #1088: a defaulted parameter must stay optional across a module boundary.
// The default lives in the callee's module; the caller's lowering never sees
// that program, so the value has to travel with the exported signature.
fn greet(name: String, greeting: String = "Hello") -> String = "${greeting}, ${name}!"

// #1087: a convention method must be reachable from ANOTHER module. Both the
// explicit `fn Tone.repr` and `Pigment`'s DERIVED Codec are registered under
// different key shapes, and every consumer starts from the qualified
// `varlib.Tone` / `varlib.Pigment` — so both spellings have to resolve.
type Tone = | Warm | Cool

fn Tone.repr(t: Tone) -> String = match t {
  Warm => "warm",
  Cool => "cool",
}
