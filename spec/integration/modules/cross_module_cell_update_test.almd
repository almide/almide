// cell.update's spread-with-closure-override (`{ ...c, _val: f(c._val) }`)
// across the generic instantiations ceangal exercises (#881): the closure
// call is a Computed-callee field the spread construct moves into its slot.

import cellstate as cl

type Todo = { id: Int, title: String, done: Bool }

test "update over a List[Record] cell" {
  let todos = cl.cell([{ id: 1, title: "alpha", done: false }])
  let todos2 = cl.update(todos, (xs) => xs + [{ id: 2, title: "beta", done: true }])
  let names = cl.get(todos2) |> list.map((t) => t.title) |> list.join(",")
  assert_eq(names, "alpha,beta")
}

test "update over scalar and String cells" {
  let count = cl.cell(10)
  assert_eq(cl.get(cl.update(count, (n) => n * 3)), 30);
  let s = cl.cell("hi")
  assert_eq(cl.get(cl.update(s, (x) => x + "!")), "hi!")
}

test "set spreads and marks dirty" {
  let c = cl.cell(1)
  assert_eq(cl.get(cl.set(c, 5)), 5);
  assert_eq(cl.is_dirty(), true)
}
