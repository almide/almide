// #1549 (mut leg): the MUT-receiver convention method (`fn Box.bump(mut
// self: Box, by)`) must mirror its signature under BOTH emit keys — the
// dotted `convmut.Box.bump` and the bare `Box.bump` — or the caller's
// borrow classification misses it and the call site passes by value
// (check green, rustc E0308). The wasm leg currently walls on the method
// body's in-place param mutation (#1557 leg 1); the native leg is the
// regression pin.
import convmut

test "mut-receiver convention method mutates across the boundary (#1549)" {
  var b = convmut.Box { n: 1 }
  b.bump(4)
  assert_eq(b.n, 5)
  b.bump(2)
  assert_eq(b.n, 7)
}
