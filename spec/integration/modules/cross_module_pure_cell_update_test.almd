// The spread-with-closure-override brick (`{ ...c, _val: f(c._val) }`, #881)
// on the VERIFIED wasm test leg — cellstate's mutable-global twin covers the
// dirty-tracking half on the native/rust legs.

import purecell as cl

type Todo = { id: Int, title: String, done: Bool }

test "update over a List[Record] cell" {
  let todos = cl.cell([{ id: 1, title: "alpha", done: false }])
  let todos2 = cl.update(todos, (xs) => xs + [{ id: 2, title: "beta", done: true }])
  let names = cl.get(todos2) |> list.map((t) => t.title) |> list.join(",")
  assert_eq(names, "alpha,beta")
}

test "update over scalar and String cells" {
  assert_eq(cl.get(cl.update(cl.cell(10), (n) => n * 3)), 30);
  assert_eq(cl.get(cl.update(cl.cell("hi"), (x) => x + "!")), "hi!")
}
