// #1426 (edit-locality hunt V3): a QUALIFIED constructor reference
// `mod.Ctor(...)` resolves inside `mod` alone. Before the owner-filtered
// lookup, `ctorqb.Mark("x")` consulted the first-REGISTERED candidate for the
// bare name `Mark` — ctorqa's `Mark(Int)` — and rejected the String payload of
// a perfectly good program. The same-name-different-payload pair below pins
// both registration polarities: whichever module registers first, the other's
// qualified access must still see its own case.
import ctorqa
import ctorqb

test "qualified ctor resolves inside its own module" {
  assert_eq(ctorqa.describe(ctorqa.Mark(7)), "a-mark:7")
  assert_eq(ctorqa.describe(ctorqa.Stop), "a-stop")
  assert_eq(ctorqb.describe(ctorqb.Mark("x")), "b-mark:x")
  assert_eq(ctorqb.describe(ctorqb.Go), "b-go")
}
