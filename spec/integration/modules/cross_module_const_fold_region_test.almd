// Const-fold top-let substitution must scope its env PER REGION: the main
// program and each module number VarIds privately from 0, and a RECORD
// toplet never enters the env (only scalar literals fold), so one shared env
// let constfleet's folded literals (linked first) stand in for palette2's
// same-numbered `_white`/`_black` refs inside `_default` — ceangal's scroll
// `BOUNCING = 2` / `FRICTION = 0.035` replacing view's `_transparent` /
// `_white` Colors: a silent wrong value dependent on module link order.
import constfleet
import palette2

test "module record toplet keeps its own module's referents" {
  assert_eq(palette2.fg_r(), 1.0)
  assert_eq(palette2.bg_r(), 0.5)
}

test "first module's consts are untouched" {
  assert_eq(constfleet.speed(), 2)
}
