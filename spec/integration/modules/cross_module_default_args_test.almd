// #1088: default arguments were dropped from a module's exported signature, so
// `varlib.greet("Alice")` failed with E004 while the byte-identical single-file
// call in spec/lang/default_args_test.almd passed. The checker consulted the
// stdlib arity table for every dotted name, and lowering had no defaults to
// fill from because its map is per-file and keyed without the module prefix.
import varlib

test "cross-module call omits a defaulted argument (#1088)" {
  assert_eq(varlib.greet("Alice"), "Hello, Alice!")
}

test "cross-module call overrides the default positionally (#1088)" {
  assert_eq(varlib.greet("Bob", "Hi"), "Hi, Bob!")
}

test "cross-module call overrides the default by name (#1088)" {
  assert_eq(varlib.greet("Carol", greeting: "Yo"), "Yo, Carol!")
}
