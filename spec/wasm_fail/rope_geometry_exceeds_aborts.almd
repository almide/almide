// @expect-fail: Error: head geometry exceeds row width
// @contract: C-278
// #1419: a head geometry that does not fit the row — `n_heads * head_dim >
// cols` — is out of domain and ABORTS with this line on both legs, exactly as
// the head-count domain (C-198) aborts on `n < 1`. Before the shared
// `head_geometry` guard, each leg crashed its own way: native with a raw slice
// panic (`index out of bounds: the len is 16 but the index is 16`, exit 101),
// wasm with an OOB memory trap (exit 134) — found by the same-seed
// re-verification campaign for #1416 (seed 508666777783, index 2120, a
// mutation of matrix_head_count_domain.almd).
fn main() -> Unit = {
  let x = matrix.ones(4, 16)
  let rp = matrix.rope_rotate(x, 65535, 8, 10000.0)
  let (rr, rc) = matrix.shape(rp)
  println("UNREACHABLE ${int.to_string(rr)}x${int.to_string(rc)}")
}
