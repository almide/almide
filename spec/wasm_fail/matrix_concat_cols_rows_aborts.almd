// @expect-fail: Error: matrix shape mismatch
// @contract: C-358
// #2482: `matrix.concat_cols` glues matrices side by side, so every
// non-empty member must have the same row count. A member with FEWER rows
// left the result ragged — native's flat store asserted (a raw panic, exit
// 101) where both wasm legs built the ragged value (`[[1, 3], [2]]`, exit
// 0); a member with MORE rows silently lost its tail on every leg. An EMPTY
// member contributes no columns and no shape and is still accepted (pinned
// in spec/wasm_cross/matrix_shape_precondition_family.almd).
fn main() -> Unit = {
  let a = matrix.from_lists([
    [1.0],
    [2.0]
  ])
  let b = matrix.from_lists([
    [3.0]
  ])
  let c = matrix.concat_cols([a, b])
  println("UNREACHABLE ${matrix.rows(c)}x${matrix.cols(c)}")
}
