// @expect-fail: Error: index out of bounds
// @contract: C-067
// The fused Qwen3 layers read four norm offsets and seven weight offsets out
// of their two `List[Int]` arguments. A shorter list reached a raw Rust slice
// panic natively (`index out of bounds: the len is 1 but the index is 1`,
// exit 101, the form ALS-T6 forbids) while the self-hosted wasm body indexed
// it with `xs[i]` and took C-067's unified abort (#1827) — two lines for one
// program. Both legs now take the `xs[i]` abort.
fn main() -> Unit = {
  let h = matrix.zeros(1, 8)
  let w = bytes.new(64)
  let (o, _k, _v) = matrix.qwen3_block_q1_0_kv(
    h,
    h,
    h,
    w,
    [0],
    [0],
    0,
    1,
    1,
    8,
    8,
    10000.0,
    0.00001,
  )
  println("UNREACHABLE ${matrix.rows(o)}")
}
