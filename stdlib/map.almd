// map — bundled-Almide stdlib module (Stdlib Declarative Unification Stage 3d).
//
// Migrated mechanically from `stdlib/defs/map.toml` (24 fns). The
// runtime impls stay in `runtime/rs/src/map.rs`; `@inline_rust`
// templates replace the TOML glue. Closure args ride the generic
// lambda-prep added in Stage 3a. Map has no IterChain fast-path —
// `map.map` etc. go through the declarative bundled dispatch directly.
//
// Note: the template for `map.map` dispatches to
// `almide_rt_map_map_values` (not `_map`) because `map_values` is the
// Rust runtime fn name — it transforms values while preserving keys.
// ── basic accessors ──
/// An empty Map[K, V].
@intrinsic("almide_rt_map_new")
fn new[K, V]() -> Map[K, V] = _

/// Value for key, or none when absent.
@intrinsic("almide_rt_map_get")
@borrow_ref(key)
fn get[K, V](m: Map[K, V], key: K) -> V? = _

/// Value for key, or default when absent.
@intrinsic("almide_rt_map_get_or")
@borrow_ref(key)
fn get_or[K, V](m: Map[K, V], key: K, default: V) -> V = _

/// Copy with key -> value; existing keys stay put.
@intrinsic("almide_rt_map_set")
@consume(m)
fn set[K, V](m: Map[K, V], key: K, value: V) -> Map[K, V] = _

/// true when key is present.
@intrinsic("almide_rt_map_contains")
@borrow_ref(key)
fn contains[K, V](m: Map[K, V], key: K) -> Bool = _

/// Copy without key; unchanged if absent.
@intrinsic("almide_rt_map_remove")
fn remove[K, V](m: Map[K, V], key: K) -> Map[K, V] = _

/// Every key, in insertion order.
@intrinsic("almide_rt_map_keys")
fn keys[K, V](m: Map[K, V]) -> List[K] = _

/// Every value, in key insertion order.
@intrinsic("almide_rt_map_values")
fn values[K, V](m: Map[K, V]) -> List[V] = _

/// Entry count; 0 for an empty map.
@intrinsic("almide_rt_map_len")
fn len[K, V](m: Map[K, V]) -> Int = _

/// (key, value) pairs in insertion order.
@intrinsic("almide_rt_map_entries")
fn entries[K, V](m: Map[K, V]) -> List[(K, V)] = _

/// a plus b's entries; b wins on shared keys.
@intrinsic("almide_rt_map_merge")
fn merge[K, V](a: Map[K, V], b: Map[K, V]) -> Map[K, V] = _

/// true iff m has no entries.
@intrinsic("almide_rt_map_is_empty")
fn is_empty[K, V](m: Map[K, V]) -> Bool = _

// ── construction ──
/// Map of pairs; a repeated key takes the last value.
@intrinsic("almide_rt_map_from_entries")
@consume(pairs)
fn from_list[K, V](pairs: List[(K, V)]) -> Map[K, V] = _

// ── closure-bearing (direct runtime dispatch — map has no IterChain) ──
/// Same keys and order, values replaced by f(v).
@intrinsic("almide_rt_map_map_values")
fn map[K, V, B](m: Map[K, V], f: (V) -> B) -> Map[K, B] = _

/// Entries where f(k, v) holds, order kept.
@intrinsic("almide_rt_map_filter")
fn filter[K, V](m: Map[K, V], f: (K, V) -> Bool) -> Map[K, V] = _

/// Folds f(acc, k, v) in insertion order.
@intrinsic("almide_rt_map_fold")
fn fold[K, V, A](m: Map[K, V], init: A, f: (A, K, V) -> A) -> A = _

/// true if some f(k, v) holds; false when empty.
@intrinsic("almide_rt_map_any")
fn any[K, V](m: Map[K, V], f: (K, V) -> Bool) -> Bool = _

/// true if every f(k, v) holds; true when empty.
@intrinsic("almide_rt_map_all")
fn all[K, V](m: Map[K, V], f: (K, V) -> Bool) -> Bool = _

/// Number of entries where f(k, v) holds.
@intrinsic("almide_rt_map_count")
fn count[K, V](m: Map[K, V], f: (K, V) -> Bool) -> Int = _

/// First (k, v) where f holds, or none.
@intrinsic("almide_rt_map_find")
fn find[K, V](m: Map[K, V], f: (K, V) -> Bool) -> (K, V)? = _

/// Copy with key's value f(v); no-op if absent.
@intrinsic("almide_rt_map_update")
fn update[K, V](m: Map[K, V], key: K, f: (V) -> V) -> Map[K, V] = _

// Single-lookup insert-or-update — the aggregation hot-loop form (present →
// f(old), absent → init). `get` + `set` spells the same thing with two
// lookups and a cloned-out V; upsert does one walk in place.
/// key -> f(old) if present, else init appended.
@intrinsic("almide_rt_map_upsert")
@consume(m)
fn upsert[K, V](m: Map[K, V], key: K, init: V, f: (V) -> V) -> Map[K, V] = _

// ── mutable (in-place) ──
/// In-place key -> value; existing keys stay put.
@intrinsic("almide_rt_map_insert")
fn insert[K, V](mut m: Map[K, V], key: K, value: V) -> Unit = _

/// Removes key in place; no-op when absent.
@intrinsic("almide_rt_map_delete")
fn delete[K, V](mut m: Map[K, V], key: K) -> Unit = _

/// Removes every entry of m in place.
@intrinsic("almide_rt_map_clear")
fn clear[K, V](mut m: Map[K, V]) -> Unit = _

// ── the fallible carriers (ADR-0006, #3163) ──
//
// INTERNAL: the checker rewrites `map.fold(m, z, (a, k, v) => f(a, k, v)!)` to
// `map.__fallible_fold(m, z, <stripped callback>)` — source may not name these
// (E043). Each walks the entries in insertion order and stops at the FIRST
// err: no entry after it reaches the callback. The matrix is
// `almide_types::fallible_hofs`.
fn __fallible_map[K, V, B, E](m: Map[K, V], f: (V) -> Result[B, E]) -> Result[Map[K, B], E] = {
  var out: List[(K, B)] = []
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(p.1) {
      ok(b) => list.push(out, (p.0, b)),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(map.from_list(out)),
  }
}

fn __fallible_filter[K, V, E](m: Map[K, V], f: (K, V) -> Result[Bool, E]) -> Result[Map[K, V], E] = {
  var out: List[(K, V)] = []
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(p.0, p.1) {
      ok(keep) => if keep then list.push(out, p) else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(map.from_list(out)),
  }
}

fn __fallible_fold[K, V, A, E](m: Map[K, V], init: A, f: (A, K, V) -> Result[A, E]) -> Result[A, E] = {
  var acc = init
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(acc, p.0, p.1) {
      ok(a) => {
        acc = a
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(acc),
  }
}

fn __fallible_any[K, V, E](m: Map[K, V], f: (K, V) -> Result[Bool, E]) -> Result[Bool, E] = {
  var hit = false
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(p.0, p.1) {
      ok(b) => if b then {
        hit = true
        stop = true
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(hit),
  }
}

fn __fallible_all[K, V, E](m: Map[K, V], f: (K, V) -> Result[Bool, E]) -> Result[Bool, E] = {
  var held = true
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(p.0, p.1) {
      ok(b) => if b then ()
      else {
        held = false
        stop = true
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(held),
  }
}

fn __fallible_count[K, V, E](m: Map[K, V], f: (K, V) -> Result[Bool, E]) -> Result[Int, E] = {
  var n = 0
  var failed: E? = none
  var stop = false
  for p in map.entries(m) {
    if stop then ()
    else match f(p.0, p.1) {
      ok(b) => if b then {
        n = n + 1
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(n),
  }
}

// The hit is kept as an INDEX into the entries and read back, as
// `list.__fallible_find` does.
fn __fallible_find[K, V, E](m: Map[K, V], f: (K, V) -> Result[Bool, E]) -> Result[(K, V)?, E] = {
  let es = map.entries(m)
  var hit_at = list.len(es)
  var i = 0
  var failed: E? = none
  var stop = false
  for p in es {
    if stop then ()
    else match f(p.0, p.1) {
      ok(hit) => if hit then {
        hit_at = i
        stop = true
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
    i = i + 1
  }
  match failed {
    some(e) => err(e),
    none => match list.get(es, hit_at) {
      some(v) => ok(some(v)),
      none => ok(none),
    },
  }
}

// An absent key leaves the map unchanged without calling `f`.
fn __fallible_update[K, V, E](m: Map[K, V], key: K, f: (V) -> Result[V, E]) -> Result[Map[K, V], E] = match map.get(
  m,
  key,
) {
  none => ok(m),
  some(v) => match f(v) {
    ok(nv) => ok(map.set(m, key, nv)),
    err(e) => err(e),
  },
}

// An absent key takes `init` without calling `f`.
fn __fallible_upsert[K, V, E](m: Map[K, V], key: K, init: V, f: (V) -> Result[V, E]) -> Result[Map[K, V], E] = match map.get(
  m,
  key,
) {
  none => ok(map.set(m, key, init)),
  some(v) => match f(v) {
    ok(nv) => ok(map.set(m, key, nv)),
    err(e) => err(e),
  },
}
