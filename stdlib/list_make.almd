// list_make — SELF-HOSTED `list.range` / `list.repeat` for v1 over the prim floor:
// construct a List[Int] via prim.alloc_list + store64. range(start,end) = the half-open
// integer run; repeat(x,n) = n copies of x. Both store i64 VALUES (no new heap elements
// created), so they are fully sound and loop-bounded — even a heap `x` is only aliased
// (like list.reverse), never freshly allocated, so nothing leaks. Result owned.
fn __range_fill(lh: Int, start: Int, count: Int, i: Int) -> Int = if i >= count then 0
else {
  prim.store64(lh + 12 + i * 8, start + i)
  __range_fill(lh, start, count, i + 1)
}

// The element count of [start, end) computed WITHOUT the subtraction that overflows.
// `end - start` for a span like (i64::MIN, 3) wraps NEGATIVE, and the allocation was
// then sized from the wrapped value: native died on a raw panic (exit 101, the form
// ALS-T6 forbids) where wasm aborted with `Error: out of memory` (exit 1).
//
// Rejecting the endpoints outright would be wrong — `range(1000000000, 1000000001)` is
// one element at a large offset and must still work — so the cases are split by sign
// instead. When both endpoints share a sign the difference is bounded by i64::MAX and
// cannot overflow; only a span that STRADDLES zero can, and there either half exceeding
// the ceiling already settles it (`count = end + |start| > end`), leaving a subtraction
// whose operands are both within one ceiling of zero.
//
// `0 - 1` is the too-wide sentinel: a real count is never negative.
fn __range_count(start: Int, end: Int) -> Int = if end <= start then 0
else if start >= 0 then end - start
else if end < 0 then end - start
else if end > 268435456 then 0 - 1
else if start < 0 - 268435456 then 0 - 1 else end - start

fn list_range(start: Int, end: Int) -> List[Int] = {
  let count = __range_count(start, end)
  // Only the WRAP sentinel aborts here (count < 0 marks a span too wide to compute
  // — see __range_count). No threshold (ratified A, 2026-08-17): 0.57.0's floor
  // already turned every unsatisfiable real count into the defined out-of-memory
  // abort on this leg, and a 2^28 guard briefly shipped here cut range(0, 3e8),
  // which 0.57.0 satisfied. The abort line matches what the floor itself prints.
  if count < 0 then prim.die(prim.handle("Error: out of memory\n")) else ()
  let buf = prim.alloc_list(count)
  let _x = __range_fill(prim.handle(buf), start, count, 0)
  buf
}

fn __repeat_fill(lh: Int, x: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store64(lh + 12 + i * 8, x)
  __repeat_fill(lh, x, n, i + 1)
}

fn list_repeat(x: Int, n: Int) -> List[Int] = {
  // A result over the shared 2^31-BYTE ceiling aborts in the T6 form on both
  // targets, matching `string.repeat` (C-161). Without it a count native can
  // satisfy but wasm cannot failed in two different forms: native allocated and
  // printed a length, wasm trapped out-of-bounds against its 4 GiB address
  // space. Keep in sync with ALMIDE_LIST_REPEAT_MAX_ELEMS in runtime/rs/src/list.rs.
  if n > 268435456 then prim.die(prim.handle("Error: repeat result too large\n")) else ()
  let count = if n > 0 then n else 0
  let buf = prim.alloc_list(count)
  let _x = __repeat_fill(prim.handle(buf), x, count, 0)
  buf
}

// list.with_capacity(cap) -> a fresh EMPTY list (v0's Vec::with_capacity has len 0). The reserved
// capacity is not observable in v1 (no self-host `push`), so the byte-matching result is the empty
// list — list.len = 0.
fn list_with_capacity(cap: Int) -> List[Int] = prim.alloc_list(0)

// list.repeat over a HEAP element (`list.repeat(h, n_rep)`, h: Matrix — the nn repeat_kv
// GQA duplication): each slot CO-OWNS the element (rc_inc per copy — the co-own producer
// pattern), so the result's recursive drop releases exactly the references it holds.
// The scalar `list_repeat` above ALIASES x raw (sound only for i64 values); routing
// (`list_heap_call_name`) sends every heap-element repeat here.
fn __repeat_fill_rc(lh: Int, hx: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.rc_inc(hx)
  prim.store64(lh + 12 + i * 8, hx)
  __repeat_fill_rc(lh, hx, n, i + 1)
}

fn list_repeat_rc(x: List[Int], n: Int) -> List[List[Int]] = {
  if n > 268435456 then prim.die(prim.handle("Error: repeat result too large\n")) else ()
  let count = if n > 0 then n else 0
  let buf: List[List[Int]] = prim.alloc_list_str(count)
  let _x = __repeat_fill_rc(prim.handle(buf), prim.handle(x), count, 0)
  buf
}
