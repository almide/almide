// bytes_typed — SELF-HOSTED typed Endian wrappers (`bytes.read_uint16/uint32/int32/
// float32` + the `write_*` / `set_*` twins), byte-matching stdlib/bytes.almd's v0
// wrappers over the width primitives. The `Endian` ARGUMENT is stdlib/bytes.almd's
// DECLARED variant (`type Endian = | LittleEndian | BigEndian`), the one value every
// leg agrees on: the frontend hands that declaration to any program that spells the
// type (#1839, `ir_link`'s type-owner pull), so a `LittleEndian` at a call site, a
// `let e: Endian` bind and a `fn (e: Endian)` param all lower as the SAME variant
// this module matches on. (Before #1839 the argument was a private 1-byte block and
// the ctor NAMES were registered to builders of it — sound only while the decl never
// reached the program; with `import bytes` the decl arrived, the call site passed
// the variant, and the structural leg walled on the representation split.) Reads
// and sets cross-call the PROVEN registered primitives (type-identical sigs). The
// functional append twins cannot be cross-called (the stdlib sig types them as v0's
// in-place `-> Unit`), so the write path re-implements the grow-append locally (the
// __bam shape). v0's write forms are IN-PLACE appends; v1 rewrites the statement
// call to a functional rebind (mod_p3's bytes.push arm), and the write twins RETURN
// the fresh grown Bytes.
fn __endian_is_le(e: Endian) -> Bool = match e {
  LittleEndian => true,
  BigEndian => false,
}

fn bytes_read_uint16(b: Bytes, offset: Int, e: Endian) -> Int = if __endian_is_le(e) then bytes.read_u16_le(b, offset) else bytes.read_u16_be(b, offset)

fn bytes_read_uint32(b: Bytes, offset: Int, e: Endian) -> Int = if __endian_is_le(e) then bytes.read_u32_le(b, offset) else bytes.read_u32_be(b, offset)

fn bytes_read_int32(b: Bytes, offset: Int, e: Endian) -> Int = if __endian_is_le(e) then bytes.read_i32_le(b, offset) else bytes.read_i32_be(b, offset)

// A v1 `Float32` VALUE holds the f32 BIT PATTERN in its i64 slot (lib.rs's
// identity-cast contract), so the Float-returning width reads narrow via
// float.to_float32 and the Float32 params widen via float.from_float32.
fn bytes_read_float32(b: Bytes, offset: Int, e: Endian) -> Float32 = {
  let f = if __endian_is_le(e) then bytes.read_f32_le(b, offset) else bytes.read_f32_be(b, offset)
  float.to_float32(f)
}

// fresh Bytes = b ++ k bytes of `bits` (le selects the byte order) — the
// bytes_append_multi __bam shape, local because the registered appends type as
// v0's in-place `-> Unit` and cannot be cross-called functionally.
fn __bt_copy(dst: Int, src: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store8(dst + i, prim.load8(src + i))
  __bt_copy(dst, src, n, i + 1)
}

fn __bt_le(p: Int, bits: Int, k: Int, i: Int) -> Int = if i >= k then 0
else {
  prim.store8(p + i, prim.band(prim.bshr_u(bits, i * 8), 255))
  __bt_le(p, bits, k, i + 1)
}

fn __bt_be(p: Int, bits: Int, k: Int, i: Int) -> Int = if i >= k then 0
else {
  prim.store8(p + i, prim.band(prim.bshr_u(bits, (k - 1 - i) * 8), 255))
  __bt_be(p, bits, k, i + 1)
}

fn __bt_append(b: Bytes, bits: Int, k: Int, le: Bool) -> Bytes = {
  let n = prim.load32(prim.handle(b) + 4)
  let out = prim.alloc_bytes(n + k)
  let dst = prim.handle(out) + 12
  let _c = __bt_copy(dst, prim.handle(b) + 12, n, 0)
  let _w = if le then __bt_le(dst + n, bits, k, 0)
  else __bt_be(dst + n, bits, k, 0)
  out
}

fn bytes_write_uint16(b: Bytes, v: Int, e: Endian) -> Bytes = __bt_append(b, v, 2, __endian_is_le(e))

fn bytes_write_uint32(b: Bytes, v: Int, e: Endian) -> Bytes = __bt_append(b, v, 4, __endian_is_le(e))

fn bytes_write_int32(b: Bytes, v: Int, e: Endian) -> Bytes = __bt_append(b, v, 4, __endian_is_le(e))

fn bytes_write_float32(b: Bytes, v: Float32, e: Endian) -> Bytes = {
  let f = float.from_float32(v)
  __bt_append(b, prim.f32bits(prim.f2f32(f)), 4, __endian_is_le(e))
}

fn bytes_set_uint16(b: Bytes, offset: Int, v: Int, e: Endian) -> Unit = if __endian_is_le(e) then bytes.set_u16_le(b, offset, v)
else bytes.set_u16_be(b, offset, v)

fn bytes_set_uint32(b: Bytes, offset: Int, v: Int, e: Endian) -> Unit = if __endian_is_le(e) then bytes.set_u32_le(b, offset, v)
else bytes.set_u32_be(b, offset, v)

fn bytes_set_int32(b: Bytes, offset: Int, v: Int, e: Endian) -> Unit = if __endian_is_le(e) then bytes.set_i32_le(b, offset, v)
else bytes.set_i32_be(b, offset, v)

fn bytes_set_float32(b: Bytes, offset: Int, v: Float32, e: Endian) -> Unit = {
  let f = float.from_float32(v)
  if __endian_is_le(e) then bytes.set_f32_le(b, offset, f)
  else bytes.set_f32_be(b, offset, f)
}
