// json_parse — SELF-HOSTED `json.parse(text)`: a pure-Almide two-pass JSON
// parser that builds the whole document as ONE allocation family
// (ADR-0033 D1, D2).
// NORMATIVE SPEC: ALS-T3 (docs/specs/als/text-and-numbers.md §T3) — conformance is judged against that section's
// rules and its pinned fixture, NOT against any other implementation (F1: no oracle circularity).
// The grammar and the err texts are clause-for-clause those of the native
// oracle (`runtime/rs/src/json.rs::almide_rt_json_parse`), so the v1 trust
// spine lowers it through the PROVEN pipeline with NO hand-written wasm
// runtime to drift.
//
// Positions are BYTE offsets internally (prim.load8 — O(1)). The oracle's
// positions are CHAR indices, so an error message converts its byte offset
// with one linear count at ERROR time only. The grammar is RFC 8259 plus
// I-JSON (RFC 7493), STRICT (C-087, C-400, C-401, #4111 / #4112), with one err
// text per case, the oracle's:
//   - the whole text is one value between JSON whitespace (space, tab, LF,
//     CR); anything left is `json: trailing data`.
//   - a string is checked in full: an unterminated string, a raw control
//     character, an unknown escape, a `\u` without four hex digits, a
//     surrogate that is not a high+low pair and a noncharacter are each an
//     err; nothing is ever dropped. A valid high+low pair joins into one
//     astral codepoint (#651).
//   - an object key must be a string, a repeated key is an err at the
//     repeat's opening quote, a `,` before `]`/`}` is a trailing comma, and a
//     missing `:` or separator is named.
//   - a number token (the run of `0-9 + - . e E`) must match
//     `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?` whole; a fraction
//     or exponent makes a Float, else Int; an out-of-range Int passes
//     int.parse's error message through, and a Float float.parse's.
//   - nesting is bounded (R-L0-47, R-json-04, #4020): an array or object
//     opened inside 1000 others is `json: nesting deeper than 1000`, checked
//     where the oracle checks it. `depth` counts the containers around the
//     value being parsed.
// The bound is crates/almide-base/src/json_limits.rs's JSON_MAX_DEPTH; this
// is its self-hosted reading (tests/json_depth_limit_test.rs pins the two),
// shared with value.set_path's bound (#4209, stdlib/json_path.almd).
//
// TWO PASSES (ADR-0033 D2, owner Q3):
//   - PASS 1 (`__jp_v1` …) validates the whole grammar — every refusal text,
//     its char position, the first refusal in document order — and COUNTS:
//     the exact byte size of the family (every Value box, String, list and
//     pair block, carved sizes) and the handles pass 2 will stack. It
//     allocates nothing but the one scratch block (its key-span stack and,
//     later, pass 2's handle stack) and, for an object of 16 keys or more,
//     a transient key index (deterministic hash, sort fallback, owner Q11).
//     A refused document costs no family.
//   - PASS 2 (`__jp_v2` …) allocates the family ONCE — a flat Bytes root of
//     the exact size — and carves every block of the document inside it,
//     post-order: a container's children first (their handles pushed on the
//     scratch stack), then its list block, filled from the stack. Every
//     carve checks `cursor + size <= end` and every push its room, and dies
//     (a defined abort) otherwise: pass 2 never trusts pass 1's arithmetic.
// An INTERIOR block keeps the ordinary layout `[rc][len][cap][payload]`; its
// rc word is `0x8000_0000 | (block - root)`, so every reader that shares or
// releases it is redirected to the root, and every copy-on-write judge reads
// it as shared. The top Value leaves through `prim.load_handle` (a share of
// the root); the root's own local is then released, so the document is held
// by the one Value the caller gets.
//
// LINEAR TIME (#939): no per-element allocation or copy, no per-element stack
// frame — arrays and objects are loops, recursion is per nesting level only.
fn __json_max_depth() -> Int = 1000

// The err text, spelled out (a runtime int.to_string costs every JSON
// program its formatting code); the test pins it to json_depth_error().
fn __json_depth_error() -> String = "json: nesting deeper than 1000"

// ── the scratch block ──
// [0] i64 family bytes (pass 1) / carve cursor (pass 2)
// [8] i64 handle count (pass 1) / handle stack top, a byte offset (pass 2)
// [16] i64 key-span stack top, a byte offset (pass 1)
// [24] i64 unused
// [32 ..] the key-span stack (pass 1: 8 bytes a key) / the handle stack
//         (pass 2: 4 bytes a handle). Sized from the text length: a key
//         takes at least four bytes of text and a handle at least 4/3.
fn __jp_scratch_len(blen: Int) -> Int = 64 + 3 * blen

fn json_parse(text: String) -> Result[Value, String] = {
  let h = prim.handle(text)
  let blen = prim.load32(h + 4)
  let sn = __jp_scratch_len(blen)
  let sc = prim.alloc_bytes(sn)
  let s = prim.handle(sc) + 12
  prim.store64(s, 0)
  prim.store64(s + 8, 0)
  prim.store64(s + 16, 32)
  prim.store64(s + 24, 0)
  let r = __jp_v1(h + 12, blen, 0, 0, s, sn)
  let q = if r < 0 then r else __jp_trail(h + 12, blen, r)
  if q < 0 then err(__jp_message(h + 12, blen, 0 - 1 - q))
  else {
    let total = prim.load64(s)
    let fam = prim.alloc_bytes(total)
    let f = prim.handle(fam)
    prim.store64(s, 0)
    prim.store64(s + 8, 32)
    let _e = __jp_v2(h + 12, blen, 0, f, total, s, sn)
    // The passes must agree: every byte carved, one handle left.
    if prim.load64(s) != total or prim.load64(s + 8) != 36 then prim.die(prim.handle("Error: json parse: the passes disagree\n")) else ()
    let top: Value = prim.load_handle(s + 32)
    ok(top)
  }
}

// Whitespace to the end, or `json: trailing data` at the first other byte.
fn __jp_trail(base: Int, len: Int, p: Int) -> Int = {
  let q = __jp_ws(base, len, p)
  if q < len then __jp_code(q, 19) else q
}

// A refusal: `kind` (__jp_message) at byte offset `p`, packed into one
// negative Int so a refusal and a position share the return value.
fn __jp_code(p: Int, kind: Int) -> Int = 0 - 1 - (p * 32 + kind)

// The byte offset a refusal code names.
fn __jp_code_pos(r: Int) -> Int = (0 - 1 - r) / 32

// ── refusal texts, spelled at the top only ──
fn __jp_message(base: Int, len: Int, code: Int) -> String = {
  let p = code / 32
  let kind = code % 32
  if kind == 6 then "unexpected end of input"
  else if kind == 14 then __jp_number_error(base, len, p)
  else if kind == 15 then "expected bool"
  else if kind == 16 then "expected null"
  else if kind == 17 then __json_depth_error()
  else if kind == 18 then "unexpected char '" + string.__err_text(string.from_codepoint(__jp_cp(base, len, p)) ?? "") + "' at pos " + int.to_string(__jp_charpos(base, len, p, 0, 0))
  else __jp_at(__jp_what(kind), base, len, p)
}

// The refusals that name a position.
fn __jp_what(kind: Int) -> String = match kind {
  0 => "json: unterminated string",
  1 => "json: control character in string",
  2 => "json: unknown escape",
  3 => "json: invalid unicode escape",
  4 => "json: lone surrogate",
  5 => "json: noncharacter",
  7 => "json: trailing comma",
  8 => "json: expected ',' or ']'",
  9 => "json: expected ',' or '}'",
  10 => "json: unquoted key",
  11 => "json: duplicate key",
  12 => "json: expected ':'",
  19 => "json: trailing data",
  _ => "json: invalid number",
}

// A number whose value is out of range: int.parse's / float.parse's own
// err text for the token (allocates; the refusal path only).
fn __jp_number_error(base: Int, len: Int, p: Int) -> String = {
  let end = __jp_numrun(base, len, p)
  let s = __jp_substr(base, len, p, end)
  let lead = if p < len and prim.load8(base + p) == 45 then p + 1 else p
  if __jp_digits(base, len, lead) < end then match float.parse(s) {
    ok(_) => "",
    err(m) => m,
  } else match int.parse(s) {
    ok(_) => "",
    err(m) => m,
  }
}

// ── low-level helpers (byte floor) ──
// The UTF-8 codepoint whose lead byte is at base+p (a byte past the text
// reads as a continuation of nothing: the text is valid UTF-8, so it never
// happens).
fn __jp_cp(base: Int, len: Int, p: Int) -> Int = if p < 0 or p >= len then 0
else {
  let b0 = prim.load8(base + p)
  if b0 < 128 then b0
  else if b0 < 224 then (b0 - 192) * 64 + (__jp_cont(base, len, p + 1))
  else if b0 < 240 then (b0 - 224) * 4096 + __jp_cont(base, len, p + 1) * 64 + __jp_cont(base, len, p + 2)
  else (b0 - 240) * 262144 + __jp_cont(base, len, p + 1) * 4096 + __jp_cont(base, len, p + 2) * 64 + __jp_cont(base, len, p + 3)
}

// The six payload bits of the continuation byte at p.
fn __jp_cont(base: Int, len: Int, p: Int) -> Int = if p >= 0 and p < len then prim.load8(base + p) - 128 else 0

// The CHAR index of byte offset `p` (count non-continuation bytes) — only for
// the oracle's `at pos N` error message, linear once per error.
fn __jp_charpos(base: Int, len: Int, p: Int, i: Int, acc: Int) -> Int = if i >= p or i < 0 or i >= len then acc
else {
  let b = prim.load8(base + i)
  let is_cont = b >= 128 and b < 192
  __jp_charpos(base, len, p, i + 1, if is_cont then acc else acc + 1)
}

// Copy n bytes from src+i.. to dst+i.., eight at a time while eight remain;
// src holds sn bytes and dst dn, and a copy past either dies.
fn __jp_copy(src: Int, sn: Int, dst: Int, dn: Int, n: Int, i: Int) -> Int = if i < 0 or n > sn or n > dn then {
  prim.die(prim.handle("Error: json parse: copy out of range\n"))
  0
} else if i + 8 <= n then {
  prim.store64(dst + i, prim.load64(src + i))
  __jp_copy(src, sn, dst, dn, n, i + 8)
} else if i < n then {
  prim.store8(dst + i, prim.load8(src + i))
  __jp_copy(src, sn, dst, dn, n, i + 1)
} else 0

// A fresh String copy of bytes [from, to) — for the err-time number texts.
fn __jp_substr(base: Int, len: Int, from: Int, to: Int) -> String = {
  let a = if from < 0 then 0 else from
  let b = if to > len then len else to
  let n = if b > a then b - a else 0
  let s = prim.alloc_str(n)
  let _c = __jp_copy(base + a, len - a, prim.handle(s) + 12, n, n, 0)
  s
}

// "<what> at pos N" with N the CHAR index of byte offset p.
fn __jp_at(what: String, base: Int, len: Int, p: Int) -> String = what + " at pos " + int.to_string(__jp_charpos(base, len, p, 0, 0))

// JSON whitespace only: space, tab, LF, CR (RFC 8259 §2).
fn __jp_ws(base: Int, len: Int, p: Int) -> Int = if p < 0 or p >= len then p
else {
  let b = prim.load8(base + p)
  if b == 32 or b == 9 or b == 10 or b == 13 then __jp_ws(base, len, p + 1)
  else p
}

// The byte at p, or -1 past the text.
fn __jp_byte(base: Int, len: Int, p: Int) -> Int = if p >= 0 and p < len then prim.load8(base + p) else 0 - 1

// I-JSON §2.1: U+FDD0..U+FDEF and every U+xFFFE / U+xFFFF.
fn __jp_nonchar(cp: Int) -> Bool = (cp >= 64976 and cp <= 65007) or cp % 65536 >= 65534

// UTF-8 length of a codepoint.
fn __jp_u8len(cp: Int) -> Int = if cp < 128 then 1 else if cp < 2048 then 2 else if cp < 65536 then 3 else 4

// ── carved sizes (block header + 4-rounded payload, never under 4) ──
fn __jp_cap(n: Int) -> Int = if n <= 4 then 4 else (n + 3) / 4 * 4

fn __jp_box_size() -> Int = 28

fn __jp_pair_size() -> Int = 20

// ══ PASS 1: validate and count ══
// Each reader takes its start position and answers the position after what
// it read, or a refusal code (negative). Counts go to the scratch words.

// Add `n` to the scratch word at `off` (0 = family bytes, 8 = handles).
fn __jp_count(s: Int, sn: Int, off: Int, n: Int) -> Unit = if off >= 0 and off + 8 <= sn then prim.store64(s + off, prim.load64(s + off) + n)
else prim.die(prim.handle("Error: json parse: scratch out of range\n"))

// One value of the family: its box, and one stacked handle.
fn __jp_count_value(s: Int, sn: Int, extra: Int) -> Unit = {
  __jp_count(s, sn, 0, __jp_box_size() + extra)
  __jp_count(s, sn, 8, 1)
}

// The value at p (whitespace first).
fn __jp_v1(base: Int, len: Int, p: Int, depth: Int, s: Int, sn: Int) -> Int = {
  let q = __jp_ws(base, len, p)
  let b = __jp_byte(base, len, q)
  if b < 0 then __jp_code(q, 6)
  else if b == 34 then {
    let r = __jp_str_scan(base, len, q + 1, q, 0, 0)
    if r < 0 then r
    else {
      __jp_count_value(s, sn, 12 + __jp_cap(__jp_scan_n(r)))
      __jp_scan_end(r) + 1
    }
  } else if (b == 123 or b == 91) and depth >= __json_max_depth() then __jp_code(q, 17)
  else if b == 123 then __jp_object1(base, len, __jp_ws(base, len, q + 1), depth + 1, s, sn)
  else if b == 91 then __jp_array1(base, len, __jp_ws(base, len, q + 1), depth + 1, s, sn)
  else if b == 116 then __jp_lit1(base, len, q, 4, __jp_lit_at(base, len, q, 116, 114, 117, 101), 15, s, sn)
  else if b == 102 then __jp_lit1(base, len, q, 5, __jp_lit_at(base, len, q, 102, 97, 108, 115) and __jp_byte(base, len, q + 4) == 101, 15, s, sn)
  else if b == 110 then __jp_lit1(base, len, q, 4, __jp_lit_at(base, len, q, 110, 117, 108, 108), 16, s, sn)
  else if b == 45 or (b >= 48 and b <= 57) then __jp_number1(base, len, q, s, sn)
  else __jp_code(q, 18)
}

// A literal of `n` bytes at p that matched (`ok`), or refused with `kind`.
fn __jp_lit1(base: Int, len: Int, p: Int, n: Int, ok: Bool, kind: Int, s: Int, sn: Int) -> Int = if ok then {
  __jp_count_value(s, sn, 0)
  p + n
} else __jp_code(p, kind)

fn __jp_lit_at(base: Int, len: Int, p: Int, b0: Int, b1: Int, b2: Int, b3: Int) -> Bool = __jp_byte(base, len, p) == b0 and __jp_byte(base, len, p + 1) == b1 and __jp_byte(base, len, p + 2) == b2 and __jp_byte(base, len, p + 3) == b3

// ── strings ──
// From p inside the string opened at `open`, `n` decoded bytes so far: the
// closing quote's offset e, the decoded byte count and whether an escape
// was met, packed as (e * 2^31 + n) * 2 + esc — or a refusal code.
fn __jp_str_scan(base: Int, len: Int, p: Int, open: Int, esc: Int, n: Int) -> Int = {
  let b = __jp_byte(base, len, p)
  if b < 0 then __jp_code(open, 0)
  else if b == 34 then (p * 2147483648 + n) * 2 + esc
  else if b < 32 then __jp_code(p, 1)
  else if b == 92 then {
    let x = __jp_byte(base, len, p + 1)
    if x < 0 then __jp_code(open, 0)
    else if x == 34 or x == 92 or x == 47 or x == 98 or x == 102 or x == 110 or x == 114 or x == 116 then __jp_str_scan(base, len, p + 2, open, 1, n + 1)
    else if x == 117 then __jp_str_scan_u(base, len, p, open, n)
    else __jp_code(p, 2)
  } else if b >= 239 then {
    if __jp_nonchar(__jp_cp(base, len, p)) then __jp_code(p, 5)
    else {
      let w = if b < 240 then 3 else 4
      __jp_str_scan(base, len, p + w, open, esc, n + w)
    }
  } else __jp_str_scan(base, len, p + 1, open, esc, n + 1)
}

// \uXXXX at p (p = the backslash).
fn __jp_str_scan_u(base: Int, len: Int, p: Int, open: Int, n: Int) -> Int = {
  let unit = __jp_hex4(base, len, p + 2)
  if unit < 0 then __jp_code(p, 3)
  else if unit >= 55296 and unit <= 56319 then {
    let lo = if __jp_byte(base, len, p + 6) == 92 and __jp_byte(base, len, p + 7) == 117 then __jp_hex4(base, len, p + 8) else 0 - 1
    if lo >= 56320 and lo <= 57343 then {
      let cp = 65536 + (unit - 55296) * 1024 + (lo - 56320)
      if __jp_nonchar(cp) then __jp_code(p, 5)
      else __jp_str_scan(base, len, p + 12, open, 1, n + 4)
    } else __jp_code(p, 4)
  } else if unit >= 56320 and unit <= 57343 then __jp_code(p, 4)
  else if __jp_nonchar(unit) then __jp_code(p, 5)
  else __jp_str_scan(base, len, p + 6, open, 1, n + __jp_u8len(unit))
}

// The fields of a scan answer.
fn __jp_scan_end(r: Int) -> Int = prim.bshr(r, 32)

fn __jp_scan_n(r: Int) -> Int = prim.band(prim.bshr(r, 1), 2147483647)

fn __jp_scan_esc(r: Int) -> Int = prim.band(r, 1)

// Exactly 4 ASCII hex digits at base+p → the code unit; anything else → -1.
// (from_str_radix rejects whitespace/`0x`, so this is hand-rolled.)
fn __jp_hex_digit(b: Int) -> Int = if b >= 48 and b <= 57 then b - 48
else if b >= 97 and b <= 102 then b - 87
else if b >= 65 and b <= 70 then b - 55 else 0 - 1

// The bound is `p > len - 4`, not `p + 4 > len`: the additive form WRAPS at a
// near-`i64::MAX` position and admits an out-of-range read. `len` is a
// non-negative i32-ranged length, so `len - 4` cannot overflow.
fn __jp_hex4(base: Int, len: Int, p: Int) -> Int = if p < 0 or p > len - 4 then 0 - 1
else {
  let a = __jp_hex_digit(__jp_byte(base, len, p))
  let b = __jp_hex_digit(__jp_byte(base, len, p + 1))
  let c = __jp_hex_digit(__jp_byte(base, len, p + 2))
  let d = __jp_hex_digit(__jp_byte(base, len, p + 3))
  if a < 0 or b < 0 or c < 0 or d < 0 then 0 - 1 else ((a * 16 + b) * 16 + c) * 16 + d
}

// ── numbers ──
fn __jp_digits(base: Int, len: Int, p: Int) -> Int = {
  let b = __jp_byte(base, len, p)
  if b >= 48 and b <= 57 then __jp_digits(base, len, p + 1) else p
}

// The number token: the run of `0-9 + - . e E` from p.
fn __jp_numrun(base: Int, len: Int, p: Int) -> Int = {
  let b = __jp_byte(base, len, p)
  if (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46 or b == 101 or b == 69 then __jp_numrun(base, len, p + 1)
  else p
}

// End of the RFC 8259 number that starts at p and ends by `end`, or -1 when
// the token is not one (the run must be matched whole).
fn __jp_num_end(base: Int, end: Int, p: Int) -> Int = {
  let p1 = if __jp_byte(base, end, p) == 45 then p + 1 else p
  let p2 = __jp_digits(base, end, p1)
  if p2 == p1 then 0 - 1
  else if __jp_byte(base, end, p1) == 48 and p2 > p1 + 1 then 0 - 1
  else {
    let has_frac = __jp_byte(base, end, p2) == 46
    let p3 = if has_frac then __jp_digits(base, end, p2 + 1) else p2
    if has_frac and p3 == p2 + 1 then 0 - 1
    else {
      let eb = __jp_byte(base, end, p3)
      if eb == 101 or eb == 69 then {
        let sb = __jp_byte(base, end, p3 + 1)
        let ps = if sb == 43 or sb == 45 then p3 + 2 else p3 + 1
        let p4 = __jp_digits(base, end, ps)
        if p4 == ps then 0 - 1 else p4
      } else p3
    }
  }
}

// The decimal digits in [p, stop) accumulated onto m.
fn __jp_mantissa(base: Int, len: Int, p: Int, stop: Int, m: Int) -> Int = if p >= stop then m
else __jp_mantissa(base, len, p + 1, stop, m * 10 + (__jp_byte(base, len, p) - 48))

// Does the Int token of `d` digits from `lead` fit (negative when `neg`)?
// Up to 18 digits always; 19 against i64's bound; more never.
fn __jp_int_fits(base: Int, len: Int, lead: Int, d: Int, neg: Bool) -> Bool = if d <= 18 then true
else if d > 19 then false
else {
  let m = __jp_mantissa(base, len, lead, lead + 18, 0)
  let last = __jp_byte(base, len, lead + 18) - 48
  m < 922337203685477580 or (m == 922337203685477580 and last <= (if neg then 8 else 7))
}

// The leading zero digits of [p, stop).
fn __jp_zeros(base: Int, len: Int, p: Int, stop: Int, z: Int) -> Int = if p < stop and __jp_byte(base, len, p) == 48 then __jp_zeros(base, len, p + 1, stop, z + 1) else z

// Does the Float token [p, end) fit an f64? Its value is 0.d… × 10^dp with
// d the first nonzero digit: dp <= 308 always fits, dp >= 310 never does,
// and only dp == 309 asks float.parse itself (allocates; such a token is
// rare). The exponent saturates as float.parse's does.
fn __jp_float_fits(base: Int, len: Int, p: Int, end: Int) -> Bool = {
  let p0 = if __jp_byte(base, len, p) == 45 then p + 1 else p
  let i_end = __jp_digits(base, len, p0)
  let has_dot = __jp_byte(base, len, i_end) == 46
  let f_start = if has_dot then i_end + 1 else i_end
  let f_end = __jp_digits(base, len, f_start)
  let zi = __jp_zeros(base, len, p0, i_end, 0)
  let z = if zi == i_end - p0 then zi + __jp_zeros(base, len, f_start, f_end, 0) else zi
  if z == (i_end - p0) + (f_end - f_start) then true
  else {
    let eb = __jp_byte(base, len, f_end)
    let has_e = eb == 101 or eb == 69
    let sb = __jp_byte(base, len, f_end + 1)
    let e_neg = has_e and sb == 45
    let e_start = if has_e and (sb == 45 or sb == 43) then f_end + 2 else f_end + 1
    let e_end = if has_e then __jp_digits(base, len, e_start) else e_start
    let e_mag = if not has_e then 0 else if e_end - e_start > 8 then 999999999 else __jp_mantissa(base, len, e_start, e_end, 0)
    let dp = (i_end - p0) - z + (if e_neg then 0 - e_mag else e_mag)
    if dp <= 308 then true
    else if dp >= 310 then false
    else match float.parse(__jp_substr(base, len, p, end)) {
      ok(_) => true,
      err(_) => false,
    }
  }
}

fn __jp_number1(base: Int, len: Int, p: Int, s: Int, sn: Int) -> Int = {
  let end = __jp_numrun(base, len, p)
  if __jp_num_end(base, end, p) != end then __jp_code(p, 13)
  else {
    let neg = __jp_byte(base, len, p) == 45
    let lead = if neg then p + 1 else p
    let fits = if __jp_digits(base, len, lead) < end then __jp_float_fits(base, len, p, end)
    else __jp_int_fits(base, len, lead, end - lead, neg)
    if fits then {
      __jp_count_value(s, sn, 0)
      end
    } else __jp_code(p, 14)
  }
}

// ── collections (pass 1) ──
// After a member at `np`: the close (answered as -1 - (close position + 1)
// ... see __jp_after1), a `,` and the next member's offset, or a refusal.
// Answer: >= 0 the next member's offset; -1 the container closed at the
// position stored by the caller's convention below; else a refusal code.
// To keep one Int, a close is answered as `len + 1 + (q + 1)` — past every
// member offset — so the caller tells the three cases apart.
fn __jp_after1(base: Int, len: Int, np: Int, close: Int) -> Int = {
  let q = __jp_ws(base, len, np)
  let b = __jp_byte(base, len, q)
  if b < 0 then __jp_code(q, 6)
  else if b == close then len + 2 + q
  else if b == 44 then {
    let n = __jp_ws(base, len, q + 1)
    if __jp_byte(base, len, n) == close then __jp_code(q, 7) else n
  } else __jp_code(q, if close == 93 then 8 else 9)
}

// p is at the first element (post-`[`, post-ws). An empty array closes here.
// A loop, never one frame per element (#939).
fn __jp_array1(base: Int, len: Int, p0: Int, depth: Int, s: Int, sn: Int) -> Int = {
  var k = 0
  var p = if __jp_byte(base, len, p0) == 93 then len + 2 + p0 else p0
  while p >= 0 and p <= len {
    let v = __jp_v1(base, len, p, depth, s, sn)
    k = k + 1
    p = if v < 0 then v else __jp_after1(base, len, v, 93)
  }
  if p < 0 then p
  else {
    __jp_count_value(s, sn, 12 + __jp_cap(4 * k))
    p - len - 1
  }
}

// ── keys (pass 1) ──
// The key-span stack: per key read in an open object, its opening quote's
// offset times two plus its escape flag, and its closing quote's offset.
fn __jp_span_push(s: Int, sn: Int, open: Int, esc: Int, e: Int) -> Unit = {
  let t = prim.load64(s + 16)
  if t >= 32 and t + 8 <= sn then {
    prim.store32(s + t, open * 2 + esc)
    prim.store32(s + t + 4, e)
    prim.store64(s + 16, t + 8)
  } else prim.die(prim.handle("Error: json parse: key stack out of range\n"))
}

fn __jp_span_open(s: Int, sn: Int, t: Int) -> Int = if t >= 32 and t + 8 <= sn then prim.load32(s + t) / 2 else 0

fn __jp_span_esc(s: Int, sn: Int, t: Int) -> Int = if t >= 32 and t + 8 <= sn then prim.load32(s + t) % 2 else 0

fn __jp_span_end(s: Int, sn: Int, t: Int) -> Int = if t >= 32 and t + 8 <= sn then prim.load32(s + t + 4) else 0

// The next decoded codepoint of a checked string at p, packed with the
// raw bytes it took: cp * 16 + width.
fn __jp_next_cp(base: Int, len: Int, p: Int) -> Int = {
  let b = __jp_byte(base, len, p)
  if b == 92 then {
    let x = __jp_byte(base, len, p + 1)
    if x == 117 then {
      let unit = __jp_hex4(base, len, p + 2)
      if unit >= 55296 and unit <= 56319 then (65536 + (unit - 55296) * 1024 + (__jp_hex4(base, len, p + 8) - 56320)) * 16 + 12
      else unit * 16 + 6
    } else __jp_simple_escape(x) * 16 + 2
  } else if b < 128 then b * 16 + 1
  else if b < 224 then __jp_cp(base, len, p) * 16 + 2
  else if b < 240 then __jp_cp(base, len, p) * 16 + 3
  else __jp_cp(base, len, p) * 16 + 4
}

// The byte a checked one-char escape stands for.
fn __jp_simple_escape(e: Int) -> Int = if e == 110 then 10
else if e == 116 then 9
else if e == 114 then 13
else if e == 98 then 8
else if e == 102 then 12 else e

// Compare the decoded keys [a, ae) and [b, be) codepoint by codepoint:
// negative, zero or positive.
fn __jp_key_cmp(base: Int, len: Int, a: Int, ae: Int, b: Int, be: Int) -> Int = if a >= ae or b >= be then (if a < ae then 1 else if b < be then 0 - 1 else 0)
else {
  let x = __jp_next_cp(base, len, a)
  let y = __jp_next_cp(base, len, b)
  if x / 16 != y / 16 then x / 16 - y / 16
  else __jp_key_cmp(base, len, a + x % 16, ae, b + y % 16, be)
}

// Raw bytes [a, a+n) and [b, b+n) equal?
fn __jp_same_bytes(base: Int, len: Int, a: Int, b: Int, n: Int, i: Int) -> Bool = if i >= n then true
else if __jp_byte(base, len, a + i) != __jp_byte(base, len, b + i) then false
else __jp_same_bytes(base, len, a, b, n, i + 1)

// The keys at span slots t and u equal (decoded)?
fn __jp_key_eq(base: Int, len: Int, s: Int, sn: Int, t: Int, u: Int) -> Bool = {
  let a = __jp_span_open(s, sn, t) + 1
  let ae = __jp_span_end(s, sn, t)
  let b = __jp_span_open(s, sn, u) + 1
  let be = __jp_span_end(s, sn, u)
  if __jp_span_esc(s, sn, t) == 0 and __jp_span_esc(s, sn, u) == 0 then ae - a == be - b and __jp_same_bytes(base, len, a, b, ae - a, 0)
  else __jp_key_cmp(base, len, a, ae, b, be) == 0
}

// Does the key at slot `t` repeat one of the slots [from, t)?
fn __jp_repeats(base: Int, len: Int, s: Int, sn: Int, from: Int, t: Int) -> Bool = if from >= t then false
else if __jp_key_eq(base, len, s, sn, from, t) then true
else __jp_repeats(base, len, s, sn, from + 8, t)

// p is at the first key (post-`{`, post-ws). An empty object closes here.
// The first 16 keys are each checked against the keys before them as they
// are read; from the 17th on, the check is deferred to one index over the
// whole object (__jp_dups) — run when the object closes, and when it is left
// by a refusal (the earlier of the two refusals is the one reported), so the
// first refusal in document order still wins.
fn __jp_object1(base: Int, len: Int, p0: Int, depth: Int, s: Int, sn: Int) -> Int = {
  let from = prim.load64(s + 16)
  var k = 0
  var p = if __jp_byte(base, len, p0) == 125 then len + 2 + p0 else p0
  while p >= 0 and p <= len {
    let b = __jp_byte(base, len, p)
    let r = if b < 0 then __jp_code(p, 6)
    else if b != 34 then __jp_code(p, 10)
    else __jp_str_scan(base, len, p + 1, p, 0, 0)
    if r < 0 then {
      p = r
    } else {
      let e = __jp_scan_end(r)
      __jp_span_push(s, sn, p, __jp_scan_esc(r), e)
      __jp_count(s, sn, 0, 12 + __jp_cap(__jp_scan_n(r)))
      let t = prim.load64(s + 16) - 8
      if k < 16 and __jp_repeats(base, len, s, sn, from, t) then {
        p = __jp_code(p, 11)
      } else {
        let c = __jp_ws(base, len, e + 1)
        let cb = __jp_byte(base, len, c)
        let v = if cb < 0 then __jp_code(c, 6)
        else if cb != 58 then __jp_code(c, 12)
        else __jp_v1(base, len, c + 1, depth, s, sn)
        k = k + 1
        p = if v < 0 then v else __jp_after1(base, len, v, 125)
      }
    }
  }
  let to = prim.load64(s + 16)
  let d = if k > 16 then __jp_dups(base, len, s, sn, from, to) else 0 - 1
  prim.store64(s + 16, from)
  if d >= 0 and (p >= 0 or d < __jp_code_pos(p)) then __jp_code(d, 11)
  else if p < 0 then p
  else {
    __jp_count(s, sn, 0, __jp_box_size() + 12 + __jp_cap(4 * k) + k * __jp_pair_size())
    __jp_count(s, sn, 8, 1 + k)
    p - len - 1
  }
}

// ── the wide-object key index (owner Q11) ──
// The keys at span slots [from, to): the offset of the first key that
// repeats an earlier one (its opening quote), or -1. A deterministic hash
// (FNV-1a over the decoded codepoints, no seed) into an open-addressed table
// of at least twice the keys; a probe run longer than __jp_chain_max() falls
// back to sorting the keys, so adversarial keys cost O(n log n), never
// O(n^2). The table is one transient block.
fn __jp_chain_max() -> Int = 8

fn __jp_dups(base: Int, len: Int, s: Int, sn: Int, from: Int, to: Int) -> Int = {
  let n = (to - from) / 8
  let m = __jp_pow2(n * 2, 32)
  let tb = prim.alloc_bytes(4 * m + 8 * n)
  let t = prim.handle(tb) + 12
  let tn = 4 * m + 8 * n
  let _z = __jp_zero(t, tn, 0)
  let d = __jp_hash_all(base, len, s, sn, from, to, t, tn, m, from)
  if d != 0 - 2 then d
  else __jp_sort_dups(base, len, s, sn, from, n, t + 4 * m, 8 * n)
}

fn __jp_pow2(want: Int, m: Int) -> Int = if m >= want then m else __jp_pow2(want, m * 2)

fn __jp_zero(t: Int, tn: Int, i: Int) -> Int = if i >= 0 and i + 8 <= tn then {
  prim.store64(t + i, 0)
  __jp_zero(t, tn, i + 8)
} else if i >= 0 and i + 4 <= tn then {
  prim.store32(t + i, 0)
  __jp_zero(t, tn, i + 4)
} else 0

// FNV-1a (32-bit) over the decoded codepoints of [a, ae).
fn __jp_hash(base: Int, len: Int, a: Int, ae: Int, hv: Int) -> Int = if a >= ae then hv
else {
  let x = __jp_next_cp(base, len, a)
  __jp_hash(base, len, a + x % 16, ae, prim.band(prim.bxor(hv, x / 16) * 16777619, 4294967295))
}

// Insert the slots [t, to) in order: the first repeat's offset, -1 when
// none, or -2 when a probe run grew past the chain bound.
fn __jp_hash_all(base: Int, len: Int, s: Int, sn: Int, from: Int, to: Int, tab: Int, tn: Int, m: Int, t: Int) -> Int = if t >= to then 0 - 1
else {
  let hv = __jp_hash(base, len, __jp_span_open(s, sn, t) + 1, __jp_span_end(s, sn, t), 2166136261)
  let r = __jp_probe(base, len, s, sn, tab, tn, m, t, prim.band(hv, m - 1), 0)
  if r != 0 - 1 then r
  else __jp_hash_all(base, len, s, sn, from, to, tab, tn, m, t + 8)
}

// Probe for slot t's key from table index i (c steps taken): -1 once it is
// inserted, its offset when an equal key is there, -2 past the chain bound.
fn __jp_probe(base: Int, len: Int, s: Int, sn: Int, tab: Int, tn: Int, m: Int, t: Int, i: Int, c: Int) -> Int = if c > __jp_chain_max() then 0 - 2
else if i < 0 or 4 * i + 4 > tn then 0 - 2
else {
  let u = prim.load32(tab + 4 * i)
  if u == 0 then {
    prim.store32(tab + 4 * i, t)
    0 - 1
  } else if __jp_key_eq(base, len, s, sn, u, t) then __jp_span_open(s, sn, t)
  else __jp_probe(base, len, s, sn, tab, tn, m, t, prim.band(i + 1, m - 1), c + 1)
}

// The sort fallback: the n slots from `from` sorted by (key, position) with
// a bottom-up merge sort over two index arrays in [w, w + wn); within each
// run of equal keys the second is a repeat, and the earliest such is the
// answer.
fn __jp_sort_dups(base: Int, len: Int, s: Int, sn: Int, from: Int, n: Int, w: Int, wn: Int) -> Int = if 8 * n > wn then 0 - 1
else {
  let _f = __jp_fill_idx(w, 4 * n, from, 0)
  let src = __jp_msort(base, len, s, sn, w, w + 4 * n, 4 * n, 1)
  __jp_runs(base, len, s, sn, src, 4 * n, 4, 0 - 1)
}

fn __jp_fill_idx(a: Int, an: Int, from: Int, i: Int) -> Int = if i >= 0 and i + 4 <= an then {
  prim.store32(a + i, from + 2 * i)
  __jp_fill_idx(a, an, from, i + 4)
} else 0

// Order of slots t and u: by key, then by position.
fn __jp_slot_lt(base: Int, len: Int, s: Int, sn: Int, t: Int, u: Int) -> Bool = {
  let c = __jp_key_cmp(base, len, __jp_span_open(s, sn, t) + 1, __jp_span_end(s, sn, t), __jp_span_open(s, sn, u) + 1, __jp_span_end(s, sn, u))
  c < 0 or (c == 0 and t < u)
}

// Merge passes of width `wd` (in slots) from a into b and back; answers the
// array holding the sorted result.
fn __jp_msort(base: Int, len: Int, s: Int, sn: Int, a: Int, b: Int, an: Int, wd: Int) -> Int = if 4 * wd >= an then a
else {
  let _m = __jp_merge_pass(base, len, s, sn, a, b, an, 4 * wd, 0)
  __jp_msort(base, len, s, sn, b, a, an, wd * 2)
}

fn __jp_merge_pass(base: Int, len: Int, s: Int, sn: Int, a: Int, b: Int, an: Int, w: Int, lo: Int) -> Int = if lo >= an then 0
else {
  let mid = if lo + w < an then lo + w else an
  let hi = if lo + 2 * w < an then lo + 2 * w else an
  let _m = __jp_merge(base, len, s, sn, a, b, an, lo, mid, mid, hi, lo)
  __jp_merge_pass(base, len, s, sn, a, b, an, w, hi)
}

fn __jp_merge(base: Int, len: Int, s: Int, sn: Int, a: Int, b: Int, an: Int, i: Int, ie: Int, j: Int, je: Int, o: Int) -> Int = if o < 0 or o + 4 > an or i < 0 or j < 0 or ie > an or je > an then 0
else if i < ie and (j >= je or not __jp_slot_lt(base, len, s, sn, prim.load32(a + j), prim.load32(a + i))) then {
  prim.store32(b + o, prim.load32(a + i))
  __jp_merge(base, len, s, sn, a, b, an, i + 4, ie, j, je, o + 4)
} else if j < je then {
  prim.store32(b + o, prim.load32(a + j))
  __jp_merge(base, len, s, sn, a, b, an, i, ie, j + 4, je, o + 4)
} else 0

// Over the sorted slots: the smallest offset of a key equal to the one
// before it (best so far `d`).
fn __jp_runs(base: Int, len: Int, s: Int, sn: Int, a: Int, an: Int, i: Int, d: Int) -> Int = if i < 4 or i + 4 > an then d
else {
  let t = prim.load32(a + i - 4)
  let u = prim.load32(a + i)
  let o = __jp_span_open(s, sn, u)
  let d2 = if __jp_key_eq(base, len, s, sn, t, u) and (d < 0 or o < d) then o else d
  __jp_runs(base, len, s, sn, a, an, i + 4, d2)
}

// ══ PASS 2: carve the family ══
// The family root is the flat block at `f` (its payload [f+12, f+12+fl));
// the scratch word [0] is the carve cursor, [8] the handle stack top.

// Carve one interior block of `size` bytes (header included) whose len word
// is `n`: its rc word is the distance back to the root with the top bit set.
fn __jp_carve(f: Int, fl: Int, s: Int, sn: Int, size: Int, n: Int) -> Int = {
  let cur = if sn >= 16 then prim.load64(s) else 0 - 1
  if cur >= 0 and size >= 16 and n >= 0 and n <= size - 12 and cur + size <= fl then {
    let b = f + 12 + cur
    prim.store32(b, 2147483648 + 12 + cur)
    prim.store32(b + 4, n)
    prim.store32(b + 8, size - 12)
    prim.store64(s, cur + size)
    b
  } else {
    prim.die(prim.handle("Error: json parse: the family is full\n"))
    0
  }
}

// Push a handle on the scratch stack.
fn __jp_push(s: Int, sn: Int, x: Int) -> Unit = {
  let t = if sn >= 16 then prim.load64(s + 8) else 0
  if t >= 32 and t + 4 <= sn then {
    prim.store32(s + t, x)
    prim.store64(s + 8, t + 4)
  } else prim.die(prim.handle("Error: json parse: handle stack out of range\n"))
}

// Pop the top handle.
fn __jp_pop(s: Int, sn: Int) -> Int = {
  let t = if sn >= 16 then prim.load64(s + 8) else 0
  if t >= 36 and t <= sn then {
    prim.store64(s + 8, t - 4)
    prim.load32(s + t - 4)
  } else {
    prim.die(prim.handle("Error: json parse: handle stack underflow\n"))
    0
  }
}

// A Value box with `tag` and the 8-byte payload `x`, pushed.
fn __jp_box(f: Int, fl: Int, s: Int, sn: Int, tag: Int, x: Int) -> Unit = {
  let b = __jp_carve(f, fl, s, sn, 28, 16)
  prim.store32(b + 12, tag)
  prim.store32(b + 16, 0)
  prim.store64(b + 20, x)
  __jp_push(s, sn, b)
}

// A list block of the top `k` handles (popped), in stack order.
fn __jp_list(f: Int, fl: Int, s: Int, sn: Int, k: Int) -> Int = {
  let b = __jp_carve(f, fl, s, sn, 12 + __jp_cap(4 * k), 4 * k)
  let t = if sn >= 16 then prim.load64(s + 8) else 0
  if k >= 0 and t - 4 * k >= 32 and t <= sn then {
    let _c = __jp_copy(s + t - 4 * k, 4 * k, b + 12, 4 * k, 4 * k, 0)
    prim.store64(s + 8, t - 4 * k)
    b
  } else {
    prim.die(prim.handle("Error: json parse: handle stack underflow\n"))
    b
  }
}

// The String block of the checked string opened at p (scan answer r).
fn __jp_str2(base: Int, len: Int, p: Int, r: Int, f: Int, fl: Int, s: Int, sn: Int) -> Int = {
  let e = __jp_scan_end(r)
  let n = __jp_scan_n(r)
  let cap = __jp_cap(n)
  let b = __jp_carve(f, fl, s, sn, 12 + cap, n)
  if __jp_scan_esc(r) == 0 then {
    let _c = __jp_copy(base + p + 1, len - p - 1, b + 12, cap, n, 0)
    b
  } else {
    if __jp_str_fill(base, len, p + 1, e, b + 12, cap, 0) != n then prim.die(prim.handle("Error: json parse: the passes disagree\n")) else ()
    b
  }
}

// Decode [p, e) of a checked string into dh (room dn); returns the bytes
// written.
fn __jp_str_fill(base: Int, len: Int, p: Int, e: Int, dh: Int, dn: Int, o: Int) -> Int = if p >= e then o
else {
  let x = __jp_next_cp(base, len, p)
  let b = __jp_byte(base, len, p)
  if b != 92 then {
    if o >= 0 and o + 1 <= dn then prim.store8(dh + o, b) else prim.die(prim.handle("Error: json parse: string room\n"))
    __jp_str_fill(base, len, p + 1, e, dh, dn, o + 1)
  } else __jp_str_fill(base, len, p + x % 16, e, dh, dn, o + __jp_utf8_write(dh, dn, o, x / 16))
}

// Encode codepoint `cp` as UTF-8 at dh+o (room dn); returns the byte count.
fn __jp_utf8_write(dh: Int, dn: Int, o: Int, cp: Int) -> Int = if o < 0 or o + __jp_u8len(cp) > dn then {
  prim.die(prim.handle("Error: json parse: string room\n"))
  0
} else if cp < 128 then {
  prim.store8(dh + o, cp)
  1
} else if cp < 2048 then {
  prim.store8(dh + o, 192 + cp / 64)
  prim.store8(dh + o + 1, 128 + cp % 64)
  2
} else if cp < 65536 then {
  prim.store8(dh + o, 224 + cp / 4096)
  prim.store8(dh + o + 1, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 2, 128 + cp % 64)
  3
} else {
  prim.store8(dh + o, 240 + cp / 262144)
  prim.store8(dh + o + 1, 128 + (cp / 4096) % 64)
  prim.store8(dh + o + 2, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 3, 128 + cp % 64)
  4
}

// The value at p, carved and its box pushed; answers the position after it.
// The text was checked by pass 1, so a byte it does not expect dies.
fn __jp_v2(base: Int, len: Int, p: Int, f: Int, fl: Int, s: Int, sn: Int) -> Int = {
  let q = __jp_ws(base, len, p)
  let b = __jp_byte(base, len, q)
  if b == 34 then {
    let r = __jp_str_scan(base, len, q + 1, q, 0, 0)
    if r < 0 then __jp_bad()
    else {
      __jp_box(f, fl, s, sn, 4, __jp_str2(base, len, q, r, f, fl, s, sn))
      __jp_scan_end(r) + 1
    }
  } else if b == 123 then __jp_object2(base, len, __jp_ws(base, len, q + 1), f, fl, s, sn)
  else if b == 91 then __jp_array2(base, len, __jp_ws(base, len, q + 1), f, fl, s, sn)
  else if b == 116 then {
    __jp_box(f, fl, s, sn, 1, 1)
    q + 4
  } else if b == 102 then {
    __jp_box(f, fl, s, sn, 1, 0)
    q + 5
  } else if b == 110 then {
    __jp_box(f, fl, s, sn, 0, 0)
    q + 4
  } else if b == 45 or (b >= 48 and b <= 57) then __jp_number2(base, len, q, f, fl, s, sn)
  else __jp_bad()
}

fn __jp_bad() -> Int = {
  prim.die(prim.handle("Error: json parse: the passes disagree\n"))
  0
}

// A checked number: an Int read in place (19 digits included — pass 1 kept
// only what fits), a Float through float.parse.
fn __jp_number2(base: Int, len: Int, p: Int, f: Int, fl: Int, s: Int, sn: Int) -> Int = {
  let end = __jp_numrun(base, len, p)
  let neg = __jp_byte(base, len, p) == 45
  let lead = if neg then p + 1 else p
  if __jp_digits(base, len, lead) < end then {
    match float.parse(__jp_substr(base, len, p, end)) {
      ok(x) => __jp_box(f, fl, s, sn, 3, prim.fbits(x)),
      err(_) => {
        let _b = __jp_bad()
        ()
      },
    }
    end
  } else {
    let d = end - lead
    let m = __jp_mantissa(base, len, lead, if d > 18 then lead + 18 else end, 0)
    let last = if d > 18 then __jp_byte(base, len, lead + 18) - 48 else 0
    let x = if d > 18 then (if neg then (0 - m) * 10 - last else m * 10 + last) else if neg then 0 - m else m
    __jp_box(f, fl, s, sn, 2, x)
    end
  }
}

// After a member at np: the next member's offset, or `len + 2 + q` for the
// close at q (checked text: a `,` or the close follows).
fn __jp_after2(base: Int, len: Int, np: Int, close: Int) -> Int = {
  let q = __jp_ws(base, len, np)
  let b = __jp_byte(base, len, q)
  if b == close then len + 2 + q
  else if b == 44 then __jp_ws(base, len, q + 1)
  else __jp_bad()
}

fn __jp_array2(base: Int, len: Int, p0: Int, f: Int, fl: Int, s: Int, sn: Int) -> Int = {
  var k = 0
  var p = if __jp_byte(base, len, p0) == 93 then len + 2 + p0 else p0
  while p >= 0 and p <= len {
    let v = __jp_v2(base, len, p, f, fl, s, sn)
    k = k + 1
    p = __jp_after2(base, len, v, 93)
  }
  __jp_box(f, fl, s, sn, 5, __jp_list(f, fl, s, sn, k))
  p - len - 1
}

fn __jp_object2(base: Int, len: Int, p0: Int, f: Int, fl: Int, s: Int, sn: Int) -> Int = {
  var k = 0
  var p = if __jp_byte(base, len, p0) == 125 then len + 2 + p0 else p0
  while p >= 0 and p <= len {
    let r = __jp_str_scan(base, len, p + 1, p, 0, 0)
    let kh = if r < 0 then __jp_bad() else __jp_str2(base, len, p, r, f, fl, s, sn)
    let c = __jp_ws(base, len, __jp_scan_end(r) + 1)
    let v = __jp_v2(base, len, c + 1, f, fl, s, sn)
    let vh = __jp_pop(s, sn)
    let pb = __jp_carve(f, fl, s, sn, 20, 8)
    prim.store32(pb + 12, kh)
    prim.store32(pb + 16, vh)
    __jp_push(s, sn, pb)
    k = k + 1
    p = __jp_after2(base, len, v, 125)
  }
  __jp_box(f, fl, s, sn, 6, __jp_list(f, fl, s, sn, k))
  p - len - 1
}
