// json_parse — SELF-HOSTED `json.parse(text)`: a pure-Almide recursive-descent
// NORMATIVE SPEC: ALS-T3 (docs/specs/als/text-and-numbers.md §T3) — conformance is judged against that section's
// rules and its pinned fixture, NOT against any other implementation (F1: no oracle circularity).
// JSON parser over the prim byte floor, transcribed clause-for-clause from the
// native oracle (`runtime/rs/src/json.rs::almide_rt_json_parse`) so the v1
// trust spine lowers it through the PROVEN pipeline with NO hand-written wasm
// runtime to drift. The last leg of the json codec cascade (parse → accessors →
// ctors → stringify) that puts porta's read_message on the VERIFIED
// render_program path.
//
// Positions are BYTE offsets internally (prim.load8 — O(1); the first version
// used char-indexed string.get + per-char string concat, O(n²), and timed out
// on a multi-KB glTF document). The oracle's positions are CHAR indices, so an
// error message converts its byte offset with one linear count at ERROR time
// only. The grammar is RFC 8259 plus I-JSON (RFC 7493), STRICT (C-087, C-400,
// C-401, #4111 / #4112), with one err text per case, the oracle's:
//   - the whole text is one value between JSON whitespace (space, tab, LF,
//     CR); anything left is `json: trailing data`.
//   - a string is checked in full BEFORE anything is written (__jp_str_check):
//     an unterminated string, a raw control character, an unknown escape, a
//     `\u` without four hex digits, a surrogate that is not a high+low pair
//     and a noncharacter are each an err; nothing is ever dropped (the parser
//     used to delete a lone surrogate and an unknown escape, so `ad\ud800min`
//     decoded to `admin`). A valid high+low pair joins into one astral
//     codepoint (#651).
//   - an object key must be a string, a repeated key is an err at the
//     repeat's opening quote, a `,` before `]`/`}` is a trailing comma, and a
//     missing `:` or separator is named.
//   - a number token (the run of `0-9 + - . e E`) must match
//     `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?` whole; a fraction
//     or exponent makes a Float, else Int; an out-of-range Int passes
//     int.parse's error message through.
//   - nesting is bounded (R-L0-47, R-json-04, #4020): an array or object
//     opened inside 1000 others is `json: nesting deeper than 1000`, checked
//     where the oracle checks it. `depth` counts the containers around the
//     value being parsed.
fn json_parse(text: String) -> Result[Value, String] = {
  let h = prim.handle(text)
  let blen = prim.load32(h + 4)
  match __jp_value(h + 12, blen, 0, 0) {
    ok(r) => {
      let (v, p) = r
      let q = __jp_ws(h + 12, blen, p)
      if q < blen then err(__jp_at("json: trailing data", h + 12, q))
      else ok(v)
    },
    err(e) => err(e),
  }
}

// ── low-level helpers (byte floor) ──
// Decode the UTF-8 codepoint at base+p → (codepoint, byte length).
fn __jp_cp(base: Int, p: Int) -> (Int, Int) = {
  let b0 = prim.load8(base + p)
  if b0 < 128 then (b0, 1)
  else if b0 < 224 then ((b0 - 192) * 64 + (prim.load8(base + p + 1) - 128), 2)
  else if b0 < 240 then ((b0 - 224) * 4096 + (prim.load8(base + p + 1) - 128) * 64 + (prim.load8(base + p + 2) - 128), 3) else ((b0 - 240) * 262144 + (prim.load8(base + p + 1) - 128) * 4096 + (prim.load8(base + p + 2) - 128) * 64 + (prim.load8(base + p + 3) - 128), 4)
}

// The CHAR index of byte offset `p` (count non-continuation bytes) — only for
// the oracle's `at pos N` error message, linear once per error.
fn __jp_charpos(base: Int, p: Int, i: Int, acc: Int) -> Int = if i >= p then acc
else {
  let b = prim.load8(base + i)
  let is_cont = b >= 128 and b < 192
  __jp_charpos(base, p, i + 1, if is_cont then acc else acc + 1)
}

// A fresh String copy of bytes [from, to) — for number slices.
fn __jp_copy_bytes(src: Int, dst: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store8(dst + i, prim.load8(src + i))
  __jp_copy_bytes(src, dst, n, i + 1)
}

fn __jp_substr(base: Int, from: Int, to: Int) -> String = {
  let n = if to > from then to - from else 0
  let s = prim.alloc_str(n)
  let _c = __jp_copy_bytes(base + from, prim.handle(s) + 12, n, 0)
  s
}

// "<what> at pos N" with N the CHAR index of byte offset p.
fn __jp_at(what: String, base: Int, p: Int) -> String = what + " at pos " + int.to_string(__jp_charpos(base, p, 0, 0))

// JSON whitespace only: space, tab, LF, CR (RFC 8259 §2).
fn __jp_ws(base: Int, len: Int, p: Int) -> Int = if p >= len then p
else {
  let b = prim.load8(base + p)
  if b == 32 or b == 9 or b == 10 or b == 13 then __jp_ws(base, len, p + 1)
  else p
}

// I-JSON §2.1: U+FDD0..U+FDEF and every U+xFFFE / U+xFFFF.
fn __jp_nonchar(cp: Int) -> Bool = (cp >= 64976 and cp <= 65007) or cp % 65536 >= 65534

// ── the value grammar ──
fn __jp_value(base: Int, len: Int, p: Int, depth: Int) -> Result[(Value, Int), String] = {
  let q = __jp_ws(base, len, p)
  if q >= len then err("unexpected end of input")
  else {
    let b = prim.load8(base + q)
    if b == 34 then match __jp_string(base, len, q) {
      ok(r) => {
        let (s, np) = r
        ok((value.string(s), np))
      },
      err(e) => err(e),
    } else if (b == 123 or b == 91) and depth >= 1000 then err("json: nesting deeper than 1000")
    else if b == 123 then {
      let q2 = __jp_ws(base, len, q + 1)
      if q2 < len and prim.load8(base + q2) == 125 then {
        let empty: List[(String, Value)] = []
        ok((value.object(empty), q2 + 1))
      } else {
        let acc0: List[(String, Value)] = []
        __jp_object(base, len, q2, acc0, depth + 1)
      }
    } else if b == 91 then {
      let q2 = __jp_ws(base, len, q + 1)
      if q2 < len and prim.load8(base + q2) == 93 then {
        let empty: List[Value] = []
        ok((value.array(empty), q2 + 1))
      } else {
        let acc0: List[Value] = []
        __jp_array(base, len, q2, acc0, depth + 1)
      }
    } else if b == 116 or b == 102 then __jp_bool(base, len, q)
    else if b == 110 then __jp_null(base, len, q)
    else if b == 45 or (b >= 48 and b <= 57) then __jp_number(base, len, q)
    else {
      let (cp, _l) = __jp_cp(base, q)
      let cpos = __jp_charpos(base, q, 0, 0)
      err("unexpected char '" + (string.from_codepoint(cp) ?? "") + "' at pos " + int.to_string(cpos))
    }
  }
}

// ── strings ──
// Two passes over THIS string's own bytes: __jp_str_check validates the whole
// string and measures an upper bound on the decoded length, then the buffer is
// allocated exactly that and __jp_str_fill writes bytes through a cursor and
// patches the String's len header — the same write-cursor + len-patch
// discipline as list.filter. p is at the opening `"`.
//
// The bound must come from the string's own span, NOT from `len - p - 1` (the
// rest of the document): sizing by the document remainder makes parsing cost
// O(strings x document length), which timed out on real glTF (#939). The fill
// only ever runs on a string the check accepted, so it meets no bad escape and
// advances exactly as the check did.
fn __jp_string(base: Int, len: Int, p: Int) -> Result[(String, Int), String] = {
  let span = __jp_str_check(base, len, p + 1, 0, p)
  if span < 0 then err(__jp_str_err(base, 0 - 1 - span))
  else {
    let buf = prim.alloc_str(span)
    let dh = prim.handle(buf) + 12
    let (np, outn) = __jp_str_fill(base, len, p + 1, dh, 0)
    prim.store32(prim.handle(buf) + 4, outn)
    ok((buf, np))
  }
}

// A refusal travels as a negative Int: 0 - 1 - (position * 8 + kind).
fn __jp_str_fail(pos: Int, kind: Int) -> Int = 0 - 1 - (pos * 8 + kind)

fn __jp_str_err(base: Int, code: Int) -> String = {
  let kind = code % 8
  let what = match kind {
    0 => "json: unterminated string",
    1 => "json: control character in string",
    2 => "json: unknown escape",
    3 => "json: invalid unicode escape",
    4 => "json: lone surrogate",
    _ => "json: noncharacter",
  }
  __jp_at(what, base, code / 8)
}

// The span (an upper bound on the bytes __jp_str_fill writes) of the string
// whose opening quote is at `open`, or a refusal (__jp_str_fail). Per branch:
// a simple escape consumes 2 and writes 1; a \uXXXX consumes 6 and writes at
// most 3; a surrogate pair consumes 12 and writes 4; a plain byte is 1 for 1.
fn __jp_str_check(base: Int, len: Int, p: Int, n: Int, open: Int) -> Int =
  if p >= len then __jp_str_fail(open, 0)
  else {
    let b = prim.load8(base + p)
    if b == 34 then n
    else if b < 32 then __jp_str_fail(p, 1)
    else if b == 92 then {
      if p + 1 >= len then __jp_str_fail(open, 0)
      else {
        let e = prim.load8(base + p + 1)
        if e == 34 or e == 92 or e == 47 or e == 98 or e == 102 or e == 110 or e == 114 or e == 116 then __jp_str_check(
          base,
          len,
          p + 2,
          n + 1,
          open,
        )
        else if e == 117 then __jp_str_check_u(base, len, p, n, open)
        else __jp_str_fail(p, 2)
      }
    } else if b >= 239 then {
      let (cp, l) = __jp_cp(base, p)
      if __jp_nonchar(cp) then __jp_str_fail(p, 5)
      else __jp_str_check(base, len, p + l, n + l, open)
    } else __jp_str_check(base, len, p + 1, n + 1, open)
  }

// \uXXXX at p (p = the backslash).
fn __jp_str_check_u(base: Int, len: Int, p: Int, n: Int, open: Int) -> Int = {
  let unit = __jp_hex4(base, len, p + 2)
  if unit < 0 then __jp_str_fail(p, 3)
  else if unit >= 55296 and unit <= 56319 then {
    let lo = if p + 7 < len and prim.load8(base + p + 6) == 92 and prim.load8(base + p + 7) == 117 then __jp_hex4(
      base,
      len,
      p + 8,
    )
    else 0 - 1
    if lo >= 56320 and lo <= 57343 then {
      let cp = 65536 + (unit - 55296) * 1024 + (lo - 56320)
      if __jp_nonchar(cp) then __jp_str_fail(p, 5)
      else __jp_str_check(base, len, p + 12, n + 4, open)
    } else __jp_str_fail(p, 4)
  } else if unit >= 56320 and unit <= 57343 then __jp_str_fail(p, 4)
  else if __jp_nonchar(unit) then __jp_str_fail(p, 5)
  else __jp_str_check(base, len, p + 6, n + 3, open)
}

// Returns (position after the closing quote, bytes written). Runs only on a
// string __jp_str_check accepted.
fn __jp_str_fill(base: Int, len: Int, p: Int, dh: Int, o: Int) -> (Int, Int) =
  if p >= len then (p, o)
  else {
    let b = prim.load8(base + p)
    if b == 34 then (p + 1, o)
    else if b == 92 then {
      let e = prim.load8(base + p + 1)
      if e == 117 then __jp_str_u(base, len, p, dh, o)
      else {
        prim.store8(dh + o, __jp_simple_escape(e))
        __jp_str_fill(base, len, p + 2, dh, o + 1)
      }
    } else {
      prim.store8(dh + o, b)
      __jp_str_fill(base, len, p + 1, dh, o + 1)
    }
  }

// The byte a checked one-char escape stands for.
fn __jp_simple_escape(e: Int) -> Int = match e {
  110 => 10,
  116 => 9,
  114 => 13,
  98 => 8,
  102 => 12,
  _ => e,
}

// A checked \uXXXX at p: a high unit is followed by its low unit and joins
// into one astral codepoint; anything else is one BMP codepoint.
fn __jp_str_u(base: Int, len: Int, p: Int, dh: Int, o: Int) -> (Int, Int) = {
  let unit = __jp_hex4(base, len, p + 2)
  if unit >= 55296 and unit <= 56319 then {
    let lo = __jp_hex4(base, len, p + 8)
    let w = __jp_utf8_write(dh, o, 65536 + (unit - 55296) * 1024 + (lo - 56320))
    __jp_str_fill(base, len, p + 12, dh, o + w)
  } else {
    let w = __jp_utf8_write(dh, o, unit)
    __jp_str_fill(base, len, p + 6, dh, o + w)
  }
}

// Encode codepoint `cp` as UTF-8 at dh+o; returns the byte count written.
fn __jp_utf8_write(dh: Int, o: Int, cp: Int) -> Int = if cp < 128 then {
  prim.store8(dh + o, cp)
  1
} else if cp < 2048 then {
  prim.store8(dh + o, 192 + cp / 64)
  prim.store8(dh + o + 1, 128 + cp % 64)
  2
} else if cp < 65536 then {
  prim.store8(dh + o, 224 + cp / 4096)
  prim.store8(dh + o + 1, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 2, 128 + cp % 64)
  3
} else {
  prim.store8(dh + o, 240 + cp / 262144)
  prim.store8(dh + o + 1, 128 + (cp / 4096) % 64)
  prim.store8(dh + o + 2, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 3, 128 + cp % 64)
  4
}

// Exactly 4 ASCII hex digits at base+p → the code unit; anything else → -1.
// (from_str_radix rejects whitespace/`0x`, so this is hand-rolled.)
fn __jp_hex_digit(b: Int) -> Int = if b >= 48 and b <= 57 then b - 48
else if b >= 97 and b <= 102 then b - 87
else if b >= 65 and b <= 70 then b - 55 else 0 - 1

// The bound is `p > len - 4`, not `p + 4 > len`: the additive form WRAPS at a
// near-`i64::MAX` position and admits an out-of-range read. `len` is a
// non-negative i32-ranged length, so `len - 4` cannot overflow. A negative `p`
// is impossible here (the scanner only advances), but the subtractive form is
// correct for it too.
fn __jp_hex4(base: Int, len: Int, p: Int) -> Int = if p > len - 4 then 0 - 1
else {
  let a = __jp_hex_digit(prim.load8(base + p))
  let b = __jp_hex_digit(prim.load8(base + p + 1))
  let c = __jp_hex_digit(prim.load8(base + p + 2))
  let d = __jp_hex_digit(prim.load8(base + p + 3))
  if a < 0 or b < 0 or c < 0 or d < 0 then 0 - 1 else ((a * 16 + b) * 16 + c) * 16 + d
}

// ── numbers ──
fn __jp_digits(base: Int, len: Int, p: Int) -> Int =
  if p < len and prim.load8(base + p) >= 48 and prim.load8(base + p) <= 57 then __jp_digits(
    base,
    len,
    p + 1,
  )
  else p

// The number token: the run of `0-9 + - . e E` from p.
fn __jp_numrun(base: Int, len: Int, p: Int) -> Int = if p >= len then p
else {
  let b = prim.load8(base + p)
  if (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46 or b == 101 or b == 69 then __jp_numrun(
    base,
    len,
    p + 1,
  )
  else p
}

// End of the RFC 8259 number that starts at p and ends by `end`, or -1 when
// the token is not one (the run must be matched whole).
fn __jp_num_end(base: Int, end: Int, p: Int) -> Int = {
  let p1 = if prim.load8(base + p) == 45 then p + 1 else p
  let p2 = __jp_digits(base, end, p1)
  if p2 == p1 then 0 - 1
  else if prim.load8(base + p1) == 48 and p2 > p1 + 1 then 0 - 1
  else {
    let has_frac = p2 < end and prim.load8(base + p2) == 46
    let p3 = if has_frac then __jp_digits(base, end, p2 + 1)
    else p2
    if has_frac and p3 == p2 + 1 then 0 - 1
    else {
      let eb = if p3 < end then prim.load8(base + p3) else 0
      if eb == 101 or eb == 69 then {
        let sb = if p3 + 1 < end then prim.load8(base + p3 + 1) else 0
        let ps = if sb == 43 or sb == 45 then p3 + 2 else p3 + 1
        let p4 = __jp_digits(base, end, ps)
        if p4 == ps then 0 - 1 else p4
      } else p3
    }
  }
}

fn __jp_number(base: Int, len: Int, p: Int) -> Result[(Value, Int), String] = {
  let end = __jp_numrun(base, len, p)
  let q = __jp_num_end(base, end, p)
  if q != end then err(__jp_at("json: invalid number", base, p))
  else {
    let s = __jp_substr(base, p, end)
    let is_float = string.contains(s, ".") or string.contains(s, "e") or string.contains(s, "E")
    if is_float then match float.parse(s) {
      ok(f) => ok((value.float(f), end)),
      err(m) => err(m),
    } else match int.parse(s) {
      ok(n) => ok((value.int(n), end)),
      err(m) => err(m),
    }
  }
}

// ── literals ──
fn __jp_lit_at(base: Int, len: Int, p: Int, b0: Int, b1: Int, b2: Int, b3: Int) -> Bool = p + 4 <= len and prim.load8(base + p) == b0 and prim.load8(base + p + 1) == b1 and prim.load8(base + p + 2) == b2 and prim.load8(base + p + 3) == b3

fn __jp_bool(base: Int, len: Int, p: Int) -> Result[(Value, Int), String] =
  if __jp_lit_at(
    base,
    len,
    p,
    116,
    114,
    117,
    101,
  ) then ok((value.bool(true), p + 4))
  else if __jp_lit_at(base, len, p, 102, 97, 108, 115) and p + 5 <= len and prim.load8(base + p + 4) == 101 then ok((value.bool(false), p + 5)) else err("expected bool")

fn __jp_null(base: Int, len: Int, p: Int) -> Result[(Value, Int), String] =
  if __jp_lit_at(
    base,
    len,
    p,
    110,
    117,
    108,
    108,
  ) then ok((value.null(), p + 4)) else err("expected null")

// ── collections ──
// p is at the first element (post-`[`, post-ws, non-`]`).
//
// A LOOP with an in-place `list.push` accumulator, deliberately breaking the
// stdlib's prefer-recursion idiom (#939) — the recursive form had two costs
// that both scale with element COUNT, and real documents put six digits there:
//   1. `acc + [v]` copies the whole accumulator per element — O(n^2) total.
//      A 103 KiB glTF chunk that parsed in 5 ms took >11 minutes.
//   2. One real call frame per element (the self-call sits under a `match` arm,
//      outside the emitted return_call shapes), so ~8k elements overflow the
//      wasm call stack — a trap, after the quadratic slowdown.
// The loop is O(1) amortized per element and O(depth) stack (nesting only).
fn __jp_array(base: Int, len: Int, p0: Int, acc0: List[Value], depth: Int) -> Result[(Value, Int), String] = {
  var p = p0
  var acc = acc0
  var endp = 0 - 1
  var error = ""
  while endp < 0 and string.len(error) == 0 {
    match __jp_value(base, len, p, depth) {
      ok(r) => {
        let (v, np) = r
        list.push(acc, v)
        let q = __jp_ws(base, len, np)
        if q >= len then {
          error = "unexpected end of input"
        } else {
          let b = prim.load8(base + q)
          if b == 93 then {
            endp = q + 1
          } else if b == 44 then {
            let n = __jp_ws(base, len, q + 1)
            if n < len and prim.load8(base + n) == 93 then {
              error = __jp_at("json: trailing comma", base, q)
            } else {
              p = n
            }
          } else {
            error = __jp_at("json: expected ',' or ']'", base, q)
          }
        }
      },
      err(e) => {
        error = e
      },
    }
  }
  if string.len(error) > 0 then err(error) else ok((value.array(acc), endp))
}

// p is at the first key (post-`{`, post-ws, non-`}`); every later round starts
// past a `,` and its whitespace. A key must be a string, and a key the object
// already holds is refused at the repeat's opening quote (I-JSON §2.3) — the
// keys read so far sit in a map, so the check is O(1) per key on wide objects.
// The same loop shape as `__jp_array`, for the same two reasons (#939).
fn __jp_object(base: Int, len: Int, p0: Int, acc0: List[(String, Value)], depth: Int) -> Result[(Value, Int), String] = {
  var p = p0
  var acc = acc0
  var seen: Map[String, Int] = map.new()
  var endp = 0 - 1
  var error = ""
  while endp < 0 and string.len(error) == 0 {
    if p >= len then {
      error = "unexpected end of input"
    } else if prim.load8(base + p) != 34 then {
      error = __jp_at("json: unquoted key", base, p)
    } else {
      match __jp_string(base, len, p) {
        err(e) => {
          error = e
        },
        ok(kr) => {
          let (k, kp) = kr
          if map.contains(seen, k) then {
            error = __jp_at("json: duplicate key", base, p)
          } else {
            map.insert(seen, k, 0)
            let c = __jp_ws(base, len, kp)
            if c >= len then {
              error = "unexpected end of input"
            } else if prim.load8(base + c) != 58 then {
              error = __jp_at("json: expected ':'", base, c)
            } else {
              match __jp_value(base, len, c + 1, depth) {
                ok(r) => {
                  let (v, np) = r
                  list.push(acc, (k, v))
                  let q = __jp_ws(base, len, np)
                  if q >= len then {
                    error = "unexpected end of input"
                  } else {
                    let b = prim.load8(base + q)
                    if b == 125 then {
                      endp = q + 1
                    } else if b == 44 then {
                      let n = __jp_ws(base, len, q + 1)
                      if n < len and prim.load8(base + n) == 125 then {
                        error = __jp_at("json: trailing comma", base, q)
                      } else {
                        p = n
                      }
                    } else {
                      error = __jp_at("json: expected ',' or '}'", base, q)
                    }
                  }
                },
                err(e) => {
                  error = e
                },
              }
            }
          }
        },
      }
    }
  }
  if string.len(error) > 0 then err(error) else ok((value.object(acc), endp))
}
