// json_parse — SELF-HOSTED `json.parse(text)`: a pure-Almide recursive-descent
// NORMATIVE SPEC: ALS-T3 (docs/specs/als/text-and-numbers.md §T3) — conformance is judged against that section's
// rules and its pinned fixture, NOT against any other implementation (F1: no oracle circularity).
// JSON parser over the prim byte floor, clause-for-clause the grammar and the
// err texts of the native oracle (`runtime/rs/src/json.rs::almide_rt_json_parse`),
// so the v1 trust spine lowers it through the PROVEN pipeline with NO
// hand-written wasm runtime to drift.
//
// Positions are BYTE offsets internally (prim.load8 — O(1)). The oracle's
// positions are CHAR indices, so an error message converts its byte offset
// with one linear count at ERROR time only. The grammar is RFC 8259 plus
// I-JSON (RFC 7493), STRICT (C-087, C-400, C-401, #4111 / #4112), with one err
// text per case, the oracle's:
//   - the whole text is one value between JSON whitespace (space, tab, LF,
//     CR); anything left is `json: trailing data`.
//   - a string is checked in full BEFORE anything is written (__jp_str_scan):
//     an unterminated string, a raw control character, an unknown escape, a
//     `\u` without four hex digits, a surrogate that is not a high+low pair
//     and a noncharacter are each an err; nothing is ever dropped. A valid
//     high+low pair joins into one astral codepoint (#651).
//   - an object key must be a string, a repeated key is an err at the
//     repeat's opening quote, a `,` before `]`/`}` is a trailing comma, and a
//     missing `:` or separator is named.
//   - a number token (the run of `0-9 + - . e E`) must match
//     `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?` whole; a fraction
//     or exponent makes a Float, else Int; an out-of-range Int passes
//     int.parse's error message through, and a Float float.parse's.
//   - nesting is bounded (R-L0-47, R-json-04, #4020): an array or object
//     opened inside 1000 others is `json: nesting deeper than 1000`, checked
//     where the oracle checks it. `depth` counts the containers around the
//     value being parsed.
// The bound is crates/almide-base/src/json_limits.rs's JSON_MAX_DEPTH; this
// is its self-hosted reading (tests/json_depth_limit_test.rs pins the two),
// shared with value.set_path's bound (#4209, stdlib/json_path.almd).
//
// COST (#4613): a value costs its own Value and nothing else. Every reader
// returns what it read and leaves the position after it in ONE 8-byte cell
// that the whole parse shares — no `Result[(Value, Int)]` per value, no
// tuple per string. A refusal is written into the same cell as a negative
// code (position and kind, __jp_code) and the readers after it do nothing,
// so the first refusal is the one reported; its text is spelled once, at
// the top (__jp_message). A number is read in place, a string without an
// escape is copied once, and a repeated key is found by comparing the keys
// already read (an index takes over from 16 keys on, as native's does).
fn __json_max_depth() -> Int = 1000

// The err text, spelled out (a runtime int.to_string costs every JSON
// program its formatting code); the test pins it to json_depth_error().
fn __json_depth_error() -> String = "json: nesting deeper than 1000"

fn json_parse(text: String) -> Result[Value, String] = {
  let h = prim.handle(text)
  let blen = prim.load32(h + 4)
  let cell = prim.alloc_bytes(8)
  let v = __jp_value(h + 12, blen, 0, 0, prim.handle(cell) + 12)
  let p = prim.load64(prim.handle(cell) + 12)
  if p < 0 then err(__jp_message(h + 12, blen, 0 - 1 - p))
  else {
    let q = __jp_ws(h + 12, blen, p)
    if q < blen then err(__jp_at("json: trailing data", h + 12, q)) else ok(v)
  }
}

// ── the position cell ──
// A reader takes its start position as an argument and leaves the position
// after what it read in the cell at `c`; a refusal leaves a negative code.
fn __jp_pos(c: Int) -> Int = prim.load64(c)

fn __jp_seek(c: Int, p: Int) -> Unit = prim.store64(c, p)

// A refusal: `kind` (__jp_message) at byte offset `p`, packed into one
// negative Int so a refusal and a position share the cell.
fn __jp_code(p: Int, kind: Int) -> Int = 0 - 1 - (p * 32 + kind)

// Refuse at `p` with `kind`; the Value is a stand-in nothing reads.
fn __jp_refuse(c: Int, p: Int, kind: Int) -> Value = {
  __jp_seek(c, __jp_code(p, kind))
  value.null()
}

// ── refusal texts, spelled at the top only ──
fn __jp_message(base: Int, len: Int, code: Int) -> String = {
  let p = code / 32
  match code % 32 {
    0 => __jp_at("json: unterminated string", base, p),
    1 => __jp_at("json: control character in string", base, p),
    2 => __jp_at("json: unknown escape", base, p),
    3 => __jp_at("json: invalid unicode escape", base, p),
    4 => __jp_at("json: lone surrogate", base, p),
    5 => __jp_at("json: noncharacter", base, p),
    6 => "unexpected end of input",
    7 => __jp_at("json: trailing comma", base, p),
    8 => __jp_at("json: expected ',' or ']'", base, p),
    9 => __jp_at("json: expected ',' or '}'", base, p),
    10 => __jp_at("json: unquoted key", base, p),
    11 => __jp_at("json: duplicate key", base, p),
    12 => __jp_at("json: expected ':'", base, p),
    13 => __jp_at("json: invalid number", base, p),
    14 => __jp_number_error(base, len, p),
    15 => "expected bool",
    16 => "expected null",
    17 => __json_depth_error(),
    _ => {
      let cp = __jp_cp(base, p)
      "unexpected char '" + string.__err_text(string.from_codepoint(cp) ?? "") + "' at pos " + int.to_string(__jp_charpos(base, p, 0, 0))
    },
  }
}

// A number the in-place reader handed over (too many digits for its exact
// range) that int.parse / float.parse then refused: their own err text.
fn __jp_number_error(base: Int, len: Int, p: Int) -> String = {
  let s = __jp_substr(base, p, __jp_numrun(base, len, p))
  let lead = if prim.load8(base + p) == 45 then p + 1 else p
  if __jp_digits(base, len, lead) < __jp_numrun(base, len, p) then match float.parse(s) {
    ok(_) => "",
    err(m) => m,
  } else match int.parse(s) {
    ok(_) => "",
    err(m) => m,
  }
}

// ── low-level helpers (byte floor) ──
// The UTF-8 codepoint whose lead byte is at base+p.
fn __jp_cp(base: Int, p: Int) -> Int = {
  let b0 = prim.load8(base + p)
  if b0 < 128 then b0
  else if b0 < 224 then (b0 - 192) * 64 + (prim.load8(base + p + 1) - 128)
  else if b0 < 240 then (b0 - 224) * 4096 + (prim.load8(base + p + 1) - 128) * 64 + (prim.load8(base + p + 2) - 128) else (b0 - 240) * 262144 + (prim.load8(base + p + 1) - 128) * 4096 + (prim.load8(base + p + 2) - 128) * 64 + (prim.load8(base + p + 3) - 128)
}

// The CHAR index of byte offset `p` (count non-continuation bytes) — only for
// the oracle's `at pos N` error message, linear once per error.
fn __jp_charpos(base: Int, p: Int, i: Int, acc: Int) -> Int = if i >= p then acc
else {
  let b = prim.load8(base + i)
  let is_cont = b >= 128 and b < 192
  __jp_charpos(base, p, i + 1, if is_cont then acc else acc + 1)
}

// Copy n bytes from src to dst, eight at a time while eight remain.
fn __jp_copy(src: Int, dst: Int, n: Int, i: Int) -> Int = if i + 8 <= n then {
  prim.store64(dst + i, prim.load64(src + i + 1))
  __jp_copy(src, dst, n, i + 8)
} else if i < n then {
  prim.store8(dst + i, prim.load8(src + i))
  __jp_copy(src, dst, n, i + 1)
} else 0

// A fresh String copy of bytes [from, to) — for the err-time number texts.
fn __jp_substr(base: Int, from: Int, to: Int) -> String = {
  let n = if to > from then to - from else 0
  let s = prim.alloc_str(n)
  let _c = __jp_copy(base + from, prim.handle(s) + 12, n, 0)
  s
}

// "<what> at pos N" with N the CHAR index of byte offset p.
fn __jp_at(what: String, base: Int, p: Int) -> String = what + " at pos " + int.to_string(__jp_charpos(base, p, 0, 0))

// JSON whitespace only: space, tab, LF, CR (RFC 8259 §2).
fn __jp_ws(base: Int, len: Int, p: Int) -> Int = if p >= len then p
else {
  let b = prim.load8(base + p)
  if b == 32 or b == 9 or b == 10 or b == 13 then __jp_ws(base, len, p + 1)
  else p
}

// I-JSON §2.1: U+FDD0..U+FDEF and every U+xFFFE / U+xFFFF.
fn __jp_nonchar(cp: Int) -> Bool = (cp >= 64976 and cp <= 65007) or cp % 65536 >= 65534

// ── the value grammar ──
// The value at p (whitespace first). A negative p is a refusal already in
// the cell: nothing is read.
fn __jp_value(base: Int, len: Int, p: Int, depth: Int, c: Int) -> Value = if p < 0 then value.null()
else {
  let q = __jp_ws(base, len, p)
  if q >= len then __jp_refuse(c, q, 6)
  else {
    let b = prim.load8(base + q)
    if b == 34 then value.string(__jp_string(base, len, q, c))
    else if (b == 123 or b == 91) and depth >= __json_max_depth() then __jp_refuse(c, q, 17)
    else if b == 123 then __jp_object(base, len, __jp_ws(base, len, q + 1), depth + 1, c)
    else if b == 91 then __jp_array(base, len, __jp_ws(base, len, q + 1), depth + 1, c)
    else if b == 116 or b == 102 then __jp_bool(base, len, q, c)
    else if b == 110 then __jp_null(base, len, q, c)
    else if b == 45 or (b >= 48 and b <= 57) then __jp_number(base, len, q, c)
    else __jp_refuse(c, q, 18)
  }
}

// ── strings ──
// Two passes over THIS string's own bytes: __jp_str_scan validates the
// whole string and finds its closing quote, then the buffer is allocated at
// the string's own span (an upper bound: an escape only ever shrinks) and
// filled — one copy when no escape was met, else __jp_str_fill decodes
// through a cursor and patches the String's len header. p is at the opening
// `"`; the cell is left past the closing one.
//
// The bound must come from the string's own span, NOT from the rest of the
// document: sizing by the document remainder makes parsing cost
// O(strings x document length), which timed out on real glTF (#939).
fn __jp_string(base: Int, len: Int, p: Int, c: Int) -> String = {
  let r = __jp_str_scan(base, len, p + 1, p, 0)
  if r < 0 then {
    __jp_seek(c, r)
    ""
  } else {
    let e = r / 2
    let n = e - p - 1
    let buf = prim.alloc_str(n)
    let dh = prim.handle(buf) + 12
    let _w = if r % 2 == 0 then __jp_copy(base + p + 1, dh, n, 0)
    else {
      prim.store32(prim.handle(buf) + 4, __jp_str_fill(base, p + 1, e, dh, 0))
      0
    }
    __jp_seek(c, e + 1)
    buf
  }
}

// From p inside the string opened at `open`: the closing quote's offset
// times two, plus one when an escape was met (`esc`), or a refusal code.
fn __jp_str_scan(base: Int, len: Int, p: Int, open: Int, esc: Int) -> Int =
  if p >= len then __jp_code(open, 0)
  else {
    let b = prim.load8(base + p)
    if b == 34 then p * 2 + esc
    else if b < 32 then __jp_code(p, 1)
    else if b == 92 then {
      if p + 1 >= len then __jp_code(open, 0)
      else {
        let x = prim.load8(base + p + 1)
        if x == 34 or x == 92 or x == 47 or x == 98 or x == 102 or x == 110 or x == 114 or x == 116 then __jp_str_scan(
          base,
          len,
          p + 2,
          open,
          1,
        )
        else if x == 117 then __jp_str_scan_u(base, len, p, open)
        else __jp_code(p, 2)
      }
    } else if b >= 239 then {
      if __jp_nonchar(__jp_cp(base, p)) then __jp_code(p, 5)
      else __jp_str_scan(base, len, p + (if b < 240 then 3 else 4), open, esc)
    } else __jp_str_scan(base, len, p + 1, open, esc)
  }

// \uXXXX at p (p = the backslash).
fn __jp_str_scan_u(base: Int, len: Int, p: Int, open: Int) -> Int = {
  let unit = __jp_hex4(base, len, p + 2)
  if unit < 0 then __jp_code(p, 3)
  else if unit >= 55296 and unit <= 56319 then {
    let lo = if p + 7 < len and prim.load8(base + p + 6) == 92 and prim.load8(base + p + 7) == 117 then __jp_hex4(
      base,
      len,
      p + 8,
    )
    else 0 - 1
    if lo >= 56320 and lo <= 57343 then {
      let cp = 65536 + (unit - 55296) * 1024 + (lo - 56320)
      if __jp_nonchar(cp) then __jp_code(p, 5)
      else __jp_str_scan(base, len, p + 12, open, 1)
    } else __jp_code(p, 4)
  } else if unit >= 56320 and unit <= 57343 then __jp_code(p, 4)
  else if __jp_nonchar(unit) then __jp_code(p, 5)
  else __jp_str_scan(base, len, p + 6, open, 1)
}

// Decode [p, e) of a string __jp_str_scan accepted into dh; returns the
// bytes written.
fn __jp_str_fill(base: Int, p: Int, e: Int, dh: Int, o: Int) -> Int = if p >= e then o
else {
  let b = prim.load8(base + p)
  if b == 92 then {
    let x = prim.load8(base + p + 1)
    if x == 117 then __jp_str_u(base, p, e, dh, o)
    else {
      prim.store8(dh + o, __jp_simple_escape(x))
      __jp_str_fill(base, p + 2, e, dh, o + 1)
    }
  } else {
    prim.store8(dh + o, b)
    __jp_str_fill(base, p + 1, e, dh, o + 1)
  }
}

// The byte a checked one-char escape stands for.
fn __jp_simple_escape(e: Int) -> Int = match e {
  110 => 10,
  116 => 9,
  114 => 13,
  98 => 8,
  102 => 12,
  _ => e,
}

// A checked \uXXXX at p: a high unit is followed by its low unit and joins
// into one astral codepoint; anything else is one BMP codepoint.
fn __jp_str_u(base: Int, p: Int, e: Int, dh: Int, o: Int) -> Int = {
  let unit = __jp_hex4(base, e, p + 2)
  if unit >= 55296 and unit <= 56319 then {
    let w = __jp_utf8_write(dh, o, 65536 + (unit - 55296) * 1024 + (__jp_hex4(base, e, p + 8) - 56320))
    __jp_str_fill(base, p + 12, e, dh, o + w)
  } else {
    let w = __jp_utf8_write(dh, o, unit)
    __jp_str_fill(base, p + 6, e, dh, o + w)
  }
}

// Encode codepoint `cp` as UTF-8 at dh+o; returns the byte count written.
fn __jp_utf8_write(dh: Int, o: Int, cp: Int) -> Int = if cp < 128 then {
  prim.store8(dh + o, cp)
  1
} else if cp < 2048 then {
  prim.store8(dh + o, 192 + cp / 64)
  prim.store8(dh + o + 1, 128 + cp % 64)
  2
} else if cp < 65536 then {
  prim.store8(dh + o, 224 + cp / 4096)
  prim.store8(dh + o + 1, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 2, 128 + cp % 64)
  3
} else {
  prim.store8(dh + o, 240 + cp / 262144)
  prim.store8(dh + o + 1, 128 + (cp / 4096) % 64)
  prim.store8(dh + o + 2, 128 + (cp / 64) % 64)
  prim.store8(dh + o + 3, 128 + cp % 64)
  4
}

// Exactly 4 ASCII hex digits at base+p → the code unit; anything else → -1.
// (from_str_radix rejects whitespace/`0x`, so this is hand-rolled.)
fn __jp_hex_digit(b: Int) -> Int = if b >= 48 and b <= 57 then b - 48
else if b >= 97 and b <= 102 then b - 87
else if b >= 65 and b <= 70 then b - 55 else 0 - 1

// The bound is `p > len - 4`, not `p + 4 > len`: the additive form WRAPS at a
// near-`i64::MAX` position and admits an out-of-range read. `len` is a
// non-negative i32-ranged length, so `len - 4` cannot overflow. A negative `p`
// is impossible here (the scanner only advances), but the subtractive form is
// correct for it too.
fn __jp_hex4(base: Int, len: Int, p: Int) -> Int = if p > len - 4 then 0 - 1
else {
  let a = __jp_hex_digit(prim.load8(base + p))
  let b = __jp_hex_digit(prim.load8(base + p + 1))
  let c = __jp_hex_digit(prim.load8(base + p + 2))
  let d = __jp_hex_digit(prim.load8(base + p + 3))
  if a < 0 or b < 0 or c < 0 or d < 0 then 0 - 1 else ((a * 16 + b) * 16 + c) * 16 + d
}

// ── numbers ──
fn __jp_digits(base: Int, len: Int, p: Int) -> Int =
  if p < len and prim.load8(base + p) >= 48 and prim.load8(base + p) <= 57 then __jp_digits(
    base,
    len,
    p + 1,
  )
  else p

// The number token: the run of `0-9 + - . e E` from p.
fn __jp_numrun(base: Int, len: Int, p: Int) -> Int = if p >= len then p
else {
  let b = prim.load8(base + p)
  if (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46 or b == 101 or b == 69 then __jp_numrun(
    base,
    len,
    p + 1,
  )
  else p
}

// End of the RFC 8259 number that starts at p and ends by `end`, or -1 when
// the token is not one (the run must be matched whole).
fn __jp_num_end(base: Int, end: Int, p: Int) -> Int = {
  let p1 = if prim.load8(base + p) == 45 then p + 1 else p
  let p2 = __jp_digits(base, end, p1)
  if p2 == p1 then 0 - 1
  else if prim.load8(base + p1) == 48 and p2 > p1 + 1 then 0 - 1
  else {
    let has_frac = p2 < end and prim.load8(base + p2) == 46
    let p3 = if has_frac then __jp_digits(base, end, p2 + 1)
    else p2
    if has_frac and p3 == p2 + 1 then 0 - 1
    else {
      let eb = if p3 < end then prim.load8(base + p3) else 0
      if eb == 101 or eb == 69 then {
        let sb = if p3 + 1 < end then prim.load8(base + p3 + 1) else 0
        let ps = if sb == 43 or sb == 45 then p3 + 2 else p3 + 1
        let p4 = __jp_digits(base, end, ps)
        if p4 == ps then 0 - 1 else p4
      } else p3
    }
  }
}

// The decimal digits in [p, stop) accumulated onto m, skipping one `.`.
fn __jp_mantissa(base: Int, p: Int, stop: Int, m: Int) -> Int = if p >= stop then m
else {
  let b = prim.load8(base + p)
  if b == 46 then __jp_mantissa(base, p + 1, stop, m)
  else __jp_mantissa(base, p + 1, stop, m * 10 + (b - 48))
}

// 10.0^k for 0 <= k <= 22, exact (each step of the product is exact there).
fn __jp_pow10(k: Int, acc: Float) -> Float = if k <= 0 then acc else __jp_pow10(k - 1, acc * 10.0)

// A whole number token, read where it lies. An Int of at most 18 digits
// cannot overflow and is accumulated in place; a Float whose digits and
// exponent sit in the exact range (at most 15 digits, a net power of ten of
// at most 22) is one correctly rounded multiply or divide — float.parse's
// own fast path, so the same bits. Anything else is handed to int.parse /
// float.parse on a copy of the token, as before.
fn __jp_number(base: Int, len: Int, p: Int, c: Int) -> Value = {
  let end = __jp_numrun(base, len, p)
  if __jp_num_end(base, end, p) != end then __jp_refuse(c, p, 13)
  else {
    __jp_seek(c, end)
    let neg = prim.load8(base + p) == 45
    let lead = if neg then p + 1 else p
    let int_end = __jp_digits(base, end, lead)
    if int_end == end then {
      if end - lead <= 19 then {
        let m = __jp_mantissa(base, lead, end, 0)
        value.int(if neg then 0 - m else m)
      } else match int.parse(__jp_substr(base, p, end)) {
        ok(n) => value.int(n),
        err(_) => __jp_refuse(c, p, 14),
      }
    } else __jp_float(base, p, lead, int_end, end, neg, c)
  }
}

fn __jp_float(base: Int, p: Int, lead: Int, int_end: Int, end: Int, neg: Bool, c: Int) -> Value = {
  let has_frac = prim.load8(base + int_end) == 46
  let frac_end = if has_frac then __jp_digits(base, end, int_end + 1) else int_end
  let frac = if has_frac then frac_end - int_end - 1 else 0
  let digits = int_end - lead + frac
  let e_neg = frac_end + 1 < end and prim.load8(base + frac_end + 1) == 45
  let e_start = if frac_end + 1 < end and (prim.load8(base + frac_end + 1) == 45 or prim.load8(base + frac_end + 1) == 43) then frac_end + 2 else frac_end + 1
  let e_mag = if frac_end < end and end - e_start <= 3 then __jp_mantissa(base, e_start, end, 0) else 0
  let net = (if e_neg then 0 - e_mag else e_mag) - frac
  let fast = digits <= 15 and (frac_end == end or end - e_start <= 3) and net <= 22 and net >= 0 - 22
  if fast then {
    let mag = prim.i2f(__jp_mantissa(base, lead, frac_end, 0))
    let scaled = if net >= 0 then mag * __jp_pow10(net, 1.0) else mag / __jp_pow10(0 - net, 1.0)
    value.float(if neg then -1.0 * scaled else scaled)
  } else match float.parse(__jp_substr(base, p, end)) {
    ok(f) => value.float(f),
    err(_) => __jp_refuse(c, p, 14),
  }
}

// ── literals ──
fn __jp_lit_at(base: Int, len: Int, p: Int, b0: Int, b1: Int, b2: Int, b3: Int) -> Bool = p + 4 <= len and prim.load8(base + p) == b0 and prim.load8(base + p + 1) == b1 and prim.load8(base + p + 2) == b2 and prim.load8(base + p + 3) == b3

fn __jp_bool(base: Int, len: Int, p: Int, c: Int) -> Value = if __jp_lit_at(base, len, p, 116, 114, 117, 101) then {
  __jp_seek(c, p + 4)
  value.bool(true)
} else if __jp_lit_at(base, len, p, 102, 97, 108, 115) and p + 5 <= len and prim.load8(base + p + 4) == 101 then {
  __jp_seek(c, p + 5)
  value.bool(false)
} else __jp_refuse(c, p, 15)

fn __jp_null(base: Int, len: Int, p: Int, c: Int) -> Value = if __jp_lit_at(base, len, p, 110, 117, 108, 108) then {
  __jp_seek(c, p + 4)
  value.null()
} else __jp_refuse(c, p, 16)

// ── collections ──
// After a member: `close` ends the container (the cell is left past it and
// the answer is -1), a `,` leads to the next member (its offset, whitespace
// skipped), anything else is refused (-1). A refusal already in the cell
// stays.
fn __jp_after(base: Int, len: Int, c: Int, close: Int) -> Int = {
  let np = __jp_pos(c)
  if np < 0 then 0 - 1
  else {
    let q = __jp_ws(base, len, np)
    if q >= len then __jp_stop(c, q, 6)
    else {
      let b = prim.load8(base + q)
      if b == close then {
        __jp_seek(c, q + 1)
        0 - 1
      } else if b == 44 then {
        let n = __jp_ws(base, len, q + 1)
        if n < len and prim.load8(base + n) == close then __jp_stop(c, q, 7) else n
      } else __jp_stop(c, q, if close == 93 then 8 else 9)
    }
  }
}

// Refuse at `p` with `kind` and stop the member loop.
fn __jp_stop(c: Int, p: Int, kind: Int) -> Int = {
  __jp_seek(c, __jp_code(p, kind))
  0 - 1
}

// p is at the first element (post-`[`, post-ws). An empty array closes here.
//
// A LOOP with an in-place `list.push` accumulator, deliberately breaking the
// stdlib's prefer-recursion idiom (#939) — the recursive form had two costs
// that both scale with element COUNT, and real documents put six digits there:
//   1. `acc + [v]` copies the whole accumulator per element — O(n^2) total.
//      A 103 KiB glTF chunk that parsed in 5 ms took >11 minutes.
//   2. One real call frame per element, so ~8k elements overflow the wasm
//      call stack — a trap, after the quadratic slowdown.
// The loop is O(1) amortized per element and O(depth) stack (nesting only).
fn __jp_array(base: Int, len: Int, p0: Int, depth: Int, c: Int) -> Value = {
  var items: List[Value] = []
  var p = if p0 < len and prim.load8(base + p0) == 93 then {
    __jp_seek(c, p0 + 1)
    0 - 1
  } else p0
  while p >= 0 {
    list.push(items, __jp_value(base, len, p, depth, c))
    p = __jp_after(base, len, c, 93)
  }
  value.array(items)
}

// The key at p (a member's start, post-ws): a string, or `unquoted key`.
fn __jp_key(base: Int, len: Int, p: Int, c: Int) -> String =
  if p >= len then {
    __jp_seek(c, __jp_code(p, 6))
    ""
  } else if prim.load8(base + p) != 34 then {
    __jp_seek(c, __jp_code(p, 10))
    ""
  } else __jp_string(base, len, p, c)

// The `:` after a key the cell is past: the offset after it, or a refusal
// (-1).
fn __jp_colon(base: Int, len: Int, c: Int) -> Int = {
  let kp = __jp_pos(c)
  if kp < 0 then 0 - 1
  else {
    let q = __jp_ws(base, len, kp)
    if q >= len then __jp_stop(c, q, 6)
    else if prim.load8(base + q) != 58 then __jp_stop(c, q, 12)
    else q + 1
  }
}

// A repeated key is refused at its opening quote (I-JSON §2.3).
fn __jp_unique(c: Int, p: Int, repeated: Bool) -> Unit =
  if repeated and __jp_pos(c) >= 0 then __jp_seek(c, __jp_code(p, 11)) else ()

// p is at the first key (post-`{`, post-ws). An empty object closes here;
// every later round starts past a `,` and its whitespace. A key is checked
// against the keys read so far — pairwise while the object is short, and
// through a key index once it holds 16 (#4297) — so the check is O(1) per
// key on wide objects. The same loop shape as `__jp_array`, for the same two
// reasons (#939).
fn __jp_object(base: Int, len: Int, p0: Int, depth: Int, c: Int) -> Value = {
  var pairs: List[(String, Value)] = []
  var p = if p0 < len and prim.load8(base + p0) == 125 then {
    __jp_seek(c, p0 + 1)
    0 - 1
  } else p0
  while p >= 0 and list.len(pairs) < 16 {
    let k = __jp_key(base, len, p, c)
    __jp_unique(c, p, list.any(pairs, ((s, _)) => s == k))
    list.push(pairs, (k, __jp_value(base, len, __jp_colon(base, len, c), depth, c)))
    p = __jp_after(base, len, c, 125)
  }
  if p >= 0 then {
    var index = pairs |> list.map(((s, _)) => (s, 0)) |> map.from_list
    while p >= 0 {
      let k = __jp_key(base, len, p, c)
      __jp_unique(c, p, false)
      index = map.set(index, k, 0)
      list.push(pairs, (k, __jp_value(base, len, __jp_colon(base, len, c), depth, c)))
      p = __jp_after(base, len, c, 125)
    }
  } else ()
  value.object(pairs)
}
