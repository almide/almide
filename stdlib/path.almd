// path — file path manipulation (secure-by-design Layer 3)
// Bundled stdlib module (written in Almide, auto multi-target)
// Whether `s` stays inside the directory it is joined to: relative (no
// leading `/` or `\`, no drive letter `C:`, no leading `~`), no NUL, and no
// `..` segment once split on BOTH separators — `..\..\x` climbs on Windows.
// Percent-encoded forms (`%2e%2e`) are NOT decoded: they are literal names
// to the filesystem, and decoding is the URL layer's job, before this check.
// The measured reference is Go's `filepath.IsLocal` (2026-10-25): it too
// refuses absolute, empty-rooted and escaping paths lexically; this check
// also refuses `~` (a shell would expand it) and backslash traversal on every
// host, where Go treats `\` as a separator on Windows only.
local fn stays_inside(s: String) -> Bool = {
  let segs = string.split(string.replace(s, "\\", "/"), "/")
  let first = list.first(segs) ?? ""
  let rooted = string.starts_with(s, "/") or string.starts_with(s, "\\")
  let drive = string.len(first) >= 2 and string.slice(first, 1, 2) == ":"
  let home = string.starts_with(s, "~")
  let nul = string.contains(s, "\u{0}")
  let climbs = list.any(segs, (seg) => seg == "..")
  not (rooted or drive or home or nul or climbs)
}

// For a child that crossed a trust boundary, use join_within (#4146): here an
// absolute child replaces base and a `..` child climbs out of it.
/// base/child; an absolute child replaces base.
fn join(base: String, child: String) -> String = {
  // If child is absolute, it replaces base (matches Rust Path::join behavior)
  if string.starts_with(child, "/") then child
  else {
    let n = if string.ends_with(base, "/") then string.len(base) - 1 else string.len(base)
    // The root keeps its slash: join("/", "a") is "/a" (#4072).
    if n > 0 then string.slice(base, 0, n) + "/" + child
    else if string.starts_with(base, "/") then "/" + child
    else child
  }
}

// The join for a child that crossed a trust boundary (#4146): `child` must be
// what `from_string` admits — relative, no `..` on either separator, no `~`,
// no drive, no NUL — so the result names a place under `base`.
/// base/child; err if child could leave base.
fn join_within(base: String, child: String) -> Result[String, String] =
  if stays_inside(child) then ok(join(base, child)) else err("path traversal rejected: " + child)

/// path minus last segment; "" if no slash.
fn dirname(path: String) -> String = {
  let parts = string.split(path, "/")
  let n = list.len(parts)
  if n <= 1 then ""
  else {
    let parent_parts = list.take(parts, n - 1)
    let joined = list.join(parent_parts, "/")
    // Preserve root "/" for absolute paths
    if string.len(joined) == 0 and string.starts_with(path, "/") then "/" else joined
  }
}

/// Last non-empty segment; "" for / or empty path.
fn basename(path: String) -> String = {
  let parts = string.split(path, "/")
  let filtered = list.filter(parts, (s) => string.len(s) > 0)
  match list.last(filtered) {
    some(name) => name,
    none => "",
  }
}

/// After basename's last dot; none if no dot or dotfile.
fn extension(path: String) -> String? = {
  let name = basename(path)
  let parts = string.split(name, ".")
  let n = list.len(parts)
  // A leading dot names a hidden file, not an extension: `.gitignore` has
  // none, `.bashrc.bak` has `bak` — the rule `stem` keeps and the docs state.
  if n <= 1 then none
  else if string.starts_with(name, ".") and n == 2 then none else list.last(parts)
}

/// True when path starts with /.
fn is_absolute(path: String) -> Bool = string.starts_with(path, "/")

/// Basename minus last extension; dotfiles as-is.
fn stem(path: String) -> String = {
  let name = basename(path)
  let parts = string.split(name, ".")
  let n = list.len(parts)
  // No dot, or only a leading dot (e.g. ".hidden") → return as-is
  if n <= 1 then name
  else if string.starts_with(name, ".") and n == 2 then name
  else {
    // Drop the last segment and rejoin
    let prefix_parts = list.take(parts, n - 1)
    list.join(prefix_parts, ".")
  }
}

/// Resolves . and .. lexically; "" becomes ".".
fn normalize(path: String) -> String = {
  let absolute = string.starts_with(path, "/")
  // The resolved segments, as a stack pushed and popped at its END: each segment
  // costs O(1), so the walk is linear in the path (#4211 — the old fold prepended
  // `[seg] + acc` and dropped with `list.drop`, a full copy per segment).
  var stack: List[String] = []
  for seg in string.split(path, "/") {
    // Empty segments (from //) and "." resolve to nothing.
    if string.len(seg) == 0 or seg == "." then ()
    else if seg == ".." then {
      match list.last(stack) {
        // Nothing to pop: keep ".." only if relative.
        none => if absolute then () else list.push(stack, ".."),
        // Can't pop past "..".
        some(top) => if top == ".." then list.push(stack, "..")
        else {
          let _ = list.pop(stack)
        },
      }
    } else list.push(stack, seg)
  }
  let joined = list.join(stack, "/")
  if absolute then "/" + joined
  else if string.len(joined) == 0 then "." else joined
}

/// Segments of normalize(path), led by "/" when absolute; ["."] for "" or ".".
fn components(path: String) -> List[String] = {
  let n = normalize(path)
  let segs = string.split(n, "/") |> list.filter((s) => string.len(s) > 0)
  if string.starts_with(n, "/") then ["/"] + segs
  else segs
}

/// path relative to base, lexically; "." when equal; none when not under base.
fn relative_to(path: String, base: String) -> String? = {
  let pc = components(path) |> list.filter((s) => s != ".")
  let bc = components(base) |> list.filter((s) => s != ".")
  let rest = list.drop(pc, list.len(bc))
  if list.take(pc, list.len(bc)) != bc or list.contains(rest, "..") then none
  else if list.is_empty(rest) then some(".")
  else some(list.join(rest, "/"))
}

local fn trim_end_slashes(p: String) -> String =
  if string.len(p) > 1 and string.ends_with(p, "/") then trim_end_slashes(string.drop_end(p, 1))
  else p

/// path with its last extension replaced by ext; "" removes it; unchanged without a file name.
fn with_extension(path: String, ext: String) -> String = {
  let name = basename(path)
  match name {
    "" => path,
    "." => path,
    ".." => path,
    _ => {
      let trimmed = trim_end_slashes(path)
      let dir = string.drop_end(trimmed, string.len(name))
      let s = stem(name)
      if ext == "" then dir + s else dir + s + "." + ext
    },
  }
}
