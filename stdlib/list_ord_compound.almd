fn list_max_oint(xs: List[Int?]) -> (Int?)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_oint(h, __exidx_oint(h, n, 1, 0, true))
}
