fn __ordc_some_oint(h: Int, i: Int) -> (Int?)? = {
  let e = prim.load64(h + 12 + i * 8)
  prim.rc_inc(e)
  let x: Int? = prim.load_handle(h + 12 + i * 8)
  some(x)
}

fn list_min_oint(xs: List[Int?]) -> (Int?)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_oint(h, __exidx_oint(h, n, 1, 0, false))
