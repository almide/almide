// list_ord_compound — SELF-HOSTED type-directed ordering (list.sort/min/max) over
// COMPOUND elements, matching native's derived Ord (the C-053 lattice):
//   - `tss`  : (scalar, scalar) 2-tuple — lexicographic i64 slot compare
//   - `tsstr`: (scalar, String) 2-tuple — i64 slot 0, byte-lex String slot 1
//   - `lint` : List[Int/Bool] element  — elementwise i64, shorter-first tiebreak
//   - `lstr` : List[String] element    — elementwise byte-lex, shorter-first
//   - `oint` : Option[scalar] element  — none < some, some by payload
// The generic scalar twins compared the i64 HANDLE (arbitrary order — a silent
// miscompile) and raw-copied handles (double-free); these follow the list_sort_str
// discipline instead: sort rc_incs every copied handle into an owned result buffer
// (the caller's type-routed recursive drop balances it), min/max return
// Some(a SHARED +1 reference to the winning element). Float components stay walled
// (IEEE totalOrder is the _float family's job, not an i64 slot compare).
fn __ordc_strcmp_at(ah: Int, bh: Int, la: Int, lb: Int, k: Int) -> Int = if k >= la then (if k >= lb then 0 else 0 - 1)
else if k >= lb then 1
else {
  let ca = prim.load8(ah + 12 + k)
  let cb = prim.load8(bh + 12 + k)
  if ca < cb then 0 - 1
  else if ca > cb then 1
  else __ordc_strcmp_at(ah, bh, la, lb, k + 1)
}

fn __ordc_strcmp(ah: Int, bh: Int) -> Int = __ordc_strcmp_at(ah, bh, prim.load32(ah + 4), prim.load32(bh + 4), 0)

fn __ordc_icmp(a: Int, b: Int) -> Int = if a < b then 0 - 1
else if a > b then 1 else 0

// ── comparators (raw block handles in, -1/0/1 out) ──
fn __cmp_tss(a: Int, b: Int) -> Int = {
  let c0 = __ordc_icmp(prim.load64(a + 12), prim.load64(b + 12))
  if c0 != 0 then c0 else __ordc_icmp(prim.load64(a + 20), prim.load64(b + 20))
}

fn __cmp_tsstr(a: Int, b: Int) -> Int = {
  let c0 = __ordc_icmp(prim.load64(a + 12), prim.load64(b + 12))
  if c0 != 0 then c0 else __ordc_strcmp(prim.load64(a + 20), prim.load64(b + 20))
}

fn __cmp_lint_at(a: Int, b: Int, la: Int, lb: Int, k: Int) -> Int = if k >= la then (if k >= lb then 0 else 0 - 1)
else if k >= lb then 1
else {
  let c = __ordc_icmp(prim.load64(a + 12 + k * 8), prim.load64(b + 12 + k * 8))
  if c != 0 then c
  else __cmp_lint_at(a, b, la, lb, k + 1)
}

fn __cmp_lint(a: Int, b: Int) -> Int = __cmp_lint_at(a, b, prim.load32(a + 4), prim.load32(b + 4), 0)

fn __cmp_lstr_at(a: Int, b: Int, la: Int, lb: Int, k: Int) -> Int = if k >= la then (if k >= lb then 0 else 0 - 1)
else if k >= lb then 1
else {
  let c = __ordc_strcmp(prim.load64(a + 12 + k * 8), prim.load64(b + 12 + k * 8))
  if c != 0 then c
  else __cmp_lstr_at(a, b, la, lb, k + 1)
}

fn __cmp_lstr(a: Int, b: Int) -> Int = __cmp_lstr_at(a, b, prim.load32(a + 4), prim.load32(b + 4), 0)

fn __cmp_oint(a: Int, b: Int) -> Int = {
  let ta = prim.load32(a + 4)
  let tb = prim.load32(b + 4)
  if ta == 0 and tb == 0 then 0
  else if ta == 0 then 0 - 1
  else if tb == 0 then 1 else __ordc_icmp(prim.load64(a + 12), prim.load64(b + 12))
}

// ── shared machinery: rc-copy, sel-dispatched stable mergesort / extremum index ──
fn __ordc_copy_rc(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(srch + 12 + i * 8)
  prim.rc_inc(e)
  prim.store64(dsth + 12 + i * 8, e)
  __ordc_copy_rc(srch, dsth, n, i + 1)
}

// One comparator dispatch for the merge (sel: 0=tss, 1=tsstr, 2=lint, 3=oint) —
// the four sorts share ONE stable bottom-up mergesort (#1459, O(n log n) in
// place of four O(n^2) selection sorts) instead of four duplicated walkers.
fn __ordc_cmp(sel: Int, a: Int, b: Int) -> Int = if sel == 0 then __cmp_tss(a, b)
else if sel == 1 then __cmp_tsstr(a, b)
else if sel == 2 then __cmp_lint(a, b)
else __cmp_oint(a, b)

// `<=` takes the left run first, so equal elements keep their order — matching
// native's stable derived-Ord sort where the difference is even observable.
fn __ordc_mrun(sel: Int, srch: Int, dsth: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
    else if i >= mid then false
    else __ordc_cmp(sel, prim.load64(srch + 12 + i * 8), prim.load64(srch + 12 + j * 8)) <= 0
  if takel then {
    prim.store64(dsth + 12 + k * 8, prim.load64(srch + 12 + i * 8))
    __ordc_mrun(sel, srch, dsth, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dsth + 12 + k * 8, prim.load64(srch + 12 + j * 8))
    __ordc_mrun(sel, srch, dsth, mid, hi, i, j + 1, k + 1)
  }
}

fn __ordc_mpass(sel: Int, srch: Int, dsth: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __ordc_mrun(sel, srch, dsth, mid, hi, lo, mid, lo)
  __ordc_mpass(sel, srch, dsth, n, width, lo + width * 2)
}

fn __ordc_mrounds(sel: Int, curh: Int, othh: Int, n: Int, width: Int) -> Int = if width >= n then curh
else {
  let _p = __ordc_mpass(sel, curh, othh, n, width, 0)
  __ordc_mrounds(sel, othh, curh, n, width * 2)
}

fn __ordc_copy(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store64(dsth + 12 + i * 8, prim.load64(srch + 12 + i * 8))
  __ordc_copy(srch, dsth, n, i + 1)
}

// rc-copy the source into the owned result buffer, mergesort against a FLAT
// scratch (stale handle copies are never rc-touched by its drop), copy back if
// the ping-pong ended on the scratch. The result buffer co-owns each element
// exactly once; the caller's type-routed recursive drop balances the rc_incs.
fn __ordc_msort(sel: Int, bh: Int, th: Int, n: Int) -> Int = {
  let fin = __ordc_mrounds(sel, bh, th, n, 1)
  if fin == bh then 0 else __ordc_copy(th, bh, n, 0)
}

fn __exidx_tss(h: Int, n: Int, i: Int, best: Int, want_max: Bool) -> Int = if i >= n then best
else {
  let c = __cmp_tss(prim.load64(h + 12 + i * 8), prim.load64(h + 12 + best * 8))
  let nb = if (want_max and c > 0) or (not want_max and c < 0) then i else best
  __exidx_tss(h, n, i + 1, nb, want_max)
}

fn __exidx_tsstr(h: Int, n: Int, i: Int, best: Int, want_max: Bool) -> Int = if i >= n then best
else {
  let c = __cmp_tsstr(prim.load64(h + 12 + i * 8), prim.load64(h + 12 + best * 8))
  let nb = if (want_max and c > 0) or (not want_max and c < 0) then i else best
  __exidx_tsstr(h, n, i + 1, nb, want_max)
}

fn __exidx_lint(h: Int, n: Int, i: Int, best: Int, want_max: Bool) -> Int = if i >= n then best
else {
  let c = __cmp_lint(prim.load64(h + 12 + i * 8), prim.load64(h + 12 + best * 8))
  let nb = if (want_max and c > 0) or (not want_max and c < 0) then i else best
  __exidx_lint(h, n, i + 1, nb, want_max)
}

fn __exidx_lstr(h: Int, n: Int, i: Int, best: Int, want_max: Bool) -> Int = if i >= n then best
else {
  let c = __cmp_lstr(prim.load64(h + 12 + i * 8), prim.load64(h + 12 + best * 8))
  let nb = if (want_max and c > 0) or (not want_max and c < 0) then i else best
  __exidx_lstr(h, n, i + 1, nb, want_max)
}

fn __exidx_oint(h: Int, n: Int, i: Int, best: Int, want_max: Bool) -> Int = if i >= n then best
else {
  let c = __cmp_oint(prim.load64(h + 12 + i * 8), prim.load64(h + 12 + best * 8))
  let nb = if (want_max and c > 0) or (not want_max and c < 0) then i else best
  __exidx_oint(h, n, i + 1, nb, want_max)
}

// ── public twins ──
// sort: rc-copy into an owned buffer, stable mergesort (handle moves only, #1459).
// The RESULT's recursive drop is routed by TYPE at the caller's bind — balanced
// against the rc_incs here.
fn list_sort_tsstr(xs: List[(Int, String)]) -> List[(Int, String)] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_str(n)
  let bh = prim.handle(buf)
  let _c = __ordc_copy_rc(h, bh, n, 0)
  let tmp = prim.alloc_list(n)
  let _s = __ordc_msort(1, bh, prim.handle(tmp), n)
  buf
}

fn list_sort_tss(xs: List[(Int, Int)]) -> List[(Int, Int)] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_str(n)
  let bh = prim.handle(buf)
  let _c = __ordc_copy_rc(h, bh, n, 0)
  let tmp = prim.alloc_list(n)
  let _s = __ordc_msort(0, bh, prim.handle(tmp), n)
  buf
}

fn list_sort_lint(xs: List[List[Int]]) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_str(n)
  let bh = prim.handle(buf)
  let _c = __ordc_copy_rc(h, bh, n, 0)
  let tmp = prim.alloc_list(n)
  let _s = __ordc_msort(2, bh, prim.handle(tmp), n)
  buf
}

fn list_sort_oint(xs: List[Int?]) -> List[Int?] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_str(n)
  let bh = prim.handle(buf)
  let _c = __ordc_copy_rc(h, bh, n, 0)
  let tmp = prim.alloc_list(n)
  let _s = __ordc_msort(3, bh, prim.handle(tmp), n)
  buf
}

// min/max: Some(a SHARED +1 reference to the winning element) — the source list
// keeps its own reference; the Option's type-routed drop releases the share.
fn __ordc_some_tsstr(h: Int, i: Int) -> (Int, String)? = {
  let e = prim.load64(h + 12 + i * 8)
  prim.rc_inc(e)
  let x: (Int, String) = prim.load_handle(h + 12 + i * 8)
  some(x)
}

fn list_min_tsstr(xs: List[(Int, String)]) -> (Int, String)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_tsstr(h, __exidx_tsstr(h, n, 1, 0, false))
}

fn list_max_tsstr(xs: List[(Int, String)]) -> (Int, String)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_tsstr(h, __exidx_tsstr(h, n, 1, 0, true))
}

fn __ordc_some_tss(h: Int, i: Int) -> (Int, Int)? = {
  let e = prim.load64(h + 12 + i * 8)
  prim.rc_inc(e)
  let x: (Int, Int) = prim.load_handle(h + 12 + i * 8)
  some(x)
}

fn list_min_tss(xs: List[(Int, Int)]) -> (Int, Int)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_tss(h, __exidx_tss(h, n, 1, 0, false))
}

fn list_max_tss(xs: List[(Int, Int)]) -> (Int, Int)? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_tss(h, __exidx_tss(h, n, 1, 0, true))
}

fn __ordc_some_lint(h: Int, i: Int) -> List[Int]? = {
  let e = prim.load64(h + 12 + i * 8)
  prim.rc_inc(e)
  let x: List[Int] = prim.load_handle(h + 12 + i * 8)
  some(x)
}

fn list_min_lint(xs: List[List[Int]]) -> List[Int]? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_lint(h, __exidx_lint(h, n, 1, 0, false))
}

fn list_max_lint(xs: List[List[Int]]) -> List[Int]? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  if n <= 0 then none
  else __ordc_some_lint(h, __exidx_lint(h, n, 1, 0, true))
}

fn __ordc_some_lstr(h: Int, i: Int) -> List[String]? = {
  let e = prim.load64(h + 12 + i * 8)
  prim.rc_inc(e)
  let x: List[String] = prim.load_handle(h + 12 + i * 8)
  some(x)
}

fn list_min_lstr(xs: List[List[String]]) -> List[String]? = {
