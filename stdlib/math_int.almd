// math_int — SELF-HOSTED scalar Int math (abs/max/min/sign/pow) for v1, plain scalar
// if/arithmetic — NO heap, NO prim floor. Matches v0's i64 ops.
// The runtime linker auto-includes the ones a program calls (all share this file).
fn math_abs(n: Int) -> Int = if n < 0 then 0 - n else n

fn math_max(a: Int, b: Int) -> Int = if a > b then a else b

fn math_min(a: Int, b: Int) -> Int = if a < b then a else b

fn math_sign(n: Int) -> Int = if n > 0 then 1
else if n < 0 then 0 - 1 else 0

// math.pow via exponentiation-by-squaring expressed with `% 2` (is-odd) and `/ 2` (halve)
// — the SAME algorithm + wrapped i64 result as v0 (`e & 1` / `e >>= 1`), in O(log exp).
// exp >= 0 byte-matches v0; v0 ABORTS on a negative exponent (an error path), which this
// returns 1 for instead (no infinite loop) — the value path is exact.
fn __pow_sq(b: Int, e: Int, acc: Int) -> Int = if e <= 0 then acc
else {
  let acc2 = if e % 2 == 1 then acc * b else acc
  __pow_sq(b * b, e / 2, acc2)
}

fn math_pow(base: Int, exp: Int) -> Int = {
  // §13 termination convention (C-035 kin): a negative exponent has no integer
  // result — abort with the native-identical stderr line + exit 1.
  if exp < 0 then prim.die(prim.handle("Error: negative exponent\n")) else ()
  __pow_sq(base, exp, 1)
}

// math.factorial = (1..=n).product(): n! for n>=1, and 1 for n<=1 (the empty product,
// matching v0's empty inclusive range). Wraps like v0's i64 product for large n.
fn __fact(n: Int, acc: Int) -> Int = if n <= 1 then acc else __fact(n - 1, acc * n)

fn math_factorial(n: Int) -> Int = __fact(n, 1)

// math.choose = C(n,k): 0 when k<0 or k>n, else C(n, min(k, n-k)) EXACTLY, reduced mod
// 2^64 like every Int product (the true binomial whenever it fits in an Int). The same
// algorithm, op for op, as v0's `almide_rt_math_choose` (runtime/rs/src/math.rs, which
// says why): each factor's power of two is counted in `twos` and its odd part multiplied
// in (wrapping), and the odd denominators are divided out at the end by their Newton
// inverse mod 2^64. #2491: the old `result * (n - i) / (i + 1)` overflowed before it
// divided (`choose(62, 31)` was negative). Every argument here is >= 1, so the two-adic
// helpers terminate.
fn __choose_tz(x: Int, c: Int) -> Int = if x % 2 == 0 then __choose_tz(x / 2, c + 1) else c

fn __choose_inv_step(a: Int, x: Int) -> Int = x * (2 - a * x)

// `a` odd is its own inverse mod 2^3; five Newton steps double that to 96 >= 64 bits.
fn __choose_inv(a: Int) -> Int = {
  let x1 = __choose_inv_step(a, a)
  let x2 = __choose_inv_step(a, x1)
  let x3 = __choose_inv_step(a, x2)
  let x4 = __choose_inv_step(a, x3)
  __choose_inv_step(a, x4)
}

fn __choose_finish(num: Int, den: Int, twos: Int) -> Int = {
  let inv = __choose_inv(den)
  let odd = num * inv
  prim.bshl(odd, twos)
}

fn __choose_loop(n: Int, k: Int, i: Int, num: Int, den: Int, twos: Int) -> Int = {
  if i >= k then __choose_finish(num, den, twos)
  else {
    let a = n - i
    let b = i + 1
    let ta = __choose_tz(a, 0)
    let tb = __choose_tz(b, 0)
    let oa = prim.bshr(a, ta)
    let ob = prim.bshr(b, tb)
    __choose_loop(n, k, i + 1, num * oa, den * ob, twos + ta - tb)
  }
}

fn math_choose(n: Int, k: Int) -> Int = if k < 0 then 0
else if k > n then 0
else {
  let nk = n - k
  let k2 = if k < nk then k else nk
  __choose_loop(n, k2, 0, 1, 1, 0)
}
