// list_fold_ols — SELF-HOSTED heap-accumulator `list.fold` for the Option[List[String]]
// accumulator over List[String] elements (is_balanced's paren-stack fold — the shape
// mod_p4.rs's `fold_hacc` wall names as "no heap-accumulator fold variant self-hosted yet").
// f : (Option[List[String]], String) -> Option[List[String]] via the (heap, heap) -> heap
// 2-arity CallIndirect (`list_reduce_str`'s proven closure shape). OWNERSHIP: `acc` MOVES
// into f each iteration (f consumes it and returns the next acc — the fn never frees it);
// each element is read as a BORROW (`prim.load_str`, the list keeps ownership); the final
// acc is the owned result. Left fold in element order, matching v0's fold(xs, init, f).
fn __fold_ols_loop(h: Int, f: fn(List[String]?, String) -> List[String]?, n: Int, i: Int, acc: List[String]?) -> List[String]? = if i >= n then acc
else {
  let x = prim.load_str(h + 12 + i * 8)
  let nacc = f(acc, x)
  __fold_ols_loop(h, f, n, i + 1, nacc)
}

fn list_fold_ols(xs: List[String], init: List[String]?, f: fn(List[String]?, String) -> List[String]?) -> List[String]? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  __fold_ols_loop(h, f, n, 0, init)
}

// ── String elements, ANY heap accumulator ── the type-ERASED sibling of
// `list_fold_ols`. A heap accumulator is one i32 handle whatever block it points
// at, and this loop never inspects it: the acc MOVES into f each iteration (f
// consumes it and returns the next — this fn never frees it) and the final acc
// is the owned result. Elements are borrowed String loads; the source keeps
// ownership.
//
// `Set[String]` shares it: a `Set[String]` IS a DynListStr block of unique,
// insertion-ordered Strings (set_str.almd), the same layout `List[String]` has,
// so one walk serves both subjects.
fn __fold_str_hacc_loop(h: Int, f: fn(Value, String) -> Value, n: Int, i: Int, acc: Value) -> Value = if i >= n then acc
else {
  let x = prim.load_str(h + 12 + i * 8)
  let nacc = f(acc, x)
  __fold_str_hacc_loop(h, f, n, i + 1, nacc)
}

fn list_fold_str_hacc(xs: List[String], init: Value, f: fn(Value, String) -> Value) -> Value = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  __fold_str_hacc_loop(h, f, n, 0, init)
}

// `Set[String]` shares the walk above under its own name: the registry maps one
// impl fn to one call name, so the alias needs a definition rather than a second
// row over `list_fold_str_hacc`.
fn set_fold_str_hacc(xs: Set[String], init: Value, f: fn(Value, String) -> Value) -> Value = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  __fold_str_hacc_loop(h, f, n, 0, init)
}
