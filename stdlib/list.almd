// list — bundled-Almide stdlib module (Stdlib Declarative Unification Stage 3c).
//
// Migrated mechanically from `stdlib/defs/list.toml` (60 fns). Closure-
// bearing ops that `pass_stdlib_lowering::try_lower_to_iter_chain`
// recognises (`map`, `filter`, `flat_map`, `filter_map`, `fold`, `find`,
// `any`, `all`, `count`) are intercepted before the `@inline_rust`
// dispatch fires — the Rust emitter produces a fused
// `into_iter().<step>().<collect>()` chain, preserving zero-copy on
// isolated calls. All other ops (non-closure, mutable, and the closure
// ops not in the IterChain list) go through the declarative bundled
// path.
// ── basic accessors ──
/// Element count; 0 for an empty list.
@intrinsic("almide_rt_list_len")
fn len[A](xs: List[A]) -> Int = _

/// Alias of list.len.
@deprecated(since=5, use="list.len")
@intrinsic("almide_rt_list_len")
fn length[A](xs: List[A]) -> Int = _

/// Element at index i, or none when out of range.
@intrinsic("almide_rt_list_get")
fn get[A](xs: List[A], i: Int) -> A? = _

/// Element at i, or default when out of range.
@intrinsic("almide_rt_list_get_or")
fn get_or[A](xs: List[A], i: Int, default: A) -> A = _

/// Copy with slot i = val; no-op if i out of range.
@intrinsic("almide_rt_list_set")
fn set[A](xs: List[A], i: Int, val: A) -> List[A] = _

/// Copy with i and j swapped; no-op if either OOB.
@intrinsic("almide_rt_list_swap")
fn swap[A](xs: List[A], i: Int, j: Int) -> List[A] = _

/// Ascending copy; Floats in IEEE totalOrder.
@intrinsic("almide_rt_list_sort")
fn sort[A](xs: List[A]) -> List[A] = _

/// Elements in reverse order.
@intrinsic("almide_rt_list_reverse")
fn reverse[A](xs: List[A]) -> List[A] = _

/// true if some element == x; NaN never matches.
@intrinsic("almide_rt_list_contains")
fn contains[A](xs: List[A], x: A) -> Bool = _

/// (index, element) pairs, index from 0.
@intrinsic("almide_rt_list_enumerate")
@consume(xs)
fn enumerate[A](xs: List[A]) -> List[(Int, A)] = _

/// Pairs by position; stops at the shorter list.
@intrinsic("almide_rt_list_zip")
@consume(xs, ys)
fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] = _

// Borrows: the runtime takes a slice and clones each element out, so `flatten`
// can appear alongside another borrow of the same binding in one expression.
// Consuming it made `list.get_or(xs, 0, list.flatten(xs))` move `xs` into
// `flatten` while `get_or` borrowed it — `check` accepted, rustc rejected with
// E0505 (differential fuzz).
/// Inner lists concatenated in order.
@intrinsic("almide_rt_list_flatten")
fn flatten[T](xss: List[List[T]]) -> List[T] = _

/// First n elements; all if n >= len or n < 0.
@intrinsic("almide_rt_list_take")
@consume(xs)
fn take[A](xs: List[A], n: Int) -> List[A] = _

/// All but the first n; [] if n >= len or n < 0.
@intrinsic("almide_rt_list_drop")
@consume(xs)
fn drop[A](xs: List[A], n: Int) -> List[A] = _

/// All but the first element; [] when empty.
fn tail[A](xs: List[A]) -> List[A] = list.drop(xs, 1)

/// Duplicates removed; first occurrences kept.
@intrinsic("almide_rt_list_unique")
fn unique[A](xs: List[A]) -> List[A] = _

/// Index of the first x, or none.
@intrinsic("almide_rt_list_index_of")
fn index_of[A](xs: List[A], x: A) -> Int? = _

/// Final element, or none when empty.
@intrinsic("almide_rt_list_last")
fn last[A](xs: List[A]) -> A? = _

/// Runs of n, last may be short; n = 0 aborts.
@intrinsic("almide_rt_list_chunk")
fn chunk[A](xs: List[A], n: Int) -> List[List[A]] = _

/// Sum; 0 when empty; wraps on overflow.
@intrinsic("almide_rt_list_sum")
fn sum(xs: List[Int]) -> Int = _

/// Product; 1 when empty; wraps on overflow.
@intrinsic("almide_rt_list_product")
fn product(xs: List[Int]) -> Int = _

/// Head element, or none when empty.
@intrinsic("almide_rt_list_first")
fn first[A](xs: List[A]) -> A? = _

/// true iff xs has no elements.
@intrinsic("almide_rt_list_is_empty")
fn is_empty[A](xs: List[A]) -> Bool = _

/// Least element, or none when empty.
@intrinsic("almide_rt_list_min")
fn min[A](xs: List[A]) -> A? = _

/// Greatest element, or none when empty.
@intrinsic("almide_rt_list_max")
fn max[A](xs: List[A]) -> A? = _

/// Strings joined by sep; empty string for [].
@intrinsic("almide_rt_list_join")
fn join(xs: List[String], sep: String) -> String = _

// ── closure-bearing (IterChain-handled: map, filter, find, any, all,
//    count, flat_map, filter_map, fold — the `try_lower_to_iter_chain`
//    intercept in `pass_stdlib_lowering` fires before the `@inline_rust`
//    dispatch below and produces a fused iterator chain) ──
/// f applied to each element, in order.
@intrinsic("almide_rt_list_map")
@consume(xs)
fn map[A, B](xs: List[A], f: (A) -> B) -> List[B] = _

/// Elements where f is true, order kept.
@intrinsic("almide_rt_list_filter")
@consume(xs)
fn filter[A](xs: List[A], f: (A) -> Bool) -> List[A] = _

/// First element where f holds, or none.
@intrinsic("almide_rt_list_find")
@consume(xs)
fn find[A](xs: List[A], f: (A) -> Bool) -> A? = _

/// true if f holds for some x; false when empty.
@intrinsic("almide_rt_list_any")
fn any[A](xs: List[A], f: (A) -> Bool) -> Bool = _

/// true if f holds for every x; true when empty.
@intrinsic("almide_rt_list_all")
fn all[A](xs: List[A], f: (A) -> Bool) -> Bool = _

/// Number of elements where f holds.
@intrinsic("almide_rt_list_count")
fn count[A](xs: List[A], f: (A) -> Bool) -> Int = _

/// f(x) lists concatenated in order.
@intrinsic("almide_rt_list_flat_map")
@consume(xs)
fn flat_map[A, B](xs: List[A], f: (A) -> List[B]) -> List[B] = _

/// The some values of f(x), in order.
@intrinsic("almide_rt_list_filter_map")
@consume(xs)
fn filter_map[A, B](xs: List[A], f: (A) -> B?) -> List[B] = _

/// Left fold from init; init when empty.
@intrinsic("almide_rt_list_fold")
@consume(xs)
fn fold[A, B](xs: List[A], init: B, f: (B, A) -> B) -> B = _

// ── closure-bearing (not IterChain-handled — direct runtime dispatch) ──
/// Stable sort by key f(x); f runs once per x.
@intrinsic("almide_rt_list_sort_by")
@consume(xs)
fn sort_by[A, B](xs: List[A], f: (A) -> B) -> List[A] = _

/// Longest prefix where f holds.
@intrinsic("almide_rt_list_take_while")
@consume(xs)
fn take_while[A](xs: List[A], f: (A) -> Bool) -> List[A] = _

/// Rest after the longest prefix where f holds.
@intrinsic("almide_rt_list_drop_while")
@consume(xs)
fn drop_while[A](xs: List[A], f: (A) -> Bool) -> List[A] = _

/// (where f holds, the rest), order kept.
@intrinsic("almide_rt_list_partition")
@consume(xs)
fn partition[A](xs: List[A], f: (A) -> Bool) -> (List[A], List[A]) = _

/// Left fold seeded by xs[0]; none when empty.
@intrinsic("almide_rt_list_reduce")
@consume(xs)
fn reduce[A](xs: List[A], f: (A, A) -> A) -> A? = _

/// Key f(x) -> elements; keys in first-seen order.
@intrinsic("almide_rt_list_group_by")
@consume(xs)
fn group_by[A, B](xs: List[A], f: (A) -> B) -> Map[B, List[A]] = _

/// Index of the first x where f holds, or none.
@intrinsic("almide_rt_list_find_index")
@consume(xs)
fn find_index[A](xs: List[A], f: (A) -> Bool) -> Int? = _

/// Copy with slot i = f(old); no-op if i out of range.
@intrinsic("almide_rt_list_update")
@consume(xs)
fn update[A](xs: List[A], i: Int, f: (A) -> A) -> List[A] = _

/// Running fold values, init excluded.
@intrinsic("almide_rt_list_scan")
@consume(xs)
fn scan[A, B](xs: List[A], init: B, f: (B, A) -> B) -> List[B] = _

/// f over pairs; stops at the shorter list.
@intrinsic("almide_rt_list_zip_with")
@consume(xs, ys)
fn zip_with[A, B, C](xs: List[A], ys: List[B], f: (A, B) -> C) -> List[C] = _

/// First element per distinct key f(x).
@intrinsic("almide_rt_list_unique_by")
@consume(xs)
fn unique_by[A, K](xs: List[A], f: (A) -> K) -> List[A] = _

// ── non-closure constructors / slicing ──
/// start up to end, exclusive; [] if end <= start.
@intrinsic("almide_rt_list_range")
fn range(start: Int, end: Int) -> List[Int] = _

/// Indices start..<end, clamped; [] if start >= end.
@intrinsic("almide_rt_list_slice")
@consume(xs)
fn slice[A](xs: List[A], start: Int, end: Int) -> List[A] = _

/// Copy with val at i; i >= len or i < 0 appends.
@intrinsic("almide_rt_list_insert")
@consume(xs)
fn insert[A](xs: List[A], i: Int, val: A) -> List[A] = _

/// Copy without slot i; no-op if i out of range.
@intrinsic("almide_rt_list_remove_at")
@consume(xs)
fn remove_at[A](xs: List[A], i: Int) -> List[A] = _

/// n copies of val; [] for n <= 0.
@intrinsic("almide_rt_list_repeat")
fn repeat[A](val: A, n: Int) -> List[A] = _

/// sep between adjacent elements.
@intrinsic("almide_rt_list_intersperse")
@consume(xs)
fn intersperse[A](xs: List[A], sep: A) -> List[A] = _

/// All n-long runs; [] if n > len; n = 0 aborts.
@intrinsic("almide_rt_list_windows")
fn windows[A](xs: List[A], n: Int) -> List[List[A]] = _

/// Adjacent equal runs collapsed; not global.
@intrinsic("almide_rt_list_dedup")
fn dedup[A](xs: List[A]) -> List[A] = _

/// Last n elements; all if n >= len or n < 0.
@intrinsic("almide_rt_list_take_end")
@consume(xs)
fn take_end[A](xs: List[A], n: Int) -> List[A] = _

/// All but the last n; [] if n >= len or n < 0.
@intrinsic("almide_rt_list_drop_end")
@consume(xs)
fn drop_end[A](xs: List[A], n: Int) -> List[A] = _

/// Random permutation; unseeded, differs per run.
@intrinsic("almide_rt_list_shuffle")
@consume(xs)
fn shuffle[A](xs: List[A]) -> List[A] = _

/// All n-long runs; [] if n > len; n = 0 aborts.
@intrinsic("almide_rt_list_window")
@consume(xs)
fn window[A](xs: List[A], n: Int) -> List[List[A]] = _

/// Index of target in ascending xs, or none.
@intrinsic("almide_rt_list_binary_search")
fn binary_search(xs: List[Int], target: Int) -> Int? = _

// ── mutable (in-place) ──
/// Appends x to xs in place.
@intrinsic("almide_rt_list_push")
fn push[A](mut xs: List[A], x: A) -> Unit = _

// Create an empty list with preallocated capacity. Subsequent `push`es
// up to `cap` avoid the repeated Vec doublings that dominate tight
// decode loops. Use when the final length is known ahead of time.
/// Empty list; cap is only a preallocation hint.
@intrinsic("almide_rt_list_with_capacity")
fn with_capacity[A](cap: Int) -> List[A] = _

/// Removes and yields the last element; none if empty.
@intrinsic("almide_rt_list_pop")
fn pop[A](mut xs: List[A]) -> A? = _

/// Removes every element of xs in place.
@intrinsic("almide_rt_list_clear")
fn clear[A](mut xs: List[A]) -> Unit = _

// ── bundled-Almide extensions (non-TOML, pure Almide body) ──
// Smoke fn: covered by spec/stdlib/list_bundled_test.almd as a regression
// guard for the bundled-dispatch pipeline. Do not remove.
/// n + 1; bundled-dispatch smoke fn.
fn bundled_probe(n: Int) -> Int = n + 1

// Split a list at index `n`. Equivalent to `(list.take(xs, n), list.drop(xs, n))`.
// Demonstrates bundled-Almide calling existing stdlib fns.
/// (take n, drop n); n past the end gives (xs, []).
fn split_at[T](xs: List[T], n: Int) -> (List[T], List[T]) = (list.take(xs, n), list.drop(xs, n))

// Build [seed, f(seed), f(f(seed)), ...] of length `n`. `f` runs exactly `n`
// times: the last result is computed and dropped, as the recursive form did.
//
// A loop, not recursion (#2306): `[seed] + iterate(f(seed), f, n - 1)` was one
// frame per element on both targets (a stack overflow at about 10,000 elements
// on wasm and 50,000 natively) and copied the tail at every level.
//
// The result grows with `list.push` for the LOOP SHAPE, not to dodge a slow
// append. When this was written `acc + [x]` copied the whole list per step for
// a heap element on the structural wasm leg; #2310 fixed that window, and the
// two spellings now measure the same inside a carrier like this one — 0.997x
// native and 1.002x wasm over 4M appends (#2353). So `list.push` stays because
// it is the spelling this body already holds its constant stack with, and
// swapping it would move the allocation ledger to buy nothing.
/// [seed, f(seed), ...] of length n; [] if n <= 0.
fn iterate[T](seed: T, f: (T) -> T, n: Int) -> List[T] = {
  var out: List[T] = []
  var x = seed
  for _ in 0..<n {
    list.push(out, x)
    x = f(x)
  }
  out
}

// The short-circuiting sibling of `filter_map` (#3156), as `find` is of
// `filter`: `filter_map(xs, f) |> list.first` without calling f past the hit.
// A loop, not recursion, for the constant stack #2291 asks of every stdlib
// body. The loop keeps a `stop` flag rather than `break` (see the carriers
// below), so after the hit the remaining iterations only test the flag — f is
// never called on them, which is the observable half of the contract.
/// The first some that f gives, or none; f is not called after the hit.
fn find_map[A, B](xs: List[A], f: (A) -> B?) -> B? = {
  var hit: B? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      some(b) => {
        hit = some(b)
        stop = true
      },
      none => (),
    }
  }
  hit
}

// ── the fallible carriers (ADR-0006 D3) ──
//
// INTERNAL CARRIERS (v0.56.0): the public try_ family (#1041) is REMOVED —
// the core HOF is fallibility-polymorphic and the checker routes a fallible
// callback to these __-prefixed bodies (`list.map(xs, (x) => f(x)!)` runs
// `__fallible_map(xs, stripped-callback)`). Each short-circuits on the FIRST
// err: no element after it reaches the callback (the short-circuit is
// observable). Every callback-taking list fn has one (#3163) — the matrix is
// `almide_types::fallible_hofs`, and tests/list_fallible_family_gate_test.rs
// asserts each cell's carrier exists and that the public try_ surface is EMPTY.
// The key-extracting cells (`sort_by` / `group_by` / `unique_by`) call the
// extractor exactly once per element, in list order, before any reordering —
// the same calls the total form makes — so their FIRST err is defined.
//
// SHAPE (#2291 sweep): one loop per carrier — constant stack, linear time, on
// every leg. The earlier bodies recursed over `list.drop(xs, 1)`: one frame per
// element (the four list-building carriers were not even tail calls, so
// `list.map(xs, (x) => f(x)!)` overflowed at about 10,000 elements on wasm and
// 50,000 natively) plus an O(n) copy per element. The loop carries a `stop`
// flag instead of `break`, which the structural wasm leg does not lower yet;
// after the first err the remaining iterations only test the flag. Results
// grow with `list.push` for that loop shape — `acc + [x]` is no longer the
// slower spelling here (#2310 / #2353); see `iterate` for the measurement.
fn __fallible_map[A, B, E](xs: List[A], f: (A) -> Result[B, E]) -> Result[List[B], E] = {
  var out: List[B] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(b) => list.push(out, b),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

fn __fallible_filter[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[List[A], E] = {
  var out: List[A] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(keep) => if keep then list.push(out, x) else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

fn __fallible_flat_map[A, B, E](xs: List[A], f: (A) -> Result[List[B], E]) -> Result[List[B], E] = {
  var out: List[B] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(bs) => for b in bs {
        list.push(out, b)
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

fn __fallible_filter_map[A, B, E](xs: List[A], f: (A) -> Result[B?, E]) -> Result[List[B], E] = {
  var out: List[B] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(kept) => match kept {
        some(b) => list.push(out, b),
        none => (),
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

fn __fallible_fold[A, B, E](xs: List[A], init: B, f: (B, A) -> Result[B, E]) -> Result[B, E] = {
  var acc = init
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(acc, x) {
      ok(b) => {
        acc = b
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(acc),
  }
}

// The first element the (erring) predicate ACCEPTS, `none` when no element
// matches — or the first err. `__fallible_find(xs, p)` also answers the any/all/
// count shapes, which is why those have no try_ twins.
//
// The hit is kept as an INDEX and read back with `list.get` (`none` for the
// one-past-the-end start value when nothing matched), and the result is rebuilt as
// `ok(some(v))` / `ok(none)`. The incumbent wasm leg walls on the shorter spellings:
// storing the loop variable into an `A?` var, and `ok(read)` over a deferred Option.
fn __fallible_find[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[A?, E] = {
  var hit_at = list.len(xs)
  var i = 0
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(hit) => if hit then {
        hit_at = i
        stop = true
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
    i = i + 1
  }
  match failed {
    some(e) => err(e),
    none => match list.get(xs, hit_at) {
      some(v) => ok(some(v)),
      none => ok(none),
    },
  }
}

// The first some an (erring) callback gives, `none` when every call gave none —
// or the first err. Neither an err nor a hit lets f run on a later element.
fn __fallible_find_map[A, B, E](xs: List[A], f: (A) -> Result[B?, E]) -> Result[B?, E] = {
  var hit: B? = none
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(found) => match found {
        some(b) => {
          hit = some(b)
          stop = true
        },
        none => (),
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(hit),
  }
}

// Run an effectful step per element for its effect, stopping at the first err.
fn __fallible_each[A, E](xs: List[A], f: (A) -> Result[Unit, E]) -> Result[Unit, E] = {
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(_) => (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(()),
  }
}

// ── the predicate queries (#3163) ──
// `list.all(xs, (x) => p(x)!)` stops at the first element the predicate
// rejects, `any` at the first it accepts — the total forms' short-circuit — and
// both stop at the first err.
fn __fallible_any[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[Bool, E] = {
  var hit = false
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(b) => if b then {
        hit = true
        stop = true
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(hit),
  }
}

fn __fallible_all[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[Bool, E] = {
  var held = true
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(b) => if b then () else {
        held = false
        stop = true
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(held),
  }
}

fn __fallible_count[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[Int, E] = {
  var n = 0
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(b) => if b then {
        n = n + 1
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(n),
  }
}

fn __fallible_find_index[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[Int?, E] = {
  var hit_at = -1
  var i = 0
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(hit) => if hit then {
        hit_at = i
        stop = true
      } else (),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
    i = i + 1
  }
  match failed {
    some(e) => err(e),
    none => if hit_at < 0 then ok(none) else ok(some(hit_at)),
  }
}

// ── the selecting cells ──
fn __fallible_partition[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[(List[A], List[A]), E] = {
  var yes: List[A] = []
  var no: List[A] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(keep) => if keep then list.push(yes, x) else list.push(no, x),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok((yes, no)),
  }
}

// The predicate runs up to and including the first element it rejects.
fn __fallible_take_while[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[List[A], E] = {
  var out: List[A] = []
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(x) {
      ok(keep) => if keep then list.push(out, x) else {
        stop = true
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

// The predicate runs up to and including the first element it rejects; the
// rest is kept without calling it.
fn __fallible_drop_while[A, E](xs: List[A], f: (A) -> Result[Bool, E]) -> Result[List[A], E] = {
  var out: List[A] = []
  var failed: E? = none
  var dropping = true
  var stop = false
  for x in xs {
    if stop then ()
    else if dropping then match f(x) {
      ok(drop) => if drop then () else {
        dropping = false
        list.push(out, x)
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
    else list.push(out, x)
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

// ── the accumulating cells ──
fn __fallible_reduce[A, E](xs: List[A], f: (A, A) -> Result[A, E]) -> Result[A?, E] = match list.first(xs) {
  none => ok(none),
  some(head) => match __fallible_fold(list.drop(xs, 1), head, f) {
    ok(v) => ok(some(v)),
    err(e) => err(e),
  },
}

fn __fallible_scan[A, B, E](xs: List[A], init: B, f: (B, A) -> Result[B, E]) -> Result[List[B], E] = {
  var out: List[B] = []
  var acc = init
  var failed: E? = none
  var stop = false
  for x in xs {
    if stop then ()
    else match f(acc, x) {
      ok(b) => {
        acc = b
        list.push(out, acc)
      },
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

// Pairs up to the shorter list, as the total form does.
fn __fallible_zip_with[A, B, C, E](xs: List[A], ys: List[B], f: (A, B) -> Result[C, E]) -> Result[List[C], E] = {
  var out: List[C] = []
  var failed: E? = none
  var stop = false
  for p in list.zip(xs, ys) {
    if stop then ()
    else match f(p.0, p.1) {
      ok(c) => list.push(out, c),
      err(e) => {
        failed = some(e)
        stop = true
      },
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

// An index outside the list leaves it unchanged without calling `f`.
fn __fallible_update[A, E](xs: List[A], i: Int, f: (A) -> Result[A, E]) -> Result[List[A], E] = if i < 0 then ok(xs)
else match list.get(xs, i) {
  none => ok(xs),
  some(v) => match f(v) {
    ok(nv) => ok(list.set(xs, i, nv)),
    err(e) => err(e),
  },
}

// `f` runs exactly `n` times, as in `iterate`; an err on any of them is the result.
fn __fallible_iterate[T, E](seed: T, f: (T) -> Result[T, E], n: Int) -> Result[List[T], E] = {
  var out: List[T] = []
  var x = seed
  var failed: E? = none
  var stop = false
  for _ in 0..<n {
    if stop then ()
    else {
      list.push(out, x)
      match f(x) {
        ok(y) => {
          x = y
        },
        err(e) => {
          failed = some(e)
          stop = true
        },
      }
    }
  }
  match failed {
    some(e) => err(e),
    none => ok(out),
  }
}

// ── the key-extracting cells ──
// The keys are computed first, once per element in list order (the first err
// stops there), then the total form runs over (key, element) pairs.
fn __fallible_sort_by[A, B, E](xs: List[A], f: (A) -> Result[B, E]) -> Result[List[A], E] = match __fallible_map(xs, f) {
  ok(keys) => ok(list.zip(keys, xs) |> list.sort_by((p) => p.0) |> list.map((p) => p.1)),
  err(e) => err(e),
}

// Groups in first-key order, each in list order — `group_by`'s own walk.
fn __fallible_group_by[A, B, E](xs: List[A], f: (A) -> Result[B, E]) -> Result[Map[B, List[A]], E] = match __fallible_map(xs, f) {
  ok(keys) => {
    var out: Map[B, List[A]] = map.new()
    var i = 0
    for x in xs {
      match list.get(keys, i) {
        some(k) => {
          out = match map.get(out, k) {
            some(g) => map.set(out, k, g + [x]),
            none => map.set(out, k, [x]),
          }
        },
        none => (),
      }
      i = i + 1
    }
    ok(out)
  },
  err(e) => err(e),
}

fn __fallible_unique_by[A, K, E](xs: List[A], f: (A) -> Result[K, E]) -> Result[List[A], E] = match __fallible_map(xs, f) {
  ok(keys) => ok(list.zip(keys, xs) |> list.unique_by((p) => p.0) |> list.map((p) => p.1)),
  err(e) => err(e),
}
