// http — bundled-Almide stdlib module.
//
// `HttpRequest` / `HttpResponse` are nominal types backed by Rust structs in
// `runtime/rs/src/http.rs`. They are NOT named `Request`/`Response` so the
// emitted Rust aliases never collide with a user/dependency `enum Response`.
// Both are an `HttpMessage` (R-http-12): `header`, `header_values`, `headers`,
// `body`, `body_bytes`, `set_header`, `set_body` and `set_body_bytes` are one
// generic function each, dispatching to the per-type `__http_request_*` /
// `__http_response_*` requirements below. A header list is
// `List[(String, String)]` in wire order, a repeated field kept (R-http-09);
// it crosses to the runtime flat, `[k1, v1, k2, v2, …]`.
//
// ABI split (drives the `@borrow_ref` / `@consume` sprinkling below):
// - Readers take `&AlmideHttp{Response,Request}` + `&str` keys — the struct
//   param needs `@borrow_ref`.
// - Writers take the struct owned (`mut resp: AlmideHttpResponse`) — the
//   default Ref would break, so `@consume`.
//
// `serve`'s handler slot is EFFECT-typed (#1055): the lambda checked against
// it gets effect-fn body ergonomics (`!` with propagation, effect calls), and
// its lowered shape is the effect carrier `Fn(...) -> Result<HttpResponse,
// String>` — exactly the contract the TCP listener loop has always expected.
// A handler `Err` becomes the loop's 500 response; a pure handler is
// Ok-wrapped by the checker's carrier typing, so both spellings arrive
// uniform.
import json
import url

/// Serves 0.0.0.0:port forever; handler err is a 500.
@intrinsic("almide_rt_http_serve")
@concurrent(handler)
@category("Net.listen")
effect fn serve(port: Int, handler: HttpHandler) -> Unit = _

// ── Response builders ──
//
// ADR-0032 (row 11e): a response's Content-Type is its body's TYPE. A `Body`
// (String, Bytes, Value, SafeHtml, TypedBody, a package's granted type) states its own media
// type; no header string can relabel it. Content-Type is the header the body
// owns: `set_header` and `with_headers` refuse it (E116 when the name is a
// literal, an abort otherwise), read off `@header_write`, which names the
// owned-header list below. A script-capable media type (HTML, SVG, XML) has
// no way in but its safe module's type; `typed` takes any other one, as a
// literal (E117), and refuses a type a safe module owns (`@media_owns`).
/// Reply with body; its type gives the Content-Type (String: text/plain; charset=utf-8).
fn response[B: Body](status: Int, body: B) -> HttpResponse = http.__http_response_flat(
  status,
  body.__self_to_text(),
  ["Content-Type", body.__self_media_type()],
)

/// Reply with Content-Type application/json; body is JSON text.
@intrinsic("almide_rt_http_json")
fn json(status: Int, body: String) -> HttpResponse = _

/// Reply with body and these headers in order after its Content-Type; a repeated name keeps its first spelling and last value.
@header_write(headers, owned="__http_response_body_headers")
fn with_headers[B: Body](status: Int, body: B, headers: List[(String, String)]) -> HttpResponse = {
  for h in headers {
    __http_response_owned_refusal("http.with_headers", h.0)
  }
  http.__with_headers(
    status,
    body.__self_to_text(),
    ["Content-Type", body.__self_media_type()] + __flat(headers),
  )
}

/// resp with its body replaced by body and its Content-Type by body's type.
fn with_body[B: Body](resp: HttpResponse, body: B) -> HttpResponse = http.__http_response_put_header(
  http.__http_response_put_body(resp, body.__self_to_text()),
  "Content-Type",
  body.__self_media_type(),
)

/// A body of media type media_type; a literal, never a script-capable or stdlib-owned one.
@literal_media(media_type)
fn typed(media_type: String, body: Bytes) -> TypedBody = TypedBody {
  media_type: media_type,
  bytes: body,
}

/// A body of a declared media type, built only by `http.typed`.
mod type TypedBody: Body = { media_type: String, bytes: Bytes }

fn __typed_body_media_type(b: TypedBody) -> String = b.media_type

fn __typed_body_to_text(b: TypedBody) -> String = bytes.to_string_lossy(b.bytes)

@intrinsic("almide_rt_http___with_headers")
@borrow_ref(flat)
local fn __with_headers(status: Int, body: String, flat: List[String]) -> HttpResponse = _

// A response holding exactly these header pairs, in order, each name written
// once by the caller: what `response` and `redirect` build, so a program that
// answers with one body never links with_headers' case-insensitive merge.
@intrinsic("almide_rt_http___http_response_flat")
@borrow_ref(flat)
local fn __http_response_flat(status: Int, body: String, flat: List[String]) -> HttpResponse = _

/// 302 with Location url, an empty body and Content-Type text/plain; charset=utf-8.
fn redirect(url: String) -> HttpResponse = http.__http_response_flat(
  302,
  "",
  ["Location", url, "Content-Type", string.__string_media_type("")],
)

// ── Response status ──
/// resp with code set; not range-checked.
@intrinsic("almide_http_set_status")
@consume(resp)
fn set_status(resp: HttpResponse, code: Int) -> HttpResponse = _

/// HTTP status code; 0 if the status line was bad.
@intrinsic("almide_http_status_code")
@borrow_ref(resp)
fn status(resp: HttpResponse) -> Int = _

// ── Headers and body of either message (R-http-12) ──
/// First value of header name, any case; none if absent.
fn header[M: HttpMessage](m: M, name: String) -> String? = m.__self_header(name)

/// Every value of header name, any case, in wire order; [] if absent.
fn header_values[M: HttpMessage](m: M, name: String) -> List[String] = m.__self_header_values(name)

/// Every header as (name, value), wire spelling and order, repeats kept.
fn headers[M: HttpMessage](m: M) -> List[(String, String)] = m.__self_headers()

/// Body text; a fetched body is decoded as lossy UTF-8.
fn body[M: HttpMessage](m: M) -> String = m.__self_body()

/// Body as bytes: a fetched body exactly as sent, a built one as the UTF-8 bytes of body(m).
fn body_bytes[M: HttpMessage](m: M) -> Bytes = m.__self_body_bytes()

/// m with header name set, any case: the first match replaced in place, else appended; a response refuses Content-Type.
fn set_header[M: HttpMessage](m: M, name: String, value: String) -> M = m.__self_set_header(
  name,
  value,
)

/// m with its body replaced; a response's Content-Type becomes text/plain; charset=utf-8.
fn set_body[M: HttpMessage](m: M, body: String) -> M = m.__self_set_body(body)

/// m with its body replaced by body, decoded as lossy UTF-8; a response's Content-Type becomes application/octet-stream.
fn set_body_bytes[M: HttpMessage](m: M, body: Bytes) -> M = m.__self_set_body_bytes(body)

// The response's HttpMessage requirements.
@intrinsic("almide_http_get_header")
@borrow_ref(m)
fn __http_response_header(m: HttpResponse, name: String) -> String? = _

@intrinsic("almide_http_header_values")
@borrow_ref(m)
fn __http_response_header_values(m: HttpResponse, name: String) -> List[String] = _

fn __http_response_headers(m: HttpResponse) -> List[(String, String)] = __pairs(http.__http_response_headers_flat(m))

@intrinsic("almide_http_headers_flat")
@borrow_ref(m)
fn __http_response_headers_flat(m: HttpResponse) -> List[String] = _

@intrinsic("almide_http_get_body")
@borrow_ref(m)
fn __http_response_body(m: HttpResponse) -> String = _

@intrinsic("almide_http_get_body_bytes")
@borrow_ref(m)
fn __http_response_body_bytes(m: HttpResponse) -> Bytes = _

@header_write(name, value, owned="__http_response_body_headers")
fn __http_response_set_header(m: HttpResponse, name: String, value: String) -> HttpResponse = {
  __http_response_owned_refusal("http.set_header", name)
  http.__http_response_put_header(m, name, value)
}

// A String body is text/plain; charset=utf-8 (ADR-0032 Q11): the body and its
// type are replaced together.
fn __http_response_set_body(m: HttpResponse, body: String) -> HttpResponse = with_body(m, body)

// The raw writers. Local: only the writers above reach them.
@intrinsic("almide_http_set_header")
@consume(m)
local fn __http_response_put_header(m: HttpResponse, name: String, value: String) -> HttpResponse = _

@intrinsic("almide_http_set_body")
@consume(m)
local fn __http_response_put_body(m: HttpResponse, body: String) -> HttpResponse = _

// The headers a response's body owns: written from its type, never by name.
local fn __http_response_body_headers() -> List[String] = ["Content-Type"]

// ASCII case-insensitive equality, as header names are compared (RFC 9110
// §5.1): the lengths first, then one character at a time, so nothing is built.
local fn __http_response_ci_eq(a: String, b: String) -> Bool = string.len(a) == string.len(b) and __http_response_ci_at(
  string.to_list(a),
  string.to_list(b),
  0,
)

local fn __http_response_ci_at(a: List[String], b: List[String], i: Int) -> Bool =
  if i >= list.len(a) then true
  else if __http_response_fold(list.get(a, i) ?? "") != __http_response_fold(list.get(b, i) ?? "") then false
  else __http_response_ci_at(a, b, i + 1)

local fn __http_response_fold(c: String) -> String = match string.index_of(
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  c,
) {
  some(i) => string.slice("abcdefghijklmnopqrstuvwxyz", i, i + 1),
  none => c,
}

local fn __http_response_owned_refusal(op: String, name: String) -> Unit =
  if __http_response_body_headers() |> list.any((h) => __http_response_ci_eq(h, name)) then panic("${op}: `${name}` is written from the body's type, never by name: answer with http.response(status, body), http.with_body(resp, body) or http.typed(media_type, bytes)")
  else ()

fn __http_response_set_body_bytes(m: HttpResponse, body: Bytes) -> HttpResponse = with_body(m, body)

// The request's HttpMessage requirements.
@intrinsic("almide_http_req_header")
@borrow_ref(m)
fn __http_request_header(m: HttpRequest, name: String) -> String? = _

@intrinsic("almide_http_req_header_values")
@borrow_ref(m)
fn __http_request_header_values(m: HttpRequest, name: String) -> List[String] = _

fn __http_request_headers(m: HttpRequest) -> List[(String, String)] = __pairs(http.__http_request_headers_flat(m))

@intrinsic("almide_http_req_headers_flat")
@borrow_ref(m)
fn __http_request_headers_flat(m: HttpRequest) -> List[String] = _

@intrinsic("almide_http_req_body")
@borrow_ref(m)
fn __http_request_body(m: HttpRequest) -> String = _

fn __http_request_body_bytes(m: HttpRequest) -> Bytes = bytes.from_string(http.__http_request_body(m))

@intrinsic("almide_http_req_set_header")
@consume(m)
fn __http_request_set_header(m: HttpRequest, name: String, value: String) -> HttpRequest = _

@intrinsic("almide_http_req_set_body")
@consume(m)
fn __http_request_set_body(m: HttpRequest, body: String) -> HttpRequest = _

fn __http_request_set_body_bytes(m: HttpRequest, body: Bytes) -> HttpRequest = http.__http_request_set_body(
  m,
  bytes.to_string_lossy(body),
)

// A header list crosses to the runtime flat: [k1, v1, k2, v2, …].
fn __flat(xs: List[(String, String)]) -> List[String] = xs |> list.flat_map(((k, v)) => [k, v])

fn __pairs(flat: List[String]) -> List[(String, String)] = list.range(0, list.len(flat) / 2) |> list.map((i) => (list.get(flat, 2 * i) ?? "", list.get(flat, 2 * i + 1) ?? ""))

// ── Request accessors (pure) ──
/// Request method as sent, e.g. GET.
@intrinsic("almide_http_req_method")
@borrow_ref(req)
fn method(req: HttpRequest) -> String = _

/// Request target, query string included (a full URL for a request built to send).
@intrinsic("almide_http_req_path")
@borrow_ref(req)
fn path(req: HttpRequest) -> String = _

// The query is `url.parse_query` of the target's text after its FIRST `?`:
// one decoder, defined once, the same on every leg (ALS-R5, C-404, #4117).
// Every pair is kept in arrival order (a repeated key appears as often as it
// was sent), a bare key has value "", `+` is a space, and a bad escape or
// invalid UTF-8 is an err naming http.query_params.
// Example: match http.query_params(http.new_request("GET", "/p?a=1?b=2&a=3", "", [])) { ok(ps) => ps == [("a", "1?b=2"), ("a", "3")], err(_) => false }
// Example: match http.query_params(http.new_request("GET", "/p?k=%zz", "", [])) { ok(_) => false, err(e) => e == "http.query_params: invalid percent escape" }
/// url.parse_query of the target after its first ?; pairs in order; err on a bad escape.
fn query_params(req: HttpRequest) -> Result[List[(String, String)], String] = match url.parse_query(__query_of(http.path(req))) {
  ok(ps) => ok(ps),
  err(e) => err(string.replace(e, "url.parse_query", "http.query_params")),
}

// ── HTTP client (effect) ──
// ANY complete response is `Ok` — a 404 or a 3xx included; `Err` is a
// transport failure only. Redirects are NEVER followed: the 3xx and its
// `Location` header are the answer. The one-shot forms are `get` / `request`
// (the body text) and `get_response` / `send` (the whole response); `start`
// is the handle.
/// Body even for a 404; err only on transport.
@intrinsic("almide_http_get")
effect fn get(url: String) -> Result[String, String] = _

/// Reply body for any method; any status is ok.
@category("Net.fetch")
effect fn request(method: String, url: String, body: String, headers: List[(String, String)]) -> Result[String, String] = http.__request(
  method,
  url,
  body,
  __flat(headers),
)

@intrinsic("almide_http_request")
@borrow_ref(flat)
effect fn __request(method: String, url: String, body: String, flat: List[String]) -> Result[String, String] = _

/// Whole reply, 404 included; redirects not followed.
@intrinsic("almide_http_get_response")
effect fn get_response(url: String) -> Result[HttpResponse, String] = _

/// Sends req to the URL its target names; the whole reply, any status; redirects not followed.
@category("Net.fetch")
effect fn send(req: HttpRequest) -> Result[HttpResponse, String] = http.__request_response(
  http.method(req),
  http.path(req),
  http.__http_request_body(req),
  http.__http_request_headers_flat(req),
)

@intrinsic("almide_http_request_response")
@borrow_ref(flat)
effect fn __request_response(method: String, url: String, body: String, flat: List[String]) -> Result[HttpResponse, String] = _

// ── Call handle and per-call limits (#2631) ──
//
// `start` returns at once with an `HttpCall`; a runtime thread does the
// exchange. `poll` and `read_new` never block, `wait` blocks until the call
// ends (bounded by its limits), `cancel` closes the connection — and so does
// dropping the last copy of the handle. Limits are per call, in ms, 0 = no
// limit: `total_ms` is a wall clock from `start` (dial, first byte and body
// all count), `idle_ms` the longest gap between bytes (the wait for the first
// byte counts). A fired limit is `err("request timeout: total_ms <n>
// exceeded")` / `err("request timeout: idle_ms <n> exceeded")`; a cancelled
// call is `err("request cancelled")`. ALMIDE_HTTP_TIMEOUT_SECS stays the
// default of the calls that take no limits. A streamed body is read with
// `read_new` between `poll`s (R-http-01: the callback clients are gone).
//
// FAMILY RULE (machine-checked by tests/http_call_family_gate_test.rs): the
// handle has exactly the five verbs start / poll / read_new / wait / cancel.
/// Per-call limits in ms; 0 = no limit.
type HttpLimits = { total_ms: Int, idle_ms: Int }

/// Begins sending req; returns at once with a handle.
@category("Net.fetch")
effect fn start(req: HttpRequest, limits: HttpLimits) -> Result[HttpCall, String] = __call_start(
  http.method(req),
  http.path(req),
  http.__http_request_body(req),
  http.__http_request_headers_flat(req),
  limits.total_ms,
  limits.idle_ms,
)

@intrinsic("almide_rt_http___call_start")
@borrow_ref(flat)
effect fn __call_start(method: String, url: String, body: String, flat: List[String], total_ms: Int, idle_ms: Int) -> Result[HttpCall, String] = _

/// Never blocks: none while running, then the result.
@intrinsic("almide_http_call_poll")
@borrow_ref(c)
effect fn poll(c: HttpCall) -> Result[HttpResponse, String]? = _

/// Body text since the last read_new; never blocks.
@intrinsic("almide_http_call_read_new")
@borrow_ref(c)
effect fn read_new(c: HttpCall) -> String = _

/// Blocks until the call ends; any status is ok.
@intrinsic("almide_http_call_wait")
@borrow_ref(c)
effect fn wait(c: HttpCall) -> Result[HttpResponse, String] = _

/// Closes the connection; the call ends as err.
@intrinsic("almide_http_call_cancel")
@borrow_ref(c)
effect fn cancel(c: HttpCall) -> Unit = _

// ── Server: handlers, routes, middleware (#2588) ──
//
// A handler is a plain function from a request to a response, and so are a
// router and a wrapped app: `serve` is one host's way of running a handler,
// `new_request` is a test's way — an app is tested by calling it, with no
// socket. Middleware is `(HttpHandler) -> HttpHandler`; per-request data is
// passed as arguments, never through a mutable context.
//
// FAMILY RULE (#2588, gated by proofs/target-availability.toml): every
// HttpRequest reader — method / path / header / header_values / headers /
// body / body_bytes / query_params / param — answers a request built by
// `new_request`, so the availability probe builds its HttpRequest argument
// that way and no reader is `unprobed` on any leg.
/// Request to response; a router is one too.
type HttpHandler = effect (HttpRequest) -> HttpResponse

/// Wraps a handler: (next) => (req) => … next(req)! ….
type HttpMiddleware = (HttpHandler) -> HttpHandler

/// Route table row; build it with route or mount.
type HttpRoute = { method: String, pattern: String, segments: List[String], handler: HttpHandler }

/// Request built in code; target keeps its ?query (a full URL for send / start).
fn new_request(method: String, target: String, body: String, headers: List[(String, String)]) -> HttpRequest = {
  let flat = __flat(headers)
  http.__new_request(method, target, body, flat)
}

@intrinsic("almide_rt_http___new_request")
@borrow_ref(flat)
fn __new_request(method: String, target: String, body: String, flat: List[String]) -> HttpRequest = _

/// Router-bound path parameter, decoded; none if unbound.
@intrinsic("almide_http_param")
@borrow_ref(req)
fn param(req: HttpRequest, name: String) -> String? = _

@intrinsic("almide_http_req_with_params")
@consume(req)
@borrow_ref(flat)
fn __with_params(req: HttpRequest, flat: List[String]) -> HttpRequest = _

@intrinsic("almide_http_req_with_path")
@consume(req)
fn __with_path(req: HttpRequest, target: String) -> HttpRequest = _

// The declared reprs of the two value types (#4204, after #2647): what
// `${req}` / `${resp}` shows, bare or nested in a record, list or option, on
// every leg. The headers are COUNTED, never listed — a logged request does not
// carry its Authorization / Cookie values. Named after the runtime-backed row
// (`stdlib_info::runtime_backed_repr_surface`), so the display engine finds
// them from the type, not from a list.
@intrinsic("almide_http_req_repr")
@borrow_ref(req)
fn __http_request_repr(req: HttpRequest) -> String = _

@intrinsic("almide_http_call_repr")
@borrow_ref(c)
fn __http_call_repr(c: HttpCall) -> String = _

@intrinsic("almide_http_resp_repr")
@borrow_ref(resp)
fn __http_response_repr(resp: HttpResponse) -> String = _

fn __path_of(target: String) -> String = match string.index_of(target, "?") {
  some(i) => string.take(target, i),
  none => target,
}

fn __query_of(target: String) -> String = match string.index_of(target, "?") {
  some(i) => string.drop(target, i + 1),
  none => "",
}

// Empty segments do not count: `/users/` and `/users` are one path.
fn __parts(path: String) -> List[String] = string.split(path, "/") |> list.filter((s) => s != "")

// A path segment percent-decoded; `+` is a literal plus in a path.
fn __decode_part(s: String) -> String = url.decode_form(string.replace(s, "+", "%2B")) ?? s

fn __is_hex(c: String) -> Bool = c != "" and string.contains("0123456789abcdefABCDEF", c)

// Some `%` is not followed by two hex digits: the path is not percent-encoded.
// Every piece after a `%` must start with two hex digits — one pass over the
// path, where recursing over its chars with `list.drop` copied the rest of
// the path per char, O(L²) in the request.
fn __bad_escape(path: String) -> Bool = string.split(path, "%") |> list.drop(1) |> list.any((p) => not __hex_pair(p))

// ONE canonical path for the router and the middleware in front of it (C-406,
// #4133): the router answers 400 to a path it would otherwise read differently
// from a `req_path` guard — an empty segment (`//admin`), a `.` or `..`
// segment, a percent-encoded unreserved byte (`%61dmin`, `%2e`), a backslash
// or a control character. What reaches a handler through the router is
// therefore exactly what a middleware's `req_path` check saw. `%2F` stays
// encoded (an encoded slash is not a separator), and a trailing `/` is kept.
// `%XX` that decodes to an unreserved character (RFC 3986: ALPHA / DIGIT /
// "-" / "." / "_" / "~"), which a canonical path spells literally.
fn __encodes_unreserved(p: String) -> Bool = match url.decode_component("%" + string.take(p, 2)) {
  ok(c) => string.len(c) == 1 and string.contains(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~",
    c,
  ),
  err(_) => false,
}

fn __canonical(path: String) -> Bool = {
  let segs = string.split(string.drop(path, 1), "/")
  let n = list.len(segs)
  let empty_inner = list.enumerate(segs) |> list.any(((i, s)) => s == "" and i + 1 < n)
  let dot = segs |> list.any((s) => s == "." or s == "..")
  let unreserved = string.split(path, "%") |> list.drop(1) |> list.any((p) => __encodes_unreserved(p))
  let odd = string.to_list(path) |> list.any((c) => c == "\\" or (string.to_codepoint(c) ?? 0) < 32 or (string.to_codepoint(c) ?? 0) == 127)
  not empty_inner and not dot and not unreserved and not odd
}

// A bound parameter (C-406, #4134) must not decode to `.` or `..` or hold a
// `/`, `\` or NUL: `/u/..%2F..%2Fetc%2Fpasswd` would hand a handler
// `../../etc/passwd`. A `{name...}` tail is checked segment by segment; the
// anonymous `{...}` of a mount is checked by the sub-app's own router.
fn __param_bad(v: String) -> Bool = v == "." or v == ".." or string.contains(v, "/") or string.contains(
  v,
  "\\",
) or string.contains(v, "\u{0}")

fn __bad_binding(segs: List[String], parts: List[String]) -> Bool = {
  let fixed = segs |> list.take_while((s) => not __is_rest(s))
  let n = list.len(fixed)
  let fixed_bad = list.zip(fixed, parts) |> list.any(((s, part)) => __is_param(s) and __param_bad(__decode_part(part)))
  let rest_bad = match list.get(segs, n) {
    some(r) => __name_of(r) != "" and (list.drop(parts, n) |> list.any((part) => __param_bad(__decode_part(part)))),
    none => false,
  }
  fixed_bad or rest_bad
}

fn __hex_pair(p: String) -> Bool = {
  let cs = string.to_list(string.take(p, 2))
  list.len(cs) == 2 and list.all(cs, __is_hex)
}

fn __is_rest(s: String) -> Bool = string.starts_with(s, "{") and string.ends_with(s, "...}")

fn __is_param(s: String) -> Bool = string.starts_with(s, "{") and string.ends_with(s, "}") and not __is_rest(s)

fn __name_of(s: String) -> String = if __is_rest(s) then string.slice(s, 1, string.len(s) - 4)
else string.slice(s, 1, string.len(s) - 1)

// "end" past the last segment, else "lit", "param" (`{name}`) or "rest" (`{name...}`).
fn __kind(s: String?) -> String = match s {
  none => "end",
  some(x) => if __is_rest(x) then "rest"
  else if __is_param(x) then "param" else "lit",
}

fn __pattern_path(pattern: String) -> String = match string.index_of(pattern, " ") {
  some(i) => string.trim(string.drop(pattern, i + 1)),
  none => pattern,
}

/// "GET /users/{id}" to a route; no method = any.
@concurrent(handler)
fn route(pattern: String, handler: HttpHandler) -> HttpRoute = {
  let p = string.trim(pattern)
  let verb = match string.index_of(p, " ") {
    some(i) => string.take(p, i),
    none => "",
  }
  { method: verb, pattern: p, segments: __parts(__pattern_path(p)), handler: handler }
}

/// Sub-app under prefix: /api/x reaches it as /x.
@concurrent(sub)
fn mount(prefix: String, sub: HttpHandler) -> HttpRoute = {
  let p = string.trim(prefix)
  { method: "", pattern: p + "/{...}", segments: __parts(p) + ["{...}"], handler: __mounted(sub) }
}

// The anonymous `{...}` binds the rest of the path undecoded, so the sub-app
// decodes each segment exactly once.
fn __mounted(sub: HttpHandler) -> HttpHandler = (req) => {
  let q = __query_of(http.path(req))
  let rest = http.param(req, "") ?? ""
  sub(http.__with_path(req, "/" + rest + (if q == "" then "" else "?" + q)))!
}

// The `[name, value, …]` bindings when a pattern matches the path's parts.
// The segments before a `{name...}` match the parts one for one; the rest
// param, if any, binds whatever is left. Pairing by `list.zip` walks each list
// once, where dropping one part per segment copied the parts per step.
fn __bind(segs: List[String], parts: List[String]) -> List[String]? = {
  let fixed = segs |> list.take_while((s) => not __is_rest(s))
  let n = list.len(fixed)
  let rest = list.get(segs, n)
  let pairs = list.zip(fixed, parts)
  let fits = if rest == none then list.len(parts) == n else list.len(parts) >= n
  if not fits or not list.all(pairs, ((s, part)) => __is_param(s) or __decode_part(part) == s) then none
  else {
    let bound = pairs |> list.filter(((s, _)) => __is_param(s)) |> list.flat_map(((s, part)) => [__name_of(s), __decode_part(part)])
    match rest {
      none => some(bound),
      some(r) => some(bound + __bind_rest(__name_of(r), list.drop(parts, n))),
    }
  }
}

// `{name...}` binds the remaining parts decoded; the anonymous `{...}` of a
// mount binds them undecoded.
fn __bind_rest(name: String, parts: List[String]) -> List[String] = [
  name,
  if name == "" then list.join(parts, "/")
  else parts |> list.map(__decode_part) |> list.join("/")
]

// Every path `a` matches, `b` matches too: `a` is at least as specific.
fn __covers(a: List[String], b: List[String]) -> Bool = {
  let ka = __kind(list.first(a))
  let kb = __kind(list.first(b))
  if kb == "rest" then true
  else if ka == "rest" then false
  else if ka == "end" or kb == "end" then ka == kb
  else if ka == "lit" and kb == "lit" and list.first(a) != list.first(b) then false
  else if ka == "param" and kb == "lit" then false else __covers(list.drop(a, 1), list.drop(b, 1))
}

// Some path is matched by both.
fn __overlaps(a: List[String], b: List[String]) -> Bool = {
  let ka = __kind(list.first(a))
  let kb = __kind(list.first(b))
  if ka == "rest" or kb == "rest" then true
  else if ka == "end" or kb == "end" then ka == kb
  else if ka == "lit" and kb == "lit" and list.first(a) != list.first(b) then false else __overlaps(
    list.drop(a, 1),
    list.drop(b, 1),
  )
}

fn __route_covers(a: HttpRoute, b: HttpRoute) -> Bool = (b.method == "" or a.method == b.method) and __covers(
  a.segments,
  b.segments,
)

// Go 1.22's rule: two routes some request matches, neither more specific
// than the other (two spellings of one pattern included).
fn __conflict(a: HttpRoute, b: HttpRoute) -> Bool = (a.method == "" or b.method == "" or a.method == b.method) and __overlaps(
  a.segments,
  b.segments,
) and __route_covers(a, b) == __route_covers(b, a)

fn __segment_ok(s: String, last: Bool) -> Bool = if __is_rest(s) then last and not string.contains(
  __name_of(s),
  "{",
) and not string.contains(__name_of(s), "}")
else if __is_param(s) then __name_of(s) != "" and not string.contains(__name_of(s), "{") and not string.contains(
  __name_of(s),
  "}",
)
else not string.contains(s, "{") and not string.contains(s, "}")

fn __method_ok(m: String) -> Bool = string.to_list(m) |> list.all((c) => string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c))

fn __pattern_problems(r: HttpRoute) -> List[String] = {
  let last = list.len(r.segments) - 1
  let names = r.segments |> list.filter((s) => __is_param(s) or __is_rest(s)) |> list.map((s) => __name_of(s)) |> list.filter((n) => n != "")
  let checks = [
    (__method_ok(r.method), "the method must be upper-case letters"),
    (string.starts_with(__pattern_path(r.pattern), "/"), "the path must start with /"),
    (list.enumerate(r.segments) |> list.all(((i, s)) => __segment_ok(s, i == last)), "a segment is a literal, {name} or a last {name...}"),
    (list.len(list.unique(names)) == list.len(names), "a name is bound twice")
  ]
  checks |> list.filter(((ok_, _)) => not ok_) |> list.map(((_, why)) => "\"${r.pattern}\": ${why}")
}

fn __problems(routes: List[HttpRoute]) -> List[String] = {
  let own = routes |> list.flat_map((r) => __pattern_problems(r))
  let conflicts = list.enumerate(routes) |> list.flat_map(((i, a)) => list.drop(routes, i + 1) |> list.filter((b) => __conflict(a, b)) |> list.map((b) => "\"${a.pattern}\" and \"${b.pattern}\" conflict"))
  own + conflicts
}

fn __not_allowed(hits: List[(HttpRoute, List[String])]) -> HttpResponse = {
  let methods = hits |> list.map(((r, _)) => r.method) |> list.filter((m) => m != "") |> list.unique
  let allow = if list.contains(methods, "GET") and not list.contains(methods, "HEAD") then methods + ["HEAD"]
  else methods
  http.set_header(
    http.response(405, "Method Not Allowed"),
    "Allow",
    allow |> list.sort |> list.join(", "),
  )
}

@category
effect fn __dispatch(hits: List[(HttpRoute, List[String])], req: HttpRequest) -> HttpResponse = {
  let verb = http.method(req)
  let target_path = __path_of(http.path(req))
  if not string.starts_with(target_path, "/") then http.response(
    400,
    "Bad Request: the request target must start with /",
  )
  else if __bad_escape(target_path) then http.response(
    400,
    "Bad Request: malformed percent-encoding in the path",
  )
  else if not __canonical(target_path) then http.response(
    400,
    "Bad Request: the path is not in canonical form",
  )
  else {
    let exact = hits |> list.filter(((r, _)) => r.method == verb or r.method == "")
    let via_get = verb == "HEAD" and list.is_empty(exact)
    let allowed = if via_get then hits |> list.filter(((r, _)) => r.method == "GET")
    else exact
    match allowed |> list.find(((a, _)) => list.all(allowed, ((b, _)) => __route_covers(a, b))) {
      some((r, bound)) => if __bad_binding(r.segments, __parts(target_path)) then http.response(
        400,
        "Bad Request: a path parameter is a dot segment or holds a /, \\ or NUL",
      )
      else {
        let res = r.handler(http.__with_params(req, bound))!
        if via_get then http.__http_response_put_body(res, "") else res
      },
      none => if list.is_empty(hits) then http.response(404, "Not Found") else __not_allowed(hits),
    }
  }
}

// The route table's lambda computes the matching routes itself: `routes` stays
// a capture, never a param a callee would have to own.
fn __table(routes: List[HttpRoute]) -> HttpHandler = (req) => {
  let parts = __parts(__path_of(http.path(req)))
  let hits = routes |> list.filter_map((r) => __bind(r.segments, parts) |> option.map((bound) => (r, bound)))
  __dispatch(hits, req)!
}

/// Route table as a handler; err on conflicting routes.
fn router(xs: List[HttpRoute]) -> Result[HttpHandler, String] = {
  let problems = __problems(xs)
  if list.is_empty(problems) then ok(__table(xs)) else err("http.router: " + list.join(
    problems,
    "; ",
  ))
}

/// Applies middleware; the first is the outermost.
@concurrent(handler, middleware)
fn wrap(handler: HttpHandler, middleware: List[HttpMiddleware]) -> HttpHandler = list.reverse(middleware) |> list.fold(
  handler,
  (inner, mw) => __apply(mw, inner),
)

// Named rather than inline `mw(inner)`: the wasm legs return a handler out
// of an `if` only through a call they can resolve. `wrap` applies the LAST
// middleware first, one fold step each: the recursion it replaces copied
// the rest of the list on every step (`list.take`), O(n²) in middleware.
fn __apply(mw: HttpMiddleware, inner: HttpHandler) -> HttpHandler = mw(inner)

// Row 22 (C-436): T is an input type — a `: Decode` record that is not also
// `Encode`; a `Codec` T is E110 at the call (`@input_sink`). The body decodes
// with `T.decode_strict`, so a key outside T's fields (an input type skips no
// field, E053) is `400 Bad Request: unknown key '<k>'`.
/// JSON body into input type T, strictly; err is a 400 response.
@input_sink
fn decode_json[T: Decode](req: HttpRequest) -> Result[T, HttpResponse] = match json.parse(http.__http_request_body(req)) {
  ok(v) => match T.decode_strict(v) {
    ok(x) => ok(x),
    err(e) => err(http.response(400, "Bad Request: " + e)),
  },
  err(e) => err(http.response(400, "Bad Request: the body is not JSON (" + e + ")")),
}
