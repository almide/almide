// http — bundled-Almide stdlib module.
//
// Migrated to `@intrinsic` + per-fn borrow overrides. `HttpRequest` /
// `HttpResponse` are nominal types backed by Rust structs in
// `runtime/rs/src/http.rs`. They are NOT named `Request`/`Response` so the
// emitted Rust aliases never collide with a user/dependency `enum Response`.
//
// ABI split (drives the `@borrow_ref` / `@consume` sprinkling below):
// - Accessors (`get_body` / `get_header` / `req_*` / `query_params`)
//   take `&AlmideHttp{Response,Request}` + `&str` keys — plain
//   `@intrinsic` resolves the `&str` via the default `String → RefStr`
//   inference; the struct param needs `@borrow_ref`.
// - Mutators (`set_status` / `set_header` / `set_cookie`) take the
//   struct owned (`mut resp: AlmideHttpResponse`) — the default Ref
//   would break, so `@consume(resp)`.
// - HTTP client (`get`/`post`/...) take `&str` URLs and bodies —
//   plain pass-through once `Map` heads get `@borrow_ref(headers)`.
//
// `serve`'s handler slot is EFFECT-typed (#1055): the lambda checked against
// it gets effect-fn body ergonomics (`!` with propagation, effect calls), and
// its lowered shape is the effect carrier `Fn(...) -> Result<HttpResponse,
// String>` — exactly the contract the TCP listener loop has always expected.
// A handler `Err` becomes the loop's 500 response; a pure handler is
// Ok-wrapped by the checker's carrier typing, so both spellings arrive
// uniform.
import json

/// Serves 0.0.0.0:port forever; handler err is a 500.
@intrinsic("almide_rt_http_serve")
effect fn serve(port: Int, f: effect (HttpRequest) -> HttpResponse) -> Unit = _

// ── Response builders ──
/// Reply with Content-Type text/plain.
@intrinsic("almide_rt_http_response")
fn response(status: Int, body: String) -> HttpResponse = _

// Safe HTML response — body must be SafeHtml (XSS-proof by construction).
// Use html.escape() or html.raw() to create SafeHtml values.
// Note: http is a bundled stdlib module and cannot import html directly.
// Users call: http.response(status, html.to_string(body))
// A convenience wrapper will be added when cross-bundled-module calls are supported.
/// Reply with Content-Type application/json.
@intrinsic("almide_rt_http_json")
fn json(status: Int, body: String) -> HttpResponse = _

/// Reply with headers as-is; no default Content-Type.
@intrinsic("almide_rt_http_with_headers")
@borrow_ref(headers)
fn with_headers(status: Int, body: String, headers: Map[String, String]) -> HttpResponse = _

/// 302 with Location url and empty body.
@intrinsic("almide_rt_http_redirect")
fn redirect(url: String) -> HttpResponse = _

// ── Response accessors/mutators ──
/// resp with code set; not range-checked.
@intrinsic("almide_http_set_status")
@consume(resp)
fn status(resp: HttpResponse, code: Int) -> HttpResponse = _

/// Payload text; lossy UTF-8 when fetched.
@intrinsic("almide_http_get_body")
@borrow_ref(resp)
fn body(resp: HttpResponse) -> String = _

/// Case-insensitive upsert of header key.
@intrinsic("almide_http_set_header")
@consume(resp)
fn set_header(resp: HttpResponse, key: String, value: String) -> HttpResponse = _

/// First value for key, any case; none if absent.
@intrinsic("almide_http_get_header")
@borrow_ref(resp)
fn get_header(resp: HttpResponse, key: String) -> String? = _

// Read side of the response record (#1791). `status_code` is the GETTER
// twin of `status(resp, code)`; `header_values` keeps a repeated field
// (`Set-Cookie`) whole where `get_header` answers the first occurrence;
// `headers` is the lowercased-name map, first value wins — the one rule
// `get_header` / `req_header` already apply — so a repeated field is read
// through `header_values`, never through the map.
/// HTTP status; 0 if the status line was bad.
@intrinsic("almide_http_status_code")
@borrow_ref(resp)
fn status_code(resp: HttpResponse) -> Int = _

/// Map by lowercased name; first value wins.
@intrinsic("almide_http_headers")
@borrow_ref(resp)
fn headers(resp: HttpResponse) -> Map[String, String] = _

/// Every value for key, wire order; [] if absent.
@intrinsic("almide_http_header_values")
@borrow_ref(resp)
fn header_values(resp: HttpResponse, key: String) -> List[String] = _

// ── Request accessors (pure) ──
/// Request method as sent, e.g. GET.
@intrinsic("almide_http_req_method")
@borrow_ref(req)
fn req_method(req: HttpRequest) -> String = _

/// Request target, query string included.
@intrinsic("almide_http_req_path")
@borrow_ref(req)
fn req_path(req: HttpRequest) -> String = _

/// Body text; empty without a Content-Length.
@intrinsic("almide_http_req_body")
@borrow_ref(req)
fn req_body(req: HttpRequest) -> String = _

/// First value for key, any case; none if absent.
@intrinsic("almide_http_req_header")
@borrow_ref(req)
fn req_header(req: HttpRequest, key: String) -> String? = _

/// Decoded query map; last duplicate wins.
@intrinsic("almide_http_query_params")
@borrow_ref(req)
fn query_params(req: HttpRequest) -> Map[String, String] = _

// Percent-decode a URL component (`+` → space, `%XX` → byte). `query_params`
// already decodes its values; use this for manually-extracted query/form text.
/// + to space, %XX to byte; bad escapes kept.
@intrinsic("almide_http_url_decode")
fn url_decode(s: String) -> String = _

// ── HTTP client (effect) ──
/// Body even for a 404; err only on transport.
@intrinsic("almide_http_get")
effect fn get(url: String) -> Result[String, String] = _

/// Reply body of a POST; JSON type by default.
@intrinsic("almide_http_post")
effect fn post(url: String, body: String) -> Result[String, String] = _

/// Reply body of a PUT; JSON type by default.
@intrinsic("almide_http_put")
effect fn put(url: String, body: String) -> Result[String, String] = _

/// Reply body of a PATCH; JSON type by default.
@intrinsic("almide_http_patch")
effect fn patch(url: String, body: String) -> Result[String, String] = _

/// Reply body of a DELETE; any status is ok.
@intrinsic("almide_http_delete")
effect fn delete(url: String) -> Result[String, String] = _

/// Reply body for any method; any status is ok.
@intrinsic("almide_http_request")
@borrow_ref(headers)
effect fn request(method: String, url: String, body: String, headers: Map[String, String]) -> Result[String, String] = _

// Status-preserving client: returns `(status_code, body)` for ANY complete
// response — a 404 is `Ok((404, body))`, not an `Err`. `Err` is only a
// transport failure (connection / TLS / timeout). Use these when you need to
// branch on the numeric status; `get` / `request` collapse it into the body.
/// (status, body); a 404 is ok, not err.
@intrinsic("almide_http_get_status")
effect fn get_status(url: String) -> Result[(Int, String), String] = _

/// (status, body) for any method; 3xx not followed.
@intrinsic("almide_http_request_status")
@borrow_ref(headers)
effect fn request_status(method: String, url: String, body: String, headers: Map[String, String]) -> Result[(Int, String), String] = _

// Full-response client (#1791): the `*_response` twin of EVERY verb-shaped
// String client above — same parameters, `Result[HttpResponse, String]` back.
// FAMILY RULE (machine-checked by tests/http_response_family_gate_test.rs):
// each of get / post / put / patch / delete / request has exactly one
// `<verb>_response` twin with the same parameter list; the body-only fn is
// the `body` projection of its twin and `request_status` the (status, body)
// projection, so the three shapes answer from ONE exchange. Intentional
// omissions: `get_status` / `get_bytes` / `request_bytes` are result-SHAPE
// variants, not verbs (they get no twin), and `request_stream` carries no
// response record (its body is delivered chunk-wise to the callback).
//
// ANY complete response is `Ok` — a 404 or a 3xx included; `Err` is a
// transport failure only. Redirects are NEVER followed: the 3xx and its
// `Location` header are the answer, and the response is always to the URL
// the caller passed. Header names keep their wire spelling and a repeated
// field keeps every occurrence — read them with `get_header` (first),
// `header_values` (all) or `headers` (lowercased map, first wins).
/// Whole reply, 404 included; redirects not followed.
@intrinsic("almide_http_get_response")
effect fn get_response(url: String) -> Result[HttpResponse, String] = _

/// Whole reply to a POST; any status is ok.
@intrinsic("almide_http_post_response")
effect fn post_response(url: String, body: String) -> Result[HttpResponse, String] = _

/// Whole reply to a PUT; any status is ok.
@intrinsic("almide_http_put_response")
effect fn put_response(url: String, body: String) -> Result[HttpResponse, String] = _

/// Whole reply to a PATCH; any status is ok.
@intrinsic("almide_http_patch_response")
effect fn patch_response(url: String, body: String) -> Result[HttpResponse, String] = _

/// Whole reply to a DELETE; any status is ok.
@intrinsic("almide_http_delete_response")
effect fn delete_response(url: String) -> Result[HttpResponse, String] = _

/// Whole reply for any method; 3xx not followed.
@intrinsic("almide_http_request_response")
@borrow_ref(headers)
effect fn request_response(method: String, url: String, body: String, headers: Map[String, String]) -> Result[HttpResponse, String] = _

// Binary client: returns the raw response body as `Bytes` with no UTF-8
// conversion, so binary payloads (images, audio — e.g. TTS mp3/wav) survive
// byte-identical. The String client above corrupts non-UTF-8 bodies.
/// Raw body bytes, not UTF-8 decoded.
@intrinsic("almide_http_get_bytes")
effect fn get_bytes(url: String) -> Result[Bytes, String] = _

/// Raw body bytes for any method and headers.
@intrinsic("almide_http_request_bytes")
@borrow_ref(headers)
effect fn request_bytes(method: String, url: String, body: String, headers: Map[String, String]) -> Result[Bytes, String] = _

// Streaming HTTP request. The on_chunk callback is invoked with each
// raw body chunk as it arrives on the wire. Supports `Transfer-Encoding:
// chunked` (Server-Sent Events shape) and plain bodies. The callback is
// the caller's job to do SSE line splitting / event parsing.
/// Body chunks to on_chunk; err on a non-2xx.
@intrinsic("almide_http_request_stream")
@borrow_ref(headers)
effect fn request_stream(method: String, url: String, body: String, headers: Map[String, String], on_chunk: (String) -> Unit) -> Result[Unit, String] = _

// OpenAI-compatible /chat/completions SSE helper. The runtime opens the
// stream, parses each `data: {...}` event, calls `on_text_delta` with
// each new content fragment for live rendering, and accumulates
// content / tool_calls / usage on its own. Returns a JSON string shaped
// like a non-streaming LLMResponse:
//
//   {"content":"...","model":"...","usage":{...},"finish_reason":"...",
//    "tool_calls":[{"id":"...","name":"...","arguments":"..."}]}
//
// `body_json` must already include `"stream": true`. The almai layer
// (or any caller) is expected to `json.parse` the result.
/// Streams base_url/chat/completions; LLM-response JSON.
@intrinsic("almide_rt_sse_openai_chat")
effect fn openai_streaming_call(base_url: String, api_key: String, body_json: String, on_text_delta: (String) -> Unit) -> Result[String, String] = _

// Anthropic Messages API streaming. Same return shape as
// `openai_streaming_call`; the runtime translates Anthropic's distinct
// SSE event format (`event: content_block_delta` etc.) into the same
// LLMResponse-shaped JSON ({content, model, usage, finish_reason,
// tool_calls}).
/// Streams Anthropic Messages; LLM-response JSON.
@intrinsic("almide_rt_sse_anthropic_messages")
effect fn anthropic_streaming_call(api_key: String, body_json: String, on_text_delta: (String) -> Unit) -> Result[String, String] = _

// ── Call handle and per-call limits (#2631) ──
//
// `start` returns at once with an `HttpCall`; a runtime thread does the
// exchange. `poll` and `read_new` never block, `wait` blocks until the call
// ends (bounded by its limits), `cancel` closes the connection — and so does
// dropping the last copy of the handle. Limits are per call, in ms, 0 = no
// limit: `total_ms` is a wall clock from `start` (dial, first byte and body
// all count), `idle_ms` the longest gap between bytes (the wait for the first
// byte counts). A fired limit is `err("request timeout: total_ms <n>
// exceeded")` / `err("request timeout: idle_ms <n> exceeded")`; a cancelled
// call is `err("request cancelled")`. ALMIDE_HTTP_TIMEOUT_SECS stays the
// default of the calls that take no limits.
//
// FAMILY RULE (machine-checked by tests/http_call_family_gate_test.rs): the
// handle has exactly the five verbs start / poll / read_new / wait / cancel,
// and every streaming client — request_stream, openai_streaming_call,
// anthropic_streaming_call — has exactly one `<name>_with_limits` twin: the
// same parameters with `limits: HttpLimits` inserted before the callback, the
// same return type, built on the handle. Intentional omissions: the one-shot
// clients (get / request / *_response / *_status / *_bytes) get no twin —
// `start` + `wait` is their limited form, answering the `request_response`
// record.
/// Per-call limits in ms; 0 = no limit.
type HttpLimits = { total_ms: Int, idle_ms: Int }

/// Begins a request; returns at once with a handle.
effect fn start(method: String, url: String, body: String, headers: Map[String, String], limits: HttpLimits) -> Result[HttpCall, String] = __call_start(
  method,
  url,
  body,
  headers,
  limits.total_ms,
  limits.idle_ms,
)

@intrinsic("almide_rt_http___call_start")
@borrow_ref(headers)
effect fn __call_start(method: String, url: String, body: String, headers: Map[String, String], total_ms: Int, idle_ms: Int) -> Result[HttpCall, String] = _

/// Never blocks: none while running, then the result.
@intrinsic("almide_http_call_poll")
@borrow_ref(c)
effect fn poll(c: HttpCall) -> Result[HttpResponse, String]? = _

/// Body text since the last read_new; never blocks.
@intrinsic("almide_http_call_read_new")
@borrow_ref(c)
effect fn read_new(c: HttpCall) -> String = _

/// Blocks until the call ends; any status is ok.
@intrinsic("almide_http_call_wait")
@borrow_ref(c)
effect fn wait(c: HttpCall) -> Result[HttpResponse, String] = _

/// Closes the connection; the call ends as err.
@intrinsic("almide_http_call_cancel")
@borrow_ref(c)
effect fn cancel(c: HttpCall) -> Unit = _

/// request_stream bounded by per-call limits.
effect fn request_stream_with_limits(method: String, url: String, body: String, headers: Map[String, String], limits: HttpLimits, on_chunk: (String) -> Unit) -> Result[Unit, String] = __request_stream_limited(
  method,
  url,
  body,
  headers,
  limits.total_ms,
  limits.idle_ms,
  on_chunk,
)

@intrinsic("almide_rt_http___request_stream_limited")
@borrow_ref(headers)
effect fn __request_stream_limited(method: String, url: String, body: String, headers: Map[String, String], total_ms: Int, idle_ms: Int, on_chunk: (String) -> Unit) -> Result[Unit, String] = _

/// openai_streaming_call bounded by per-call limits.
effect fn openai_streaming_call_with_limits(base_url: String, api_key: String, body_json: String, limits: HttpLimits, on_text_delta: (String) -> Unit) -> Result[String, String] = __openai_streaming_limited(
  base_url,
  api_key,
  body_json,
  limits.total_ms,
  limits.idle_ms,
  on_text_delta,
)

@intrinsic("almide_rt_http___openai_streaming_limited")
effect fn __openai_streaming_limited(base_url: String, api_key: String, body_json: String, total_ms: Int, idle_ms: Int, on_text_delta: (String) -> Unit) -> Result[String, String] = _

/// anthropic_streaming_call bounded by per-call limits.
effect fn anthropic_streaming_call_with_limits(api_key: String, body_json: String, limits: HttpLimits, on_text_delta: (String) -> Unit) -> Result[String, String] = __anthropic_streaming_limited(
  api_key,
  body_json,
  limits.total_ms,
  limits.idle_ms,
  on_text_delta,
)

@intrinsic("almide_rt_http___anthropic_streaming_limited")
effect fn __anthropic_streaming_limited(api_key: String, body_json: String, total_ms: Int, idle_ms: Int, on_text_delta: (String) -> Unit) -> Result[String, String] = _

// ── Server: handlers, routes, middleware (#2588) ──
//
// A handler is a plain function from a request to a response, and so are a
// router and a wrapped app: `serve` is one host's way of running a handler,
// `new_request` is a test's way — an app is tested by calling it, with no
// socket. Middleware is `(HttpHandler) -> HttpHandler`; per-request data is
// passed as arguments, never through a mutable context.
//
// FAMILY RULE (#2588, gated by proofs/target-availability.toml): every
// HttpRequest reader — req_method / req_path / req_body / req_header /
// query_params / param — answers a request built by `new_request`, so the
// availability probe builds its HttpRequest argument that way and no reader
// is `unprobed` on any leg.
/// Request to response; a router is one too.
type HttpHandler = effect (HttpRequest) -> HttpResponse

/// Wraps a handler: (next) => (req) => … next(req)! ….
type HttpMiddleware = (HttpHandler) -> HttpHandler

/// Route table row; build it with route or mount.
type HttpRoute = { method: String, pattern: String, segments: List[String], handler: HttpHandler }

/// Request built in code; target keeps its ?query.
@intrinsic("almide_rt_http_new_request")
@borrow_ref(headers)
fn new_request(method: String, target: String, body: String, headers: Map[String, String]) -> HttpRequest = _

/// Router-bound path parameter, decoded; none if unbound.
@intrinsic("almide_http_param")
@borrow_ref(req)
fn param(req: HttpRequest, name: String) -> String? = _

@intrinsic("almide_http_req_with_params")
@consume(req)
@borrow_ref(flat)
fn __with_params(req: HttpRequest, flat: List[String]) -> HttpRequest = _

@intrinsic("almide_http_req_with_path")
@consume(req)
fn __with_path(req: HttpRequest, target: String) -> HttpRequest = _

@intrinsic("almide_http_set_body")
@consume(resp)
fn __set_body(resp: HttpResponse, body: String) -> HttpResponse = _

fn __path_of(target: String) -> String = match string.index_of(target, "?") {
  some(i) => string.take(target, i),
  none => target,
}

fn __query_of(target: String) -> String = match string.index_of(target, "?") {
  some(i) => string.drop(target, i + 1),
  none => "",
}

// Empty segments do not count: `/users/` and `/users` are one path.
fn __parts(path: String) -> List[String] = string.split(path, "/") |> list.filter((s) => s != "")

// A path segment percent-decoded; `+` is a literal plus in a path.
fn __decode_part(s: String) -> String = http.url_decode(string.replace(s, "+", "%2B"))

fn __is_hex(c: String) -> Bool = c != "" and string.contains("0123456789abcdefABCDEF", c)

// Some `%` is not followed by two hex digits: the path is not percent-encoded.
fn __bad_escape(cs: List[String]) -> Bool = match list.first(cs) {
  none => false,
  some(c) => if c != "%" then __bad_escape(list.drop(cs, 1))
  else if __is_hex(list.get(cs, 1) ?? "") and __is_hex(list.get(cs, 2) ?? "") then __bad_escape(list.drop(cs, 3)) else true,
}

fn __is_rest(s: String) -> Bool = string.starts_with(s, "{") and string.ends_with(s, "...}")

fn __is_param(s: String) -> Bool = string.starts_with(s, "{") and string.ends_with(s, "}") and not __is_rest(s)

fn __name_of(s: String) -> String = if __is_rest(s) then string.slice(s, 1, string.len(s) - 4)
else string.slice(s, 1, string.len(s) - 1)

// "end" past the last segment, else "lit", "param" (`{name}`) or "rest" (`{name...}`).
fn __kind(s: String?) -> String = match s {
  none => "end",
  some(x) => if __is_rest(x) then "rest"
  else if __is_param(x) then "param" else "lit",
}

fn __pattern_path(pattern: String) -> String = match string.index_of(pattern, " ") {
  some(i) => string.trim(string.drop(pattern, i + 1)),
  none => pattern,
}

/// "GET /users/{id}" to a route; no method = any.
fn route(pattern: String, handler: HttpHandler) -> HttpRoute = {
  let p = string.trim(pattern)
  let method = match string.index_of(p, " ") {
    some(i) => string.take(p, i),
    none => "",
  }
  { method: method, pattern: p, segments: __parts(__pattern_path(p)), handler: handler }
}

/// Sub-app under prefix: /api/x reaches it as /x.
fn mount(prefix: String, sub: HttpHandler) -> HttpRoute = {
  let p = string.trim(prefix)
  { method: "", pattern: p + "/{...}", segments: __parts(p) + ["{...}"], handler: __mounted(sub) }
}

// The anonymous `{...}` binds the rest of the path undecoded, so the sub-app
// decodes each segment exactly once.
fn __mounted(sub: HttpHandler) -> HttpHandler = (req) => {
  let q = __query_of(http.req_path(req))
  let rest = http.param(req, "") ?? ""
  sub(http.__with_path(req, "/" + rest + (if q == "" then "" else "?" + q)))!
}

// The `[name, value, …]` bindings when a pattern matches the path's parts.
fn __bind(segs: List[String], parts: List[String]) -> List[String]? = __bind_into(segs, parts, [])

// Tail-recursive: `bound` carries the bindings made so far.
fn __bind_into(segs: List[String], parts: List[String], bound: List[String]) -> List[String]? = match list.first(segs) {
  none => if list.is_empty(parts) then some(bound) else none,
  some(s) => if __is_rest(s) then {
    let name = __name_of(s)
    some(bound + [
      name,
      if name == "" then list.join(parts, "/")
      else parts |> list.map(__decode_part) |> list.join("/")
    ])
  } else match list.first(parts) {
    none => none,
    some(part) => if __is_param(s) then __bind_into(
      list.drop(segs, 1),
      list.drop(parts, 1),
      bound + [__name_of(s), __decode_part(part)],
    )
    else if __decode_part(part) == s then __bind_into(
      list.drop(segs, 1),
      list.drop(parts, 1),
      bound,
    )
    else none,
  },
}

// Every path `a` matches, `b` matches too: `a` is at least as specific.
fn __covers(a: List[String], b: List[String]) -> Bool = {
  let ka = __kind(list.first(a))
  let kb = __kind(list.first(b))
  if kb == "rest" then true
  else if ka == "rest" then false
  else if ka == "end" or kb == "end" then ka == kb
  else if ka == "lit" and kb == "lit" and list.first(a) != list.first(b) then false
  else if ka == "param" and kb == "lit" then false else __covers(list.drop(a, 1), list.drop(b, 1))
}

// Some path is matched by both.
fn __overlaps(a: List[String], b: List[String]) -> Bool = {
  let ka = __kind(list.first(a))
  let kb = __kind(list.first(b))
  if ka == "rest" or kb == "rest" then true
  else if ka == "end" or kb == "end" then ka == kb
  else if ka == "lit" and kb == "lit" and list.first(a) != list.first(b) then false else __overlaps(
    list.drop(a, 1),
    list.drop(b, 1),
  )
}

fn __route_covers(a: HttpRoute, b: HttpRoute) -> Bool = (b.method == "" or a.method == b.method) and __covers(
  a.segments,
  b.segments,
)

// Go 1.22's rule: two routes some request matches, neither more specific
// than the other (two spellings of one pattern included).
fn __conflict(a: HttpRoute, b: HttpRoute) -> Bool = (a.method == "" or b.method == "" or a.method == b.method) and __overlaps(
  a.segments,
  b.segments,
) and __route_covers(a, b) == __route_covers(b, a)

fn __segment_ok(s: String, last: Bool) -> Bool = if __is_rest(s) then last and not string.contains(
  __name_of(s),
  "{",
) and not string.contains(__name_of(s), "}")
else if __is_param(s) then __name_of(s) != "" and not string.contains(__name_of(s), "{") and not string.contains(
  __name_of(s),
  "}",
) else not string.contains(s, "{") and not string.contains(s, "}")

fn __method_ok(m: String) -> Bool = string.chars(m) |> list.all((c) => string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c))

fn __pattern_problems(r: HttpRoute) -> List[String] = {
  let last = list.len(r.segments) - 1
  let names = r.segments |> list.filter((s) => __is_param(s) or __is_rest(s)) |> list.map((s) => __name_of(s)) |> list.filter((n) => n != "")
  let checks = [
    (__method_ok(r.method), "the method must be upper-case letters"),
    (string.starts_with(__pattern_path(r.pattern), "/"), "the path must start with /"),
    (list.enumerate(r.segments) |> list.all(((i, s)) => __segment_ok(s, i == last)), "a segment is a literal, {name} or a last {name...}"),
    (list.len(list.unique(names)) == list.len(names), "a name is bound twice")
  ]
  checks |> list.filter(((ok_, _)) => not ok_) |> list.map(((_, why)) => "\"${r.pattern}\": ${why}")
}

fn __problems(routes: List[HttpRoute]) -> List[String] = {
  let own = routes |> list.flat_map((r) => __pattern_problems(r))
  let conflicts = list.enumerate(routes) |> list.flat_map(((i, a)) => list.drop(routes, i + 1) |> list.filter((b) => __conflict(a, b)) |> list.map((b) => "\"${a.pattern}\" and \"${b.pattern}\" conflict"))
  own + conflicts
}

fn __not_allowed(hits: List[(HttpRoute, List[String])]) -> HttpResponse = {
  let methods = hits |> list.map(((r, _)) => r.method) |> list.filter((m) => m != "") |> list.unique
  let allow = if list.contains(methods, "GET") and not list.contains(methods, "HEAD") then methods + ["HEAD"]
  else methods
  http.set_header(
    http.response(405, "Method Not Allowed"),
    "Allow",
    allow |> list.sort |> list.join(", "),
  )
}

effect fn __dispatch(hits: List[(HttpRoute, List[String])], req: HttpRequest) -> HttpResponse = {
  let method = http.req_method(req)
  let path = __path_of(http.req_path(req))
  if not string.starts_with(path, "/") then http.response(
    400,
    "Bad Request: the request target must start with /",
  )
  else if __bad_escape(string.chars(path)) then http.response(
    400,
    "Bad Request: malformed percent-encoding in the path",
  )
  else {
    let exact = hits |> list.filter(((r, _)) => r.method == method or r.method == "")
    let via_get = method == "HEAD" and list.is_empty(exact)
    let allowed = if via_get then hits |> list.filter(((r, _)) => r.method == "GET")
    else exact
    match allowed |> list.find(((a, _)) => list.all(allowed, ((b, _)) => __route_covers(a, b))) {
      some((r, bound)) => {
        let res = r.handler(http.__with_params(req, bound))!
        if via_get then http.__set_body(res, "") else res
      },
      none => if list.is_empty(hits) then http.response(404, "Not Found") else __not_allowed(hits),
    }
  }
}

// The route table's lambda computes the matching routes itself: `routes` stays
// a capture, never a param a callee would have to own.
fn __table(routes: List[HttpRoute]) -> HttpHandler = (req) => {
  let parts = __parts(__path_of(http.req_path(req)))
  let hits = routes |> list.filter_map((r) => __bind(r.segments, parts) |> option.map((bound) => (r, bound)))
  __dispatch(hits, req)!
}

/// Route table as a handler; err on conflicting routes.
fn router(routes: List[HttpRoute]) -> Result[HttpHandler, String] = {
  let problems = __problems(routes)
  if list.is_empty(problems) then ok(__table(routes)) else err("http.router: " + list.join(
    problems,
    "; ",
  ))
}

/// Applies middleware; the first is the outermost.
fn wrap(handler: HttpHandler, middleware: List[HttpMiddleware]) -> HttpHandler = if list.is_empty(middleware) then handler
else wrap(
  __apply(list.last(middleware) ?? __no_middleware, handler),
  list.take(middleware, list.len(middleware) - 1),
)

// Named rather than inline `mw(inner)`: the wasm legs return a handler out
// of an `if` only through a call they can resolve. `wrap` applies the LAST
// middleware first, so the recursion is a tail call.
fn __apply(mw: HttpMiddleware, inner: HttpHandler) -> HttpHandler = mw(inner)

fn __no_middleware(next: HttpHandler) -> HttpHandler = next

/// JSON body through decode; err is a 400 response.
fn decode_json[T](req: HttpRequest, decode: (Value) -> Result[T, String]) -> Result[T, HttpResponse] = match json.parse(http.req_body(req)) {
  ok(v) => match decode(v) {
    ok(x) => ok(x),
    err(e) => err(http.response(400, "Bad Request: " + e)),
  },
  err(e) => err(http.response(400, "Bad Request: the body is not JSON (" + e + ")")),
}
