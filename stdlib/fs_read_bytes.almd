// fs_read_bytes — SELF-HOSTED `fs.read_bytes(path) -> Result[Bytes, String]` over the
// SAME WASI file-read floor as fs.read_text (prim.read_bytes_file), minus the UTF-8
// check: native `std::fs::read` hands back whatever bytes are on disk, and so does this.
// The call-head twin names `fs.read_bytes` in a failure (#2206). Capability::FsRead
// via the prim, exactly like the read_text twin.
effect fn fs_read_bytes(path: String) -> Result[Bytes, String] = prim.read_bytes_file_as(
  path,
  "fs.read_bytes",
)
