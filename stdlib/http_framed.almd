// http_framed — the WASM lowering of the 4-arg request family (#1710
// increment 3). The host-op ABI carries exactly two buffers, so the
// (method, body, headers) triple SERIALIZES into one frame that rides
// beside the url: decimal-length cells `<len>\n<payload>`, method first,
// body second, then each header key and value in list order (the flat
// `[k1, v1, …]` http.almd's leaves take, R-http-09). Lengths are
// CHAR counts (string.len semantics) and the frame stays valid UTF-8 —
// the embedded host parses it with the same char arithmetic. Native
// keeps its direct intrinsics; this file only ever links on the wasm
// legs through the self-host registry.
//
// The three `__http_framed_*` leaves are host ops (48 text / 49 status /
// 50 bytes) served by the embedded host's transcription of the native
// client, so transport-error texts match native byte-for-byte (C-328).
// The status op answers `<code>\n<body>` — split at the FIRST newline;
// the body may carry any number of its own. The response leaf (op 65,
// ADR-0023 step 4) answers `<code>\n<hlen>\n<header cells><body>`: hlen CHARS
// of name/value cells, so one cut separates the headers from the body and
// the body is copied once. The answer becomes the HttpResponse rep
// http_response.almd reads — `[status, body, k1, v1, …]` — built as-is: a
// repeated field keeps every occurrence, as native's Vec does. The p3 shim
// serves it over wasi:http (wasi_p3_http_resp.rs); no host serves it.
fn __http_cell(s: String) -> String = "${string.len(s)}\n${s}"

fn __http_frame(method: String, body: String, flat: List[String]) -> String = list.take(
  flat,
  2 * (list.len(flat) / 2),
) |> list.map((c) => __http_cell(c)) |> list.fold(
  "${__http_cell(method)}${__http_cell(body)}",
  (acc, cell) => acc + cell,
)

effect fn __http_framed_text(url: String, frame: String) -> Result[String, String] = _

effect fn __http_framed_status(url: String, frame: String) -> Result[String, String] = _

effect fn __http_framed_bytes(url: String, frame: String) -> Result[Bytes, String] = _

@implements("http.__request")
effect fn __request_impl(method: String, url: String, body: String, flat: List[String]) -> Result[String, String] = __http_framed_text(
  url,
  __http_frame(method, body, flat),
)

@implements("http.__request_bytes")
effect fn __request_bytes_impl(method: String, url: String, body: String, flat: List[String]) -> Result[Bytes, String] = __http_framed_bytes(
  url,
  __http_frame(method, body, flat),
)

effect fn __http_framed_response(url: String, frame: String) -> Result[String, String] = _

// The next decimal-length cell of `f`: (payload, rest).
fn __http_take_cell(f: String) -> (String, String) = {
  let cut = string.index_of(f, "\n") ?? 0
  let n = int.parse(string.take(f, cut)) ?? 0
  let rest = string.drop(f, cut + 1)
  (string.take(rest, n), string.drop(rest, n))
}

fn __http_cells(f: String, acc: List[String]) -> List[String] = if f == "" then acc
else {
  let (cell, rest) = __http_take_cell(f)
  __http_cells(rest, acc + [cell])
}

@implements("http.__request_response")
effect fn __request_response_impl(method: String, url: String, body: String, flat: List[String]) -> Result[List[String], String] = {
  let f = __http_framed_response(url, __http_frame(method, body, flat))!
  let c1 = string.index_of(f, "\n") ?? 0
  let after_code = string.drop(f, c1 + 1)
  let c2 = string.index_of(after_code, "\n") ?? 0
  let hlen = int.parse(string.take(after_code, c2)) ?? 0
  let rest = string.drop(after_code, c2 + 1)
  ok([string.take(f, c1), string.drop(rest, hlen)] + __http_cells(string.take(rest, hlen), []))
}

@implements("http.get_response")
effect fn __get_response_impl(url: String) -> Result[List[String], String] = __request_response_impl(
  "GET",
  url,
  "",
  [],
)
