// bytes_string — SELF-HOSTED bytes.{to_string_lossy, read_string_at, read_string_be} for v1.
// A Bytes is the [rc][len@4][cap@8][data@12] byte block; each result is a FRESH String built by
// prim.alloc_str + a byte copy of the selected range (prim.load8/store8 — the proven bytes_core
// discipline). The windowed readers decode their window through `bytes.to_string_lossy`, so INVALID
// UTF-8 becomes U+FFFD per maximal subpart exactly as native's String::from_utf8_lossy does. They
// used to copy the raw bytes: the String then held invalid UTF-8, which printing hid and every string
// operation after it read wrong (`string.to_upper` of three 0xFF bytes gave "\x01" plus three U+FFFD,
// length 1, against native's three U+FFFD, length 3). Source Bytes is BORROWED (no refcount change). All bounds use a scalar-if effective
// length (never a heap-result if), so only ONE alloc path lowers.
fn __bs_copy(dst: Int, src: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store8(dst + i, prim.load8(src + i))
  __bs_copy(dst, src, n, i + 1)
}

// bytes.to_string_lossy(b): the whole data region decoded as UTF-8.
fn bytes_to_string_lossy(b: Bytes) -> String = {
  let h = prim.handle(b)
  let n = prim.load32(h + 4)
  let out = prim.alloc_str(n)
  let _x = __bs_copy(prim.handle(out) + 12, h + 12, n, 0)
  out
}

// bytes.read_string_at(b, pos, len): the len-byte window at pos, or "" when the window
// does not lie WHOLLY inside the data region. The bounds check folds into the effective
// copy length.
//
// The three tests are separate and SUBTRACTIVE on purpose. The single additive test this
// replaces (`pos + len > blen`, transcribed from v0) was defeated by its own arithmetic
// in both directions: `read_string_at(b, -1, 3)` computed 2 > blen = false and copied
// three bytes starting one byte BEFORE the data region — the cap field, returned as text,
// with no error on either leg — and `pos = i64::MAX` wrapped the sum negative, passed, and
// then indexed past the end. `pos > blen - len` cannot wrap: both sides are already
// bounded once the two sign tests have run.
fn bytes_read_string_at(b: Bytes, pos: Int, len: Int) -> String = {
  let h = prim.handle(b)
  let blen = prim.load32(h + 4)
  let n = if pos < 0 then 0
  else if len < 0 then 0
  else if pos > blen - len then 0 else len
  bytes.to_string_lossy(bytes.slice(b, pos, pos + n))
}

// 4-byte BIG-ENDIAN u32 at address p (prim.load8 returns the unsigned byte 0..255).
fn __bs_be32(p: Int) -> Int = {
  let b0 = prim.load8(p)
  let b1 = prim.load8(p + 1)
  let b2 = prim.load8(p + 2)
  let b3 = prim.load8(p + 3)
  ((b0 * 256 + b1) * 256 + b2) * 256 + b3
}

// bytes.read_string_be(b, pos): a 4-byte BE length prefix at pos, then that many UTF-8 body bytes.
// "" when the prefix or the body runs past the end, expressed as nested scalar-ifs folding into
// one effective copy length (no `and`/`or`, no heap-result if).
//
// Both bounds are SUBTRACTIVE, for the reason spelled out on read_string_at: the header test
// `pos + 4 <= blen` admitted a negative pos outright and wrapped for a pos near i64::MAX, and the
// body test `pos + 4 + slen > blen` could wrap on slen alone (a u32 prefix reaches 4294967295).
// Once hdr_ok holds, pos is in [0, blen-4], so `blen - 4 - pos` is a non-negative budget the body
// length is compared against directly — no sum is ever formed.
fn bytes_read_string_be(b: Bytes, pos: Int) -> String = {
  let h = prim.handle(b)
  let blen = prim.load32(h + 4)
  let hdr_ok = if pos < 0 then false else pos <= blen - 4
  let slen = if hdr_ok then __bs_be32(h + 12 + pos) else 0
  let n = if hdr_ok then (if slen > blen - 4 - pos then 0 else slen)
  else 0
  bytes.to_string_lossy(bytes.slice(b, pos + 4, pos + 4 + n))
}
