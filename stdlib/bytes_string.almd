// bytes_string — SELF-HOSTED bytes.to_string_lossy for v1.
// A Bytes is the [rc][len@4][cap@8][data@12] byte block; the result is a FRESH String built by
// prim.alloc_str + byte stores (prim.load8/store8 — the proven bytes_core discipline). Source
// Bytes is BORROWED (no refcount change). INVALID UTF-8 becomes U+FFFD per maximal subpart,
// exactly as native's String::from_utf8_lossy does: a String never holds invalid UTF-8 (a raw
// copy printed the same but every string operation after it read wrong). Two passes over the
// same decoder: the first sizes the result, the second writes it. Every if is scalar, so only
// ONE alloc path lowers.
fn __bs_copy(dst: Int, src: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store8(dst + i, prim.load8(src + i))
  __bs_copy(dst, src, n, i + 1)
}

// Is the byte at p (p < end) inside lo..=hi?
fn __bs_cont(p: Int, end: Int, lo: Int, hi: Int) -> Bool = if p >= end then false
else {
  let c = prim.load8(p)
  if c < lo then false else c <= hi
}

// The UTF-8 sequence at d + i (d = data base, n = data length): +k when the k-byte sequence
// is well-formed, -m when it is not, m >= 1 being the maximal subpart (the lead plus the
// continuation bytes that matched before the first one that did not). Unicode Table 3-7: a
// lead 0x80..0xC1 or 0xF5..0xFF is never valid; 0xE0 needs a second byte 0xA0..0xBF, 0xED
// 0x80..0x9F (no surrogates), 0xF0 0x90..0xBF, 0xF4 0x80..0x8F (nothing past U+10FFFF).
fn __bs_seq(d: Int, n: Int, i: Int) -> Int = {
  let b0 = prim.load8(d + i)
  let k = if b0 < 128 then 1
  else if b0 < 194 then 0
  else if b0 < 224 then 2
  else if b0 < 240 then 3
  else if b0 < 245 then 4
  else 0
  let lo2 = if b0 == 224 then 160
  else if b0 == 240 then 144 else 128
  let hi2 = if b0 == 237 then 159
  else if b0 == 244 then 143 else 191
  let e = d + n
  let m = if k < 2 then 1
  else if not __bs_cont(d + i + 1, e, lo2, hi2) then 1
  else if k == 2 then 2
  else if not __bs_cont(d + i + 2, e, 128, 191) then 2
  else if k == 3 then 3
  else if not __bs_cont(d + i + 3, e, 128, 191) then 3
  else 4
  if k == 0 then 0 - 1
  else if m == k then k else 0 - m
}

// Pass 1: the decoded length in bytes (an invalid subpart costs the 3 bytes of U+FFFD).
fn __bs_olen(d: Int, n: Int, i: Int, acc: Int) -> Int = if i >= n then acc
else {
  let s = __bs_seq(d, n, i)
  if s > 0 then __bs_olen(d, n, i + s, acc + s)
  else __bs_olen(d, n, i - s, acc + 3)
}

// Pass 2: copy each well-formed sequence, write EF BF BD for each invalid subpart.
fn __bs_emit(dst: Int, d: Int, n: Int, i: Int, o: Int) -> Int = if i >= n then 0
else {
  let s = __bs_seq(d, n, i)
  if s > 0 then {
    let _c = __bs_copy(dst + o, d + i, s, 0)
    __bs_emit(dst, d, n, i + s, o + s)
  } else {
    prim.store8(dst + o, 239)
    prim.store8(dst + o + 1, 191)
    prim.store8(dst + o + 2, 189)
    __bs_emit(dst, d, n, i - s, o + 3)
  }
}

// bytes.to_string_lossy(b): the whole data region decoded as UTF-8.
fn bytes_to_string_lossy(b: Bytes) -> String = {
  let h = prim.handle(b)
  let n = prim.load32(h + 4)
  let d = h + 12
  let out = prim.alloc_str(__bs_olen(d, n, 0, 0))
  let _x = __bs_emit(prim.handle(out) + 12, d, n, 0, 0)
  out
}
