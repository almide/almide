// mem — arena checkpoint surface (the C-041 contract, bytes.heap_save's twin).
//
// save() takes an OPAQUE checkpoint; restore(mark) hands it back. The
// promise is observational: take a checkpoint, allocate scratch, restore,
// and subsequent work produces identical results on every target. v0's
// wasm leg reset a bump pointer here; v1's RC discipline reclaims scratch
// deterministically at scope end, so on every leg the pair is trivial —
// native (runtime/rs/src/mem.rs) and wasm (stdlib/mem_checkpoint.almd) alike.
// The checkpoint value is never meaningful to print.
/// Opaque checkpoint for restore.
@intrinsic("almide_rt_mem_save")
fn save() -> Int = _

/// Rewinds to mark; a no-op under RC today.
@intrinsic("almide_rt_mem_restore")
fn restore(mark: Int) -> Unit = _
