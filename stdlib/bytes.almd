fn write_string_be(b: Bytes, s: String) -> Unit = _

/// Appends val's low 32 bits, BE.
@intrinsic("almide_rt_bytes_write_u32_be")
fn write_u32_be(b: Bytes, val: Int) -> Unit = _

/// Appends val's low 8 bits; 256 becomes 0.
@intrinsic("almide_rt_bytes_write_u8")
fn write_u8(b: Bytes, val: Int) -> Unit = _

/// Bytewise XOR, as long as the shorter input.
@intrinsic("almide_rt_bytes_xor")
fn xor(a: Bytes, b: Bytes) -> Bytes = _

// Arena memory management (WASM only — no-op on Rust target).
// heap_save returns a checkpoint; heap_restore frees all allocations above it.
/// Opaque arena checkpoint; currently always 0.
@intrinsic("almide_rt_bytes_heap_save")
fn heap_save() -> Int = _

/// Restores a heap_save checkpoint; currently a no-op.
@intrinsic("almide_rt_bytes_heap_restore")
fn heap_restore(checkpoint: Int) -> Unit = _

// ── Typed byte IO (Stage 4a, Sized Numeric Types integration) ──
//
// The new preferred surface: one function per (operation × width × kind),
// parameterized by `Endian` instead of burnt into the name. Replaces
// `read_u32_le` / `read_u32_be` / ... with `read_uint32(b, pos, .le)` /
// `read_uint32(b, pos, .be)`. The old names stay for now; a later arc
// will flip usage and delete them. Each typed wrapper dispatches at
// compile time (match on a unit-variant arm), so there is no runtime
// overhead over calling the legacy fn directly.
//
// Covered in this MVP:
//   - read/write × {UInt16, UInt32, Int32, Float32}
//
// Follow-ups (not blocking this arc):
//   - UInt8 / Int8 / Int16 / UInt64 / Int64 / Float64
//   - `set[T]` / `append[T]` typed families
//   - `FixedWidthInteger` / `BinaryFloatingPoint` protocols once the
//     generic-dispatch infrastructure lands
/// Byte order: LittleEndian or BigEndian.
type Endian = | LittleEndian | BigEndian

/// UInt16 at offset; 0 if out of range.
@intrinsic("almide_rt_bytes_read_uint16")
fn read_uint16(b: Bytes, offset: Int, endian: Endian) -> UInt16 = _

/// UInt32 at offset; 0 if out of range.
@intrinsic("almide_rt_bytes_read_uint32")
fn read_uint32(b: Bytes, offset: Int, endian: Endian) -> UInt32 = _

/// Int32 at offset; 0 if out of range.
@intrinsic("almide_rt_bytes_read_int32")
fn read_int32(b: Bytes, offset: Int, endian: Endian) -> Int32 = _

/// Float32 at offset; 0 if out of range.
@intrinsic("almide_rt_bytes_read_float32")
fn read_float32(b: Bytes, offset: Int, endian: Endian) -> Float32 = _

/// Appends value as 2 bytes in endian order.
@intrinsic("almide_rt_bytes_write_uint16")
fn write_uint16(b: Bytes, value: UInt16, endian: Endian) -> Unit = _

/// Appends value as 4 bytes in endian order.
@intrinsic("almide_rt_bytes_write_uint32")
fn write_uint32(b: Bytes, value: UInt32, endian: Endian) -> Unit = _

/// Appends value as 4 bytes in endian order.
@intrinsic("almide_rt_bytes_write_int32")
fn write_int32(b: Bytes, value: Int32, endian: Endian) -> Unit = _

/// Appends value as 4 bytes in endian order.
@intrinsic("almide_rt_bytes_write_float32")
fn write_float32(b: Bytes, value: Float32, endian: Endian) -> Unit = _

/// Writes value at offset; no-op out of range.
@intrinsic("almide_rt_bytes_set_uint16")
fn set_uint16(b: Bytes, offset: Int, value: UInt16, endian: Endian) -> Unit = _

/// Writes value at offset; no-op out of range.
@intrinsic("almide_rt_bytes_set_uint32")
fn set_uint32(b: Bytes, offset: Int, value: UInt32, endian: Endian) -> Unit = _

/// Writes value at offset; no-op out of range.
@intrinsic("almide_rt_bytes_set_int32")
fn set_int32(b: Bytes, offset: Int, value: Int32, endian: Endian) -> Unit = _

/// Writes value at offset; no-op out of range.
@intrinsic("almide_rt_bytes_set_float32")
fn set_float32(b: Bytes, offset: Int, value: Float32, endian: Endian) -> Unit = _
