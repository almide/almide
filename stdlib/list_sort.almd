// list_sort — SELF-HOSTED `list.sort` for v1 over the prim floor: copy the elements into a
// fresh List[Int] (prim.alloc_list) and bottom-up MERGESORT them between two buffers by
// ascending i64 value. Sound + loop-bounded (i64 value copies, no new heap elements).
// List[Int] only: a heap-element list would be sorted by HANDLE address, not value — a
// per-type refinement. O(n log n) — the selection sort this replaced was O(n^2), a 100x
// wall-time cliff at n=20k that native (Rust pdqsort) never had (#1459) — and STABLE
// (`<=` takes the left run first), matching native's stable sort. Every recursive helper
// is tail-recursive; depth is O(n) within a merge pass, same bound as the old code.
fn __sort_load(h: Int, i: Int) -> Int = prim.load64(h + 12 + i * 8)

// Merge the runs [lo, mid) and [mid, hi) from src into dst; `i`/`j` walk the
// two runs, `k` walks [lo, hi) in dst. `<=` keeps the merge stable.
fn __merge_run(srch: Int, dsth: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
  else if i >= mid then false else __sort_load(srch, i) <= __sort_load(srch, j)
  if takel then {
    prim.store64(dsth + 12 + k * 8, __sort_load(srch, i))
    __merge_run(srch, dsth, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dsth + 12 + k * 8, __sort_load(srch, j))
    __merge_run(srch, dsth, mid, hi, i, j + 1, k + 1)
  }
}

// One width-pass: merge each adjacent pair of width-runs from src into dst,
// `lo` stepping by 2*width across [0, n).
fn __merge_pass(srch: Int, dsth: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __merge_run(srch, dsth, mid, hi, lo, mid, lo)
  __merge_pass(srch, dsth, n, width, lo + width * 2)
}

// Double the run width until one run covers the list, ping-ponging between
// the two buffers; returns the handle holding the sorted data.
fn __merge_rounds(curh: Int, othh: Int, n: Int, width: Int) -> Int = if width >= n then curh
else {
  let _p = __merge_pass(curh, othh, n, width, 0)
  __merge_rounds(othh, curh, n, width * 2)
}

fn __sort_copy(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(srch + 12 + i * 8)
  prim.store64(dsth + 12 + i * 8, e)
  __sort_copy(srch, dsth, n, i + 1)
}

fn list_sort(xs: List[Int]) -> List[Int] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list(n)
  let bh = prim.handle(buf)
  let _c = __sort_copy(h, bh, n, 0)
  // The scratch buffer is a plain List[Int] whose drop frees only the block —
  // it never owns anything, whichever side the ping-pong ends on.
  let tmp = prim.alloc_list(n)
  let th = prim.handle(tmp)
  let fin = __merge_rounds(bh, th, n, 1)
  let _cb = if fin == bh then 0
  else __sort_copy(fin, bh, n, 0)
  buf
}

// list.sort over a List[String] — sort by STRING CONTENT (lexicographic byte order, matching v0's
// Rust String Ord), NOT by handle address (which the generic list_sort compares → arbitrary order,
// the silent bug). A String is a handle; bytes at h+12, byte length at h+4. rc-copy the handles to
// co-own (the result is a List[String] → recursive DropListStr; without rc_inc the result+source
// double-free at scale), then selection-sort in place by content (handle swaps, no rc change).
fn __strcmp_at(ah: Int, bh: Int, la: Int, lb: Int, k: Int) -> Int = if k >= la then (if k >= lb then 0 else 0 - 1)
else if k >= lb then 1
else {
  let ca = prim.load8(ah + 12 + k)
  let cb = prim.load8(bh + 12 + k)
  if ca < cb then 0 - 1
  else if ca > cb then 1
  else __strcmp_at(ah, bh, la, lb, k + 1)
}

fn __strcmp(ah: Int, bh: Int) -> Int = __strcmp_at(ah, bh, prim.load32(ah + 4), prim.load32(bh + 4), 0)

// Takes the list HANDLES (srch/dsth), adds the +12 data offset itself — mirrors __sort_copy.
fn __sort_copy_rc(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(srch + 12 + i * 8)
  prim.rc_inc(e)
  prim.store64(dsth + 12 + i * 8, e)
  __sort_copy_rc(srch, dsth, n, i + 1)
}

// The String-leg merge twins: same shape as __merge_run/__merge_pass/
// __merge_rounds with __strcmp for the ordering. Merging moves HANDLES
// between raw buffers — no rc traffic; the one rc_inc per element happened
// in __sort_copy_rc, and the returned List[String]'s recursive drop is the
// single matching rc_dec.
fn __merge_run_str(srch: Int, dsth: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
  else if i >= mid then false else __strcmp(prim.load64(srch + 12 + i * 8), prim.load64(srch + 12 + j * 8)) <= 0
  if takel then {
    prim.store64(dsth + 12 + k * 8, prim.load64(srch + 12 + i * 8))
    __merge_run_str(srch, dsth, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dsth + 12 + k * 8, prim.load64(srch + 12 + j * 8))
    __merge_run_str(srch, dsth, mid, hi, i, j + 1, k + 1)
  }
}

fn __merge_pass_str(srch: Int, dsth: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __merge_run_str(srch, dsth, mid, hi, lo, mid, lo)
  __merge_pass_str(srch, dsth, n, width, lo + width * 2)
}

fn __merge_rounds_str(curh: Int, othh: Int, n: Int, width: Int) -> Int = if width >= n then curh
else {
  let _p = __merge_pass_str(curh, othh, n, width, 0)
  __merge_rounds_str(othh, curh, n, width * 2)
}

fn list_sort_str(xs: List[String]) -> List[String] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_str(n)
  let bh = prim.handle(buf)
  let _c = __sort_copy_rc(h, bh, n, 0)
  // Scratch is a FLAT List[Int] on purpose: it holds stale handle copies
  // after the ping-pong, and a flat drop frees only the block — a
  // List[String] scratch would rc_dec those stale handles (double-free).
  let tmp = prim.alloc_list(n)
  let th = prim.handle(tmp)
  let fin = __merge_rounds_str(bh, th, n, 1)
  let _cb = if fin == bh then 0
  else __sort_copy(fin, bh, n, 0)
  buf
}

// list.min / list.max over a List[String] — by CONTENT (like sort), not handle address (the generic
// list_min/list_max compared the i64 handle → wrong element, a silent bug). Find the min/max INDEX by
// __strcmp, then return Some(a fresh DEEP COPY of that element) via string.repeat — single-owned, the
// source keeps its ref (the __get_str_some pattern; v0 clones too). Empty → None.
fn __min_idx_str(h: Int, len: Int, i: Int, best: Int) -> Int = if i >= len then best
else {
  let e = prim.load64(h + 12 + i * 8)
  let be = prim.load64(h + 12 + best * 8)
  let nb = if __strcmp(e, be) < 0 then i else best
  __min_idx_str(h, len, i + 1, nb)
}

fn __max_idx_str(h: Int, len: Int, i: Int, best: Int) -> Int = if i >= len then best
else {
  let e = prim.load64(h + 12 + i * 8)
  let be = prim.load64(h + 12 + best * 8)
  let nb = if __strcmp(e, be) > 0 then i else best
  __max_idx_str(h, len, i + 1, nb)
}

// Some(a fresh DEEP COPY of element i) — mirrors list_get_str's __get_str_some (the else-arm must be a
// CALL returning Option[String], not an inline Some(call) which walls the heap-result-if).
fn __idx_str_some(h: Int, i: Int) -> String? = {
  let x = prim.load_str(h + 12 + i * 8)
  let copy = string.repeat(x, 1)
  some(copy)
}

fn list_min_str(xs: List[String]) -> String? = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  if len <= 0 then none
  else __idx_str_some(h, __min_idx_str(h, len, 1, 0))
}

fn list_max_str(xs: List[String]) -> String? = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  if len <= 0 then none
  else __idx_str_some(h, __max_idx_str(h, len, 1, 0))
}
