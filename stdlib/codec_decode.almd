// codec_decode — SELF-HOSTED derived-Codec decode helpers (runtime/rs/src/value.rs):
// __decode_list_T (Array → List[T], first element error propagates), __decode_option_T
// (field: Null/absent → None, else Some(as_T)), __decode_default_T (Null/absent → default).
// Element decode reuses the self-hosted value.as_T; op order + error text mirror v0.
fn __is_null(v: Value) -> Bool = prim.load32(prim.handle(v) + 4) == 0

// ── List ──
fn __dl_int(items: List[Value], n: Int, i: Int, acc: List[Int]) -> Result[List[Int], String] = if i >= n then ok(acc)
else match value.as_int(list.get(items, i) ?? value.null()) {
  ok(x) => __dl_int(items, n, i + 1, acc + [x]),
  err(e) => err(__err_at_index(e, i)),
}

fn __decode_list_int(v: Value) -> Result[List[Int], String] = match value.as_array(v) {
  ok(items) => __dl_int(items, list.len(items), 0, []),
  err(e) => err(e),
}

fn __dl_float(items: List[Value], n: Int, i: Int, acc: List[Float]) -> Result[List[Float], String] = if i >= n then ok(acc)
else match value.as_float(list.get(items, i) ?? value.null()) {
  ok(x) => __dl_float(items, n, i + 1, acc + [x]),
  err(e) => err(__err_at_index(e, i)),
}

fn __decode_list_float(v: Value) -> Result[List[Float], String] = match value.as_array(v) {
  ok(items) => __dl_float(items, list.len(items), 0, []),
  err(e) => err(e),
}

fn __dl_bool(items: List[Value], n: Int, i: Int, acc: List[Bool]) -> Result[List[Bool], String] = if i >= n then ok(acc)
else match value.as_bool(list.get(items, i) ?? value.null()) {
  ok(x) => __dl_bool(items, n, i + 1, acc + [x]),
  err(e) => err(__err_at_index(e, i)),
}

fn __decode_list_bool(v: Value) -> Result[List[Bool], String] = match value.as_array(v) {
  ok(items) => __dl_bool(items, list.len(items), 0, []),
  err(e) => err(e),
}

// #1675: splice a path segment into a decode error. The canonical shape is
// `<leaf>, at <path>` — appending keeps composition a pure suffix edit: a
// parent frame prepends its segment (`city` -> `address.city`), and an index
// segment (`[1]`) joins without a dot (`tags[1]`). One implementation for
// BOTH targets: this is pure Almide, so native and wasm compile the same fn.
// (No string.split_once here: that fn has no wasm lowering yet — the scan
// uses len/slice/starts_with, which both legs link.)
fn __err_scan(e: String, n: Int, i: Int) -> Int = if i + 5 > n then 0 - 1
else if string.slice(e, i, i + 5) == ", at " then i
else __err_scan(e, n, i + 1)

fn __err_at(e: String, seg: String) -> String = {
  let n = string.len(e)
  let i = __err_scan(e, n, 0)
  if i < 0 then e + ", at " + seg
  else {
    let head = string.slice(e, 0, i)
    let path = string.slice(e, i + 5, n)
    if string.starts_with(path, "[") then head + ", at " + seg + path else head + ", at " + seg + "." + path
  }
}

// #1675: the list-element frame — `[i]` joins the path bracket-style.
fn __err_at_index(e: String, i: Int) -> String = __err_at(e, "[" + int.to_string(i) + "]")

fn __dl_string(items: List[Value], n: Int, i: Int, acc: List[String]) -> Result[List[String], String] = if i >= n then ok(acc)
else match value.as_string(list.get(items, i) ?? value.null()) {
  ok(x) => __dl_string(items, n, i + 1, acc + [x]),
  err(e) => err(__err_at_index(e, i)),
}

fn __decode_list_string(v: Value) -> Result[List[String], String] = match value.as_array(v) {
  ok(items) => __dl_string(items, list.len(items), 0, []),
  err(e) => err(e),
}

// ── Option (field: Null/absent → None, present → Some(as_T)) ──
// Mirrors runtime/rs value_decode_option: Ok(Null)/missing → None, Ok(val) → as_T(val).map(some).
fn __decode_option_int(v: Value, key: String) -> Result[Int?, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(none)
  else match value.as_int(fv) {
    ok(x) => ok(some(x)),
    err(e) => err(e),
  },
  err(_e) => ok(none),
}

fn __decode_option_float(v: Value, key: String) -> Result[Float?, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(none)
  else match value.as_float(fv) {
    ok(x) => ok(some(x)),
    err(e) => err(e),
  },
  err(_e) => ok(none),
}

fn __decode_option_bool(v: Value, key: String) -> Result[Bool?, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(none)
  else match value.as_bool(fv) {
    ok(x) => ok(some(x)),
    err(e) => err(e),
  },
  err(_e) => ok(none),
}

fn __decode_option_string(v: Value, key: String) -> Result[String?, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(none)
  else match value.as_string(fv) {
    ok(x) => ok(some(x)),
    err(e) => err(e),
  },
  err(_e) => ok(none),
}

// ── Default (field: Null/absent → default) ──
fn __decode_default_int(v: Value, key: String, default: Int) -> Result[Int, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else value.as_int(fv),
  err(_e) => ok(default),
}

fn __decode_default_float(v: Value, key: String, default: Float) -> Result[Float, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else value.as_float(fv),
  err(_e) => ok(default),
}

fn __decode_default_bool(v: Value, key: String, default: Bool) -> Result[Bool, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else value.as_bool(fv),
  err(_e) => ok(default),
}

fn __decode_default_string(v: Value, key: String, default: String) -> Result[String, String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else value.as_string(fv),
  err(_e) => ok(default),
}

// ── List defaults (#1520: `tags: List[String] = []`) — the same Null/absent →
// default rule, a present array decodes strictly through the list family. ──
fn __decode_default_list_int(v: Value, key: String, default: List[Int]) -> Result[List[Int], String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else __decode_list_int(fv),
  err(_e) => ok(default),
}

fn __decode_default_list_float(v: Value, key: String, default: List[Float]) -> Result[List[Float], String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else __decode_list_float(fv),
  err(_e) => ok(default),
}

fn __decode_default_list_bool(v: Value, key: String, default: List[Bool]) -> Result[List[Bool], String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else __decode_list_bool(fv),
  err(_e) => ok(default),
}

fn __decode_default_list_string(v: Value, key: String, default: List[String]) -> Result[List[String], String] = match value.field(v, key) {
  ok(fv) => if __is_null(fv) then ok(default) else __decode_list_string(fv),
  err(_e) => ok(default),
}
