// int64_convert — SELF-HOSTED int64.to_* sized conversions for v1: `int.to_<dst>(int.__from_int64(x))`
// unrolled to two `let`s (no call-as-arg), byte-matching int64.almd. Cross-file callees, pure
// scalar. `to_string` routes through signed int.to_string. There is no `to_int64` — identity.
fn int64_to_string(x: Int64) -> String = {
  let v = int.__from_int64(x)
  int.to_string(v)
}
