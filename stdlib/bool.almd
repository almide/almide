// bool — the Bool module (R-bool-01..03): parse, compare, to_string.
//
// Also the SELF-HOSTED `bool.to_string` for v1, the one new `to_string` the
// uniform string-interpolation desugar needs (`"flag=${b}"` → `"" ++
// bool.to_string(b)`): `__bool_to_string` below, registered in
// `self_host_runtime()` and renamed to bool.to_string there. Pure scalar `if` —
// NO heap, NO prim floor. The two String literals are the SAME bytes v0 emits
// for a Bool interpolation part, so a `${b}` interp byte-matches v0.
fn __bool_to_string(b: Bool) -> String = if b then "true" else "false"

/// "true" or "false"; bool.parse reads it back.
fn to_string(b: Bool) -> String = if b then "true" else "false"

/// ok(true) for "true", ok(false) for "false", err for anything else.
fn parse(s: String) -> Result[Bool, String] = match s {
  "true" => ok(true),
  "false" => ok(false),
  _ => err("provided string was not `true` or `false`"),
}

/// Negative if a < b, 0 if equal, positive if a > b; false < true.
fn compare(a: Bool, b: Bool) -> Int = if a == b then 0
else if b then -1 else 1
