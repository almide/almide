// list_sortby — SELF-HOSTED `list.sort_by` for v1 over the prim floor + closures. A STABLE
// sort by a CACHED key: the key fn f: (Int) -> Int ($closure_fn1) is called EXACTLY ONCE per
// element (matching v0's sort_by_cached_key), into a scratch key array; then a STABLE
// bottom-up mergesort reorders the value copy AND the key array together (O(n log n), #1459;
// `<=` takes the left run first so equal keys keep their order). List[Int]/Int key. The scratch key list is owned + dropped at scope end
// (no leak); the result value list is returned owned rc=1. Source borrowed.
fn __sb_init(bh: Int, sh: Int, kh: Int, f: fn(Int) -> Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let v = prim.load64(sh + 12 + i * 8)
  let k = f(v)
  prim.store64(bh + 12 + i * 8, v)
  prim.store64(kh + 12 + i * 8, k)
  __sb_init(bh, sh, kh, f, n, i + 1)
}

// ── stable bottom-up mergesort over the paired (value, key) buffers (#1459):
// O(n log n) in place of the O(n^2) insertion shift; `<=` takes the left run
// first, so equal keys keep their order (same stability contract as before).
fn __sb_mrun(svh: Int, skh: Int, dvh: Int, dkh: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
    else if i >= mid then false
    else prim.load64(skh + 12 + i * 8) <= prim.load64(skh + 12 + j * 8)
  if takel then {
    prim.store64(dvh + 12 + k * 8, prim.load64(svh + 12 + i * 8))
    prim.store64(dkh + 12 + k * 8, prim.load64(skh + 12 + i * 8))
    __sb_mrun(svh, skh, dvh, dkh, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dvh + 12 + k * 8, prim.load64(svh + 12 + j * 8))
    prim.store64(dkh + 12 + k * 8, prim.load64(skh + 12 + j * 8))
    __sb_mrun(svh, skh, dvh, dkh, mid, hi, i, j + 1, k + 1)
  }
}

fn __sb_mpass(svh: Int, skh: Int, dvh: Int, dkh: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __sb_mrun(svh, skh, dvh, dkh, mid, hi, lo, mid, lo)
  __sb_mpass(svh, skh, dvh, dkh, n, width, lo + width * 2)
}

fn __sb_mrounds(cvh: Int, ckh: Int, ovh: Int, okh: Int, n: Int, width: Int) -> Int = if width >= n then cvh
else {
  let _p = __sb_mpass(cvh, ckh, ovh, okh, n, width, 0)
  __sb_mrounds(ovh, okh, cvh, ckh, n, width * 2)
}

fn __sb_mcopy(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store64(dsth + 12 + i * 8, prim.load64(srch + 12 + i * 8))
  __sb_mcopy(srch, dsth, n, i + 1)
}

// Sorted values are guaranteed to END in bvh (and the keys in bkh): a final
// ping-pong landing in the scratch is copied back, so an OWNED key list (the
// String-key twin) never holds a stale handle at its recursive scope-end drop.
fn __sb_msort(bvh: Int, bkh: Int, tvh: Int, tkh: Int, n: Int) -> Int = {
  let fin = __sb_mrounds(bvh, bkh, tvh, tkh, n, 1)
  if fin == bvh then 0 else {
    let _v = __sb_mcopy(tvh, bvh, n, 0)
    __sb_mcopy(tkh, bkh, n, 0)
  }
}

fn list_sort_by(xs: List[Int], f: fn(Int) -> Int) -> List[Int] = {
  let n = list.len(xs)
  let buf = prim.alloc_list(n)
  let keys = prim.alloc_list(n)
  let _a = __sb_init(prim.handle(buf), prim.handle(xs), prim.handle(keys), f, n, 0)
  let tv = prim.alloc_list(n)
  let tk = prim.alloc_list(n)
  let _s = __sb_msort(prim.handle(buf), prim.handle(keys), prim.handle(tv), prim.handle(tk), n)
  buf
}

// HEAP-element variant (`sort_by(xs, (s) => string.len(s))` over a List[String]/List[R]):
// identical sort, but each element handle copied into the result is ACQUIRED (rc_inc) —
// the result list CO-OWNS every element, so both lists' recursive drops are balanced
// (the raw-copy variant shares without acquiring and the two deep drops double-free:
// rc_dec trap in the caller's epilogue). Mirrors list_sort_by_float_rc.
fn __sbr_init(bh: Int, sh: Int, kh: Int, f: fn(Int) -> Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let v = prim.load64(sh + 12 + i * 8)
  let k = f(v)
  prim.rc_inc(v)
  prim.store64(bh + 12 + i * 8, v)
  prim.store64(kh + 12 + i * 8, k)
  __sbr_init(bh, sh, kh, f, n, i + 1)
}

fn list_sort_by_rc(xs: List[Int], f: fn(Int) -> Int) -> List[Int] = {
  let n = list.len(xs)
  let buf = prim.alloc_list(n)
  let keys = prim.alloc_list(n)
  let _a = __sbr_init(prim.handle(buf), prim.handle(xs), prim.handle(keys), f, n, 0)
  let tv = prim.alloc_list(n)
  let tk = prim.alloc_list(n)
  let _s = __sb_msort(prim.handle(buf), prim.handle(keys), prim.handle(tv), prim.handle(tk), n)
  buf
}
