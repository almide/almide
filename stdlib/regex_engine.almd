// regex_engine — bundled-Almide stdlib module (the v1 trust-spine self-host of
// the regex runtime; STAGE 1: is_match + full_match).
//
// v0's `runtime/rs/src/regex.rs` is the SEMANTIC ORACLE, ported quirk-for-quirk:
//  - CHAR-based matching (UTF-8 decoded on the fly, codepoint compares);
//  - greedy backtracking with v0's ZERO-WIDTH repetition guard
//    (`consumed > 0 || count == 0` — `(a*)*` terminates);
//  - alternation is FIRST-WIN, and a GROUP boundary does not backtrack
//    (`(a|ab)c` on "abc" does NOT match — v0 semantics, kept);
//  - empty alternatives are natural (`a|`, `|a`, `a||b` all match anywhere);
//  - `.` matches any char EXCEPT '\n';
//  - escapes: \d \D \w \W \s \S classes ('\s' = space/tab/nl/cr), \n \t \r
//    literals, anything else the escaped char itself;
//  - classes: leading '^' negates; '\d' '\w' '\s' '\n' '\t' expand INSIDE a
//    class, any other escape is the literal char ('\D' in a class = 'D' — v0
//    quirk); 'a-z' ranges (a '-' before ']' or at the end is a literal);
//  - anchors '^' '$' are matched at sequence level and a quantifier on an
//    anchor is parsed but IGNORED (v0 quirk);
//  - no '{n,m}' counted repetition (zero corpus usage, v0 has none).
//
// All positions are BYTE ADDRESSES into the pattern/text data (handle + 12);
// `pe`/`te` are one-past-the-end addresses. Groups are MATCHED but captures are
// not yet extracted (regex.captures is a later stage). Like every self-host,
// this carries its own PCC certificates through the proven checker.
// ── UTF-8 decode ──
import prim

fn __rx_w(a: Int) -> Int = {
  let b = prim.load8(a)
  if b < 128 then 1
  else if b < 224 then 2
  else if b < 240 then 3 else 4
}

// ── pattern navigation (byte addresses; classes and groups are opaque) ──
// End of the class body starting AFTER '[' — the address just past the closing
// ']' (an escape skips the escaped char; an unterminated class ends at `pe`).
fn __rx_cp(a: Int) -> Int = {
  let b = prim.load8(a)
  if b < 128 then b
  else if b < 224 then (b - 192) * 64 + (prim.load8(a + 1) - 128)
  else if b < 240 then ((b - 224) * 64 + (prim.load8(a + 1) - 128)) * 64 + (prim.load8(a + 2) - 128) else (((b - 240) * 64 + (prim.load8(a + 1) - 128)) * 64 + (prim.load8(a + 2) - 128)) * 64 + (prim.load8(a + 3) - 128)
}

// End of the group starting AFTER '(' — the address just past the MATCHING ')'
// (nested groups tracked by depth; an unterminated group ends at `pe`, v0's
// tolerance).
// A `]` in the FIRST position (after an optional negating `^`) is a literal
// MEMBER, not the terminator — POSIX, and PCRE, Python, Rust, Go and JS all
// follow it. Read as a terminator, `[]]` became the empty class plus a stray
// `]` and silently never matched (#2129); the twin in runtime/rs/src/regex.rs
// carries the same rule.
fn __rx_class_end(p: Int, pe: Int) -> Int = {
  let q = if p < pe and prim.load8(p) == 94 then p + 1 else p
  __rx_class_scan(if q < pe and prim.load8(q) == 93 then q + 1 else q, pe)
}

fn __rx_class_scan(p: Int, pe: Int) -> Int = if p >= pe then pe
else {
  let b = prim.load8(p)
  if b == 93 then p + 1
  else if b == 92 and p + 1 < pe then __rx_class_scan(p + 1 + __rx_w(p + 1), pe) else __rx_class_scan(
    p + __rx_w(p),
    pe,
  )
}

// End of the ATOM starting at `p` (a class, a group, an escape+char, or one char).
fn __rx_group_end(p: Int, pe: Int, depth: Int) -> Int = if p >= pe then pe
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < pe then __rx_group_end(p + 1 + __rx_w(p + 1), pe, depth)
  else if b == 91 then __rx_group_end(__rx_class_end(p + 1, pe), pe, depth)
  else if b == 40 then __rx_group_end(p + 1, pe, depth + 1)
  else if b == 41 then {
    if depth == 0 then p + 1
    else __rx_group_end(p + 1, pe, depth - 1)
  } else __rx_group_end(p + __rx_w(p), pe, depth)
}

// End of a WELL-FORMED brace quantifier `{n}` / `{n,}` / `{n,m}` starting at
// the '{' at `p`: the address just past '}', or -1 if malformed (then the
// '{' stays a literal piece — same fallback as the native engine, #845).
fn __rx_atom_end(p: Int, pe: Int) -> Int = {
  let b = prim.load8(p)
  if b == 92 then {
    if p + 1 < pe then p + 1 + __rx_w(p + 1) else p + 1
  } else if b == 91 then __rx_class_end(p + 1, pe)
  else if b == 40 then __rx_group_end(p + 1, pe, 0)
  else p + __rx_w(p)
}

// First non-digit address in [p, pe).
fn __rx_brace_end(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  if d1 == p + 1 then 0 - 1
  else if d1 < pe and prim.load8(d1) == 125 then d1 + 1
  else if d1 < pe and prim.load8(d1) == 44 then {
    let d2 = __rx_digits_end(d1 + 1, pe)
    if d2 < pe and prim.load8(d2) == 125 then d2 + 1 else 0 - 1
  } else 0 - 1
}

// Decimal value of the digit run [p, e).
fn __rx_digits_end(p: Int, pe: Int) -> Int =
  if p < pe and prim.load8(p) >= 48 and prim.load8(p) <= 57 then __rx_digits_end(
    p + 1,
    pe,
  )
  else p

// min of the brace quantifier whose '{' is at `p` (well-formed by construction).
fn __rx_digits_val(p: Int, e: Int, acc: Int) -> Int = if p >= e then acc
else __rx_digits_val(p + 1, e, acc * 10 + (prim.load8(p) - 48))

// max of the brace quantifier whose '{' is at `p`; -1 = unbounded ({n,}).
fn __rx_brace_min(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  __rx_digits_val(p + 1, d1, 0)
}

// End of the PIECE (atom + one optional quantifier: * + ? or {n,m}).
fn __rx_brace_max(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  if prim.load8(d1) == 125 then __rx_digits_val(p + 1, d1, 0)
  else {
    let d2 = __rx_digits_end(d1 + 1, pe)
    if d2 == d1 + 1 then 0 - 1
    else __rx_digits_val(d1 + 1, d2, 0)
  }
}

// End of the current ALTERNATIVE: the address of the next top-level '|', or `pe`.
fn __rx_piece_end(p: Int, pe: Int) -> Int = {
  let ae = __rx_atom_end(p, pe)
  if ae < pe then {
    let q = prim.load8(ae)
    if q == 42 or q == 43 or q == 63 then {
      if ae + 1 < pe and prim.load8(ae + 1) == 63 then ae + 2 else ae + 1
    } else if q == 123 then {
      let be = __rx_brace_end(ae, pe)
      if be < 0 then ae
      else if be < pe and prim.load8(be) == 63 then be + 1 else be
    } else ae
  } else ae
}

// ── single-char matchers (codepoint `c` against the atom at [p, ae)) ──
fn __rx_alt_end(p: Int, pe: Int) -> Int = if p >= pe then pe
else {
  if prim.load8(p) == 124 then p else __rx_alt_end(__rx_piece_end(p, pe), pe)
}

// Does codepoint `c` hit any class item in [p, ie)? (v0's in-class expansions:
// \d \w \s \n \t; every other escape is the literal escaped char.)
fn __rx_esc_match(e: Int, c: Int) -> Bool = if e == 100 then c >= 48 and c <= 57
else if e == 68 then {
  if c >= 48 and c <= 57 then false else true
} else if e == 119 then (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
else if e == 87 then {
  if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 then false else true
} else if e == 115 then c == 32 or c == 9 or c == 10 or c == 13
else if e == 83 then {
  if c == 32 or c == 9 or c == 10 or c == 13 then false else true
} else if e == 110 then c == 10
else if e == 116 then c == 9
else if e == 114 then c == 13 else c == e

// Match ONE text char at `t` against the non-group atom at [p, ae).
fn __rx_class_hit(p: Int, ie: Int, c: Int) -> Bool = if p >= ie then false
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < ie then {
    let e = prim.load8(p + 1)
    let hit = if e == 100 then c >= 48 and c <= 57
    else if e == 119 then (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
    else if e == 115 then c == 32 or c == 9 or c == 10 or c == 13
    else if e == 110 then c == 10
    else if e == 116 then c == 9 else c == __rx_cp(p + 1)
    if hit then true
    else __rx_class_hit(p + 1 + __rx_w(p + 1), ie, c)
  } else {
    let cw = __rx_w(p)
    let lo = __rx_cp(p)
    if p + cw < ie and prim.load8(p + cw) == 45 and p + cw + 1 < ie and prim.load8(p + cw + 1) != 93 then {
      let hi = __rx_cp(p + cw + 1)
      if c >= lo and c <= hi then true
      else __rx_class_hit(p + cw + 1 + __rx_w(p + cw + 1), ie, c)
    } else {
      if c == lo then true
      else __rx_class_hit(p + cw, ie, c)
    }
  }
}

// ── the backtracking matcher ──
// Match ONE text char at `t` against the non-group atom at [p, ae).
fn __rx_char_match(p: Int, ae: Int, t: Int, te: Int) -> Bool = if t >= te then false
else {
  let c = __rx_cp(t)
  let b = prim.load8(p)
  if b == 46 then c != 10
  else if b == 91 then {
    let ie = if ae > p + 1 and prim.load8(ae - 1) == 93 then ae - 1 else ae
    let neg = p + 1 < ie and prim.load8(p + 1) == 94
    let ps = if neg then p + 2 else p + 1
    let hit = __rx_class_hit(ps, ie, c)
    if neg then {
      if hit then false else true
    } else hit
  } else if b == 92 then {
    if ae == p + 1 then c == 92 else __rx_esc_match(prim.load8(p + 1), c)
  } else c == __rx_cp(p)
}

// ── the matcher: a backtracking walk whose state lives in an arena (#2307) ──
// The walk is the native engine's (runtime/rs/src/regex.rs), in the same
// order: leftmost alternative first, greedy quantifiers longest-first, lazy
// ones shortest-first, an empty repetition instance ends its loop, and a
// group's capture is written when the group ends and restored when the walk
// backtracks past it. Every call between the matcher's own functions is a
// TAIL call, so the wasm stack stays flat whatever the input's length (a
// repeated group used to take stack per repetition and trapped past about
// 5,000 of them). The state recursion used to hold lives in an ARENA of
// 8-byte slots, addressed by byte OFFSET so the arena can move when it grows:
//  - continuation FRAMES, what runs when a sequence ends. `k` is a frame
//    offset, or -1 once the whole pattern has matched. 1 = SEQ [pnext, pend,
//    next]; 2 = GROUP_END [ci, tstart, next] (writes the capture); 3 = REP
//    [p, ae, pnext, pend, count, mn, mx, next, tprev, lazy] (one more
//    instance of a repeated group, or the rest).
//  - CHOICES, the untried alternatives, linked newest-first from `bt`, each
//    [kind, prev, fields]: 11 = ALTS [p, pend, t, k]; 12 = SEQ [p, pend, t,
//    k]; 13 = GROUP [p, ae, t, k] (one more lazy instance); 14 = BACK [pnext,
//    pend, t, count, mn, k] (a greedy atom gives back one char); 15 = LAZY
//    [p, ae, pnext, pend, t, count, mn, mx, k] (a lazy atom takes one more);
//    16 = UNDO [slot, start, end] (a capture write to take back).
// A failure resumes the newest choice and cuts the arena back to it, which
// frees everything made after it; a frame that runs with nothing made after
// it is freed as it runs. The machine block `m` (__rx_vm) holds, in 8-byte
// slots: 0 arena base, 1 arena capacity in bytes, 2 top (offset), 3 bt
// (newest choice, -1 = none), 4 ts, 5 te, 6 caps (the capture buffer, 0 = no
// capture writes), 7 pat0, 8 end_at (-1 = a match may end anywhere;
// full_match passes te), 9 the end of the last match found, 10 the capture
// buffer's slot count, 11-14 a suspended step (p, pend, t, k), 15 the Pike
// VM's work block once the walk has handed over (0 = none), 16 steps taken,
// 17 the step budget (-1 = none), 18 1 once the walk gave up. The first arena
// follows at slot 20.
// Flags: a leading `(?m)` makes `^`/`$` line anchors; `(?:…)` groups do not
// capture; `\b`/`\B` are word-boundary assertions; a quantifier followed by
// `?` is LAZY.
fn __rx_back(t: Int, ts: Int) -> Int = {
  let t1 = t - 1
  if t1 <= ts then ts
  else if prim.band(prim.load8(t1), 192) == 128 then __rx_back(t1, ts) else t1
}

fn __rx_flags(pat0: Int) -> Int =
  if prim.load8(pat0) == 40 and prim.load8(pat0 + 1) == 63 and prim.load8(pat0 + 2) == 109 and prim.load8(pat0 + 3) == 41 then 1 else 0

fn __rx_is_word(c: Int) -> Bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

// Word boundary at t: the word-ness of the char before differs from the one at t.
fn __rx_at_boundary(t: Int, ts: Int, te: Int) -> Bool = {
  let before = if t <= ts then false else __rx_is_word(prim.load8(__rx_back(t, ts)))
  let after = if t >= te then false else __rx_is_word(prim.load8(t))
  before != after
}

fn __rx_bol(t: Int, ts: Int, pat0: Int) -> Bool = t == ts or (__rx_flags(pat0) == 1 and prim.load8(t - 1) == 10)

fn __rx_eol(t: Int, te: Int, pat0: Int) -> Bool = t == te or (__rx_flags(pat0) == 1 and prim.load8(t) == 10)

// The machine block for one public call (layout above), with the first arena
// inside it. Owned by the caller and dropped with it.
fn __rx_vm(pat0: Int, pe: Int, ts: Int, te: Int, caps: Int, nslots: Int, end_at: Int) -> List[Int] = {
  let vm = prim.alloc_list(276)
  let m = prim.handle(vm) + 12
  prim.store64(m, m + 160)
  prim.store64(m + 8, 2048)
  prim.store64(m + 32, ts)
  prim.store64(m + 40, te)
  prim.store64(m + 48, caps)
  prim.store64(m + 56, pat0)
  prim.store64(m + 64, end_at)
  prim.store64(m + 80, nslots)
  prim.store64(m + 120, 0)
  prim.store64(m + 128, 0)
  prim.store64(m + 136, 4 * (pe - pat0 + 1) * (te - ts + 1))
  prim.store64(m + 144, 0)
  vm
}

// One match attempt of the alternatives [p, pend) at `t`: the end of the
// first match the walk reaches, or -1.
fn __rx_exec(p: Int, pend: Int, t: Int, m: Int) -> Int = {
  prim.store64(m + 16, 0)
  prim.store64(m + 24, 0 - 1)
  let caps = prim.load64(m + 48)
  let _0 = if caps == 0 then 0 else __rx_fill_neg(caps, prim.load64(m + 80))
  __rx_drive(__rx_alts(p, pend, t, 0 - 1, m), m)
}

// -2 = the walk stopped to grow its arena; anything else is its answer.
fn __rx_drive(r: Int, m: Int) -> Int = if r == 0 - 2 then __rx_grow(m) else r

// Move the arena into one twice its size and resume the stopped step there.
// The new arena is this call's own list, so it has to outlive the rest of the
// walk: the resume is not a tail call, and nests once per doubling. The old
// arena is put back afterwards for the next attempt.
fn __rx_grow(m: Int) -> Int = {
  let base = prim.load64(m)
  let cap = prim.load64(m + 8)
  let arena = prim.alloc_list(cap / 4)
  let nb = prim.handle(arena) + 12
  let _0 = __rx_copy64(base, nb, prim.load64(m + 16) / 8)
  prim.store64(m, nb)
  prim.store64(m + 8, cap * 2)
  let p = prim.load64(m + 88)
  let pend = prim.load64(m + 96)
  let t = prim.load64(m + 104)
  let k = prim.load64(m + 112)
  let r = __rx_drive(__rx_seq(p, pend, t, k, m), m)
  prim.store64(m, base)
  prim.store64(m + 8, cap)
  r
}

// Stop the walk at the step (p, pend, t, k) so the arena can grow: -2.
fn __rx_suspend(p: Int, pend: Int, t: Int, k: Int, m: Int) -> Int = {
  prim.store64(m + 88, p)
  prim.store64(m + 96, pend)
  prim.store64(m + 104, t)
  prim.store64(m + 112, k)
  0 - 2
}

// Take `n` slots at the arena top: their offset. __rx_seq keeps 512 bytes
// free, and no step between two of its calls takes more than 32 slots.
fn __rx_take(m: Int, n: Int) -> Int = {
  let off = prim.load64(m + 16)
  prim.store64(m + 16, off + n * 8)
  off
}

// A SEQ or GROUP_END frame [kind, a, b, c]: its offset.
fn __rx_frame3(m: Int, kind: Int, a: Int, b: Int, c: Int) -> Int = {
  let off = __rx_take(m, 4)
  let at = prim.load64(m) + off
  prim.store64(at, kind)
  prim.store64(at + 8, a)
  prim.store64(at + 16, b)
  prim.store64(at + 24, c)
  off
}

// A REP frame: the instance after `count` of the repeated group at [p, ae)
// starts at `t`. Its offset.
fn __rx_rep_frame(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, count: Int, mn: Int, mx: Int, lazy: Int, k: Int, m: Int) -> Int = {
  let off = __rx_take(m, 11)
  let at = prim.load64(m) + off
  prim.store64(at, 3)
  prim.store64(at + 8, p)
  prim.store64(at + 16, ae)
  prim.store64(at + 24, pnext)
  prim.store64(at + 32, pend)
  prim.store64(at + 40, count)
  prim.store64(at + 48, mn)
  prim.store64(at + 56, mx)
  prim.store64(at + 64, k)
  prim.store64(at + 72, t)
  prim.store64(at + 80, lazy)
  off
}

// Link `n` slots at the arena top as the newest choice of `kind`: the
// address of its first field.
fn __rx_choice(m: Int, kind: Int, n: Int) -> Int = {
  let off = __rx_take(m, n)
  let at = prim.load64(m) + off
  prim.store64(at, kind)
  prim.store64(at + 8, prim.load64(m + 24))
  prim.store64(m + 24, off)
  at + 16
}

// An ALTS, SEQ or GROUP choice.
fn __rx_choice4(m: Int, kind: Int, a: Int, b: Int, c: Int, d: Int) -> Int = {
  let f = __rx_choice(m, kind, 6)
  prim.store64(f, a)
  prim.store64(f + 8, b)
  prim.store64(f + 16, c)
  prim.store64(f + 24, d)
  0
}

// BACK: next, continue after `count` chars of the greedy atom, ending at `t`.
fn __rx_back_choice(pnext: Int, pend: Int, t: Int, count: Int, mn: Int, k: Int, m: Int) -> Int = {
  let f = __rx_choice(m, 14, 8)
  prim.store64(f, pnext)
  prim.store64(f + 8, pend)
  prim.store64(f + 16, t)
  prim.store64(f + 24, count)
  prim.store64(f + 32, mn)
  prim.store64(f + 40, k)
  0
}

// LAZY: next, the lazy atom goes on from `count` chars ending at `t`.
fn __rx_lazy_choice(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, count: Int, mn: Int, mx: Int, k: Int, m: Int) -> Int = {
  let f = __rx_choice(m, 15, 11)
  prim.store64(f, p)
  prim.store64(f + 8, ae)
  prim.store64(f + 16, pnext)
  prim.store64(f + 24, pend)
  prim.store64(f + 32, t)
  prim.store64(f + 40, count)
  prim.store64(f + 48, mn)
  prim.store64(f + 56, mx)
  prim.store64(f + 64, k)
  0
}

// UNDO: the capture `slot` is about to be overwritten; keep what it held.
fn __rx_undo(slot: Int, m: Int) -> Int = {
  let f = __rx_choice(m, 16, 5)
  prim.store64(f, slot)
  prim.store64(f + 8, prim.load64(slot))
  prim.store64(f + 16, prim.load64(slot + 8))
  0
}

// A failure resumes the newest choice and cuts the arena back to it; -1 once
// none is left (no match at this start).
fn __rx_fail(m: Int) -> Int = {
  let b = prim.load64(m + 24)
  if b < 0 then 0 - 1
  else {
    let at = prim.load64(m) + b
    let kind = prim.load64(at)
    if kind == 14 then {
      // the group-repetition frame's resume, inlined (#2307): as its only
      // caller, keeping it a separate fn made this a mutual-recursion group
      // the incumbent leg cannot render
      let t = prim.load64(at + 32)
      let count = prim.load64(at + 40)
      let keep = count > prim.load64(at + 48)
      prim.store64(at + 32, __rx_back(t, prim.load64(m + 32)))
      prim.store64(at + 40, count - 1)
      prim.store64(m + 16, if keep then b + 64 else b)
      prim.store64(m + 24, if keep then b else prim.load64(at + 8))
      __rx_seq(prim.load64(at + 16), prim.load64(at + 24), t, prim.load64(at + 56), m)
    } else {
      prim.store64(m + 16, b)
      prim.store64(m + 24, prim.load64(at + 8))
      __rx_resume(kind, at + 16, m)
    }
  }
}

// Run the choice just popped, its fields at `f`. Its slots are free again, so
// every field is read before the step it resumes allocates anything.
fn __rx_resume(kind: Int, f: Int, m: Int) -> Int = match kind {
  11 => __rx_alts(prim.load64(f), prim.load64(f + 8), prim.load64(f + 16), prim.load64(f + 24), m),
  12 => __rx_seq(prim.load64(f), prim.load64(f + 8), prim.load64(f + 16), prim.load64(f + 24), m),
  13 => __rx_group(prim.load64(f), prim.load64(f + 8), prim.load64(f + 16), prim.load64(f + 24), m),
  15 => __rx_rep_lazy(
    prim.load64(f),
    prim.load64(f + 8),
    prim.load64(f + 16),
    prim.load64(f + 24),
    prim.load64(f + 32),
    prim.load64(f + 40),
    prim.load64(f + 48),
    prim.load64(f + 56),
    prim.load64(f + 64),
    m,
  ),
  _ => __rx_restore(f, m),
}

// UNDO: put the capture slot back, then keep failing.
fn __rx_restore(f: Int, m: Int) -> Int = {
  let slot = prim.load64(f)
  prim.store64(slot, prim.load64(f + 8))
  prim.store64(slot + 8, prim.load64(f + 16))
  __rx_fail(m)
}

// Run continuation `k` at text position `t`.
fn __rx_run(k: Int, t: Int, m: Int) -> Int = if k < 0 then {
  let e = prim.load64(m + 64)
  if e < 0 or t == e then t else __rx_fail(m)
} else {
  let at = prim.load64(m) + k
  let kind = prim.load64(at)
  if kind == 3 then __rx_run_rep(at, k, t, m)
  else {
    let a = prim.load64(at + 8)
    let c = prim.load64(at + 16)
    let next = prim.load64(at + 24)
    let _0 = __rx_free_top(k, 32, m)
    if kind == 1 then __rx_seq(a, c, t, next, m)
    else __rx_close_group(a, c, next, t, m)
  }
}

// A frame that runs with nothing made after it has no other reader: free it.
fn __rx_free_top(k: Int, size: Int, m: Int) -> Int = {
  let top = prim.load64(m + 16)
  prim.store64(m + 16, if k + size == top then k else top)
  0
}

// A group instance ended at `t`: write its capture (ci < 0 = non-capturing),
// keeping the old value on the chain while a choice could still need it.
fn __rx_close_group(ci: Int, tstart: Int, next: Int, t: Int, m: Int) -> Int = {
  let caps = prim.load64(m + 48)
  if caps == 0 or ci < 0 then __rx_run(next, t, m)
  else {
    let slot = caps + ci * 16
    let _0 = if prim.load64(m + 24) < 0 then 0 else __rx_undo(slot, m)
    prim.store64(slot, tstart)
    prim.store64(slot + 8, t)
    __rx_run(next, t, m)
  }
}

// A repeated group's instance just ended at `t`: one more instance, or the
// rest. An empty instance counts, but never loops.
fn __rx_run_rep(at: Int, k: Int, t: Int, m: Int) -> Int = {
  let p = prim.load64(at + 8)
  let ae = prim.load64(at + 16)
  let pnext = prim.load64(at + 24)
  let pend = prim.load64(at + 32)
  let count = prim.load64(at + 40) + 1
  let mn = prim.load64(at + 48)
  let mx = prim.load64(at + 56)
  let next = prim.load64(at + 64)
  let tprev = prim.load64(at + 72)
  let lazy = prim.load64(at + 80)
  let _0 = __rx_free_top(k, 88, m)
  if t != tprev then __rx_rep_group(p, ae, pnext, pend, t, count, mn, mx, lazy, next, m)
  else if count < mn then __rx_fail(m)
  else __rx_seq(pnext, pend, t, next, m)
}

// The repeated GROUP at [p, ae) has `count` instances ending at `t`: greedy
// tries one more instance before the rest, lazy the rest first.
fn __rx_rep_group(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, count: Int, mn: Int, mx: Int, lazy: Int, k: Int, m: Int) -> Int = {
  let more = mx < 0 or count < mx
  let rest = count >= mn
  if more and rest then {
    if lazy == 1 then {
      let fr = __rx_rep_frame(p, ae, pnext, pend, t, count, mn, mx, lazy, k, m)
      let _0 = __rx_choice4(m, 13, p, ae, t, fr)
      __rx_seq(pnext, pend, t, k, m)
    } else {
      let _0 = __rx_choice4(m, 12, pnext, pend, t, k)
      let fr = __rx_rep_frame(p, ae, pnext, pend, t, count, mn, mx, lazy, k, m)
      __rx_group(p, ae, t, fr, m)
    }
  } else if more then {
    let fr = __rx_rep_frame(p, ae, pnext, pend, t, count, mn, mx, lazy, k, m)
    __rx_group(p, ae, t, fr, m)
  } else if rest then __rx_seq(pnext, pend, t, k, m)
  else __rx_fail(m)
}

// One instance of the group at [p, ae): its alternatives, each continuing
// into a GROUP_END frame that writes the capture.
fn __rx_group(p: Int, ae: Int, t: Int, k: Int, m: Int) -> Int = {
  let ce = if ae > p + 1 and prim.load8(ae - 1) == 41 then ae - 1 else ae
  let noncap = prim.load8(p + 1) == 63
  let body = if noncap then p + 3 else p + 1
  let caps = prim.load64(m + 48)
  let ci = if noncap or caps == 0 then 0 - 1 else __rx_ngroups(prim.load64(m + 56), p)
  __rx_alts(body, ce, t, __rx_frame3(m, 2, ci, t, k), m)
}

// Alternation over [p, pend): the first alternative now, the next one left as
// a choice.
fn __rx_alts(p: Int, pend: Int, t: Int, k: Int, m: Int) -> Int = {
  let aend = __rx_alt_end(p, pend)
  let _0 = if aend < pend then __rx_choice4(m, 11, aend + 1, pend, t, k)
  else 0
  __rx_seq(p, aend, t, k, m)
}

// Is the piece ending at `pnext` lazy (`*?` `+?` `??` `{n,m}?`)? The lazy `?`
// sits at pnext-1 with a quantifier char right before it.
fn __rx_lazy(ae: Int, pnext: Int) -> Int =
  if pnext >= ae + 2 and prim.load8(pnext - 1) == 63 and (prim.load8(pnext - 2) == 42 or prim.load8(pnext - 2) == 43 or prim.load8(pnext - 2) == 63 or prim.load8(pnext - 2) == 125) then 1 else 0

// Match the sequence [p, pend) at `t`, then `k`. Every step passes here, so
// this is where the arena is kept from filling up.
fn __rx_seq(p: Int, pend: Int, t: Int, k: Int, m: Int) -> Int = {
  let room = prim.load64(m + 8) - prim.load64(m + 16)
  if room < 512 then __rx_suspend(p, pend, t, k, m)
  else if __rx_tick(m) then 0 - 3
  else if p >= pend then __rx_run(k, t, m)
  else __rx_piece(p, pend, t, k, m)
}

fn __rx_piece(p: Int, pend: Int, t: Int, k: Int, m: Int) -> Int = {
  let b = prim.load8(p)
  let pnext = __rx_piece_end(p, pend)
  let ts = prim.load64(m + 32)
  let te = prim.load64(m + 40)
  let pat0 = prim.load64(m + 56)
  if b == 94 then {
    if __rx_bol(t, ts, pat0) then __rx_seq(pnext, pend, t, k, m)
    else __rx_fail(m)
  } else if b == 36 then {
    if __rx_eol(t, te, pat0) then __rx_seq(pnext, pend, t, k, m)
    else __rx_fail(m)
  } else if b == 92 and p + 1 < pend and (prim.load8(p + 1) == 98 or prim.load8(p + 1) == 66) then {
    let want = prim.load8(p + 1) == 98
    if __rx_at_boundary(t, ts, te) == want then __rx_seq(pnext, pend, t, k, m)
    else __rx_fail(m)
  } else if b == 40 and p == pat0 and __rx_flags(pat0) == 1 then __rx_seq(pnext, pend, t, k, m)
  else {
    let ae = __rx_atom_end(p, pend)
    if ae < pnext then __rx_quant(p, ae, pnext, pend, t, k, m)
    else if b == 40 then __rx_group(p, ae, t, __rx_frame3(m, 1, pnext, pend, k), m)
    else if __rx_char_match(p, ae, t, te) then __rx_seq(pnext, pend, t + __rx_w(t), k, m)
    else __rx_fail(m)
  }
}

// A quantified piece: the atom at [p, ae), its quantifier at [ae, pnext).
fn __rx_quant(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, k: Int, m: Int) -> Int = {
  let q = prim.load8(ae)
  let lazy = __rx_lazy(ae, pnext)
  let mn = if q == 42 then 0
  else if q == 43 then 1
  else if q == 63 then 0 else __rx_brace_min(ae, pnext)
  let mx = if q == 42 then 0 - 1
  else if q == 43 then 0 - 1
  else if q == 63 then 1 else __rx_brace_max(ae, pnext)
  if prim.load8(p) == 40 then __rx_rep_group(p, ae, pnext, pend, t, 0, mn, mx, lazy, k, m)
  else if lazy == 1 then __rx_rep_lazy(p, ae, pnext, pend, t, 0, mn, mx, k, m)
  else __rx_repi_fwd(p, ae, pnext, pend, t, 0, mn, mx, k, m)
}

// Non-group atom, LAZY: the rest first, leaving a choice that takes one more
// char.
fn __rx_rep_lazy(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, count: Int, mn: Int, mx: Int, k: Int, m: Int) -> Int = {
  let more = (mx < 0 or count < mx) and __rx_char_match(p, ae, t, prim.load64(m + 40))
  let t1 = if more then t + __rx_w(t) else t
  if count >= mn then {
    let _0 = if more then __rx_lazy_choice(p, ae, pnext, pend, t1, count + 1, mn, mx, k, m)
    else 0
    __rx_seq(pnext, pend, t, k, m)
  } else if more then __rx_rep_lazy(p, ae, pnext, pend, t1, count + 1, mn, mx, k, m)
  else __rx_fail(m)
}

// Non-group atom, GREEDY (#1524): walk forward to the deepest count, then try
// the rest there, leaving a choice that gives back one char at a time.
fn __rx_repi_fwd(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, count: Int, mn: Int, mx: Int, k: Int, m: Int) -> Int = {
  let under_max = if mx < 0 then true else count < mx
  if __rx_tick(m) then 0 - 3
  else if under_max and __rx_char_match(p, ae, t, prim.load64(m + 40)) then __rx_repi_fwd(
    p,
    ae,
    pnext,
    pend,
    t + __rx_w(t),
    count + 1,
    mn,
    mx,
    k,
    m,
  )
  else __rx_repi_try(pnext, pend, t, count, mn, k, m)
}

fn __rx_repi_try(pnext: Int, pend: Int, t: Int, i: Int, mn: Int, k: Int, m: Int) -> Int =
  if i < mn then __rx_fail(m)
  else {
    let ts = prim.load64(m + 32)
    let _0 = if i > mn then __rx_back_choice(pnext, pend, __rx_back(t, ts), i - 1, mn, k, m)
    else 0
    __rx_seq(pnext, pend, t, k, m)
  }

// ── linear-time matching: a Pike VM (#4019) ──
// The walk above can take time exponential in the input's length (`(a+)+$` on
// "aaaa…a!"). The twin of runtime/rs/src/regex.rs's Pike VM gives the walk's
// answers — its first success, span and every group — in time proportional to
// the program's size times the input's length. The pattern is compiled to a
// program (Thompson's NFA, the walk's preferences as instruction order) and all
// of its threads advance one character at a time in priority order; two threads
// in the same STATE at the same position have the same future, so only the
// higher-priority one is kept, and cutting every lower thread at MATCH leaves
// the walk's answer.
//
// A state is (pc, d). An instance of a repeated group that matched nothing
// counts but never loops (__rx_run_rep), and only an instance that began at the
// current position can be empty; instances nest, so those are the innermost
// open ones. `d` counts the open instances of TRACKED groups (whose body can
// match empty) that began before here; reading a character makes them all old.
//
// Counted repetition is expanded, one body copy per count. Past 20,000 states
// the pattern is matched by the walk instead — the same answers without the
// linear bound — so a huge `{n}` cannot allocate without limit.
//
// The program is 6 slots per instruction: [op, a, b, c, e, depth], depth = the
// tracked instances open there. Ops: 1 CHAR [p, ae] (the atom's pattern
// bytes); 2 ASSERT [kind: 0 ^, 1 $, 2 \b, 3 \B]; 3 SPLIT [first, second];
// 4 JMP [to]; 5 GSTART [ci]; 6 GEND [ci, outer (-1 = untracked), empty
// (-1 = fail), nonempty]; 7 MATCH; 8 FAIL. ci is 1-based, 0 = no capture.
// Targets not known yet are HOLES: the field holds the next hole of its chain
// (pc * 8 + field, -1 ends it) until __rx_patch fills the chain.
//
// The compiler block `cb` (8-byte slots): 0 program address (0 = a dry run that
// only counts), 1 instructions so far, 2 tracked instances open, 3 the deepest
// nesting of them, 4 over budget (1), 5 pat0.
fn __rx_cslot(cb: Int, i: Int) -> Int = prim.load64(cb + i * 8)

fn __rx_cset(cb: Int, i: Int, v: Int) -> Int = {
  prim.store64(cb + i * 8, v)
  0
}

// Append one instruction: its index.
fn __rx_emit(cb: Int, op: Int, a: Int, b: Int, c: Int, e: Int) -> Int = {
  let n = __rx_cslot(cb, 1)
  let base = __rx_cslot(cb, 0)
  let _0 = if base == 0 then 0
  else {
    let at = base + n * 48
    prim.store64(at, op)
    prim.store64(at + 8, a)
    prim.store64(at + 16, b)
    prim.store64(at + 24, c)
    prim.store64(at + 32, e)
    prim.store64(at + 40, __rx_cslot(cb, 2))
    0
  }
  let _1 = __rx_cset(cb, 1, n + 1)
  let _2 = if (n + 1) * (__rx_cslot(cb, 3) + 1) > 20000 then __rx_cset(cb, 4, 1)
  else 0
  n
}

// Write field `f` of instruction `pc` (not in a dry run).
fn __rx_iset(cb: Int, pc: Int, f: Int, v: Int) -> Int = {
  let base = __rx_cslot(cb, 0)
  let _0 = if base == 0 then 0
  else {
    prim.store64(base + pc * 48 + f * 8, v)
    0
  }
  0
}

// Make field `f` of instruction `pc` a hole on `chain`: the new chain head.
fn __rx_hole(cb: Int, pc: Int, f: Int, chain: Int) -> Int = {
  let _0 = __rx_iset(cb, pc, f, chain)
  pc * 8 + f
}

// Fill every hole of `chain` with `to`.
fn __rx_patch(cb: Int, chain: Int, to: Int) -> Int = {
  let base = __rx_cslot(cb, 0)
  if chain < 0 or base == 0 then 0
  else {
    let at = base + (chain / 8) * 48 + (chain % 8) * 8
    let next = prim.load64(at)
    prim.store64(at, to)
    __rx_patch(cb, next, to)
  }
}

fn __rx_over(cb: Int) -> Bool = __rx_cslot(cb, 4) == 1

// Can the alternatives [p, pend) match without reading a character? An
// assertion counts as matching nothing — an over-approximation, the safe side.
fn __rx_null_alts(p: Int, pend: Int, pat0: Int) -> Bool = {
  let aend = __rx_alt_end(p, pend)
  if __rx_null_seq(p, aend, pat0) then true
  else if aend < pend then __rx_null_alts(aend + 1, pend, pat0)
  else false
}

fn __rx_null_seq(p: Int, pend: Int, pat0: Int) -> Bool = if p >= pend then true
else if __rx_null_piece(p, pend, pat0) then __rx_null_seq(__rx_piece_end(p, pend), pend, pat0)
else false

fn __rx_null_piece(p: Int, pend: Int, pat0: Int) -> Bool = {
  let b = prim.load8(p)
  let pnext = __rx_piece_end(p, pend)
  let ae = __rx_atom_end(p, pend)
  if b == 94 or b == 36 then true
  else if b == 92 and p + 1 < pend and (prim.load8(p + 1) == 98 or prim.load8(p + 1) == 66) then true
  else if b == 40 and p == pat0 and __rx_flags(pat0) == 1 then true
  else if ae < pnext and __rx_quant_min(ae, pnext) == 0 then true
  else if b == 40 then {
    let ce = if ae > p + 1 and prim.load8(ae - 1) == 41 then ae - 1 else ae
    __rx_null_alts(if prim.load8(p + 1) == 63 then p + 3 else p + 1, ce, pat0)
  } else false
}

// The quantifier at [ae, pnext): its minimum, its maximum (-1 = unbounded).
fn __rx_quant_min(ae: Int, pnext: Int) -> Int = {
  let q = prim.load8(ae)
  if q == 42 or q == 63 then 0
  else if q == 43 then 1 else __rx_brace_min(ae, pnext)
}

fn __rx_quant_max(ae: Int, pnext: Int) -> Int = {
  let q = prim.load8(ae)
  if q == 42 or q == 43 then 0 - 1
  else if q == 63 then 1 else __rx_brace_max(ae, pnext)
}

// The alternatives [p, pend), each one's end jumping past the rest.
fn __rx_c_alts(cb: Int, p: Int, pend: Int, ends: Int) -> Int =
  if __rx_over(cb) then 0
  else {
    let aend = __rx_alt_end(p, pend)
    if aend < pend then {
      let sp = __rx_emit(cb, 3, __rx_cslot(cb, 1) + 1, 0, 0, 0)
      let _0 = __rx_c_seq(cb, p, aend)
      let j = __rx_emit(cb, 4, 0, 0, 0, 0)
      let ends2 = __rx_hole(cb, j, 1, ends)
      let _1 = __rx_iset(cb, sp, 2, __rx_cslot(cb, 1))
      __rx_c_alts(cb, aend + 1, pend, ends2)
    } else {
      let _0 = __rx_c_seq(cb, p, aend)
      __rx_patch(cb, ends, __rx_cslot(cb, 1))
    }
  }

// The pieces of [p, pend) in order — the walk's __rx_piece, compiled.
fn __rx_c_seq(cb: Int, p: Int, pend: Int) -> Int = if p >= pend or __rx_over(cb) then 0
else {
  let _0 = __rx_c_piece(cb, p, pend)
  __rx_c_seq(cb, __rx_piece_end(p, pend), pend)
}

fn __rx_c_piece(cb: Int, p: Int, pend: Int) -> Int = {
  let b = prim.load8(p)
  let pnext = __rx_piece_end(p, pend)
  let pat0 = __rx_cslot(cb, 5)
  if b == 94 then __rx_emit(cb, 2, 0, 0, 0, 0)
  else if b == 36 then __rx_emit(cb, 2, 1, 0, 0, 0)
  else if b == 92 and p + 1 < pend and (prim.load8(p + 1) == 98 or prim.load8(p + 1) == 66) then __rx_emit(
    cb,
    2,
    if prim.load8(p + 1) == 98 then 2 else 3,
    0,
    0,
    0,
  )
  else if b == 40 and p == pat0 and __rx_flags(pat0) == 1 then 0
  else {
    let ae = __rx_atom_end(p, pend)
    let quantified = ae < pnext
    let mn = if quantified then __rx_quant_min(ae, pnext) else 1
    let mx = if quantified then __rx_quant_max(ae, pnext) else 1
    let lazy = if quantified then __rx_lazy(ae, pnext) else 0
    if mx >= 0 and mn > mx then __rx_emit(cb, 8, 0, 0, 0, 0)
    else if b == 40 then __rx_c_group(cb, p, ae, mn, mx, lazy)
    else __rx_c_atom(cb, p, ae, mn, mx, lazy)
  }
}

// `k` required copies of the atom [p, ae).
fn __rx_c_chars(cb: Int, p: Int, ae: Int, k: Int) -> Int = if k <= 0 or __rx_over(cb) then 0
else {
  let _0 = __rx_emit(cb, 1, p, ae, 0, 0)
  __rx_c_chars(cb, p, ae, k - 1)
}

// The optional copies k..mx of a bounded atom: greedy prefers one more, lazy
// prefers to stop; every refusal jumps to the end (the `exits` chain).
fn __rx_c_opt(cb: Int, p: Int, ae: Int, k: Int, mx: Int, lazy: Int, exits: Int) -> Int =
  if k >= mx or __rx_over(cb) then __rx_patch(cb, exits, __rx_cslot(cb, 1))
  else {
    let sp = __rx_emit(cb, 3, 0, 0, 0, 0)
    let body = __rx_emit(cb, 1, p, ae, 0, 0)
    let _0 = __rx_iset(cb, sp, if lazy == 1 then 2 else 1, body)
    __rx_c_opt(cb, p, ae, k + 1, mx, lazy, __rx_hole(cb, sp, if lazy == 1 then 1 else 2, exits))
  }

// A single-character atom repeated mn..mx times (mx = -1: unbounded).
fn __rx_c_atom(cb: Int, p: Int, ae: Int, mn: Int, mx: Int, lazy: Int) -> Int = {
  let _0 = __rx_c_chars(cb, p, ae, mn)
  if mx >= 0 then __rx_c_opt(cb, p, ae, mn, mx, lazy, 0 - 1)
  else {
    let top = __rx_emit(cb, 3, 0, 0, 0, 0)
    let body = __rx_emit(cb, 1, p, ae, 0, 0)
    let _1 = __rx_emit(cb, 4, top, 0, 0, 0)
    let exit = __rx_cslot(cb, 1)
    let _2 = __rx_iset(cb, top, 1, if lazy == 1 then exit else body)
    __rx_iset(cb, top, 2, if lazy == 1 then body else exit)
  }
}

// A group [p, ae) repeated mn..mx times: the decision after `c` instances, then
// instance c. Below mn the instance is required; from mn on greedy prefers one
// more and lazy prefers to stop; an unbounded repetition's copy at mn loops.
fn __rx_c_group(cb: Int, p: Int, ae: Int, mn: Int, mx: Int, lazy: Int) -> Int = {
  let pat0 = __rx_cslot(cb, 5)
  let ce = if ae > p + 1 and prim.load8(ae - 1) == 41 then ae - 1 else ae
  let noncap = prim.load8(p + 1) == 63
  let body = if noncap then p + 3 else p + 1
  let ci = if noncap then 0 else __rx_ngroups(pat0, p) + 1
  let tracked = (mn != 1 or mx != 1) and __rx_null_alts(body, ce, pat0)
  let outer = if tracked then __rx_cslot(cb, 2) else 0 - 1
  let _0 = if tracked and outer + 1 > __rx_cslot(cb, 3) then __rx_cset(cb, 3, outer + 1)
  else 0
  __rx_c_copy(cb, body, ce, ci, outer, mn, mx, lazy, 0, 0 - 1)
}

fn __rx_c_copy(cb: Int, body: Int, ce: Int, ci: Int, outer: Int, mn: Int, mx: Int, lazy: Int, c: Int, exits: Int) -> Int =
  if __rx_over(cb) then 0
  else if mx >= 0 and c >= mx then __rx_patch(cb, exits, __rx_cslot(cb, 1))
  else {
    let rc = __rx_cslot(cb, 1)
    let exits1 = if c >= mn then {
      let sp = __rx_emit(cb, 3, 0, 0, 0, 0)
      let _0 = __rx_iset(cb, sp, if lazy == 1 then 2 else 1, rc + 1)
      __rx_hole(cb, sp, if lazy == 1 then 1 else 2, exits)
    } else exits
    let _1 = if outer >= 0 then __rx_cset(cb, 2, outer + 1)
    else 0
    let _2 = if ci > 0 then __rx_emit(cb, 5, ci, 0, 0, 0)
    else 0
    let _3 = __rx_c_alts(cb, body, ce, 0 - 1)
    let loops = mx < 0 and c == mn
    let nonempty = if loops then rc else __rx_cslot(cb, 1) + 1
    let end = __rx_emit(cb, 6, ci, outer, 0 - 1, nonempty)
    let exits2 = if c + 1 < mn then exits1
    else __rx_hole(cb, end, 3, exits1)
    let _4 = if outer >= 0 then __rx_cset(cb, 2, outer)
    else 0
    let last = if mx < 0 then mn else mx
    if loops or c >= last then __rx_patch(cb, exits2, __rx_cslot(cb, 1))
    else __rx_c_copy(cb, body, ce, ci, outer, mn, mx, lazy, c + 1, exits2)
  }

// Compile [p0, pe) into the program at `base` (0 = count only): its length,
// or -1 when it is over the state budget.
fn __rx_compile(cb: Int, base: Int, p0: Int, pe: Int) -> Int = {
  let _0 = __rx_cset(cb, 0, base)
  let _1 = __rx_cset(cb, 1, 0)
  let _2 = __rx_cset(cb, 2, 0)
  let _3 = __rx_cset(cb, 3, 0)
  let _4 = __rx_cset(cb, 4, 0)
  let _5 = __rx_cset(cb, 5, p0)
  let _6 = __rx_c_alts(cb, p0, pe, 0 - 1)
  let _7 = __rx_emit(cb, 7, 0, 0, 0, 0)
  if __rx_over(cb) then 0 - 1 else __rx_cslot(cb, 1)
}

// The VM's work block `w` (8-byte slots): 0 program, 1 W (states per pc),
// 2 ns (slots per thread: match start, then per group start, end, instance
// start), 3 ts, 4 te, 5 pat0, 6 track, 7 stack address, 8 stack depth,
// 9 found end (-1 = none), 10 found slots, 11 current list, 12 next list,
// 13 anchored, 14 end_at (-1 = anywhere), 15 any, 16 scratch slots, 17 the
// last stamp used. A list block: 0 count, 1 stamp, 2 (pc, d) pairs, 3 slots,
// 4 the stamp each state was last added under.
fn __rx_wk(w: Int, i: Int) -> Int = prim.load64(w + i * 8)

fn __rx_wset(w: Int, i: Int, v: Int) -> Int = {
  prim.store64(w + i * 8, v)
  0
}

// The work block's size in slots for a program of `n` instructions.
fn __rx_work_size(n: Int, width: Int, ns: Int) -> Int = {
  let k = n * width
  32 + 2 * (8 + 2 * k + k * ns + k) + 3 * (3 * k + 8) + 2 * ns
}

// Lay out the work block at `w` (all its stamps zero).
fn __rx_work_init(w: Int, prog: Int, n: Int, width: Int, ns: Int, ts: Int, te: Int, pat0: Int, track: Int) -> Int = {
  let k = n * width
  let l0 = w + 32 * 8
  let l1 = l0 + (8 + 2 * k + k * ns + k) * 8
  let stack = l1 + (8 + 2 * k + k * ns + k) * 8
  let scratch = stack + 3 * (3 * k + 8) * 8
  let _0 = __rx_wset(w, 0, prog)
  let _1 = __rx_wset(w, 1, width)
  let _2 = __rx_wset(w, 2, ns)
  let _3 = __rx_wset(w, 3, ts)
  let _4 = __rx_wset(w, 4, te)
  let _5 = __rx_wset(w, 5, pat0)
  let _6 = __rx_wset(w, 6, track)
  let _7 = __rx_wset(w, 7, stack)
  let _8 = __rx_wset(w, 8, 0)
  let _9 = __rx_wset(w, 10, scratch + ns * 8)
  let _10 = __rx_wset(w, 11, l0)
  let _11 = __rx_wset(w, 12, l1)
  let _12 = __rx_wset(w, 16, scratch)
  let _13 = __rx_wset(w, 17, 0)
  let _14 = __rx_list_init(l0, k, ns)
  __rx_list_init(l1, k, ns)
}

fn __rx_list_init(l: Int, k: Int, ns: Int) -> Int = {
  let pairs = l + 8 * 8
  let slots = pairs + 2 * k * 8
  let seen = slots + k * ns * 8
  let _0 = __rx_wset(l, 0, 0)
  let _1 = __rx_wset(l, 1, 0)
  let _2 = __rx_wset(l, 2, pairs)
  let _3 = __rx_wset(l, 3, slots)
  let _4 = __rx_wset(l, 4, seen)
  __rx_fill_zero(seen, k)
}

fn __rx_fill_zero(dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store64(dst, 0)
  __rx_fill_zero(dst + 8, n - 1)
}

// Empty list `l` under a fresh stamp.
fn __rx_list_clear(w: Int, l: Int) -> Int = {
  let s = __rx_wk(w, 17) + 1
  let _0 = __rx_wset(w, 17, s)
  let _1 = __rx_wset(l, 1, s)
  __rx_wset(l, 0, 0)
}

fn __rx_push(w: Int, kind: Int, a: Int, b: Int) -> Int = {
  let top = __rx_wk(w, 8)
  let at = __rx_wk(w, 7) + top * 24
  prim.store64(at, kind)
  prim.store64(at + 8, a)
  prim.store64(at + 16, b)
  __rx_wset(w, 8, top + 1)
}

// Does the zero-width test `kind` hold at `t`?
fn __rx_assert(w: Int, kind: Int, t: Int) -> Bool = {
  let ts = __rx_wk(w, 3)
  let te = __rx_wk(w, 4)
  let pat0 = __rx_wk(w, 5)
  if kind == 0 then __rx_bol(t, ts, pat0)
  else if kind == 1 then __rx_eol(t, te, pat0)
  else if kind == 2 then __rx_at_boundary(t, ts, te)
  else __rx_at_boundary(t, ts, te) == false
}

// Add the thread at (pc, d) at text position `t`, and everything it reaches
// without reading, to list `l` in priority order. The scratch slots are the
// thread's; the closure changes them and puts them back.
fn __rx_add(w: Int, l: Int, pc: Int, d: Int, t: Int) -> Int = {
  let _0 = __rx_push(w, 0, pc, d)
  __rx_closure(w, l, t)
}

fn __rx_closure(w: Int, l: Int, t: Int) -> Int = {
  let top = __rx_wk(w, 8)
  if top == 0 then 0
  else {
    let at = __rx_wk(w, 7) + (top - 1) * 24
    let kind = prim.load64(at)
    let a = prim.load64(at + 8)
    let b = prim.load64(at + 16)
    let _0 = __rx_wset(w, 8, top - 1)
    if kind == 1 then {
      prim.store64(__rx_wk(w, 16) + a * 8, b)
      __rx_closure(w, l, t)
    } else {
      let seen = __rx_wk(l, 4) + (a * __rx_wk(w, 1) + b) * 8
      if prim.load64(seen) == __rx_wk(l, 1) then __rx_closure(w, l, t)
      else {
        prim.store64(seen, __rx_wk(l, 1))
        let _1 = __rx_visit(w, l, a, b, t)
        __rx_closure(w, l, t)
      }
    }
  }
}

// One state of the closure: what instruction `pc` does at `t` with `d`.
fn __rx_visit(w: Int, l: Int, pc: Int, d: Int, t: Int) -> Int = {
  let ins = __rx_wk(w, 0) + pc * 48
  let op = prim.load64(ins)
  let a = prim.load64(ins + 8)
  if op == 1 or op == 7 then {
    let i = __rx_wk(l, 0)
    let ns = __rx_wk(w, 2)
    let pair = __rx_wk(l, 2) + i * 16
    prim.store64(pair, pc)
    prim.store64(pair + 8, d)
    let _0 = __rx_copy64(__rx_wk(w, 16), __rx_wk(l, 3) + i * ns * 8, ns)
    __rx_wset(l, 0, i + 1)
  } else if op == 2 then {
    if __rx_assert(w, a, t) then __rx_push(w, 0, pc + 1, d)
    else 0
  } else if op == 3 then {
    let _0 = __rx_push(w, 0, prim.load64(ins + 16), d)
    __rx_push(w, 0, a, d)
  } else if op == 4 then __rx_push(w, 0, a, d)
  else if op == 5 then {
    let _0 = if __rx_wk(w, 6) == 1 then {
      let slot = __rx_wk(w, 16) + a * 24
      let _1 = __rx_push(w, 1, 3 * a, prim.load64(slot))
      prim.store64(slot, t)
      0
    } else 0
    __rx_push(w, 0, pc + 1, d)
  } else if op == 6 then {
    let outer = prim.load64(ins + 16)
    let _0 = if a > 0 and __rx_wk(w, 6) == 1 then {
      let sc = __rx_wk(w, 16)
      let s0 = sc + (3 * a - 2) * 8
      let _1 = __rx_push(w, 1, 3 * a - 2, prim.load64(s0))
      let _2 = __rx_push(w, 1, 3 * a - 1, prim.load64(s0 + 8))
      prim.store64(s0, prim.load64(sc + 3 * a * 8))
      prim.store64(s0 + 8, t)
      0
    } else 0
    // the instance began here when it is not among the `d` that began before
    let empty = outer >= 0 and d <= outer
    let to = if empty then prim.load64(ins + 24) else prim.load64(ins + 32)
    let d2 = if outer >= 0 and outer < d then outer else d
    if to >= 0 then __rx_push(w, 0, to, d2)
    else 0
  } else 0
}

// Advance the current list's threads i.. over the character at `t` into the
// next list (positioned at `tn`). 0 = all done; 1 = a match cut the rest;
// 2 = a match ends the search (`any`).
fn __rx_threads(w: Int, i: Int, t: Int, tn: Int) -> Int = {
  let cl = __rx_wk(w, 11)
  if i >= __rx_wk(cl, 0) then 0
  else {
    let pair = __rx_wk(cl, 2) + i * 16
    let pc = prim.load64(pair)
    let ins = __rx_wk(w, 0) + pc * 48
    let op = prim.load64(ins)
    let ns = __rx_wk(w, 2)
    let slots = __rx_wk(cl, 3) + i * ns * 8
    if op == 7 then {
      let e = __rx_wk(w, 14)
      if e < 0 or t == e then {
        let _0 = __rx_copy64(slots, __rx_wk(w, 10), ns)
        let _1 = __rx_wset(w, 9, t)
        if __rx_wk(w, 15) == 1 then 2 else 1
      } else __rx_threads(w, i + 1, t, tn)
    } else if __rx_char_match(prim.load64(ins + 8), prim.load64(ins + 16), t, __rx_wk(w, 4)) then {
      let _0 = __rx_copy64(slots, __rx_wk(w, 16), ns)
      let _1 = __rx_add(w, __rx_wk(w, 12), pc + 1, prim.load64(ins + 40), tn)
      __rx_threads(w, i + 1, t, tn)
    } else __rx_threads(w, i + 1, t, tn)
  }
}

// Reset the scratch slots for a thread starting at `t`.
fn __rx_seed(w: Int, t: Int) -> Int = {
  let sc = __rx_wk(w, 16)
  let _0 = __rx_fill_neg(sc, __rx_wk(w, 2))
  prim.store64(sc, t)
  0
}

// One step at text position `t`, then the next.
fn __rx_steps(w: Int, t: Int) -> Int = {
  let te = __rx_wk(w, 4)
  let tn = if t < te then t + __rx_w(t) else t
  let _0 = __rx_list_clear(w, __rx_wk(w, 12))
  let r = __rx_threads(w, 0, t, tn)
  if r == 2 or t >= te then 0
  else {
    let _1 = if __rx_wk(w, 9) < 0 and __rx_wk(w, 13) == 0 then {
      let _2 = __rx_seed(w, tn)
      __rx_add(w, __rx_wk(w, 12), 0, 0, tn)
    } else 0
    let nl = __rx_wk(w, 12)
    if __rx_wk(nl, 0) == 0 and (__rx_wk(w, 9) >= 0 or __rx_wk(w, 13) == 1) then 0
    else {
      let _3 = __rx_wset(w, 12, __rx_wk(w, 11))
      let _4 = __rx_wset(w, 11, nl)
      __rx_steps(w, tn)
    }
  }
}

// The walk's first success from a start at or after `t` (only at `t` when
// anchored), ending at end_at unless that is -1; with `any`, the first match
// found. Its start, or -1; its end in slot 9, its slots in the found buffer.
fn __rx_pike(w: Int, t: Int, anchored: Int, end_at: Int, any: Int) -> Int = {
  let _0 = __rx_wset(w, 9, 0 - 1)
  let _1 = __rx_wset(w, 13, anchored)
  let _2 = __rx_wset(w, 14, end_at)
  let _3 = __rx_wset(w, 15, any)
  let _4 = __rx_wset(w, 8, 0)
  let cl = __rx_wk(w, 11)
  let _5 = __rx_list_clear(w, cl)
  let _6 = __rx_seed(w, t)
  let _7 = __rx_add(w, cl, 0, 0, t)
  let _8 = __rx_steps(w, t)
  if __rx_wk(w, 9) < 0 then 0 - 1 else prim.load64(__rx_wk(w, 10))
}

// The program of [p0, pe), compiled: an empty list when the pattern is over
// the state budget (it then runs on the walk). The block's slot 0 is the
// instruction count, slot 1 the states per pc; the program follows at slot 8.
fn __rx_program(p0: Int, pe: Int) -> List[Int] = {
  let cbl = prim.alloc_list(8)
  let cb = prim.handle(cbl) + 12
  let n = __rx_compile(cb, 0, p0, pe)
  if n < 0 then prim.alloc_list(0)
  else {
    let prog = prim.alloc_list(8 + n * 6)
    let pa = prim.handle(prog) + 12
    let _0 = __rx_compile(cb, pa + 64, p0, pe)
    prim.store64(pa, n)
    prim.store64(pa + 8, __rx_cslot(cb, 3) + 1)
    prog
  }
}

// The work block for the program whose list handle is `ph` over the text
// [ts, te): an empty list when there is no program. Handles, never the Lists,
// cross these calls: a List passed to a fn is the callee's to drop, and the
// caller keeps both alive for as long as the VM runs.
fn __rx_work(ph: Int, ncap: Int, ts: Int, te: Int, pat0: Int, track: Int) -> List[Int] = {
  let pa = ph + 12
  if prim.load32(ph + 4) == 0 then prim.alloc_list(0)
  else {
    let n = prim.load64(pa)
    let width = prim.load64(pa + 8)
    let ns = if track == 1 then 1 + 3 * ncap else 1
    let work = prim.alloc_list(__rx_work_size(n, width, ns))
    let _0 = __rx_work_init(prim.handle(work) + 12, pa + 64, n, width, ns, ts, te, pat0, track)
    work
  }
}

// The work block's address from its list handle, or 0 when there is none.
fn __rx_work_at(wh: Int) -> Int = if prim.load32(wh + 4) == 0 then 0 else wh + 12

// Leftmost match at or after `t` on the VM: like __rx_find_start, its start
// (or -1) with the end left in the machine block's slot 9.
fn __rx_pike_find(w: Int, t: Int, m: Int) -> Int = {
  let st = __rx_pike(w, t, 0, 0 - 1, 0)
  let _0 = if st >= 0 then __rx_wset(m, 9, __rx_wk(w, 9))
  else 0
  st
}

// ── public API ──
// The text end, and the end of the last match found. The loops that grow an
// accumulator read the machine block through these rather than a `prim` op
// in their own body: an accumulator loop with a prim op in it keeps every old
// accumulator alive, which made find_all quadratic in memory.
fn __rx_te(m: Int) -> Int = prim.load64(m + 40)

fn __rx_end(m: Int) -> Int = prim.load64(m + 72)

// Leftmost match START at or after `t`, or -1; the match's end is left in
// the machine block (slot 9).
fn __rx_find_start(p: Int, pe: Int, t: Int, m: Int) -> Int = {
  let w = prim.load64(m + 120)
  if w != 0 then __rx_pike_find(w, t, m)
  else __rx_find_start_walk(p, pe, t, m)
}

// The walk's leftmost search: one attempt per start position. -1 also when
// the walk ran out of steps (slot 18 then says so).
fn __rx_find_start_walk(p: Int, pe: Int, t: Int, m: Int) -> Int = {
  let r = __rx_exec(p, pe, t, m)
  if r >= 0 then {
    prim.store64(m + 72, r)
    t
  } else if r == 0 - 3 or t >= prim.load64(m + 40) then 0 - 1
  else __rx_find_start_walk(p, pe, t + __rx_w(t), m)
}

// The walk runs first, under a step budget linear in the text's length (4 per
// pattern byte per text byte): it is the faster engine on the patterns people
// write, and it answers what the Pike VM answers. A step past the budget makes
// it give up (-3 through every caller of __rx_seq); the operation is then done
// again on the VM, so no call takes more than linear time. Count one step and
// say whether the budget is spent.
fn __rx_tick(m: Int) -> Bool = {
  let steps = prim.load64(m + 128) + 1
  prim.store64(m + 128, steps)
  let budget = prim.load64(m + 136)
  if budget >= 0 and steps > budget then {
    prim.store64(m + 144, 1)
    true
  } else false
}

fn __rx_gave_up(m: Int) -> Bool = prim.load64(m + 144) == 1

// After the walk gave up: from now on __rx_find_start runs the VM whose work
// block is at `w` — or, for a pattern over the VM's state budget (no work
// block), the walk again without a step budget.
fn __rx_hand_over(m: Int, w: Int) -> Int = {
  prim.store64(m + 120, w)
  prim.store64(m + 144, 0)
  prim.store64(m + 136, 0 - 1)
  0
}

fn regex_is_match(pat: String, s: String) -> Bool = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let st = __rx_find_start(p0, pe, t0, m)
  if __rx_gave_up(m) then {
    let prog = __rx_program(p0, pe)
    let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
    let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
    __rx_find_start(p0, pe, t0, m) >= 0
  } else st >= 0
}

// ── Stage 2: find / find_all / replace / replace_first / split ──
fn regex_full_match(pat: String, s: String) -> Bool = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, te)
  let m = prim.handle(vm) + 12
  let r = __rx_exec(p0, pe, t0, m)
  if __rx_gave_up(m) then {
    let prog = __rx_program(p0, pe)
    let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
    let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
    let w = __rx_work_at(prim.handle(work))
    if w != 0 then __rx_pike(w, t0, 1, te, 0) >= 0
    else __rx_exec(p0, pe, t0, m) == te
  } else r == te
}

// Copy `n` bytes from `src` to `dst`.
fn __rx_copy(src: Int, dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store8(dst, prim.load8(src))
  __rx_copy(src + 1, dst + 1, n - 1)
}

// The text substring [a, b) as a fresh owned String.
fn __rx_sub(a: Int, b: Int) -> String = {
  let out = prim.alloc_str(b - a)
  let _ = __rx_copy(a, prim.handle(out) + 12, b - a)
  out
}

// The operation again on the Pike VM, once the walk gave up: each helper owns
// the program and work block for as long as the VM runs.
fn __rx_vm_find(p0: Int, pe: Int, t0: Int, te: Int, m: Int) -> Int = {
  let prog = __rx_program(p0, pe)
  let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
  let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
  __rx_find_start(p0, pe, t0, m)
}

fn __rx_vm_find_all(p0: Int, pe: Int, t0: Int, te: Int, m: Int) -> List[String] = {
  let prog = __rx_program(p0, pe)
  let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
  let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
  let acc: List[String] = []
  __rx_find_all_go(p0, pe, t0, m, acc)
}

fn __rx_vm_replace(p0: Int, pe: Int, t0: Int, te: Int, m: Int, rep: String) -> String = {
  let prog = __rx_program(p0, pe)
  let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
  let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
  let acc = ""
  __rx_replace_go(p0, pe, t0, m, rep, acc)
}

fn __rx_vm_split(p0: Int, pe: Int, t0: Int, te: Int, m: Int) -> List[String] = {
  let prog = __rx_program(p0, pe)
  let work = __rx_work(prim.handle(prog), 0, t0, te, p0, 0)
  let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
  let acc: List[String] = []
  __rx_split_go(p0, pe, t0, t0, m, acc)
}

fn regex_find(pat: String, s: String) -> String? = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let st0 = __rx_find_start(p0, pe, t0, m)
  let st = if __rx_gave_up(m) then __rx_vm_find(p0, pe, t0, te, m)
  else st0
  if st < 0 then none
  else {
    let hit = __rx_sub(st, __rx_end(m))
    some(hit)
  }
}

// v0 find_all: repeat leftmost; a zero-width match advances one char past `end`.
fn __rx_find_all_go(p: Int, pe: Int, pos: Int, m: Int, acc: List[String]) -> List[String] =
  if pos > __rx_te(m) then acc
  else {
    let st = __rx_find_start(p, pe, pos, m)
    if st < 0 then acc
    else {
      let en = __rx_end(m)
      let hit = __rx_sub(st, en)
      if en > st then __rx_find_all_go(p, pe, en, m, acc + [hit])
      else {
        if en < __rx_te(m) then __rx_find_all_go(p, pe, en + __rx_w(en), m, acc + [hit])
        else acc + [hit]
      }
    }
  }

fn regex_find_all(pat: String, s: String) -> List[String] = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let acc: List[String] = []
  let r = __rx_find_all_go(p0, pe, t0, m, acc)
  if __rx_gave_up(m) then __rx_vm_find_all(p0, pe, t0, te, m)
  else r
}

// v0 replace: scan; at each match emit the gap + the LITERAL replacement (no $n);
// a zero-width match ALSO emits the char at `end` and advances past it (at
// end-of-string it just terminates).
fn __rx_replace_go(p: Int, pe: Int, pos: Int, m: Int, rep: String, acc: String) -> String = {
  let te = __rx_te(m)
  if pos > te then acc
  else {
    let st = __rx_find_start(p, pe, pos, m)
    if st < 0 then acc + __rx_sub(pos, te)
    else {
      let en = __rx_end(m)
      let acc2 = acc + __rx_sub(pos, st) + rep
      if en > st then __rx_replace_go(p, pe, en, m, rep, acc2)
      else {
        if en < te then __rx_replace_go(
          p,
          pe,
          en + __rx_w(en),
          m,
          rep,
          acc2 + __rx_sub(en, en + __rx_w(en)),
        )
        else acc2
      }
    }
  }
}

fn regex_replace(pat: String, s: String, rep: String) -> String = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let acc = ""
  let r = __rx_replace_go(p0, pe, t0, m, rep, acc)
  if __rx_gave_up(m) then __rx_vm_replace(p0, pe, t0, te, m, rep)
  else r
}

fn regex_replace_first(pat: String, s: String, rep: String) -> String = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let st0 = __rx_find_start(p0, pe, t0, m)
  let st = if __rx_gave_up(m) then __rx_vm_find(p0, pe, t0, te, m)
  else st0
  if st < 0 then s else __rx_sub(t0, st) + rep + __rx_sub(__rx_end(m), te)
}

// A field is the text BETWEEN two matches, so the split point (`last`) and the
// scan position are two different things. Conflating them made a zero-width
// match EAT a character — `split("^", "abc")` answered `["a", "bc"]` — where
// Python, Rust and Go all answer `["", "abc"]` (#2129). The walk is `find_all`'s
// (an empty match advances one character so it terminates) and the trailing
// field is always emitted, which is how `split("$", "a")` is `["a", ""]`.
fn __rx_split_go(p: Int, pe: Int, last: Int, scan: Int, m: Int, acc: List[String]) -> List[String] = {
  let te = __rx_te(m)
  if scan > te then acc + [__rx_sub(last, te)]
  else {
    let st = __rx_find_start(p, pe, scan, m)
    if st < 0 then acc + [__rx_sub(last, te)]
    else {
      let en = __rx_end(m)
      let nxt = if en > st then en
      else if en >= te then te + 1 else en + __rx_w(en)
      __rx_split_go(p, pe, en, nxt, m, acc + [__rx_sub(last, st)])
    }
  }
}

fn regex_split(pat: String, s: String) -> List[String] = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let vm = __rx_vm(p0, pe, t0, te, 0, 0, 0 - 1)
  let m = prim.handle(vm) + 12
  let acc: List[String] = []
  let r = __rx_split_go(p0, pe, t0, t0, m, acc)
  if __rx_gave_up(m) then __rx_vm_split(p0, pe, t0, te, m)
  else r
}

// ── Stage 3: captures ──
// caps[k] is written at GROUP COMPLETION (k = the group's pre-order '('
// ordinal) and taken back when the walk backtracks past the write, so only the
// winning derivation's writes survive. The caps live in a caller-owned
// List[Int] buffer (2 slots per group: start, end; -1 = unmatched), passed as
// a raw address so the matcher stays prim-only.
// Count the REAL group-opens '(' in [p, q) (escapes and classes are opaque) —
// the group at `q` has capture ordinal = this count.
fn __rx_ngroups(p: Int, q: Int) -> Int = if p >= q then 0
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < q then __rx_ngroups(p + 1 + __rx_w(p + 1), q)
  else if b == 91 then __rx_ngroups(__rx_class_end(p + 1, q), q)
  else if b == 40 then {
    if p + 1 < q and prim.load8(p + 1) == 63 then __rx_ngroups(p + 1, q) else 1 + __rx_ngroups(
      p + 1,
      q,
    )
  } else __rx_ngroups(p + __rx_w(p), q)
}

// Copy `n` i64 slots from `src` to `dst`.
fn __rx_copy64(src: Int, dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store64(dst, prim.load64(src))
  __rx_copy64(src + 8, dst + 8, n - 1)
}

// Fill `n` i64 slots at `dst` with -1 (unmatched).
fn __rx_fill_neg(dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store64(dst, 0 - 1)
  __rx_fill_neg(dst + 8, n - 1)
}

// The VM's groups: slot 3i+1 is group i's start, 3i+2 its end (-1 = unmatched).
fn __rx_pcaps_out(found: Int, i: Int, ncap: Int, acc: List[String]) -> List[String] =
  if i >= ncap then acc
  else {
    let st = prim.load64(found + (3 * i + 1) * 8)
    if st < 0 then __rx_pcaps_out(found, i + 1, ncap, acc + [""])
    else {
      let hit = __rx_sub(st, prim.load64(found + (3 * i + 2) * 8))
      __rx_pcaps_out(found, i + 1, ncap, acc + [hit])
    }
  }

fn __rx_caps_out(caps: Int, i: Int, ncap: Int, acc: List[String]) -> List[String] =
  if i >= ncap then acc
  else {
    let st = prim.load64(caps + i * 16)
    if st < 0 then __rx_caps_out(caps, i + 1, ncap, acc + [""])
    else {
      let hit = __rx_sub(st, prim.load64(caps + i * 16 + 8))
      __rx_caps_out(caps, i + 1, ncap, acc + [hit])
    }
  }

// Index 0 is the WHOLE match, 1.. are the groups — the shape every mainstream
// regex API uses and the one docs/stdlib/regex.md always documented; the
// groups-only return this replaced made `caps[1]` silently mean the SECOND
// group to anyone carrying that habit over (almide#1432).
//
// `none` now means exactly one thing: the pattern did not match. It previously
// also came back for a pattern with NO groups, conflating "matched nothing to
// capture" with "did not match" — with a full match at index 0 that case has a
// real answer. The buffer is still sized for at least one slot pair so a
// group-less pattern has somewhere to scan. The buffer holds the winning
// attempt's groups when the scan returns: the walk resets it at each start and
// takes back every write it backtracks past.
fn regex_captures(pat: String, s: String) -> List[String]? = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let ncap = __rx_ngroups(p0, pe)
  let nslots = if ncap == 0 then 2 else ncap * 2
  let buf = prim.alloc_list(nslots)
  let bd = prim.handle(buf) + 12
  let vm = __rx_vm(p0, pe, t0, te, bd, nslots, 0 - 1)
  let m = prim.handle(vm) + 12
  let ms = __rx_find_start(p0, pe, t0, m)
  if __rx_gave_up(m) then __rx_vm_captures(p0, pe, t0, te, ncap, bd, m)
  else if ms < 0 then none
  else {
    let whole = __rx_sub(ms, __rx_end(m))
    let acc: List[String] = [whole]
    some(__rx_caps_out(bd, 0, ncap, acc))
  }
}

// captures again once the walk gave up: on the Pike VM (its groups come back
// in its found slots), or for a pattern over the VM's state budget on the walk
// without a step budget (its groups in `bd`).
fn __rx_vm_captures(p0: Int, pe: Int, t0: Int, te: Int, ncap: Int, bd: Int, m: Int) -> List[String]? = {
  let prog = __rx_program(p0, pe)
  let work = __rx_work(prim.handle(prog), ncap, t0, te, p0, 1)
  let w = __rx_work_at(prim.handle(work))
  let _0 = __rx_hand_over(m, __rx_work_at(prim.handle(work)))
  let ms = if w != 0 then __rx_pike(w, t0, 0, 0 - 1, 0)
  else __rx_find_start(p0, pe, t0, m)
  if ms < 0 then none
  else if w != 0 then {
    let whole = __rx_sub(ms, __rx_wk(w, 9))
    let acc: List[String] = [whole]
    some(__rx_pcaps_out(__rx_wk(w, 10), 0, ncap, acc))
  } else {
    let whole = __rx_sub(ms, __rx_end(m))
    let acc: List[String] = [whole]
    some(__rx_caps_out(bd, 0, ncap, acc))
  }
}
