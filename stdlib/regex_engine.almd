// regex_engine — bundled-Almide stdlib module (the v1 trust-spine self-host of
// the regex runtime; STAGE 1: is_match + full_match).
//
// v0's `runtime/rs/src/regex.rs` is the SEMANTIC ORACLE, ported quirk-for-quirk:
//  - CHAR-based matching (UTF-8 decoded on the fly, codepoint compares);
//  - greedy backtracking with v0's ZERO-WIDTH repetition guard
//    (`consumed > 0 || count == 0` — `(a*)*` terminates);
//  - alternation is FIRST-WIN, and a GROUP boundary does not backtrack
//    (`(a|ab)c` on "abc" does NOT match — v0 semantics, kept);
//  - empty alternatives are natural (`a|`, `|a`, `a||b` all match anywhere);
//  - `.` matches any char EXCEPT '\n';
//  - escapes: \d \D \w \W \s \S classes ('\s' = space/tab/nl/cr), \n \t \r
//    literals, anything else the escaped char itself;
//  - classes: leading '^' negates; '\d' '\w' '\s' '\n' '\t' expand INSIDE a
//    class, any other escape is the literal char ('\D' in a class = 'D' — v0
//    quirk); 'a-z' ranges (a '-' before ']' or at the end is a literal);
//  - anchors '^' '$' are matched at sequence level and a quantifier on an
//    anchor is parsed but IGNORED (v0 quirk);
//  - no '{n,m}' counted repetition (zero corpus usage, v0 has none).
//
// All positions are BYTE ADDRESSES into the pattern/text data (handle + 12);
// `pe`/`te` are one-past-the-end addresses. Groups are MATCHED but captures are
// not yet extracted (regex.captures is a later stage). Like every self-host,
// this carries its own PCC certificates through the proven checker.
// ── UTF-8 decode ──
import prim

fn __rx_w(a: Int) -> Int = {
  let b = prim.load8(a)
  if b < 128 then 1
  else if b < 224 then 2
  else if b < 240 then 3 else 4
}

// ── pattern navigation (byte addresses; classes and groups are opaque) ──
// End of the class body starting AFTER '[' — the address just past the closing
// ']' (an escape skips the escaped char; an unterminated class ends at `pe`).
fn __rx_cp(a: Int) -> Int = {
  let b = prim.load8(a)
  if b < 128 then b
  else if b < 224 then (b - 192) * 64 + (prim.load8(a + 1) - 128)
  else if b < 240 then ((b - 224) * 64 + (prim.load8(a + 1) - 128)) * 64 + (prim.load8(a + 2) - 128) else (((b - 240) * 64 + (prim.load8(a + 1) - 128)) * 64 + (prim.load8(a + 2) - 128)) * 64 + (prim.load8(a + 3) - 128)
}

// End of the group starting AFTER '(' — the address just past the MATCHING ')'
// (nested groups tracked by depth; an unterminated group ends at `pe`, v0's
// tolerance).
fn __rx_class_end(p: Int, pe: Int) -> Int = if p >= pe then pe
else {
  let b = prim.load8(p)
  if b == 93 then p + 1
  else if b == 92 and p + 1 < pe then __rx_class_end(p + 1 + __rx_w(p + 1), pe) else __rx_class_end(p + __rx_w(p), pe)
}

// End of the ATOM starting at `p` (a class, a group, an escape+char, or one char).
fn __rx_group_end(p: Int, pe: Int, depth: Int) -> Int = if p >= pe then pe
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < pe then __rx_group_end(p + 1 + __rx_w(p + 1), pe, depth)
  else if b == 91 then __rx_group_end(__rx_class_end(p + 1, pe), pe, depth)
  else if b == 40 then __rx_group_end(p + 1, pe, depth + 1)
  else if b == 41 then {
    if depth == 0 then p + 1
    else __rx_group_end(p + 1, pe, depth - 1)
  } else __rx_group_end(p + __rx_w(p), pe, depth)
}

// End of a WELL-FORMED brace quantifier `{n}` / `{n,}` / `{n,m}` starting at
// the '{' at `p`: the address just past '}', or -1 if malformed (then the
// '{' stays a literal piece — same fallback as the native engine, #845).
fn __rx_atom_end(p: Int, pe: Int) -> Int = {
  let b = prim.load8(p)
  if b == 92 then {
    if p + 1 < pe then p + 1 + __rx_w(p + 1) else p + 1
  } else if b == 91 then __rx_class_end(p + 1, pe)
  else if b == 40 then __rx_group_end(p + 1, pe, 0)
  else p + __rx_w(p)
}

// First non-digit address in [p, pe).
fn __rx_brace_end(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  if d1 == p + 1 then 0 - 1
  else if d1 < pe and prim.load8(d1) == 125 then d1 + 1
  else if d1 < pe and prim.load8(d1) == 44 then {
    let d2 = __rx_digits_end(d1 + 1, pe)
    if d2 < pe and prim.load8(d2) == 125 then d2 + 1 else 0 - 1
  } else 0 - 1
}

// Decimal value of the digit run [p, e).
fn __rx_digits_end(p: Int, pe: Int) -> Int = if p < pe and prim.load8(p) >= 48 and prim.load8(p) <= 57 then __rx_digits_end(p + 1, pe) else p

// min of the brace quantifier whose '{' is at `p` (well-formed by construction).
fn __rx_digits_val(p: Int, e: Int, acc: Int) -> Int = if p >= e then acc
else __rx_digits_val(p + 1, e, acc * 10 + (prim.load8(p) - 48))

// max of the brace quantifier whose '{' is at `p`; -1 = unbounded ({n,}).
fn __rx_brace_min(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  __rx_digits_val(p + 1, d1, 0)
}

// End of the PIECE (atom + one optional quantifier: * + ? or {n,m}).
fn __rx_brace_max(p: Int, pe: Int) -> Int = {
  let d1 = __rx_digits_end(p + 1, pe)
  if prim.load8(d1) == 125 then __rx_digits_val(p + 1, d1, 0)
  else {
    let d2 = __rx_digits_end(d1 + 1, pe)
    if d2 == d1 + 1 then 0 - 1
    else __rx_digits_val(d1 + 1, d2, 0)
  }
}

// End of the current ALTERNATIVE: the address of the next top-level '|', or `pe`.
fn __rx_piece_end(p: Int, pe: Int) -> Int = {
  let ae = __rx_atom_end(p, pe)
  if ae < pe then {
    let q = prim.load8(ae)
    if q == 42 or q == 43 or q == 63 then {
      if ae + 1 < pe and prim.load8(ae + 1) == 63 then ae + 2 else ae + 1
    } else if q == 123 then {
      let be = __rx_brace_end(ae, pe)
      if be < 0 then ae
      else if be < pe and prim.load8(be) == 63 then be + 1 else be
    } else ae
  } else ae
}

// ── single-char matchers (codepoint `c` against the atom at [p, ae)) ──
fn __rx_alt_end(p: Int, pe: Int) -> Int = if p >= pe then pe
else {
  if prim.load8(p) == 124 then p else __rx_alt_end(__rx_piece_end(p, pe), pe)
}

// Does codepoint `c` hit any class item in [p, ie)? (v0's in-class expansions:
// \d \w \s \n \t; every other escape is the literal escaped char.)
fn __rx_esc_match(e: Int, c: Int) -> Bool = if e == 100 then c >= 48 and c <= 57
else if e == 68 then {
  if c >= 48 and c <= 57 then false else true
} else if e == 119 then (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
else if e == 87 then {
  if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 then false else true
} else if e == 115 then c == 32 or c == 9 or c == 10 or c == 13
else if e == 83 then {
  if c == 32 or c == 9 or c == 10 or c == 13 then false else true
} else if e == 110 then c == 10
else if e == 116 then c == 9
else if e == 114 then c == 13 else c == e

// Match ONE text char at `t` against the non-group atom at [p, ae).
fn __rx_class_hit(p: Int, ie: Int, c: Int) -> Bool = if p >= ie then false
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < ie then {
    let e = prim.load8(p + 1)
    let hit = if e == 100 then c >= 48 and c <= 57
    else if e == 119 then (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
    else if e == 115 then c == 32 or c == 9 or c == 10 or c == 13
    else if e == 110 then c == 10
    else if e == 116 then c == 9 else c == __rx_cp(p + 1)
    if hit then true
    else __rx_class_hit(p + 1 + __rx_w(p + 1), ie, c)
  } else {
    let cw = __rx_w(p)
    let lo = __rx_cp(p)
    if p + cw < ie and prim.load8(p + cw) == 45 and p + cw + 1 < ie and prim.load8(p + cw + 1) != 93 then {
      let hi = __rx_cp(p + cw + 1)
      if c >= lo and c <= hi then true
      else __rx_class_hit(p + cw + 1 + __rx_w(p + cw + 1), ie, c)
    } else {
      if c == lo then true
      else __rx_class_hit(p + cw, ie, c)
    }
  }
}

// ── the backtracking matcher ──
// Returns the text END address of a match, or -1.
// Alternation over [p, pend): FIRST alternative whose sequence matches wins.
fn __rx_char_match(p: Int, ae: Int, t: Int, te: Int) -> Bool = if t >= te then false
else {
  let c = __rx_cp(t)
  let b = prim.load8(p)
  if b == 46 then c != 10
  else if b == 91 then {
    let ie = if ae > p + 1 and prim.load8(ae - 1) == 93 then ae - 1 else ae
    let neg = p + 1 < ie and prim.load8(p + 1) == 94
    let ps = if neg then p + 2 else p + 1
    let hit = __rx_class_hit(ps, ie, c)
    if neg then {
      if hit then false else true
    } else hit
  } else if b == 92 then {
    if ae == p + 1 then c == 92 else __rx_esc_match(prim.load8(p + 1), c)
  } else c == __rx_cp(p)
}

// ── the matcher: backtracking by CONTINUATION (#1927) ──
// Every position in a sequence carries the rest of the match as `k`, a
// continuation FRAME on the heap (8-byte slots: kind first). Finishing a
// sequence RUNS the frame instead of returning an end, so a group boundary
// is no longer a commit point: `(.+) (stdout|stderr)` backs the `.+` off
// until the group after it matches, and `(a|ab)c` on "abc" tries the second
// alternative. Frames: 1 = SEQ [pnext, pend, next]; 2 = GROUP_END [ci,
// tstart, next, saved_start, saved_end] (records the capture, restores it
// when the continuation fails); 3 = REP [p, ae, pnext, pend, count, mn, mx,
// next, tprev, lazy] (one more instance of a repeated group, or the rest);
// 4 = END_AT [te] (full_match: the match must end exactly there). `k = 0`
// is the empty continuation: return the current text position.
// `caps = 0` means no capture writes (is_match / find / replace / split).
// Flags: a leading `(?m)` makes `^`/`$` line anchors; `(?:…)` groups do
// not capture; `\b`/`\B` are word-boundary assertions; a quantifier
// followed by `?` is LAZY. A zero-width repetition never loops.
fn __rx_back(t: Int, ts: Int) -> Int = {
  let t1 = t - 1
  if t1 <= ts then ts
  else if prim.band(prim.load8(t1), 192) == 128 then __rx_back(t1, ts) else t1
}

fn __rx_frame(n: Int) -> Int = prim.handle(prim.alloc_list(n)) + 12

fn __rx_flags(pat0: Int) -> Int = if prim.load8(pat0) == 40 and prim.load8(pat0 + 1) == 63 and prim.load8(pat0 + 2) == 109 and prim.load8(pat0 + 3) == 41 then 1 else 0

fn __rx_is_word(c: Int) -> Bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

// Word boundary at t: the word-ness of the char before differs from the one at t.
fn __rx_at_boundary(t: Int, ts: Int, te: Int) -> Bool = {
  let before = if t <= ts then false else __rx_is_word(prim.load8(__rx_back(t, ts)))
  let after = if t >= te then false else __rx_is_word(prim.load8(t))
  before != after
}

fn __rx_bol(t: Int, ts: Int, pat0: Int) -> Bool = t == ts or (__rx_flags(pat0) == 1 and prim.load8(t - 1) == 10)

fn __rx_eol(t: Int, te: Int, pat0: Int) -> Bool = t == te or (__rx_flags(pat0) == 1 and prim.load8(t) == 10)

// Run continuation `k` at text position `t`.
fn __rx_run(k: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int) -> Int = if k == 0 then t
else {
  let kind = prim.load64(k)
  if kind == 1 then __rx_seq(prim.load64(k + 8), prim.load64(k + 16), t, ts, te, caps, pat0, prim.load64(k + 24))
  else if kind == 2 then __rx_run_group_end(k, t, ts, te, caps, pat0)
  else if kind == 3 then __rx_run_rep(k, t, ts, te, caps, pat0)
  else {
    if t == prim.load64(k + 8) then t else 0 - 1
  }
}

fn __rx_run_group_end(k: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int) -> Int = {
  let ci = prim.load64(k + 8)
  let knext = prim.load64(k + 24)
  if caps == 0 or ci < 0 then __rx_run(knext, t, ts, te, caps, pat0)
  else {
    let slot = caps + ci * 16
    let _s = prim.store64(k + 32, prim.load64(slot))
    let _e = prim.store64(k + 40, prim.load64(slot + 8))
    let _w1 = prim.store64(slot, prim.load64(k + 16))
    let _w2 = prim.store64(slot + 8, t)
    let r = __rx_run(knext, t, ts, te, caps, pat0)
    if r >= 0 then r
    else {
      let _r1 = prim.store64(slot, prim.load64(k + 32))
      let _r2 = prim.store64(slot + 8, prim.load64(k + 40))
      0 - 1
    }
  }
}

// A repeated group's instance just ended at `t`: one more instance, or the rest.
fn __rx_run_rep(k: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int) -> Int = {
  let count = prim.load64(k + 40) + 1
  let tprev = prim.load64(k + 72)
  if t == tprev then __rx_rep_rest(k, count, t, ts, te, caps, pat0)
  else __rx_rep_group(prim.load64(k + 8), prim.load64(k + 16), prim.load64(k + 24), prim.load64(k + 32), t, ts, te, caps, pat0, count, prim.load64(k + 48), prim.load64(k + 56), prim.load64(k + 80), prim.load64(k + 64))
}

fn __rx_rep_rest(k: Int, count: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int) -> Int = if count < prim.load64(k + 48) then 0 - 1
else __rx_seq(prim.load64(k + 24), prim.load64(k + 32), t, ts, te, caps, pat0, prim.load64(k + 64))

// Repeated GROUP at [p, ae) with `count` instances matched so far.
fn __rx_rep_group(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, count: Int, mn: Int, mx: Int, lazy: Int, k: Int) -> Int = {
  let under_max = if mx < 0 then true else count < mx
  let fr = __rx_frame(11)
  let _0 = prim.store64(fr, 3)
  let _1 = prim.store64(fr + 8, p)
  let _2 = prim.store64(fr + 16, ae)
  let _3 = prim.store64(fr + 24, pnext)
  let _4 = prim.store64(fr + 32, pend)
  let _5 = prim.store64(fr + 40, count)
  let _6 = prim.store64(fr + 48, mn)
  let _7 = prim.store64(fr + 56, mx)
  let _8 = prim.store64(fr + 64, k)
  let _9 = prim.store64(fr + 72, t)
  let _a = prim.store64(fr + 80, lazy)
  if lazy == 1 and count >= mn then {
    let r = __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    if r >= 0 then r
    else if under_max then __rx_group(p, ae, t, ts, te, caps, pat0, fr)
    else 0 - 1
  } else if under_max then {
    let r = __rx_group(p, ae, t, ts, te, caps, pat0, fr)
    if r >= 0 then r
    else if count >= mn then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    else 0 - 1
  } else if count >= mn then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
  else 0 - 1
}

// One instance of the group at [p, ae): its alternatives, each continuing
// into a GROUP_END frame that records the capture (ci < 0 = non-capturing).
fn __rx_group(p: Int, ae: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, k: Int) -> Int = {
  let ce = if ae > p + 1 and prim.load8(ae - 1) == 41 then ae - 1 else ae
  let noncap = prim.load8(p + 1) == 63
  let body = if noncap then p + 3 else p + 1
  let ci = if noncap then 0 - 1 else __rx_ngroups(pat0, p)
  let fr = __rx_frame(6)
  let _0 = prim.store64(fr, 2)
  let _1 = prim.store64(fr + 8, ci)
  let _2 = prim.store64(fr + 16, t)
  let _3 = prim.store64(fr + 24, k)
  __rx_alts(body, ce, t, ts, te, caps, pat0, fr)
}

fn __rx_alts(p: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, k: Int) -> Int = {
  let aend = __rx_alt_end(p, pend)
  let r = __rx_seq(p, aend, t, ts, te, caps, pat0, k)
  if r >= 0 then r
  else if aend < pend then __rx_alts(aend + 1, pend, t, ts, te, caps, pat0, k)
  else 0 - 1
}

// Is the piece ending at `pnext` lazy (`*?` `+?` `??` `{n,m}?`)? The lazy `?`
// sits at pnext-1 with a quantifier char right before it.
fn __rx_lazy(ae: Int, pnext: Int) -> Int = if pnext >= ae + 2 and prim.load8(pnext - 1) == 63 and (prim.load8(pnext - 2) == 42 or prim.load8(pnext - 2) == 43 or prim.load8(pnext - 2) == 63 or prim.load8(pnext - 2) == 125) then 1 else 0

fn __rx_seq(p: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, k: Int) -> Int = if p >= pend then __rx_run(k, t, ts, te, caps, pat0)
else {
  let b = prim.load8(p)
  let pnext = __rx_piece_end(p, pend)
  if b == 94 then {
    if __rx_bol(t, ts, pat0) then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    else 0 - 1
  } else if b == 36 then {
    if __rx_eol(t, te, pat0) then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    else 0 - 1
  } else if b == 92 and p + 1 < pend and (prim.load8(p + 1) == 98 or prim.load8(p + 1) == 66) then {
    let want = prim.load8(p + 1) == 98
    if __rx_at_boundary(t, ts, te) == want then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    else 0 - 1
  } else if b == 40 and p == pat0 and __rx_flags(pat0) == 1 then __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
  else {
    let ae = __rx_atom_end(p, pend)
    let q = if ae < pnext then prim.load8(ae) else 0
    let lazy = __rx_lazy(ae, pnext)
    if q == 0 then {
      if b == 40 then {
        let fr = __rx_frame(4)
        let _0 = prim.store64(fr, 1)
        let _1 = prim.store64(fr + 8, pnext)
        let _2 = prim.store64(fr + 16, pend)
        let _3 = prim.store64(fr + 24, k)
        __rx_group(p, ae, t, ts, te, caps, pat0, fr)
      } else {
        if __rx_char_match(p, ae, t, te) then __rx_seq(pnext, pend, t + __rx_w(t), ts, te, caps, pat0, k)
        else 0 - 1
      }
    } else {
      let mn = if q == 42 then 0
      else if q == 43 then 1
      else if q == 63 then 0 else __rx_brace_min(ae, pnext)
      let mx = if q == 42 then 0 - 1
      else if q == 43 then 0 - 1
      else if q == 63 then 1 else __rx_brace_max(ae, pnext)
      if b == 40 then __rx_rep_group(p, ae, pnext, pend, t, ts, te, caps, pat0, 0, mn, mx, lazy, k)
      else if lazy == 1 then __rx_rep_lazy(p, ae, pnext, pend, t, ts, te, caps, pat0, 0, mn, mx, k)
      else __rx_repi_fwd(p, ae, pnext, pend, t, ts, te, caps, pat0, 0, mn, mx, k)
    }
  }
}

// Non-group atom, LAZY: the rest first, then one more char.
fn __rx_rep_lazy(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, count: Int, mn: Int, mx: Int, k: Int) -> Int = {
  let under_max = if mx < 0 then true else count < mx
  if count >= mn then {
    let r = __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    if r >= 0 then r
    else if under_max and __rx_char_match(p, ae, t, te) then __rx_rep_lazy(p, ae, pnext, pend, t + __rx_w(t), ts, te, caps, pat0, count + 1, mn, mx, k)
    else 0 - 1
  } else if __rx_char_match(p, ae, t, te) then __rx_rep_lazy(p, ae, pnext, pend, t + __rx_w(t), ts, te, caps, pat0, count + 1, mn, mx, k)
  else 0 - 1
}

// Non-group atom, GREEDY (#1524): walk forward to the deepest count, then
// try the continuation at each position DESCENDING — two tail-recursive
// walks the renderer turns into loops.
fn __rx_repi_fwd(p: Int, ae: Int, pnext: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, count: Int, mn: Int, mx: Int, k: Int) -> Int = {
  let under_max = if mx < 0 then true else count < mx
  if under_max and __rx_char_match(p, ae, t, te) then __rx_repi_fwd(p, ae, pnext, pend, t + __rx_w(t), ts, te, caps, pat0, count + 1, mn, mx, k)
  else __rx_repi_try(pnext, pend, t, ts, te, caps, pat0, count, mn, k)
}

fn __rx_repi_try(pnext: Int, pend: Int, t: Int, ts: Int, te: Int, caps: Int, pat0: Int, i: Int, mn: Int, k: Int) -> Int = {
  if i < mn then 0 - 1
  else {
    let r = __rx_seq(pnext, pend, t, ts, te, caps, pat0, k)
    if r >= 0 then r
    else if i == 0 then 0 - 1
    else __rx_repi_try(pnext, pend, __rx_back(t, ts), ts, te, caps, pat0, i - 1, mn, k)
  }
}

// The Stage-1 entry (no captures, empty continuation).
fn __rx_match_at(p: Int, pe: Int, t: Int, ts: Int, te: Int) -> Int = __rx_alts(p, pe, t, ts, te, 0, p, 0)

// ── public API (Stage 1) ──
fn __rx_find_from(p: Int, pe: Int, t: Int, ts: Int, te: Int) -> Int = {
  let r = __rx_match_at(p, pe, t, ts, te)
  if r >= 0 then r
  else if t >= te then 0 - 1
  else __rx_find_from(p, pe, t + __rx_w(t), ts, te)
}

fn regex_is_match(pat: String, s: String) -> Bool = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  __rx_find_from(p0, pe, t0, t0, te) >= 0
}

// ── Stage 2: find / find_all / replace / replace_first / split ──
// Copy `n` bytes from `src` to `dst`.
fn regex_full_match(pat: String, s: String) -> Bool = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let fr = __rx_frame(2)
  let _0 = prim.store64(fr, 4)
  let _1 = prim.store64(fr + 8, te)
  __rx_alts(p0, pe, t0, t0, te, 0, p0, fr) == te
}

// The text substring [a, b) as a fresh owned String.
fn __rx_copy(src: Int, dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store8(dst, prim.load8(src))
  __rx_copy(src + 1, dst + 1, n - 1)
}

// Leftmost match START from `t` (or -1) — the companion of __rx_find_from.
fn __rx_sub(a: Int, b: Int) -> String = {
  let out = prim.alloc_str(b - a)
  let _ = __rx_copy(a, prim.handle(out) + 12, b - a)
  out
}

fn __rx_find_start(p: Int, pe: Int, t: Int, ts: Int, te: Int) -> Int = {
  let r = __rx_match_at(p, pe, t, ts, te)
  if r >= 0 then t
  else if t >= te then 0 - 1
  else __rx_find_start(p, pe, t + __rx_w(t), ts, te)
}

// v0 find_all: repeat leftmost; a zero-width match advances one char past `end`.
fn regex_find(pat: String, s: String) -> String? = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let st = __rx_find_start(p0, pe, t0, t0, te)
  if st < 0 then none
  else {
    let m = __rx_sub(st, __rx_match_at(p0, pe, st, t0, te))
    some(m)
  }
}

fn __rx_find_all_go(p: Int, pe: Int, pos: Int, ts: Int, te: Int, acc: List[String]) -> List[String] = if pos > te then acc
else {
  let st = __rx_find_start(p, pe, pos, ts, te)
  if st < 0 then acc
  else {
    let en = __rx_match_at(p, pe, st, ts, te)
    let m = __rx_sub(st, en)
    if en > st then __rx_find_all_go(p, pe, en, ts, te, acc + [m])
    else {
      if en < te then __rx_find_all_go(p, pe, en + __rx_w(en), ts, te, acc + [m])
      else acc + [m]
    }
  }
}

// v0 replace: scan; at each match emit the gap + the LITERAL replacement (no $n);
// a zero-width match ALSO emits the char at `end` and advances past it (at
// end-of-string it just terminates).
fn regex_find_all(pat: String, s: String) -> List[String] = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let acc: List[String] = []
  __rx_find_all_go(p0, pe, t0, t0, te, acc)
}

fn __rx_replace_go(p: Int, pe: Int, pos: Int, ts: Int, te: Int, rep: String, acc: String) -> String = if pos > te then acc
else {
  let st = __rx_find_start(p, pe, pos, ts, te)
  if st < 0 then acc + __rx_sub(pos, te)
  else {
    let en = __rx_match_at(p, pe, st, ts, te)
    let acc2 = acc + __rx_sub(pos, st) + rep
    if en > st then __rx_replace_go(p, pe, en, ts, te, rep, acc2)
    else {
      if en < te then __rx_replace_go(p, pe, en + __rx_w(en), ts, te, rep, acc2 + __rx_sub(en, en + __rx_w(en)))
      else acc2
    }
  }
}

fn regex_replace(pat: String, s: String, rep: String) -> String = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let acc = ""
  __rx_replace_go(p0, pe, t0, t0, te, rep, acc)
}

// v0 split: a zero-width match AT the current position takes ONE char as a
// field; otherwise the gap [pos, start) is a field and the scan resumes at
// `end`; the unmatched tail is the last field.
fn regex_replace_first(pat: String, s: String, rep: String) -> String = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let st = __rx_find_start(p0, pe, t0, t0, te)
  if st < 0 then s
  else __rx_sub(t0, st) + rep + __rx_sub(__rx_match_at(p0, pe, st, t0, te), te)
}

fn __rx_split_go(p: Int, pe: Int, pos: Int, ts: Int, te: Int, acc: List[String]) -> List[String] = if pos > te then acc
else {
  let st = __rx_find_start(p, pe, pos, ts, te)
  if st < 0 then acc + [__rx_sub(pos, te)]
  else {
    let en = __rx_match_at(p, pe, st, ts, te)
    if en == st and st == pos then {
      if pos < te then __rx_split_go(p, pe, pos + __rx_w(pos), ts, te, acc + [__rx_sub(pos, pos + __rx_w(pos))])
      else acc
    } else __rx_split_go(p, pe, en, ts, te, acc + [__rx_sub(pos, st)])
  }
}

// ── Stage 3: captures ──
// v0 semantics: caps[k] is written at GROUP COMPLETION (k = the group's
// pre-order '(' ordinal); the caller SAVES the caps before every alternative
// try and every greedy extension try, restoring on failure — so only the
// successful derivation's writes survive. The caps live in a caller-owned
// List[Int] buffer (2 slots per group: start, end; -1 = unmatched), passed as
// a raw handle so the matcher stays prim-only.
// Count the REAL group-opens '(' in [p, q) (escapes and classes are opaque) —
// the group at `q` has capture ordinal = this count.
fn regex_split(pat: String, s: String) -> List[String] = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let acc: List[String] = []
  __rx_split_go(p0, pe, t0, t0, te, acc)
}

// Copy `n` i64 slots from list-data address `src` to `dst`.
fn __rx_ngroups(p: Int, q: Int) -> Int = if p >= q then 0
else {
  let b = prim.load8(p)
  if b == 92 and p + 1 < q then __rx_ngroups(p + 1 + __rx_w(p + 1), q)
  else if b == 91 then __rx_ngroups(__rx_class_end(p + 1, q), q)
  else if b == 40 then {
    if p + 1 < q and prim.load8(p + 1) == 63 then __rx_ngroups(p + 1, q) else 1 + __rx_ngroups(p + 1, q)
  } else __rx_ngroups(p + __rx_w(p), q)
}

// Fill `n` i64 slots at `dst` with -1 (unmatched).
fn __rx_copy64(src: Int, dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store64(dst, prim.load64(src))
  __rx_copy64(src + 8, dst + 8, n - 1)
}

// ── the capture-threading matcher (the `_c` family — v0's clone/restore) ──
// `caps` = the buffer's DATA address (handle + 12); `nslots` = 2 * ncap;
// `pat0` = the pattern's data start (for group ordinal computation).
fn __rx_fill_neg(dst: Int, n: Int) -> Int = if n <= 0 then 0
else {
  prim.store64(dst, 0 - 1)
  __rx_fill_neg(dst + 8, n - 1)
}

fn __rx_caps_out(caps: Int, i: Int, ncap: Int, acc: List[String]) -> List[String] = if i >= ncap then acc
else {
  let st = prim.load64(caps + i * 16)
  if st < 0 then __rx_caps_out(caps, i + 1, ncap, acc + [""])
  else {
    let m = __rx_sub(st, prim.load64(caps + i * 16 + 8))
    __rx_caps_out(caps, i + 1, ncap, acc + [m])
  }
}

// Index 0 is the WHOLE match, 1.. are the groups — the shape every mainstream
// regex API uses and the one docs/stdlib/regex.md always documented; the
// groups-only return this replaced made `caps[1]` silently mean the SECOND
// group to anyone carrying that habit over (almide#1432).
//
// `none` now means exactly one thing: the pattern did not match. It previously
// also came back for a pattern with NO groups, conflating "matched nothing to
// capture" with "did not match" — with a full match at index 0 that case has a
// real answer. The buffer is still sized for at least one slot pair so a
// group-less pattern has somewhere to scan.
fn __rx_caps_scan(p: Int, pe: Int, t: Int, ts: Int, te: Int, caps: Int, nslots: Int) -> Int = {
  let _ = __rx_fill_neg(caps, nslots)
  let r = __rx_alts(p, pe, t, ts, te, caps, p, 0)
  if r >= 0 then t
  else if t >= te then 0 - 1
  else __rx_caps_scan(p, pe, t + __rx_w(t), ts, te, caps, nslots)
}

fn regex_captures(pat: String, s: String) -> List[String]? = {
  let ph = prim.handle(pat)
  let sh = prim.handle(s)
  let p0 = ph + 12
  let pe = p0 + prim.load32(ph + 4)
  let t0 = sh + 12
  let te = t0 + prim.load32(sh + 4)
  let ncap = __rx_ngroups(p0, pe)
  let nslots = if ncap == 0 then 2 else ncap * 2
  let buf = prim.alloc_list(nslots)
  let bd = prim.handle(buf) + 12
  let ms = __rx_caps_scan(p0, pe, t0, t0, te, bd, nslots)
  if ms < 0 then none
  else {
    let _ = __rx_fill_neg(bd, nslots)
    let me = __rx_alts(p0, pe, ms, t0, te, bd, p0, 0)
    let whole = __rx_sub(ms, me)
    let acc: List[String] = [whole]
    some(__rx_caps_out(bd, 0, ncap, acc))
  }
}
