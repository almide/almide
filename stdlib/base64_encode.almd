// base64_encode — SELF-HOSTED base64.encode / base64.encode_url (RFC 4648, padded). Each 3-byte
// group becomes 4 chars (6 bits each); a 1- or 2-byte tail is padded with '='. The alphabet is
// computed arithmetically: 0..25 -> 'A'..'Z', 26..51 -> 'a'..'z', 52..61 -> '0'..'9', 62/63 are
// the alphabet-specific symbols ('+'/'/' standard, '-'/'_' URL-safe). Output length = ceil(n/3)*4.
// A 6-bit index (0..63) -> its base64 ASCII char; c62/c63 are the alphabet-specific symbols.
fn __b64_char(idx: Int, c62: Int, c63: Int) -> Int = if idx < 26 then 65 + idx
else {
  if idx < 52 then 97 + (idx - 26)
  else {
    if idx < 62 then 48 + (idx - 52)
    else {
      if idx < 63 then c62 else c63
    }
  }
}

// Encode the n-byte input at src into base64 at dst (4 chars per 3-byte group, '=' padded tail).
// The 2nd/3rd source bytes are read from a CLAMPED offset (so the read is always in bounds even
// for a 1- or 2-byte tail) and zeroed via a 0/1 presence flag; the 3rd/4th output chars likewise
// compute the char unconditionally then SELECT it or '=' (61) — both keep every arm a plain scalar.
fn __b64_fill(dst: Int, src: Int, n: Int, i: Int, c62: Int, c63: Int) -> Int = if i >= n then 0
else {
  let rem = n - i
  let f1 = if rem > 1 then 1 else 0
  let f2 = if rem > 2 then 1 else 0
  let b0 = prim.load8(src + i)
  let b1raw = prim.load8(src + i + f1)
  let b2raw = prim.load8(src + i + f2 * 2)
  let b1 = b1raw * f1
  let b2 = b2raw * f2
  let s0 = prim.bshl(b0, 16)
  let s1 = prim.bshl(b1, 8)
  let p = prim.bor(s0, s1)
  let acc = prim.bor(p, b2)
  let sh18 = prim.bshr_u(acc, 18)
  let sh12 = prim.bshr_u(acc, 12)
  let sh6 = prim.bshr_u(acc, 6)
  let i0 = prim.band(sh18, 63)
  let i1 = prim.band(sh12, 63)
  let i2 = prim.band(sh6, 63)
  let i3 = prim.band(acc, 63)
  let dstpos = dst + (i / 3) * 4
  let ch0 = __b64_char(i0, c62, c63)
  let ch1 = __b64_char(i1, c62, c63)
  let ch2 = __b64_char(i2, c62, c63)
  let ch3 = __b64_char(i3, c62, c63)
  let c2 = if rem > 1 then ch2 else 61
  let c3 = if rem > 2 then ch3 else 61
  prim.store8(dstpos, ch0)
  prim.store8(dstpos + 1, ch1)
  prim.store8(dstpos + 2, c2)
  prim.store8(dstpos + 3, c3)
  __b64_fill(dst, src, n, i + 3, c62, c63)
}

// base64.encode(b) -> the standard-alphabet ('+' '/') padded base64 String.
fn base64_encode(b: Bytes) -> String = {
  let n = prim.load32(prim.handle(b) + 4)
  let chunks = (n + 2) / 3
  let out = prim.alloc_str(chunks * 4)
  let _x = __b64_fill(prim.handle(out) + 12, prim.handle(b) + 12, n, 0, 43, 47)
  out
}

// base64.encode_url(b) -> the URL-safe ('-' '_') padded base64 String.
fn base64_encode_url(b: Bytes) -> String = {
  let n = prim.load32(prim.handle(b) + 4)
  let chunks = (n + 2) / 3
  let out = prim.alloc_str(chunks * 4)
  let _x = __b64_fill(prim.handle(out) + 12, prim.handle(b) + 12, n, 0, 45, 95)
  out
}

// ── base64.decode / decode_url ── Result[Bytes, String], byte-matching native
// runtime/rs/src/base64.rs decode_str: the CANONICAL padded form only (#4119),
// checked in this order, the first failure wins:
//   1. byte length % 4 != 0              → "invalid base64 length: {len}"
//   2. more than two trailing '='        → "invalid base64 padding"
//   3. a body byte outside THIS alphabet → "invalid base64 character"
//      (a '=' before the trailing run, or the other alphabet's 62/63 pair)
//   4. nonzero bits under the padding    → "invalid base64 trailing bits"
// c62/c63 name the alphabet: 43/47 ('+' '/') for decode, 45/95 ('-' '_') for
// decode_url. Before #4119 both read both alphabets, '=' was stripped without
// bound and the dropped bits were ignored, so QQ==, QR==, QQ and QQ========
// all decoded to "A".
// 0..63 value of byte c under the alphabet (c62, c63), or -1.
fn __b64d_val(c: Int, c62: Int, c63: Int) -> Int = if c >= 65 and c <= 90 then c - 65
else if c >= 97 and c <= 122 then c - 71
else if c >= 48 and c <= 57 then c + 4
else if c == c62 then 62
else if c == c63 then 63 else 0 - 1

// Number of trailing '=' (61) bytes before `end`.
fn __b64d_pads(p: Int, end: Int, acc: Int) -> Int =
  if end > 0 and prim.load8(p + end - 1) == 61 then __b64d_pads(p, end - 1, acc + 1)
  else acc

fn __b64d_scan(p: Int, n: Int, i: Int, c62: Int, c63: Int) -> Bool = if i >= n then true
else if __b64d_val(prim.load8(p + i), c62, c63) < 0 then false
else __b64d_scan(p, n, i + 1, c62, c63)

fn __b64d_chunks(dst: Int, src: Int, chunks: Int, i: Int, c62: Int, c63: Int) -> Int =
  if i >= chunks then 0
  else {
    let a = __b64d_val(prim.load8(src + i * 4), c62, c63)
    let b = __b64d_val(prim.load8(src + i * 4 + 1), c62, c63)
    let c = __b64d_val(prim.load8(src + i * 4 + 2), c62, c63)
    let d = __b64d_val(prim.load8(src + i * 4 + 3), c62, c63)
    prim.store8(dst + i * 3, a * 4 + b / 16)
    prim.store8(dst + i * 3 + 1, prim.band(b * 16, 255) + c / 4)
    prim.store8(dst + i * 3 + 2, prim.band(c * 64, 255) + d)
    __b64d_chunks(dst, src, chunks, i + 1, c62, c63)
  }

fn __b64d_rem(dst: Int, src: Int, rem: Int, c62: Int, c63: Int) -> Int = if rem == 2 then {
  let a = __b64d_val(prim.load8(src), c62, c63)
  let b = __b64d_val(prim.load8(src + 1), c62, c63)
  prim.store8(dst, a * 4 + b / 16)
  0
} else if rem == 3 then {
  let a = __b64d_val(prim.load8(src), c62, c63)
  let b = __b64d_val(prim.load8(src + 1), c62, c63)
  let c = __b64d_val(prim.load8(src + 2), c62, c63)
  prim.store8(dst, a * 4 + b / 16)
  prim.store8(dst + 1, prim.band(b * 16, 255) + c / 4)
  0
} else 0

// The bits one '=' drops (low 2) or two drop (low 4) of the last symbol.
fn __b64d_dropped(pads: Int) -> Int = match pads {
  1 => 3,
  2 => 15,
  _ => 0,
}

fn __b64d_decode(s: String, c62: Int, c63: Int) -> Result[Bytes, String] = {
  let sh = prim.handle(s)
  let n = prim.load32(sh + 4)
  let pads = __b64d_pads(sh + 12, n, 0)
  let end = n - pads
  if n % 4 != 0 then err("invalid base64 length: " + int.to_string(n))
  else if pads > 2 then err("invalid base64 padding")
  else if __b64d_scan(sh + 12, end, 0, c62, c63) == false then err("invalid base64 character")
  else if end > 0 and prim.band(
    __b64d_val(prim.load8(sh + 12 + end - 1), c62, c63),
    __b64d_dropped(pads),
  ) != 0 then err("invalid base64 trailing bits")
  else {
    let chunks = end / 4
    let rem = end % 4
    let extra = if rem == 2 then 1
    else if rem == 3 then 2 else 0
    let out = prim.alloc_bytes(chunks * 3 + extra)
    let _c = __b64d_chunks(prim.handle(out) + 12, sh + 12, chunks, 0, c62, c63)
    let _r = __b64d_rem(prim.handle(out) + 12 + chunks * 3, sh + 12 + chunks * 4, rem, c62, c63)
    ok(out)
  }
}

fn base64_decode(s: String) -> Result[Bytes, String] = __b64d_decode(s, 43, 47)

fn base64_decode_url(s: String) -> Result[Bytes, String] = __b64d_decode(s, 45, 95)
