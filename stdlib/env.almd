// env — bundled-Almide stdlib module.
//
// Migrated from `@inline_rust(...)` templates to `@intrinsic(symbol)`
// in the dispatch-unification Phase 1e-3 sweep. Each fn is a single
// runtime-call pass-through; arg borrow decoration is derived by
// `pass_borrow_inference` from the Rust runtime signature instead of
// hand-coded in the template.
//
// Rust runtime lives in `runtime/rs/src/env.rs`. On WASM `args` /
// `unix_timestamp` / `os` / `temp_dir` / `get` are SELF-HOSTED
// (`stdlib/env_args.almd`, `env_unix_timestamp.almd`, `env_os.almd`,
// `env_temp_dir.almd`, `env_get.almd`), registered in
// `crates/almide-mir/src/render_wasm/registry.rs`; v0 routed them through
// `emit_wasm/calls_env.rs`, retired in c71eff7b. The rest
// (set/cwd/millis/sleep_ms) would
// need real WASI syscalls, tracked under
// `active/stdlib-declarative-unification.md` Stage 4.
/// Wall-clock seconds since the Unix epoch.
@intrinsic("almide_rt_env_unix_timestamp")
@category("Time")
effect fn unix_timestamp() -> Int = _

/// Program arguments, argv[0] excluded.
@intrinsic("almide_rt_env_args")
effect fn args() -> List[String] = _

/// Value of name, or none if unset.
@intrinsic("almide_rt_env_get")
effect fn get(name: String) -> String? = _

/// Sets name for this process and later spawns; err if name is empty or holds `=` or NUL, or value holds NUL.
@ordered
@category("Env.write")
effect fn set(name: String, value: String) -> Result[Unit, String] = match __set_refusal(
  name,
  value,
) {
  some(why) => err("env.set: " + why),
  none => {
    __set(name, value)
    ok(())
  },
}

// The pairs no environment can hold (#4200): POSIX setenv refuses an empty
// name and a name with `=`, and a C string ends at NUL. Native's set_var
// panicked on all four, where the wasm overlay stored them; checking here,
// before the host op, gives every leg the same err. The text names no
// user data, so it has nothing to escape.
local fn __set_refusal(name: String, value: String) -> String? =
  if name == "" then some("empty name")
  else if string.contains(name, "=") then some("name contains '='")
  else if string.contains(name, "\u{0}") then some("name contains NUL")
  else if string.contains(value, "\u{0}") then some("value contains NUL")
  else none

// `env.set`'s host op, reached only through `set` above and `remove` below:
// `remove` hands it the value NUL, the one value `set` refuses, and every leg
// reads that value as "this name is unset" (#3908).
@ordered
@intrinsic("almide_rt_env___set")
@category("Env.write")
effect fn __set(name: String, value: String) -> Unit = _

/// Removes name for this process and later spawns; ok if unset; err if name is empty or holds `=` or NUL.
@ordered
@category("Env.write")
effect fn remove(name: String) -> Result[Unit, String] = match __set_refusal(name, "") {
  some(why) => err("env.remove: " + why),
  none => {
    __set(name, "\u{0}")
    ok(())
  },
}

/// Every environment variable of this process, keyed and ordered by name.
/// Holds secrets as plain values: read a credential by name with `env.secret` instead.
effect fn vars() -> Map[String, String] = {
  let merged = __environ() |> list.fold(map.new(), (m, entry) => __vars_step(m, entry))
  merged |> map.to_list |> list.sort_by(((name, _)) => name) |> map.from_list
}

// One `name=value` entry of `__environ` onto the map. A later entry wins: the
// wasm hosts list the program's own `env.set` / `env.remove` writes after the
// environment it started with. A removed name's mark is the value NUL, which
// no `set` can store (`__set_refusal`), so it drops the name instead.
local fn __vars_step(m: Map[String, String], entry: String) -> Map[String, String] =
  match string.split_once(entry, "=") {
    some((name, value)) => if value == "\u{0}" then map.remove(m, name) else map.set(m, name, value),
    none => m,
  }

// `env.vars`'s host op: one `name=value` string per variable.
@intrinsic("almide_rt_env___environ")
effect fn __environ() -> List[String] = _

/// Absolute current directory; err if unreadable.
@intrinsic("almide_rt_env_cwd")
effect fn cwd() -> Result[String, String] = _

/// Wall-clock ms since the Unix epoch.
@intrinsic("almide_rt_env_millis")
@category("Time")
effect fn millis() -> Int = _

/// Blocks ms milliseconds; a negative ms hangs.
@intrinsic("almide_rt_env_sleep_ms")
@category("Time")
effect fn sleep_ms(ms: Int) -> Unit = _

/// Host temp dir; may end with /.
@intrinsic("almide_rt_env_temp_dir")
effect fn temp_dir() -> String = _

/// Host OS: macos, linux, windows or unknown; "wasi" on wasm (C-189).
@intrinsic("almide_rt_env_os")
@category
fn os() -> String = _
