// float64_convert — SELF-HOSTED float64.to_* sized conversions for v1:
// `float.to_<dst>(float.__from_float64(x))` unrolled to two `let`s (no call-as-arg),
// byte-matching float64.almd. Cross-file callees, pure scalar. There is no `to_float64` —
// identity.
fn float64_to_string(x: Float64) -> String = {
  let v = float.__from_float64(x)
  float.to_string(v)
}

fn float64_to_float32(x: Float64) -> Float32 = {
  let v = float.__from_float64(x)
  float.__raw_to_float32(v)
}
