// value_utils — SELF-HOSTED `value.pick` / `value.omit`, byte-matching native
// runtime/rs/src/value.rs. Both are SHALLOW (top-level keys only, nested Values
// untouched). pick/omit CO-OWN each kept key+value into the fresh Object
// (rc_inc — the __vmerge_fill_a discipline).
// keys ∋ k — a lookup in the key list hashed once per call (#4207): O(n + k),
// where a scan of `keys` per field was O(n·k). vb is the Object's pair payload.
fn __vu_keyset(keys: List[String]) -> Map[String, Int] = {
  var named: Map[String, Int] = map.new()
  for k in keys {
    named = map.set(named, k, 0)
  }
  named
}

fn __vu_has(named: Map[String, Int], vb: Int, i: Int) -> Bool = {
  let k: String = prim.load_handle(vb + (2 * i) * 8)
  map.contains(named, k)
}

// Count the pairs whose membership matches `want` (true = pick, false = omit).
fn __vu_count(vb: Int, named: Map[String, Int], want: Bool, i: Int, n: Int, acc: Int) -> Int =
  if i >= n then acc
  else if __vu_has(named, vb, i) == want then __vu_count(vb, named, want, i + 1, n, acc + 1)
  else __vu_count(vb, named, want, i + 1, n, acc)

// Fill the kept pairs in object order, co-owning key AND value (rc_inc both).
fn __vu_fill(vb: Int, named: Map[String, Int], dst: Value, want: Bool, i: Int, n: Int, w: Int) -> Int =
  if i >= n then w
  else if __vu_has(named, vb, i) == want then {
    let dh = prim.handle(dst)
    let kh = prim.load64(vb + (2 * i) * 8)
    let vh = prim.load64(vb + (2 * i + 1) * 8)
    prim.rc_inc(kh)
    prim.rc_inc(vh)
    prim.store64(dh + 12 + (2 * w) * 8, kh)
    prim.store64(dh + 12 + (2 * w + 1) * 8, vh)
    __vu_fill(vb, named, dst, want, i + 1, n, w + 1)
  } else __vu_fill(vb, named, dst, want, i + 1, n, w)

fn __vu_sel(v: Value, keys: List[String], want: Bool) -> Value = {
  let h = prim.handle(v)
  let n = prim.load32(h + 8) / 2
  let named = __vu_keyset(keys)
  let cnt = __vu_count(h + 12, named, want, 0, n, 0)
  let dst = prim.alloc_value(2 * cnt)
  let dh = prim.handle(dst)
  prim.store32(dh + 4, 6)
  prim.store32(dh + 8, 2 * cnt)
  let _w = __vu_fill(h + 12, named, dst, want, 0, n, 0)
  dst
}

// A non-object picks to the empty object (C-401): an allowlist over a value
// that is not an object lets nothing through.
fn value_pick(v: Value, keys: List[String]) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_sel(
    v,
    keys,
    true,
  )
  else {
    let none_: List[(String, Value)] = []
    value.object(none_)
  }

fn value_omit(v: Value, keys: List[String]) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_sel(
    v,
    keys,
    false,
  )
  else v

// value.object's fold on the structural wasm leg (C-401): the emitter boxes
// the list this returns, so a pair list that repeats a key becomes one entry
// per key — its first position, its last value — exactly as native's
// almide_rt_object_upsert and value_core's value_object fold it.
fn __vu_has_dup(pairs: List[(String, Value)]) -> Bool = {
  // A short list asks of each key whether it occurs twice: the pair list is
  // only read, so the check costs no allocation (it used to box an Option per
  // `list.get` probe, two per compared pair, #4613).
  if list.len(pairs) < 16 then pairs |> list.any(((k, _)) => list.count(pairs, ((j, _)) => j == k) > 1)
  else {
    var seen: Map[String, Int] = map.new()
    var dup = false
    for (k, _) in pairs {
      if map.contains(seen, k) then {
        dup = true
      } else {
        seen = map.set(seen, k, 0)
      }
    }
    dup
  }
}

fn __vu_fold_pairs(pairs: List[(String, Value)]) -> List[(String, Value)] =
  if list.len(pairs) < 2 or not __vu_has_dup(pairs) then pairs
  else {
    var at: Map[String, Int] = map.new()
    var keys: List[String] = []
    var vals: List[Value] = []
    for (k, v) in pairs {
      match map.get(at, k) {
        some(i) => {
          vals = list.set(vals, i, v)
        },
        none => {
          at = map.set(at, k, list.len(keys))
          list.push(keys, k)
          list.push(vals, v)
        },
      }
    }
    list.zip(keys, vals)
  }

// The STRUCTURAL wasm leg's value.merge / pick / omit (#4207): its emitter
// (crates/almide-wasm/src/value.rs) hands these the Objects' pair lists, so
// the key index is the keyed Map (a hash index past 16 entries) and each call
// is O(|a| + |b|) / O(n + k), where the emitter's scans were O(|a|·|b|) /
// O(n·k). merge is the fold v0 does: a's pairs in order, a key b has takes
// b's LAST value in the FIRST slot holding it, b's new keys appended once at
// their first position.
fn __vu_merge_pairs(pa: List[(String, Value)], pb: List[(String, Value)]) -> List[(String, Value)] = {
  var at: Map[String, Int] = map.new()
  var keys: List[String] = []
  var vals: List[Value] = []
  for (k, v) in pa {
    if not map.contains(at, k) then {
      at = map.set(at, k, list.len(keys))
    } else ()
    list.push(keys, k)
    list.push(vals, v)
  }
  for (k, v) in pb {
    match map.get(at, k) {
      some(i) => {
        vals = list.set(vals, i, v)
      },
      none => {
        at = map.set(at, k, list.len(keys))
        list.push(keys, k)
        list.push(vals, v)
      },
    }
  }
  list.zip(keys, vals)
}

fn __vu_select_pairs(pairs: List[(String, Value)], keys: List[String], want: Bool) -> List[(String, Value)] = {
  var named: Map[String, Int] = map.new()
  for k in keys {
    named = map.set(named, k, 0)
  }
  var out: List[(String, Value)] = []
  for (k, v) in pairs {
    if map.contains(named, k) == want then { list.push(out, (k, v)) } else ()
  }
  out
}

fn __vu_pick_pairs(pairs: List[(String, Value)], keys: List[String]) -> List[(String, Value)] = __vu_select_pairs(
  pairs,
  keys,
  true,
)

fn __vu_omit_pairs(pairs: List[(String, Value)], keys: List[String]) -> List[(String, Value)] = __vu_select_pairs(
  pairs,
  keys,
  false,
)

// Two keys that rename to one (`a_b` and `aB` under camelCase) are folded by
// value.object's upsert (C-401): first position, last value, as natively.
fn __vu_pair(v: Value, i: Int) -> (String, Value) = {
  let h = prim.handle(v)
  let k: String = prim.load_handle(h + 12 + (2 * i) * 8)
  let x: Value = prim.load_handle(h + 12 + (2 * i + 1) * 8)
  (k, x)
}

fn __vu_refold(v: Value) -> Value = {
  let keys = value.__keys(v)
  let n = list.len(keys)
  if list.len(list.unique(keys)) == n then v
  else value.object(list.range(0, n) |> list.map((i) => __vu_pair(v, i)))
}

// ── json.stringify on the wasm leg (ADR-0033 phase 1, D5) ──
// The self-hosted compact writer the wasm emitter calls for `json.stringify`
// and `value.__stringify` (VALUE_SELFHOST_HELPERS), in place of its hand-built
// `$vjson`. Two passes over the tree: a SIZE pass (exact for every leaf but a
// Float, which is bounded by 24 bytes — the longest shortest-round-trip text
// of an f64), ONE String allocated at that size, then a FILL pass whose every
// write is first checked against the allocated end: a disagreement between
// the passes is a defined abort, never a write past the block. The String's
// len is then set to what was written.
//
// It reads the WASM layout, so only the wasm leg links it (the native leg's
// json.stringify is its runtime intrinsic, the interpreter's its own):
//   a Value box: tag i32 at +12 (0 null, 1 bool, 2 int, 3 float, 4 str,
//     5 array, 6 object), payload at +20 (a block address, an Int, a Float's
//     bits, a Bool 0/1);
//   a list block: len at +4 in BYTES, 4-byte handle slots from +12;
//   a (String, Value) pair block: key at +12, value at +16;
//   a String block: len at +4, bytes from +12.
// Output is byte-identical to `$vjson` (RFC 8259 §7 escapes: \" \\ \n \r \t
// short, every other byte below 0x20 as \u00xx in lowercase hex; a Float
// through float.to_string minus a trailing ".0"; a non-finite Float as null,
// C-356; Object keys in insertion order, C-401).

// The bytes the JSON text of byte `b` inside a string takes.
fn __jw_esc(b: Int) -> Int = if b == 34 or b == 92 or b == 10 or b == 13 or b == 9 then 2
else if b < 32 then 6
else 1

// Does the 8-byte word `x` hold a byte below 0x20, a '"' or a '\'? The
// SWAR has-less / has-zero tests (exact as booleans): eight string bytes per
// step on the clean runs, which are nearly all of a JSON text.
fn __jw_special8(x: Int) -> Bool = {
  let ones = 72340172838076673
  let q = prim.bxor(x, 2459565876494606882)
  let b = prim.bxor(x, 6655295901103053916)
  let ctl = prim.band(x - 2314885530818453536, prim.bxor(x, 0 - 1))
  let quo = prim.band(q - ones, prim.bxor(q, 0 - 1))
  let bsl = prim.band(b - ones, prim.bxor(b, 0 - 1))
  prim.band(prim.bor(prim.bor(ctl, quo), bsl), 0 - 9187201950435737472) != 0
}

fn __jw_strsize(p: Int, e: Int, acc: Int) -> Int = if p + 8 <= e and not __jw_special8(prim.load64(p)) then __jw_strsize(
  p + 8,
  e,
  acc + 8,
)
else if p >= e then acc
else __jw_strsize(p + 1, e, acc + __jw_esc(prim.load8(p)))

// The quoted size of the String block at `s`.
fn __jw_qsize(s: Int) -> Int = __jw_strsize(s + 12, s + 12 + prim.load32(s + 4), 2)

fn __jw_digits(n: Int, acc: Int) -> Int = if n < 10 then acc + 1 else __jw_digits(n / 10, acc + 1)

// The length of Int n's decimal text. The one Int with no negation, the
// minimum, is 20 bytes.
fn __jw_isize(n: Int) -> Int = if n >= 0 then __jw_digits(n, 0)
else if n == 0 - 9223372036854775807 - 1 then 20
else 1 + __jw_digits(0 - n, 0)

// The size of the Value box at `h`.
fn __jw_size(h: Int) -> Int = match prim.load32(h + 12) {
  0 => 4,
  1 => if prim.load64(h + 20) == 0 then 5 else 4,
  2 => __jw_isize(prim.load64(h + 20)),
  3 => 24,
  4 => __jw_qsize(prim.load32(h + 20)),
  5 => __jw_lsize(prim.load32(h + 20), false),
  _ => __jw_lsize(prim.load32(h + 20), true),
}

// The size of a list block's members, brackets and commas; `obj` reads each
// slot as a pair block.
fn __jw_lsize(l: Int, obj: Bool) -> Int = {
  let n = prim.load32(l + 4) / 4
  if n == 0 then 2 else __jw_lsum(l + 12, l + 12 + n * 4, obj, n + 1)
}

fn __jw_lsum(p: Int, e: Int, obj: Bool, acc: Int) -> Int = if p >= e then acc
else {
  let x = prim.load32(p)
  let s = if obj then __jw_qsize(prim.load32(x + 12)) + 1 + __jw_size(prim.load32(x + 16)) else __jw_size(x)
  __jw_lsum(p + 4, e, obj, acc + s)
}

// Abort unless `k` more bytes fit before `lim`.
fn __jw_room(o: Int, k: Int, lim: Int) -> Unit = if o + k > lim then prim.die(
  prim.handle("Error: json.stringify wrote past its sized buffer\n"),
)
else ()

fn __jw_put1(o: Int, lim: Int, b: Int) -> Int = {
  __jw_room(o, 1, lim)
  prim.store8(o, b)
  o + 1
}

fn __jw_put4(o: Int, lim: Int, a: Int, b: Int, c: Int, d: Int) -> Int = {
  __jw_room(o, 4, lim)
  prim.store8(o, a)
  prim.store8(o + 1, b)
  prim.store8(o + 2, c)
  prim.store8(o + 3, d)
  o + 4
}

fn __jw_hex(n: Int) -> Int = if n < 10 then 48 + n else 87 + n

// One string byte at `o`, each branch checking the room its own text takes;
// answers the next `o`.
fn __jw_putb(b: Int, o: Int, lim: Int) -> Int = if b == 34 or b == 92 then {
  __jw_room(o, 2, lim)
  prim.store8(o, 92)
  prim.store8(o + 1, b)
  o + 2
} else if b == 10 or b == 13 or b == 9 then {
  __jw_room(o, 2, lim)
  prim.store8(o, 92)
  prim.store8(o + 1, if b == 10 then 110 else if b == 13 then 114 else 116)
  o + 2
} else if b < 32 then {
  __jw_room(o, 6, lim)
  prim.store8(o, 92)
  prim.store8(o + 1, 117)
  prim.store8(o + 2, 48)
  prim.store8(o + 3, 48)
  prim.store8(o + 4, __jw_hex(b / 16))
  prim.store8(o + 5, __jw_hex(b % 16))
  o + 6
} else {
  __jw_room(o, 1, lim)
  prim.store8(o, b)
  o + 1
}

// A clean 8-byte word is copied whole; any other byte goes through
// __jw_putb.
fn __jw_putbytes(p: Int, e: Int, o: Int, lim: Int) -> Int = if p + 8 <= e and not __jw_special8(prim.load64(p)) then {
  __jw_room(o, 8, lim)
  prim.store64(o, prim.load64(p))
  __jw_putbytes(p + 8, e, o + 8, lim)
} else if p >= e then o
else __jw_putbytes(p + 1, e, __jw_putb(prim.load8(p), o, lim), lim)

// The String block at `s`, quoted.
fn __jw_putstr(s: Int, o: Int, lim: Int) -> Int = {
  let o1 = __jw_put1(o, lim, 34)
  let o2 = __jw_putbytes(s + 12, s + 12 + prim.load32(s + 4), o1, lim)
  __jw_put1(o2, lim, 34)
}

// The digits of n >= 0, the last at `q`, leftwards.
fn __jw_wpos(n: Int, q: Int) -> Unit = {
  prim.store8(q, 48 + n % 10)
  if n >= 10 then __jw_wpos(n / 10, q - 1) else ()
}

// The digits of n < 0 (its remainders are -9..0, so the minimum needs no
// negation), the last at `q`, leftwards.
fn __jw_wneg(n: Int, q: Int) -> Unit = {
  prim.store8(q, 48 - n % 10)
  if n <= 0 - 10 then __jw_wneg(n / 10, q - 1) else ()
}

fn __jw_putint(n: Int, o: Int, lim: Int) -> Int = {
  let k = __jw_isize(n)
  __jw_room(o, k, lim)
  if n >= 0 then __jw_wpos(n, o + k - 1)
  else {
    prim.store8(o, 45)
    __jw_wneg(n, o + k - 1)
  }
  o + k
}

fn __jw_copy(p: Int, e: Int, o: Int) -> Int = if p >= e then o
else {
  prim.store8(o, prim.load8(p))
  __jw_copy(p + 1, e, o + 1)
}

// A Float's text: float.to_string's, minus a trailing ".0"; non-finite is null.
fn __jw_putfloat(bits: Int, o: Int, lim: Int) -> Int = if prim.band(prim.bshr_u(bits, 52), 2047) == 2047 then __jw_put4(
  o,
  lim,
  110,
  117,
  108,
  108,
)
else {
  let s = float.to_string(prim.ffrombits(bits))
  let h = prim.handle(s)
  let n = prim.load32(h + 4)
  let m = if n >= 2 and prim.load8(h + 12 + n - 2) == 46 and prim.load8(h + 12 + n - 1) == 48 then n - 2 else n
  __jw_room(o, m, lim)
  __jw_copy(h + 12, h + 12 + m, o)
}

// The Value box at `h` at `o`; answers the next `o`.
fn __jw_put(h: Int, o: Int, lim: Int) -> Int = match prim.load32(h + 12) {
  0 => __jw_put4(o, lim, 110, 117, 108, 108),
  1 => if prim.load64(h + 20) == 0 then __jw_put1(__jw_put4(o, lim, 102, 97, 108, 115), lim, 101)
  else __jw_put4(o, lim, 116, 114, 117, 101),
  2 => __jw_putint(prim.load64(h + 20), o, lim),
  3 => __jw_putfloat(prim.load64(h + 20), o, lim),
  4 => __jw_putstr(prim.load32(h + 20), o, lim),
  5 => __jw_putlist(prim.load32(h + 20), false, o, lim),
  _ => __jw_putlist(prim.load32(h + 20), true, o, lim),
}

fn __jw_putlist(l: Int, obj: Bool, o: Int, lim: Int) -> Int = {
  let n = prim.load32(l + 4) / 4
  let o1 = __jw_put1(o, lim, if obj then 123 else 91)
  let o2 = __jw_putmembers(l + 12, l + 12 + n * 4, obj, o1, lim)
  __jw_put1(o2, lim, if obj then 125 else 93)
}

fn __jw_putmembers(p: Int, e: Int, obj: Bool, o: Int, lim: Int) -> Int = if p >= e then o
else {
  let x = prim.load32(p)
  let o2 = if obj then __jw_put(prim.load32(x + 16), __jw_put1(__jw_putstr(prim.load32(x + 12), o, lim), lim, 58), lim) else __jw_put(x, o, lim)
  if p + 4 < e then __jw_putmembers(p + 4, e, obj, __jw_put1(o2, lim, 44), lim) else o2
}

// `json.stringify(v)` on the wasm leg.
fn __jw_stringify(v: Value) -> String = {
  let h = prim.handle(v)
  let size = __jw_size(h)
  let out = prim.alloc_str(size)
  let oh = prim.handle(out)
  let n = __jw_put(h, oh + 12, oh + 12 + size) - (oh + 12)
  prim.store32(oh + 4, n)
  out
}
