// value_utils — SELF-HOSTED `value.pick` / `value.omit` / `value.to_camel_case` /
// `value.to_snake_case`, byte-matching native runtime/rs/src/value.rs. All four are
// SHALLOW (top-level keys only, nested Values untouched) and pass a non-Object
// through unchanged (the borrowed param returned bare — auto-acquire, the
// value_merge `else b` precedent). pick/omit CO-OWN each kept key+value into the
// fresh Object (rc_inc — the __vmerge_fill_a discipline); the case transforms store
// a FRESH transformed key (owned, moved via store_str) and co-own the value only.
// Key transforms are ASCII-only (native's to_ascii_uppercase/lowercase): byte-level
// processing is char-exact because UTF-8 continuation bytes never land in A-Z/a-z.
// keys ∋ k — a binary search of the key list sorted once per call (#4207, the
// value_core __vx_* key index): O((n + k) log k), where a scan of `keys` per
// field was O(n·k). kb is the key list's payload, sk its sorted index.
fn __vu_has(kb: Int, sk: Int, nk: Int, k: Int) -> Bool = __vx_first(kb, 8, sk, nk, k) >= 0

// Count the pairs whose membership matches `want` (true = pick, false = omit).
fn __vu_count(vb: Int, kb: Int, sk: Int, want: Bool, i: Int, n: Int, nk: Int, acc: Int) -> Int =
  if i >= n then acc
  else if __vu_has(kb, sk, nk, prim.load64(vb + (2 * i) * 8)) == want then __vu_count(
    vb,
    kb,
    sk,
    want,
    i + 1,
    n,
    nk,
    acc + 1,
  )
  else __vu_count(vb, kb, sk, want, i + 1, n, nk, acc)

// Fill the kept pairs in object order, co-owning key AND value (rc_inc both).
fn __vu_fill(vb: Int, kb: Int, sk: Int, dst: Value, want: Bool, i: Int, n: Int, nk: Int, w: Int) -> Int =
  if i >= n then w
  else {
    let kh = prim.load64(vb + (2 * i) * 8)
    if __vu_has(kb, sk, nk, kh) == want then {
      let dh = prim.handle(dst)
      let vh = prim.load64(vb + (2 * i + 1) * 8)
      prim.rc_inc(kh)
      prim.rc_inc(vh)
      prim.store64(dh + 12 + (2 * w) * 8, kh)
      prim.store64(dh + 12 + (2 * w + 1) * 8, vh)
      __vu_fill(vb, kb, sk, dst, want, i + 1, n, nk, w + 1)
    } else __vu_fill(vb, kb, sk, dst, want, i + 1, n, nk, w)
  }

fn __vu_sel(v: Value, keys: List[String], want: Bool) -> Value = {
  let h = prim.handle(v)
  let n = prim.load32(h + 8) / 2
  let kh = prim.handle(keys)
  let nk = prim.load32(kh + 4)
  let xk = prim.alloc_list(nk)
  let yk = prim.alloc_list(nk)
  let sk = __vx_sort(kh + 12, 8, nk, prim.handle(xk) + 12, prim.handle(yk) + 12)
  let cnt = __vu_count(h + 12, kh + 12, sk, want, 0, n, nk, 0)
  let dst = prim.alloc_value(2 * cnt)
  let dh = prim.handle(dst)
  prim.store32(dh + 4, 6)
  prim.store32(dh + 8, 2 * cnt)
  let _w = __vu_fill(h + 12, kh + 12, sk, dst, want, 0, n, nk, 0)
  dst
}

// A non-object picks to the empty object (C-401): an allowlist over a value
// that is not an object lets nothing through.
fn value_pick(v: Value, keys: List[String]) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_sel(
    v,
    keys,
    true,
  )
  else {
    let none_: List[(String, Value)] = []
    value.object(none_)
  }

fn value_omit(v: Value, keys: List[String]) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_sel(
    v,
    keys,
    false,
  )
  else v

// snake_case → camelCase: '_' drops and capitalizes the NEXT ASCII lowercase
// letter (consecutive/leading/trailing underscores follow native's flag walk).
fn __vu_camel_fill(dst: Int, src: Int, n: Int, i: Int, w: Int, up: Bool) -> Int = if i >= n then w
else {
  let b = prim.load8(src + i)
  if b == 95 then __vu_camel_fill(dst, src, n, i + 1, w, true)
  else if up and b >= 97 and b <= 122 then {
    prim.store8(dst + w, b - 32)
    __vu_camel_fill(dst, src, n, i + 1, w + 1, false)
  } else {
    prim.store8(dst + w, b)
    __vu_camel_fill(dst, src, n, i + 1, w + 1, false)
  }
}

fn __vu_camel(k: String) -> String = {
  let sh = prim.handle(k)
  let n = prim.load32(sh + 4)
  let out = prim.alloc_str(n)
  let w = __vu_camel_fill(prim.handle(out) + 12, sh + 12, n, 0, 0, false)
  prim.store32(prim.handle(out) + 4, w)
  out
}

// camelCase → snake_case: ASCII uppercase gains a '_' prefix (except at byte 0)
// and lowers; everything else passes through. Worst case doubles → alloc 2n, shrink.
fn __vu_snake_fill(dst: Int, src: Int, n: Int, i: Int, w: Int) -> Int = if i >= n then w
else {
  let b = prim.load8(src + i)
  if b >= 65 and b <= 90 and i > 0 then {
    prim.store8(dst + w, 95)
    prim.store8(dst + w + 1, b + 32)
    __vu_snake_fill(dst, src, n, i + 1, w + 2)
  } else if b >= 65 and b <= 90 then {
    prim.store8(dst + w, b + 32)
    __vu_snake_fill(dst, src, n, i + 1, w + 1)
  } else {
    prim.store8(dst + w, b)
    __vu_snake_fill(dst, src, n, i + 1, w + 1)
  }
}

fn __vu_snake(k: String) -> String = {
  let sh = prim.handle(k)
  let n = prim.load32(sh + 4)
  let out = prim.alloc_str(2 * n)
  let w = __vu_snake_fill(prim.handle(out) + 12, sh + 12, n, 0, 0)
  prim.store32(prim.handle(out) + 4, w)
  out
}

// Rename fills: fresh owned key MOVED into the slot (store_str), value CO-OWNED
// (rc_inc). Split per transform — a heap-result `if` cannot pick the transform.
fn __vu_ren_fill_c(v: Value, dst: Value, i: Int, n: Int) -> Unit = if i >= n then ()
else {
  let h = prim.handle(v)
  let k: String = prim.load_handle(h + 12 + (2 * i) * 8)
  let nk = __vu_camel(k)
  let dh = prim.handle(dst)
  prim.store_str(dh + 12 + (2 * i) * 8, nk)
  let vh = prim.load64(h + 12 + (2 * i + 1) * 8)
  prim.rc_inc(vh)
  prim.store64(dh + 12 + (2 * i + 1) * 8, vh)
  __vu_ren_fill_c(v, dst, i + 1, n)
}

fn __vu_ren_fill_s(v: Value, dst: Value, i: Int, n: Int) -> Unit = if i >= n then ()
else {
  let h = prim.handle(v)
  let k: String = prim.load_handle(h + 12 + (2 * i) * 8)
  let nk = __vu_snake(k)
  let dh = prim.handle(dst)
  prim.store_str(dh + 12 + (2 * i) * 8, nk)
  let vh = prim.load64(h + 12 + (2 * i + 1) * 8)
  prim.rc_inc(vh)
  prim.store64(dh + 12 + (2 * i + 1) * 8, vh)
  __vu_ren_fill_s(v, dst, i + 1, n)
}

fn __vu_ren_c(v: Value) -> Value = {
  let h = prim.handle(v)
  let n = prim.load32(h + 8) / 2
  let dst = prim.alloc_value(2 * n)
  let dh = prim.handle(dst)
  prim.store32(dh + 4, 6)
  prim.store32(dh + 8, 2 * n)
  __vu_ren_fill_c(v, dst, 0, n)
  dst
}

fn __vu_ren_s(v: Value) -> Value = {
  let h = prim.handle(v)
  let n = prim.load32(h + 8) / 2
  let dst = prim.alloc_value(2 * n)
  let dh = prim.handle(dst)
  prim.store32(dh + 4, 6)
  prim.store32(dh + 8, 2 * n)
  __vu_ren_fill_s(v, dst, 0, n)
  dst
}

// value.object's fold on the structural wasm leg (C-401): the emitter boxes
// the list this returns, so a pair list that repeats a key becomes one entry
// per key — its first position, its last value — exactly as native's
// almide_rt_object_upsert and value_core's value_object fold it.
fn __vu_dup_small(pairs: List[(String, Value)], i: Int, j: Int, n: Int) -> Bool =
  if i >= n then false
  else if j >= n then __vu_dup_small(pairs, i + 1, i + 2, n)
  else if __vu_key_at(pairs, i) == __vu_key_at(pairs, j) then true
  else __vu_dup_small(pairs, i, j + 1, n)

fn __vu_key_at(pairs: List[(String, Value)], i: Int) -> String = match list.get(pairs, i) {
  some((k, _)) => k,
  none => "",
}

fn __vu_has_dup(pairs: List[(String, Value)]) -> Bool = {
  let n = list.len(pairs)
  if n < 16 then __vu_dup_small(pairs, 0, 1, n)
  else {
    var seen: Map[String, Int] = map.new()
    var dup = false
    for (k, _) in pairs {
      if map.contains(seen, k) then {
        dup = true
      } else {
        map.insert(seen, k, 0)
      }
    }
    dup
  }
}

fn __vu_fold_pairs(pairs: List[(String, Value)]) -> List[(String, Value)] =
  if list.len(pairs) < 2 or not __vu_has_dup(pairs) then pairs
  else {
    var at: Map[String, Int] = map.new()
    var keys: List[String] = []
    var vals: List[Value] = []
    for (k, v) in pairs {
      match map.get(at, k) {
        some(i) => {
          vals = list.set(vals, i, v)
        },
        none => {
          map.insert(at, k, list.len(keys))
          list.push(keys, k)
          list.push(vals, v)
        },
      }
    }
    list.zip(keys, vals)
  }

// The STRUCTURAL wasm leg's value.merge / pick / omit (#4207): its emitter
// (crates/almide-wasm/src/value.rs) hands these the Objects' pair lists, so
// the key index is the keyed Map (a hash index past 16 entries) and each call
// is O(|a| + |b|) / O(n + k), where the emitter's scans were O(|a|·|b|) /
// O(n·k). merge is the fold v0 does: a's pairs in order, a key b has takes
// b's LAST value in the FIRST slot holding it, b's new keys appended once at
// their first position.
fn __vu_merge_pairs(pa: List[(String, Value)], pb: List[(String, Value)]) -> List[(String, Value)] = {
  var at: Map[String, Int] = map.new()
  var keys: List[String] = []
  var vals: List[Value] = []
  for (k, v) in pa {
    if not map.contains(at, k) then {
      map.insert(at, k, list.len(keys))
    } else ()
    list.push(keys, k)
    list.push(vals, v)
  }
  for (k, v) in pb {
    match map.get(at, k) {
      some(i) => {
        vals = list.set(vals, i, v)
      },
      none => {
        map.insert(at, k, list.len(keys))
        list.push(keys, k)
        list.push(vals, v)
      },
    }
  }
  list.zip(keys, vals)
}

fn __vu_select_pairs(pairs: List[(String, Value)], keys: List[String], want: Bool) -> List[(String, Value)] = {
  var named: Map[String, Int] = map.new()
  for k in keys {
    map.insert(named, k, 0)
  }
  var out: List[(String, Value)] = []
  for (k, v) in pairs {
    if map.contains(named, k) == want then { list.push(out, (k, v)) } else ()
  }
  out
}

fn __vu_pick_pairs(pairs: List[(String, Value)], keys: List[String]) -> List[(String, Value)] = __vu_select_pairs(
  pairs,
  keys,
  true,
)

fn __vu_omit_pairs(pairs: List[(String, Value)], keys: List[String]) -> List[(String, Value)] = __vu_select_pairs(
  pairs,
  keys,
  false,
)

// Two keys that rename to one (`a_b` and `aB` under camelCase) are folded by
// value.object's upsert (C-401): first position, last value, as natively.
fn __vu_pair(v: Value, i: Int) -> (String, Value) = {
  let h = prim.handle(v)
  let k: String = prim.load_handle(h + 12 + (2 * i) * 8)
  let x: Value = prim.load_handle(h + 12 + (2 * i + 1) * 8)
  (k, x)
}

fn __vu_refold(v: Value) -> Value = {
  let keys = value.keys(v)
  let n = list.len(keys)
  if list.len(list.unique(keys)) == n then v
  else value.object(list.range(0, n) |> list.map((i) => __vu_pair(v, i)))
}

fn value_to_camel_case(v: Value) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_refold(__vu_ren_c(v)) else v

fn value_to_snake_case(v: Value) -> Value =
  if prim.load32(prim.handle(v) + 4) == 6 then __vu_refold(__vu_ren_s(v)) else v
