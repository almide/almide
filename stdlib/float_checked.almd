// float_checked — SELF-HOSTED float.to_{int,uint}{8,16,32,64}_checked for v1: Some(T) iff `n` is
// an EXACT integer in T's range, else None (NaN / infinity / fractional / out-of-range → None),
// byte-matching v0 (stdlib/float.almd) cell for cell.
//
// THE FAMILY RULE (#2487): every cell is a RANGE test on the source value against the target's
// exact bounds plus an INTEGRALITY test (`floor(n) == n`, via prim.ffloor / prim.feq), never a
// round trip through a conversion that wraps or saturates. The old round trip through
// int.from_T was exact up to 32 bits but `int.from_uint64` reinterprets [2^63, 2^64) as a
// negative Int, so `to_uint64_checked(2^63)` was None although 2^63 is an exact UInt64.
//
// SHAPE: all computation (guard bools, the truncation `i`, and the integrality bool `rt`) is
// hoisted into PRECEDING `let`s, leaving a FLAT if-chain whose every arm is directly `None` or
// `Some(i)` — the proven materialized-Option shape (cf. int_checked.almd). A BLOCK arm
// (`else { … }`) is NOT in that subset: a tail Option-`if` with a block arm falls back to an
// Opaque (len-0 = always-None) result. v1 also does not lower `or` (so the chain is nested ifs),
// a scalar call as an `if` cond (so each guard is bound first), or a nested call arg. Float
// compares go through the prim floor (flt/fgt/feq → f64.lt/gt/eq); the signed lower bound is
// built with prim.fneg. `i`/`rt` are computed UNCONDITIONALLY — sound because every op
// (float.to_T / prim.ffloor / prim.feq) is TOTAL (no trap, no effect, saturating), so the
// discarded out-of-range values change nothing and the Some-path value is `to_T(n)` exactly.
// Scalar Option[Int8…] over the materialized-Option machinery — cert untouched.
//
// The 64-bit variants build their 2^63 / 2^64 bound at RUNTIME (the literal overflows the float
// parser) via prim.i2f(prim.bshl(1, 62)) doubled — the pattern from float_convert.almd's
// float_to_uint64. Deferred: to_float32_checked (needs f32).
fn float_to_int8_checked(n: Float) -> Int8? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let neg = prim.fneg(128.0)
  let lo = prim.flt(n, neg)
  let hi = prim.fgt(n, 127.0)
  let i = float.to_int8(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

fn float_to_int16_checked(n: Float) -> Int16? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let neg = prim.fneg(32768.0)
  let lo = prim.flt(n, neg)
  let hi = prim.fgt(n, 32767.0)
  let i = float.to_int16(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

fn float_to_int32_checked(n: Float) -> Int32? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let neg = prim.fneg(2147483648.0)
  let lo = prim.flt(n, neg)
  let hi = prim.fgt(n, 2147483647.0)
  let i = float.to_int32(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

fn float_to_uint8_checked(n: Float) -> UInt8? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let lo = prim.flt(n, 0.0)
  let hi = prim.fgt(n, 255.0)
  let i = float.to_uint8(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

fn float_to_uint16_checked(n: Float) -> UInt16? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let lo = prim.flt(n, 0.0)
  let hi = prim.fgt(n, 65535.0)
  let i = float.to_uint16(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

fn float_to_uint32_checked(n: Float) -> UInt32? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let lo = prim.flt(n, 0.0)
  let hi = prim.fgt(n, 4294967295.0)
  let i = float.to_uint32(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

// 64-bit: bound 2^63 built at runtime (2^62 + 2^62), guards `n < -2^63` / `n >= 2^63` (>= because
// the f64 2^63 is just above i64::MAX). float.to_int64 = saturating f2i (total, no trap).
fn float_to_int64_checked(n: Float) -> Int64? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let p62 = prim.bshl(1, 62)
  let f62 = prim.i2f(p62)
  let two63 = prim.fadd(f62, f62)
  let neg63 = prim.fneg(two63)
  let lo = prim.flt(n, neg63)
  let hi = prim.fge(n, two63)
  let i = float.to_int64(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}

// 64-bit unsigned: bound 2^64 built at runtime (2^63 + 2^63), guards `n < 0` / `n >= 2^64`. Every
// integral f64 in [0, 2^64) is an exact u64, the upper half included: float.to_uint64 returns it
// as its i64 bit pattern (negative for >= 2^63), which IS the UInt64 (C-179).
fn float_to_uint64_checked(n: Float) -> UInt64? = {
  let nan = float.is_nan(n)
  let inf = float.is_infinite(n)
  let p62 = prim.bshl(1, 62)
  let f62 = prim.i2f(p62)
  let two63 = prim.fadd(f62, f62)
  let two64 = prim.fadd(two63, two63)
  let lo = prim.flt(n, 0.0)
  let hi = prim.fge(n, two64)
  let i = float.to_uint64(n)
  let fl = prim.ffloor(n)
  let rt = prim.feq(fl, n)
  if nan then none
  else if inf then none
  else if lo then none
  else if hi then none
  else if rt then some(i) else none
}
