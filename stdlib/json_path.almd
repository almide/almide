// json_path — SELF-HOSTED value.Path API (root/key/index/get_path/set_path/remove_path).
// The rep is a List[String] of segments, root-first — "f<name>" is a key step, "i<int>"
// an index step (digits from int.to_string, so int.parse always round-trips). A step
// appends to a uniquely owned path in place (the `let seg` + `path + [seg]` shape), so
// building a deep path stays linear.
fn json_path_index(path: List[String], i: Int) -> List[String] = {
  let seg = "i" + int.to_string(i)
  path + [seg]
}

fn json_path_get_go(j: Value, path: List[String], k: Int) -> Value? =
  if k >= list.len(path) then some(j)
  else {
    let seg = list.get(path, k) ?? ""
    let rest = string.drop(seg, 1)
    if string.take(seg, 1) == "f" then match value.__field(j, rest) {
      ok(v) => json_path_get_go(v, path, k + 1),
      err(_) => none,
    } else match int.parse(rest) {
      ok(i) => json_path_step_index(j, path, k, i),
      err(_) => none,
    }
  }

fn json_path_step_index(j: Value, path: List[String], k: Int, i: Int) -> Value? = match value.as_array(j) {
  ok(xs) => {
    match list.get(xs, i) {
      some(v) => json_path_get_go(v, path, k + 1),
      none => none,
    }
  },
  err(_) => none,
}

// ── value.Path (#4220) ── stdlib/value.almd's root/key/index/get_path/set_path/
// remove_path on the wasm leg, over this file's List[String] segment rep (the newtype
// eraser publishes Named("Path") → List[String]). value.index treats a negative i as
// OUT OF RANGE (it never counts from the end), so a negative step is recorded as the
// largest Int, which no array reaches — get misses, set and remove leave v as is.
@implements("value.root")
fn value_path_root() -> List[String] = []

@implements("value.key")
fn value_path_key(p: List[String], name: String) -> List[String] = {
  let seg = "f" + name
  p + [seg]
}

@implements("value.index")
fn value_path_index(p: List[String], i: Int) -> List[String] =
  if i < 0 then json_path_index(p, 9223372036854775807)
  else json_path_index(p, i)

@implements("value.get_path")
fn value_get_path(v: Value, p: List[String]) -> Value? = json_path_get_go(v, p, 0)

// set_path is the bundled Path's walk over these segments' (is_key, name,
// index) steps (#4315): the structural wasm leg lowers that walk in place
// where `v` is its alone (crates/almide-wasm/src/value_set_path.rs), and `v`
// reaches it at its last use. The nesting bound (#4209) is the walk's own.
@implements("value.set_path")
fn value_set_path(v: Value, p: List[String], x: Value) -> Result[Value, String] = value.__set_path_steps(
  v,
  __jpath_steps(p),
  x,
)

// "f<name>" -> (true, name, 0); "i<int>" -> (false, "", int).
fn __jpath_steps(p: List[String]) -> List[(Bool, String, Int)] = p |> list.map((seg) => match string.take(seg, 1) {
  "f" => (true, string.drop(seg, 1), 0),
  _ => (false, "", int.parse(string.drop(seg, 1)) ?? 0),
})

@implements("value.remove_path")
fn value_remove_path(v: Value, p: List[String]) -> Value = json_path_rm_go(v, p, 0)

// ── remove_path — byte-matching native remove_at_steps (runtime/rs/src/json.rs, the
// C-090 oracle); INFALLIBLE. A Field step over an Object rewrites EVERY entry whose key
// matches — the walks go by SLOT index (key @ h+12+(2i)*8, value @ +8), not by key
// lookup, so duplicate keys transform each entry exactly like native's entries map. A
// non-object node or an out-of-range index is a NO-OP. Rebuilds go through the PROVEN
// value.object / value.array ctors. (set_path is __set_path_steps' walk, above.)
fn json_path_rm_go(j: Value, path: List[String], k: Int) -> Value =
  if k >= list.len(path) then value.null()
  else {
    let seg = list.get(path, k) ?? ""
    let rest = string.drop(seg, 1)
    let last = k + 1 >= list.len(path)
    if string.take(seg, 1) == "f" then json_path_rm_field(j, path, k, rest, last)
    else json_path_rm_index(j, path, k, int.parse(rest) ?? 0, last)
  }

fn json_path_rm_field(j: Value, path: List[String], k: Int, key: String, last: Bool) -> Value =
  if prim.load32(prim.handle(j) + 4) == 6 then {
    let n = prim.load32(prim.handle(j) + 8) / 2
    value.object(__jpr_pairs(j, path, k, key, last, 0, n, []))
  } else j

fn __jpr_pairs(j: Value, path: List[String], k: Int, key: String, last: Bool, i: Int, n: Int, acc: List[(String, Value)]) -> List[(String, Value)] =
  if i >= n then acc
  else {
    let h = prim.handle(j)
    let ek: String = prim.load_handle(h + 12 + (2 * i) * 8)
    let ev: Value = prim.load_handle(h + 12 + (2 * i + 1) * 8)
    if ek == key then {
      if last then __jpr_pairs(j, path, k, key, last, i + 1, n, acc)
      else {
        let rv = json_path_rm_go(ev, path, k + 1)
        __jpr_pairs(j, path, k, key, last, i + 1, n, acc + [(ek, rv)])
      }
    } else __jpr_pairs(j, path, k, key, last, i + 1, n, acc + [(ek, ev)])
  }

fn json_path_rm_index(j: Value, path: List[String], k: Int, i: Int, last: Bool) -> Value =
  if prim.load32(prim.handle(j) + 4) == 5 then {
    let n = prim.load32(prim.handle(j) + 8)
    if i < n then value.array(__jpr_items(j, path, k, i, last, 0, n, []))
    else j
  } else j

fn __jpr_items(j: Value, path: List[String], k: Int, tgt: Int, last: Bool, i: Int, n: Int, acc: List[Value]) -> List[Value] =
  if i >= n then acc
  else {
    let ev: Value = prim.load_handle(prim.handle(j) + 12 + i * 8)
    if i == tgt then {
      if last then __jpr_items(j, path, k, tgt, last, i + 1, n, acc)
      else {
        let rv = json_path_rm_go(ev, path, k + 1)
        __jpr_items(j, path, k, tgt, last, i + 1, n, acc + [rv])
      }
    } else __jpr_items(j, path, k, tgt, last, i + 1, n, acc + [ev])
  }

// ── value.__set_path_steps ── the interp oracle's body for the native runtime
// walk value.set_path calls over the bundled Path's (is_key, name, index)
// steps: stdlib/value.almd's pure `__set_path_pure`, which walks the public
// Value surface only. The structural wasm leg lowers the call itself
// (crates/almide-wasm/src/value_set_path.rs, #4315).
@implements("value.__set_path_steps")
fn value_set_path_steps(v: Value, steps: List[(Bool, String, Int)], x: Value) -> Result[Value, String] = value.__set_path_pure(
  v,
  steps,
  x,
)
