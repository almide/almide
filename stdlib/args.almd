// args — command-line argument parsing
// Bundled stdlib module (written in Almide, auto multi-target)
//
// Every reader is an `effect fn` (dialect epoch 13): argv is input, and a
// plain fn writes and aborts but never reads (ADR-0022), the rule
// `process.args` already followed (#3248). The `__` helpers take the list as
// a parameter and stay plain. `import env` lets the checker resolve
// `env.args` here, so the effect rule judges this file (without it the call
// was an unresolved name in the bundled context and E006 could not fire).
import env

/// Same as env.args; argv[0] excluded.
effect fn raw() -> List[String] = env.args()

/// True on --name before `--`; a one-letter name also matches -name. No short form is derived.
effect fn flag(name: String) -> Bool = __has(__options(env.args()), name)

/// True on --name before `--`; a one-letter name also matches -name. No short form is derived.
effect fn has_flag(name: String) -> Bool = __has(__options(env.args()), name)

// No short spelling is DERIVED from a long name (#4144: `-d` used to set both
// --dry-run and --delete). A long name's "short" comparand is "--" + name
// again, so only --name matches; a one-letter name also matches -name, which
// is how a program declares a short form: `has_flag("dry-run")! or has_flag("n")!`.
@category
fn __has(args: List[String], name: String) -> Bool = {
  // Recursion instead of `list.any` with a CAPTURING lambda: a capture inside
  // a BUNDLED module mislowers on wasm (#892). The recursion carries the two
  // comparands as parameters, so nothing is captured.
  let short = if string.len(name) == 1 then "-" + name else "--" + name
  __flag_at(args, "--" + name, short, 0)
}

// The arguments before the first `--` (#4144): `--` ends option parsing, so
// flags and options are read from this prefix only, and everything after the
// marker is positional.
@category
fn __options(args: List[String]) -> List[String] = match list.index_of(args, "--") {
  some(i) => list.take(args, i),
  none => args,
}

// The arguments after the first `--` (none when there is no marker).
@category
fn __operands(args: List[String]) -> List[String] = match list.index_of(args, "--") {
  some(i) => list.drop(args, i + 1),
  none => [],
}

@category
fn __flag_at(args: List[String], long: String, short: String, i: Int) -> Bool =
  if i >= list.len(args) then false
  else {
    // Read the element ONCE — a repeated `list.get_or` on a heap list param
    // inside a bundled module doubled the borrow (#892).
    let a = list.get_or(args, i, "")
    if a == long or a == short then true
    else __flag_at(args, long, short, i + 1)
  }

/// Value of --name=v or --name v before `--`; none if absent.
effect fn option(name: String) -> String? = {
  let args = __options(env.args())
  let long = "--" + name
  let eq_prefix = long + "="
  // Recursion, not `list.find` with a CAPTURING lambda — see `__has` (#892).
  let eq_match = __find_prefixed(args, eq_prefix, 0)
  match eq_match {
    some(a) => string.strip_prefix(a, eq_prefix),
    none => {
      let idx = list.index_of(args, long)
      match idx {
        some(i) => list.get(args, i + 1),
        none => none,
      }
    },
  }
}

@category
fn __find_prefixed(args: List[String], prefix: String, i: Int) -> String? =
  if i >= list.len(args) then none
  else if string.starts_with(list.get_or(args, i, ""), prefix) then list.get(args, i)
  else __find_prefixed(args, prefix, i + 1)

/// option(name), or fallback when absent.
effect fn option_or(name: String, fallback: String) -> String = match option(name)! {
  some(v) => v,
  none => fallback,
}

/// Args before `--` that are not flags or values of the named options, then all after `--`.
effect fn positional(options: List[String]) -> List[String] = __positional(env.args(), options)

// `env.args()` ALREADY excludes argv[0] — it is the user's arguments, the ones
// after `--`. Dropping one more here ate the FIRST real argument (#891:
// `-- input.csv out.csv` gave `out.csv`). After the first `--` every argument
// is positional, a leading `-` included (#4144: a file named `-d`).
//
// `options` names the options the program reads with `args.option` (#4144):
// the argument after `--name` is that option's value — the one `option(name)`
// answers — and is not positional, so `--out report.txt input.txt` with
// `["out"]` is `["input.txt"]`, not `["report.txt", "input.txt"]`. Before,
// `positional()` took no names and could not tell a value from a file.
@category
fn __positional(args: List[String], options: List[String]) -> List[String] = __positional_at(
  __options(args),
  options,
  0,
  [],
) + __operands(args)

// Recursion with the names as a parameter, not a capturing lambda (#892).
@category
fn __positional_at(args: List[String], options: List[String], i: Int, acc: List[String]) -> List[String] =
  if i >= list.len(args) then acc
  else {
    let a = list.get_or(args, i, "")
    if not string.starts_with(a, "-") then __positional_at(args, options, i + 1, acc + [a])
    else if string.starts_with(a, "--") and list.contains(options, string.drop(a, 2)) then __positional_at(
      args,
      options,
      i + 2,
      acc,
    )
    else __positional_at(args, options, i + 1, acc)
  }

/// i-th positional arg (see positional); none if out of range.
effect fn positional_at(i: Int, options: List[String]) -> String? = list.get(
  positional(options)!,
  i,
)
