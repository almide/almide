// args — command-line argument parsing
// Bundled stdlib module (written in Almide, auto multi-target)
//
// Every reader is an `effect fn` (dialect epoch 13): argv is input, and a
// plain fn writes and aborts but never reads (ADR-0022), the rule
// `env.args` already followed (#3248). The `__` helpers take the list as
// a parameter and stay plain. `import env` lets the checker resolve
// `env.args` here, so the effect rule judges this file (without it the call
// was an unresolved name in the bundled context and E006 could not fire).
import env

/// True on --name before `--`; a one-letter name also matches -name. No short form is derived. Err on a dash-written or empty name.
effect fn has_flag(name: String) -> Bool = {
  __name_ok("args.has_flag", name)!
  __has(__options(env.args()), name)
}

// A name is written without its dashes (#4866): `has_flag("--out")` compared
// against `----out` and was silently never true. A dash-written or empty
// name is an err naming the dash-free form, on every reader, whatever argv
// holds — so the mistake shows on the first run, not only when the option
// is passed.
@category
fn __name_ok(reader: String, name: String) -> Result[Unit, String] = {
  let bare = __undash(name)
  if bare == "" then err("${reader}: the name is empty: write it without dashes, as in \"out\"")
  else if bare != name then err("${reader}: write the name without its dashes: \"${bare}\"")
  else ok(())
}

@category
fn __undash(s: String) -> String = if string.starts_with(s, "-") then __undash(string.drop(s, 1)) else s

// Every name of a list, as `__name_ok` judges one (recursion, not a
// capturing lambda: #892).
@category
fn __names_ok(reader: String, names: List[String], i: Int) -> Result[Unit, String] =
  if i >= list.len(names) then ok(())
  else {
    __name_ok(reader, list.get(names, i) ?? "")!
    __names_ok(reader, names, i + 1)
  }

// The short comparand of a name: `-n` for a one-letter name, which is how a
// program declares a short form, else the long form again (no short form is
// derived from a long name, #4144).
@category
fn __short(name: String) -> String = if string.len(name) == 1 then "-" + name else "--" + name

// No short spelling is DERIVED from a long name (#4144: `-d` used to set both
// --dry-run and --delete). A long name's "short" comparand is "--" + name
// again, so only --name matches; a one-letter name also matches -name, which
// is how a program declares a short form: `has_flag("dry-run")! or has_flag("n")!`.
@category
fn __has(args: List[String], name: String) -> Bool = {
  // Recursion instead of `list.any` with a CAPTURING lambda: a capture inside
  // a BUNDLED module mislowers on wasm (#892). The recursion carries the two
  // comparands as parameters, so nothing is captured.
  __flag_at(args, "--" + name, __short(name), 0)
}

// The arguments before the first `--` (#4144): `--` ends option parsing, so
// flags and options are read from this prefix only, and everything after the
// marker is positional.
@category
fn __options(args: List[String]) -> List[String] = match list.index_of(args, "--") {
  some(i) => list.take(args, i),
  none => args,
}

// The arguments after the first `--` (none when there is no marker).
@category
fn __operands(args: List[String]) -> List[String] = match list.index_of(args, "--") {
  some(i) => list.drop(args, i + 1),
  none => [],
}

@category
fn __flag_at(args: List[String], long: String, short: String, i: Int) -> Bool =
  if i >= list.len(args) then false
  else {
    // Read the element ONCE — a repeated `list.get` on a heap list param
    // inside a bundled module doubled the borrow (#892).
    let a = list.get(args, i) ?? ""
    if a == long or a == short then true
    else __flag_at(args, long, short, i + 1)
  }

/// Value of --name=v or --name v before `--` (a one-letter name also -n=v, -n v); none if absent. Err on a dash-written or empty name.
effect fn option(name: String) -> String? = {
  __name_ok("args.option", name)!
  __option(__options(env.args()), name)
}

// The readers agree on a one-letter name (#4866): `has_flag("o")` answers to
// `-o`, so `option("o")` reads `-o v` and `-o=v` as well as `--o v`.
@category
fn __option(args: List[String], name: String) -> String? = {
  let long = "--" + name
  let short = __short(name)
  // Recursion, not `list.find` with a CAPTURING lambda — see `__has` (#892).
  match __find_either_prefixed(args, long + "=", short + "=", 0) {
    some(v) => some(v),
    none => match __index_either(args, long, short, 0) {
      some(i) => list.get(args, i + 1),
      none => none,
    },
  }
}

// The rest of the first argument starting with either prefix.
@category
fn __find_either_prefixed(args: List[String], long: String, short: String, i: Int) -> String? =
  if i >= list.len(args) then none
  else {
    let a = list.get(args, i) ?? ""
    if string.starts_with(a, long) then string.strip_prefix(a, long)
    else if string.starts_with(a, short) then string.strip_prefix(a, short)
    else __find_either_prefixed(args, long, short, i + 1)
  }

// The first argument starting with `prefix` (kept for the semantics
// manifest's element-index probe).
@category
fn __find_prefixed(args: List[String], prefix: String, i: Int) -> String? =
  if i >= list.len(args) then none
  else if string.starts_with(list.get(args, i) ?? "", prefix) then list.get(args, i)
  else __find_prefixed(args, prefix, i + 1)

// The index of the first argument equal to either form.
@category
fn __index_either(args: List[String], long: String, short: String, i: Int) -> Int? =
  if i >= list.len(args) then none
  else {
    let a = list.get(args, i) ?? ""
    if a == long or a == short then some(i)
    else __index_either(args, long, short, i + 1)
  }

/// Args before `--` that are not flags or values of the named options, then all after `--`. Err on a dash-written or empty name.
effect fn positional(options: List[String]) -> List[String] = {
  __names_ok("args.positional", options, 0)!
  __positional(env.args(), options)
}

// `env.args()` ALREADY excludes argv[0] — it is the user's arguments, the ones
// after `--`. Dropping one more here ate the FIRST real argument (#891:
// `-- input.csv out.csv` gave `out.csv`). After the first `--` every argument
// is positional, a leading `-` included (#4144: a file named `-d`).
//
// `options` names the options the program reads with `args.option` (#4144):
// the argument after `--name` is that option's value — the one `option(name)`
// answers — and is not positional, so `--out report.txt input.txt` with
// `["out"]` is `["input.txt"]`, not `["report.txt", "input.txt"]`. Before,
// `positional()` took no names and could not tell a value from a file.
@category
fn __positional(args: List[String], options: List[String]) -> List[String] = __positional_at(
  __options(args),
  options,
  0,
  [],
) + __operands(args)

// Recursion with the names as a parameter, not a capturing lambda (#892).
@category
fn __positional_at(args: List[String], options: List[String], i: Int, acc: List[String]) -> List[String] =
  if i >= list.len(args) then acc
  else {
    let a = list.get(args, i) ?? ""
    if not string.starts_with(a, "-") then __positional_at(args, options, i + 1, acc + [a])
    else if __names_value(options, a, 0) then __positional_at(
      args,
      options,
      i + 2,
      acc,
    )
    else __positional_at(args, options, i + 1, acc)
  }

// Does `a` stand before a named option's value: `--name`, or `-n` for a
// one-letter name (#4866, the same forms `option` reads)?
@category
fn __names_value(options: List[String], a: String, i: Int) -> Bool =
  if i >= list.len(options) then false
  else {
    let name = list.get(options, i) ?? ""
    if a == "--" + name or a == __short(name) then true
    else __names_value(options, a, i + 1)
  }
