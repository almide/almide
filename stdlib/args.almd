// args — command-line argument parsing
// Bundled stdlib module (written in Almide, auto multi-target)
fn raw() -> List[String] = env.args()

fn flag(name: String) -> Bool = {
  // Recursion instead of `list.any` with a CAPTURING lambda: a capture inside
  // a BUNDLED module mislowers on wasm (#892 — the closure env held garbage,
  // so the result was a truncated string or an out-of-bounds trap). The
  // recursion carries the two comparands as parameters, so nothing is
  // captured; it is also the form CLAUDE.md's idioms prefer.
  __flag_at(env.args(), "--" + name, "-" + string.slice(name, 0, 1), 0)
}

fn __flag_at(args: List[String], long: String, short: String, i: Int) -> Bool = if i >= list.len(args) then false
else {
  // Read the element ONCE — a repeated `list.get_or` on a heap list param
  // inside a bundled module doubled the borrow (#892).
  let a = list.get_or(args, i, "")
  if a == long or a == short then true
  else __flag_at(args, long, short, i + 1)
}

fn option(name: String) -> String? = {
  let args = env.args()
  let long = "--" + name
  let eq_prefix = long + "="
  // Recursion, not `list.find` with a CAPTURING lambda — see `flag` (#892).
  let eq_match = __find_prefixed(args, eq_prefix, 0)
  match eq_match {
    some(a) => string.strip_prefix(a, eq_prefix),
    none => {
      let idx = list.index_of(args, long)
      match idx {
        some(i) => list.get(args, i + 1),
        none => none,
      }
    },
  }
}

fn __find_prefixed(args: List[String], prefix: String, i: Int) -> String? = if i >= list.len(args) then none
else if string.starts_with(list.get_or(args, i, ""), prefix) then list.get(args, i)
else __find_prefixed(args, prefix, i + 1)

fn option_or(name: String, fallback: String) -> String = match option(name) {
  some(v) => v,
  none => fallback,
}

fn positional() -> List[String] = {
  // `env.args()` ALREADY excludes argv[0] — it is the user's arguments, the
  // ones after `--`. Dropping one more here ate the FIRST real argument
  // (#891: `-- input.csv out.csv` gave `out.csv`).
  list.filter(env.args(), (a) => not string.starts_with(a, "-"))
}

fn positional_at(i: Int) -> String? = list.get(positional(), i)
