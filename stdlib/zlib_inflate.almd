fn zli_sym_kind(sym: Int) -> Int = if sym < 0 then 0
else if sym < 256 then 1
else if sym == 256 then 2
else if sym - 257 >= 29 then 0 else 3

fn zli_len_kind(sym: Int) -> Int = if sym < 0 then 0
else if sym < 16 then 1
else if sym == 16 then 2
else if sym == 17 then 3 else 4

// (status, pos, buf, cnt)
// `base` is where this stream's output starts in `out`: a distance reaching
// before it is corrupt (RFC 1951 §3.2.5; zlib's "invalid distance too far
// back"), never read as zeros — an earlier gzip member's bytes are not this
// member's history either (#4268).
fn zli_codes(pos: Int, buf: Int, cnt: Int, inp: Bytes, mut out: Bytes, base: Int, limit: Int, lencode: List[Int], distcode: List[Int]) -> (Int, Int, Int, Int) = {
  let lbase = zli_lbase()
  let lext = zli_lext()
  let dbase = zli_dbase()
  let dext = zli_dext()
  var p = pos
  var b = buf
  var c = cnt
  var status = 0
  var running = true
  while running {
    let (sym, p2, b2, c2) = zli_decode(p, b, c, inp, lencode)
    p = p2
    b = b2
    c = c2
    // A symbol decoded from bits past the end of the input stops the block;
    // zli_inflate_stream reports it as truncation (#2853), not as a symbol.
    let sk = if p > bytes.len(inp) then 0 else zli_sym_kind(sym)
    var clen = 0
    var dist = 1
    match int.band(sk, 3) {
      0 => {
        status = 0 - 1
        running = false
      },
      1 => {
        if bytes.len(out) >= limit then {
          status = 0 - 3
          running = false
        } else { bytes.push(out, sym) }
      },
      2 => {
        running = false
      },
      _ => {
        let li = sym - 257
        let (eb, p3, b3, c3) = zli_bits(p, b, c, inp, lext[li])
        let (ds, p4, b4, c4) = zli_decode(p3, b3, c3, inp, distcode)
        let dsc = if ds < 0 or ds >= 30 then 0 else ds
        let (db, p5, b5, c5) = zli_bits(p4, b4, c4, inp, dext[dsc])
        p = p5
        b = b5
        c = c5
        let far = dbase[dsc] + db > bytes.len(out) - base
        let bad = if ds < 0 or ds >= 30 or far then 1 else 0
        let want = if bad == 1 then 0 else lbase[li] + eb
        let over = bad == 0 and bytes.len(out) + want > limit
        status = if bad == 1 then 0 - 1
        else if over then 0 - 3 else 0
        running = status == 0
        clen = if over then 0 else want
        dist = dbase[dsc] + db
      },
    }
    var k = 0
    while k < clen {
      bytes.push(out, bytes.get(out, bytes.len(out) - dist) ?? 0)
      k = k + 1
    }
  }
  (status, p, b, c)
}

fn zli_fixed_lit() -> List[Int] = {
  var lengths = list.repeat(8, 288)
  var i = 144
  while i < 256 {
    lengths[i] = 9
    i = i + 1
  }
  i = 256
  while i < 280 {
    lengths[i] = 7
    i = i + 1
  }
  zli_construct(lengths, 288)
}

// Read the HLIT+HDIST code lengths (with 16/17/18 repeats). Returns (status, pos, buf, cnt, lengths).
fn zli_read_lengths(pos: Int, buf: Int, cnt: Int, inp: Bytes, lencode: List[Int], total: Int) -> (Int, Int, Int, Int, List[Int]) = {
  var p = pos
  var b = buf
  var c = cnt
  var lengths = list.repeat(0, 320)
  var i = 0
  var status = 0
  while i < total and status == 0 {
    let (sym, p2, b2, c2) = zli_decode(p, b, c, inp, lencode)
    p = p2
    b = b2
    c = c2
    let lk = zli_len_kind(sym)
    let need = if lk == 2 then 2
    else if lk == 3 then 3
    else if lk == 4 then 7 else 0
    let (extra, p3, b3, c3) = zli_bits(p, b, c, inp, need)
    p = p3
    b = b3
    c = c3
    let val = if lk == 1 then sym
    else if lk == 2 and i > 0 then lengths[i - 1] else 0
    let rep0 = if lk == 1 then 1
    else if lk == 2 or lk == 3 then 3 + extra
    else if lk == 4 then 11 + extra else 0
    let bad = if lk == 0 or (lk == 2 and i == 0) or i + rep0 > total then 1 else 0
    status = 0 - bad
    var rep = if bad == 1 then 0 else rep0
    while rep > 0 {
      lengths[i] = val
      i = i + 1
      rep = rep - 1
    }
  }
  (status, p, b, c, if status != 0 then list.repeat(0, 320) else lengths)
}

// The order RFC 1951 sends the code-length code lengths in.
fn zli_cl_order() -> List[Int] = [
  16,
  17,
  18,
  0,
  8,
  7,
  9,
  6,
  10,
  5,
  11,
  4,
  12,
  3,
  13,
  2,
  14,
  1,
  15
]

// (status, pos, buf, cnt)
fn zli_dynamic(pos: Int, buf: Int, cnt: Int, inp: Bytes, mut out: Bytes, base: Int, limit: Int) -> (Int, Int, Int, Int) = {
  let (nlit, p1, b1, c1) = zli_bits(pos, buf, cnt, inp, 5)
  let (ndist, p2, b2, c2) = zli_bits(p1, b1, c1, inp, 5)
  let (ncode, p3, b3, c3) = zli_bits(p2, b2, c2, inp, 4)
  let nlen = nlit + 257
  let ndis = ndist + 1
  // Too many length or distance codes is malformed once the 14 header bits
  // are read — native stops there, so an input that also ends inside the
  // code-length codes after it is corrupt, not incomplete (GCE inspection).
  if nlen > 286 or ndis > 30 then (0 - 1, p3, b3, c3)
  else zli_dynamic_tables(p3, b3, c3, inp, out, base, limit, nlen, ndis, ncode)
}

// The code-length codes, then the literal/length and distance tables, then the
// block's symbols.
fn zli_dynamic_tables(pos: Int, buf: Int, cnt: Int, inp: Bytes, mut out: Bytes, base: Int, limit: Int, nlen: Int, ndis: Int, ncode: Int) -> (Int, Int, Int, Int) = {
  let order = zli_cl_order()
  var p = pos
  var b = buf
  var c = cnt
  var cl = list.repeat(0, 19)
  var i = 0
  while i < ncode + 4 {
    let (v, p4, b4, c4) = zli_bits(p, b, c, inp, 3)
    p = p4
    b = b4
    c = c4
    cl[order[i]] = v
    i = i + 1
  }
  // Each table is checked where native checks it and the block stops at the
  // first bad one (#2853): an incomplete code-length code, a malformed
  // literal/length or distance code.
  if not zli_code_ok(cl, 19, false) then (0 - 1, p, b, c)
  else {
    let (status, p5, b5, c5, lengths) = zli_read_lengths(
      p,
      b,
      c,
      inp,
      zli_construct(cl, 19),
      nlen + ndis,
    )
    let dlens = list.slice(lengths, nlen, nlen + ndis)
    if status != 0 then (status, p5, b5, c5)
    else if not zli_code_ok(lengths, nlen, true) or not zli_code_ok(dlens, ndis, true) then (0 - 1, p5, b5, c5)
    else zli_codes(
      p5,
      b5,
      c5,
      inp,
      out,
      base,
      limit,
      zli_construct(lengths, nlen),
      zli_construct(dlens, ndis),
    )
  }
}

// (status, pos, 0, 0) — stored blocks are byte-aligned
fn zli_stored(pos: Int, inp: Bytes, mut out: Bytes, limit: Int) -> (Int, Int, Int, Int) = {
  let len = int.bor(bytes.get(inp, pos) ?? 0, int.bshl(bytes.get(inp, pos + 1) ?? 0, 8))
  let nlen = int.bor(bytes.get(inp, pos + 2) ?? 0, int.bshl(bytes.get(inp, pos + 3) ?? 0, 8))
  let start = pos + 4
  // The payload bytes the input holds: native copies those before it stops
  // for more input, so they count against the output bound even when the
  // block is cut off.
  let held = int.max(0, int.min(len, bytes.len(inp) - start))
  // A length that fails its complement is corrupt; a payload past the output
  // bound exceeds it; a payload that runs past the input is truncation
  // (#2853) — native says `incomplete`, not `corrupt`.
  let status = if int.bxor(len, nlen) != 65535 then 0 - 1
  else if bytes.len(out) + held > limit then 0 - 3
  else if start + len > bytes.len(inp) then 0 - 2 else 0
  let n = if status != 0 then 0 else len
  var k = 0
  while k < n {
    bytes.push(out, bytes.get(inp, start + k) ?? 0)
    k = k + 1
  }
  (status, start + n, 0, 0)
}

// Inflate one DEFLATE stream starting at byte `pos`, `out` held to `limit`
// bytes; returns (status, pos of the first byte after it).
fn zli_inflate_stream(pos: Int, inp: Bytes, mut out: Bytes, limit: Int) -> (Int, Int) = {
  let flit = zli_fixed_lit()
  // All 32 fixed distance codes, 30 and 31 included: they are valid 5-bit
  // codes for invalid symbols (corrupt), not a code the decoder cannot finish
  // — with 30 entries, a 30/31 read on past the end and looked truncated.
  let fdist = zli_construct(list.repeat(5, 32), 32)
  let base = bytes.len(out)
  var p = pos
  var b = 0
  var c = 0
  var last = 0
  var status = 0
  while last == 0 and status == 0 {
    let (l, p1, b1, c1) = zli_bits(p, b, c, inp, 1)
    let (kind, p2, b2, c2) = zli_bits(p1, b1, c1, inp, 2)
    last = l
    let (s, p3, b3, c3) = match int.band(kind, 3) {
      0 => zli_stored(p2, inp, out, limit),
      1 => zli_codes(p2, b2, c2, inp, out, base, limit, flit, fdist),
      2 => zli_dynamic(p2, b2, c2, inp, out, base, limit),
      _ => (0 - 1, p2, b2, c2),
    }
    status = s
    p = p3
    b = b3
    c = c3
  }
  // zli_bits reads past the end as zero bytes; a stream that needed any of
  // them — to finish, or to reach the point where it failed — is truncated
  // (-2), the way native stops for more input and reports `incomplete deflate
  // stream` (#2853). Checked after the loop, it also covers every block kind.
  (if p > bytes.len(inp) then 0 - 2 else status, p)
}

fn zli_crc_table() -> List[Int] = {
  var t = list.repeat(0, 256)
  var n = 0
  while n < 256 {
    var cc = n
    var k = 0
    while k < 8 {
      cc = if int.band(cc, 1) == 1 then int.bxor(3988292384, int.bshr(cc, 1)) else int.bshr(cc, 1)
      k = k + 1
    }
    t[n] = cc
    n = n + 1
  }
  t
}

fn zli_crc32_from(t: List[Int], b: Bytes, start: Int) -> Int = {
  var cc = 4294967295
  var i = start
  let n = bytes.len(b)
  while i < n {
    cc = int.bxor(t[int.band(int.bxor(cc, bytes.get(b, i) ?? 0), 255)], int.bshr(cc, 8))
    i = i + 1
  }
  int.bxor(cc, 4294967295)
}

// Adler-32 over b[start..) — s1/s2 mod 65521, (s2 << 16) | s1.
fn zli_adler32_from(b: Bytes, start: Int) -> Int = {
  var s1 = 1
  var s2 = 0
  var i = start
  let n = bytes.len(b)
  while i < n {
    s1 = (s1 + bytes.get(b, i) ?? 0) % 65521
    s2 = (s2 + s1) % 65521
    i = i + 1
  }
  int.bor(int.bshl(s2, 16), s1)
}

fn zli_u32_le(b: Bytes, p: Int) -> Int = int.bor(
  int.bor(bytes.get(b, p) ?? 0, int.bshl(bytes.get(b, p + 1) ?? 0, 8)),
  int.bor(int.bshl(bytes.get(b, p + 2) ?? 0, 16), int.bshl(bytes.get(b, p + 3) ?? 0, 24)),
)

fn zli_skip_zstr(b: Bytes, p: Int) -> Int = if bytes.get(b, p) ?? 0 == 0 then p + 1 else zli_skip_zstr(
  b,
  p + 1,
)

// The bytes 31 139 8 a gzip member header opens with; `i` past 2 never matches.
fn zli_gzip_magic(i: Int) -> Int = match i {
  0 => 31,
  1 => 139,
  2 => 8,
  _ => 0 - 1,
}

// Whether the bytes of a header cut short at `inp`'s end still match the magic.
fn zli_magic_prefix(inp: Bytes, pos: Int, i: Int) -> Bool =
  if i >= 3 or pos + i >= bytes.len(inp) then true
  else if (bytes.get(inp, pos + i) ?? 0) != zli_gzip_magic(i) then false
  else zli_magic_prefix(inp, pos, i + 1)

// Where the deflate stream starts after the gzip member header at `pos`, or a
// negative failure (C-331, the same classes the native intrinsic reports):
// -1 an invalid header (magic, CM != 8, a reserved FLG bit), -2 a header the
// input ends inside, -3 an FHCRC that is not the header's CRC-32 low half.
fn zli_header_end(t: List[Int], inp: Bytes, pos: Int) -> Int = {
  let n = bytes.len(inp)
  if not zli_magic_prefix(inp, pos, 0) then 0 - 1
  else if pos + 10 > n then 0 - 2
  else {
    let flg = bytes.get(inp, pos + 3) ?? 0
    let p0 = pos + 10
    let p1 = if int.band(flg, 4) != 0 then p0 + 2 + int.bor(
      bytes.get(inp, p0) ?? 0,
      int.bshl(bytes.get(inp, p0 + 1) ?? 0, 8),
    )
    else p0
    let p2 = if int.band(flg, 8) != 0 then zli_skip_zstr(inp, p1) else p1
    let p3 = if int.band(flg, 16) != 0 then zli_skip_zstr(inp, p2) else p2
    let end = if int.band(flg, 2) != 0 then p3 + 2 else p3
    if int.band(flg, 224) != 0 then 0 - 1
    else if end > n then 0 - 2
    else if int.band(flg, 2) != 0 and int.band(
      zli_crc32_from(t, bytes.slice(inp, pos, p3), 0),
      65535,
    ) != int.bor(
      bytes.get(inp, p3) ?? 0,
      int.bshl(bytes.get(inp, p3 + 1) ?? 0, 8),
    ) then 0 - 3
    else end
  }
}

// gzip members back to back; returns 0 on success, else 1=invalid header,
// 2=corrupt deflate, 3=crc mismatch, 4=size mismatch, 5=empty input or a
// header/trailer cut off, 6=truncated deflate stream (#2853), 7=header crc
// mismatch, 8=output past `limit` (summed over the members). A gzip file has
// at least one member, so zero bytes is an error (#2478); whatever follows a
// member must be another member.
fn zli_gunzip_members(inp: Bytes, mut out: Bytes, limit: Int) -> Int = {
  let t = zli_crc_table()
  var pos = 0
  var code = if bytes.len(inp) == 0 then 5 else 0
  while pos < bytes.len(inp) and code == 0 {
    let start = zli_header_end(t, inp, pos)
    code = match start {
      -1 => 1,
      -2 => 5,
      -3 => 7,
      _ => {
        let member_start = bytes.len(out)
        let (status, after) = zli_inflate_stream(start, inp, out, limit)
        pos = after + 8
        if status == 0 - 2 then 6
        else if status == 0 - 3 then 8
        else if status != 0 then 2
        else if after + 8 > bytes.len(inp) then 5
        else if zli_crc32_from(t, out, member_start) != zli_u32_le(inp, after) then 3
        else if int.band(bytes.len(out) - member_start, 4294967295) != zli_u32_le(inp, after + 4) then 4 else 0
      },
    }
  }
  code
}

// The canonical decode failure texts (C-331) — the native intrinsics in
// runtime/rs/src/zlib.rs spell the same set; tests/zlib_decode_error_parity_test.rs
// pins both legs to it.
fn zli_gunzip_error(code: Int) -> String = match code {
  1 => "invalid gzip header",
  2 => "corrupt deflate stream",
  3 => "crc mismatch",
  5 => "unexpected end of file",
  6 => "incomplete deflate stream",
  7 => "header crc mismatch",
  _ => "size mismatch",
}

// The output bound of the default entry points (R-zlib-04): 256 MiB.
fn zli_default_limit() -> Int = 268435456

fn zli_exceeds(limit: Int) -> String = "zlib: output exceeds ${int.to_string(limit)} bytes"

// A caller's bound must be positive; anything else aborts the way native does
// (R-L0-33: a count the caller can check before calling).
fn zli_check_limit(func: String, max_len: Int) -> Unit =
  if max_len <= 0 then panic("zlib.${func}: max_len must be positive, got ${max_len}")
  else ()

fn zli_gunzip(data: Bytes, limit: Int) -> Result[Bytes, String] = {
  var out = bytes.zeros(0)
  let code = zli_gunzip_members(data, out, limit)
  if code == 0 then ok(out)
  else if code == 8 then err(zli_exceeds(limit))
  else err("zlib.gunzip: ${zli_gunzip_error(code)}")
}

fn zli_inflate(data: Bytes, limit: Int) -> Result[Bytes, String] = {
  var out = bytes.zeros(0)
  let (status, after) = zli_inflate_stream(0, data, out, limit)
  // A raw DEFLATE stream is the whole input: a byte after its final block is
  // refused, as a byte after a gzip member is (#4268).
  if status == 0 - 3 then err(zli_exceeds(limit))
  else if status == 0 - 2 then err("zlib.inflate: incomplete deflate stream")
  else if status != 0 then err("zlib.inflate: corrupt deflate stream")
  else if after < bytes.len(data) then err("zlib.inflate: trailing data after stream") else ok(out)
}

// A zlib header is CMF FLG: CM 8, CINFO <= 7, FCHECK making CMF*256+FLG a
// multiple of 31; FDICT is refused. An input cut off before the two header
// bytes or inside the Adler-32 trailer is `unexpected end of file`; a byte
// after the trailer is `trailing data after stream` (#4268).
fn zli_decompress(data: Bytes, limit: Int) -> Result[Bytes, String] = {
  let cmf = bytes.get(data, 0) ?? 0
  let flg = bytes.get(data, 1) ?? 0
  if bytes.len(data) < 2 then err("zlib.decompress: unexpected end of file")
  else if int.band(cmf, 15) != 8 or int.bshr(cmf, 4) > 7 or (cmf * 256 + flg) % 31 != 0 then err("zlib.decompress: invalid zlib header")
  else if int.band(flg, 32) != 0 then err("zlib.decompress: preset dictionary unsupported")
  else {
    var out = bytes.zeros(0)
    let (status, after) = zli_inflate_stream(2, data, out, limit)
    let stored = int.bor(
      int.bshl(bytes.get(data, after) ?? 0, 24),
      int.bor(
        int.bshl(bytes.get(data, after + 1) ?? 0, 16),
        int.bor(int.bshl(bytes.get(data, after + 2) ?? 0, 8), bytes.get(data, after + 3) ?? 0),
      ),
    )
    if status == 0 - 3 then err(zli_exceeds(limit))
    else if status == 0 - 2 then err("zlib.decompress: incomplete deflate stream")
    else if status != 0 then err("zlib.decompress: corrupt deflate stream")
    else if after + 4 > bytes.len(data) then err("zlib.decompress: unexpected end of file")
    else if zli_adler32_from(out, 0) != stored then err("zlib.decompress: adler32 mismatch")
    else if after + 4 < bytes.len(data) then err("zlib.decompress: trailing data after stream") else ok(out)
  }
}

// ── The stdlib entry points ──
fn zlib_gunzip(data: Bytes) -> Result[Bytes, String] = zli_gunzip(data, zli_default_limit())

fn zlib_inflate(data: Bytes) -> Result[Bytes, String] = zli_inflate(
  data,
  zli_default_limit(),
)

fn zlib_decompress(data: Bytes) -> Result[Bytes, String] = zli_decompress(
  data,
  zli_default_limit(),
)

@implements("zlib.gunzip_max")
fn zlib_gunzip_max(data: Bytes, max_len: Int) -> Result[Bytes, String] = {
  zli_check_limit("gunzip_max", max_len)
  zli_gunzip(data, max_len)
}

@implements("zlib.inflate_max")
fn zlib_inflate_max(data: Bytes, max_len: Int) -> Result[Bytes, String] = {
  zli_check_limit("inflate_max", max_len)
  zli_inflate(data, max_len)
}

@implements("zlib.decompress_max")
fn zlib_decompress_max(data: Bytes, max_len: Int) -> Result[Bytes, String] = {
  zli_check_limit("decompress_max", max_len)
  zli_decompress(data, max_len)
}
