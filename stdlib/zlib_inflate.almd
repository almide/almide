// zlib_inflate — SELF-HOSTED decompression half of `zlib` (#1700): raw DEFLATE
// (`zlib.inflate`), the zlib container (`zlib.decompress`, header + adler32),
// and gzip members (`zlib.gunzip`, header + crc32 + ISIZE) — the C-326 decoder
// (spec/wasm_cross/gzip_inflate_members.almd) promoted to stdlib. Native keeps
// the flate2 intrinsics as the oracle; DEFLATE decoding is exact, so success
// outputs are byte-identical across legs by construction. Error TEXTS are one
// canonical set per corrupt-input class (zli_gunzip_error and the literals in
// the entry points), which the native intrinsics spell too — flate2's io
// wording is not an API and is never surfaced (C-331).
//
// The output is bounded (R-L0-47, R-zlib-04, #4020): every decoder takes
// `limit`, the most bytes `out` may hold, and stops with status -3 where one
// more byte would pass it — `zlib: output exceeds <limit> bytes`, the text the
// native intrinsics spell. The default entry points pass 268435456 (256 MiB);
// the `_max` ones pass the caller's bound. A symbol read from bits past the
// end of the input is still truncation (-2) first, as on native, which never
// decodes it.
// (value, pos, buf, cnt)
fn zli_bits(pos: Int, buf: Int, cnt: Int, inp: Bytes, need: Int) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  while c < need {
    b = int.bor(b, int.bshl(bytes.get(inp, p) ?? 0, c))
    p = p + 1
    c = c + 8
  }
  (int.band(b, int.bshl(1, need) - 1), p, int.bshr(b, need), c - need)
}

// Huffman table packed in one list: [0..16) = count per length, [16..) = symbols by code.
fn zli_construct(lengths: List[Int], n: Int) -> List[Int] = {
  var count = list.repeat(0, 16)
  var i = 0
  while i < n {
    count[lengths[i]] = count[lengths[i]] + 1
    i = i + 1
  }
  var offs = list.repeat(0, 16)
  var len = 1
  while len < 15 {
    offs[len + 1] = offs[len] + count[len]
    len = len + 1
  }
  var symbol = list.repeat(0, n)
  i = 0
  while i < n {
    if lengths[i] != 0 then {
      symbol[offs[lengths[i]]] = i
      offs[lengths[i]] = offs[lengths[i]] + 1
    } else ()
    i = i + 1
  }
  count + symbol
}

// Whether `lengths[0..n)` is a code the native decoder accepts (#2853; the
// rule zlib's inftrees.c and miniz_oxide share). An over-subscribed code is
// always corrupt. An incomplete code is corrupt unless `sparse` allows it (the
// literal/length and distance tables may be incomplete when their longest
// code is at most 1 bit: an unused table or a lone 1-bit symbol). The
// code-length table must be complete. Without this check, a corrupted
// length table decoded to `ok` with garbage bytes where native reports
// `corrupt deflate stream`.
fn zli_code_ok(lengths: List[Int], n: Int, sparse: Bool) -> Bool = {
  var count = list.repeat(0, 16)
  var i = 0
  while i < n {
    count[lengths[i]] = count[lengths[i]] + 1
    i = i + 1
  }
  var left = 1
  var max_len = 0
  var len = 1
  while len < 16 {
    left = left * 2 - count[len]
    max_len = if count[len] > 0 then len else max_len
    len = len + 1
  }
  left == 0 or (left > 0 and sparse and max_len <= 1)
}

// (symbol or -1, pos, buf, cnt)
fn zli_decode(pos: Int, buf: Int, cnt: Int, inp: Bytes, h: List[Int]) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  var code = 0
  var first = 0
  var index = 0
  var len = 1
  var result = 0 - 1
  while len <= 15 and result < 0 {
    let (bit, p2, b2, c2) = zli_bits(p, b, c, inp, 1)
    p = p2
    b = b2
    c = c2
    code = int.bor(code, bit)
    let cnt_len = h[len]
    if code - cnt_len < first then {
      result = h[16 + index + (code - first)]
    } else {
      index = index + cnt_len
      first = int.bshl(first + cnt_len, 1)
      code = int.bshl(code, 1)
      len = len + 1
    }
  }
  (result, p, b, c)
}

fn zli_lbase() -> List[Int] = [
  3,
  4,
  5,
  6,
  7,
  8,
  9,
