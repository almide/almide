// zlib_inflate — SELF-HOSTED decompression half of `zlib` (#1700): raw DEFLATE
// (`zlib.inflate`), the zlib container (`zlib.decompress`, header + adler32),
// and gzip members (`zlib.gunzip`, header + crc32 + ISIZE) — the C-326 decoder
// (spec/wasm_cross/gzip_inflate_members.almd) promoted to stdlib. Native keeps
// the flate2 intrinsics as the oracle; DEFLATE decoding is exact, so success
// outputs are byte-identical across legs by construction. Error TEXTS name the
// entry point and the failure the way the decoder saw it (flate2's io wording
// is not reproduced — the cross-target promise is bounded to success bytes and
// the err/ok SPLIT, C-330).
// (value, pos, buf, cnt)
fn zli_bits(pos: Int, buf: Int, cnt: Int, inp: Bytes, need: Int) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  while c < need {
    b = int.bor(b, int.bshl(bytes.get_or(inp, p, 0), c))
    p = p + 1
    c = c + 8
  }
  (int.band(b, int.bshl(1, need) - 1), p, int.bshr(b, need), c - need)
}

// Huffman table packed in one list: [0..16) = count per length, [16..) = symbols by code.
fn zli_construct(lengths: List[Int], n: Int) -> List[Int] = {
  var count = list.repeat(0, 16)
  var i = 0
  while i < n {
    count[lengths[i]] = count[lengths[i]] + 1
    i = i + 1
  }
  var offs = list.repeat(0, 16)
  var len = 1
  while len < 15 {
    offs[len + 1] = offs[len] + count[len]
    len = len + 1
  }
  var symbol = list.repeat(0, n)
  i = 0
  while i < n {
    if lengths[i] != 0 then {
      symbol[offs[lengths[i]]] = i
      offs[lengths[i]] = offs[lengths[i]] + 1
    } else ()
    i = i + 1
  }
  count + symbol
}

// (symbol or -1, pos, buf, cnt)
fn zli_decode(pos: Int, buf: Int, cnt: Int, inp: Bytes, h: List[Int]) -> (Int, Int, Int, Int) = {
  var p = pos
  var b = buf
  var c = cnt
  var code = 0
  var first = 0
  var index = 0
  var len = 1
  var result = 0 - 1
  while len <= 15 and result < 0 {
    let (bit, p2, b2, c2) = zli_bits(p, b, c, inp, 1)
    p = p2
    b = b2
    c = c2
    code = int.bor(code, bit)
    let cnt_len = h[len]
    if code - cnt_len < first then {
      result = h[16 + index + (code - first)]
    } else {
      index = index + cnt_len
      first = int.bshl(first + cnt_len, 1)
      code = int.bshl(code, 1)
      len = len + 1
    }
  }
  (result, p, b, c)
}

