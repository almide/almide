// list_sort_float — SELF-HOSTED `list.sort` over a List[Float], ordered by IEEE-754 totalOrder
// (the ordering twin of f64::total_cmp): -0.0 < +0.0, NaN is the greatest (after +inf), negatives
// sort by magnitude-with-sign. The plain list.sort compares the i64 SLOT bits with SIGNED-int `<`,
// which is garbage for f64 patterns. Here each slot's raw f64 bits are mapped to a MONOTONE i64 key
//   key = bits ^ ((bits >>_s 63) >>_u 1)
// (arithmetic shift broadcasts the sign, logical shift drops the sign bit, XOR flips the lower 63
// bits of a negative) and the keys are compared as signed i64 = totalOrder. The STORED elements stay
// the original f64 bits — only the comparison key is transformed. Stable bottom-up mergesort (#1459); List[Float] only.
fn __ftotal_sf(b: Int) -> Int = {
  let s = prim.bshr(b, 63)
  let m = prim.bshr_u(s, 1)
  prim.bxor(b, m)
}

fn __sortf_load(h: Int, i: Int) -> Int = prim.load64(h + 12 + i * 8)

// ── stable bottom-up mergesort by the monotone totalOrder key (#1459):
// O(n log n) in place of the O(n^2) selection scan. The key transform is
// applied per comparison; the stored slots stay the original f64 bits.
fn __sortf_mrun(srch: Int, dsth: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
    else if i >= mid then false
    else __ftotal_sf(__sortf_load(srch, i)) <= __ftotal_sf(__sortf_load(srch, j))
  if takel then {
    prim.store64(dsth + 12 + k * 8, __sortf_load(srch, i))
    __sortf_mrun(srch, dsth, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dsth + 12 + k * 8, __sortf_load(srch, j))
    __sortf_mrun(srch, dsth, mid, hi, i, j + 1, k + 1)
  }
}

fn __sortf_mpass(srch: Int, dsth: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __sortf_mrun(srch, dsth, mid, hi, lo, mid, lo)
  __sortf_mpass(srch, dsth, n, width, lo + width * 2)
}

fn __sortf_mrounds(curh: Int, othh: Int, n: Int, width: Int) -> Int = if width >= n then curh
else {
  let _p = __sortf_mpass(curh, othh, n, width, 0)
  __sortf_mrounds(othh, curh, n, width * 2)
}

fn __sortf_copy(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(srch + 12 + i * 8)
  prim.store64(dsth + 12 + i * 8, e)
  __sortf_copy(srch, dsth, n, i + 1)
}

fn list_sort_float(xs: List[Float]) -> List[Float] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let buf = prim.alloc_list_f64(n)
  let bh = prim.handle(buf)
  let _c = __sortf_copy(h, bh, n, 0)
  let tmp = prim.alloc_list_f64(n)
  let th = prim.handle(tmp)
  let fin = __sortf_mrounds(bh, th, n, 1)
  let _cb = if fin == bh then 0 else __sortf_copy(fin, bh, n, 0)
  buf
}
