// int_rotate — SELF-HOSTED `int.rotate_left` / `int.rotate_right` over the bitwise prim
// floor. The register is the 64 bits of `a` (R-int-12): the count is reduced into
// [0, 64), the value is shifted left and right as a u64 (logical shr via prim.bshr_u)
// and the halves are ORed. Byte-exact with native `u64::rotate_left`. Pure scalar —
// cert untouched.
//
// The count is reduced EUCLIDEAN-ly into [0, 64), like native `n.rem_euclid(64)`, so a
// negative count rotates the other way (#2492: `n % bits` kept the sign, and a negative
// shift amount made every negative count return 0).
fn __rotate_count(n: Int) -> Int = {
  let r = n % 64
  if r < 0 then r + 64 else r
}

fn int_rotate_left(a: Int, n: Int) -> Int = {
  let nn = __rotate_count(n)
  if nn == 0 then a else prim.bor(prim.bshl(a, nn), prim.bshr_u(a, 64 - nn))
}

fn int_rotate_right(a: Int, n: Int) -> Int = {
  let nn = __rotate_count(n)
  if nn == 0 then a else prim.bor(prim.bshr_u(a, nn), prim.bshl(a, 64 - nn))
}
