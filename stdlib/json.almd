// json — the FORMAT over the `value.*` data model: parse / stringify /
// stringify_pretty, the json-branded path API, and the typed-key
// conveniences. Constructors and accessors live on `value.*` — the second
// names (`json.null`, `json.as_int`, `value.get`, …) were dropped after
// their one-release E040 deprecation window (#1078); every fn on this
// surface has exactly one name. Runtime impls stay in `runtime/rs/src/json.rs`;
// `JsonPath` is the opaque path-traversal nominal type.
//
// Runtime ABI — `j: &Value`, `key: &str`, `path: &AlmideJsonPath`, etc.
// `set_path` returns `Result[Value, String]`, so callers propagate via
// `!` / `?` / match.
@intrinsic("almide_rt_json_parse")
fn parse(text: String) -> Result[Value, String] = _

@intrinsic("almide_rt_json_stringify")
fn stringify(v: Value) -> String = _

@intrinsic("almide_json_stringify_pretty")
fn stringify_pretty(j: Value) -> String = _

// ── key-based typed extraction ──
@intrinsic("almide_json_get_string")
fn get_string(j: Value, key: String) -> Option[String] = _

@intrinsic("almide_json_get_int")
fn get_int(j: Value, key: String) -> Option[Int] = _

@intrinsic("almide_json_get_float")
fn get_float(j: Value, key: String) -> Option[Float] = _

@intrinsic("almide_json_get_bool")
fn get_bool(j: Value, key: String) -> Option[Bool] = _

@intrinsic("almide_json_get_array")
fn get_array(j: Value, key: String) -> Option[List[Value]] = _

// ── path API ──
@intrinsic("almide_rt_json_root")
fn root() -> JsonPath = _

@intrinsic("almide_rt_json_field")
fn field(path: JsonPath, name: String) -> JsonPath = _

@intrinsic("almide_rt_json_index")
fn index(path: JsonPath, i: Int) -> JsonPath = _

@intrinsic("almide_json_get_path")
@borrow_ref(path)
fn get_path(j: Value, path: JsonPath) -> Option[Value] = _

@intrinsic("almide_json_set_path")
@borrow_ref(path)
@consume(value)
fn set_path(j: Value, path: JsonPath, value: Value) -> Result[Value, String] = _

@intrinsic("almide_json_remove_path")
@borrow_ref(path)
fn remove_path(j: Value, path: JsonPath) -> Value = _

@intrinsic("almide_json_to_map")
fn to_map(j: Value) -> Option[Map[String, String]] = _
