// process_wasm — the WASM lowering of the subprocess family (#2589,
// ADR-0025). Native keeps its direct intrinsics (runtime/rs/src/process.rs);
// this file only ever links on the wasm legs through the self-host registry.
//
// Every operation is one call of the private `almide:process/spawn`
// capability: an op (the `__proc_*` leaf, host op 80..=90 in WIT `enum op`
// order), two text operands, and an ok(text) / err(text) answer. The embedded
// host serves it with the SAME core native runs
// (crates/almide-rt-core/src/process_core.rs), so the captured text, the exit
// code and every err string agree with native by construction. A stock
// artifact carries the import and a stock runtime refuses it at load.
//
// Operand frames reuse http_framed's decimal CHAR-length cells
// (`<string.len>\n<payload>`), parsed by the host with the same char
// arithmetic: the argument list is one cell per argument, and the settings
// `output` and `run` need past two operands (the deadline, directory, stdin
// text, command) go in the first cells.
import process

fn __proc_cell(s: String) -> String = "${string.len(s)}\n${s}"

// The registry-linked String join, not the protocol-generic `list.join[T: Text]`:
// a self-host splice links after monomorphization, so a generic call here
// resolves only when the entry program itself happens to load `list`.
fn __proc_argv(args: List[String]) -> String = args |> list.map((a) => __proc_cell(a)) |> list.__join_string("")

effect fn __proc_exec(cmd: String, argv: String) -> Result[String, String] = _

// a = cmd, b = [timeout_ms, dir, stdin] ++ argv (op 84, `output`).
effect fn __proc_output(cmd: String, argv: String) -> Result[String, String] = _

// a = dir, b = [cmd, stdin, timeout_ms] ++ argv (op 90, `run`).
effect fn __proc_run_cmd(dir: String, argv: String) -> Result[String, String] = _

effect fn __proc_kill(pid: String, signal: String) -> Result[String, String] = _

// `pid` keeps a plain leaf: its impl returns the raw type at the call site,
// as http_call's non-blocking leaves do. The work is still the host's.
fn __proc_pid(unused: String, unused2: String) -> Result[String, String] = _

// The status answer is `<code>\n<stdout chars>\n<stdout><stderr>`: the code
// line, the stdout length line, then the two texts back to back.
fn __proc_status(f: String) -> ProcessStatus = {
  let c1 = string.index_of(f, "\n") ?? 0
  let rest = string.drop(f, c1 + 1)
  let c2 = string.index_of(rest, "\n") ?? 0
  let n = int.parse(string.take(rest, c2)) ?? 0
  let body = string.drop(rest, c2 + 1)
  ProcessStatus {
    code: int.parse(string.take(f, c1)) ?? -1,
    stdout: string.take(body, n),
    stderr: string.drop(body, n),
  }
}

effect fn __process_exec_impl(cmd: String, args: List[String]) -> Result[String, String] = __proc_exec(
  cmd,
  __proc_argv(args),
)

effect fn __process_output_impl(cmd: String, args: List[String], dir: String, stdin: String, timeout_ms: Int) -> Result[ProcessStatus, String] = {
  let f = __proc_output(cmd, __proc_argv([int.to_string(timeout_ms), dir, stdin] + args))!
  ok(__proc_status(f))
}

effect fn __process_run_impl(cmd: String, args: List[String], dir: String, stdin: String, timeout_ms: Int) -> Result[Int, String] = {
  let code = __proc_run_cmd(dir, __proc_argv([cmd, stdin, int.to_string(timeout_ms)] + args))!
  ok(int.parse(code) ?? -1)
}

effect fn __process_kill_impl(pid: Int, signal: Int) -> Result[Unit, String] = {
  let _ = __proc_kill(int.to_string(pid), int.to_string(signal))!
  ok(())
}

fn __process_pid_impl() -> Int = match __proc_pid("", "") {
  ok(p) => int.parse(p) ?? -1,
  _ => -1,
}

// ── The `start` child (R-process-03, #4308) ──
//
// A started child is a host resource: the host keeps it in its own table —
// the pipes its workers drain, the deadline, what was read so far — and the
// guest holds only its handle, carried as decimal text in a. The host runs
// native's child core on it (`AlmideProcChild`), so every outcome, read and
// err string is native's. The ops follow `run-with` in the WIT `enum op`.
// a = cmd, b = [timeout_ms, dir, stdin] ++ argv (op 146); ok = the handle.
effect fn __proc_start(cmd: String, argv: String) -> Result[String, String] = _

// ok = `1` once the child's outcome is in, else `0` (op 147).
effect fn __proc_poll(h: String, unused: String) -> Result[String, String] = _

// Blocks until the outcome (op 148); ok = the status answer.
effect fn __proc_wait(h: String, unused: String) -> Result[String, String] = _

// b = grace_ms (op 149); ok = the status answer.
effect fn __proc_stop(h: String, grace_ms: String) -> Result[String, String] = _

// The two non-blocking reads keep plain leaves, as `pid` does: their
// surfaces are called with the raw type at the site. b = `1` stdout, `2`
// stderr (op 150); op 151 answers the child's pid.
fn __proc_read_new(h: String, which: String) -> Result[String, String] = _

fn __proc_child_pid(h: String, unused: String) -> Result[String, String] = _

@implements("process.__os_start")
effect fn __process_start_impl(cmd: String, args: List[String], dir: String, stdin: String, timeout_ms: Int) -> Result[Int, String] = {
  let h = __proc_start(cmd, __proc_argv([int.to_string(timeout_ms), dir, stdin] + args))!
  ok(int.parse(h) ?? -1)
}

@implements("process.__os_poll")
effect fn __process_poll_impl(h: Int) -> Result[Bool, String] = {
  let t = __proc_poll(int.to_string(h), "")!
  ok(t == "1")
}

@implements("process.__os_wait")
effect fn __process_wait_impl(h: Int) -> Result[ProcessStatus, String] = {
  let f = __proc_wait(int.to_string(h), "")!
  ok(__proc_status(f))
}

@implements("process.__os_stop")
effect fn __process_stop_impl(h: Int, grace_ms: Int) -> Result[ProcessStatus, String] = {
  let f = __proc_stop(int.to_string(h), int.to_string(grace_ms))!
  ok(__proc_status(f))
}

@implements("process.__os_read_new")
fn __process_read_new_impl(h: Int, which: Int) -> String = __proc_read_new(
  int.to_string(h),
  int.to_string(which),
) ?? ""

@implements("process.__os_child_pid")
fn __process_child_pid_impl(h: Int) -> Int = match __proc_child_pid(int.to_string(h), "") {
  ok(p) => int.parse(p) ?? -1,
  _ => -1,
}
