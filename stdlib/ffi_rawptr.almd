// ffi_rawptr — SELF-HOSTED `ffi` over the linear-memory floor (R-ffi-01, #440, C-062).
//
// An address is the RAW ADDRESS of a Bytes DATA region (handle + 12, an i32
// offset on wasm, never a tracked handle). An EMPTY buffer has no data region,
// so `ffi.address` is null (0) — the native oracle answers the same, so
// `ffi.to_int(ffi.address(bytes.new(0)))` is 0 on both targets. Null moves
// nothing on either target. Address arithmetic runs on Int via the identity
// prim casts. Mirrors stdlib/bytes_rawptr.almd, which keeps the deprecated
// `bytes` spellings until epoch 16 removes them.
@implements("ffi.address")
fn ffi_address(b: Bytes) -> RawPtr = {
  let h = prim.handle(b)
  if prim.load32(h + 4) == 0 then prim.int_to_ptr(0) else prim.int_to_ptr(h + 12)
}

@implements("ffi.to_int")
fn ffi_to_int(p: RawPtr) -> Int = prim.ptr_to_int(p)

fn __ffi_copy(dst: Int, src: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store8(dst + i, prim.load8(src + i))
  __ffi_copy(dst, src, n, i + 1)
}

// NULL / non-positive guards mirror the native oracle exactly
// (`if ptr.is_null() || len <= 0 { return Vec::new(); }`).
@implements("ffi.read")
fn ffi_read(ptr: RawPtr, len: Int) -> Bytes = {
  let src = prim.ptr_to_int(ptr)
  if src == 0 or len <= 0 then prim.alloc_bytes(0)
  else {
    let out = prim.alloc_bytes(len)
    let oh = prim.handle(out)
    let _c = __ffi_copy(oh + 12, src, len, 0)
    out
  }
}

// `cap` is an UNSIGNED capacity, matching the native oracle's
// `b.len().min(cap as usize)`: a NEGATIVE cap saturates to the whole buffer
// (the C-034 unsigned-count rule).
@implements("ffi.write")
fn ffi_write(ptr: RawPtr, b: Bytes, cap: Int) -> Int = {
  let dst = prim.ptr_to_int(ptr)
  let h = prim.handle(b)
  let len = if dst == 0 then 0 else prim.load32(h + 4)
  let capped = if cap < 0 then len else cap
  let n = if len < capped then len else capped
  let _c = __ffi_copy(dst, h + 12, n, 0)
  n
}
