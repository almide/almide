// list_flatmap — SELF-HOSTED `list.flat_map` for v1 over the heap-returning closure machinery.
// f: (Int) -> List[Int] ($closure_fn1_h) maps each element to a sublist; the result is their
// concatenation. Two passes (the result length is unknown up front): pass 1 sums the sublist
// lengths, pass 2 copies each sublist's elements into the over-allocated buffer. Each pass's
// per-element work lives in a __step fn so the owned sublist `sub` is dropped on RETURN —
// before the next element — keeping only ONE sublist live (O(1)). A pure f is called twice
// (vs v0's once) — same RESULT. List[Int]; source borrowed; result owned.
fn __flm_len_step(sh: Int, f: (Int) -> List[Int], i: Int) -> Int = {
  let x = prim.load64(sh + 12 + i * 8)
  let sub = f(x)
  let subh = prim.handle(sub)
  prim.load32(subh + 4)
}

fn __flm_total(sh: Int, f: (Int) -> List[Int], n: Int, i: Int, acc: Int) -> Int = if i >= n then acc
else {
  let s = __flm_len_step(sh, f, i)
  __flm_total(sh, f, n, i + 1, acc + s)
}

fn __flm_copy(dh: Int, subh: Int, sublen: Int, j: Int, di: Int) -> Int = if j >= sublen then di
else {
  let e = prim.load64(subh + 12 + j * 8)
  prim.store64(dh + 12 + di * 8, e)
  __flm_copy(dh, subh, sublen, j + 1, di + 1)
}

fn __flm_fill_step(dh: Int, sh: Int, f: (Int) -> List[Int], i: Int, di: Int) -> Int = {
  let x = prim.load64(sh + 12 + i * 8)
  let sub = f(x)
  let subh = prim.handle(sub)
  let sublen = prim.load32(subh + 4)
  __flm_copy(dh, subh, sublen, 0, di)
}

fn __flm_fill(dh: Int, sh: Int, f: (Int) -> List[Int], n: Int, i: Int, di: Int) -> Int = if i >= n then di
else {
  let ndi = __flm_fill_step(dh, sh, f, i, di)
  __flm_fill(dh, sh, f, n, i + 1, ndi)
}

fn list_flat_map(xs: List[Int], f: (Int) -> List[Int]) -> List[Int] = {
  let n = list.len(xs)
  let total = __flm_total(prim.handle(xs), f, n, 0, 0)
  let buf = prim.alloc_list(total)
  let _x = __flm_fill(prim.handle(buf), prim.handle(xs), f, n, 0, 0)
  buf
}

// list_flat_map_str — the REPR-POLY heap twin (#1519): result element String
// (source element ANY handle repr — a record source rides the same i32 slot,
// the closure knows its true type). The scalar body above raw-copies element
// slots, which under-owns an ALIASED sublist (a closure returning the
// element's own List field: source and result co-referenced each String
// un-owned — the scope-end rc_dec double-free the issue's trap shows). Same
// discipline as list_filter_str: each copied element is DEEP-COPIED
// (string.repeat ·1) into the result so it is single-owned; the sublist
// itself is a typed List[String] local, freed by the normal recursive drop
// whether fresh or aliased. Two passes like the scalar body; a pure f is
// called twice with the same result.
fn __flmstr_len_step(sh: Int, f: (String) -> List[String], i: Int) -> Int = {
  let x = prim.load_str(sh + 12 + i * 8)
  let sub = f(x)
  list.len(sub)
}

fn __flmstr_total(sh: Int, f: (String) -> List[String], n: Int, i: Int, acc: Int) -> Int = if i >= n then acc
else {
  let s = __flmstr_len_step(sh, f, i)
  __flmstr_total(sh, f, n, i + 1, acc + s)
}

fn __flmstr_copy(dh: Int, sub: List[String], sublen: Int, j: Int, di: Int) -> Int = if j >= sublen then di
else {
  let e = list.get(sub, j) ?? ""
  let copy = string.repeat(e, 1)
  prim.store_str(dh + 12 + di * 8, copy)
  __flmstr_copy(dh, sub, sublen, j + 1, di + 1)
}

fn __flmstr_fill_step(dh: Int, sh: Int, f: (String) -> List[String], i: Int, di: Int) -> Int = {
  let x = prim.load_str(sh + 12 + i * 8)
  let sub = f(x)
  __flmstr_copy(dh, sub, list.len(sub), 0, di)
}

fn __flmstr_fill(dh: Int, sh: Int, f: (String) -> List[String], n: Int, i: Int, di: Int) -> Int = if i >= n then di
else {
  let ndi = __flmstr_fill_step(dh, sh, f, i, di)
  __flmstr_fill(dh, sh, f, n, i + 1, ndi)
}

fn list_flat_map_str(xs: List[String], f: (String) -> List[String]) -> List[String] = {
  let n = list.len(xs)
  let total = __flmstr_total(prim.handle(xs), f, n, 0, 0)
  let buf = prim.alloc_list_str(total)
  let _x = __flmstr_fill(prim.handle(buf), prim.handle(xs), f, n, 0, 0)
  prim.store32(prim.handle(buf) + 4, total)
  buf
}

// list_flat_map_h — the GENERIC heap-element twin (#1519's second half): any
// heap element class (records, nested lists, variants; String rides _str
// above). SHARE-copy discipline: each spliced element handle is rc_inc'd
// into the result, and the sublist local's rc-GATED shallow sweep (the
// List[String]-typed drop: one rc_dec per slot, only at rc==1) releases the
// sublist's own element refs exactly when it was fresh — an aliased sublist
// (rc>=2) keeps its elements shared between source and result, each side
// releasing its own ref at scope end. No element ever frees inside the
// twin (fresh: 1 -> inc 2 -> sweep 1; aliased: 1 -> inc 2, no sweep), so
// the caller's typed recursive result-drop is the single point of deep
// free, whatever the element class.
fn __flmh_len_step(sh: Int, f: (String) -> List[String], i: Int) -> Int = {
  let x = prim.load_str(sh + 12 + i * 8)
  let sub = f(x)
  list.len(sub)
}

fn __flmh_total(sh: Int, f: (String) -> List[String], n: Int, i: Int, acc: Int) -> Int = if i >= n then acc
else {
  let s = __flmh_len_step(sh, f, i)
  __flmh_total(sh, f, n, i + 1, acc + s)
}

fn __flmh_copy_step(dh: Int, subh: Int, j: Int, di: Int) -> Int = {
  let e = prim.load64(subh + 12 + j * 8)
  prim.rc_inc(e)
  prim.store64(dh + 12 + di * 8, e)
  0
}

fn __flmh_copy(dh: Int, subh: Int, sublen: Int, j: Int, di: Int) -> Int = if j >= sublen then di
else {
  let _s = __flmh_copy_step(dh, subh, j, di)
  __flmh_copy(dh, subh, sublen, j + 1, di + 1)
}

fn __flmh_fill_step(dh: Int, sh: Int, f: (String) -> List[String], i: Int, di: Int) -> Int = {
  let x = prim.load_str(sh + 12 + i * 8)
  let sub = f(x)
  __flmh_copy(dh, prim.handle(sub), list.len(sub), 0, di)
}

fn __flmh_fill(dh: Int, sh: Int, f: (String) -> List[String], n: Int, i: Int, di: Int) -> Int = if i >= n then di
else {
  let ndi = __flmh_fill_step(dh, sh, f, i, di)
  __flmh_fill(dh, sh, f, n, i + 1, ndi)
}

fn list_flat_map_h(xs: List[String], f: (String) -> List[String]) -> List[String] = {
  let n = list.len(xs)
  let total = __flmh_total(prim.handle(xs), f, n, 0, 0)
  let buf = prim.alloc_list_str(total)
  let _x = __flmh_fill(prim.handle(buf), prim.handle(xs), f, n, 0, 0)
  prim.store32(prim.handle(buf) + 4, total)
  buf
}
