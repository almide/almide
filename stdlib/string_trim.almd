// string_trim — SELF-HOSTED `string.trim` / `trim_start` / `trim_end` for v1
// NORMATIVE SPEC: ALS-T1 (docs/specs/als/text-and-numbers.md §T1) — conformance is judged against that section's
// rules and its pinned fixture, NOT against any other implementation (F1: no oracle circularity).
// over the prim floor. Trims the full Unicode White_Space set (the 25
// codepoints of Rust's `char::is_whitespace` — the native oracle `str::trim*`),
// decoding UTF-8 at the boundaries only; the middle is byte-copied verbatim.
// (The first version was ASCII-only and left U+00A0/U+3000 etc. in place —
// the C-021 divergence on the render_program path.) Self-contained helpers.
// Decode the UTF-8 codepoint starting at `addr` → codepoint * 4 + (byte length - 1),
// ONE Int: a tuple here was a heap block per scanned codepoint, and the
// structural leg has no drop glue for tuples yet (#2005 / #2010) — 64 B
// leaked per `string.trim` call. `__trim_cp_of` / `__trim_cp_len` unpack.
fn __trim_cp(addr: Int) -> Int = {
  let b0 = prim.load8(addr)
  if b0 < 128 then b0 * 4
  else if b0 < 224 then ((b0 - 192) * 64 + (prim.load8(addr + 1) - 128)) * 4 + 1
  else if b0 < 240 then ((b0 - 224) * 4096 + (prim.load8(addr + 1) - 128) * 64 + (prim.load8(addr + 2) - 128)) * 4 + 2 else ((b0 - 240) * 262144 + (prim.load8(addr + 1) - 128) * 4096 + (prim.load8(addr + 2) - 128) * 64 + (prim.load8(addr + 3) - 128)) * 4 + 3
}

fn __trim_cp_of(packed: Int) -> Int = packed / 4

fn __trim_cp_len(packed: Int) -> Int = packed % 4 + 1

// The byte index where the codepoint containing byte `i` begins: step back
// over UTF-8 continuation bytes (0b10xxxxxx = 128..191).
fn __trim_cp_begin(start: Int, i: Int) -> Int = if i <= start then start
else {
  let b = prim.load8(i)
  if b >= 128 and b < 192 then __trim_cp_begin(start, i - 1) else i
}

// Unicode White_Space (char::is_whitespace): TAB..CR, SPACE, NEL, NBSP, OGHAM,
// U+2000..200A, LINE/PARA SEPARATOR, NNBSP, MMSP, IDEOGRAPHIC SPACE.
fn __trim_is_uws(c: Int) -> Bool = if c == 32 then true
else if c >= 9 and c <= 13 then true
else if c == 133 then true
else if c == 160 then true
else if c == 5760 then true
else if c >= 8192 and c <= 8202 then true
else if c == 8232 then true
else if c == 8233 then true
else if c == 8239 then true
else if c == 8287 then true
else if c == 12288 then true else false

// An ASCII byte of White_Space: TAB..CR or SPACE. Every other ASCII byte is
// not, and a byte >= 128 starts (or continues) a multi-byte codepoint.
fn __trim_ascii_ws(b: Int) -> Bool = b == 32 or (b >= 9 and b <= 13)

// First non-WS byte address scanning forward from `addr` (codepoint steps).
// An ASCII byte is judged by itself; only a multi-byte codepoint is decoded.
fn __trim_start(addr: Int, end: Int) -> Int = if addr >= end then addr
else {
  let b = prim.load8(addr)
  if b < 128 then (if __trim_ascii_ws(b) then __trim_start(addr + 1, end) else addr)
  else {
    let packed = __trim_cp(addr)
    if __trim_is_uws(__trim_cp_of(packed)) then __trim_start(addr + __trim_cp_len(packed), end) else addr
  }
}

// Address just past the last non-WS codepoint scanning backward from `end`.
fn __trim_end(start: Int, end: Int) -> Int = if end <= start then end
else {
  let b = prim.load8(end - 1)
  if b < 128 then (if __trim_ascii_ws(b) then __trim_end(start, end - 1) else end)
  else {
    let cb = __trim_cp_begin(start, end - 1)
    if __trim_is_uws(__trim_cp_of(__trim_cp(cb))) then __trim_end(start, cb) else end
  }
}

// Copy `len` bytes from `src` to `dst`, eight at a time while eight remain.
// Front to back, so `dst <= src` may overlap: every word is read before the
// write that could reach it.
fn __trim_copy(src: Int, dst: Int, len: Int) -> Int = {
  var i = 0
  while i + 8 <= len {
    prim.store64(dst + i, prim.load64(src + i))
    i = i + 8
  }
  while i < len {
    prim.store8(dst + i, prim.load8(src + i))
    i = i + 1
  }
  dst + len
}

// The registry's prim body owns its parameter, so a sole owner (rc 1) may
// be trimmed in place: its bytes move to the front and its length shrinks.
// A pooled literal also carries rc 1 but always cap = len, so spare capacity
// is required too, as `string.to_upper` requires it (string_to_upper.almd).
// Each trim judges its own parameter in its own body: handed to a helper,
// the parameter would carry the helper's credit too and never read as sole.
fn __trim_sole(h: Int, blen: Int) -> Bool = prim.load32(h) == 1 and prim.load32(h + 8) > blen

// The bytes `from`..`from + nbytes` as a new string.
fn __trim_copied(from: Int, nbytes: Int) -> String = {
  let buf = prim.alloc_str(nbytes)
  let _e = __trim_copy(from, prim.handle(buf) + 12, nbytes)
  buf
}

// All of `s` is `s` itself; a sole owner keeps its block; anything else is
// copied out. The ASCII ends are scanned here, in the body, byte by byte; an
// end that is a multi-byte codepoint goes through the decoding scanners.
fn string_trim(s: String) -> String = {
  let h = prim.handle(s)
  let blen = prim.load32(h + 4)
  let base = h + 12
  let end = base + blen
  var a = base
  while a < end {
    let b = prim.load8(a)
    if b != 32 and (b < 9 or b > 13) then break
    else ()
    a = a + 1
  }
  let ws_start = if a < end and prim.load8(a) >= 128 then __trim_start(a, end) else a
  var z = end
  while z > ws_start {
    let b = prim.load8(z - 1)
    if b != 32 and (b < 9 or b > 13) then break
    else ()
    z = z - 1
  }
  let ws_end = if z > ws_start and prim.load8(z - 1) >= 128 then __trim_end(ws_start, z) else z
  let nbytes = ws_end - ws_start
  if nbytes == blen then s
  else if prim.load32(h) == 1 and prim.load32(h + 8) > blen then {
    let _e = __trim_copy(ws_start, base, nbytes)
    prim.store32(h + 4, nbytes)
    s
  } else __trim_copied(ws_start, nbytes)
}

// Strip Unicode whitespace from the START only (leading), keeping the remainder.
fn string_trim_start(s: String) -> String = {
  let h = prim.handle(s)
  let blen = prim.load32(h + 4)
  let base = h + 12
  let end = base + blen
  let ws_start = __trim_start(base, end)
  let nbytes = end - ws_start
  if nbytes == blen then s
  else if __trim_sole(h, blen) then {
    let _e = __trim_copy(ws_start, base, nbytes)
    prim.store32(h + 4, nbytes)
    s
  } else __trim_copied(ws_start, nbytes)
}

// Strip Unicode whitespace from the END only (trailing), keeping the prefix:
// a sole owner only shortens its length.
fn string_trim_end(s: String) -> String = {
  let h = prim.handle(s)
  let blen = prim.load32(h + 4)
  let base = h + 12
  let nbytes = __trim_end(base, base + blen) - base
  if nbytes == blen then s
  else if __trim_sole(h, blen) then {
    prim.store32(h + 4, nbytes)
    s
  } else __trim_copied(base, nbytes)
}
