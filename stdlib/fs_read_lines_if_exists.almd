// fs_read_lines_if_exists — SELF-HOSTED `fs.read_lines_if_exists(path)` for the
// wasm leg: missing file → `Ok(none)` (native maps NotFound), present → the
// read floor + the self-hosted string.lines splitter into `Ok(some(lines))`,
// any other read error keeps the err channel — the read_text_if_exists pattern
// with the fs_read_lines composition. Reaching both floors carries
// Capability::FsRead.
effect fn fs_read_lines_if_exists(path: String) -> Result[List[String]?, String] = {
  if prim.path_exists(path) then {
    let r: Result[String, String] = prim.read_text_file(path)
    let rh = prim.handle(r)
    if prim.load32(rh + 16) != 0 then {
      let m: String = prim.load_handle(rh + 12)
      err(m)
    } else {
      let t: String = prim.load_handle(rh + 12)
      let lines = string.lines(t)
      ok(some(lines))
    }
  } else ok(none)
}
