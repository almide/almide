// url — CORE-TIER pure URL handling (RFC 3986-lite).
//
// First module authored under the stdlib-excellence constitution
// (STDLIB-EXCELLENCE.md, SD1–SD3): pure algorithms only, family-complete
// (parse ⇄ to_string, encode ⇄ decode, query_pairs ⇄ build_query), no
// panicking variants — parse/decode failures are Results with reasons
// (the int.parse precedent), and every public fn carries an evaluable
// `// Example:` line executed by the interpreter examples harness.
//
// Scope (documented limits, not accidents): schemes with an authority only
// (`scheme://…`); no userinfo, no IPv6 bracket hosts, no punycode.
// Where a browser could read a URL as pointing somewhere else, parse and
// resolve read it as the WHATWG URL parser does or refuse it (ALS-T27,
// C-402 / C-403, #4116): the input is cleaned as WHATWG cleans it, the
// scheme is validated at the start, a backslash, a control character, a `%`
// in the host and a non-canonical numeric host are refused, scheme and host
// are lowercased, and `.`/`..` segments (spelled with `%2e` or not) are
// removed by one rule in both. `+` is
// NOT decoded as space (that is form-encoding, not RFC 3986). A URL whose
// query/fragment is present but empty (`http://h?`) round-trips to the
// separator-free form.
// A parsed URL. `port` is absent when the authority carries no `:port`;
// `path` is "" when the authority is not followed by `/`; `query` and
// `fragment` are "" when their separators are absent.
/// Parsed URL; port none, other parts "" when absent.
type Url = { scheme: String, host: String, port: Int?, path: String, query: String, fragment: String }

// Split at the FIRST occurrence of `sep`: (before, after, found).
fn __url_split_once(s: String, sep: String) -> (String, String, Bool) = match string.index_of(
  s,
  sep,
) {
  some(i) => (string.slice(s, 0, i), string.slice(s, i + string.len(sep), string.len(s)), true),
  none => (s, "", false),
}

fn __url_hex_char(n: Int) -> String = string.slice("0123456789ABCDEF", n, n + 1)

// RFC 3986 unreserved: ALPHA / DIGIT / "-" / "." / "_" / "~"
fn __url_is_unreserved(cp: Int) -> Bool = (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or (cp >= 48 and cp <= 57) or cp == 45 or cp == 46 or cp == 95 or cp == 126

fn __url_enc_byte(b: Int) -> String = "%" + __url_hex_char(b / 16) + __url_hex_char(b % 16)

// UTF-8 encode one scalar value as %XX escapes (pure arithmetic — the
// bytes module is deliberately not used, so this module stays fully
// interpreter-coverable while the #1226 bridge slices land).
fn __url_enc_cp(cp: Int) -> String = if cp < 128 then __url_enc_byte(cp)
else if cp < 2048 then __url_enc_byte(192 + cp / 64) + __url_enc_byte(128 + cp % 64)
else if cp < 65536 then __url_enc_byte(224 + cp / 4096) + __url_enc_byte(128 + (cp / 64) % 64) + __url_enc_byte(128 + cp % 64) else __url_enc_byte(240 + cp / 262144) + __url_enc_byte(128 + (cp / 4096) % 64) + __url_enc_byte(128 + (cp / 64) % 64) + __url_enc_byte(128 + cp % 64)

fn __url_enc_char(c: String) -> String = match string.to_codepoint(c) {
  some(cp) => if __url_is_unreserved(cp) then c else __url_enc_cp(cp),
  none => "",
}

// Percent-encode a single component (query key, query value, path segment).
// Total: every input has an encoding. Unreserved characters pass through;
// every other scalar is UTF-8-encoded and escaped as %XX per byte.
// See also: url.decode_component (the inverse), url.build_query.
// Example: url.encode_component("a b") == "a%20b"
// Example: url.encode_component("A-z_.~09") == "A-z_.~09"
/// All but A-Za-z0-9-._~ as UTF-8 %XX escapes.
fn encode_component(s: String) -> String = s |> string.to_list |> list.map((c) => __url_enc_char(c)) |> list.join("")

fn __url_hex_val(c: String) -> Int? = match string.to_codepoint(c) {
  some(cp) => if cp >= 48 and cp <= 57 then some(cp - 48)
  else if cp >= 65 and cp <= 70 then some(cp - 55)
  else if cp >= 97 and cp <= 102 then some(cp - 87) else none,
  none => none,
}

fn __url_hex2(a: String, b: String) -> Int? = match (__url_hex_val(a), __url_hex_val(b)) {
  (some(x), some(y)) => some(x * 16 + y),
  _ => none,
}

// End index of the %XX-run starting at i, or a sentinel: -1 = truncated
// escape, -2 = non-hex escape. (Int sentinels are internal-only: a
// Result[(List[Int], Int), _] payload trips the interpreter's #1226 bridge
// slice today — see STDLIB-EXCELLENCE queue #4; restructure when it lands.)
fn __url_pct_end(cs: List[String], i: Int, n: Int) -> Int =
  if i >= n or (list.get(cs, i) ?? "") != "%" then i
  else if i + 3 > n then 0 - 1
  else match __url_hex2(list.get(cs, i + 1) ?? "", list.get(cs, i + 2) ?? "") {
    some(_) => __url_pct_end(cs, i + 3, n),
    none => 0 - 2,
  }

// Byte value of the %XX escape whose '%' sits at char index p, or -1.
fn __url_pbyte(cs: List[String], p: Int) -> Int = match __url_hex2(
  list.get(cs, p + 1) ?? "",
  list.get(cs, p + 2) ?? "",
) {
  some(b) => b,
  none => 0 - 1,
}

fn __url_cont(b: Int) -> Bool = b >= 128 and b <= 191

// Strict UTF-8 decode of the %XX-run occupying char range [p, end): every
// byte is read straight from its hex pair (no intermediate byte list — a
// List[Int] crossing the interpreter bridge trips #1226 today; see
// STDLIB-EXCELLENCE queue #4). Rejects continuation errors, overlong
// forms, surrogates, and > U+10FFFF.
fn __url_utf8_go(cs: List[String], p: Int, end: Int, acc: String) -> Result[String, String] =
  if p >= end then ok(acc)
  else {
    let b0 = __url_pbyte(cs, p)
    if b0 >= 0 and b0 < 128 then __url_utf8_go(
      cs,
      p + 3,
      end,
      acc + (string.from_codepoint(b0) ?? ""),
    )
    else if b0 >= 194 and b0 <= 223 then {
      let b1 = __url_pbyte(cs, p + 3)
      if p + 6 <= end and __url_cont(b1) then __url_utf8_go(
        cs,
        p + 6,
        end,
        acc + (string.from_codepoint((b0 - 192) * 64 + (b1 - 128)) ?? ""),
      )
      else err("url.decode_component: invalid UTF-8 in percent data")
    } else if b0 >= 224 and b0 <= 239 then {
      let b1 = __url_pbyte(cs, p + 3)
      let b2 = __url_pbyte(cs, p + 6)
      let lo1 = if b0 == 224 then 160 else 128
      let hi1 = if b0 == 237 then 159 else 191
      if p + 9 <= end and b1 >= lo1 and b1 <= hi1 and __url_cont(b2) then __url_utf8_go(
        cs,
        p + 9,
        end,
        acc + (string.from_codepoint((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)) ?? ""),
      )
      else err("url.decode_component: invalid UTF-8 in percent data")
    } else if b0 >= 240 and b0 <= 244 then {
      let b1 = __url_pbyte(cs, p + 3)
      let b2 = __url_pbyte(cs, p + 6)
      let b3 = __url_pbyte(cs, p + 9)
      let lo1 = if b0 == 240 then 144 else 128
      let hi1 = if b0 == 244 then 143 else 191
      if p + 12 <= end and b1 >= lo1 and b1 <= hi1 and __url_cont(b2) and __url_cont(b3) then __url_utf8_go(
        cs,
        p + 12,
        end,
        acc + (string.from_codepoint((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)) ?? ""),
      )
      else err("url.decode_component: invalid UTF-8 in percent data")
    } else err("url.decode_component: invalid UTF-8 in percent data")
  }

fn __url_dec_go(cs: List[String], i: Int, n: Int, acc: String) -> Result[String, String] =
  if i >= n then ok(acc)
  else {
    let c = list.get(cs, i) ?? ""
    if c == "%" then {
      let e = __url_pct_end(cs, i, n)
      if e == 0 - 1 then err("url.decode_component: truncated percent escape")
      else if e == 0 - 2 then err("url.decode_component: invalid percent escape")
      else match __url_utf8_go(cs, i, e, "") {
        ok(dec) => __url_dec_go(cs, e, n, acc + dec),
        err(er) => err(er),
      }
    } else __url_dec_go(cs, i + 1, n, acc + c)
  }

// Decode a percent-encoded component. Fails with a reason on a truncated or
// non-hex escape and on percent data that is not valid UTF-8 (strict:
// overlong forms and surrogates are rejected). `+` is left as `+`
// (RFC 3986; form-encoding is a different codec).
// See also: url.encode_component (the inverse).
// Example: match url.decode_component("a%20b") { ok(v) => v == "a b", err(_) => false }
// Example: match url.decode_component("%zz") { ok(_) => false, err(_) => true }
// Example: match url.decode_component(url.encode_component("日本語 ok~")) { ok(v) => v == "日本語 ok~", err(_) => false }
/// Percent-decoded s; err on bad escape/UTF-8; + kept.
fn decode_component(s: String) -> Result[String, String] = {
  let cs = string.to_list(s)
  __url_dec_go(cs, 0, list.len(cs), "")
}

// RFC 3986 reg-name characters without pct-encoded: unreserved / sub-delims.
// A '%' is refused (C-402): WHATWG decodes it before checking the host, so
// `evil.com%2fgood.com` would be read as two different things.
fn __url_host_char(cp: Int) -> Bool = __url_is_unreserved(cp) or cp == 33 or cp == 36 or cp == 38 or cp == 39 or cp == 40 or cp == 41 or cp == 42 or cp == 43 or cp == 44 or cp == 59 or cp == 61

fn __url_host_ok(host: String) -> Bool = host |> string.to_list |> list.all((c) => match string.to_codepoint(c) {
  some(cp) => __url_host_char(cp),
  none => false,
})

// The WHATWG URL parser's cleaning: leading and trailing C0 control or space
// stripped, every tab / LF / CR removed. What is left may hold no other
// control character and no backslash (WHATWG reads `\` as `/` in http(s);
// refusing it keeps every reader on one URL).
fn __url_cp(c: String) -> Int = string.to_codepoint(c) ?? 0

fn __url_first_kept(cs: List[String], i: Int) -> Int =
  if i < list.len(cs) and __url_cp(list.get(cs, i) ?? "") <= 32 then __url_first_kept(cs, i + 1)
  else i

fn __url_last_kept(cs: List[String], i: Int) -> Int =
  if i > 0 and __url_cp(list.get(cs, i - 1) ?? "") <= 32 then __url_last_kept(cs, i - 1)
  else i

fn __url_clean(s: String, who: String) -> Result[String, String] = {
  let cs = string.to_list(s)
  let start = __url_first_kept(cs, 0)
  let end = __url_last_kept(cs, list.len(cs))
  let kept = cs |> list.take(end) |> list.drop(start) |> list.filter((c) => c != "\t" and c != "\n" and c != "\r")
  if kept |> list.any((c) => __url_cp(c) < 32 or __url_cp(c) == 127) then err(who + ": control character in URL")
  else if kept |> list.any((c) => c == "\\") then err(who + ": backslash in URL")
  else ok(list.join(kept, ""))
}

// A scheme is ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
fn __url_scheme_ok(t: String) -> Bool = string.len(t) > 0 and string.to_list(t) |> list.enumerate |> list.all(((j, c)) => {
  let cp = __url_cp(c)
  (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or (j > 0 and ((cp >= 48 and cp <= 57) or cp == 43 or cp == 45 or cp == 46))
})

fn __url_all_digits(t: String) -> Bool = string.len(t) > 0 and string.to_list(t) |> list.all((c) => __url_cp(c) >= 48 and __url_cp(c) <= 57)

fn __url_hex_digit(c: String) -> Bool = match __url_hex_val(c) {
  some(_) => true,
  none => false,
}

// WHATWG's ends-in-a-number: the last label (one trailing empty label
// dropped) is all digits, or `0x`/`0X` and hex digits.
fn __url_ends_in_number(host: String) -> Bool = {
  let labels = string.split(host, ".")
  let n = list.len(labels)
  let last = if n > 1 and (list.get(labels, n - 1) ?? "") == "" then list.get(labels, n - 2) ?? ""
  else list.get(labels, n - 1) ?? ""
  __url_all_digits(last) or ((string.starts_with(last, "0x") or string.starts_with(last, "0X")) and string.to_list(string.drop(last, 2)) |> list.all((c) => __url_hex_digit(c)))
}

// Four decimal labels, each `0` or a non-zero-led number up to 255.
fn __url_canonical_ipv4(host: String) -> Bool = {
  let labels = string.split(host, ".")
  list.len(labels) == 4 and labels |> list.all((l) => __url_all_digits(l) and string.len(l) <= 3 and (string.len(l) == 1 or not string.starts_with(
    l,
    "0",
  )) and (int.parse(l) ?? 256) <= 255)
}

// The dot-segment rule (WHATWG path state): `.` and `%2e` (any case) are a
// single-dot segment, `..`, `.%2e`, `%2e.` and `%2e%2e` a double-dot one.
fn __url_dot_kind(seg: String) -> Int = match string.to_lower(seg) {
  "." => 1,
  "%2e" => 1,
  ".." => 2,
  ".%2e" => 2,
  "%2e." => 2,
  "%2e%2e" => 2,
  _ => 0,
}

// A double-dot drops the segment before it; either kind, as the last
// segment, leaves the path ending in `/`.
fn __url_dots_go(segs: List[String], i: Int, n: Int, out: List[String]) -> List[String] =
  if i >= n then out
  else {
    let seg = list.get(segs, i) ?? ""
    let last = i + 1 == n
    let kind = __url_dot_kind(seg)
    let kept = if kind == 2 and list.len(out) > 0 then list.take(out, list.len(out) - 1)
    else out
    let next = if kind == 0 then kept + [seg]
    else if last then kept + [""]
    else kept
    __url_dots_go(segs, i + 1, n, next)
  }

fn __url_remove_dots(path: String) -> String = if string.len(path) == 0 then ""
else {
  let rooted = string.starts_with(path, "/")
  let body = if rooted then string.drop(path, 1) else path
  let segs = string.split(body, "/")
  let joined = list.join(__url_dots_go(segs, 0, list.len(segs), []), "/")
  if rooted then "/" + joined else joined
}

// Parse `scheme://host[:port][/path][?query][#fragment]`. The input is first
// cleaned as the WHATWG URL parser cleans it (__url_clean). Fails with a
// reason on a control character or backslash left after cleaning, a scheme
// that is not `ALPHA *( ALPHA / DIGIT / "+" / "-" / "." )` before the first
// `:` or is not followed by `//`, an empty or invalid host (a `%` included),
// a numeric host that is not four canonical decimal labels (WHATWG would
// read `127.1` as `127.0.0.1`; refused here), userinfo (`user@host`) or an
// IPv6 literal (`[::1]`) — both documented out of scope, refused rather than
// read as a host — or a port that is not all digits in 0..=65535. The
// empty-host check looks at the HOST, not the authority: `http://:8` used to
// parse with `host = ""` because `:8` is non-empty (#2490). Scheme and host
// are lowercased, and dot segments are removed from the path (C-402).
// See also: url.to_string (the inverse), url.query_pairs.
// Example: match url.parse("https://example.com:8080/a/b?x=1&y=2#top") { ok(u) => u.scheme == "https" and u.host == "example.com" and u.port == some(8080) and u.path == "/a/b" and u.query == "x=1&y=2" and u.fragment == "top", err(_) => false }
// Example: match url.parse("http://x") { ok(u) => u.host == "x" and u.path == "" and u.port == none, err(_) => false }
// Example: match url.parse("not a url") { ok(_) => false, err(_) => true }
// Example: match url.parse("http://h:99999") { ok(_) => false, err(_) => true }
// Example: match url.parse("http://:8") { ok(_) => false, err(e) => e == "url.parse: empty host" }
// Example: match url.parse("http://h:+80") { ok(_) => false, err(e) => e == "url.parse: invalid port: +80" }
// Example: match url.parse("http://u@h") { ok(_) => false, err(e) => e == "url.parse: userinfo is not supported: u@h" }
// Example: match url.parse("http://a b") { ok(_) => false, err(e) => e == "url.parse: invalid host: a b" }
// Example: match url.parse("javascript:alert(1)//://good.com") { ok(_) => false, err(e) => e == "url.parse: missing '://' scheme separator" }
// Example: match url.parse("http://good.com/a/%2e%2e/b") { ok(u) => u.path == "/b", err(_) => false }
/// Url from s, cleaned as WHATWG does; err on a bad scheme, host or port, a backslash or control char, userinfo, IPv6.
fn parse(s: String) -> Result[Url, String] = match __url_clean(s, "url.parse") {
  err(e) => err(e),
  ok(t) => __url_parse_clean(t),
}

fn __url_parse_clean(s: String) -> Result[Url, String] = match string.index_of(s, ":") {
  none => err("url.parse: missing '://' scheme separator"),
  some(i) => {
    if i == 0 then err("url.parse: empty scheme")
    else if not __url_scheme_ok(string.take(s, i)) then err("url.parse: invalid scheme: " + string.take(
      s,
      i,
    ))
    else if string.slice(s, i + 1, i + 3) != "//" then err("url.parse: missing '://' scheme separator")
    else {
      let scheme = string.to_lower(string.take(s, i))
      let rest = string.slice(s, i + 3, string.len(s))
      let hf = __url_split_once(rest, "#")
      let qs = __url_split_once(hf.0, "?")
      let ps = __url_split_once(qs.0, "/")
      let authority = ps.0
      let path = if ps.2 then __url_remove_dots("/" + ps.1)
      else ""
      if string.contains(authority, "@") then err("url.parse: userinfo is not supported: " + authority)
      else if string.starts_with(authority, "[") then err("url.parse: IPv6 hosts are not supported: " + authority)
      else {
        let hp = __url_split_once(authority, ":")
        let host = hp.0
        if string.len(host) == 0 then err("url.parse: empty host")
        else if not __url_host_ok(host) then err("url.parse: invalid host: " + host)
        else if __url_ends_in_number(host) and not __url_canonical_ipv4(host) then err("url.parse: non-canonical IPv4 host: " + host)
        else if hp.2 then {
          if not string.is_digit(hp.1) then err("url.parse: invalid port: " + hp.1)
          else match int.parse(hp.1) {
            ok(p) => if p <= 65535 then ok(Url {
              scheme: scheme,
              host: string.to_lower(host),
              port: some(p),
              path: path,
              query: qs.1,
              fragment: hf.1,
            })
            else err("url.parse: port out of range: " + hp.1),
            err(_) => err("url.parse: invalid port: " + hp.1),
          }
        } else ok(Url {
          scheme: scheme,
          host: string.to_lower(host),
          port: none,
          path: path,
          query: qs.1,
          fragment: hf.1,
        })
      }
    }
  },
}

// Render a Url back to its string form. Total; `parse ∘ to_string` is the
// identity on every value `parse` produces.
// See also: url.parse (the inverse).
// Example: match url.parse("https://example.com:8080/a?x=1#t") { ok(u) => url.to_string(u) == "https://example.com:8080/a?x=1#t", err(_) => false }
/// URL text of u; empty query/fragment omitted.
fn to_string(u: Url) -> String = {
  let port_part = match u.port {
    some(p) => ":" + int.to_string(p),
    none => "",
  }
  let query_part = if string.len(u.query) == 0 then ""
  else "?" + u.query
  let frag_part = if string.len(u.fragment) == 0 then ""
  else "#" + u.fragment
  u.scheme + "://" + u.host + port_part + u.path + query_part + frag_part
}

// Split a raw query string into key/value pairs. Total and lenient: empty
// segments are dropped, a segment without `=` becomes (key, ""). Values are
// returned RAW (not percent-decoded) — decode per pair when needed, so one
// malformed value cannot fail the whole query.
// See also: url.build_query (the inverse), url.decode_component.
// Example: url.query_pairs("a=1&b=two") == [("a", "1"), ("b", "two")]
// Example: url.query_pairs("") == []
// Example: url.query_pairs("flag&x=1") == [("flag", ""), ("x", "1")]
/// Undecoded (k, v) pairs; bare key gets "".
fn query_pairs(query: String) -> List[(String, String)] = if string.len(query) == 0 then []
else query |> string.split("&") |> list.filter((part) => string.len(part) > 0) |> list.map((part) => {
  let kv = __url_split_once(part, "=")
  (kv.0, kv.1)
})

// Build a query string from pairs, percent-encoding every key and value.
// Total. `query_pairs(build_query(ps))` recovers the ENCODED forms.
// See also: url.query_pairs, url.encode_component.
// Example: url.build_query([("q", "a b"), ("lang", "ja")]) == "q=a%20b&lang=ja"
// Example: url.build_query([]) == ""
/// k=v joined by &, both sides percent-encoded.
fn build_query(xs: List[(String, String)]) -> String = xs |> list.map(((k, v)) => encode_component(k) + "=" + encode_component(v)) |> list.join("&")

// Form encoding (application/x-www-form-urlencoded): a space is `+`, every
// other character is escaped as encode_component escapes it.
// See also: url.decode_form (the inverse), url.encode_component.
// Example: url.encode_form("a b+c") == "a+b%2Bc"
/// Like encode_component, but a space becomes +.
fn encode_form(s: String) -> String = s |> string.to_list |> list.map((c) => if c == " " then "+" else __url_enc_char(c)) |> list.join("")

// Form decoding: `+` becomes a space, then the decode_component rules apply.
// See also: url.encode_form (the inverse), url.decode_component.
// Example: match url.decode_form("a+b%2Bc") { ok(v) => v == "a b+c", err(_) => false }
// Example: match url.decode_form("%zz") { ok(_) => false, err(_) => true }
/// + as space, then percent-decoded; err on bad escape/UTF-8.
fn decode_form(s: String) -> Result[String, String] = match decode_component(string.replace(s, "+", " ")) {
  ok(v) => ok(v),
  err(e) => err(string.replace(e, "url.decode_component", "url.decode_form")),
}

fn __url_parse_pairs(parts: List[String], acc: List[(String, String)]) -> Result[List[(String, String)], String] = match list.first(parts) {
  none => ok(list.reverse(acc)),
  some(part) => {
    let kv = __url_split_once(part, "=")
    match (decode_form(kv.0), decode_form(kv.1)) {
      (ok(k), ok(v)) => __url_parse_pairs(list.drop(parts, 1), [(k, v)] + acc),
      (err(e), _) => err(string.replace(e, "url.decode_form", "url.parse_query")),
      (_, err(e)) => err(string.replace(e, "url.decode_form", "url.parse_query")),
    }
  },
}

// Split a query string into key/value pairs and decode both sides with the
// decode_form rules. Empty segments are dropped; a segment without `=`
// becomes (key, ""). The first malformed escape fails the whole query.
// See also: url.build_query (the inverse), url.decode_form.
// Example: match url.parse_query("q=a+b&lang=ja") { ok(ps) => ps == [("q", "a b"), ("lang", "ja")], err(_) => false }
// Example: match url.parse_query("") { ok(ps) => ps == [], err(_) => false }
// Example: match url.parse_query("x=%zz") { ok(_) => false, err(_) => true }
/// Decoded (k, v) pairs; bare key gets ""; err on a bad escape.
fn parse_query(query: String) -> Result[List[(String, String)], String] = __url_parse_pairs(
  string.split(query, "&") |> list.filter((part) => string.len(part) > 0),
  [],
)

// RFC 3986 5.2.3: a relative path merged onto the base path.
fn __url_merge(base: Url, rel: String) -> String = if string.len(base.path) == 0 then "/" + rel
else match string.last_index_of(base.path, "/") {
  some(i) => string.take(base.path, i + 1) + rel,
  none => rel,
}

// A scheme and its `:` start the reference.
fn __url_has_scheme(r: String) -> Bool = match string.index_of(r, ":") {
  none => false,
  some(i) => __url_scheme_ok(string.take(r, i)),
}

// Resolve a reference against a base URL by RFC 3986 section 5.2, after
// cleaning the reference as url.parse cleans its input (C-403). An absolute
// reference is parsed on its own; a network-path reference (`//host/p`)
// takes the base's scheme. Every resulting path goes through the one
// dot-segment rule, `%2e` spellings included. Like url.parse, the result must
// have an authority, so a reference such as `mailto:x` is an err.
// See also: url.parse, url.to_string.
// Example: match url.parse("http://a/b/c/d;p?q") { ok(b) => match url.resolve(b, "../g") { ok(u) => url.to_string(u) == "http://a/b/g", err(_) => false }, err(_) => false }
// Example: match url.parse("http://a/b/c/d;p?q") { ok(b) => match url.resolve(b, "?y") { ok(u) => url.to_string(u) == "http://a/b/c/d;p?y", err(_) => false }, err(_) => false }
// Example: match url.parse("http://good.com/files/pub/") { ok(b) => match url.resolve(b, "%2e%2e/%2e%2e/admin") { ok(u) => u.path == "/admin", err(_) => false }, err(_) => false }
/// ref cleaned as parse does, resolved against base (RFC 3986 5.2); err when the result is not a URL.
fn resolve(base: Url, ref: String) -> Result[Url, String] = match __url_clean(ref, "url.resolve") {
  err(e) => err(e),
  ok(r) => if __url_has_scheme(r) then parse(r)
  else if string.starts_with(r, "//") then parse(base.scheme + ":" + r)
  else {
    let hf = __url_split_once(r, "#")
    let qs = __url_split_once(hf.0, "?")
    let rpath = qs.0
    let path = if string.len(rpath) == 0 then base.path
    else if string.starts_with(rpath, "/") then __url_remove_dots(rpath)
    else __url_remove_dots(__url_merge(base, rpath))
    let query = if string.len(rpath) == 0 and not qs.2 then base.query
    else qs.1
    ok({ ...base, path: path, query: query, fragment: hf.1 })
  },
}

// TEMP probes
fn __url_t_pctend(s: String) -> Int = __url_pct_end(string.to_list(s), 1, string.len(s))

fn __url_t_pbyte(s: String) -> Int = __url_pbyte(string.to_list(s), 0)

fn __url_t_utf8(s: String) -> String = match __url_utf8_go(string.to_list(s), 0, string.len(s), "") {
  ok(v) => v,
  err(e) => "E:" + e,
}

fn __url_t_fcp(b: Int) -> String = (string.from_codepoint(b) ?? "")

fn __url_t_dec_nopct(s: String) -> String = match __url_dec_go(
  string.to_list(s),
  0,
  string.len(s),
  "",
) {
  ok(v) => v,
  err(e) => "E:" + e,
}
