// float_to_string — SELF-HOSTED `float.to_string`, `float.to_string_compound` and `float.to_fixed`.
//
// `float.to_string` is SCHUBFACH (Giulietti, "The Schubfach way to render doubles"): the
// shortest round-trip decimal from three 126x64-bit products against a power-of-ten
// constant g(j), rendered in FIXED notation (never scientific) + a `.0` integer suffix —
// byte-identical to v0 native's `format!("{}", n)` + suffix. It replaced the Dragon4
// transcription (#1985) because the exact-bignum digit loop cost 6.4 KB of wasm per program
// that prints a float; Schubfach's per-digit work is three 64x64 multiplies, and its one
// large table (617 x 128 bits, 9.9 KB) is NOT stored: g(j) is DERIVED AT RUN TIME by exact
// big-integer arithmetic (one multiply-by-small and one divide-by-small loop over u32
// limbs), which is ~1.2 KB of code. The measurement that chose this is
// docs/benchmarks/float-printer.md. Two places deliberately depart from Giulietti's Java:
// an exact tie between the two closest candidates rounds the magnitude UP (Rust's Dragon4
// "2R >= S"), and the shorter multiple-of-10 candidate is tried from s >= 10 (Java prints at
// least two digits; format! prints "1e-322" for 20 * 2^-1074).
//
// `float.to_string_compound` is the SAME printer with the `.0` suffix switched off — the form v0
// uses for a Float inside `${...}`, a record, a tuple or a list (`1.0` -> "1", `-0.0` -> "-0"),
// so a program that interpolates a float carries one printer, not a printer plus a copy.
//
// `float.to_fixed(x, nd)` — exactly nd fractional digits, byte-matching `format!("{:.N}", x)`:
// the exact binary value rounded half-to-even — is the SAME scaling on the same bignum: M =
// floor(2 * v * 10^nd) with its sticky bit, N = M / 2 rounded up on a half when the sticky bit or
// N's last bit is set, then N's decimal digits by repeated division by 10^9. It replaced the
// Steele & White / Burger–Dubois "Dragon4" fixed-mode digit loop (one bignum compare-subtract
// per digit), which cost 4.7 KB of wasm and 30 us per conversion.
//
// All are pure String building (cert `i`, like int.to_string): no host effect, no caps, no
// proof touched. The only risk is byte-exactness, caught by the byte-match e2e tests, the
// tests/float_to_string_cross_target_test.rs sweep (both printers, every biased exponent, 100k
// bit patterns vs `format!`) and the 1M-value cross-target diff recorded in the benchmark doc.
//
// ── Big-integer layout ──
// One bignum lives at the start of a scratch block (one prim.alloc_list, read/written by byte
// address via prim.load32/store32): [len:u32 @ +0][limb_0 @ +4][limb_1 @ +8]... little-endian u32
// limbs. to_string: g(j)'s bignum of up to 38 limbs (2^1202) @0, then the two g words @160 —
// prim.alloc_list(22) = 176 bytes.
// to_fixed: up to 460 limbs (c * 2^1025 * 10^4096 < 2^14687) at @0, then the 9-digit chunks of
// the answer (i64 each, at most 492) at @1856 — prim.alloc_list(724) = 5792 bytes.
// All offsets below are BYTE offsets from the scratch byte-base (handle(block) + 12).
// ───────────────────────── big-integer helpers ─────────────────────────
// Each takes the absolute BYTE address of a bignum's len word. limb i is at p + 4 + i*4.
// norm(p): drop high zero limbs, keep len >= 1.
fn __dg_norm_loop(p: Int, len: Int) -> Int = {
  let stop = if len <= 1 then true else (prim.load32(p + 4 + (len - 1) * 4) != 0)
  if stop then len else __dg_norm_loop(p, len - 1)
}

fn __dg_norm(p: Int) -> Unit = {
  let len = prim.load32(p)
  prim.store32(p, __dg_norm_loop(p, len))
}

// mul_small(p, m): p *= m (m a u32). carry/prod are full i64.
fn __dg_ms_body(p: Int, m: Int, len: Int, i: Int, carry: Int) -> Int = if i >= len then carry
else {
  let prod = prim.load32(p + 4 + i * 4) * m + carry
  prim.store32(p + 4 + i * 4, prim.band(prod, 4294967295))
  __dg_ms_body(p, m, len, i + 1, prim.bshr_u(prod, 32))
}

fn __dg_ms_carry(p: Int, len: Int, carry: Int) -> Int = if carry == 0 then len
else {
  prim.store32(p + 4 + len * 4, prim.band(carry, 4294967295))
  __dg_ms_carry(p, len + 1, prim.bshr_u(carry, 32))
}

fn __dg_mul_small(p: Int, m: Int) -> Unit = {
  let len = prim.load32(p)
  let carry = __dg_ms_body(p, m, len, 0, 0)
  let len2 = __dg_ms_carry(p, len, carry)
  prim.store32(p, len2)
}

fn __sf_limb(p: Int, i: Int) -> Int = if i < prim.load32(p) then prim.load32(p + 4 + i * 4) else 0

// p = floor(p / d) (d < 2^31), top limb down; the length is kept (high limbs may read zero).
fn __sf_ds_body(p: Int, d: Int, i: Int, rem: Int) -> Int = if i < 0 then rem
else {
  let cur = prim.bshl(rem, 32) + prim.load32(p + 4 + i * 4)
  let q = cur / d
  prim.store32(p + 4 + i * 4, q)
  __sf_ds_body(p, d, i - 1, cur - q * d)
}

// p = floor(p / d), returning the remainder.
fn __sf_div_small(p: Int, d: Int) -> Int = __sf_ds_body(p, d, prim.load32(p) - 1, 0)

fn __sf_pow10_small(n: Int) -> Int = if n == 0 then 1 else 10 * __sf_pow10_small(n - 1)

// One chunk: p = floor(p / m) returning the remainder (dv = true), or p *= m returning 0.
fn __sf_step(p: Int, m: Int, dv: Bool) -> Int = if dv then __sf_div_small(p, m)
else {
  __dg_mul_small(p, m)
  0
}

// p *= 10^j (dv = false) or p = floor(p / 10^j) (dv = true), in chunks of 10^9 (< 2^30):
// floor(floor(x / a) / b) = floor(x / ab) on integers, so the chunked division is exact, and
// x mod ab != 0 iff some chunk's remainder is non-zero — `acc` sums them (< 2^40, no overflow).
fn __sf_pow10_loop(p: Int, j: Int, dv: Bool, acc: Int) -> Int = if j >= 9 then {
  let r = __sf_step(p, 1000000000, dv)
  __sf_pow10_loop(p, j - 9, dv, acc + r)
} else acc + __sf_step(p, __sf_pow10_small(j), dv)

// p *= 2^e, in multiply-by-small steps of 2^31.
fn __sf_shl(p: Int, e: Int) -> Unit = if e >= 31 then {
  __dg_mul_small(p, 2147483648)
  __sf_shl(p, e - 31)
} else __dg_mul_small(p, prim.bshl(1, e))

// Is any limb below index i non-zero?
fn __sf_low_nz(p: Int, i: Int) -> Bool = if i <= 0 then false
else if __sf_limb(p, i - 1) != 0 then true else __sf_low_nz(p, i - 1)

// P @ sb = floor(x * 2^q * 10^-k) exactly (x < 2^57), as the limbs from index i upward — returns
// i * 2 + sticky, the sticky bit set when the discarded part was non-zero. P = x * 2^max(q,0) *
// 10^max(-k,0), then floor(P / 10^max(k,0)) in 10^9 chunks (the remainders are sticky), then
// floor(P / 2^max(-q,0)): the low n % 32 bits by one small division (its remainder is sticky),
// the n / 32 whole limbs below the answer by a scan. q and k usually share a sign, but not
// always (c = 2^52, q = 0 has k = -1), so every step is guarded by its own sign; a no-op step
// costs one pass by 1.
fn __sf_scale(x: Int, q: Int, k: Int, sb: Int) -> Int = {
  prim.store32(sb, 2)
  prim.store32(sb + 4, prim.band(x, 4294967295))
  prim.store32(sb + 8, prim.bshr_u(x, 32))
  let e = if q > 0 then q else 0
  __sf_shl(sb, e)
  let _m = if k < 0 then __sf_pow10_loop(sb, 0 - k, false, 0)
  else 0
  let rem = if k > 0 then __sf_pow10_loop(sb, k, true, 0)
  else 0
  let n = if q < 0 then 0 - q else 0
  let rem2 = __sf_div_small(sb, prim.bshl(1, prim.band(n, 31)))
  let i = prim.bshr(n, 5)
  let sticky = if rem + rem2 != 0 then 1
  else (if __sf_low_nz(sb, i) then 1 else 0)
  i + i + sticky
}

// ───────────────────────── shared digit writer ─────────────────────────
// Write n digits backwards from `end`: the next digit of f each step (f / 10; '0' once f is
// spent — the leading and trailing zeros), and '.' at address `dot` (0 = none) as it is passed,
// not counted. Returns the address of the last byte written.
fn __sf_wd(f: Int, end: Int, n: Int, dot: Int) -> Int = if n <= 0 then end
else if end - 1 == dot then {
  prim.store8(dot, 46)
  __sf_wd(f, end - 1, n, dot)
} else {
  // a spent f skips the divide: a huge or tiny value is mostly zeros
  let q = if f == 0 then 0 else f / 10
  prim.store8(end - 1, 48 + f - q * 10)
  __sf_wd(q, end - 1, n - 1, dot)
}

// The number of decimal digits of f (0 for 0), by comparison against rising powers of ten — a
// multiply per digit, not a divide (f < 10^18, so p never overflows).
fn __sf_ndig(f: Int, p: Int, acc: Int) -> Int = if f < p then acc
else __sf_ndig(f, p * 10, acc + 1)

fn __dg_special(bits0: Int, raw_mant0: Int) -> String = if raw_mant0 != 0 then "NaN"
else if bits0 < 0 then "-inf" else "inf"

// ───────────────────────── float_to_string: Schubfach ─────────────────────────
// v = c * 2^q, c the 53-bit significand. k = floor(log10 v) (three-quarters form on the
// asymmetric power-of-two boundary); j = -k; the 126-bit g(j) = floor(10^j * 2^-r) + 1 with
// r = floor(log2 10^j) - 125 makes vb = floor(4v * 10^-k) with a sticky bit, and the
// candidates s = vb >> 2, s + 1 and the multiple of 10 at s are tested against the rounding
// interval [vbl, vbr] computed the same way from c - 1/2 (or - 1/4) and c + 1/2.
// Floor-log helpers, exact over the f64 range (checked offline against big-integer logs).
fn __sf_flog10pow2(e: Int) -> Int = prim.bshr(e * 661971961083, 41)

fn __sf_flog10_3q_pow2(e: Int) -> Int = prim.bshr(e * 661971961083 - 274743187321, 41)

fn __sf_flog2pow10(e: Int) -> Int = prim.bshr(e * 913124641741, 38)

// p = 2^e: zero the limbs below, one bit in the top limb.
fn __sf_set_pow2(p: Int, e: Int, i: Int) -> Unit = if i < prim.bshr(e, 5) then {
  prim.store32(p + 4 + i * 4, 0)
  __sf_set_pow2(p, e, i + 1)
} else {
  prim.store32(p, i + 1)
  prim.store32(p + 4 + i * 4, prim.bshl(1, prim.band(e, 31)))
}

// The n (<= 63) bits of bignum p starting at bit position pos; pos < 0 reads zeros below bit 0.
fn __sf_getbits(p: Int, pos: Int, n: Int) -> Int = if pos + n <= 0 then 0
else if pos < 0 then prim.bshl(__sf_getbits(p, 0, n + pos), 0 - pos)
else {
  let i = prim.bshr(pos, 5)
  let s = prim.band(pos, 31)
  let l0 = __sf_limb(p, i)
  let l1 = __sf_limb(p, i + 1)
  let l2 = __sf_limb(p, i + 2)
  let hi = if s == 0 then 0 else prim.bshl(l2, 64 - s)
  let v = prim.bor(prim.bor(prim.bshr_u(l0, s), prim.bshl(l1, 32 - s)), hi)
  prim.band(v, prim.bshl(1, n) - 1)
}

// g(j) = floor(10^j * 2^-r) + 1, r = floor(log2 10^j) - 125, derived exactly:
//   j >= 0: P = 10^j (chunked *10^9), g - 1 = its top 126 bits
//   j <  0: P = 2^(125 - floor(log2 10^j)) divided by 10^-j (chunked /10^9) = exactly g - 1
// Leaves g1 @ sb+160 and g0 @ sb+168.
fn __sf_compute_g(j: Int, sb: Int) -> Unit = {
  // l = bit length of the bignum whose top 126 bits are g - 1.
  let l = if j >= 0 then {
    prim.store32(sb, 1)
    prim.store32(sb + 4, 1)
    let _m = __sf_pow10_loop(sb, j, false, 0)
    __sf_flog2pow10(j) + 1
  } else {
    __sf_set_pow2(sb, 125 - __sf_flog2pow10(j), 0)
    let _d = __sf_pow10_loop(sb, 0 - j, true, 0)
    126
  }
  let g0 = __sf_getbits(sb, l - 126, 63) + 1
  let carry = if g0 == prim.bshl(1, 63) then 1 else 0
  prim.store64(sb + 160, __sf_getbits(sb, l - 63, 63) + carry)
  prim.store64(sb + 168, prim.band(g0, 9223372036854775807))
}

// 64x64 -> the high 64 bits (unsigned), from four 32x32 partial products.
fn __sf_mulhi(a: Int, b: Int) -> Int = {
  let al = prim.band(a, 4294967295)
  let ah = prim.bshr_u(a, 32)
  let bl = prim.band(b, 4294967295)
  let bh = prim.bshr_u(b, 32)
  let m1 = al * bh
  let m2 = ah * bl
  let t = prim.bshr_u(al * bl, 32) + prim.band(m1, 4294967295) + prim.band(m2, 4294967295)
  ah * bh + prim.bshr_u(m1, 32) + prim.bshr_u(m2, 32) + prim.bshr_u(t, 32)
}

// rop(g, cp) = floor(g * cp / 2^127) with a sticky low bit when the discarded part is non-zero.
fn __sf_rop(g1: Int, g0: Int, cp: Int) -> Int = {
  let z = prim.bshr_u(g1 * cp, 1) + __sf_mulhi(g0, cp)
  let vbp = __sf_mulhi(g1, cp) + prim.bshr_u(z, 63)
  if prim.band(z, 9223372036854775807) != 0 then prim.bor(vbp, 1) else vbp
}

// Which of the candidates lo < hi lies in the rounding interval [vbl, vbr] (open when out = 1):
// 1 = only lo, 2 = only hi, 0 = neither, 3 = both.
fn __sf_pick(vbl: Int, vbr: Int, out: Int, lo: Int, hi: Int) -> Int = {
  let su = if vbl + out <= prim.bshl(lo, 2) then 1 else 0
  let sw = if prim.bshl(hi, 2) + out <= vbr then 2 else 0
  su + sw
}

// |v| = f * 10^e with f > 0 and no trailing zero, m digits, k = m + e the point position:
//   k <= 0 :  "[-]0." + (-k) zeros + digits
//   k >= m :  "[-]" + digits + (k-m) zeros + ".0"      (the ".0" only when dot0)
//   else   :  "[-]" + digits[0..k] + "." + digits[k..m]
// Backwards passes of __sf_wd: the point sits at c0 + k (k > 0) or c0 + 1 (k <= 0, where the pass
// writes the leading "0" as the zero it emits once f is spent). A whole value's (k - m) zeros and
// the "0" of its ".0" sit to the RIGHT of the digits: a first pass with f = 0 writes them (and
// the point), the digits follow below.
fn __sf_render(f: Int, m: Int, k: Int, neg: Bool, dot0: Bool) -> String = {
  let whole = k >= m
  let tail = if whole then (if dot0 then 2 else 0)
  else 1
  let body = if k <= 0 then 2 - k + m
  else if whole then k + tail else m + 1
  // NB: `(if neg ...) + body` as a BinOp operand silently mis-lowers in v1 (the if-in-operand
  // gap), so bind the sign width FIRST then add — see the dual-oracle byte-match.
  let sign_w = if neg then 1 else 0
  let out_len = sign_w + body
  let buf = prim.alloc_str(out_len)
  let base = prim.handle(buf) + 12
  let c0 = if neg then {
    prim.store8(base, 45)
    base + 1
  } else base
  let dot = if k <= 0 then c0 + 1
  else if tail == 0 then 0 else c0 + k
  let right = if whole then k - m + tail / 2 else 0
  let mid = __sf_wd(0, base + out_len, right, dot)
  let left = if k <= 0 then m + 1 - k else m
  let _w = __sf_wd(f, mid, left, dot)
  buf
}

// |v| = f * 10^e (f > 0): strip trailing zeros, then render.
fn __sf_finish(f: Int, e: Int, neg: Bool, dot0: Bool) -> String = if (f / 10) * 10 == f then __sf_finish(
  f / 10,
  e + 1,
  neg,
  dot0,
)
else {
  let m = __sf_ndig(f, 1, 0)
  __sf_render(f, m, m + e, neg, dot0)
}

// v = c * 2^q (c > 0): the shortest decimal in the rounding interval, closest on a draw, and on
// an exact tie the LARGER magnitude — Rust's `{}` (Dragon4 "2R >= S") rounds a half up, not to
// even: format! prints 1669760939663944.3 for ...944.25 where Giulietti's even rule gives ...4.2.
fn __sf_core(q: Int, c: Int, neg: Bool, dot0: Bool, sb: Int) -> String = {
  let out = prim.band(c, 1)
  let cb = prim.bshl(c, 2)
  let regular = if c != 4503599627370496 then true else q == 0 - 1074
  let cbl = if regular then cb - 2 else cb - 1
  let k = if regular then __sf_flog10pow2(q) else __sf_flog10_3q_pow2(q)
  let h = q + __sf_flog2pow10(0 - k) + 2
  __sf_compute_g(0 - k, sb)
  let g1 = prim.load64(sb + 160)
  let g0 = prim.load64(sb + 168)
  let vb = __sf_rop(g1, g0, prim.bshl(cb, h))
  let vbl = __sf_rop(g1, g0, prim.bshl(cbl, h))
  let vbr = __sf_rop(g1, g0, prim.bshl(cb + 2, h))
  let s = prim.bshr(vb, 2)
  let sp10 = (s / 10) * 10
  // Giulietti guards the shorter (multiple-of-10) candidate with `s >= 100` because Java prints
  // at least two digits; the interval is 1..10 units of 10^k wide so it holds at most one
  // multiple of 10, and a subnormal's s can be two digits — 20 * 2^-1074 has s = 98 with 100
  // inside the interval, and format! prints the one-digit "1e-322". `s >= 10` keeps sp10 > 0.
  let sel10 = if s >= 10 then __sf_pick(vbl, vbr, out, sp10, sp10 + 10)
  else 0
  let sel = if sel10 == 0 then __sf_pick(vbl, vbr, out, s, s + 1)
  else 0
  let f = if sel10 == 1 then sp10
  else if sel10 == 2 then sp10 + 10
  else if sel == 1 then s
  else if sel == 2 then s + 1
  else if vb < prim.bshl(s + s + 1, 1) then s else s + 1
  __sf_finish(f, k, neg, dot0)
}

// The Schubfach main path for a FINITE, NON-ZERO x. (Java's C_TINY branch, which feeds 10*t so
// that MIN_VALUE gets Java's mandatory second digit "4.9E-324", is deliberately absent: format!
// prints the one-digit shortest "5e-324".)
fn __sf_nonzero(bq: Int, t: Int, neg: Bool, dot0: Bool) -> String = {
  let blk = prim.alloc_list(22)
  let sb = prim.handle(blk) + 12
  let q = if bq != 0 then bq - 1075 else 0 - 1074
  let c = if bq != 0 then t + 4503599627370496 else t
  __sf_core(q, c, neg, dot0, sb)
}

// every arm is one call → the heap-result-if lowering handles it. A zero renders as the one
// digit 0 at point position 1 — "0.0" / "0" / "-0.0" / "-0" — through the same writer, so the
// printer ships no string literal beyond the three specials (the pool shifts every alloc row).
fn __sf_main(x: Float, dot0: Bool) -> String = {
  let bits0 = prim.fbits(x)
  let bq = prim.band(prim.bshr_u(bits0, 52), 2047)
  let t = prim.band(bits0, 4503599627370495)
  // 0xF_FFFF_FFFF_FFFF
  let neg = bits0 < 0
  if bq == 2047 then __dg_special(bits0, t)
  else if prim.feq(x, 0.0) then __sf_render(0, 1, 1, neg, dot0)
  else __sf_nonzero(bq, t, neg, dot0)
}

fn float_to_string(x: Float) -> String = __sf_main(x, true)

// The `${...}` / record / tuple / list form: integer-valued floats DROP the ".0" (`1.0` -> "1",
// `-0.0` -> "-0"); every other value prints exactly as `float.to_string` does.
fn float_to_string_compound(x: Float) -> String = __sf_main(x, false)

// ───────────────────────── float.to_fixed: exact value, round half to even ─────────────────────────
// v0 native: `format!("{:.N}", x)` — the EXACT decimal expansion rounded to N fractional digits,
// ties-to-even (core::fmt flt2dec). M = floor(2 * v * 10^nd) with the sticky bit, N = M >> 1,
// and the dropped bit of M is the half: round N up when it is set and either the sticky bit or
// N's last bit is. Zero flows through unchanged (c = 0 -> N = 0 -> "0.00…", "-0.00…" for -0.0).
// p += 1 (the round-up carry).
fn __tf_inc(p: Int, i: Int) -> Unit = if i >= prim.load32(p) then {
  prim.store32(p, i + 1)
  prim.store32(p + 4 + i * 4, 1)
} else {
  let v = prim.load32(p + 4 + i * 4) + 1
  prim.store32(p + 4 + i * 4, prim.band(v, 4294967295))
  if v == 4294967296 then __tf_inc(p, i + 1) else ()
}

// N's decimal digits as 9-digit chunks, least significant first, i64 each at cp; returns the count.
fn __tf_chunks(p: Int, cp: Int, n: Int) -> Int = {
  let r = __sf_div_small(p, 1000000000)
  prim.store64(cp + n * 8, r)
  __dg_norm(p)
  let zero = if prim.load32(p) == 1 then prim.load32(p + 4) == 0 else false
  if zero then n + 1
  else __tf_chunks(p, cp, n + 1)
}

// Write chunks j .. jmax-1 (9 digits each, least significant first) backwards from `end`.
fn __tf_write(cp: Int, j: Int, jmax: Int, end: Int, dot: Int) -> Int = if j >= jmax then end
else __tf_write(cp, j + 1, jmax, __sf_wd(prim.load64(cp + j * 8), end, 9, dot), dot)

fn __tf_main(bits0: Int, nd: Int) -> String = {
  let neg = bits0 < 0
  let bq = prim.band(prim.bshr_u(bits0, 52), 2047)
  let t = prim.band(bits0, 4503599627370495)
  let q = if bq != 0 then bq - 1075 else 0 - 1074
  let c = if bq != 0 then t + 4503599627370496 else t
  let blk = prim.alloc_list(724)
  let sb = prim.handle(blk) + 12
  let cp = sb + 1856
  // M as the limbs from index i of the bignum at sb; re-head it at p (limb i-1 is below the
  // answer and its part in the sticky bit is already taken).
  let r = __sf_scale(c, q + 1, 0 - nd, sb)
  let i = prim.bshr(r, 1)
  let len0 = prim.load32(sb)
  let p = sb + i * 4
  let len = if len0 > i then len0 - i else 1
  prim.store32(p, len)
  let _pad = if len0 > i then 0
  else {
    prim.store32(p + 4, 0)
    0
  }
  let half = __sf_div_small(p, 2)
  let odd = prim.band(prim.load32(p + 4), 1)
  let up = if half == 0 then false else prim.band(r, 1) + odd != 0
  if up then __tf_inc(p, 0) else ()
  let nchunks = __tf_chunks(p, cp, 0)
  let top = prim.load64(cp + (nchunks - 1) * 8)
  let ndigits = (nchunks - 1) * 9 + __sf_ndig(top, 1, 0)
  let int_len = if ndigits > nd then ndigits - nd else 1
  let point_w = if nd > 0 then 1 else 0
  let sign_w = if neg then 1 else 0
  let out_len = sign_w + int_len + point_w + nd
  let buf = prim.alloc_str(out_len)
  let base = prim.handle(buf) + 12
  let c0 = if neg then {
    prim.store8(base, 45)
    base + 1
  } else base
  let dot = if nd > 0 then c0 + int_len else 0
  let mid = __tf_write(cp, 0, nchunks - 1, base + out_len, dot)
  let _w = __sf_wd(top, mid, int_len + nd - (nchunks - 1) * 9, dot)
  buf
}

fn float_to_fixed(x: Float, nd: Int) -> String = {
  // ALS-T6: out-of-domain decimals abort with the 1-line message. 0..=4096
  // everywhere — the old 1e6 bound was NOT total (native `format!` caps
  // runtime precision at u16::MAX and panicked at 1e6 while this expansion
  // trapped; an f64's exact expansion never exceeds ~1074 fractional digits).
  if nd < 0 or nd > 4096 then prim.die(prim.handle("Error: to_fixed requires decimals in 0..=4096\n"))
  else ()
  let bits0 = prim.fbits(x)
  let raw_exp = prim.band(prim.bshr_u(bits0, 52), 2047)
  let raw_mant = prim.band(bits0, 4503599627370495)
  if raw_exp == 2047 then __dg_special(bits0, raw_mant) else __tf_main(bits0, nd)
}
