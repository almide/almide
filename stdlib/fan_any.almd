else match f(list.get(xs, i) ?? "") {
  ok(y) => ok(y),
  err(_) => __fan_any_ss_go(xs, f, i + 1),
}

fn fan_any_ss(xs: List[String], f: (String) -> Result[String, String]) -> Result[String, String] = __fan_any_ss_go(xs, f, 0)

