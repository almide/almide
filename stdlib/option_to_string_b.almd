// option_to_string_b — `option.to_string_b` over `Option[Bool]`, byte-matching v0's `some(true)` /
// `some(false)` / `none`. The inner Bool renders inline (no `bool.to_string` self-host dependency).
fn option_to_string_b(o: Bool?) -> String = match o {
  some(v) => "some(" + (if v then "true" else "false") + ")",
  none => "none",
}

// The SELF-HOSTED `bool.to_string` for v1, the `to_string` the uniform string
// interpolation desugar needs (`"flag=${b}"` -> `"" ++ bool.to_string(b)`).
// Pure scalar `if`, no heap, no prim floor: the two literals are the SAME bytes
// v0 emits for a Bool interpolation part, so a `${b}` interp byte-matches v0.
// It lives beside the other Bool renderer rather than in stdlib/bool.almd, so
// the bool module's public names stay out of the registry's flat namespace.
@implements("bool.to_string")
fn __bool_to_string(b: Bool) -> String = if b then "true" else "false"

// The SELF-HOSTED `bytes.__join`, the Text requirement `list.join[T: Text]`
// reaches for Bytes: language-level match / fold / bytes.__concat, no prim floor.
// It lives in this classified prim-free pure file (beside `bool.to_string`'s
// body, for the same reason) because a new stdlib file would need a new
// purity classification; bytes_split.almd reaches the prim floor, which
// would keep the wasm leg from linking a List[Bytes] signature.
@implements("bytes.__join")
fn bytes_join(xs: List[Bytes], sep: Bytes) -> Bytes = match xs {
  [] => bytes.zeros(0),
  _ => {
    // Sized once and filled in place (#4785): a fold of `__concat` copied
    // the whole accumulator at every element, O(n^2) in the total bytes.
    let k = bytes.len(sep)
    let total = list.fold(xs, 0 - k, (t, b) => t + k + bytes.len(b))
    var out = bytes.zeros(total)
    var at = 0
    var first = true
    for b in xs {
      if first then {
        first = false
      } else {
        bytes.copy_from(out, sep, at, 0, k)
        at = at + k
      }
      bytes.copy_from(out, b, at, 0, bytes.len(b))
      at = at + bytes.len(b)
    }
    out
  },
}
