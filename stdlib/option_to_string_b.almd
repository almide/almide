// option_to_string_b — `option.to_string_b` over `Option[Bool]`, byte-matching v0's `some(true)` /
// `some(false)` / `none`. The inner Bool renders inline (no `bool.to_string` self-host dependency).
fn option_to_string_b(o: Bool?) -> String = match o {
  some(v) => "some(" + (if v then "true" else "false") + ")",
  none => "none",
}

// The SELF-HOSTED `bool.to_string` for v1, the `to_string` the uniform string
// interpolation desugar needs (`"flag=${b}"` -> `"" ++ bool.to_string(b)`).
// Pure scalar `if`, no heap, no prim floor: the two literals are the SAME bytes
// v0 emits for a Bool interpolation part, so a `${b}` interp byte-matches v0.
// It lives beside the other Bool renderer rather than in stdlib/bool.almd, so
// the bool module's public names stay out of the registry's flat namespace.
@implements("bool.to_string")
fn __bool_to_string(b: Bool) -> String = if b then "true" else "false"
