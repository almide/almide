// json_get_typed — SELF-HOSTED key-based typed `json.get_<T>(j, key)` over `value.field`
// (Result[Value, String], wasm-linked) composed with the per-type `value.as_<T>` accessor
// (Result[T, String], wasm-linked): the field is fetched, then coerced to the requested
// type; a missing key OR a type mismatch yields None. Byte-identical to the
// `almide_json_get_<T>` intrinsics across all cases (absent key, present-but-wrong-type,
// present-matching, null), so the v1 trust spine lowers the ubiquitous
// `json.get_string(v,k) ?? ""` / `json.get_bool(v,k) ?? false` / `json.get_array(v,k) ?? []`
// accessor family through the PROVEN `value.field` + `value.as_*` + Option-ctor path with NO
// hand-written wasm runtime to drift from the native oracle.
//
// SHAPE: each accessor is a single `match value.field(...)` whose Ok arm tail-calls a flat
// `Result[T] -> Option[T]` adapter (`__r2o*`) — the minimal-body form the materialized-Option
// lowering admits (brick #46: a heap Option-returning named-call tail), exactly like
// json_string's `__jas_some` helper split.
fn __r2o_str(r: Result[String, String]) -> String? = match r {
  ok(s) => some(s),
  err(_) => none,
}

fn __r2o_int(r: Result[Int, String]) -> Int? = match r {
  ok(n) => some(n),
  err(_) => none,
}

fn __r2o_float(r: Result[Float, String]) -> Float? = match r {
  ok(f) => some(f),
  err(_) => none,
}

fn __r2o_bool(r: Result[Bool, String]) -> Bool? = match r {
  ok(b) => some(b),
  err(_) => none,
}

fn __r2o_arr(r: Result[List[Value], String]) -> List[Value]? = match r {
  ok(a) => some(a),
  err(_) => none,
}

fn json_get_string(j: Value, key: String) -> String? = match value.field(j, key) {
  ok(v) => __r2o_str(value.as_string(v)),
  err(_) => none,
}

fn json_get_int(j: Value, key: String) -> Int? = match value.field(j, key) {
  ok(v) => __r2o_int(value.as_int(v)),
  err(_) => none,
}

fn json_get_float(j: Value, key: String) -> Float? = match value.field(j, key) {
  ok(v) => __r2o_float(value.as_float(v)),
  err(_) => none,
}

fn json_get_bool(j: Value, key: String) -> Bool? = match value.field(j, key) {
  ok(v) => __r2o_bool(value.as_bool(v)),
  err(_) => none,
}

fn json_get_array(j: Value, key: String) -> List[Value]? = match value.field(j, key) {
  ok(v) => __r2o_arr(value.as_array(v)),
  err(_) => none,
}
