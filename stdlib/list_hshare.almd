// list_hshare — handle-SHARING accessors over a List[heap]: the result CO-OWNS its
// block (a borrowed `prim.load_handle` auto-acquires on move-out; take's per-slot
// copies rc_inc explicitly — the __lc_copy_rc convention), correct for ANY element
// layout (no deep copy, no layout assumption). The list keeps owning the originals;
// the result's own typed drop releases exactly the acquired refs.
import prim

fn __hshare_elem(h: Int, i: Int) -> List[Int] = {
  let v: List[Int] = prim.load_handle(h + 12 + i * 8)
  v
}

fn list_get_or_hshare(xs: List[List[Int]], i: Int, default: List[Int]) -> List[Int] = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  if i < 0 then default
  else if i >= len then default else __hshare_elem(h, i)
}

fn __take_h_fill(dh: Int, sh: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(sh + 12 + i * 8)
  prim.rc_inc(e)
  prim.store64(dh + 12 + i * 8, e)
  __take_h_fill(dh, sh, n, i + 1)
}

// list.drop over SHARED heap elements — the take_hshare mirror (#877): the kept
// tail's elements are rc_inc-SHARED into a fresh block; n<0 → the native
// `skip(n as usize)` wraps huge → drops ALL (empty result), n>len → empty.
fn list_take_hshare(xs: List[List[Int]], n: Int) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  // n<0 → the native `take(n as usize)` wraps huge → takes ALL (the
  // list_take_drop __clamp_len convention); the old max(n,0) diverged
  // (native take(-1) = whole list, wasm = empty).
  let k = if n < 0 then len
  else if n > len then len else n
  let out: List[List[Int]] = prim.alloc_list_str(k)
  let _x = __take_h_fill(prim.handle(out), h, k, 0)
  out
}

fn list_drop_hshare(xs: List[List[Int]], n: Int) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  let start = if n < 0 then len
  else if n > len then len else n
  let k = len - start
  let out: List[List[Int]] = prim.alloc_list_str(k)
  let _x = __drop_h_fill(prim.handle(out), h, start, k, 0)
  out
}

// list.slice over SHARED heap elements — the take/drop mirror completing the
// family: the [start, end) window's elements are rc_inc-SHARED into a fresh
// block. Bounds clamp to [0, len] and an inverted window is empty, matching
// `list_slice`'s scalar convention.
fn __drop_h_fill(dh: Int, sh: Int, start: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let e = prim.load64(sh + 12 + (start + i) * 8)
  prim.rc_inc(e)
  prim.store64(dh + 12 + i * 8, e)
  __drop_h_fill(dh, sh, start, n, i + 1)
}

// list.unique / list.dedup over FLAT-BLOCK heap elements (List[List[Int]] /
// List[(Int, Int)] — compound_eq): SLOT-WISE structural equality (length + raw
// i64 slots — exact for inline-scalar blocks), kept elements rc_inc-SHARED into an
// over-allocated block whose len is patched to the kept count (the alloc_set
// convention; cap keeps the free-list exact).
// #1532 smoke-night finding (seed 514313080935/326): this twin had INVENTED
// its own negative edges — start<0 clamped to 0 (the WHOLE list) and end<0
// to 0 — while the scalar twin, the _str twin, and the native runtime all
// follow v0's `as usize` doctrine: negative start -> EMPTY, negative end ->
// len. A recursion shrinking via `list.slice(xs, <negative>, len)` therefore
// terminated natively and looped forever on wasm (the koka_beans has_none
// mutation: native printed F in 0.3s, wasm hung). One doctrine, four
// implementations, byte-identical.
fn list_slice_hshare(xs: List[List[Int]], start: Int, end: Int) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  let e0 = if end < 0 then len
  else if end > len then len else end
  let s0 = if start < 0 then len else start
  let k = if s0 >= e0 then 0 else e0 - s0
  let out: List[List[Int]] = prim.alloc_list_str(k)
  let _x = __drop_h_fill(prim.handle(out), h, s0, k, 0)
  out
}

fn __uh_eq_at(ah: Int, bh: Int, n: Int, i: Int) -> Bool = if i >= n then true
else if prim.load64(ah + 12 + i * 8) != prim.load64(bh + 12 + i * 8) then false
else __uh_eq_at(ah, bh, n, i + 1)

fn __uh_eq(ah: Int, bh: Int) -> Bool = {
  let la = prim.load32(ah + 4)
  let lb = prim.load32(bh + 4)
  if la != lb then false
  else __uh_eq_at(ah, bh, la, 0)
}

// Store `e` into out[k] (rc-shared) UNLESS already seen — the __ivh_set_append
// shape (const-result arms); the caller advances k branchlessly by `1 - seen`.
fn __uh_seen(oh: Int, k: Int, eh: Int, i: Int) -> Int = if i >= k then 0
else {
  let hit = __uh_eq(prim.load64(oh + 12 + i * 8), eh)
  if hit then 1
  else __uh_seen(oh, k, eh, i + 1)
}

fn __uh_acquire(e: Int) -> Int = {
  prim.rc_inc(e)
  0
}

fn __uh_store(oh: Int, k: Int, e: Int, seen: Int) -> Int = if seen >= 1 then 0
else {
  prim.store64(oh + 12 + k * 8, e)
  __uh_acquire(e)
}

fn __uh_fill(sh: Int, oh: Int, n: Int, i: Int, k: Int) -> Int = if i >= n then k
else {
  let e = prim.load64(sh + 12 + i * 8)
  let seen = __uh_seen(oh, k, e, 0)
  let _s = __uh_store(oh, k, e, seen)
  __uh_fill(sh, oh, n, i + 1, k + 1 - seen)
}

fn list_unique_hshare(xs: List[List[Int]]) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let out: List[List[Int]] = prim.alloc_list_str(n)
  let oh = prim.handle(out)
  let k = __uh_fill(h, oh, n, 0, 0)
  prim.store32(oh + 4, k)
  out
}

fn __dh_last_eq(oh: Int, k: Int, e: Int) -> Int = if k > 0 then {
  let hit = __uh_eq(prim.load64(oh + 12 + (k - 1) * 8), e)
  if hit then 1 else 0
} else 0

fn __dh_fill(sh: Int, oh: Int, n: Int, i: Int, k: Int) -> Int = if i >= n then k
else {
  let e = prim.load64(sh + 12 + i * 8)
  let last_eq = __dh_last_eq(oh, k, e)
  let _s = __uh_store(oh, k, e, last_eq)
  __dh_fill(sh, oh, n, i + 1, k + 1 - last_eq)
}

// list.contains / list.index_of over FLAT-BLOCK heap elements — the same slot-wise
// `__uh_eq` structural equality, borrowing (no allocation, no copy: search only).
fn list_dedup_hshare(xs: List[List[Int]]) -> List[List[Int]] = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let out: List[List[Int]] = prim.alloc_list_str(n)
  let oh = prim.handle(out)
  let k = __dh_fill(h, oh, n, 0, 0)
  prim.store32(oh + 4, k)
  out
}

fn __lch_idx(h: Int, x: Int, n: Int, i: Int) -> Int = if i >= n then 0 - 1
else if __uh_eq(prim.load64(h + 12 + i * 8), x) then i
else __lch_idx(h, x, n, i + 1)

fn list_contains_hshare(xs: List[List[Int]], x: List[Int]) -> Bool = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let idx = __lch_idx(h, prim.handle(x), n, 0)
  idx >= 0
}

fn __lih_none() -> Int? = none

fn __lih_some(i: Int) -> Int? = some(i)

// `list.get/first/last` over a FLAT heap element (List[scalar] / scalar tuple): the
// Some payload SHARES the element (rc_inc via the Some-ctor Dup; the option's drop
// releases it — balanced like get_or_hshare). OOB → none.
fn list_index_of_hshare(xs: List[List[Int]], x: List[Int]) -> Int? = {
  let h = prim.handle(xs)
  let n = prim.load32(h + 4)
  let idx = __lch_idx(h, prim.handle(x), n, 0)
  if idx < 0 then __lih_none() else __lih_some(idx)
}

fn list_get_hshare(xs: List[List[Int]], i: Int) -> List[Int]? = {
  let h = prim.handle(xs)
  let len = prim.load32(h + 4)
  if i < 0 then none
  else if i >= len then none
  else {
    let v: List[Int] = prim.load_handle(h + 12 + i * 8)
    some(v)
  }
}

fn list_first_hshare(xs: List[List[Int]]) -> List[Int]? = list_get_hshare(xs, 0)

fn list_last_hshare(xs: List[List[Int]]) -> List[Int]? = {
  let n = prim.load32(prim.handle(xs) + 4)
  list_get_hshare(xs, n - 1)
}
