// option_map — SELF-HOSTED option.map(o, f) = o.map(f) for v1 over the prim floor + the closures
// machinery. Reads the materialized Option's len-tag (Some = len 1, None = len 0). The closure is
// invoked ONLY on the Some arm (v0 never calls f for None) — the Some arm is a CALL to a helper
// that applies f and builds Some(f(x)); the None arm builds None. SCALAR payload (Option[Int]) so
// there is no nested-heap transfer; `o` is borrowed, the result is a fresh owned Option.
// Apply f to x and wrap as Some(f(x)) — a heap-returning helper, so option_map's Some arm is a
// direct user call (the proven heap-result call-arm) and f is invoked via CallIndirect here, not in
// an OptionSome scalar position (which does not lower a closure call).
fn __opt_map_some(x: Int, f: (Int) -> Int) -> Int? = {
  let y = f(x)
  some(y)
}

fn option_map(o: Int?, f: (Int) -> Int) -> Int? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then __opt_map_some(x, f) else none
}

// option.filter(o, pred) = o.filter(pred): keep Some(x) iff pred(x), else None. Same helper shape —
// pred is invoked via CallIndirect ONLY when the Option is Some (v0 calls f only on the value). The
// kept value is the SAME x (no closure transform), so Some(x) reuses the borrowed scalar.
fn __opt_filter_some(x: Int, pred: (Int) -> Bool) -> Int? = {
  let p = pred(x)
  if p then some(x) else none
}

fn option_filter(o: Int?, pred: (Int) -> Bool) -> Int? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then __opt_filter_some(x, pred) else none
}

// option.flat_map(o, f) = o.and_then(f): Some(x) → f(x) (itself an Option), None → None. The
// closure RETURNS a heap Option, invoked via a heap-result CallIndirect ONLY on the Some arm; its
// fresh owned result is moved straight out. The helper isolates the closure call so option_flat_map's
// Some arm is a plain named call (the proven heap-result call-arm).
fn __opt_flatmap_some(x: Int, f: (Int) -> Int?) -> Int? = {
  let r = f(x)
  r
}

fn option_flat_map(o: Int?, f: (Int) -> Int?) -> Int? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then __opt_flatmap_some(x, f) else none
}

// option.unwrap_or_else(o, f) = o.unwrap_or_else(f): Some(x) → x, None → f() (a 0-arg thunk). The
// thunk is invoked via CallIndirect ONLY on the None arm (a named helper isolates the call so the
// scalar `if` arm is a plain call). Result is a SCALAR Int. `o` is borrowed.
fn __opt_unwrap_else(f: () -> Int) -> Int = f()

fn option_unwrap_or_else(o: Int?, f: () -> Int) -> Int = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then x else __opt_unwrap_else(f)
}

// option.or_else(o, f) = o.or_else(f): Some(x) → Some(x) (kept), None → f() (a 0-arg thunk itself
// returning an Option, invoked via a heap-result CallIndirect ONLY on the None arm). The kept Some
// is rebuilt from its scalar slot (Option[Int]); the helper isolates the heap-result thunk call.
fn __opt_orelse_none(f: () -> Int?) -> Int? = {
  let r = f()
  r
}

fn option_or_else(o: Int?, f: () -> Int?) -> Int? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then some(x) else __opt_orelse_none(f)
}

// option.to_result(o, msg) = o.ok_or(msg.to_string()): Some(x) → Ok(x), None → Err(a fresh COPY of
// msg). v0 copies the message (to_string), so the borrowed `msg` is NOT moved into the Result — a
// deep copy (string.repeat ·1) is, keeping single ownership (no double-free with the caller's msg).
fn __copy_str(s: String) -> String = string.repeat(s, 1)

fn option_to_result(o: Int?, msg: String) -> Result[Int, String] = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then ok(x) else err(__copy_str(msg))
}

// option.flatten(o) = o.flatten(): Some(inner) → inner, None → None. Re-reads the inner Option's
// len-tag + scalar slot and REBUILDS it (no ownership transfer — the outer keeps its inner, freed
// by the caller's DropListStr; the rebuilt Option is fresh). Some(Some(x))→Some(x), Some(None)→None.
fn __opt_flatten_inner(inner_h: Int) -> Int? = {
  let ilen = prim.load32(inner_h + 4)
  let ival = prim.load64(inner_h + 12)
  if ilen >= 1 then some(ival) else none
}

fn option_flatten(o: (Int?)?) -> Int? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let inner_h = prim.load64(h + 12)
  if len == 0 then none else __opt_flatten_inner(inner_h)
}

fn __opt_zip_some(av: Int, bv: Int) -> (Int, Int)? = {
  let t = (av, bv)
  some(t)
}

fn option_zip(a: Int?, b: Int?) -> (Int, Int)? = {
  let ah = prim.handle(a)
  let alen = prim.load32(ah + 4)
  let av = prim.load64(ah + 12)
  let bh = prim.handle(b)
  let blen = prim.load32(bh + 4)
  let bv = prim.load64(bh + 12)
  if alen == 0 then none
  else if blen == 0 then none else __opt_zip_some(av, bv)
}

// HEAP-payload twins (`option.map(some("hello"), (s) => string.to_upper(s))`): the
// scalar impls declare `f: (Int) -> Int` (an i64-result CallIndirect type), but a
// heap-mapping user closure uses the `_h` table type — the repr mismatch the router
// walled. These twins declare the closure HEAP-typed, so the dispatch type matches.
// The Some payload is a SHARED borrow into f (load_handle); f's result is fresh
// owned and moves into the some(); a bare kept payload Dups (the hshare discipline).
fn __opt_maph_some(x: String, f: (String) -> String) -> String? = {
  let y = f(x)
  some(y)
}

fn option_map_h(o: String?, f: (String) -> String) -> String? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len >= 1 then {
    let x: String = prim.load_handle(h + 12)
    __opt_maph_some(x, f)
  } else none
}

fn __opt_unwrap_else_h(f: () -> String) -> String = f()

fn option_unwrap_or_else_h(o: String?, f: () -> String) -> String = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len >= 1 then {
    let x: String = prim.load_handle(h + 12)
    x
  } else __opt_unwrap_else_h(f)
}

// HEAP-payload `option.to_result` twin: the scalar impl built the len-as-tag Result
// (Ok scalar convention), but a heap-Ok `Result[String, String]` is the CAP-AS-TAG
// block (tag @16) — the eq/match consumers misread the scalar layout. Typed heap here
// so the ok()/err() ctors build the right block. Some payload shares into ok() (Dup);
// err copies the borrowed msg (v0's to_string copy).
fn __otr_copy_str(s: String) -> String = string.repeat(s, 1)

fn option_to_result_h(o: String?, msg: String) -> Result[String, String] = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len >= 1 then {
    let x: String = prim.load_handle(h + 12)
    ok(x)
  } else err(__otr_copy_str(msg))
}

// `option.to_result` CUSTOM-E twin (#1114, the ADR-0003 D1 typed-error route): a
// SCALAR payload with a NON-String error value. The err arm CO-OWNS the caller's
// error block (Dup — the physics is one handle slot, payload-type-independent,
// exactly the `_h` family's discipline); the caller's statically-typed drop route
// frees it recursively. The String declaration is the uniform-block spelling the
// twin family uses — only the handle moves, no string op ever touches the block.
// Before this twin the type-blind registry link served the (Int?, String) body to
// EVERY scalar-A instantiation, and its `__copy_str` read a VARIANT error block as
// string bytes — `match` on the result then dispatched over a corrupt copy and
// printed NOTHING (silent wrong output, native printed the payload; the exact
// shim-v1 failure mode docs/roadmap/active/selfhost-link-v2.md names).
fn option_to_result_ve(o: Int?, e: String) -> Result[Int, String] = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  let x = prim.load64(h + 12)
  if len >= 1 then ok(x) else err(e)
}

// `option.filter` heap twin: the kept payload SHARES into some() (Dup) — the scalar
// re-wrap raw-copied the handle un-owned.
fn __opt_filterh_some(x: String, pred: (String) -> Bool) -> String? = {
  let p = pred(x)
  if p then some(x) else none
}

fn option_filter_h(o: String?, pred: (String) -> Bool) -> String? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len >= 1 then {
    let x: String = prim.load_handle(h + 12)
    __opt_filterh_some(x, pred)
  } else none
}

// `option.or_else` heap twin: the closure type matches the scalar impl by
// construction (`() -> Option[A]` is heap-result either way), but the KEPT
// payload has the same share obligation as filter/flatten — the scalar rewrap
// raw-copied the handle un-owned, a double free at scope end (fuzz
// seed-20260718 index 622: correct output, then an __rc_dec trap).
fn __opt_orelse_none_h(f: () -> String?) -> String? = {
  let r = f()
  r
}

fn option_or_else_h(o: String?, f: () -> String?) -> String? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len >= 1 then {
    let x: String = prim.load_handle(h + 12)
    some(x)
  } else __opt_orelse_none_h(f)
}

// `option.flatten` heap twin (`some(some("s"))` → `some("s")`): the inner payload
// SHARES into the rebuilt some() (Dup); the outer/inner blocks stay caller-owned.
fn option_flatten_h(o: (String?)?) -> String? = {
  let h = prim.handle(o)
  let len = prim.load32(h + 4)
  if len == 0 then none
  else {
    let inner: String? = prim.load_handle(h + 12)
    let ih = prim.handle(inner)
    let ilen = prim.load32(ih + 4)
    if ilen >= 1 then {
      let x: String = prim.load_handle(ih + 12)
      some(x)
    } else none
  }
}
