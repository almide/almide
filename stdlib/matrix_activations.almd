// matrix_activations — SELF-HOSTED softmax/gelu/etc. over the v1 Matrix (List[List[Float]]).
// The transcription oracle — v0's WASM emitter (emit_wasm/calls_matrix_p2.rs, retired in
// c71eff7b) — computed these with SCALAR arithmetic and
// `rt.math_exp` (= libm exp, the SAME musl exp `math.exp`/math_exp.almd transcribes), NOT the
// native SIMD fast-exp. So a faithful transcription in the SAME op order (row-max subtract →
// per-element exp → LEFT-TO-RIGHT sum → divide) byte-matches v0 `--target wasm`.
// Row max: init from row[0], scan the rest with `>` (NaN-safe: a NaN element leaves max).
import prim

// ── The CANONICAL fast-exp (#1197) ────────────────────────────────────────
// Transcribed op-for-op from `crates/almide-kernel/src/silu.rs::fast_exp`, the
// scalar reference every native SIMD lane is a widening of. Both legs now run
// THIS algorithm, so `matrix.softmax_rows` / `gelu` / `swiglu_gate` answer with
// the same bits on native x86_64, native aarch64 and wasm — before this the
// wasm leg used the vendored-libm exp while native used the fast-exp, which is
// the divergence #1197 measured (~1e-12 relative on softmax, amplified through
// the normalization sum).
//
// Deliberately UNFUSED (every step a separate `fmul` then `fadd`): wasm has no
// FMA instruction, and relaxed-simd's fma is spec'd as "fused OR unfused,
// implementation's choice", so a fused step anywhere re-opens the divergence.
// `fnearest` is round-ties-to-even (wasm `f64.nearest`), NOT `float.round`
// (half away from zero) — the SIMD lanes all round ties to even.
//
// exp(x) = 2^k · exp(r), k = round(x·log2e), r = x - k·ln2, exp(r) Taylor deg 6.
// Clamped to ±708: `(k + 1023) << 52` needs the biased exponent inside
// (0, 2046), and beyond it the shift wraps (the softmax -1e9 mask value used to
// corrupt whole rows).
fn __fast_exp(x0: Float) -> Float = {
  let lo = prim.fmax(x0, -708.0)
  let x = prim.fmin(lo, 708.0)
  let kf = prim.fnearest(prim.fmul(x, 1.4426950408889634))
  let r = prim.fsub(x, prim.fmul(kf, 0.6931471805599453))
  let p1 = prim.fadd(prim.fmul(0.001388888888888889, r), 0.008333333333333333)
  let p2 = prim.fadd(prim.fmul(p1, r), 0.041666666666666664)
  let p3 = prim.fadd(prim.fmul(p2, r), 0.16666666666666666)
  let p4 = prim.fadd(prim.fmul(p3, r), 0.5)
  let p5 = prim.fadd(prim.fmul(p4, r), 1.0)
  let p6 = prim.fadd(prim.fmul(p5, r), 1.0)
  let biased = prim.f2i(kf) + 1023
  prim.fmul(p6, prim.ffrombits(int.bshl(biased, 52)))
}

fn __sm_row_max(row: List[Float], n: Int, i: Int, acc: Float) -> Float = if i >= n then acc
else {
  let x = list.get(row, i) ?? acc
  __sm_row_max(row, n, i + 1, if x > acc then x else acc)
}

fn __softmax_row(row: List[Float]) -> List[Float] = {
  let n = list.len(row)
  if n == 0 then row
  else {
    let mx = __sm_row_max(row, n, 1, list.get(row, 0) ?? 0.0)
    let exps = row |> list.map((x) => __fast_exp(x - mx))
    let s = exps |> list.fold(0.0, (acc, v) => acc + v)
    if s <= 0.0 or s != s then row |> list.map((_x) => 1.0 / int.to_float(n))
    else {
      // RECIPROCAL-MULTIPLY, not divide (#1197): the native kernel scales by
      // `inv = 1.0/sum` and multiplies, and `v * (1/s)` is not `v / s` — they
      // differ by up to one ULP. After the exp and the reduction order were
      // unified this was the last byte between the legs.
      let inv = 1.0 / s
      exps |> list.map((v) => v * inv)
    }
  }
}

// gelu (tanh approximation) — element-wise. v0 (emit_wasm/calls_matrix_p2.rs "gelu"):
//   inner   = 0.7978845608028654 * (x + 0.044715 * ((x*x)*x))   // sqrt(2/π)
//   clamped = max(min(inner, 20), -20)
//   e2      = exp(2 * clamped)                                    // rt.math_exp = libm
//   tanh    = (e2 - 1) / (e2 + 1)
//   y       = 0.5 * ((1 + tanh) * x)
// The op order (and the (x*x)*x association) is transcribed exactly for a byte-match.
fn matrix_softmax_rows(m: List[List[Float]]) -> List[List[Float]] = m |> list.map((row) => __softmax_row(row))

fn __gelu_scalar(x: Float) -> Float = {
  let inner = 0.7978845608028654 * (x + 0.044715 * ((x * x) * x))
  // The native lanes' identity, spelled the same way (#1197): `1 - 2/(e2+1)`,
  // NOT the algebraically-equal `(e2-1)/(e2+1)`, which rounds differently. The
  // ±20 pre-clamp is gone with it — `__fast_exp` already saturates at ±708,
  // the same limit every SIMD lane has, and tanh is flat long before that.
  let e2 = __fast_exp(2.0 * inner)
  let t = 1.0 - 2.0 / (e2 + 1.0)
  0.5 * ((1.0 + t) * x)
}

fn __gelu_row(dh: Int, sh: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let x = prim.ffrombits(prim.load64(sh + 12 + i * 8))
  prim.store64(dh + 12 + i * 8, prim.fbits(__gelu_scalar(x)))
  __gelu_row(dh, sh, n, i + 1)
}

fn __gelu_rows(ho: Int, hm: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let rh = prim.load64(hm + 12 + i * 8)
  let c = prim.load32(rh + 4)
  let row = prim.alloc_list_f64(c)
  let _f = __gelu_row(prim.handle(row), rh, c, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __gelu_rows(ho, hm, n, i + 1)
}

// swiglu_gate(x, w_gate, w_up) — the FFN SwiGLU. x: r×d_in, weights: d_out×d_in, out: r×d_out.
//   g = Σ_k x[i,k]*w_gate[j,k]   (LEFT-TO-RIGHT accumulate)
//   u = Σ_k x[i,k]*w_up[j,k]
//   sig = 1 / (1 + exp(clamp(-g, -40, 40)))
//   out[i,j] = (g * sig) * u
// v0 (emit_wasm/calls_matrix_p2.rs "swiglu_gate"); scalar `rt.math_exp` = math.exp. Op order exact.
fn matrix_gelu(m: List[List[Float]]) -> List[List[Float]] = {
  let hm = prim.handle(m)
  let n = prim.load32(hm + 4)
  let out: List[List[Float]] = prim.alloc_list_str(n)
  let _x = __gelu_rows(prim.handle(out), hm, n, 0)
  out
}

fn __sg_dot(ah: Int, bh: Int, n: Int, k: Int, acc: Float) -> Float = if k >= n then acc
else {
  let av = prim.ffrombits(prim.load64(ah + 12 + k * 8))
  let bv = prim.ffrombits(prim.load64(bh + 12 + k * 8))
  __sg_dot(ah, bh, n, k + 1, acc + av * bv)
}

fn __sg_cell(xrow_h: Int, wg: List[List[Float]], wu: List[List[Float]], j: Int, d_in: Int) -> Float = {
  let wgj = prim.load64(prim.handle(wg) + 12 + j * 8)
  let wuj = prim.load64(prim.handle(wu) + 12 + j * 8)
  let g = __sg_dot(xrow_h, wgj, d_in, 0, 0.0)
  let u = __sg_dot(xrow_h, wuj, d_in, 0, 0.0)
  let negg = float.max(float.min(0.0 - g, 40.0), -40.0)
  let sig = 1.0 / (1.0 + __fast_exp(negg))
  (g * sig) * u
}

fn __sg_row_cells(dh: Int, xrow_h: Int, wg: List[List[Float]], wu: List[List[Float]], d_out: Int, d_in: Int, j: Int) -> Int = if j >= d_out then 0
else {
  prim.store64(dh + 12 + j * 8, prim.fbits(__sg_cell(xrow_h, wg, wu, j, d_in)))
  __sg_row_cells(dh, xrow_h, wg, wu, d_out, d_in, j + 1)
}

fn __sg_rows(ho: Int, x: List[List[Float]], wg: List[List[Float]], wu: List[List[Float]], r: Int, d_out: Int, d_in: Int, i: Int) -> Int = if i >= r then 0
else {
  let xrow_h = prim.load64(prim.handle(x) + 12 + i * 8)
  let row = prim.alloc_list_f64(d_out)
  let _c = __sg_row_cells(prim.handle(row), xrow_h, wg, wu, d_out, d_in, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __sg_rows(ho, x, wg, wu, r, d_out, d_in, i + 1)
}

// rope_rotate(x, n_heads, head_dim, theta) — RoPE. Per row p (position pos=p), per head h,
// per pair i (0..head_dim/2): rotate (x[j0], x[j0+1]) where j0 = h*head_dim + 2i, by
//   inv_freq = exp(-(2i/head_dim) * log(theta)); angle = pos * inv_freq
//   new_x0 = x0*cos - x1*sin ; new_x1 = x0*sin + x1*cos
// Non-pair elements copy through. v0 (emit_wasm/calls_matrix_p3.rs "rope_rotate"); scalar
// rt.math_{exp,log,sin,cos} = the self-hosted math.*; op order transcribed exactly.
fn matrix_swiglu_gate(x: List[List[Float]], w_gate: List[List[Float]], w_up: List[List[Float]]) -> List[List[Float]] = {
  let hx = prim.handle(x)
  let r = prim.load32(hx + 4)
  // d_in = columns = length of x's first row (0 for an empty matrix).
  let d_in = if r == 0 then 0 else prim.load32(prim.load64(hx + 12) + 4)
  let d_out = prim.load32(prim.handle(w_gate) + 4)
  let up_rows = prim.load32(prim.handle(w_up) + 4)
  // An EMPTY operand yields the EMPTY matrix, matching the native oracle's
  // `if x.is_empty() || w_gate.is_empty() || w_up.is_empty() { return vec![] }`.
  // Without the weight half of that guard this built `r` rows of width 0, so a
  // clamped-away weight matrix (C-161) gave 4x0 here and 0x0 natively
  // (differential-fuzz, seed 1784965680755102000).
  let rows = if r == 0 or d_out == 0 or up_rows == 0 then 0 else r
  let out: List[List[Float]] = prim.alloc_list_str(rows)
  let _x = __sg_rows(prim.handle(out), x, w_gate, w_up, rows, d_out, d_in, 0)
  out
}

fn __rope_copy(dh: Int, sh: Int, cols: Int, j: Int) -> Int = if j >= cols then 0
else {
  prim.store64(dh + 12 + j * 8, prim.load64(sh + 12 + j * 8))
  __rope_copy(dh, sh, cols, j + 1)
}

// A head count below 1 has no meaning, so it ABORTS with the same unified
// `Error: <msg>` + exit 1 the native `almide_rt_matrix_head_count` raises (and
// that `list.chunk` / `int.rotate_*` already use for their own domains). Before
// this, the family answered the question three different ways: native rope
// clamped negatives to 0, native rms_norm_heads clamped them to 1, native MHA
// did not guard at all (`n_heads = i32::MIN` cast to usize and hung), and these
// self-hosted bodies divided by a zero head count. Wave 5 R2.
fn __rope_pairs(dh: Int, sh: Int, pos_f: Float, head_dim_f: Float, log_theta: Float, h: Int, head_dim: Int, half: Int, i_pair: Int) -> Int = if i_pair >= half then 0
else {
  let j0 = h * head_dim + 2 * i_pair
  let x0 = prim.ffrombits(prim.load64(sh + 12 + j0 * 8))
  let x1 = prim.ffrombits(prim.load64(sh + 12 + (j0 + 1) * 8))
  let two_i_f = int.to_float(2 * i_pair)
  let inv_freq = __fast_exp(0.0 - (two_i_f / head_dim_f) * log_theta)
  let angle = pos_f * inv_freq
  let s = math.sin(angle)
  let c = math.cos(angle)
  prim.store64(dh + 12 + j0 * 8, prim.fbits(x0 * c - x1 * s))
  prim.store64(dh + 12 + (j0 + 1) * 8, prim.fbits(x0 * s + x1 * c))
  __rope_pairs(dh, sh, pos_f, head_dim_f, log_theta, h, head_dim, half, i_pair + 1)
}

fn __mx_head_count(n: Int) -> Int = {
  if n < 1 then prim.die(prim.handle("Error: head count must be positive\n")) else ()
  n
}

fn __rope_heads(dh: Int, sh: Int, pos_f: Float, head_dim_f: Float, log_theta: Float, n_heads: Int, head_dim: Int, half: Int, h: Int) -> Int = if h >= n_heads then 0
else {
  let _p = __rope_pairs(dh, sh, pos_f, head_dim_f, log_theta, h, head_dim, half, 0)
  __rope_heads(dh, sh, pos_f, head_dim_f, log_theta, n_heads, head_dim, half, h + 1)
}

fn __rope_rows(ho: Int, hx: Int, n_heads: Int, head_dim: Int, half: Int, head_dim_f: Float, log_theta: Float, cols: Int, rows: Int, p: Int) -> Int = if p >= rows then 0
else {
  let sh = prim.load64(hx + 12 + p * 8)
  let row = prim.alloc_list_f64(cols)
  let dh = prim.handle(row)
  let _cp = __rope_copy(dh, sh, cols, 0)
  let _ht = __rope_heads(dh, sh, int.to_float(p), head_dim_f, log_theta, n_heads, head_dim, half, 0)
  prim.store_str(ho + 12 + p * 8, row)
  __rope_rows(ho, hx, n_heads, head_dim, half, head_dim_f, log_theta, cols, rows, p + 1)
}

// multi_head_attention(q, k, v, n_heads) [+ causal for masked]. Per head h (col range
// col0=h*dh .. +dh), per query row i: scores[j] = scale*Σ_k q[i,col0+k]*k[j,col0+k]
// (+ -1e9 if causal && j > (sk-sq)+i); softmax row; out[i,col0+k] = Σ_j (scores[j]/sum)*v[j,col0+k].
// Heads write DISJOINT columns, so i-outer/h-inner is byte-identical to v0's h-outer/i-inner.
// v0 (emit_wasm/calls_matrix_p4.rs); scalar rt.math_exp = math.exp; op order transcribed exactly.
fn matrix_rope_rotate(x: List[List[Float]], n_heads: Int, head_dim: Int, theta: Float) -> List[List[Float]] = {
  let hx = prim.handle(x)
  let rows = prim.load32(hx + 4)
  let cols = if rows == 0 then 0 else prim.load32(prim.load64(hx + 12) + 4)
  let half = head_dim / 2
  let nh = __mx_head_count(n_heads)
  let out: List[List[Float]] = prim.alloc_list_str(rows)
  let _x = __rope_rows(prim.handle(out), hx, nh, head_dim, half, int.to_float(head_dim), math.log(theta), cols, rows, 0)
  out
}

// scores[j] for j in 0..sk. `mask` = (sk - sq) + i (causal cutoff); pass -1 to disable.
fn __mha_dot(qh: Int, kh: Int, col0: Int, dh: Int, k: Int, acc: Float) -> Float = if k >= dh then acc
else {
  let qv = prim.ffrombits(prim.load64(qh + 12 + (col0 + k) * 8))
  let kv = prim.ffrombits(prim.load64(kh + 12 + (col0 + k) * 8))
  __mha_dot(qh, kh, col0, dh, k + 1, acc + qv * kv)
}

fn __mha_scores(sch: Int, qh: Int, kmat: List[List[Float]], col0: Int, dh: Int, sk: Int, scale: Float, mask: Int, j: Int) -> Int = if j >= sk then 0
else {
  let kh = prim.load64(prim.handle(kmat) + 12 + j * 8)
  let dot = __mha_dot(qh, kh, col0, dh, 0, 0.0)
  let scaled = dot * scale
  let masked = if mask >= 0 and j > mask then scaled + (0.0 - 1000000000.0) else scaled
  prim.store64(sch + 12 + j * 8, prim.fbits(masked))
  __mha_scores(sch, qh, kmat, col0, dh, sk, scale, mask, j + 1)
}

fn __mha_max(sch: Int, sk: Int, j: Int, acc: Float) -> Float = if j >= sk then acc
else {
  let v = prim.ffrombits(prim.load64(sch + 12 + j * 8))
  __mha_max(sch, sk, j + 1, if v > acc then v else acc)
}

fn __mha_exp(sch: Int, sk: Int, mx: Float, j: Int, sum: Float) -> Float = if j >= sk then sum
else {
  let s = prim.ffrombits(prim.load64(sch + 12 + j * 8))
  let e = __fast_exp(s - mx)
  prim.store64(sch + 12 + j * 8, prim.fbits(e))
  __mha_exp(sch, sk, mx, j + 1, sum + e)
}

// out[col0+k] += w * v[j, col0+k] for k in 0..dh (w = scores[j]/sum), accumulated over j.
fn __mha_fill_one(sch: Int, sk: Int, j: Int) -> Int = if j >= sk then 0
else {
  prim.store64(sch + 12 + j * 8, prim.fbits(1.0))
  __mha_fill_one(sch, sk, j + 1)
}

fn __mha_acc_cols(oh: Int, vh: Int, col0: Int, dh: Int, w: Float, k: Int) -> Int = if k >= dh then 0
else {
  let old = prim.ffrombits(prim.load64(oh + 12 + (col0 + k) * 8))
  let vv = prim.ffrombits(prim.load64(vh + 12 + (col0 + k) * 8))
  prim.store64(oh + 12 + (col0 + k) * 8, prim.fbits(old + vv * w))
  __mha_acc_cols(oh, vh, col0, dh, w, k + 1)
}

fn __mha_out(oh: Int, sch: Int, vmat: List[List[Float]], col0: Int, dh: Int, sk: Int, sum: Float, j: Int) -> Int = if j >= sk then 0
else {
  let w = prim.ffrombits(prim.load64(sch + 12 + j * 8)) / sum
  let vh = prim.load64(prim.handle(vmat) + 12 + j * 8)
  let _c = __mha_acc_cols(oh, vh, col0, dh, w, 0)
  __mha_out(oh, sch, vmat, col0, dh, sk, sum, j + 1)
}

fn __mha_heads(oh: Int, qh: Int, kmat: List[List[Float]], vmat: List[List[Float]], nh: Int, dh: Int, sk: Int, sq: Int, i: Int, scale: Float, causal: Bool, h: Int) -> Int = if h >= nh then 0
else {
  let col0 = h * dh
  let scores = prim.alloc_list_f64(sk)
  let sch = prim.handle(scores)
  let mask = if causal then (sk - sq) + i else 0 - 1
  let _s = __mha_scores(sch, qh, kmat, col0, dh, sk, scale, mask, 0)
  let mx = __mha_max(sch, sk, 1, prim.ffrombits(prim.load64(sch + 12)))
  let sum0 = __mha_exp(sch, sk, mx, 0, 0.0)
  let bad = sum0 <= 0.0 or sum0 != sum0
  let sum = if bad then {
    let _f = __mha_fill_one(sch, sk, 0)
    int.to_float(sk)
  } else sum0
  let _o = __mha_out(oh, sch, vmat, col0, dh, sk, sum, 0)
  __mha_heads(oh, qh, kmat, vmat, nh, dh, sk, sq, i, scale, causal, h + 1)
}

fn __mha_zero(oh: Int, dm: Int, i: Int) -> Int = if i >= dm then 0
else {
  prim.store64(oh + 12 + i * 8, prim.fbits(0.0))
  __mha_zero(oh, dm, i + 1)
}

fn __mha_rows(ho: Int, qmat: List[List[Float]], kmat: List[List[Float]], vmat: List[List[Float]], nh: Int, dh: Int, dm: Int, sk: Int, sq: Int, scale: Float, causal: Bool, i: Int) -> Int = if i >= sq then 0
else {
  let qh = prim.load64(prim.handle(qmat) + 12 + i * 8)
  let row = prim.alloc_list_f64(dm)
  let oh = prim.handle(row)
  let _z = __mha_zero(oh, dm, 0)
  let _h = __mha_heads(oh, qh, kmat, vmat, nh, dh, sk, sq, i, scale, causal, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __mha_rows(ho, qmat, kmat, vmat, nh, dh, dm, sk, sq, scale, causal, i + 1)
}

fn __mha_impl(q: List[List[Float]], k: List[List[Float]], v: List[List[Float]], n_heads: Int, causal: Bool) -> List[List[Float]] = {
  let hq = prim.handle(q)
  let sq = prim.load32(hq + 4)
  let sk = prim.load32(prim.handle(k) + 4)
  let dm = if sq == 0 then 0 else prim.load32(prim.load64(hq + 12) + 4)
  let nh = __mx_head_count(n_heads)
  let dh = dm / nh
  let scale = 1.0 / float.sqrt(int.to_float(dh))
  let out: List[List[Float]] = prim.alloc_list_str(sq)
  let _x = __mha_rows(prim.handle(out), q, k, v, nh, dh, dm, sk, sq, scale, causal, 0)
  out
}

fn matrix_multi_head_attention(q: List[List[Float]], k: List[List[Float]], v: List[List[Float]], n_heads: Int) -> List[List[Float]] = __mha_impl(q, k, v, n_heads, false)

// from_q1_0_bytes(data, offset, rows, cols) — Q1_0 dequant. 18 bytes / 128 weights:
// [0..2] fp16 scale (LE), [2..18] 16 sign bytes (LSB-first). bit 1 → +scale, 0 → -scale.
// v0 (emit_wasm/calls_matrix_p4.rs "from_q1_0_bytes"); pure bit-ops (no exp). Byte data at
// handle(data)+12+offset. scale recomputed per element (block = k>>7 → identical value).
fn matrix_masked_multi_head_attention(q: List[List[Float]], k: List[List[Float]], v: List[List[Float]], n_heads: Int) -> List[List[Float]] = __mha_impl(q, k, v, n_heads, true)

// The dequantization-zero ruling (#1358, C-229): a dequantized element whose
// MAGNITUDE is zero is +0.0. A quantized element is magnitude (the block's fp16
// scale) x direction (the Q1_0 sign bit / Q8_0 int8 quant); at zero magnitude the
// bytes encode no direction, so the sign IEEE-754 hands back is an artifact of how
// the arithmetic was spelled, not of the data. Mirrors `dq_zero` in
// runtime/rs/src/matrix_p2.rs. -0.0 == 0.0, so this maps -0.0 to +0.0 and leaves
// every other value (NaN included) alone.
fn __dq_zero(v: Float) -> Float = if v == 0.0 then 0.0 else v

// Normalize an fp16 SUBNORMAL mantissa: shift left until bit 10 is set, dropping
// one from the exponent per shift — native's `while m & 0x400 == 0` loop in
// `fp16_bits_to_f32`, as a recursion. `e` enters at 1 - 15 = -14.
fn __fp16_subnormal_bits(signbits: Int, m: Int, e: Int) -> Int =
  if prim.band(m, 1024) == 0 then __fp16_subnormal_bits(signbits, prim.bshl(m, 1), e - 1)
  else prim.bor(prim.bor(signbits, prim.bshl(e + 127, 23)), prim.bshl(prim.band(m, 1023), 13))

// fp16 bit pattern -> f32 bit pattern, the exact mirror of native's
// `fp16_bits_to_f32` (runtime/rs/src/matrix_p2.rs) over the WHOLE fp16 domain:
// subnormals are normalized rather than flushed to zero, exp==31 decodes to
// Inf/NaN rather than a finite 2^16-scaled value, and a zero magnitude drops its
// sign bit per the ruling above.
fn __fp16_bits(raw: Int) -> Int = {
  let signbits = prim.bshl(prim.band(prim.bshr_u(raw, 15), 1), 31)
  let expv = prim.band(prim.bshr_u(raw, 10), 31)
  let mant = prim.band(raw, 1023)
  if expv == 0 then (if mant == 0 then 0 else __fp16_subnormal_bits(signbits, mant, 0 - 14))
  else if expv == 31 then prim.bor(prim.bor(signbits, prim.bshl(255, 23)), prim.bshl(mant, 13))
  else prim.bor(prim.bor(signbits, prim.bshl(expv + 112, 23)), prim.bshl(mant, 13))
}

fn __q10_scale(base: Int, block_start: Int) -> Float = {
  let raw = prim.bor(prim.load8(base + block_start), prim.bshl(prim.load8(base + block_start + 1), 8))
  prim.bits_to_f32(__fp16_bits(raw))
}

fn __q10_val(base: Int, k: Int) -> Float = {
  let block_start = prim.bshr_u(k, 7) * 18
  let scale = __q10_scale(base, block_start)
  let bits_start = block_start + 2
  let byte_idx = bits_start + prim.band(prim.bshr_u(k, 3), 15)
  let bit = prim.band(prim.bshr_u(prim.load8(base + byte_idx), prim.band(k, 7)), 1)
  // Every element is +scale or -scale, so canonicalizing the two branch values
  // settles the ruling for the whole block. (Native does this once per block;
  // here the scale is already recomputed per element, so this rides along.)
  if bit == 1 then __dq_zero(scale) else __dq_zero(0.0 - scale)
}

fn __q10_row(dh: Int, base: Int, row_k0: Int, cols: Int, c: Int) -> Int = if c >= cols then 0
else {
  prim.store64(dh + 12 + c * 8, prim.fbits(__q10_val(base, row_k0 + c)))
  __q10_row(dh, base, row_k0, cols, c + 1)
}

fn __q10_rows(ho: Int, base: Int, rows: Int, cols: Int, r: Int) -> Int = if r >= rows then 0
else {
  let row = prim.alloc_list_f64(cols)
  let _c = __q10_row(prim.handle(row), base, r * cols, cols, 0)
  prim.store_str(ho + 12 + r * 8, row)
  __q10_rows(ho, base, rows, cols, r + 1)
}

fn matrix_from_q1_0_bytes(data: Bytes, offset: Int, rows: Int, cols: Int) -> List[List[Float]] = {
  let base = prim.handle(data) + 12 + offset
  let out: List[List[Float]] = prim.alloc_list_str(rows)
  let _x = __q10_rows(prim.handle(out), base, rows, cols, 0)
  out
}

// select_rows_q1_0(data, offset, cols, row_ids) — the ROW-SUBSET twin of
// from_q1_0_bytes: each selected row rid (clamped to 0 like native's
// `rid.max(0)`) decodes its cols weights through the SAME `__q10_row`
// (row_k0 = rid·cols — the global-k schedule works because cols is a
// 128-multiple, so a row starts on a block boundary).
// A row whose 18-byte/128-weight blocks would read past the buffer is the
// all-zero row (`__q8_zfill`, the shared zero-filler) — the family's defined
// OOB→zeros edge, per ROW; `limit` is the absolute end of the data block.
// `offset` clamps to 0 like native's `offset.max(0)`.
fn __q10_sel_rows(ho: Int, base: Int, limit: Int, ids: List[Int], cols: Int, i: Int) -> Int = if i >= list.len(ids) then 0
else {
  let rid0 = list.get(ids, i) ?? 0
  let rid = if rid0 < 0 then 0 else rid0
  let row_bytes = cols / 128 * 18
  let row = prim.alloc_list_f64(cols)
  let _c = if base + rid * row_bytes + row_bytes > limit then __q8_zfill(prim.handle(row), cols, 0)
  else __q10_row(prim.handle(row), base, rid * cols, cols, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __q10_sel_rows(ho, base, limit, ids, cols, i + 1)
}

fn matrix_select_rows_q1_0(data: Bytes, offset: Int, cols: Int, row_ids: List[Int]) -> List[List[Float]] = {
  let hd = prim.handle(data)
  let off = if offset < 0 then 0 else offset
  let base = hd + 12 + off
  let limit = hd + 12 + prim.load32(hd + 4)
  let n = list.len(row_ids)
  let out: List[List[Float]] = prim.alloc_list_str(n)
  let _x = __q10_sel_rows(prim.handle(out), base, limit, row_ids, cols, 0)
  out
}

// select_rows_q8_0_dq(data, offset, cols, row_ids) — Q8_0 row dequant: 34 bytes
// per 32-weight block ([0..2] fp16 scale LE — decoded by the SAME `__q10_scale`
// fp16 machinery — then 32 signed int8 quants; element = scale · quant). A cols
// not divisible by 32 yields the all-zero matrix (native's guard). rid clamped
// to 0 like native's `rid.max(0)`.
fn __q8_i8(base: Int, addr: Int) -> Int = {
  let v = prim.load8(base + addr)
  if v > 127 then v - 256 else v
}

fn __q8_row(dh: Int, base: Int, row_off: Int, cols: Int, c: Int) -> Int = if c >= cols then 0
else {
  let blk = prim.bshr_u(c, 5)
  let block_start = row_off + blk * 34
  let scale = __q10_scale(base, block_start)
  let q = __q8_i8(base, block_start + 2 + prim.band(c, 31))
  // Q8_0 needs the ruling per ELEMENT, not per block: the product is zero when
  // EITHER factor is (a zero scale, or a zero quant under a negative scale),
  // and `a * b` signs by xor.
  prim.store64(dh + 12 + c * 8, prim.fbits(__dq_zero(scale * int.to_float(q))))
  __q8_row(dh, base, row_off, cols, c + 1)
}

// A row whose 34-byte/32-weight blocks would read past the buffer is the
// all-zero row — the same defined edge as the non-multiple-cols guard in the
// opener; `limit` is the absolute end of the data block. `offset` clamps to 0
// like native's `offset.max(0)`.
fn __q8_sel_rows(ho: Int, base: Int, limit: Int, ids: List[Int], cols: Int, row_bytes: Int, i: Int) -> Int = if i >= list.len(ids) then 0
else {
  let rid0 = list.get(ids, i) ?? 0
  let rid = if rid0 < 0 then 0 else rid0
  let row = prim.alloc_list_f64(cols)
  let _c = if base + rid * row_bytes + row_bytes > limit then __q8_zfill(prim.handle(row), cols, 0)
  else __q8_row(prim.handle(row), base, rid * row_bytes, cols, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __q8_sel_rows(ho, base, limit, ids, cols, row_bytes, i + 1)
}

fn matrix_select_rows_q8_0_dq(data: Bytes, offset: Int, cols: Int, row_ids: List[Int]) -> List[List[Float]] = {
  let hd = prim.handle(data)
  let off = if offset < 0 then 0 else offset
  let base = hd + 12 + off
  let limit = hd + 12 + prim.load32(hd + 4)
  let n = list.len(row_ids)
  if cols % 32 != 0 then __q8_zeros(n, cols)
  else {
    let out: List[List[Float]] = prim.alloc_list_str(n)
    let row_bytes = cols / 32 * 34
    let _x = __q8_sel_rows(prim.handle(out), base, limit, row_ids, cols, row_bytes, 0)
    out
  }
}

fn __q8_zfill(dh: Int, cols: Int, c: Int) -> Int = if c >= cols then 0
else {
  prim.store64(dh + 12 + c * 8, 0)
  __q8_zfill(dh, cols, c + 1)
}

fn __q8_zero_rows(ho: Int, n: Int, cols: Int, i: Int) -> Int = if i >= n then 0
else {
  let row = prim.alloc_list_f64(cols)
  let _z = __q8_zfill(prim.handle(row), cols, 0)
  prim.store_str(ho + 12 + i * 8, row)
  __q8_zero_rows(ho, n, cols, i + 1)
}

fn __q8_zeros(n: Int, cols: Int) -> List[List[Float]] = {
  let out: List[List[Float]] = prim.alloc_list_str(n)
  let _x = __q8_zero_rows(prim.handle(out), n, cols, 0)
  out
}
