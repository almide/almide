// io_read_byte — SELF-HOSTED `io.read_byte()` over the WASI fd-0 byte floor
// (prim.read_n_bytes), the io.read_n_bytes machinery narrowed to one byte:
// read exactly 1 byte from stdin, returning it as 0..255, or -1 on EOF (the
// native oracle's `read(&mut [0u8;1])` contract — `Ok(1)` yields the byte,
// anything else -1). The Bytes block's length field (@4) distinguishes the
// two: a short read leaves it 0. Reaching prim.read_n_bytes carries
// Capability::Stdin.
fn io_read_byte() -> Int = {
  let b = prim.read_n_bytes(1)
  let h = prim.handle(b)
  if prim.load32(h + 4) < 1 then 0 - 1 else prim.load8(h + 12)
}
