// string_take_drop — SELF-HOSTED `string.take/drop/take_end/drop_end` for v1 over the
// prim floor. All four are CODEPOINT-indexed (#419), matching v0's `chars()` adapters:
//   take(s, n)      = s.chars().take(n)   — the first n codepoints
//   drop(s, n)      = s.chars().skip(n)   — all but the first n
//   take_end(s, n)  = the last n codepoints
//   drop_end(s, n)  = all but the last n
// v0 casts n to usize, so a NEGATIVE n becomes a huge count: take treats n<0 as "take
// all", drop as "drop all" (→ empty), take_end as "the whole string", drop_end as
// "drop all" (→ empty). Each fn reduces to two codepoint indices [lo, hi) and copies
// that UTF-8 byte range — self-contained (no other stdlib call, since the production
// auto-linker is single-pass), mirroring string_slice's proven walk.
fn __td_skip(addr: Int, end: Int) -> Int = if addr >= end then addr
else if prim.load8(addr) / 64 == 2 then __td_skip(addr + 1, end) else addr

// Byte address of the k-th codepoint start at/after `addr`.
fn __td_offset(addr: Int, end: Int, k: Int) -> Int = if k <= 0 then addr
else if addr >= end then addr
else {
  let next = __td_skip(addr + 1, end)
  __td_offset(next, end, k - 1)
}

fn __td_copy(src: Int, dst: Int, len: Int) -> Int = if len <= 0 then dst
else {
  prim.store8(dst, prim.load8(src))
  __td_copy(src + 1, dst + 1, len - 1)
}

// Byte address of the k-th codepoint start counted back from `addr` (the end
// of the string, or a codepoint start), never below `base`: a scan of the
// last k codepoints only. `take_end` / `drop_end` used to count every
// codepoint of the string first — O(len) to cut a short tail (#3542).
fn __td_back(base: Int, addr: Int, k: Int) -> Int = if k <= 0 then addr
else if addr <= base then base
else {
  let p = addr - 1
  if prim.load8(p) / 64 == 2 then __td_back(base, p, k)
  else __td_back(base, p, k - 1)
}

// The bytes [lo, hi) as a fresh owned String.
fn __td_bytes(lo: Int, hi: Int) -> String = {
  let nbytes = if hi > lo then hi - lo else 0
  let buf = prim.alloc_str(nbytes)
  let _e = __td_copy(lo, prim.handle(buf) + 12, nbytes)
  buf
}

// Each fn walks only as far as its own cut: `take` / `drop` the first n
// codepoints forward from the start, `take_end` / `drop_end` the last n back
// from the end — n past the count stops at the edge, as before.
fn string_take(s: String, n: Int) -> String = {
  let h = prim.handle(s)
  let base = h + 12
  let end = base + prim.load32(h + 4)
  let cut = if n < 0 then end else __td_offset(base, end, n)
  __td_bytes(base, cut)
}

fn string_drop(s: String, n: Int) -> String = {
  let h = prim.handle(s)
  let base = h + 12
  let end = base + prim.load32(h + 4)
  let cut = if n < 0 then end else __td_offset(base, end, n)
  __td_bytes(cut, end)
}

fn string_take_end(s: String, n: Int) -> String = {
  let h = prim.handle(s)
  let base = h + 12
  let end = base + prim.load32(h + 4)
  let cut = if n < 0 then base else __td_back(base, end, n)
  __td_bytes(cut, end)
}

fn string_drop_end(s: String, n: Int) -> String = {
  let h = prim.handle(s)
  let base = h + 12
  let end = base + prim.load32(h + 4)
  let cut = if n < 0 then base else __td_back(base, end, n)
  __td_bytes(base, cut)
}
