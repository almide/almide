// int_wrap — SELF-HOSTED wrapping arithmetic + unsigned narrowing for v1 (pure scalar).
// wrap_add(a, b) = a +w b and wrap_mul(a, b) = a *w b over the 64-bit register
// (R-int-12; wasm i64 add/mul already wrap = u64 wrap); an N-bit register composes
// with int.wrap.
//   to_u32(n) = n & 0xFFFFFFFF,  to_u8(n) = n & 0xFF     (zero-extended low bits)
// Composed from the prim bitwise floor (band); cert-untouching (scalar).
fn int_wrap_add(a: Int, b: Int) -> Int = a + b

fn int_wrap_mul(a: Int, b: Int) -> Int = a * b

fn int_to_u32(n: Int) -> Int = prim.band(n, 4294967295)

fn int_to_u8(n: Int) -> Int = prim.band(n, 255)
