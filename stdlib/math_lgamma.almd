// Self-hosted math.log_gamma — Lanczos approximation (g=7, n=9), bit-exact to v0.
//
// Mirrors runtime/rs/src/math.rs `almide_rt_math_log_gamma`: Γ(x+1) via Lanczos,
// input shifted by -1. The two natural-log terms route through the self-hosted
// math.log (same vendored libm log v0 uses), so the result byte-matches v0.
//
// Below x = 0.5 the series is not valid (#2493: log_gamma(-0.5) was NaN,
// log_gamma(-6.5) inf), so the REFLECTION formula
// `ln|Γ(x)| = ln(π / |sin(πx)|) - ln Γ(1 - x)` moves the work to 1 - x > 0.5, with
// |sin(πx)| taken on the reduced fraction min(f, 1 - f), f = frac(|x|) (both exact),
// through the self-hosted math.sin (the vendored libm sin v0 uses). The non-positive
// integers are poles (+inf), as are -inf and +inf; NaN stays NaN. The op sequence is
// v0's, op for op — see the native doc comment for the reasoning.
//
// Float constants are materialized via prim.ffrombits(<exact i64 bits>) — decimal
// literals drift ~1 ULP. The accumulation order matches Rust left-assoc exactly.
fn __lgamma_lanczos(x0: Float) -> Float = {
  let x = x0 - 1.0
  let c0 = prim.ffrombits(4607182418800015696)
  let c1 = prim.ffrombits(4649161951908399877)
  let c2 = prim.ffrombits(0 - 4570119468569323749)
  let c3 = prim.ffrombits(4649995848448718040)
  let c4 = prim.ffrombits(0 - 4582953931388014755)
  let c5 = prim.ffrombits(4623230626370919553)
  let c6 = prim.ffrombits(0 - 4629211466700216235)
  let c7 = prim.ffrombits(4532011357038326351)
  let c8 = prim.ffrombits(4504784147394309871)
  // ag = c0 + Σ c[i+1] / (x + (i+1)), i = 0..7 (left-assoc accumulation)
  let ag = c0 + c1 / (x + 1.0) + c2 / (x + 2.0) + c3 / (x + 3.0) + c4 / (x + 4.0) + c5 / (x + 5.0) + c6 / (x + 6.0) + c7 / (x + 7.0) + c8 / (x + 8.0)
  let t = x + 7.5
  let half_ln_2pi = prim.ffrombits(4606452282016710324)
  let lt = math.log(t)
  let lag = math.log(ag)
  half_ln_2pi + (x + 0.5) * lt - t + lag
}

// ln(π / s) - ln Γ(1 - x), for s = |sin(πx)| > 0.
fn __lgamma_reflect_finite(x: Float, s: Float, pi: Float) -> Float = {
  let q = prim.fdiv(pi, s)
  let l = math.log(q)
  let w = prim.fsub(1.0, x)
  let g = __lgamma_lanczos(w)
  prim.fsub(l, g)
}

// x < 0.5 (or -inf): the reflection branch. `pos` false = a pole (s = 0) or -inf (s NaN).
fn __lgamma_reflect(x: Float) -> Float = {
  let neg = prim.flt(x, 0.0)
  let y = if neg then prim.fneg(x) else x
  let fl = prim.ffloor(y)
  let f0 = prim.fsub(y, fl)
  let hi = prim.fgt(f0, 0.5)
  let f = if hi then prim.fsub(1.0, f0) else f0
  let pi = prim.ffrombits(4614256656552045848)
  let arg = prim.fmul(pi, f)
  let s = math.sin(arg)
  let pos = prim.fgt(s, 0.0)
  if pos then __lgamma_reflect_finite(x, s, pi)
  else prim.ffrombits(9218868437227405312)
}

fn math_log_gamma(x0: Float) -> Float = {
  let small = prim.flt(x0, 0.5)
  let pinf = prim.ffrombits(9218868437227405312)
  let top = prim.feq(x0, pinf)
  if small then __lgamma_reflect(x0)
  else if top then pinf else __lgamma_lanczos(x0)
}
