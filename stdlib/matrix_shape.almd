// matrix_shape — SELF-HOSTED `matrix.shape` for v1: `(rows, cols)` as a flat scalar
// tuple over the DynListStr matrix block (outer len@4 = rows; row 0's len@4 = cols;
// (0, 0) for the empty matrix — matrix_cols' convention). This is a SEPARATE file from
// matrix_core.almd on purpose: both callees (matrix.rows / matrix.cols) live THERE, so
// calling them from here is cross-file (an intra-file module call would re-trigger the
// auto-linker forever). Pure; the result is a fresh owned 2-slot tuple block.
fn matrix_shape(m: Matrix) -> (Int, Int) = {
  let r = matrix.rows(m)
  let c = matrix.cols(m)
  (r, c)
}

// concat_rows / zip_with (R-matrix-11, R-matrix-09), prim-free like the rest of
// this file: compositions of public matrix.* calls, all served cross-file.
//
// concat_rows: native folds append_rows over the list from the 0 x 0 matrix.
// The same fold, by recursion (no capturing lambda in a bundled module, #892).
fn __matrix_concat_rows_go(xs: List[Matrix], i: Int, acc: Matrix) -> Matrix = match list.get(xs, i) {
  some(m) => __matrix_concat_rows_go(xs, i + 1, matrix.append_rows(acc, m)),
  none => acc,
}

@implements("matrix.concat_rows")
fn __matrix_concat_rows(xs: List[Matrix]) -> Matrix = __matrix_concat_rows_go(
  xs,
  0,
  matrix.from_lists([]),
)

fn __matrix_zip_row(ra: List[Float], rb: List[Float], f: (Float, Float) -> Float, i: Int, acc: List[Float]) -> List[Float] = match (list.get(
  ra,
  i,
), list.get(rb, i)) {
  (some(x), some(y)) => __matrix_zip_row(ra, rb, f, i + 1, acc + [f(x, y)]),
  _ => acc,
}

fn __matrix_zip_rows(la: List[List[Float]], lb: List[List[Float]], f: (Float, Float) -> Float, i: Int, acc: List[List[Float]]) -> List[List[Float]] = match (list.get(
  la,
  i,
), list.get(lb, i)) {
  (some(ra), some(rb)) => __matrix_zip_rows(
    la,
    lb,
    f,
    i + 1,
    acc + [
      __matrix_zip_row(ra, rb, f, 0, [])
    ],
  ),
  _ => acc,
}

// The extent check aborts with the family's own line (native's shape_eq),
// prim-free: append_rows aborts on two one-row operands of different widths,
// so a one-row probe per extent checks rows, then cols. The probes' widths
// feed the result's guard, so neither call is dead code.
@implements("matrix.zip_with")
fn __matrix_zip_with(a: Matrix, b: Matrix, f: (Float, Float) -> Float) -> Matrix = {
  let rows_probe = matrix.append_rows(
    matrix.zeros(1, matrix.rows(a)),
    matrix.zeros(1, matrix.rows(b)),
  )
  let cols_probe = matrix.append_rows(
    matrix.zeros(1, matrix.cols(a)),
    matrix.zeros(1, matrix.cols(b)),
  )
  if matrix.cols(rows_probe) + matrix.cols(cols_probe) < 0 then a
  else matrix.from_lists(__matrix_zip_rows(matrix.to_lists(a), matrix.to_lists(b), f, 0, []))
}

// to_bytes_f16_le: native (matrix_p2.rs almide_f64_to_f16_bits) rounds each
// f64 straight to IEEE half, to nearest even, overflow to +-inf, a NaN to the
// canonical 0x7E00. The same integer steps here, prim-free.
fn __matrix_f16_bits(x: Float) -> Int = {
  let bits = float.to_bits(x)
  let sign = if bits < 0 then 32768 else 0
  let exp = int.band(int.bshr(bits, 52), 2047)
  let mant = int.band(bits, 4503599627370495)
  if exp == 2047 then (if mant != 0 then 32256 else sign + 31744)
  else if exp == 0 then sign
  else {
    let e = exp - 1023 + 15
    let m = 4503599627370496 + mant
    let shift = if e >= 1 then 42 else 42 + (1 - e)
    if shift > 53 then sign
    else {
      let q0 = int.bshr(m, shift)
      let r = int.band(m, int.bshl(1, shift) - 1)
      let half = int.bshl(1, shift - 1)
      let q = if r > half or (r == half and int.band(q0, 1) == 1) then q0 + 1 else q0
      let out = if e >= 1 then int.bshl(e, 10) + (q - 1024) else q
      if out >= 31744 then sign + 31744 else sign + out
    }
  }
}

fn __matrix_f16_row(row: List[Float], i: Int, acc: List[Int]) -> List[Int] = match list.get(row, i) {
  some(x) => {
    let h = __matrix_f16_bits(x)
    __matrix_f16_row(row, i + 1, acc + [int.band(h, 255), int.bshr(h, 8)])
  },
  none => acc,
}

fn __matrix_f16_rows(rows: List[List[Float]], i: Int, acc: List[Int]) -> List[Int] = match list.get(
  rows,
  i,
) {
  some(row) => __matrix_f16_rows(rows, i + 1, __matrix_f16_row(row, 0, acc)),
  none => acc,
}

@implements("matrix.to_bytes_f16_le")
fn __matrix_to_bytes_f16_le(m: Matrix) -> Bytes = bytes.from_list(__matrix_f16_rows(matrix.to_lists(m), 0, []))
