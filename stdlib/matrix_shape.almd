// matrix_shape — SELF-HOSTED `matrix.shape` for v1: `(rows, cols)` as a flat scalar
// tuple over the DynListStr matrix block (outer len@4 = rows; row 0's len@4 = cols;
// (0, 0) for the empty matrix — matrix_cols' convention). This is a SEPARATE file from
// matrix_core.almd on purpose: both callees (matrix.rows / matrix.cols) live THERE, so
// calling them from here is cross-file (an intra-file module call would re-trigger the
// auto-linker forever). Pure; the result is a fresh owned 2-slot tuple block.
fn matrix_shape(m: Matrix) -> (Int, Int) = {
  let r = matrix.rows(m)
  let c = matrix.cols(m)
  (r, c)
}

// concat_rows / zip_with (R-matrix-11, R-matrix-09), prim-free like the rest of
// this file: compositions of public matrix.* calls, all served cross-file.
//
// concat_rows: native's one pass (#4770: a fold of append_rows copied the
// accumulator per member). Before the first non-empty member the answer is
// the last member seen; after it, each non-empty member's width is checked by
// append_rows on two one-row probes where it differs (its abort line), and
// its rows appended.
@implements("matrix.concat_rows")
fn __matrix_concat_rows(xs: List[Matrix]) -> Matrix = {
  var out = matrix.from_lists([])
  var rows: List[List[Float]] = []
  var cols = 0
  var started = false
  for m in xs {
    if matrix.rows(m) == 0 then {
      if started then ()
      else {
        out = m
      }
    } else if started then {
      if matrix.cols(m) != cols then {
        let probe = matrix.__append_rows(matrix.zeros(1, cols), matrix.zeros(1, matrix.cols(m)))
        cols = matrix.cols(probe)
      } else ()
      if list.is_empty(rows) then {
        rows = matrix.to_lists(out)
      } else ()
      for r in matrix.to_lists(m) {
        list.push(rows, r)
      }
    } else {
      started = true
      out = m
      cols = matrix.cols(m)
    }
  }
  // One member with rows is the answer itself, as the fold's first step.
  if list.is_empty(rows) then out else matrix.from_lists(rows)
}

// zip_with's rows, one pass: `acc + [row]` on a recursion param copied the
// accumulator per row (#4786).
fn __matrix_zip_rows(la: List[List[Float]], lb: List[List[Float]], f: (Float, Float) -> Float) -> List[List[Float]] = {
  var out: List[List[Float]] = []
  for i in 0..<list.len(la) {
    match (list.get(la, i), list.get(lb, i)) {
      (some(ra), some(rb)) => list.push(out, list.zip_with(ra, rb, f)),
      _ => (),
    }
  }
  out
}

@implements("matrix.zip_with")
fn __matrix_zip_with(a: Matrix, b: Matrix, f: (Float, Float) -> Float) -> Matrix = {
  let rows_probe = matrix.__append_rows(
    matrix.zeros(1, matrix.rows(a)),
    matrix.zeros(1, matrix.rows(b)),
  )
  let cols_probe = matrix.__append_rows(
    matrix.zeros(1, matrix.cols(a)),
    matrix.zeros(1, matrix.cols(b)),
  )
  if matrix.cols(rows_probe) + matrix.cols(cols_probe) < 0 then a
  else matrix.from_lists(__matrix_zip_rows(matrix.to_lists(a), matrix.to_lists(b), f))
}

// to_bytes_f16_le: native (matrix_p2.rs almide_f64_to_f16_bits) rounds each
// f64 straight to IEEE half, to nearest even, overflow to +-inf, a NaN to the
// canonical 0x7E00 — the integer steps of `bytes.__f16_bits`, which every
// bytes f16 writer shares, prim-free.
fn __matrix_f16_bits(x: Float) -> Int = bytes.__f16_bits(x)

// One pass into one list (#4775): an `acc + [..]` recursion param copied the
// accumulator per element.
fn __matrix_f16_codes(rows: List[List[Float]]) -> List[Int] = {
  var out: List[Int] = []
  for row in rows {
    for x in row {
      let h = __matrix_f16_bits(x)
      list.push(out, int.band(h, 255))
      list.push(out, int.bshr(h, 8))
    }
  }
  out
}

@implements("matrix.to_bytes_f16_le")
fn __matrix_to_bytes_f16_le(m: Matrix) -> Bytes = bytes.from_list(__matrix_f16_codes(matrix.to_lists(m)))
