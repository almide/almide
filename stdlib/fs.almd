// fs — bundled-Almide stdlib module (Stdlib Declarative Unification Stage 4c).
//
// Migrated mechanically from `stdlib/defs/fs.toml` (27 fns + the
// `FileStat` record). Runtime impls stay in `runtime/rs/src/fs.rs`.
//
// Runtime ABI: every `path` / `content` / `src` / `dst` / `prefix` /
// `dir` / `pattern` param on the runtime side takes owned `String`,
// so the templates pass arguments by value. The TOML's `&*{path}`
// looked like a borrow but was really an `ArgTransform::Direct`
// signal (runtime string → owned); the bundled path writes the
// owned form directly so no special-case stripping is needed.
/// Path metadata; modified is Unix seconds.
type FileStat = { size: Int, is_dir: Bool, is_file: Bool, modified: Int }

// The whole-file readers (read_text / read_bytes / read_lines /
// read_bytes_raw and their _if_exists twins) read a REGULAR file of at most
// 1 GiB (1073741824 bytes), on every leg (#4201, C-422): a device, FIFO or
// socket errs `fs.<call>("<path>"): Not a regular file` without blocking, a
// larger file errs `File too large (the read limit is 1073741824 bytes)`, a
// directory keeps its EISDIR. A bigger file streams through fold_lines.
/// Whole regular file (<= 1 GiB) as UTF-8; err if missing or not UTF-8.
@intrinsic("almide_rt_fs_read_text")
effect fn read_text(path: String) -> Result[String, String] = _

/// Bytes as Ints 0..255; regular file <= 1 GiB; err if missing.
@intrinsic("almide_rt_fs_read_bytes")
effect fn read_bytes(path: String) -> Result[List[Int], String] = _

/// Overwrites or creates; err if no parent dir.
@ordered
@intrinsic("almide_rt_fs_write")
@category("FS.write")
effect fn write(path: String, content: String) -> Result[Unit, String] = _

/// Writes low byte of each Int (-1 -> 255).
@ordered
@intrinsic("almide_rt_fs_write_bytes")
@category("FS.write")
effect fn write_bytes(path: String, bytes: List[Int]) -> Result[Unit, String] = _

/// Writes data verbatim, replacing the file.
@ordered
@intrinsic("almide_rt_fs_write_bytes_raw")
@category("FS.write")
effect fn write_bytes_raw(path: String, data: Bytes) -> Result[Unit, String] = _

/// Appends content; creates the file if missing.
@ordered
@intrinsic("almide_rt_fs_append")
@category("FS.write")
effect fn append(path: String, content: String) -> Result[Unit, String] = _

/// Creates dir and parents; ok if it exists.
@ordered
@intrinsic("almide_rt_fs_mkdir_p")
@category("FS.write")
effect fn mkdir_p(path: String) -> Result[Unit, String] = _

/// False if missing or a dangling symlink.
@intrinsic("almide_rt_fs_exists")
effect fn exists(path: String) -> Bool = _

/// CRLF-aware lines of a regular file <= 1 GiB; a final newline adds no line.
@intrinsic("almide_rt_fs_read_lines")
effect fn read_lines(path: String) -> Result[List[String], String] = _

// Streaming line readers: walk the file line-by-line without materializing a
// List[String] — peak memory is O(longest line), not O(file). Line semantics
// byte-match read_lines. The family is exactly {fold_lines, for_each_line,
// fold_lines_range, fold_lines_chunked} (tests/fs_streaming_family_gate):
// map/filter over lines are intentional omissions (a transforming pipeline
// belongs on fold_lines; an eager List belongs to read_lines), and for_each
// has no range/chunked cell (chunk workers accumulate — fold is their shape).
//
// ADR-0006 fallible callback forms (#1144): the two CALLBACK-DRIVEN cells
// carry them — `fs.fold_lines(p, z, (a, l) => g(a, l)!)!` and
// `fs.for_each_line(p, (l) => g(l)!)!` route to the `__fallible_*` carriers
// below, which stop the reader at the first err (the callback is not invoked
// again and the rest of the file is never read). The range/chunked cells do
// NOT have fallible forms: a chunk worker's err has no defined stop point
// across a parallel partition (which chunk's err wins is a thread-schedule
// observable), so an erring chunk body handles its own error — an intentional
// omission the family gate pins.
/// Streamed fold over lines; err if missing.
@intrinsic("almide_rt_fs_fold_lines")
effect fn fold_lines[A](path: String, init: A, f: (A, String) -> A) -> Result[A, String] = _

/// Calls f per line, streamed; may err mid-file.
@intrinsic("almide_rt_fs_for_each_line")
effect fn for_each_line(path: String, f: (String) -> Unit) -> Result[Unit, String] = _

// The ADR-0006 fallible carriers. NOT spellings: the checker rewrites
// `fs.fold_lines`/`fs.for_each_line` to these when the callback is fallible
// (`infer_calls_closures.rs::normalize_fallible_hof_callback`), exactly as
// `list.map` becomes `list.__fallible_map`; naming one in source is E043.
// The error is `String`, not generic: the walk's own read error (a missing
// file) shares the callback's channel, and a read error has no value of a
// user error type — so a callback here is checked against a `String` channel
// (ADR-0021 D1-1) and a typed `!` in it erases to its Debug text.
@intrinsic("almide_rt_fs_fold_lines_effect")
effect fn __fallible_fold_lines[A](path: String, init: A, f: (A, String) -> Result[A, String]) -> Result[A, String] = _

@intrinsic("almide_rt_fs_for_each_line_effect")
effect fn __fallible_for_each_line(path: String, f: (String) -> Result[Unit, String]) -> Result[Unit, String] = _

// The chunk worker's walker: fold exactly the lines owned by the byte range
// [start, end) — a line belongs to the chunk containing the byte before its
// first byte — so folding a partition of [0, file_size) visits every line
// exactly once, and per-chunk partials merge afterwards.
/// Folds lines starting in bytes [start, end).
@intrinsic("almide_rt_fs_fold_lines_range")
effect fn fold_lines_range[A](path: String, start: Int, end: Int, init: A, f: (A, String) -> A) -> Result[A, String] = _

// Chunk-PARALLEL fold: N workers each fold their byte-range partition on
// real threads inside the runtime, returning the partials in CHUNK ORDER —
// the merge stays with the caller, so the result is deterministic whatever
// the thread schedule. The callback must not reach mutable state:
// `@concurrent(f)` makes a callback that reaches a `var` E008 at check, on
// every target (the wasm leg runs the chunks sequentially and would accept it).
/// Parallel chunk partials, in order; [] if empty.
@concurrent(f)
@intrinsic("almide_rt_fs_fold_lines_chunked")
effect fn fold_lines_chunked[A](path: String, workers: Int, init: A, f: (A, String) -> A) -> Result[List[A], String] = _

// Absence-as-Option content readers (#1106 / ADR-0004 D4): none ⇔ the path
// does not exist (parents included); err = permission / directory / IO. The
// family covers exactly the content readers — metadata (stat/file_size/
// modified_at) and directory ops (list_dir/walk/glob) keep their exists/
// is_dir predicates, writes create, and remove/remove_all err on a missing
// path on every leg (there is no rm -f form); those omissions are
// intentional (tests/fs_if_exists_family_gate). A FIFO, a device or a file
// over 1 GiB is an err, never none (#4201, the plain readers' bound).
/// Text, or none if missing; err if not UTF-8.
@intrinsic("almide_rt_fs_read_text_if_exists")
effect fn read_text_if_exists(path: String) -> Result[String?, String] = _

/// Bytes as Ints, or none if missing.
@intrinsic("almide_rt_fs_read_bytes_if_exists")
effect fn read_bytes_if_exists(path: String) -> Result[List[Int]?, String] = _

/// read_lines result, or none if missing.
@intrinsic("almide_rt_fs_read_lines_if_exists")
effect fn read_lines_if_exists(path: String) -> Result[List[String]?, String] = _

/// File Bytes, or none if missing.
@intrinsic("almide_rt_fs_read_bytes_raw_if_exists")
effect fn read_bytes_raw_if_exists(path: String) -> Result[Bytes?, String] = _

/// Deletes a file or empty dir; err if missing.
@ordered
@intrinsic("almide_rt_fs_remove")
@category("FS.write")
effect fn remove(path: String) -> Result[Unit, String] = _

/// Sorted names (not paths); err if not a dir.
@intrinsic("almide_rt_fs_list_dir")
effect fn list_dir(path: String) -> Result[List[String], String] = _

/// True for a dir; follows symlinks.
@intrinsic("almide_rt_fs_is_dir")
effect fn is_dir(path: String) -> Bool = _

/// True for a regular file; follows symlinks.
@intrinsic("almide_rt_fs_is_file")
effect fn is_file(path: String) -> Bool = _

/// Copies src to dst; overwrites dst.
@ordered
@intrinsic("almide_rt_fs_copy")
@category("FS.read", "FS.write")
effect fn copy(src: String, dst: String) -> Result[Unit, String] = _

/// Moves src to dst; replaces an existing dst.
@ordered
@intrinsic("almide_rt_fs_rename")
@category("FS.write")
effect fn rename(src: String, dst: String) -> Result[Unit, String] = _

/// Sorted paths below dir; links listed, not followed.
@intrinsic("almide_rt_fs_walk")
effect fn walk(dir: String) -> Result[List[String], String] = _

/// Deletes a tree or file; err if missing.
@ordered
@intrinsic("almide_rt_fs_remove_all")
@category("FS.write")
effect fn remove_all(path: String) -> Result[Unit, String] = _

/// Size in bytes; err if missing.
@intrinsic("almide_rt_fs_file_size")
effect fn file_size(path: String) -> Result[Int, String] = _

// Effect fn: the answer is a host read (`$TMPDIR` / GetTempPath), not a
// constant — the bare-`fn` spelling was a misdeclaration (env.temp_dir was
// always declared effect).
/// Host temp dir; a location, not a safe name.
@intrinsic("almide_rt_fs_temp_dir")
effect fn temp_dir() -> String = _

/// Size, kind and mtime; err if missing.
@intrinsic("almide_rt_fs_stat")
effect fn stat(path: String) -> Result[FileStat, String] = _

/// Sorted * and ** matches; links not followed.
@intrinsic("almide_rt_fs_glob")
effect fn glob(pattern: String) -> Result[List[String], String] = _

/// New private file, random name; its path.
@ordered
@intrinsic("almide_rt_fs_create_temp_file")
@category("FS.write")
effect fn create_temp_file(prefix: String) -> Result[String, String] = _

/// New private dir, random name; its path.
@ordered
@intrinsic("almide_rt_fs_create_temp_dir")
@category("FS.write")
effect fn create_temp_dir(prefix: String) -> Result[String, String] = _

/// True for a symlink, even a dangling one.
@intrinsic("almide_rt_fs_is_symlink")
effect fn is_symlink(path: String) -> Bool = _

/// Mtime in Unix seconds; err if missing.
@intrinsic("almide_rt_fs_modified_at")
effect fn modified_at(path: String) -> Result[Int, String] = _

/// Whole regular file (<= 1 GiB) as Bytes; err if missing.
@intrinsic("almide_rt_fs_read_bytes_raw")
effect fn read_bytes_raw(path: String) -> Result[Bytes, String] = _

// Rooted access (#4022, R-fs-06): the analogue of Go 1.24's `os.Root`. A
// program that joins untrusted input onto a base directory opens the base as
// an `FsRoot` and passes the input as `path`; a `path` that would leave the
// root — an absolute path, a `..` past the root, or a symlink anywhere along
// it — is refused with `fs: path escapes root: <path>` before anything is
// touched, on every target. The `..` / absolute check is written here, once;
// the symlink refusal is the call itself (#4084): each `__root_*` intrinsic
// reaches `<root>/<segments>` by descriptor from the root without following
// any symlink (openat2 RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS on Linux, an
// O_NOFOLLOW segment walk elsewhere, the same walk under the preopen on a
// stock wasm runtime), so a directory swapped for a symlink after a check
// cannot steer it out. Symlinks are not followed at all (not Go's in-root
// following): following one needs `read_link`, which fs does not have
// (R-fs-04). `[permissions] fs` bounds the program as a whole.
/// A directory that every root_* call stays inside; made by open_root.
mod type FsRoot = String

/// dir as an FsRoot; err if dir is not a directory.
effect fn open_root(dir: String) -> Result[FsRoot, String] =
  if fs.is_dir(dir) then ok(FsRoot(__root_trim(dir)))
  else err("fs.open_root(\"" + dir + "\"): not a directory")

local fn __root_trim(dir: String) -> String =
  if string.len(dir) > 1 and string.ends_with(dir, "/") then __root_trim(string.drop_end(dir, 1))
  else dir

local fn __root_dir(root: FsRoot) -> String = match root {
  FsRoot(d) => d
}

// The segments of `path` with `.` and `..` applied, or none when it is
// absolute or a `..` climbs past the root.
local fn __root_segments(path: String) -> List[String]? =
  if string.starts_with(path, "/") then none
  else string.split(path, "/") |> list.fold(
    some([]),
    (acc, seg) => match acc {
      none => none,
      some(segs) => match seg {
        "" => some(segs),
        "." => some(segs),
        ".." => if list.len(segs) == 0 then none else some(list.take(segs, list.len(segs) - 1)),
        _ => some(segs + [seg]),
      },
    },
  )

// `path` under root as the rooted calls' operand `<root>\0<segments>`, or the
// escape refusal for an absolute path or a `..` past the root.
local fn __root_at(root: FsRoot, path: String) -> Result[String, String] = match __root_segments(path) {
  none => err("fs: path escapes root: " + path),
  some(segs) => ok(__root_dir(root) + "\u{0}" + string.join(segs, "/")),
}

// A rooted call's answer, its symlink refusal completed with `path`.
local fn __root_answer[A](r: Result[A, String], path: String) -> Result[A, String] = match r {
  ok(v) => ok(v),
  err(e) => if e == "fs: path escapes root" then err("fs: path escapes root: " + path) else err(e),
}

// The rooted calls (#4084): `at` is `<root>\0<segments>`; each answers what
// the plain call on `<root>/<segments>` answers, or `fs: path escapes root`
// for a symlink anywhere on the way.
@intrinsic("almide_rt_fs___root_read_text")
effect fn __root_read_text(at: String) -> Result[String, String] = _

@intrinsic("almide_rt_fs___root_read_bytes")
effect fn __root_read_bytes(at: String) -> Result[Bytes, String] = _

@intrinsic("almide_rt_fs___root_list_dir")
effect fn __root_list_dir(at: String) -> Result[List[String], String] = _

// One byte when the entry exists, none when it does not.
@intrinsic("almide_rt_fs___root_exists")
effect fn __root_exists(at: String) -> Result[Bytes, String] = _

@intrinsic("almide_rt_fs___root_write_text")
@category("FS.write")
effect fn __root_write_text(at: String, content: String) -> Result[Unit, String] = _

@intrinsic("almide_rt_fs___root_remove")
@category("FS.write")
effect fn __root_remove(at: String) -> Result[Unit, String] = _

/// read_text of path inside root; err if it escapes.
effect fn root_read_text(root: FsRoot, path: String) -> Result[String, String] = __root_answer(
  __root_read_text(__root_at(root, path)!),
  path,
)

/// read_bytes_raw of path inside root; err if it escapes.
effect fn root_read_bytes(root: FsRoot, path: String) -> Result[Bytes, String] = __root_answer(
  __root_read_bytes(__root_at(root, path)!),
  path,
)

/// write of content to path inside root; err if it escapes.
@ordered
@category("FS.write")
effect fn root_write_text(root: FsRoot, path: String, content: String) -> Result[Unit, String] = __root_answer(
  __root_write_text(__root_at(root, path)!, content),
  path,
)

/// list_dir of path inside root; err if it escapes.
effect fn root_list_dir(root: FsRoot, path: String) -> Result[List[String], String] = __root_answer(
  __root_list_dir(__root_at(root, path)!),
  path,
)

/// exists of path inside root; err if it escapes.
effect fn root_exists(root: FsRoot, path: String) -> Result[Bool, String] = match __root_answer(
  __root_exists(__root_at(root, path)!),
  path,
) {
  ok(b) => ok(bytes.len(b) > 0),
  err(e) => err(e),
}

/// remove of path inside root; err if it escapes.
@ordered
@category("FS.write")
effect fn root_remove(root: FsRoot, path: String) -> Result[Unit, String] = __root_answer(
  __root_remove(__root_at(root, path)!),
  path,
)
