// fan_map — SELF-HOSTED `fan.map`, the WASM (single-threaded) semantics of the fan-out combinator:
// apply the callback to EVERY element IN LIST ORDER — an element's err does not stop the map, the
// elements after it still run (ADR-0024 D1, C-005: the rule `fan { }` block arms follow, C-199) —
// collect the ok values, and when some element failed the LOWEST-INDEX err is the whole result (a
// deterministic order, byte-identical to native's in-order collection). `first` carries that err
// from the element that returned it to the end of the list. The callback is a funcref invoked via
// `Op::CallIndirect`; the fallible traverse returns `Result[List[B], String]` (the caller's `!`
// unwraps it in effect context). Monomorphic per (input element A, output element B) — the
// trust-spine routes `fan.map` to the right variant by type (`list_heap_call_name`); an unsupported
// pairing walls. `xs` is read-only; `acc` grows a fresh list.
// ── (Int → Int) ──
fn __fan_map_go(xs: List[Int], f: (Int) -> Result[Int, String], i: Int, acc: List[Int], first: String?) -> Result[List[Int], String] = if i >= list.len(xs) then match first {
  some(e) => err(e),
  none => ok(acc),
} else match f(list.get(xs, i) ?? 0) {
  ok(y) => __fan_map_go(xs, f, i + 1, acc + [y], first),
  err(e) => __fan_map_go(xs, f, i + 1, acc, some(first ?? e)),
}

fn fan_map(xs: List[Int], f: (Int) -> Result[Int, String]) -> Result[List[Int], String] = __fan_map_go(
  xs,
  f,
  0,
  [],
  none,
)

// ── (Int → String) ──
fn __fan_map_is_go(xs: List[Int], f: (Int) -> Result[String, String], i: Int, acc: List[String], first: String?) -> Result[List[String], String] = if i >= list.len(xs) then match first {
  some(e) => err(e),
  none => ok(acc),
} else match f(list.get(xs, i) ?? 0) {
  ok(y) => __fan_map_is_go(xs, f, i + 1, acc + [y], first),
  err(e) => __fan_map_is_go(xs, f, i + 1, acc, some(first ?? e)),
}

fn fan_map_is(xs: List[Int], f: (Int) -> Result[String, String]) -> Result[List[String], String] = __fan_map_is_go(
  xs,
  f,
  0,
  [],
  none,
)

