// string_err_text — the SELF-HOSTED twin of C-418's escaper (#4126), the body
// `string.__err_text` runs on wasm and in the interp oracle; native calls
// almide-base's err_text.rs. Rule for rule: a C0 control, DEL, a C1 control and
// a bidirectional control (U+061C, U+200E, U+200F, U+202A..=U+202E,
// U+2066..=U+2069) read `\n` `\r` `\t` `\0` or `\u{<lowercase hex>}`; every
// other character is kept. This file never reaches `prim.`.
fn __et_escaped(n: Int) -> Bool = n <= 31 or (n >= 127 and n <= 159) or n == 1564 or n == 8206 or n == 8207 or (n >= 8234 and n <= 8238) or (n >= 8294 and n <= 8297)

fn __et_char(c: String, n: Int) -> String = match n {
  10 => "\\n",
  13 => "\\r",
  9 => "\\t",
  0 => "\\0",
  _ => if __et_escaped(n) then "\\u{" + int.to_hex(n) + "}" else c,
}

@implements("string.__err_text")
fn string_err_text(s: String) -> String =
  if string.chars(s) |> list.any((c) => __et_escaped(string.codepoint(c) ?? 0)) then string.chars(s) |> list.map((c) => __et_char(c, string.codepoint(c) ?? 0)) |> list.join("")
  else s
