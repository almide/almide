// fs_fold_lines — SELF-HOSTED `fs.fold_lines` for the wasm leg over the WASI
// file-read floor (prim.read_text_file) + a byte-level line walk with EXACTLY
// `BufRead::read_line`'s semantics (the native oracle, runtime/rs/src/fs.rs):
// lines split at '\n' (the terminator is stripped, a preceding '\r' too); a
// final UNTERMINATED line is still yielded; a file ending WITH '\n' yields no
// trailing empty line; the empty file folds ZERO lines (init returned as-is).
// The whole file is read up front — C-220's observables (stdout/stderr/exit)
// are byte-identical; the streaming RSS property is native-only, by design.
//
// Typed twin: the `Map[String, Int]` accumulator (`_msi` — the aggregation
// shape, `list.fold_str_msi`'s ABI: the acc MOVES into f each iteration and f
// returns the next; this fn never frees it). Other accumulator types route to
// an unregistered name in `list_heap_call_name` and wall cleanly at render.
// Reaching prim.read_text_file, the transitive cap_witness carries
// Capability::FsRead — a caller must be an `effect fn` declaring it.
// Byte index of the next '\n' at or after p, or slen if none.
fn __ffl_nl(sh: Int, slen: Int, p: Int) -> Int = if p >= slen then slen
else if prim.load8(sh + 12 + p) == 10 then p
else __ffl_nl(sh, slen, p + 1)

fn __ffl_copy(dst: Int, src: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let b = prim.load8(src + i)
  prim.store8(dst + i, b)
  __ffl_copy(dst, src, n, i + 1)
}

// The line text[start .. endp], with a trailing '\r' stripped (the CRLF rule).
fn __ffl_line(sh: Int, start: Int, endp: Int) -> String = {
  let e2 = if endp > start then {
    if prim.load8(sh + 12 + endp - 1) == 13 then endp - 1 else endp
  } else endp
  let n = e2 - start
  let out = prim.alloc_str(n)
  let _c = __ffl_copy(prim.handle(out) + 12, sh + 12 + start, n, 0)
  out
}

fn __ffl_walk_msi(sh: Int, slen: Int, pos: Int, acc: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Map[String, Int] = if pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_walk_msi(sh, slen, e + 1, nacc, f)
}

effect fn fs_fold_lines_msi(path: String, init: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Result[Map[String, Int], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    ok(__ffl_walk_msi(th, prim.load32(th + 4), 0, init, f))
  }
}

// The ADR-0006 FALLIBLE walker (#1144, C-220's tracked cell): the same byte
// walk, with a callback answering `Result[_, String]` and the FIRST err ending
// the walk — the callback is NOT invoked for any later line. The native leg
// additionally stops READING at the failing line (`almide_rt_fs_fold_lines_effect`
// returns out of the BufReader loop); here the whole file was already in memory
// before the first line was cut, so "where the reader stopped" is not a wasm
// observable. What IS observable on both legs — the callback-invocation trace
// and the err message — is byte-identical, which is exactly what the contract
// promises. Typed twin: the `Map[String, Int]` accumulator, the same shape the
// total `_msi` walker carries; every other accumulator routes to an
// unregistered `_x` name and walls at render.
fn __ffl_walk_eff_msi(sh: Int, slen: Int, pos: Int, acc: Map[String, Int], f: (Map[String, Int], String) -> Result[Map[String, Int], String]) -> Result[Map[String, Int], String] = if pos >= slen then ok(acc)
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  match f(acc, line) {
    ok(nacc) => __ffl_walk_eff_msi(sh, slen, e + 1, nacc, f),
    err(m) => err(m),
  }
}

effect fn fs_fallible_fold_lines_msi(path: String, init: Map[String, Int], f: (Map[String, Int], String) -> Result[Map[String, Int], String]) -> Result[Map[String, Int], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    __ffl_walk_eff_msi(th, prim.load32(th + 4), 0, init, f)
  }
}

// The RANGE walker — the native `fold_lines_range_impl` transcribed over the
// in-memory bytes: a line is owned by the chunk containing the byte BEFORE its
// first byte (line 0 by the chunk containing byte 0). `start > 0` begins at
// `start - 1` and discards through the first '\n' (if byte start-1 IS '\n'
// the discard consumes just it); lines then fold while their START offset is
// < `end` — the final line may read past `end` to finish.
fn __ffl_range_start(sh: Int, slen: Int, start: Int) -> Int = if start <= 0 then 0
else {
  if start - 1 >= slen then slen + 1
  else {
    let d = __ffl_nl(sh, slen, start - 1)
    if d >= slen then slen + 1 else d + 1
  }
}

fn __ffl_range_walk_msi(sh: Int, slen: Int, pos: Int, endp: Int, acc: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Map[String, Int] = if pos >= endp or pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_range_walk_msi(sh, slen, e + 1, endp, nacc, f)
}

// `fs.fold_lines_chunked` msi twin: the SAME byte partition the native runtime
// computes (`chunk = size / max(workers,1) + 1`; range i = [i*chunk,
// min(+chunk, size)) while the start is in-file), folded SEQUENTIALLY in chunk
// order — the partials list is byte-identical to native's (parallelism is a
// wall-clock property, never an observable; C-220).
fn __ffl_chunks_msi(sh: Int, slen: Int, lh: Int, n: Int, chunk: Int, i: Int, init: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Int = if i >= n then 0
else {
  let s = i * chunk
  let e = if s + chunk < slen then s + chunk else slen
  let p0 = __ffl_range_start(sh, slen, s)
  let part = __ffl_range_walk_msi(sh, slen, p0, e, init, f)
  prim.store_str(lh + 12 + i * 8, part)
  __ffl_chunks_msi(sh, slen, lh, n, chunk, i + 1, init, f)
}

effect fn fs_fold_lines_chunked_msi(path: String, workers: Int, init: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Result[List[Map[String, Int]], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let w = if workers < 1 then 1 else workers
    let chunk = slen / w + 1
    let full = (slen + chunk - 1) / chunk
    let n = if w < full then w else full
    let parts: List[Map[String, Int]] = prim.alloc_list_str(n)
    let _c = __ffl_chunks_msi(th, slen, prim.handle(parts), n, chunk, 0, init, f)
    ok(parts)
  }
}

// `fs.fold_lines_chunked` Int-accumulator twin (`_i` — the chunked
// error-path shape `fold_lines_chunked(p, w, 0, (acc, line) => acc)`): the
// SAME byte partition and walker as the msi twin, with each partial stored
// as a raw i64 slot (a scalar carries no ownership; the partials list is a
// flat block, the fan.map payload class).
fn __ffl_range_walk_i(sh: Int, slen: Int, pos: Int, endp: Int, acc: Int, f: (Int, String) -> Int) -> Int = if pos >= endp or pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_range_walk_i(sh, slen, e + 1, endp, nacc, f)
}

fn __ffl_chunks_i(sh: Int, slen: Int, lh: Int, n: Int, chunk: Int, i: Int, init: Int, f: (Int, String) -> Int) -> Int = if i >= n then 0
else {
  let s = i * chunk
  let e = if s + chunk < slen then s + chunk else slen
  let p0 = __ffl_range_start(sh, slen, s)
  let part = __ffl_range_walk_i(sh, slen, p0, e, init, f)
  prim.store64(lh + 12 + i * 8, part)
  __ffl_chunks_i(sh, slen, lh, n, chunk, i + 1, init, f)
}

effect fn fs_fold_lines_chunked_i(path: String, workers: Int, init: Int, f: (Int, String) -> Int) -> Result[List[Int], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let w = if workers < 1 then 1 else workers
    let chunk = slen / w + 1
    let full = (slen + chunk - 1) / chunk
    let n = if w < full then w else full
    let parts: List[Int] = prim.alloc_list(n)
    let _c = __ffl_chunks_i(th, slen, prim.handle(parts), n, chunk, 0, init, f)
    ok(parts)
  }
}

// `fs.fold_lines_range` List[String]-accumulator twin (`_ls` — the
// collect_partition shape `(acc, line) => acc + [line]`): the SAME range
// walker over a List[String] acc. The acc moves through f per line; the final
// acc is the owned Ok payload.
fn __ffl_range_walk_ls(sh: Int, slen: Int, pos: Int, endp: Int, acc: List[String], f: (List[String], String) -> List[String]) -> List[String] = if pos >= endp or pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_range_walk_ls(sh, slen, e + 1, endp, nacc, f)
}

// `fs.fold_lines_chunked` List[String]-accumulator twin (`_ls` — the same
// collect_partition shape, chunked). Identical byte partition to the msi twin,
// with each partial stored as a HEAP handle (`store_str`) into the partials
// block: `Result[List[List[String]], String]` is the msi payload class with a
// List[String] element instead of a Map — both are heap blocks whose slots the
// partials list owns, so the recursive drop route is the same one msi rides.
fn __ffl_chunks_ls(sh: Int, slen: Int, lh: Int, n: Int, chunk: Int, i: Int, init: List[String], f: (List[String], String) -> List[String]) -> Int = if i >= n then 0
else {
  let s = i * chunk
  let e = if s + chunk < slen then s + chunk else slen
  let p0 = __ffl_range_start(sh, slen, s)
  let part = __ffl_range_walk_ls(sh, slen, p0, e, init, f)
  prim.store_str(lh + 12 + i * 8, part)
  __ffl_chunks_ls(sh, slen, lh, n, chunk, i + 1, init, f)
}

effect fn fs_fold_lines_chunked_ls(path: String, workers: Int, init: List[String], f: (List[String], String) -> List[String]) -> Result[List[List[String]], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let w = if workers < 1 then 1 else workers
    let chunk = slen / w + 1
    let full = (slen + chunk - 1) / chunk
    let n = if w < full then w else full
    let parts: List[List[String]] = prim.alloc_list_str(n)
    let _c = __ffl_chunks_ls(th, slen, prim.handle(parts), n, chunk, 0, init, f)
    ok(parts)
  }
}

effect fn fs_fold_lines_range_ls(path: String, start: Int, endp: Int, init: List[String], f: (List[String], String) -> List[String]) -> Result[List[String], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let p0 = __ffl_range_start(th, slen, start)
    ok(__ffl_range_walk_ls(th, slen, p0, endp, init, f))
  }
}

// `fs.fold_lines` String-accumulator twin (`_s` — the concat-fold shape
// `fold_lines(p, "", (acc, line) => acc + line)`): the SAME full-file walk as
// the msi twin over a String acc. The acc moves through f per line; the final
// acc is the owned Ok payload (flat drop — one buffer).
fn __ffl_walk_s(sh: Int, slen: Int, pos: Int, acc: String, f: (String, String) -> String) -> String = if pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_walk_s(sh, slen, e + 1, nacc, f)
}

effect fn fs_fold_lines_s(path: String, init: String, f: (String, String) -> String) -> Result[String, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    ok(__ffl_walk_s(th, prim.load32(th + 4), 0, init, f))
  }
}

// `fs.fold_lines` Int-accumulator twin (`_i` — the counting shape
// `fold_lines(p, 0, (acc, line) => acc + string.len(line))`): a scalar acc
// carries no ownership; the len-as-tag Result[Int, String] payload class.
fn __ffl_walk_i(sh: Int, slen: Int, pos: Int, acc: Int, f: (Int, String) -> Int) -> Int = if pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_walk_i(sh, slen, e + 1, nacc, f)
}

effect fn fs_fold_lines_i(path: String, init: Int, f: (Int, String) -> Int) -> Result[Int, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    ok(__ffl_walk_i(th, prim.load32(th + 4), 0, init, f))
  }
}

// `fs.fold_lines` List[String]-accumulator twin (`_ls` — the read_lines
// equivalence shape `fold_lines(p, [], (acc, line) => acc + [line])`): the
// full-file version of the range walker's acc class.
fn __ffl_walk_ls(sh: Int, slen: Int, pos: Int, acc: List[String], f: (List[String], String) -> List[String]) -> List[String] = if pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_walk_ls(sh, slen, e + 1, nacc, f)
}

effect fn fs_fold_lines_ls(path: String, init: List[String], f: (List[String], String) -> List[String]) -> Result[List[String], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    ok(__ffl_walk_ls(th, prim.load32(th + 4), 0, init, f))
  }
}

// `fs.for_each_line` (the visitor of the family — no accumulator): the SAME
// byte walk, calling f per line for its effects only. The Unit-returning
// callback rides the same lift machinery the fold twins use; the answer is
// `ok(())` unless the READ failed (a per-line callback cannot fail here —
// that form is the fallible carrier below).
fn __ffl_walk_u(sh: Int, slen: Int, pos: Int, f: (String) -> Unit) -> Int = if pos >= slen then 0
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  f(line)
  __ffl_walk_u(sh, slen, e + 1, f)
}

effect fn fs_for_each_line(path: String, f: (String) -> Unit) -> Result[Unit, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let _w = __ffl_walk_u(th, prim.load32(th + 4), 0, f)
    ok(())
  }
}

// The ADR-0006 fallible carriers for the Int fold and the visitor (#1144,
// C-274): the FIRST err ends the walk — the callback is NOT invoked for any
// later line (the invocation trace is the cross-target observable, same as
// the msi fallible walker above).
fn __ffl_walk_eff_i(sh: Int, slen: Int, pos: Int, acc: Int, f: (Int, String) -> Result[Int, String]) -> Result[Int, String] = if pos >= slen then ok(acc)
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  match f(acc, line) {
    ok(nacc) => __ffl_walk_eff_i(sh, slen, e + 1, nacc, f),
    err(m) => err(m),
  }
}

effect fn fs_fallible_fold_lines_i(path: String, init: Int, f: (Int, String) -> Result[Int, String]) -> Result[Int, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    __ffl_walk_eff_i(th, prim.load32(th + 4), 0, init, f)
  }
}

fn __ffl_walk_eff_u(sh: Int, slen: Int, pos: Int, f: (String) -> Result[Unit, String]) -> Result[Unit, String] = if pos >= slen then ok(())
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  match f(line) {
    ok(_u) => __ffl_walk_eff_u(sh, slen, e + 1, f),
    err(m) => err(m),
  }
}

effect fn fs_fallible_for_each_line(path: String, f: (String) -> Result[Unit, String]) -> Result[Unit, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    __ffl_walk_eff_u(th, prim.load32(th + 4), 0, f)
  }
}

// `fs.fold_lines_range` Int-accumulator twin (`_i` — the count-in-range
// shape, and the availability probe's `A = Int` instantiation): the SAME
// range walker over an Int acc. Completes the range column of the C-220
// family matrix (#1423 bucket A).
fn __ffl_range_walk_i(sh: Int, slen: Int, pos: Int, endp: Int, acc: Int, f: (Int, String) -> Int) -> Int = if pos >= endp or pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_range_walk_i(sh, slen, e + 1, endp, nacc, f)
}

effect fn fs_fold_lines_range_i(path: String, start: Int, endp: Int, init: Int, f: (Int, String) -> Int) -> Result[Int, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let p0 = __ffl_range_start(th, slen, start)
    ok(__ffl_range_walk_i(th, slen, p0, endp, init, f))
  }
}

// `fs.fold_lines_range` String-accumulator twin (`_s` — the concat-in-range
// shape): the SAME range walker over a String acc.
fn __ffl_range_walk_s(sh: Int, slen: Int, pos: Int, endp: Int, acc: String, f: (String, String) -> String) -> String = if pos >= endp or pos >= slen then acc
else {
  let e = __ffl_nl(sh, slen, pos)
  let line = __ffl_line(sh, pos, e)
  let nacc = f(acc, line)
  __ffl_range_walk_s(sh, slen, e + 1, endp, nacc, f)
}

effect fn fs_fold_lines_range_s(path: String, start: Int, endp: Int, init: String, f: (String, String) -> String) -> Result[String, String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let p0 = __ffl_range_start(th, slen, start)
    ok(__ffl_range_walk_s(th, slen, p0, endp, init, f))
  }
}

// `fs.fold_lines_range` Map[String, Int]-accumulator twin (`_msi`): the
// surface over the range walker the chunked msi twin already owns.
effect fn fs_fold_lines_range_msi(path: String, start: Int, endp: Int, init: Map[String, Int], f: (Map[String, Int], String) -> Map[String, Int]) -> Result[Map[String, Int], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let p0 = __ffl_range_start(th, slen, start)
    ok(__ffl_range_walk_msi(th, slen, p0, endp, init, f))
  }
}

// `fs.fold_lines_chunked` String-accumulator twin (`_s` — concat partials
// per chunk): the SAME byte partition as the msi/ls/i twins, each String
// partial stored as a heap handle into the partials block. Completes the
// walker x accumulator twin matrix (#1423 bucket A): every accumulating
// walker now carries {_msi, _i, _ls, _s}.
fn __ffl_chunks_s(sh: Int, slen: Int, lh: Int, n: Int, chunk: Int, i: Int, init: String, f: (String, String) -> String) -> Int = if i >= n then 0
else {
  let s = i * chunk
  let e = if s + chunk < slen then s + chunk else slen
  let p0 = __ffl_range_start(sh, slen, s)
  let part = __ffl_range_walk_s(sh, slen, p0, e, init, f)
  prim.store_str(lh + 12 + i * 8, part)
  __ffl_chunks_s(sh, slen, lh, n, chunk, i + 1, init, f)
}

effect fn fs_fold_lines_chunked_s(path: String, workers: Int, init: String, f: (String, String) -> String) -> Result[List[String], String] = {
  let r: Result[String, String] = prim.read_text_file(path)
  let rh = prim.handle(r)
  if prim.load32(rh + 16) != 0 then {
    let m: String = prim.load_handle(rh + 12)
    err(m)
  } else {
    let text: String = prim.load_handle(rh + 12)
    let th = prim.handle(text)
    let slen = prim.load32(th + 4)
    let w = if workers < 1 then 1 else workers
    let chunk = slen / w + 1
    let full = (slen + chunk - 1) / chunk
    let n = if w < full then w else full
    let parts: List[String] = prim.alloc_list_str(n)
    let _c = __ffl_chunks_s(th, slen, prim.handle(parts), n, chunk, 0, init, f)
    ok(parts)
  }
}
