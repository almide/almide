// testing — bundled-Almide stdlib module.
//
// Pure assertion helpers dispatched via `@intrinsic`. On WASM the
// assertions are SELF-HOSTED in `stdlib/testing_assert.almd`, registered
// in `crates/almide-mir/src/render_wasm/registry.rs`. (v0 routed
// `testing.*` through `emit_wasm/calls.rs::dispatch_runtime_fallback` to a
// Named dispatcher holding hardcoded assert_contains / assert_approx /
// etc. implementations; that tree was retired in c71eff7b.)
@intrinsic("almide_rt_test_assert_throws")
fn assert_throws(f: () -> Unit, expected: String) -> Unit = _

@intrinsic("almide_rt_test_assert_contains")
fn assert_contains(haystack: String, needle: String) -> Unit = _

@intrinsic("almide_rt_test_assert_approx")
fn assert_approx(a: Float, b: Float, tolerance: Float) -> Unit = _

@intrinsic("almide_rt_test_assert_gt")
fn assert_gt(a: Int, b: Int) -> Unit = _

@intrinsic("almide_rt_test_assert_lt")
fn assert_lt(a: Int, b: Int) -> Unit = _

@intrinsic("almide_rt_test_assert_some")
@borrow_ref(opt)
fn assert_some[A](opt: A?) -> Unit = _

@intrinsic("almide_rt_test_assert_ok")
@borrow_ref(result)
fn assert_ok[A, B](result: Result[A, B]) -> Unit = _

@intrinsic("almide_rt_test_assert_none")
@borrow_ref(opt)
fn assert_none[A](opt: A?) -> Unit = _

@intrinsic("almide_rt_test_assert_err")
@borrow_ref(result)
fn assert_err[A, B](result: Result[A, B]) -> Unit = _

// assert_snapshot (#1314): `actual` must equal the `expected` literal written
// at the call site; `almide test --update-snapshots` rewrites that literal to
// the found value. The FRONTEND desugars every direct call — inside test
// blocks too — to the T18 abort block (`Error: snapshot mismatch` / `at:` /
// `expected:` / `found:`, exit 1), the same shape on every lane, which is what
// the accept step reads back. This body is reached only through a first-class
// use of the fn value (never desugared) and keeps the verdict, minus the site.
fn assert_snapshot(actual: String, expected: String) -> Unit =
  if actual == expected then () else panic("snapshot mismatch\n  expected: ${expected}\n  found: ${actual}")
