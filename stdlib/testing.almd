// testing — bundled-Almide stdlib module.
//
// Pure assertion helpers dispatched via `@intrinsic`. On WASM the
// assertions are SELF-HOSTED in `stdlib/testing_assert.almd`, registered
// in `crates/almide-mir/src/render_wasm/registry.rs`. (v0 routed
// `testing.*` through `emit_wasm/calls.rs::dispatch_runtime_fallback` to a
// Named dispatcher holding hardcoded assert_contains / assert_approx /
// etc. implementations; that tree was retired in c71eff7b.)
/// Fails unless f, run alone in a child, aborts with text containing expected.
fn assert_aborts[T](expected: String, f: () -> T) -> Unit = panic("testing.assert_aborts runs only as a direct call in a test block (E099)")

// assert_aborts (ADR-0029): the frontend lifts each call's closure to a site
// fn and rewrites the call to `__assert_aborts_check(expected,
// __abort_site_run(k), line)`. The leg runs site k in a child — a re-exec of
// the native test binary, a fresh instance of the wasm module on the embedded
// host — and answers [status, stdout, stderr]. The verdict below is the one
// comparison every leg shares (D4), and its failure block is D5's.
@intrinsic("almide_rt_test_abort_site_run")
fn __abort_site_run(site: Int) -> List[String] = _

// The site a child was started to run, or -1 in the parent: the wasm test
// runner's `main` asks it to choose between the tests and one site.
@intrinsic("almide_rt_test_abort_site_selected")
fn __abort_site_selected() -> Int = _

local fn abort_header(line: String) -> Bool = ["Error: ", "PANIC: "] |> list.any((h) => string.starts_with(line, h))

// The abort text: stderr from its LAST header line to the end (D4), so an
// earlier `eprintln` of the expected text cannot satisfy the match.
local fn abort_text(stderr: String) -> String? = {
  let lines = string.split(stderr, "\n")
  let heads = lines |> list.enumerate |> list.filter_map(((i, l)) => if abort_header(l) then some(i) else none)
  match list.last(heads) {
    some(i) => some(list.drop(lines, i) |> list.join("\n")),
    none => none,
  }
}

// Why a child is not the expected abort, or none when it is.
local fn abort_mismatch(expected: String, status: Int, stderr: String) -> String? = match status {
  0 => some("returned normally"),
  1 => match abort_text(stderr) {
    some(text) => if string.contains(text, expected) then none else some("abort \"${text}\""),
    none => some("exit code 1"),
  },
  101 => some("exit code 101 (raw panic)"),
  134 => some("trap (exit 134)"),
  n => some("exit code ${n}"),
}

// A child's output under its name, indented; blank lines are dropped, since a
// blank line ends the block the test reporters read.
local fn child_section(name: String, text: String) -> String = {
  let lines = string.split(text, "\n") |> list.filter((l) => l != "") |> list.map((l) => "    ${l}")
  if list.is_empty(lines) then "" else "\n  child ${name}:\n" + list.join(lines, "\n")
}

// The verdict of one `assert_aborts` call over its child's [status, stdout, stderr].
fn __assert_aborts_check(expected: String, child: List[String], line: Int) -> Unit = {
  let status = int.parse(list.get(child, 0) ?? "-1") ?? -1
  let stdout = list.get(child, 1) ?? ""
  let stderr = list.get(child, 2) ?? ""
  match abort_mismatch(expected, status, stderr) {
    none => (),
    some(found) => {
      let sections = child_section("stdout", stdout) + child_section("stderr", stderr)
      eprintln("Error: assertion failed\n  at: line ${line}\n  expected: abort containing \"${expected}\"\n  found: ${found}${sections}")
      panic("testing.assert_aborts failed at line ${line}")
    },
  }
}

/// Fails unless needle is in haystack; "" passes.
@intrinsic("almide_rt_test_assert_contains")
fn assert_contains(haystack: String, needle: String) -> Unit = _

/// Fails unless abs(a - b) < tolerance (strict).
@intrinsic("almide_rt_test_assert_approx")
fn assert_approx(a: Float, b: Float, tolerance: Float) -> Unit = _

/// Fails unless a > b; equal fails.
@intrinsic("almide_rt_test_assert_gt")
fn assert_gt(a: Int, b: Int) -> Unit = _

/// Fails unless a < b; equal fails.
@intrinsic("almide_rt_test_assert_lt")
fn assert_lt(a: Int, b: Int) -> Unit = _

/// Fails when opt is none.
@intrinsic("almide_rt_test_assert_some")
@borrow_ref(opt)
fn assert_some[A](opt: A?) -> Unit = _

/// Fails when result is an err.
@intrinsic("almide_rt_test_assert_ok")
@borrow_ref(result)
fn assert_ok[A, B](result: Result[A, B]) -> Unit = _

/// Fails when opt is some.
@intrinsic("almide_rt_test_assert_none")
@borrow_ref(opt)
fn assert_none[A](opt: A?) -> Unit = _

/// Fails when result is ok.
@intrinsic("almide_rt_test_assert_err")
@borrow_ref(result)
fn assert_err[A, B](result: Result[A, B]) -> Unit = _

// assert_snapshot (#1314): `actual` must equal the `expected` literal written
// at the call site; `almide test --update-snapshots` rewrites that literal to
// the found value. The FRONTEND desugars every direct call — inside test
// blocks too — to the T18 abort block (`Error: snapshot mismatch` / `at:` /
// `expected:` / `found:`, exit 1), the same shape on every lane, which is what
// the accept step reads back. This body is reached only through a first-class
// use of the fn value (never desugared) and keeps the verdict, minus the site.
/// Fails unless actual == expected; --update-snapshots rewrites.
fn assert_snapshot(actual: String, expected: String) -> Unit = if actual == expected then ()
else panic("snapshot mismatch\n  expected: ${expected}\n  found: ${actual}")
