// hash — bundled-Almide stdlib module: non-cryptographic digests, SHA-256/512 and HMAC
// (#1467, the one category the small-language cohort filled and we did not).
//
// `fnv1a32` is the 32-BIT FNV-1a on purpose: every step is `(h ^ byte) *
// 16777619` masked to 32 bits, so the largest intermediate stays under 2^56
// and the wasm self-host reproduces it exactly in i64 arithmetic — a 64-bit
// variant would need a wrapping 64-bit multiply the self-host floor does not
// have. The result is the unsigned 32-bit hash as a non-negative Int.
//
// `sha256` / `sha256_hex` are FIPS 180-4, byte-identical across targets
// (spec/wasm_cross/hash_digests.almd pins the NIST vectors on both legs).
//
// Templates route the Rust target to `runtime/rs/src/hash.rs`; on WASM all
// four are SELF-HOSTED in `stdlib/hash_impl.almd`, registered in
// `crates/almide-types/src/self_host_registry.rs`.
/// 32-bit FNV-1a of s's UTF-8; non-negative Int.
@intrinsic("almide_rt_hash_fnv1a32")
fn fnv1a32(s: String) -> Int = _

/// 32-bit FNV-1a of b, in 0..4294967295.
@intrinsic("almide_rt_hash_fnv1a32_bytes")
fn fnv1a32_bytes(b: Bytes) -> Int = _

/// 32-byte SHA-256 digest of b. Not a MAC: sha256(key ++ msg) is forgeable by length extension; use hash.hmac_sha256 / hash.is_valid_hmac_sha256.
@intrinsic("almide_rt_hash_sha256")
fn sha256(b: Bytes) -> Bytes = _

/// SHA-256 of s's UTF-8, 64 lowercase hex chars.
@intrinsic("almide_rt_hash_sha256_hex")
fn sha256_hex(s: String) -> String = _

// ── Checksums and the other digests (R-hash-02, R-hash-03) ──
// Pure Almide on every target, so native and wasm run the same code. 32-bit
// lanes are Ints masked to 32 bits after every add; SHA-512's 64-bit lanes are
// plain Ints, whose + and * wrap mod 2^64 on every leg.
/// CRC-32 (IEEE, reflected) as an unsigned Int; 0 for empty b.
fn crc32(b: Bytes) -> Int = {
  var table = list.repeat(0, 256)
  var n = 0
  while n < 256 {
    var c = n
    var k = 0
    while k < 8 {
      c = int.bxor(int.bshr(c, 1), int.band(3988292384, 0 - int.band(c, 1)))
      k = k + 1
    }
    table[n] = c
    n = n + 1
  }
  var acc = 4294967295
  var i = 0
  let len = bytes.len(b)
  while i < len {
    acc = int.bxor(table[int.band(int.bxor(acc, bytes.get_or(b, i, 0)), 255)], int.bshr(acc, 8))
    i = i + 1
  }
  int.bxor(acc, 4294967295)
}

/// Adler-32 as an unsigned Int; 1 for empty b.
fn adler32(b: Bytes) -> Int = {
  var s1 = 1
  var s2 = 0
  var i = 0
  let len = bytes.len(b)
  while i < len {
    s1 = (s1 + bytes.get_or(b, i, 0)) % 65521
    s2 = (s2 + s1) % 65521
    i = i + 1
  }
  int.bor(int.bshl(s2, 16), s1)
}

local fn h_mask32(x: Int) -> Int = int.band(x, 4294967295)

local fn h_rotl32(x: Int, n: Int) -> Int = h_mask32(int.bor(int.bshl(x, n), int.bshr(x, 32 - n)))

// Logical right shift of a 64-bit lane, n in 1..63.
local fn h_shr64(x: Int, n: Int) -> Int = int.band(int.bshr(x, n), int.bshl(1, 64 - n) - 1)

local fn h_rotr64(x: Int, n: Int) -> Int = int.bor(h_shr64(x, n), int.bshl(x, 64 - n))

// The bit length of an n-byte message as `count` bytes, big- or little-endian.
local fn h_len_bytes(n: Int, count: Int, big_endian: Bool) -> List[Int] = {
  let le = list.range(0, count) |> list.map((i) => if i < 8 then int.band(int.bshr(n * 8, i * 8), 255) else 0)
  if big_endian then list.reverse(le) else le
}

// The message padded to a whole number of `block`-byte blocks (MD/SHA).
local fn h_pad(b: Bytes, block: Int, len_count: Int, big_endian: Bool) -> List[Int] = {
  let n = bytes.len(b)
  let total = (n + 1 + len_count + block - 1) / block * block
  bytes.to_list(b) + [128] + list.repeat(0, total - n - 1 - len_count) + h_len_bytes(
    n,
    len_count,
    big_endian,
  )
}

local fn h_word32(m: List[Int], at: Int, big_endian: Bool) -> Int =
  if big_endian then int.bor(
    int.bor(int.bshl(m[at], 24), int.bshl(m[at + 1], 16)),
    int.bor(int.bshl(m[at + 2], 8), m[at + 3]),
  ) else int.bor(
    int.bor(m[at], int.bshl(m[at + 1], 8)),
    int.bor(int.bshl(m[at + 2], 16), int.bshl(m[at + 3], 24)),
  )

local fn h_word64(m: List[Int], at: Int) -> Int = list.range(0, 8) |> list.fold(
  0,
  (acc, k) => int.bor(int.bshl(acc, 8), m[at + k]),
)

// Each word as `width` bytes, big- or little-endian.
local fn h_out(words: List[Int], width: Int, big_endian: Bool) -> Bytes = words |> list.flat_map((w) => list.range(0, width) |> list.map((k) => {
  let shift = if big_endian then (width - 1 - k) * 8 else k * 8
  int.band(int.bshr(w, shift), 255)
})) |> bytes.from_list

local fn h_hex(b: Bytes) -> String = bytes.to_list(b) |> list.map((x) => string.slice("0123456789abcdef", int.bshr(x, 4), int.bshr(x, 4) + 1) + string.slice(
  "0123456789abcdef",
  int.band(x, 15),
  int.band(x, 15) + 1,
)) |> string.join("")

