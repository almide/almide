// list_sortby_float — SELF-HOSTED `list.sort_by` with a FLOAT key, ordered by IEEE-754 totalOrder
// (f64::total_cmp; see list_sort_float for the bit-key). Like list_sortby (a stable mergesort
// by a cached key, the key fn called EXACTLY ONCE per element), but the cached key is the f64 key's
// MONOTONE totalOrder transform — so the insertion sort's plain signed `>` IS the totalOrder swap
// test (v0 pre-transforms the same way). The element slots are opaque i64 (any element type, e.g.
// a List[R] of records); only the KEY is Float. Scratch key list owned + dropped; result owned.
fn __ftotal_sb(b: Int) -> Int = {
  let s = prim.bshr(b, 63)
  let m = prim.bshr_u(s, 1)
  prim.bxor(b, m)
}

fn __sbf_init(bh: Int, sh: Int, kh: Int, f: (Int) -> Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let v = prim.load64(sh + 12 + i * 8)
  let raw = f(v)
  let k = __ftotal_sb(raw)
  prim.store64(bh + 12 + i * 8, v)
  prim.store64(kh + 12 + i * 8, k)
  __sbf_init(bh, sh, kh, f, n, i + 1)
}

// ── stable bottom-up mergesort over the paired (value, key) buffers (#1459):
// O(n log n) in place of the O(n^2) insertion shift; `<=` takes the left run
// first, so equal keys keep their order (same stability contract as before).
fn __sbf_mrun(svh: Int, skh: Int, dvh: Int, dkh: Int, mid: Int, hi: Int, i: Int, j: Int, k: Int) -> Int = if k >= hi then 0
else {
  let takel = if j >= hi then true
  else if i >= mid then false else prim.load64(skh + 12 + i * 8) <= prim.load64(skh + 12 + j * 8)
  if takel then {
    prim.store64(dvh + 12 + k * 8, prim.load64(svh + 12 + i * 8))
    prim.store64(dkh + 12 + k * 8, prim.load64(skh + 12 + i * 8))
    __sbf_mrun(svh, skh, dvh, dkh, mid, hi, i + 1, j, k + 1)
  } else {
    prim.store64(dvh + 12 + k * 8, prim.load64(svh + 12 + j * 8))
    prim.store64(dkh + 12 + k * 8, prim.load64(skh + 12 + j * 8))
    __sbf_mrun(svh, skh, dvh, dkh, mid, hi, i, j + 1, k + 1)
  }
}

fn __sbf_mpass(svh: Int, skh: Int, dvh: Int, dkh: Int, n: Int, width: Int, lo: Int) -> Int = if lo >= n then 0
else {
  let m0 = lo + width
  let mid = if m0 > n then n else m0
  let h0 = lo + width * 2
  let hi = if h0 > n then n else h0
  let _r = __sbf_mrun(svh, skh, dvh, dkh, mid, hi, lo, mid, lo)
  __sbf_mpass(svh, skh, dvh, dkh, n, width, lo + width * 2)
}

fn __sbf_mrounds(cvh: Int, ckh: Int, ovh: Int, okh: Int, n: Int, width: Int) -> Int = if width >= n then cvh
else {
  let _p = __sbf_mpass(cvh, ckh, ovh, okh, n, width, 0)
  __sbf_mrounds(ovh, okh, cvh, ckh, n, width * 2)
}

fn __sbf_mcopy(srch: Int, dsth: Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  prim.store64(dsth + 12 + i * 8, prim.load64(srch + 12 + i * 8))
  __sbf_mcopy(srch, dsth, n, i + 1)
}

// Sorted values are guaranteed to END in bvh (and the keys in bkh): a final
// ping-pong landing in the scratch is copied back, so an OWNED key list (the
// String-key twin) never holds a stale handle at its recursive scope-end drop.
fn __sbf_msort(bvh: Int, bkh: Int, tvh: Int, tkh: Int, n: Int) -> Int = {
  let fin = __sbf_mrounds(bvh, bkh, tvh, tkh, n, 1)
  if fin == bvh then 0
  else {
    let _v = __sbf_mcopy(tvh, bvh, n, 0)
    __sbf_mcopy(tkh, bkh, n, 0)
  }
}

fn list_sort_by_float(xs: List[Int], f: (Int) -> Int) -> List[Int] = {
  let n = list.len(xs)
  let buf = prim.alloc_list(n)
  let keys = prim.alloc_list(n)
  let _a = __sbf_init(prim.handle(buf), prim.handle(xs), prim.handle(keys), f, n, 0)
  let tv = prim.alloc_list(n)
  let tk = prim.alloc_list(n)
  let _s = __sbf_msort(prim.handle(buf), prim.handle(keys), prim.handle(tv), prim.handle(tk), n)
  buf
}

// HEAP-element variant (`sort_by(rs, (r) => r.v)` over a List[R] of records):
// identical sort, but each element handle copied into the result is ACQUIRED
// (rc_inc) — the result list CO-OWNS every element, so both lists' recursive
// drops are balanced (the raw-copy variant double-freed: rc_dec trap in
// __drop_list_R, the list_float_total_order teardown).
fn __sbfr_init(bh: Int, sh: Int, kh: Int, f: (Int) -> Int, n: Int, i: Int) -> Int = if i >= n then 0
else {
  let v = prim.load64(sh + 12 + i * 8)
  let raw = f(v)
  let k = __ftotal_sb(raw)
  prim.rc_inc(v)
  prim.store64(bh + 12 + i * 8, v)
  prim.store64(kh + 12 + i * 8, k)
  __sbfr_init(bh, sh, kh, f, n, i + 1)
}

fn list_sort_by_float_rc(xs: List[Int], f: (Int) -> Int) -> List[Int] = {
  let n = list.len(xs)
  let buf = prim.alloc_list(n)
  let keys = prim.alloc_list(n)
  let _a = __sbfr_init(prim.handle(buf), prim.handle(xs), prim.handle(keys), f, n, 0)
  let tv = prim.alloc_list(n)
  let tk = prim.alloc_list(n)
  let _s = __sbf_msort(prim.handle(buf), prim.handle(keys), prim.handle(tv), prim.handle(tk), n)
  buf
}
