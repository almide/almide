target/
.test/
.minigit/
.test_fs_walk/
.worktrees/
codopsy-report.json
.codopsy-baseline.json
.claude/settings.local.json
**/.almide/cache/
tools/stdlib-crawler/data/
__pycache__/
*.pyc
docs-site/

# The tree+toolchain fingerprint `make verify-trust` records so `make receipt`
# can fold in a verification of the identical tree (proofs/lib/stamp.sh).
proofs/.verified-fingerprint

# Build artifacts must not be tracked (#930)
*.cwasm
*.rmeta
spec/**/*.wasm
.DS_Store

# Lean lake build dirs (local builds only; CI builds from scratch)
.lake/
crates/almide-mir/m.wasm

# gen-dossier.sh output: the redirect creates this in the repo root BEFORE
# the receipt inside fingerprints the tree — an untracked hit would break
# the fingerprint fast-path and force a full gate re-derivation
almide-dossier-*.md
*.regen

# insta writes a .snap.new beside a snapshot it could not match; it is a
# pending-review artifact, never a committed one (5 of them reached the tree
# in the fifth A-ci batch through a directory-wide `git add`).
*.snap.new
