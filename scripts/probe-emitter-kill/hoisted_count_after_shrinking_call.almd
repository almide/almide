// Probe: a list indexed in a loop and handed, inside the loop, to a function
// that shortens it through a `mut` parameter. The index that follows is out
// of range for the shortened list, so the program must stop there.
fn keep_first(mut xs: List[Int]) -> Unit = {
  xs = [xs[0]]
}

effect fn main() -> Unit = {
  var xs = [10, 20, 30, 40, 50, 60, 70, 80]
  var total = 0
  var i = 0
  while i < 8 {
    if i == 2 then keep_first(xs) else ()
    total = total + xs[i]
    i = i + 1
  }
  println(int.to_string(total))
}
