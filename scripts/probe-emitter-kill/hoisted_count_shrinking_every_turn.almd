// Probe: a list indexed in a loop and handed, on every turn of the loop, to a
// function that drops its last element through a `mut` parameter. On the
// fifth turn the index is out of range, so the program must stop there.
fn drop_last(mut xs: List[Int]) -> Unit = {
  xs = list.take(xs, list.len(xs) - 1)
}

effect fn main() -> Unit = {
  var xs = [10, 20, 30, 40, 50, 60, 70, 80]
  var total = 0
  var i = 0
  while i < 8 {
    drop_last(xs)
    total = total + xs[i]
    i = i + 1
  }
  println(int.to_string(total))
}
