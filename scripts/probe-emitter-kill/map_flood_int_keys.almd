effect fn main() -> Unit = {
  let ks = keys()
  var m: Map[Int, Int] = map.new()
  var n = 0
  for k in ks {
    m[k] = n
    n = n + 1
  }
  println(int.to_string(map.len(m)))
  var sum = 0
  for k in ks {
    sum = sum + (map.get(m, k) ?? -1000000)
  }
  println(int.to_string(sum))
  var i = 0
  while i < 400 {
    m = map.remove(m, list.get(ks, i) ?? 0)
    i = i + 3
  }
  println(int.to_string(map.len(m)))
  var present = 0
  var kept = 0
  i = 0
  while i < 400 {
    let k = list.get(ks, i) ?? 0
    if map.contains(m, k) then {
      present = present + 1
      kept = kept + (map.get(m, k) ?? -1000000)
    } else {
      present = present + 0
    }
    i = i + 1
  }
  println("${present} ${kept}")
  m[list.get(ks, 1) ?? 0] = 7777
  println("${map.get(m, list.get(ks, 1) ?? 0) ?? 0} ${map.contains(m, list.get(ks, 0) ?? 0)} ${map.contains(m, list.get(ks, 2) ?? 0)}")
}
