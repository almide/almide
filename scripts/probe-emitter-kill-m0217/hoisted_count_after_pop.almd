// Probe: a list indexed in a loop that also shortens it in place with
// `list.pop`, one element per turn. On the fifth turn the index is past the
// list's end, so the program must stop there with "index out of bounds".
effect fn main() -> Unit = {
  var xs = [10, 20, 30, 40, 50, 60, 70, 80]
  var total = 0
  var i = 0
  while i < 8 {
    let _ = list.pop(xs)
    total = total + xs[i]
    i = i + 1
  }
  println(int.to_string(total))
}
