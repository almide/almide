// コンパイルしない例 — 診断のリファレンス
// @status: future-syntax — 各断片は tests/diagnostics/ の fixture（E0xx 各 1）に転写される。
// このファイル全体が「コンパイルできないことが正しい」コード。

// ── race の枝に oracle 効果 ─────────────────────────────────
effect fn bad_io_race(url: String) -> String = {
  fan.race(1s) { http.get(url); cached() }
  // error: fan.race branches must be pure
  // hint: racing I/O is environment-dependent — restructure, or use the
  //       oracle-tier fan.timeout (Stage 4)
}

// ── 単位なしの裸の数値 ─────────────────────────────────────
effect fn bad_bare_number(strategies: List[Strategy]) -> Int = {
  fan.race(1000, strategies, (s) => run(s))
  // error: expected Compute, found Int
  // hint: budgets carry a unit — fan.race(1000ms, ...) — or omit the budget
  //       entirely (it is an optional divergence guard)
}

// ── 壁時計の duration を決定的予算の位置に渡す ────────────────────
effect fn bad_clock_mixup(cfg: Config) -> Int = {
  fan.bounded(cfg.request_timeout) { solve() }
  // error: expected Compute, found Duration
  // hint: fan.bounded budgets deterministic computation, not wall-clock time.
  //       For a wall-clock limit use fan.timeout (oracle tier, Stage 4)
}

// ── v1 の thunk リスト形（Wave 1 で E0xx tombstone）──────────────
effect fn bad_thunk_list() -> Int = {
  fan.any([() => a(), () => b()])
  // error (E0xx): thunk lists were removed in fan v2
  // hint: fan.any { a(); b() } or fan.any(xs, f)
}

// ── bounded に複数 arm ─────────────────────────────────────
effect fn bad_multi_arm() -> Int = {
  fan.bounded(100ms) { a(); b() }
  // error: fan.bounded takes one body expression
  // hint: for selection over branches use fan.race; to run all use fan { }
}

// ── 外側 var のキャプチャ（既存 E008・不変）──────────────────────
effect fn bad_var_capture() -> Unit = {
  var count = 0
  fan { do { count = count + 1; f() }; g() }
  // error (E008): fan arms cannot capture outer `var`
}

// ── pure 文脈での fan（既存規則の一貫適用）─────────────────────
fn bad_pure_ctx() -> Int =
  fan.bounded(10ms) { 1 }
  // error: fan.bounded() can only be used inside an effect fn
